import Mathlib
import PEqualNP.Defs.Search
import PEqualNP.Defs.CoverPromise

/-!
# The owner link (G-OWN of the import map of L-meta-444): exact statements

Conjecture until a seat's checker accepts a row. `OWN` and `REN` are the terms of the import map,
section 4, verbatim (the functions inside L-meta-499 and L-meta-500). `GOwn` is the import map's
G-OWN term with `OWN`, `REN` named; `GOwnA`, `GOwnB`, `GOwnC` are its three clauses under the same
hypotheses prefix:
(a) the leading entries have no repeats and their set is the forward cover `F`;
(b) every list has at least two entries, and every entry is below the vertex count;
(c) the owned pairs are exactly the edges of `S`, and the tail lengths sum to the edge count.
`gOwn_of_abc` assembles them.
-/

namespace PEqualNP.MetaComplexity.Helpers.OwnerLink

/-- The owner-list function of L-meta-499, verbatim. -/
def OWN : ℕ → ℕ → PEqualNP.Search.CNF → List (List ℕ) :=
  (fun (E k : ℕ) (ψ : PEqualNP.Search.CNF) => (fun (off : ℕ → ℕ) => (fun (pos : ℕ → ℕ → ℕ) (X : ℕ → ℕ → ℕ → ℕ) => (fun (inner : ℕ → ℕ → Bool → List (List ℕ)) (lit : ℕ → ℕ → PEqualNP.Search.Literal) (w : ℕ → ℕ) (f : ℕ → ℕ) => (List.range ψ.length).flatMap (fun i : ℕ => (List.range (w i + 1)).flatMap (fun j : ℕ => (if j < w i then inner (2 * (lit i j).1 + (if (lit i j).2 then 1 else 0)) (pos i j) (lit i j).2 else inner (2 * E + 1) (pos i j) true) ++ ((List.range (w i + 1)).filter (fun l : ℕ => decide (j < l))).flatMap (fun l : ℕ => inner (pos i j) (pos i l) (decide (j ≠ f i))) ++ (if j < w i ∧ (lit i j).1 = off i + j then inner (2 * (lit i j).1) (2 * (lit i j).1 + 1) false else []) ++ (if j ≠ f i then [pos i j :: ((if j < w i ∧ (lit i j).2 = false then [X (2 * (lit i j).1) (pos i j) (2 * k)] else []) ++ (if f i < j then [X (pos i (f i)) (pos i j) (2 * k)] else []) ++ ((List.range (w i + 1)).filter (fun l : ℕ => decide (j < l))).map (fun l : ℕ => X (pos i j) (pos i l) 1))] else []) ++ (if j < w i ∧ (lit i j).1 = off i + j then [(2 * (lit i j).1 + 1) :: X (2 * (lit i j).1) (2 * (lit i j).1 + 1) (2 * k) :: (List.range ψ.length).flatMap (fun i' : ℕ => ((List.range (w i')).filter (fun j' : ℕ => decide ((lit i' j').1 = (lit i j).1 ∧ (lit i' j').2 = true))).map (fun j' : ℕ => X (2 * (lit i j).1 + 1) (pos i' j') 1))] else []))) ++ inner (2 * E) (2 * E + 1) false ++ inner (2 * E) (3 * E + 2) false ++ [(2 * E + 1) :: X (2 * E) (2 * E + 1) (2 * k) :: (List.range ψ.length).map (fun i : ℕ => X (2 * E + 1) (pos i (w i)) 1)] ++ [[3 * E + 2, X (2 * E) (3 * E + 2) (2 * k)]]) (fun (u v : ℕ) (inT : Bool) => ((List.range (2 * k)).filter (fun s : ℕ => decide ((s + 1) % 2 = 0 ↔ inT = true))).map (fun s : ℕ => [X u v (s + 1), if s = 0 then u else X u v s, if s + 1 = 2 * k then v else X u v (s + 2)])) (fun (i j : ℕ) => (ψ.getD i []).getD j (0, false)) (fun (i : ℕ) => (ψ.getD i []).length) (fun (i : ℕ) => (ψ.getD i []).findIdx (fun l : PEqualNP.Search.Literal => l.2))) (fun (i j : ℕ) => 2 * (E + 1) + off i + j) (fun (u v t : ℕ) => 3 * (E + 1) + 2 * k * (u * (3 * (E + 1)) + v) + t - 1)) (fun (i : ℕ) => ((ψ.take i).map (fun c : PEqualNP.Search.Clause => c.length + 1)).sum))

/-- The renaming by earliest occurrence of L-meta-500, verbatim. -/
def REN : PEqualNP.Search.CNF → PEqualNP.Search.CNF :=
  (fun φ : PEqualNP.Search.CNF => φ.map (fun c : PEqualNP.Search.Clause => c.map (fun l : PEqualNP.Search.Literal => ((φ.flatMap (fun c' : PEqualNP.Search.Clause => c'.map some ++ [none])).findIdx (fun o : Option PEqualNP.Search.Literal => o.any (fun l' : PEqualNP.Search.Literal => l'.1 == l.1)), l.2))))

/-- G-OWN, the import map's term with `OWN` and `REN` named. -/
def GOwn : Prop :=
  ∀ (φ : PEqualNP.Search.CNF) (E k : ℕ) (off : ℕ → ℕ) (e : ℕ → ℕ), 1 ≤ k → E = (PEqualNP.Search.encodeCNF φ).length → (∀ i, off i = ((φ.take i).map (fun c => c.length + 1)).sum) → (∀ z, e z = (φ.flatMap (fun c => c.map some ++ [none])).findIdx (fun o => o.any (fun l => l.1 == z))) → ∀ num : PEqualNP.MetaComplexity.CoverPromise.Vertex → ℕ, (∀ z ∈ PEqualNP.MetaComplexity.CoverPromise.vars φ, ∀ b : Bool, num (Sum.inl (z, b)) = 2 * e z + (if b then 1 else 0)) → (∀ b : Bool, num (Sum.inl (PEqualNP.MetaComplexity.CoverPromise.fresh φ, b)) = 2 * E + (if b then 1 else 0)) → (∀ i j, i < φ.length → j ≤ (φ.getD i []).length → num (Sum.inr (i, j)) = 2 * (E + 1) + off i + j) → num (Sum.inr (φ.length, 0)) = 3 * E + 2 → ∀ H : SimpleGraph (Fin (3 * (E + 1))), (∀ a b : Fin (3 * (E + 1)), H.Adj a b ↔ ∃ u v, (PEqualNP.MetaComplexity.CoverPromise.cvcGraph φ).Adj u v ∧ num u = a.val ∧ num v = b.val) → ∀ T : Finset (Fin (3 * (E + 1))), (∀ a : Fin (3 * (E + 1)), a ∈ T ↔ ∃ u ∈ PEqualNP.MetaComplexity.CoverPromise.cvcCover φ, num u = a.val) → ∀ S : SimpleGraph (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), S = SimpleGraph.fromRel (fun x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))) => ∃ u v : Fin (3 * (E + 1)), u < v ∧ H.Adj u v ∧ ∃ i : Fin (2 * k), x.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ ((i.val = 0 ∧ y.val = u.val) ∨ (i.val + 1 < 2 * k ∧ y.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val + 1) ∨ (i.val + 1 = 2 * k ∧ y.val = v.val))) → ∀ F : Finset (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), (∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ (∃ u ∈ T, j.val = u.val) ∨ ∃ u v : Fin (3 * (E + 1)), ∃ i : Fin (2 * k), u < v ∧ H.Adj u v ∧ j.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ (i.val % 2 = 1 ↔ u ∈ T)) → ∀ ol : List (List ℕ), ol = OWN E k (REN φ) → (ol.map (fun l : List ℕ => l.headD 0)).Nodup ∧ (∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ j.val ∈ ol.map (fun l : List ℕ => l.headD 0)) ∧ (∀ l ∈ ol, 2 ≤ l.length) ∧ (∀ l ∈ ol, ∀ w ∈ l, w < (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))) ∧ (∀ x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), S.Adj x y ↔ ∃ l ∈ ol, (l.headD 0 = x.val ∧ y.val ∈ l.tail) ∨ (l.headD 0 = y.val ∧ x.val ∈ l.tail)) ∧ (ol.map (fun l : List ℕ => l.tail.length)).sum = S.edgeSet.ncard

/-- Clause (a): heads without repeats, their set the forward cover. -/
def GOwnA : Prop :=
  ∀ (φ : PEqualNP.Search.CNF) (E k : ℕ) (off : ℕ → ℕ) (e : ℕ → ℕ), 1 ≤ k → E = (PEqualNP.Search.encodeCNF φ).length → (∀ i, off i = ((φ.take i).map (fun c => c.length + 1)).sum) → (∀ z, e z = (φ.flatMap (fun c => c.map some ++ [none])).findIdx (fun o => o.any (fun l => l.1 == z))) → ∀ num : PEqualNP.MetaComplexity.CoverPromise.Vertex → ℕ, (∀ z ∈ PEqualNP.MetaComplexity.CoverPromise.vars φ, ∀ b : Bool, num (Sum.inl (z, b)) = 2 * e z + (if b then 1 else 0)) → (∀ b : Bool, num (Sum.inl (PEqualNP.MetaComplexity.CoverPromise.fresh φ, b)) = 2 * E + (if b then 1 else 0)) → (∀ i j, i < φ.length → j ≤ (φ.getD i []).length → num (Sum.inr (i, j)) = 2 * (E + 1) + off i + j) → num (Sum.inr (φ.length, 0)) = 3 * E + 2 → ∀ H : SimpleGraph (Fin (3 * (E + 1))), (∀ a b : Fin (3 * (E + 1)), H.Adj a b ↔ ∃ u v, (PEqualNP.MetaComplexity.CoverPromise.cvcGraph φ).Adj u v ∧ num u = a.val ∧ num v = b.val) → ∀ T : Finset (Fin (3 * (E + 1))), (∀ a : Fin (3 * (E + 1)), a ∈ T ↔ ∃ u ∈ PEqualNP.MetaComplexity.CoverPromise.cvcCover φ, num u = a.val) → ∀ S : SimpleGraph (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), S = SimpleGraph.fromRel (fun x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))) => ∃ u v : Fin (3 * (E + 1)), u < v ∧ H.Adj u v ∧ ∃ i : Fin (2 * k), x.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ ((i.val = 0 ∧ y.val = u.val) ∨ (i.val + 1 < 2 * k ∧ y.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val + 1) ∨ (i.val + 1 = 2 * k ∧ y.val = v.val))) → ∀ F : Finset (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), (∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ (∃ u ∈ T, j.val = u.val) ∨ ∃ u v : Fin (3 * (E + 1)), ∃ i : Fin (2 * k), u < v ∧ H.Adj u v ∧ j.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ (i.val % 2 = 1 ↔ u ∈ T)) → ∀ ol : List (List ℕ), ol = OWN E k (REN φ) → ((ol.map (fun l : List ℕ => l.headD 0)).Nodup) ∧ ((∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ j.val ∈ ol.map (fun l : List ℕ => l.headD 0)))

/-- Clause (b): every list has at least two entries, every entry below the vertex count. -/
def GOwnB : Prop :=
  ∀ (φ : PEqualNP.Search.CNF) (E k : ℕ) (off : ℕ → ℕ) (e : ℕ → ℕ), 1 ≤ k → E = (PEqualNP.Search.encodeCNF φ).length → (∀ i, off i = ((φ.take i).map (fun c => c.length + 1)).sum) → (∀ z, e z = (φ.flatMap (fun c => c.map some ++ [none])).findIdx (fun o => o.any (fun l => l.1 == z))) → ∀ num : PEqualNP.MetaComplexity.CoverPromise.Vertex → ℕ, (∀ z ∈ PEqualNP.MetaComplexity.CoverPromise.vars φ, ∀ b : Bool, num (Sum.inl (z, b)) = 2 * e z + (if b then 1 else 0)) → (∀ b : Bool, num (Sum.inl (PEqualNP.MetaComplexity.CoverPromise.fresh φ, b)) = 2 * E + (if b then 1 else 0)) → (∀ i j, i < φ.length → j ≤ (φ.getD i []).length → num (Sum.inr (i, j)) = 2 * (E + 1) + off i + j) → num (Sum.inr (φ.length, 0)) = 3 * E + 2 → ∀ H : SimpleGraph (Fin (3 * (E + 1))), (∀ a b : Fin (3 * (E + 1)), H.Adj a b ↔ ∃ u v, (PEqualNP.MetaComplexity.CoverPromise.cvcGraph φ).Adj u v ∧ num u = a.val ∧ num v = b.val) → ∀ T : Finset (Fin (3 * (E + 1))), (∀ a : Fin (3 * (E + 1)), a ∈ T ↔ ∃ u ∈ PEqualNP.MetaComplexity.CoverPromise.cvcCover φ, num u = a.val) → ∀ S : SimpleGraph (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), S = SimpleGraph.fromRel (fun x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))) => ∃ u v : Fin (3 * (E + 1)), u < v ∧ H.Adj u v ∧ ∃ i : Fin (2 * k), x.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ ((i.val = 0 ∧ y.val = u.val) ∨ (i.val + 1 < 2 * k ∧ y.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val + 1) ∨ (i.val + 1 = 2 * k ∧ y.val = v.val))) → ∀ F : Finset (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), (∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ (∃ u ∈ T, j.val = u.val) ∨ ∃ u v : Fin (3 * (E + 1)), ∃ i : Fin (2 * k), u < v ∧ H.Adj u v ∧ j.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ (i.val % 2 = 1 ↔ u ∈ T)) → ∀ ol : List (List ℕ), ol = OWN E k (REN φ) → ((∀ l ∈ ol, 2 ≤ l.length)) ∧ ((∀ l ∈ ol, ∀ w ∈ l, w < (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))))

/-- Clause (c): owned pairs are the edges of `S`, tail lengths sum to the edge count. -/
def GOwnC : Prop :=
  ∀ (φ : PEqualNP.Search.CNF) (E k : ℕ) (off : ℕ → ℕ) (e : ℕ → ℕ), 1 ≤ k → E = (PEqualNP.Search.encodeCNF φ).length → (∀ i, off i = ((φ.take i).map (fun c => c.length + 1)).sum) → (∀ z, e z = (φ.flatMap (fun c => c.map some ++ [none])).findIdx (fun o => o.any (fun l => l.1 == z))) → ∀ num : PEqualNP.MetaComplexity.CoverPromise.Vertex → ℕ, (∀ z ∈ PEqualNP.MetaComplexity.CoverPromise.vars φ, ∀ b : Bool, num (Sum.inl (z, b)) = 2 * e z + (if b then 1 else 0)) → (∀ b : Bool, num (Sum.inl (PEqualNP.MetaComplexity.CoverPromise.fresh φ, b)) = 2 * E + (if b then 1 else 0)) → (∀ i j, i < φ.length → j ≤ (φ.getD i []).length → num (Sum.inr (i, j)) = 2 * (E + 1) + off i + j) → num (Sum.inr (φ.length, 0)) = 3 * E + 2 → ∀ H : SimpleGraph (Fin (3 * (E + 1))), (∀ a b : Fin (3 * (E + 1)), H.Adj a b ↔ ∃ u v, (PEqualNP.MetaComplexity.CoverPromise.cvcGraph φ).Adj u v ∧ num u = a.val ∧ num v = b.val) → ∀ T : Finset (Fin (3 * (E + 1))), (∀ a : Fin (3 * (E + 1)), a ∈ T ↔ ∃ u ∈ PEqualNP.MetaComplexity.CoverPromise.cvcCover φ, num u = a.val) → ∀ S : SimpleGraph (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), S = SimpleGraph.fromRel (fun x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))) => ∃ u v : Fin (3 * (E + 1)), u < v ∧ H.Adj u v ∧ ∃ i : Fin (2 * k), x.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ ((i.val = 0 ∧ y.val = u.val) ∨ (i.val + 1 < 2 * k ∧ y.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val + 1) ∨ (i.val + 1 = 2 * k ∧ y.val = v.val))) → ∀ F : Finset (Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1)))), (∀ j : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), j ∈ F ↔ (∃ u ∈ T, j.val = u.val) ∨ ∃ u v : Fin (3 * (E + 1)), ∃ i : Fin (2 * k), u < v ∧ H.Adj u v ∧ j.val = (3 * (E + 1)) + 2 * k * (u.val * (3 * (E + 1)) + v.val) + i.val ∧ (i.val % 2 = 1 ↔ u ∈ T)) → ∀ ol : List (List ℕ), ol = OWN E k (REN φ) → ((∀ x y : Fin (3 * (E + 1) + 2 * k * (3 * (E + 1)) * (3 * (E + 1))), S.Adj x y ↔ ∃ l ∈ ol, (l.headD 0 = x.val ∧ y.val ∈ l.tail) ∨ (l.headD 0 = y.val ∧ x.val ∈ l.tail))) ∧ ((ol.map (fun l : List ℕ => l.tail.length)).sum = S.edgeSet.ncard)

/-- The three clauses give G-OWN (they are its conjuncts). -/
theorem gOwn_of_abc (ha : GOwnA) (hb : GOwnB) (hc : GOwnC) : GOwn := by
  intro φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
  obtain ⟨a1, a2⟩ := ha φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
  obtain ⟨b1, b2⟩ := hb φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
  obtain ⟨c1, c2⟩ := hc φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
  exact ⟨a1, a2, b1, b2, c1, c2⟩

/-- And conversely. -/
theorem abc_of_gOwn (h : GOwn) : GOwnA ∧ GOwnB ∧ GOwnC := by
  refine ⟨?_, ?_, ?_⟩ <;>
  · intro φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
    obtain ⟨a1, a2, b1, b2, c1, c2⟩ := h φ E k off e hk hE hoff he num h1 h2 h3 h4 H hH T hT S hS F hF ol hol
    first
    | exact ⟨a1, a2⟩
    | exact ⟨b1, b2⟩
    | exact ⟨c1, c2⟩

end PEqualNP.MetaComplexity.Helpers.OwnerLink
