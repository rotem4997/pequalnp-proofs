    ∀ t : ℕ, HasCircuitSize 8 (fun x : Fin 8 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 0 && x 4) || (x 1 && x 2) || (x 1 && x 5) || (x 3 && x 6) || (x 5 && x 6) || (x 6 && x 7)) t → 11 ≤ t := by
  refine step _ _ 4 ![0, 1, 2, 3, 0, 4, 5, 6] 10 (by decide) h ⟨fun i => i == 0, by decide⟩
    ⟨fun _ => false, fun i => i == 0 || i == 1, by decide⟩ (all7 _ ?_)
  decide

