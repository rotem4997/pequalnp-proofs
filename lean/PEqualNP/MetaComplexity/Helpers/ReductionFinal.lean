/-!
# L-meta-444 from its pieces

Part 4 of the assembly. The outer shell L-meta-498 extends the map of record `R`
(computable by G-MACH) to strings; the glue L-meta-352, with the checked injectivity of the CNF
code (L-lib-026), G-FUN on codes and the empty circuit (a YES instance) on non-codes, gives the
statement of L-meta-444 verbatim. The pieces checked in-house (L-meta-352, 376, 388, 507, 508) are
imported and applied; every hypothesis is the recorded statement of a row checked only by the
outside runner or not yet checked (`Stmt<id>`), or the gap G-OWN (`GOwn`).
-/

namespace PEqualNP.MetaComplexity.Reduction

open PEqualNP.Search PEqualNP.CircuitLowerBounds

/-- The witness of L-meta-498 at `R` is the map of record `r`. -/
theorem r_unique (r' : List Bool → ℕ × Circuit) (hc : ∀ φ : CNF, r' (encodeCNF φ) = R φ)
    (hn : ∀ x : List Bool, (∀ φ : CNF, encodeCNF φ ≠ x) → r' x = (0, Circuit.mk [] 0)) : r' = r := by
  classical
  funext x
  by_cases h : ∃ φ : CNF, encodeCNF φ = x
  · rw [r, dif_pos h, ← hc, h.choose_spec]
  · rw [r, dif_neg h]
    exact hn x (fun φ hφ => h ⟨φ, hφ⟩)

theorem L444_of_pieces (h285 : Stmt285) (h286 : Stmt286) (h290 : Stmt290) (h307 : Stmt307)
    (h473 : Stmt473) (h474 : Stmt474) (h475 : Stmt475) (h478 : Stmt478)
    (h479 : Stmt479) (h489 : Stmt489) (h492 : Stmt492) (h499 : Stmt499)
    (h500 : Stmt500) (h501 : Stmt501) (hown : PEqualNP.MetaComplexity.Helpers.OwnerLink.GOwn) :
    ∃ r : List Bool → ℕ × PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.Library.ComputableInPolyTime (fun x : List Bool => x) PEqualNP.MetaComplexity.encodeLgp r ∧ ∀ x : List Bool, (x ∉ PEqualNP.Search.SAT → PEqualNP.MetaComplexity.LgpYes (r x).1 (r x).2) ∧ (x ∈ PEqualNP.Search.SAT → PEqualNP.MetaComplexity.LgpNo (r x).1 (r x).2) := by
  obtain ⟨r', hr', hcode, hnon⟩ := PEqualNP.MetaComplexity.L498 R
    (mach_of_pieces h499 h500 h501 PEqualNP.MetaComplexity.L507 PEqualNP.MetaComplexity.L508)
  refine ⟨r', hr', PEqualNP.MetaComplexity.L352 r' PEqualNP.Library.L026 ?_ ?_⟩
  · intro φ
    rw [hcode φ]
    exact fun_of_pieces h285 h286 h290 h307 PEqualNP.MetaComplexity.L376 PEqualNP.MetaComplexity.L388
      h473 h474 h475 h478 h479 h489 h492 hown φ
  · intro x hx
    rw [hnon x (fun φ h => hx ⟨φ, h⟩)]
    exact PEqualNP.MetaComplexity.LgpEncode.lgpYes_empty

