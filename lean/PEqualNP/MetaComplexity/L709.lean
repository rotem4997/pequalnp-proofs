import PEqualNP.MetaComplexity.Helpers.FewNotSplit

/-- Few NOT gates, the split at the first NOT gate: a gate list of AND, OR and NOT gates of
fan-in at most two, with at most `s` NOT gates counted by indices, has no NOT gate, or is
`pre ++ NOT ins :: post` with `pre` free of NOT gates, `s = s' + 1`, and replacing the NOT
gate in place by any AND or OR gate of fan-in at most two leaves at most `s'` NOT gates. -/
theorem PEqualNP.MetaComplexity.L709 : ∀ (s : ℕ) (gates : List PEqualNP.CircuitLowerBounds.Gate), (∀ g ∈ gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) → (∃ ι : Fin s → Fin gates.length, ∀ i : Fin gates.length, (gates.get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → ∃ j : Fin s, ι j = i) → (∀ g ∈ gates, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) ∨ ∃ (s' : ℕ) (pre post : List PEqualNP.CircuitLowerBounds.Gate) (ins : List ℕ), s = s' + 1 ∧ gates = pre ++ ({ op := PEqualNP.CircuitLowerBounds.GateOp.not, inputs := ins } : PEqualNP.CircuitLowerBounds.Gate) :: post ∧ ins.length ≤ 2 ∧ (∀ g ∈ pre, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or) ∧ g.inputs.length ≤ 2) ∧ ∀ g' : PEqualNP.CircuitLowerBounds.Gate, (g'.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g'.op = PEqualNP.CircuitLowerBounds.GateOp.or) → g'.inputs.length ≤ 2 → (∀ g ∈ pre ++ g' :: post, (g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.not) ∧ g.inputs.length ≤ 2) ∧ ∃ ι' : Fin s' → Fin (pre ++ g' :: post).length, ∀ i : Fin (pre ++ g' :: post).length, ((pre ++ g' :: post).get i).op = PEqualNP.CircuitLowerBounds.GateOp.not → ∃ j : Fin s', ι' j = i :=
  PEqualNP.MetaComplexity.FewNot.fn_split_general
