import PEqualNP.MetaComplexity.Helpers.LogicRows

/-- Given the lower and upper bounds, a cover one above the minimum yields a NO instance of the last-gate problem. -/
theorem PEqualNP.MetaComplexity.L388 : (∀ (n k s : ℕ) (G : SimpleGraph (Fin n)) (A : Finset (Fin n)), (∀ (v : Fin n) (c : G.Walk v v), c.IsCycle → 7 ≤ c.length) → (∀ u v : Fin n, u ≠ v → 3 ≤ (G.neighborSet u).ncard → 3 ≤ (G.neighborSet v).ncard → ∀ p : G.Walk u v, 7 ≤ p.length) → (∀ i j : Fin n, G.Adj i j → i ∉ A) → (A.Nonempty ∨ ∃ i j : Fin n, G.Adj i j) → (∀ T : Finset (Fin n), (∀ i j : Fin n, G.Adj i j → i ∈ T ∨ j ∈ T) → k ≤ T.card) → PEqualNP.MetaComplexity.HasCircuitSize n (fun x : Fin n → Bool => @decide ((∃ a ∈ A, x a = true) ∨ ∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true) (Classical.propDecidable _)) s → A.card + G.edgeSet.ncard + k ≤ s + 1) → ∀ (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (C : PEqualNP.CircuitLowerBounds.Circuit) (T : Finset (Fin n)), (∀ (v : Fin n) (c : G.Walk v v), c.IsCycle → 7 ≤ c.length) → (∀ u v : Fin n, u ≠ v → 3 ≤ (G.neighborSet u).ncard → 3 ≤ (G.neighborSet v).ncard → ∀ p : G.Walk u v, 7 ≤ p.length) → (∃ i j : Fin n, G.Adj i j) → (∀ S : Finset (Fin n), (∀ i j : Fin n, G.Adj i j → i ∈ S ∨ j ∈ S) → ∃ s : ℕ, s + 1 = G.edgeSet.ncard + S.card ∧ PEqualNP.MetaComplexity.HasCircuitSize n (fun x : Fin n → Bool => decide (∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true)) s) → (∀ i j : Fin n, G.Adj i j → i ∈ T ∨ j ∈ T) → (∀ S : Finset (Fin n), (∀ i j : Fin n, G.Adj i j → i ∈ S ∨ j ∈ S) → T.card ≤ S.card + 1) → (∃ S : Finset (Fin n), (∀ i j : Fin n, G.Adj i j → i ∈ S ∨ j ∈ S) ∧ S.card < T.card) → PEqualNP.MetaComplexity.FanInTwo C → PEqualNP.MetaComplexity.circuitFun n C = (fun x : Fin n → Bool => decide (∃ i j : Fin n, G.Adj i j ∧ x i = true ∧ x j = true)) → C.size + 1 = G.edgeSet.ncard + T.card → PEqualNP.MetaComplexity.LgpNo n C :=
  PEqualNP.MetaComplexity.Helpers.LogicRows.row388
