    (deep : ∃ (x1 : ℕ), ∀ (x2 : ℕ) (x3 : SimpleGraph (Fin x2)) [x4 : DecidableRel x3.Adj], (∀ (x5 : Fin x2) (x6 : x3.Walk x5 x5), x6.IsCycle → (5 : ℕ) ≤ x6.length) → x3.edgeFinset.Nonempty → ∀ (x7 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.TopForm.IsLeastAO x3 x7 → PEqualNP.TopForm.TopForm x3 x7 → ∀ x8 ⊆ PEqualNP.TopForm.Ustar x3 x7, (∀ x10 ∈ x8, (¬∃ (x11 : Fin x2) (x12 : Fin x2), x10 = s(x11, x12) ∧ ∃ x13 < x7.gates.length, ∃ (x14 : Fin (2 : ℕ)), (2 : ℕ) ≤ (PEqualNP.TopForm.orIn x2 x7 (x2 + x13)).card ∧ (∀ x15 ∈ PEqualNP.TopForm.orIn x2 x7 (x2 + x13), x3.Adj x11 x15) ∧ PEqualNP.TopForm.orIn x2 x7 (PEqualNP.TopForm.opnd x7 x13 x14) = {x12}) ∧ ∃ x11 ∈ PEqualNP.TopForm.centreless x3 x7, x10 ∈ PEqualNP.TopForm.gammaE x3 x7 x11) → (∀ x10 ∈ x8, ¬(∃ (y1 : Fin x2) (y2 : Fin x2), x10 = s(y1, y2) ∧ ∃ y3 ∈ PEqualNP.TopForm.tops x3 x7, ∀ (y4 : Fin (2 : ℕ)), y1 ∈ PEqualNP.TopForm.side x7 y3 y4 ∨ y2 ∈ PEqualNP.TopForm.side x7 y3 y4 ∨ ∃ y5 ∈ PEqualNP.TopForm.junk x3 x7, PEqualNP.CleanedNonEdge.OrReaches x2 x7 (PEqualNP.TopForm.opnd x7 y3 y4) y5 ∧ ((∀ (y6 : Fin (2 : ℕ)), y1 ∈ PEqualNP.TopForm.side x7 y5 y6 ∨ y2 ∈ PEqualNP.TopForm.side x7 y5 y6) ∨ ∃ (y6 : Fin (2 : ℕ)), y1 ∈ PEqualNP.TopForm.side x7 y3 ((1 : Fin (2 : ℕ)) - y4) ∧ (y1 ∈ PEqualNP.TopForm.side x7 y5 y6 ∨ y2 ∈ PEqualNP.TopForm.side x7 y5 y6) ∧ ∃ y7 ∈ PEqualNP.TopForm.junk x3 x7, PEqualNP.CleanedNonEdge.OrReaches x2 x7 (PEqualNP.TopForm.opnd x7 y5 ((1 : Fin (2 : ℕ)) - y6)) y7 ∧ ∀ (y8 : Fin (2 : ℕ)), y1 ∈ PEqualNP.TopForm.side x7 y7 y8 ∨ y2 ∈ PEqualNP.TopForm.side x7 y7 y8))) → x8.card ≤ x1 * (x7.size + (1 : ℕ))) :
