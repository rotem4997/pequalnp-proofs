private def residual (a : Fin 25) := on graph (live a.castSucc)

private theorem active (a v : Fin 25) :
    v ∈ live a.castSucc ↔ v ≠ a ∧ ¬ graph.Adj a v := by
  have h := (data a.castSucc).2.2.2 v
  have lt := a.isLt
  simpa [Fin.ext_iff,Fin.ofNat_eq_cast, Nat.mod_eq_of_lt lt, Nat.ne_of_lt lt] using h

private theorem neighbor (a v : Fin 25) : v ∈ neighbours a ↔ graph.Adj a v := by simp [neighbours]

private theorem existsEdge (a : Fin 25) : ∃ u v, (residual a).Adj u v := by
  have existsAway : ∀ a : Fin 25, ∃ u v, graph.Adj u v ∧
      (u ≠ a ∧ ¬graph.Adj a u) ∧ (v ≠ a ∧ ¬ graph.Adj a v) := by decide +kernel
  obtain ⟨u,v,e,hu,hv⟩ := existsAway a
  exact ⟨u,v,e,(active _ _).mpr hu,(active _ _).mpr hv⟩

theorem pinFormula (a : Fin 25) (x : Fin 25 → Bool) :
    F graph ∅ (Function.update x a true) = F (residual a) (neighbours a) x := by
  apply F_eq
  simp only [Finset.notMem_empty,false_and,exists_false,false_or]
  constructor
  · rintro ⟨u,v,e,hu,hv⟩
    by_cases ua : u = a
    · subst u
      exact Or.inl ⟨v,(neighbor _ _).mpr e,by simpa [Function.update_of_ne e.ne.symm] using hv⟩
    by_cases va : v = a
    · subst v
      exact Or.inl ⟨u,(neighbor _ _).mpr e.symm,by simpa [Function.update_of_ne e.ne] using hu⟩
    rw [Function.update_of_ne ua] at hu
    rw [Function.update_of_ne va] at hv
    by_cases au : graph.Adj a u
    · exact Or.inl ⟨u,(neighbor _ _).mpr au,hu⟩
    by_cases av : graph.Adj a v
    · exact Or.inl ⟨v,(neighbor _ _).mpr av,hv⟩
    exact Or.inr ⟨u,v,⟨e,(active _ _).mpr ⟨ua,au⟩,(active _ _).mpr ⟨va,av⟩⟩,hu,hv⟩
  · rintro (⟨v,hv,xv⟩ | ⟨u,v,⟨e,hu,hv⟩,xu,xv⟩)
    · have e := (neighbor _ _).mp hv
      exact ⟨a,v,e,by simp,by simpa [Function.update_of_ne e.ne.symm] using xv⟩
    · exact ⟨u,v,e,by simpa [Function.update_of_ne ((active _ _).mp hu).1] using xu,
        by simpa [Function.update_of_ne ((active _ _).mp hv).1] using xv⟩

theorem fullLower : Lower (F graph ∅) 30 := by
  let a : Fin 26 := 25
  have ⟨ck,pos,score,all⟩ := data a
  have full : on graph (live a) = graph := by
    ext u v
    exact ⟨fun e => e.1,fun e => ⟨e,(all u).mpr (Or.inl rfl),(all v).mpr (Or.inl rfl)⟩⟩
  have h := price graph (cert a) ck (by decide) pos
  change Lower (F (on graph (live a)) ∅) _ at h
  rw [full] at h
  exact fun s hC => Nat.le_trans (by exact score) (h s hC)

theorem pinnedLower (a : Fin 25) : Lower (F (residual a) (neighbours a)) 28 := by
  have lt := a.isLt
  have ck := data a.castSucc
  simp only [Fin.val_castSucc,Nat.ne_of_lt lt,ite_false] at ck
  obtain ⟨hcert,pos,score,_⟩ := ck
  have base := price graph (cert a.castSucc) hcert (by decide) pos
  have payFree := freePrice (residual a) (neighbours a)
    (fun u hu v e => ((active _ _).mp e.2.1).2 ((neighbor _ _).mp hu)) (existsEdge a)
    (by omega) base
  have ae : Fin.ofNat 25 a.val = a := Fin.ext (Nat.mod_eq_of_lt lt)
  rw [ae] at score
  exact fun s h => score.trans (payFree s h)

theorem operand (a : Fin 25) (f : (Fin 25 → Bool) → Bool)
    (whenOn : ∀ x, x a = true → f x = F graph ∅ x) :
    Lower f 28 ∧ ((∃ x, f (Function.update x a (!x a)) ≠ f x) → Lower f 29) := by
  have eq (x) : f (Function.update x a true) = F (residual a) (neighbours a) x :=
    (whenOn _ (by simp)).trans (pinFormula a x)
  have save (dep : ∃ x, f (Function.update x a (!x a)) ≠ f x) : Lower f 29 :=
    pay dep eq (F_nc _ _ (Or.inr (existsEdge a))) (by decide) (pinnedLower a)
  refine ⟨?_,save⟩
  by_cases dep : ∃ x, f (Function.update x a (!x a)) ≠ f x
  · exact fun s h => Nat.le_trans (by decide) (save dep s h)
  · push Not at dep
    have same : f = F (residual a) (neighbours a) := by
      funext x
      rw [←eq]
      cases hx : x a with
      | false => simpa only [hx,Bool.not_false] using (dep x).symm
      | true => rw [←hx,Function.update_eq_self]
    rw [same]
    exact pinnedLower a

def one (a i : Fin 25) := decide (i=a)

theorem star (p q : (Fin 25 → Bool) → Bool) (a b : Fin 25)
    (hp : ∀ ⦃x y⦄, (∀ i, x i = true → y i = true) → p x = true → p y = true)
    (hq : ∀ ⦃x y⦄, (∀ i, x i = true → y i = true) → q x = true → q y = true)
    (rep : ∀ x, (p x && q x) = F graph ∅ x) (solo : ∀ i, p (one i) = true ↔ i=a)
    (partner : q (one b) = true) : Lower p 29 ∧ Lower q 28 := by
  have lift (i : Fin 25) (x : Fin 25 → Bool) (hx : x i = true) :
      ∀ j, one i j = true → x j = true := by
    intro j hj; obtain rfl := of_decide_eq_true hj; exact hx
  have pOn (x) (hb : x b = true) : p x = F graph ∅ x := by
    simpa [hq (lift b _ hb) partner] using rep x
  have qOn (x) (ha : x a = true) : q x = F graph ∅ x := by
    simpa [hp (lift a _ ha) ((solo a).mpr rfl)] using rep x
  have away : ∀ a b : Fin 25, ∃ w, graph.Adj b w ∧ w ≠ a := by decide +kernel
  obtain ⟨w,e,wa⟩ := away a b
  have old : p (one w) = false := Bool.eq_false_iff.mpr (fun h => wa ((solo w).mp h))
  have wb : one w b = false := by simp [one,e.ne]
  let x := Function.update (one w) b true
  have gx : F graph ∅ x = true := (F_true _ _ _).mpr (Or.inr ⟨b,w,e,by simp [x],
    by simp [x,Function.update_of_ne e.ne.symm,one]⟩)
  have hit : p x = true := (pOn _ (by simp [x])).trans gx
  exact ⟨(operand b p pOn).2 ⟨one w, by rw [wb,Bool.not_false,old]; exact ne_of_eq_of_ne hit (by decide)⟩,
    (operand a q qOn).1⟩

