theorem freePrice {n k} (G : SimpleGraph (Fin (n+1))) (A : Finset (Fin (n+1)))
    (iso : ∀ a ∈ A, ∀ j, ¬G.Adj a j) (edge : ∃ i j, G.Adj i j)
    (pos : 0 < k) (h : Lower (F G ∅) k) : Lower (F G A) (k+A.card) := by
  classical
  induction A using Finset.induction_on with
  | empty => simpa using h
  | @insert a A fresh ih =>
    have dep := F_dep_A G (insert a A) a (by simp)
    have nc := F_nc G A (Or.inr edge)
    have rest := ih (fun v hv => iso v (Finset.mem_insert_of_mem hv))
    have eq (x) : F G (insert a A) (Function.update x a false) = F G A x := by
      apply F_eq
      simp only [Finset.mem_insert]
      constructor
      · rintro (⟨u,hu,bit⟩ | ⟨i,j,ij,xi,xj⟩)
        · rcases hu with rfl | hu
          · simp at bit
          · have ne : u ≠ a := fun e => fresh (e ▸ hu)
            exact Or.inl ⟨u,hu,by simpa [Function.update_of_ne ne] using bit⟩
        · have ia : i ≠ a := by rintro rfl; exact iso _ (by simp) _ ij
          have ja : j ≠ a := by rintro rfl; exact iso _ (by simp) _ ij.symm
          exact Or.inr ⟨i,j,ij,by simpa [Function.update_of_ne ia] using xi,
            by simpa [Function.update_of_ne ja] using xj⟩
      · rintro (⟨u,hu,bit⟩ | ⟨i,j,ij,xi,xj⟩)
        · have ne : u ≠ a := fun e => fresh (e ▸ hu)
          exact Or.inl ⟨u,Or.inr hu,by simpa [Function.update_of_ne ne] using bit⟩
        · have ia : i ≠ a := by rintro rfl; exact iso _ (by simp) _ ij
          have ja : j ≠ a := by rintro rfl; exact iso _ (by simp) _ ij.symm
          exact Or.inr ⟨i,j,ij,by simpa [Function.update_of_ne ia] using xi,
            by simpa [Function.update_of_ne ja] using xj⟩
    simpa [Finset.card_insert_of_notMem fresh,Nat.add_assoc] using
      pay (k := k+A.card) dep eq nc (by omega) rest

