def Inc (p : Fin 12) (l : Fin 13) := p.succ=l ∨ p.succ=l+1 ∨ p.succ=l+3 ∨ p.succ=l+9

def target (x : Fin 25 → Bool) : Prop := ∃ p l, Inc p l ∧
  x (Fin.castAdd 13 p) = true ∧ x (Fin.natAdd 12 l) = true

theorem graphTarget (x) : F graph ∅ x = true ↔ target x := by
  have inc : ∀ p l, Inc p l → graph.Adj (Fin.castAdd 13 p) (Fin.natAdd 12 l) := by unfold Inc; decide +kernel
  have decode : ∀ i j, forward i j →
      ∃ p l, i = Fin.castAdd 13 p ∧ j = Fin.natAdd 12 l ∧ Inc p l := by unfold Inc forward; decide +kernel
  rw [F_true]; simp only [Finset.notMem_empty,false_and,exists_false,false_or]
  constructor
  · rintro ⟨i,j,(e|e),hi,hj⟩
    · obtain ⟨p,l,rfl,rfl,edge⟩ := decode _ _ e
      exact ⟨p,l,edge,hi,hj⟩
    · obtain ⟨p,l,rfl,rfl,edge⟩ := decode _ _ e
      exact ⟨p,l,edge,hj,hi⟩
  · rintro ⟨p,l,e,hp,hl⟩
    exact ⟨_,_,inc _ _ e,hp,hl⟩

def W (D : Circuit) (w : ℕ) (x : Fin 25 → Bool) := (D.wires (List.ofFn x)).getD w false

theorem smallShared (D : Circuit) (p q : ℕ) (a : Fin 25) (mono : Monotone2 D)
    (rep : ∀ x, (W D p x && W D q x) = true ↔ target x)
    (solo : ∀ i, W D p (one i) = true ↔ i=a) (partner : ∃ i, W D q (one i) = true)
    (budget : D.size ≤ 56) : ∃ t < D.size, InOutCone 25 D (25+t) p ∧ InOutCone 25 D (25+t) q := by
  obtain ⟨b,hb⟩ := partner
  have monoW (w) (x y : Fin 25 → Bool) (le : ∀ i, x i = true → y i = true) :
      W D w x = true → W D w y = true :=
    PEqualNP.Outside.L_meta_18986.WireFacts.pos_mono D.gates (fun g hg => (mono g hg).1) (w+1) x y le
  have eq (x) : (W D p x && W D q x) = F graph ∅ x :=
    Bool.eq_iff_iff.mpr ((rep x).trans (graphTarget x).symm)
  have ⟨lp,lq⟩ := star _ _ a b (fun {x y} => monoW p x y) (fun {x y} => monoW q x y) eq solo hb
  have fan : FanInTwo D := by
    intro g hg
    obtain ⟨op,len⟩ := mono g hg
    exact ⟨by change g.op = GateOp.and ∨ g.op = GateOp.or ∨ g.op = GateOp.not; change g.op = GateOp.and ∨ g.op = GateOp.or at op; exact op.imp_right Or.inl,len⟩
  exact shared D p q fan lp lq budget

