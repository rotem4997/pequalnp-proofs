theorem shared (C : Circuit) (p q : ℕ) (fan : FanInTwo C)
    (lowP : Lower (fun x : Fin 25 → Bool => (C.wires (List.ofFn x)).getD p false) 29)
    (lowQ : Lower (fun x : Fin 25 → Bool => (C.wires (List.ofFn x)).getD q false) 28) (budget : C.size ≤ 56) :
    ∃ t < C.size, InOutCone 25 C (25+t) p ∧ InOutCone 25 C (25+t) q := by
  have pBound := lowP _ (coneRep C 25 p fan)
  have qBound := lowQ _ (coneRep C 25 q fan)
  have sub : cone 25 C p ∪ cone 25 C q ⊆ Finset.range C.size := by
    intro t ht
    rcases Finset.mem_union.mp ht with hp|hq
    · exact (Finset.mem_filter.mp hp).1
    · exact (Finset.mem_filter.mp hq).1
  have count := Finset.card_le_card sub
  rw [Finset.card_range] at count
  have balance := Finset.card_union_add_card_inter (cone 25 C p) (cone 25 C q)
  have nonempty : 0 < (cone 25 C p ∩ cone 25 C q).card := by omega
  obtain ⟨t,ht⟩ := Finset.card_pos.mp nonempty
  obtain ⟨hp,hq⟩ := Finset.mem_inter.mp ht
  exact ⟨t,Finset.mem_range.mp (Finset.mem_filter.mp hp).1,(Finset.mem_filter.mp hp).2,
    (Finset.mem_filter.mp hq).2⟩

