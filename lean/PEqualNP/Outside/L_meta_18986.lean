def cone (n : ℕ) (C : Circuit) (o : ℕ) : Finset ℕ :=
  (Finset.range C.size).filter fun t => InOutCone n C (n+t) o

private theorem coneRep (C : Circuit) (n o : ℕ) (fan : FanInTwo C) :
    HasCircuitSize n (fun x => (C.wires (List.ofFn x)).getD o false) (cone n C o).card := by
  let κ (t : ℕ) := decide (t ∈ cone n C o)
  have hκ {t} (h : κ t = true) : t < C.gates.length :=
    Finset.mem_range.mp (Finset.mem_filter.mp (of_decide_eq_true h)).1
  have hcl (t : ℕ) (ht : t < C.gates.length) (hk : κ t = true)
      (z : ℕ) (hz : z ∈ C.gates[t].inputs) (nz : n ≤ z) (zt : z < n+t) : κ (z-n) = true := by
    have nt : n+(z-n)=z := by omega
    have direct : InCone n C (z-n) t := (inCone_iff _ _ _ _).mpr ⟨ht,z-n,by omega,by
      simpa [gateAt,List.getElem?_eq_getElem ht,nt] using hz,Or.inl rfl⟩
    apply decide_eq_true
    refine Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by change z-n < C.gates.length; omega),Or.inr ⟨by omega,?_,?_⟩⟩
    · rcases (Finset.mem_filter.mp (of_decide_eq_true hk)).2 with eq | ⟨_,ho,_⟩
      · omega
      · exact ho
    · rw [Nat.add_sub_cancel_left]
      rcases (Finset.mem_filter.mp (of_decide_eq_true hk)).2 with eq | ⟨_,_,inside⟩
      · rw [←eq,Nat.add_sub_cancel_left]; exact direct
      · rw [Nat.add_sub_cancel_left] at inside
        exact inCone_trans _ _ _ _ direct _ inside
  have ho (no : n ≤ o) (end_ : o < n+C.gates.length) : κ (o-n) = true :=
