import Mathlib.Data.Nat.Bitwise
import Mathlib.Data.Fintype.Powerset
import Mathlib.Data.List.GetD
import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_4083

abbrev Vertex := Fin 10

def neighborMask (p : Vertex) : Nat :=
  [50, 69, 138, 276, 521, 385, 770, 548, 104, 208].getD p.val 0

def edgeFunction (x : Vertex → Bool) : Bool :=
  decide (∃ p q : Vertex, x p = true ∧ x q = true ∧ (neighborMask p).testBit q.val = true)

def inputOf (T : Finset Vertex) (p : Vertex) : Bool := decide (p ∈ T)

def neighborUnion (vertices : List Vertex) : Nat :=
  vertices.foldr (fun p m => neighborMask p ||| m) 0

lemma neighborUnion_spec (vertices : List Vertex) (q : Vertex) :
    (neighborUnion vertices).testBit q.val = true ↔
      ∃ p ∈ vertices, (neighborMask p).testBit q.val = true := by
  induction vertices with
  | nil => simp [neighborUnion]
  | cons p ps ih =>
    change (neighborMask p ||| neighborUnion ps).testBit q.val = true ↔ _
    rw [Nat.testBit_lor, Bool.or_eq_true, ih]
    simp only [List.mem_cons]
    constructor
    · rintro (h | ⟨t, ht, h⟩)
      · exact ⟨p, Or.inl rfl, h⟩
      · exact ⟨t, Or.inr ht, h⟩
    · rintro ⟨t, rfl | ht, h⟩
      · exact Or.inl h
      · exact Or.inr ⟨t, ht, h⟩

def members (T : Finset Vertex) : List Vertex :=
  (List.finRange 10).filter fun v => decide (v ∈ T)

lemma mem_members (T : Finset Vertex) (v : Vertex) : v ∈ members T ↔ v ∈ T := by
  simp [members]

def evalOn (T : Finset Vertex) : Bool :=
  let vertices := members T
  let neighbors := neighborUnion vertices
  vertices.any fun q => neighbors.testBit q.val

lemma evalOn_eq (T : Finset Vertex) : evalOn T = edgeFunction (inputOf T) := by
  apply Bool.eq_iff_iff.mpr
  simp only [evalOn, edgeFunction, List.any_eq_true, neighborUnion_spec, mem_members,
    decide_eq_true_eq, inputOf]
  constructor
  · rintro ⟨q, hq, p, hp, edge⟩
    exact ⟨p, q, hp, hq, edge⟩
  · rintro ⟨p, q, hp, hq, edge⟩
    exact ⟨q, hq, p, hp, edge⟩

def addOutside (S T : Finset Vertex) (v : Vertex) : Finset Vertex :=
  if v ∈ S then T else insert v T

lemma evalOn_spec (T : Finset Vertex) :
    evalOn T = true ↔ ∃ p ∈ T, ∃ q ∈ T, (neighborMask p).testBit q.val = true := by
  rw [evalOn_eq]
  simp only [edgeFunction, inputOf, decide_eq_true_eq]
  constructor
  · exact fun ⟨p, q, hp, hq, edge⟩ => ⟨p, hp, q, hq, edge⟩
  · exact fun ⟨p, hp, q, hq, edge⟩ => ⟨p, q, hp, hq, edge⟩

lemma neighborSymmetric : ∀ p q : Vertex,
    (neighborMask p).testBit q.val = (neighborMask q).testBit p.val := by decide +kernel

lemma noLoop : ∀ p : Vertex, (neighborMask p).testBit p.val = false := by decide +kernel

lemma evalOn_insert (T : Finset Vertex) (v : Vertex) :
    evalOn (insert v T) = (evalOn T || (neighborUnion (members T)).testBit v.val) := by
  apply Bool.eq_iff_iff.mpr
  simp only [Bool.or_eq_true, evalOn_spec, neighborUnion_spec, mem_members, Finset.mem_insert]
  constructor
  · rintro ⟨p, rfl | hp, q, rfl | hq, hc⟩
    · simp [noLoop] at hc
    · exact Or.inr ⟨q, hq, (neighborSymmetric _ _).symm.trans hc⟩
    · exact Or.inr ⟨p, hp, hc⟩
    · exact Or.inl ⟨p, hp, q, hq, hc⟩
  · rintro (⟨p, hp, q, hq, hc⟩ | ⟨p, hp, hc⟩)
    · exact ⟨p, Or.inr hp, q, Or.inr hq, hc⟩
    · exact ⟨p, Or.inr hp, v, Or.inl rfl, hc⟩

def response (S T : Finset Vertex) : List Bool :=
  let vertices := members T
  let neighbors := neighborUnion vertices
  let internal := vertices.any fun q => neighbors.testBit q.val
  internal :: (List.finRange 10).map (fun v => internal || (decide (v ∉ S) && neighbors.testBit v.val))

lemma response_unfold (S T : Finset Vertex) :
    response S T = evalOn T :: (List.finRange 10).map (fun v => evalOn (addOutside S T v)) := by
  change evalOn T :: (List.finRange 10).map
    (fun v => evalOn T || (decide (v ∉ S) && (neighborUnion (members T)).testBit v.val)) = _
  congr 1
  apply List.map_congr_left
  intro v _
  by_cases h : v ∈ S
  · simp [addOutside, h]
  · simp [addOutside, h, evalOn_insert]

def required (k : Nat) : Nat := [1, 2, 4, 6, 9, 12, 9, 9, 5, 3, 2].getD k 0

