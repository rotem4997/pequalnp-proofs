def decodeMask (m : Fin 1024) : Finset Vertex :=
  Finset.univ.filter fun v => m.val.testBit v.val

lemma decodeMask_surj : Function.Surjective decodeMask := by
  apply (Fintype.bijective_iff_injective_and_card decodeMask).mpr ⟨?_, by simp⟩ |>.surjective
  intro m n eq
  apply Fin.ext
  apply Nat.eq_of_testBit_eq
  intro i
  by_cases hi : i < 10
  · have hk : (⟨i, hi⟩ : Vertex) ∈ decodeMask m ↔ (⟨i, hi⟩ : Vertex) ∈ decodeMask n := by rw [eq]
    exact Bool.eq_iff_iff.mpr (by simpa [decodeMask] using hk)
  · have power : 1024 ≤ 2 ^ i := Nat.pow_le_pow_right (by decide : 0 < (2 : Nat)) (by omega : 10 ≤ i)
    rw [Nat.testBit_eq_false_of_lt (m.isLt.trans_le power),
      Nat.testBit_eq_false_of_lt (n.isLt.trans_le power)]

def bitVertices (mask : Nat) : List Vertex :=
  (List.finRange 10).filter fun v => mask.testBit v.val

lemma decodedMembers (m : Fin 1024) : members (decodeMask m) = bitVertices m.val := by
  simp [members, decodeMask, bitVertices]

lemma decodedCard (m : Fin 1024) : (decodeMask m).card = (bitVertices m.val).length := by
  have same : (members (decodeMask m)).toFinset = decodeMask m := by
    ext i
    simp [mem_members]
  have unique : (members (decodeMask m)).Nodup := (List.nodup_finRange _).filter _
  rw [← decodedMembers m, ← List.toFinset_card_of_nodup unique, same]

def rawResponse (inside row : Nat) : List Bool :=
  let vertices := bitVertices row
  let neighbors := neighborUnion vertices
  let internal := vertices.any fun q => neighbors.testBit q.val
  internal :: (List.finRange 10).map
    (fun v => internal || (!inside.testBit v.val && neighbors.testBit v.val))

lemma rawResponse_eq (m t : Fin 1024) :
    rawResponse m.val t.val = response (decodeMask m) (decodeMask t) := by
  simp only [rawResponse, response, decodedMembers]
  simp [decodeMask]

def rows (m : Fin 1024) : List (Fin 1024) :=
  ((sampleMasks.getD (m.val / 32) #[]).getD (m.val % 32) []).map (Fin.ofNat 1024)

abbrev sampleValid (m : Fin 1024) : Prop :=
  let candidates := rows m
  required (bitVertices m.val).length ≤ candidates.length ∧
    (candidates.map (fun t => rawResponse m.val t.val)).Nodup ∧
    (candidates.all fun t => (t.val &&& m.val) == t.val) = true

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
lemma samplesValid : ∀ m : Fin 1024, sampleValid m := by decide +kernel

lemma finiteCounts (S : Finset Vertex) :
    required S.card ≤ (S.powerset.image (response S)).card := by
  obtain ⟨m, rfl⟩ := decodeMask_surj S
  obtain ⟨enough, unique, inside⟩ := samplesValid m
  let keys := (rows m).map (fun t => rawResponse m.val t.val)
  have sub : keys.toFinset ⊆ (decodeMask m).powerset.image (response (decodeMask m)) := by
    intro key hk
    obtain ⟨t, ht, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp hk)
    have lands : t.val &&& m.val = t.val := by simpa using List.all_eq_true.mp inside t ht
    refine Finset.mem_image.mpr ⟨decodeMask t, Finset.mem_powerset.mpr ?_, (rawResponse_eq m t).symm⟩
    intro v hv
    have hBit := congrArg (fun mask : Nat => mask.testBit v.val) lands
    simp only [decodeMask, Finset.mem_filter, Finset.mem_univ, true_and] at hv ⊢
    simpa [Nat.testBit_land, hv] using hBit
  exact calc
    required (decodeMask m).card ≤ (rows m).length := by rw [decodedCard]; exact enough
    _ = keys.toFinset.card := by
      rw [List.toFinset_card_of_nodup unique]
      simp
    _ ≤ _ := Finset.card_le_card sub

open PEqualNP.CircuitLowerBounds

def gateValue (w : List Bool) (g : Gate) : Bool :=
  g.op.eval (g.inputs.map fun i => w.getD i false)

def gateStep (w : List Bool) (g : Gate) : List Bool := w ++ [gateValue w g]

def run (gs : List Gate) (w : List Bool) : List Bool := gs.foldl gateStep w

lemma gateValue_eq (g : Gate) {u v : List Bool}
    (agree : ∀ i ∈ g.inputs, u.getD i false = v.getD i false) :
    gateValue u g = gateValue v g :=
  congrArg g.op.eval (List.map_congr_left agree)

lemma readAppend (w : List Bool) (b : Bool) (i : Nat) :
    (w ++ [b]).getD i false = if i = w.length then b else w.getD i false := by
  by_cases equal : i = w.length
  · subst i
    simp
  · by_cases earlier : i < w.length
    · rw [List.getD_append _ _ _ _ earlier, ite_eq_right equal]
    · have old : w.length ≤ i := by omega
      have new : (w ++ [b]).length ≤ i := by simp; omega
      rw [List.getD_eq_default _ _ new, List.getD_eq_default _ _ old, ite_eq_right equal]

lemma runRead (gs : List Gate) (w : List Bool) (i : Nat) (h : i < w.length) :
    (run gs w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    change (run gs (gateStep w g)).getD i false = _
    have earlier : i < (gateStep w g).length := by simp [gateStep]; omega
    rw [ih _ earlier, gateStep, readAppend, ite_eq_right (by omega : i ≠ w.length)]

def Cut (inside boundary : Finset Nat) (offset : Nat) (gs : List Gate) : Prop :=
  ∀ (i : Nat) (g : Gate), gs[i]? = some g → ∀ w ∈ g.inputs,
    (offset + i ∈ inside → w ∈ inside) ∧ (offset + i ∉ inside → w ∈ inside → w ∈ boundary)

def Splice (inside : Finset Nat) (a b c d : List Bool) : Prop :=
  ∀ i,
    (i ∈ inside → c.getD i false = a.getD i false ∧ d.getD i false = b.getD i false) ∧
    (i ∉ inside → c.getD i false = d.getD i false)

lemma spliceStep (inside : Finset Nat) {a b c d : List Bool} (g : Gate)
    (lengths : b.length = a.length ∧ c.length = a.length ∧ d.length = a.length)
    (prior : Splice inside a b c d)
    (newInside : a.length ∈ inside → gateValue c g = gateValue a g ∧ gateValue d g = gateValue b g)
    (newOutside : a.length ∉ inside → gateValue c g = gateValue d g) :
    Splice inside (gateStep a g) (gateStep b g) (gateStep c g) (gateStep d g) := by
  intro i
  simp only [gateStep, readAppend, lengths.1, lengths.2.1, lengths.2.2]
  by_cases hi : i = a.length
  · subst i
    simpa only [ite_true] using And.intro newInside newOutside
  · simpa only [hi, ite_false] using prior i

lemma spliceRun (inside boundary : Finset Nat) (gs : List Gate) (a b c d : List Bool)
    (lengths : b.length = a.length ∧ c.length = a.length ∧ d.length = a.length)
    (cut : Cut inside boundary a.length gs)
    (boundaryEq : ∀ i ∈ boundary, (run gs a).getD i false = (run gs b).getD i false)
    (prior : Splice inside a b c d) :
    Splice inside (run gs a) (run gs b) (run gs c) (run gs d) := by
  induction gs generalizing a b c d with
  | nil => exact prior
  | cons g tail ih =>
    have boundaryHere (w : Nat) (hw : w ∈ boundary) : a.getD w false = b.getD w false := by
      by_cases earlier : w < a.length
      · exact ((runRead (g :: tail) a w earlier).symm.trans (boundaryEq w hw)).trans
          (runRead (g :: tail) b w (by omega))
      · rw [List.getD_eq_default _ _ (by omega : a.length ≤ w),
          List.getD_eq_default _ _ (by omega : b.length ≤ w)]
    have first (w : Nat) (hw : w ∈ g.inputs) :
        (a.length ∈ inside → w ∈ inside) ∧ (a.length ∉ inside → w ∈ inside → w ∈ boundary) := by
      simpa using cut 0 g rfl w hw
    have newest := spliceStep inside g lengths prior
      (fun hi => ⟨gateValue_eq g (fun w hw => ((prior w).1 ((first w hw).1 hi)).1),
        gateValue_eq g (fun w hw => ((prior w).1 ((first w hw).1 hi)).2)⟩)
      (fun ho => gateValue_eq g (fun w hw => by
        by_cases wi : w ∈ inside
        · obtain ⟨ca, db⟩ := (prior w).1 wi
          exact (ca.trans (boundaryHere w ((first w hw).2 ho wi))).trans db.symm
        · exact (prior w).2 wi))
    apply ih (gateStep a g) (gateStep b g) (gateStep c g) (gateStep d g) _ _ boundaryEq newest
    · simp [gateStep, lengths.1, lengths.2.1, lengths.2.2]
    · intro i gate hgate w hw
      have hlookup : (g :: tail)[i + 1]? = some gate := hgate
      have shifted : (gateStep a g).length + i = a.length + (i + 1) := by simp [gateStep]; omega
      rw [shifted]
      exact cut (i + 1) gate hlookup w hw

def seeded (x : Vertex → Bool) : List Bool := List.ofFn x ++ [!x 0]

lemma readInput (x : Vertex → Bool) (i : Nat) (hi : i < 10) :
    (seeded x).getD i false = x ⟨i, hi⟩ := by
  rw [seeded, List.getD_append _ _ _ _ (by simpa using hi),
    List.getD_eq_getElem _ _ (by simpa using hi), List.getElem_ofFn]

lemma readNegated (x : Vertex → Bool) : (seeded x).getD 10 false = !x 0 := by
  simp [seeded]

def blend (S : Finset Vertex) (x y : Vertex → Bool) (i : Vertex) : Bool :=
  if i ∈ S then x i else y i

lemma startSplice (S : Finset Vertex) (inside : Finset Nat)
    (raw : ∀ i : Vertex, i.val ∈ inside ↔ i ∈ S)
    (extra : 10 ∈ inside ↔ (0 : Vertex) ∈ S) (x y outside : Vertex → Bool) :
    Splice inside (seeded x) (seeded y) (seeded (blend S x outside)) (seeded (blend S y outside)) := by
  intro i
  by_cases h : i < 10
  · simp only [readInput _ _ h]
    constructor
    · intro hi
      simp [blend, (raw ⟨i, h⟩).mp hi]
    · intro hi
      have hOutside : ⟨i, h⟩ ∉ S := fun mem => hi ((raw ⟨i, h⟩).mpr mem)
      simp [blend, hOutside]
  · by_cases he : i = 10
    · subst i
      simp only [readNegated]
      constructor
      · intro hi
        simp [blend, extra.mp hi]
      · intro hi
        have hOutside : (0 : Vertex) ∉ S := fun mem => hi (extra.mpr mem)
        simp [blend, hOutside]
    · have large (u : Vertex → Bool) : (seeded u).length ≤ i := by
        simp [seeded]
        omega
      simp only [List.getD_eq_default _ _ (large _), implies_true, and_self]

lemma readBlend (C : Circuit) (S : Finset Vertex) (inside boundary : Finset Nat)
    (raw : ∀ i : Vertex, i.val ∈ inside ↔ i ∈ S)
    (extra : 10 ∈ inside ↔ (0 : Vertex) ∈ S)
    (cut : Cut inside boundary 11 C.gates)
    (outputBoundary : C.output ∈ inside → C.output ∈ boundary)
    (x y outside : Vertex → Bool)
    (boundaryEq : ∀ i ∈ boundary,
      (C.wires (seeded x)).getD i false = (C.wires (seeded y)).getD i false) :
    C.eval (seeded (blend S x outside)) = C.eval (seeded (blend S y outside)) := by
  have final := spliceRun inside boundary C.gates (seeded x) (seeded y)
    (seeded (blend S x outside)) (seeded (blend S y outside))
    (by simp [seeded]) (by simpa [seeded] using cut) boundaryEq
    (startSplice S inside raw extra x y outside) C.output
  by_cases hOut : C.output ∈ inside
  · obtain ⟨cx, dy⟩ := final.1 hOut
    exact (cx.trans (boundaryEq _ (outputBoundary hOut))).trans dy.symm
  · exact final.2 hOut

lemma blendEmpty (S T : Finset Vertex) (hT : T ⊆ S) :
    blend S (inputOf T) (inputOf ∅) = inputOf T := by
  funext i
  by_cases hi : i ∈ S
  · simp [blend, hi]
  · have hNot : i ∉ T := fun ht => hi (hT ht)
    simp [blend, inputOf, hi, hNot]

lemma blendSingle (S T : Finset Vertex) (hT : T ⊆ S) (v : Vertex) :
    blend S (inputOf T) (inputOf {v}) = inputOf (addOutside S T v) := by
  funext i
  by_cases hi : i ∈ S
  · by_cases hv : v ∈ S
    · simp [blend, addOutside, hi, hv]
    · have hne : i ≠ v := fun eq => hv (eq ▸ hi)
      simp [blend, addOutside, inputOf, hi, hv, hne]
  · have hNot : i ∉ T := fun ht => hi (hT ht)
    by_cases hv : v ∈ S
    · have hne : i ≠ v := fun eq => hi (eq ▸ hv)
      simp [blend, addOutside, inputOf, hi, hv, hne, hNot]
    · simp [blend, addOutside, inputOf, hi, hv, hNot]

lemma response_eq (S T U : Finset Vertex) (hT : T ⊆ S) (hU : U ⊆ S)
    (agrees : ∀ y, edgeFunction (blend S (inputOf T) y) = edgeFunction (blend S (inputOf U) y)) :
    response S T = response S U := by
  rw [response_unfold S T, response_unfold S U]
  congr 1
  · simpa only [evalOn_eq, blendEmpty S T hT, blendEmpty S U hU] using agrees (inputOf ∅)
  · apply List.map_congr_left
    intro v _
    simpa only [evalOn_eq, blendSingle S T hT v, blendSingle S U hU v] using agrees (inputOf {v})

lemma boundaryCounts (C : Circuit) (computes : ∀ x, C.eval (seeded x) = edgeFunction x)
    (S : Finset Vertex) (inside boundary : Finset Nat)
    (raw : ∀ i : Vertex, i.val ∈ inside ↔ i ∈ S)
    (extra : 10 ∈ inside ↔ (0 : Vertex) ∈ S)
    (cut : Cut inside boundary 11 C.gates)
    (outputBoundary : C.output ∈ inside → C.output ∈ boundary) :
    required S.card ≤ (Finset.univ.image fun (x : Vertex → Bool) (w : ↥boundary) =>
      (C.wires (seeded x)).getD w false).card := by
  let signature (x : Vertex → Bool) (w : ↥boundary) : Bool := (C.wires (seeded x)).getD w false
  let decode (v : ↥boundary → Bool) : List Bool := by
    classical
    exact if h : ∃ T : Finset Vertex, T ⊆ S ∧ signature (inputOf T) = v then
      response S (Classical.choose h) else []
  apply (finiteCounts S).trans
  apply Finset.card_le_card_of_surjOn decode
  intro y hy
  obtain ⟨T, hT, rfl⟩ := Finset.mem_image.mp hy
  have subsetT := Finset.mem_powerset.mp hT
  refine ⟨signature (inputOf T), Finset.mem_image.mpr ⟨inputOf T, Finset.mem_univ _, rfl⟩, ?_⟩
  have found : ∃ U : Finset Vertex, U ⊆ S ∧ signature (inputOf U) = signature (inputOf T) :=
    ⟨T, subsetT, rfl⟩
  unfold decode
  rw [dite_eq_left found]
  have props := Classical.choose_spec found
  apply response_eq S _ T props.1 subsetT
  intro outside
  rw [← computes, ← computes]
  apply readBlend C S inside boundary raw extra cut outputBoundary
  intro i hi
  exact congrFun props.2 ⟨i, hi⟩


end PEqualNP.Outside.L_meta_4083

