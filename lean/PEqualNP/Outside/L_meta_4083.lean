theorem PEqualNP.Outside.L_meta_4083 :
    ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x2 : Fin (10 : ℕ) → Bool), x1.eval (List.ofFn x2 ++ [!x2 (0 : Fin (10 : ℕ))]) = (fun (x3 : Fin (10 : ℕ) → Bool) => Decidable.decide (∃ (x4 : Fin (10 : ℕ)) (x5 : Fin (10 : ℕ)), x3 x4 = Bool.true ∧ x3 x5 = Bool.true ∧ ([(50 : ℕ), (69 : ℕ), (138 : ℕ), (276 : ℕ), (521 : ℕ), (385 : ℕ), (770 : ℕ), (548 : ℕ), (104 : ℕ), (208 : ℕ)].getD ↑x4 (0 : ℕ)).testBit ↑x5 = Bool.true)) x2) → ∀ (x3 : Finset (Fin (10 : ℕ))) (x4 x5 : Finset ℕ), (∀ (x6 : Fin (10 : ℕ)), ↑x6 ∈ x4 ↔ x6 ∈ x3) → ((10 : ℕ) ∈ x4 ↔ (0 : Fin (10 : ℕ)) ∈ x3) → (∀ (x8 : Fin x1.size), ∀ x9 ∈ (x1.gates.get x8).inputs, ((11 : ℕ) + ↑x8 ∈ x4 → x9 ∈ x4) ∧ ((11 : ℕ) + ↑x8 ∉ x4 → x9 ∈ x4 → x9 ∈ x5)) → (x1.output ∈ x4 → x1.output ∈ x5) → [(1 : ℕ), (2 : ℕ), (4 : ℕ), (6 : ℕ), (9 : ℕ), (12 : ℕ), (9 : ℕ), (9 : ℕ), (5 : ℕ), (3 : ℕ), (2 : ℕ)].getD x3.card (0 : ℕ) ≤ (Finset.image (fun (x10 : Fin (10 : ℕ) → Bool) (x11 : ↥x5) => (x1.wires (List.ofFn x10 ++ [!x10 (0 : Fin (10 : ℕ))])).getD (↑x11) Bool.false) Finset.univ).card := by
  intro C computes S inside boundary raw extra links outputBoundary
  apply boundaryCounts C computes S inside boundary raw extra _ outputBoundary
  intro i g hg w hw
  obtain ⟨hi, eq⟩ := List.getElem?_eq_some_iff.mp hg
  subst g
  exact links ⟨i, hi⟩ w hw
