import PEqualNP.Defs

-- Credit: the case-split reduction shape of foudress (R_meta_1710_64, #23768) and willakone
-- (R_meta_17910_64). This is a split on the output wire of x1: one of the 14 inputs, or a later wire; each piece is the step with that one extra hypothesis.
theorem PEqualNP.Outside.R_meta_17507_1
    (caseA : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), x1.output < (14 : ℕ) → x1.size ≤ (27 : ℕ) →     PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 →       (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) →         (PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ)).op = PEqualNP.CircuitLowerBounds.GateOp.and →           (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), x7 ∈ PEqualNP.CircuitLowerBounds.fanoLines x8 ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) →             (have x7 : ℕ → ℕ → Bool := fun (x7 x8 : ℕ) => PEqualNP.EdgeOwnership.gateVal (14 : ℕ) x1 x7 fun (x9 : Fin (14 : ℕ)) => Decidable.decide (↑x9 = x8);               ∃ (x8 : Fin x1.size) (x9 : Fin x1.size), (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x8).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x9).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ x7 ↑x8 (7 : ℕ) = Bool.true ∧ x7 ↑x8 (0 : ℕ) = Bool.false ∧ x7 ↑x9 (0 : ℕ) = Bool.true ∧ x7 ↑x9 (7 : ℕ) = Bool.false) →               ∃ (x8 : List (ℕ × ℕ)),                 x8.length = (7 : ℕ) ∧                   (∀ (x9 : Fin x8.length), (x8.get x9).1 < x1.size - ↑x9) ∧                     have x9 : PEqualNP.CircuitLowerBounds.Circuit := List.foldl (fun (x9 : PEqualNP.CircuitLowerBounds.Circuit) (x10 : ℕ × ℕ) => PEqualNP.CircuitMoves.eraseGate (14 : ℕ) x9 x10.1 x10.2) x1 x8;                     ∀ (x10 : Fin (14 : ℕ) → Bool), x10 (0 : Fin (14 : ℕ)) = Bool.false → x10 (7 : Fin (14 : ℕ)) = Bool.false → x9.eval (List.ofFn x10) = x1.eval (List.ofFn x10))
    (caseB : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (14 : ℕ) ≤ x1.output → x1.size ≤ (27 : ℕ) →     PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 →       (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) →         (PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ)).op = PEqualNP.CircuitLowerBounds.GateOp.and →           (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), x7 ∈ PEqualNP.CircuitLowerBounds.fanoLines x8 ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) →             (have x7 : ℕ → ℕ → Bool := fun (x7 x8 : ℕ) => PEqualNP.EdgeOwnership.gateVal (14 : ℕ) x1 x7 fun (x9 : Fin (14 : ℕ)) => Decidable.decide (↑x9 = x8);               ∃ (x8 : Fin x1.size) (x9 : Fin x1.size), (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x8).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x9).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ x7 ↑x8 (7 : ℕ) = Bool.true ∧ x7 ↑x8 (0 : ℕ) = Bool.false ∧ x7 ↑x9 (0 : ℕ) = Bool.true ∧ x7 ↑x9 (7 : ℕ) = Bool.false) →               ∃ (x8 : List (ℕ × ℕ)),                 x8.length = (7 : ℕ) ∧                   (∀ (x9 : Fin x8.length), (x8.get x9).1 < x1.size - ↑x9) ∧                     have x9 : PEqualNP.CircuitLowerBounds.Circuit := List.foldl (fun (x9 : PEqualNP.CircuitLowerBounds.Circuit) (x10 : ℕ × ℕ) => PEqualNP.CircuitMoves.eraseGate (14 : ℕ) x9 x10.1 x10.2) x1 x8;                     ∀ (x10 : Fin (14 : ℕ) → Bool), x10 (0 : Fin (14 : ℕ)) = Bool.false → x10 (7 : Fin (14 : ℕ)) = Bool.false → x9.eval (List.ofFn x10) = x1.eval (List.ofFn x10)) :
    ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit),   x1.size ≤ (27 : ℕ) →     PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 →       (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) →         (PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ)).op = PEqualNP.CircuitLowerBounds.GateOp.and →           (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), x7 ∈ PEqualNP.CircuitLowerBounds.fanoLines x8 ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) →             (have x7 : ℕ → ℕ → Bool := fun (x7 x8 : ℕ) => PEqualNP.EdgeOwnership.gateVal (14 : ℕ) x1 x7 fun (x9 : Fin (14 : ℕ)) => Decidable.decide (↑x9 = x8);               ∃ (x8 : Fin x1.size) (x9 : Fin x1.size), (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x8).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt x1 ↑x9).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ x7 ↑x8 (7 : ℕ) = Bool.true ∧ x7 ↑x8 (0 : ℕ) = Bool.false ∧ x7 ↑x9 (0 : ℕ) = Bool.true ∧ x7 ↑x9 (7 : ℕ) = Bool.false) →               ∃ (x8 : List (ℕ × ℕ)),                 x8.length = (7 : ℕ) ∧                   (∀ (x9 : Fin x8.length), (x8.get x9).1 < x1.size - ↑x9) ∧                     have x9 : PEqualNP.CircuitLowerBounds.Circuit := List.foldl (fun (x9 : PEqualNP.CircuitLowerBounds.Circuit) (x10 : ℕ × ℕ) => PEqualNP.CircuitMoves.eraseGate (14 : ℕ) x9 x10.1 x10.2) x1 x8;                     ∀ (x10 : Fin (14 : ℕ) → Bool), x10 (0 : Fin (14 : ℕ)) = Bool.false → x10 (7 : Fin (14 : ℕ)) = Bool.false → x9.eval (List.ofFn x10) = x1.eval (List.ofFn x10) := by
  intro x1
  rcases Nat.lt_or_ge x1.output (14 : ℕ) with h | h
  · exact @caseA x1 h
  · exact @caseB x1 h
