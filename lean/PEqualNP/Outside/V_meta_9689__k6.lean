open PEqualNP.Library.LRAT PEqualNP.Library.LRAT.LinkN

def NoNot (s : ℕ) (M : Model) : Prop := ∀ j < s, M.op j ≠ 3

lemma noNot_mv {n s d t : ℕ} {M : Model} (h : NoNot s M) :
    NoNot s (mv n s M d t) := by
  intro j hj
  simp only [mv]
  split_ifs
  · decide
  · exact h _ (by omega)
  · exact h _ hj

lemma noNot_xsw {n s j : ℕ} {M : Model} (h : NoNot s M) (hj : j + 1 < s) :
    NoNot s (xsw n M j) := by
  intro i hi
  simp only [xsw]
  split_ifs <;> exact h _ (by omega)

lemma normal_noNot {n s : ℕ} {g : ℕ → Bool} {R : ℕ → Prop} {M : Model} (hv : Valid n s g R M)
    (hmono : NoNot s M)
    (hmin : ∀ M', Valid n s g R M' → NoNot s M' → meas2 n s M' < meas2 n s M → False) : NF n s M := by
  classical
  have hmv : ∀ d t, d < s → TgtOk n d t →
      (M.Read n s d → ∀ r, R r → M.w d r = tval n M d t r) →
      (¬ M.pad n d ∨ ∃ i < d, ¬ M.pad n i) → False := by
    intro d t hd ht htr hpos
    have hv' := valid_mv hv hd ht htr
    exact hmin _ hv' (noNot_mv hmono) (meas2_mv hv hv' hd hpos)
  have htriv : ∀ d < s, ¬ M.pad n d →
      (∃ t, TgtOk n d t ∧ ∀ r, R r → M.w d r = tval n M d t r) → False := by
    intro d hd hnp ⟨t, ht, hw⟩
    exact hmv d t hd ht (fun _ => hw) (Or.inl hnp)
  have padOp : ∀ j < s, M.op j = 2 → M.pad n j := by
    intro j hj h2
    by_contra hnp
    exact htriv j hj hnp (op2_triv hv hj h2)
  have noF : ∀ j < s, ¬ M.pad n j → M.s1 j ≠ n + j ∧ M.s2 j ≠ n + j := by
    intro j hj hnp
    by_contra hc
    have hF : M.s1 j = n + j ∨ M.s2 j = n + j := by tauto
    refine htriv j hj hnp (false_src hv hj ?_)
    rcases hF with h | h
    · exact Or.inl fun r _ => by rw [h]; simp [Model.sv]
    · exact Or.inr fun r _ => by rw [h]; simp [Model.sv]
  have padRd : ∀ j < s, ∀ i < j, M.pad n i → M.s1 j ≠ n + i ∧ M.s2 j ≠ n + i := by
    intro j hj i hi hpi
    by_contra hc
    have hT : M.s1 j = n + i ∨ M.s2 j = n + i := by tauto
    have hnp : ¬ M.pad n j := fun hp' => by
      rcases hT with h | h
      · have := hp'.2.1; omega
      · have := hp'.2.2; omega
    have e : ∀ r, R r → M.sv n j (n + i) r = true := by
      intro r hr
      unfold Model.sv
      simp only [if_neg (show ¬ n + i < n by omega), if_pos (show n + i < n + j by omega),
        show n + i - n = i by omega]
      exact pad_w hv (by omega) hpi hr
    refine htriv j hj hnp (true_src hv hj ?_)
    rcases hT with h | h
    · exact Or.inl fun r hr => by rw [h]; exact e r hr
    · exact Or.inr fun r hr => by rw [h]; exact e r hr
  have notNot : ∀ j < s, ∀ i < j, M.op j = 3 → M.op i = 3 → M.s1 j ≠ n + i := by
    intro j hj i hi h3 hi3 he
    exact htriv j hj (fun hp => by have := hp.1; omega) (notnot_triv hv hj hi h3 hi3 he)
  have ord : ∀ j < s, ¬ M.pad n j → M.s1 j < M.s2 j ∨ (M.op j = 3 ∧ M.s1 j = M.s2 j) := by
    intro j hj hnp
    by_contra hc
    by_cases he : M.s1 j = M.s2 j
    · exact htriv j hj hnp (same_src hv hj (fun h3 => hc (Or.inr ⟨h3, he⟩)) he)
    · exact hmin _ (valid_sw hv j) (fun i hi => hmono i hi) (meas2_sw hv hj (by omega))
  have pre : ∀ j, j + 1 < s → M.pad n (j + 1) → M.pad n j := by
    intro j hj hp1
    by_contra hnp
    exact hmv (j + 1) 1 hj (Or.inr (Or.inl rfl))
      (fun _ r hr => by rw [pad_w hv hj hp1 hr]; simp [tval]) (Or.inr ⟨j, by omega, hnp⟩)
  have rd : ∀ j < s, ¬ M.pad n j → M.Read n s j := by
    intro j hj hnp
    by_contra hc
    exact hmv j 0 hj (Or.inl rfl) (fun h => absurd h hc) (Or.inl hnp)
  refine {
    pre := pre
    padOp := padOp
    noF := noF
    noPadRd := padRd
    ord := ord
    notNot := notNot
    used := ?_
    out := ?_ }
  · intro j hj hnp
    rcases rd j (by omega) hnp with h | h
    · exact h
    · exfalso
      by_cases hl : M.pad n (s - 1)
      · have hall : ∀ m, m < s → M.pad n (s - 1 - m) := by
          intro m
          induction m with
          | zero => intro _; simpa using hl
          | succ m ih =>
            intro hm
            have := pre (s - 1 - (m + 1)) (by omega)
              (by rw [show s - 1 - (m + 1) + 1 = s - 1 - m by omega]; exact ih (by omega))
            exact this
        exact hnp (by
          have := hall (s - 1 - j) (by omega)
          rwa [show s - 1 - (s - 1 - j) = j by omega] at this)
      · rcases rd (s - 1) (by omega) hl with ⟨i, hi1, hi2, _⟩ | h'
        · omega
        · omega
  · intro hs
    by_cases h6 : M.pad n (s - 1)
    · exact Or.inr h6
    · rcases rd (s - 1) (by omega) h6 with ⟨j, hj1, hj2, _⟩ | h
      · omega
      · left; omega

/-- A model of least `meas2` is lexicographically ordered. -/
lemma lex_noNot {n s : ℕ} {g : ℕ → Bool} {R : ℕ → Prop} {M : Model} (hv : Valid n s g R M)
    (hmono : NoNot s M)
    (hmin : ∀ M', Valid n s g R M' → NoNot s M' → meas2 n s M' < meas2 n s M → False) : LexNF n s M := by
  have hnf := normal_noNot hv hmono hmin
  intro j hj hnp ha hb
  have hnp1 : ¬ M.pad n (j + 1) := fun h => hnp (hnf.pre j hj h)
  have f0 := hnf.noF j (by omega) hnp
  have f1 := hnf.noF (j + 1) hj hnp1
  have l1 := hv.s1_le j (by omega)
  have l2 := hv.s2_le j (by omega)
  have l3 := hv.s1_le (j + 1) hj
  have l4 := hv.s2_le (j + 1) hj
  have h1 : M.s1 j < n + j := by omega
  have h2 : M.s2 j < n + j := by omega
  have h3 : M.s1 (j + 1) < n + j := by omega
  have h4 : M.s2 (j + 1) < n + j := by omega
  have o0 := hv.op_lt j (by omega)
  have o1 := hv.op_lt (j + 1) hj
  have o0' : M.op j ≠ 2 := fun h => hnp (hnf.padOp j (by omega) h)
  have o1' : M.op (j + 1) ≠ 2 := fun h => hnp1 (hnf.padOp (j + 1) hj h)
  -- a strictly smaller key at `j + 1` contradicts minimality through `xsw`
  have hx : lexKey n s M (j + 1) < lexKey n s M j → False := fun hlt =>
    hmin _ (valid_xsw hv hj h1 h2 h3 h4) (noNot_xsw hmono hj) (meas2_xsw hv hj h1 h2 h3 h4 hlt)
  have hK : ∀ y z : ℕ, y < n + j → z < 4 → y * 4 + z < 4 * (n + s + 1) := by
    intro y z hy hz; omega
  by_contra hc
  rcases lt_trichotomy (M.s1 j) (M.s1 (j + 1)) with e1 | e1 | e1
  · exact hc (Or.inl e1)
  · rcases lt_trichotomy (M.s2 j) (M.s2 (j + 1)) with e2 | e2 | e2
    · exact hc (Or.inr ⟨e1, Or.inl e2⟩)
    · by_cases e3 : M.op j = M.op (j + 1)
      · -- gate `j + 1` is a copy of wire `n + j`
        have hw : ∀ r, R r → M.w (j + 1) r = M.sv n (j + 1) (n + j) r := by
          intro r hr
          have hs : ∀ k, k < n + j → M.sv n (j + 1) k r = M.sv n j k r := by
            intro k hk
            unfold Model.sv
            by_cases h6 : k < n
            · simp [h6]
            · simp only [if_neg h6, if_pos hk, if_pos (show k < n + (j + 1) by omega)]
          rw [hv.w_eq (j + 1) hj r hr, hs _ h3, hs _ h4, ← e1, ← e2, ← e3,
            ← hv.w_eq j (by omega) r hr]
          unfold Model.sv
          simp only [if_neg (show ¬ n + j < n by omega), if_pos (show n + j < n + (j + 1) by omega),
            show n + j - n = j by omega]
        obtain ⟨t, ht, htw⟩ := copy_tgt hv hj (k := n + j) (by omega) hw
        have hv' := valid_mv hv hj ht (fun _ => htw)
        exact hmin _ hv' (noNot_mv hmono) (meas2_mv hv hv' hj (Or.inl hnp1))
      · have q0 := hnf.ord j (by omega) hnp
        have q1 := hnf.ord (j + 1) hj hnp1
        have n0 := hv.not_eq j (by omega)
        have n1 := hv.not_eq (j + 1) hj
        have : M.op j = 0 ∧ M.op (j + 1) = 1 ∨ M.op (j + 1) < M.op j := by omega
        rcases this with h | h
        · exact hc (Or.inr ⟨e1, Or.inr ⟨e2, h⟩⟩)
        · apply hx
          unfold lexKey
          exact lex3 _ _ _ _ _ _ _ (hK _ _ h4 o1) o1 (Or.inr ⟨e1.symm, Or.inr ⟨e2.symm, h⟩⟩)
    · apply hx
      unfold lexKey
      exact lex3 _ _ _ _ _ _ _ (hK _ _ h4 o1) o1 (Or.inr ⟨e1.symm, Or.inl e2⟩)
  · apply hx
    unfold lexKey
    exact lex3 _ _ _ _ _ _ _ (hK _ _ h4 o1) o1 (Or.inl e1)

lemma exists_normal_noNot {n s : ℕ} {g : ℕ → Bool} {R : ℕ → Prop}
    (h : ∃ M, Valid n s g R M ∧ NoNot s M) :
    ∃ M, Valid n s g R M ∧ NoNot s M ∧ NF n s M ∧ LexNF n s M := by
  classical
  have hex : ∃ m, ∃ M, Valid n s g R M ∧ NoNot s M ∧ meas2 n s M = m := by
    obtain ⟨M, hv, hm⟩ := h
    exact ⟨_, M, hv, hm, rfl⟩
  obtain ⟨M, hv, hmono, hm⟩ := Nat.find_spec hex
  have hmin : ∀ M', Valid n s g R M' → NoNot s M' → meas2 n s M' < meas2 n s M → False := by
    intro M' hv' hmono' hlt
    exact Nat.find_min hex (hm ▸ hlt) ⟨M', hv', hmono', rfl⟩
  exact ⟨M, hv, hmono, normal_noNot hv hmono hmin, lex_noNot hv hmono hmin⟩

lemma code_noNot (n s : ℕ) (C : Circuit) (hC : Monotone2 C) : NoNot s (ofCirc n s C) := by
  intro j _
  have hgate : (gateAt C j).op = .and ∨ (gateAt C j).op = .or := by
    unfold gateAt
    rw [List.getD_eq_getElem?_getD]
    cases h : C.gates[j]? with
    | none => exact Or.inl rfl
    | some gate => exact (hC gate (List.mem_of_getElem? h)).1
  rcases h : gateAt C j with ⟨op, inputs⟩
  rw [h] at hgate
  change (code n (gateAt C j) j).1 ≠ 3
  rw [h]
  rcases hgate with (rfl | rfl) <;>
    rcases inputs with _ | ⟨a, _ | ⟨b, rest⟩⟩ <;> simp [PEqualNP.Library.LRAT.LinkN.code]

def goalFn (x : Fin 4 → Bool) : Bool := (429 : ℕ).testBit (tableIndex x)

def litRow (r : ℕ) : ℕ := r + 16 * (15 - r)

def goalRow (r : ℕ) : Bool := (429 : ℕ).testBit (r % 16)

lemma row_eval : ∀ x : Fin 4 → Bool,
    xr 8 (litRow (tableIndex x)) = List.ofFn x ++ List.ofFn (fun i => !x i) ∧
    goalRow (litRow (tableIndex x)) = goalFn x := by decide

def rows : List ℕ := [15, 60, 90, 120, 150, 165, 195, 225]

def formula : List (List ℕ) := enc2 8 5 goalRow rows ++
  (List.range 5).map (fun j => [Q (ix 8 5 0 j 3)])

def compactVar (v : ℕ) : ℕ :=
  let i := v - 1
  i / (266 + 5) * 16 + i % (266 + 5) % 16 + 1

def expandVar (v : ℕ) : ℕ :=
  let block := (v - 1) / 16
  let kind := block / (5 + 1)
  let slot := (v - 1) % 16
  block * (266 + 5) + (if 3 ≤ kind ∧ kind ≤ 5 then litRow slot else slot) + 1

def compactLit (l : ℕ) : ℕ := 2 * compactVar (l / 2) + l % 2

def compactFormula : List (List ℕ) := formula.map (List.map compactLit)

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
lemma compact_roundtrip :
    (formula.all fun c => c.all fun l => expandVar (compactVar (l / 2)) == l / 2) = true := by
  decide +kernel

lemma compact_sat (h : FormulaSat formula) : FormulaSat compactFormula := by
  obtain ⟨a, ha⟩ := h
  refine ⟨a ∘ expandVar, ?_⟩
  intro d hd
  obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hd
  obtain ⟨l, hl, hs⟩ := ha c hc
  have hr := List.all_eq_true.mp (List.all_eq_true.mp compact_roundtrip c hc) l hl
  have hdv : compactLit l / 2 = compactVar (l / 2) := by unfold compactLit; omega
  have hmd : compactLit l % 2 = l % 2 := by unfold compactLit; omega
  refine ⟨compactLit l, List.mem_map_of_mem hl, ?_⟩
  simpa only [litVal, hdv, hmd, Function.comp_apply, beq_iff_eq.mp hr] using hs

lemma sat_of_lit (h : HasLitSize 4 goalFn 5) : FormulaSat formula := by
  obtain ⟨C, hC, hs, he⟩ := h
  have fan : FanInTwo C := by
    intro gate hm
    obtain ⟨hop, hlen⟩ := hC gate hm
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop ⊢
    exact ⟨hop.imp_right Or.inl, hlen⟩
  have hrow : ∀ r ∈ rows, r < 2 ^ 8 := by decide
  have hall : ∀ r ∈ rows, ∃ x : Fin 4 → Bool, litRow (tableIndex x) = r := by decide
  have hv := valid_ofCirc 8 5 goalRow (· ∈ rows) C fan hs (by
    intro r hr
    obtain ⟨x, rfl⟩ := hall r hr
    rw [(row_eval x).1, (row_eval x).2]
    exact he x)
  obtain ⟨M, hv', hno, hn, hl⟩ := exists_normal_noNot ⟨_, hv, code_noNot 8 5 C hC⟩
  refine ⟨val 8 5 M, ?_⟩
  intro c hc
  rcases List.mem_append.mp hc with hc | hc
  · exact enc2_sat hrow hv' hn hl c hc
  · obtain ⟨j, hj, rfl⟩ := List.mem_map.mp hc
    have hjs := List.mem_range.mp hj
    refine ⟨_, List.mem_singleton_self _, ?_⟩
    rw [litVal_Q, v_op M (by omega) (by decide)]
    simp [hno j hjs]

def witnessCirc : Circuit := ⟨[⟨.or, [0, 6]⟩, ⟨.or, [1, 2]⟩, ⟨.and, [4, 5]⟩, ⟨.and, [7, 9]⟩, ⟨.or, [10, 11]⟩, ⟨.and, [8, 12]⟩], 13⟩

lemma upper_eval : ∀ x : Fin 4 → Bool,
    witnessCirc.eval (List.ofFn x ++ List.ofFn (fun i => !x i)) = goalFn x := by decide

lemma upper : HasLitSize 4 goalFn 6 := by
  exact ⟨witnessCirc, by simp [Monotone2, witnessCirc], by decide, upper_eval⟩

