open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

def majValue (a b c : Bool) : Bool := (a && b) || ((a || b) && c)

def majSigned (sign : Bool) (x : Fin 3 → Bool) : Bool :=
  sign ^^ majValue (x 0) (x 1) (x 2)

def lowerF (sign : Bool) (x : Fin 4 → Bool) : Bool :=
  sign ^^ (x 0 ^^ majValue (x 1) (x 2) (x 3))

def higherF (sign : Bool) (x : Fin 5 → Bool) : Bool :=
  sign ^^ (x 0 ^^ x 1 ^^ majValue (x 2) (x 3) (x 4))

theorem budget_widen {n a b : ℕ} {f : (Fin n → Bool) → Bool}
    (hc : HasClean n f a) (hab : a ≤ b) : HasClean n f b := by
  obtain ⟨gs, o, clean, len, eq⟩ := hc
  exact ⟨gs, o, clean, len.trans hab, eq⟩

theorem positive_clean {n : ℕ} {f : (Fin n → Bool) → Bool}
    (nonzero : ∃ x, f x = true) (nonproj : ∀ j : Fin n, ∃ x, x j ≠ f x)
    {s : ℕ} (h : HasClean n f s) : 1 ≤ s := by
  obtain ⟨gs, o, clean, size, good⟩ := h
  by_contra small
  have empty : gs = [] := List.length_eq_zero_iff.mp (by omega)
  subst gs
  by_cases ho : o < n
  · obtain ⟨x, hx⟩ := nonproj ⟨o, ho⟩
    exact hx ((vl_input [] x o ho).symm.trans (good x))
  · obtain ⟨x, hx⟩ := nonzero
    have he := good x
    change (List.ofFn x).getD o false = f x at he
    rw [List.getD_eq_default _ _ (by simp; omega), hx] at he
    contradiction

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem majority_lower (sign : Bool) (s : ℕ) (h : HasClean 3 (majSigned sign) s) : 4 ≤ s := by
  by_contra small
  apply (mixed_first_gate 2 3 (majSigned sign) (fun _ => True) ?_ ?_ ?_ ?_ ?_ ?_) (budget_widen h (by omega))
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · simp
  · intro i _ b k hc
    have w : ∀ sg (i : Fin 3) (b : Bool),
        (∃ x : Fin 2 → Bool, majSigned sg (ins i b x) = true) ∧
        (∀ j : Fin 2, ∃ x : Fin 2 → Bool, x j ≠ majSigned sg (ins i b x)) := by decide +kernel
    obtain ⟨p, q⟩ := w sign i b
    have := positive_clean p q hc
    omega
  · intros; omega

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem lower_signed (sign : Bool) (s : ℕ) (h : HasClean 4 (lowerF sign) s) : 8 ≤ s := by
  have majco (i : Fin 4) (hi : 1 ≤ i.val) (b : Bool) (k : ℕ)
      (hc : HasClean 3 (fun x => lowerF sign (ins i b x)) k) : 5 ≤ k := by
    have eq : ∀ sg (i : Fin 4) b, 1 ≤ i.val → ∀ x : Fin 3 → Bool, lowerF sg (ins i b x) =
        (sg ^^ (x 0 ^^ (if b then x 1 || x 2 else x 1 && x 2))) := by decide +kernel
    rw [funext (eq sign i b hi)] at hc
    exact split_one sign b k hc
  by_contra small
  apply (mixed_first_gate 3 7 (lowerF sign) (fun i => 1 ≤ i.val) ?_ ?_ ?_ ?_ ?_ ?_) (budget_widen h (by omega))
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · intro i hi b k hc
    have := majco i hi b k hc
    omega
  · intro i b k hc
    by_cases hi : 1 ≤ i.val
    · have := majco i hi b k hc; omega
    · have eq : ∀ sg (i : Fin 4) b, ¬1 ≤ i.val → ∀ x : Fin 3 → Bool,
            lowerF sg (ins i b x) = majSigned (sg ^^ b) x := by decide +kernel
      rw [funext (eq sign i b hi)] at hc
      have := majority_lower (sign ^^ b) k hc
      omega

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
theorem higher (sign : Bool) (s : ℕ) (h : HasClean 5 (higherF sign) s) : 12 ≤ s := by
  have majco (i : Fin 5) (hi : 2 ≤ i.val) (b : Bool) (k : ℕ)
      (hc : HasClean 4 (fun x => higherF sign (ins i b x)) k) : 9 ≤ k := by
    have eq : ∀ sg (i : Fin 5) b, 2 ≤ i.val → ∀ x : Fin 4 → Bool, higherF sg (ins i b x) =
        (sg ^^ (x 0 ^^ x 1 ^^ (if b then x 2 || x 3 else x 2 && x 3))) := by decide +kernel
    rw [funext (eq sign i b hi)] at hc
    exact split_two sign b k hc
  by_contra small
  apply (mixed_first_gate 4 11 (higherF sign) (fun i => 2 ≤ i.val) ?_ ?_ ?_ ?_ ?_ ?_) (budget_widen h (by omega))
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · cases sign <;> decide +kernel
  · intro i hi b k hc
    have := majco i hi b k hc
    omega
  · intro i b k hc
    by_cases hi : 2 ≤ i.val
    · have := majco i hi b k hc; omega
    · have eq : ∀ sg (i : Fin 5) b, ¬2 ≤ i.val → ∀ x : Fin 4 → Bool,
            higherF sg (ins i b x) = lowerF (sg ^^ b) x := by decide +kernel
      rw [funext (eq sign i b hi)] at hc
      have := lower_signed (sign ^^ b) k hc
      omega

end PEqualNP.Outside.L_meta_10165.FirstGate

theorem PEqualNP.Outside.L_meta_10165 : ¬ (PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit ((1 * (x 0).toNat + 2 * (x 1).toNat + 4 * (x 2).toNat) + (1 * (x 3).toNat + 2 * (x 4).toNat + 4 * (x 5).toNat)) 2) 12) := by
  intro h
  have bound := PEqualNP.Outside.L_meta_10165.FirstGate.higher false 11 (PEqualNP.Outside.L_meta_10165.FirstGate.split_adder h)
  omega
