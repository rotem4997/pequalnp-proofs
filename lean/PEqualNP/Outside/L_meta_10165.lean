namespace Rewire

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

/-- The renaming of wires: input wire `w < n` goes to `π w`, gate wire `w ≥ n` to
`w - n + m`. -/
def wmap (n m : ℕ) (π : Fin n → Fin m) (w : ℕ) : ℕ :=
  if h : w < n then (π ⟨w, h⟩ : ℕ) else w - n + m

/-- A gate with its wires renamed. -/
def relGate (n m : ℕ) (π : Fin n → Fin m) (g : Gate) : Gate :=
  ⟨g.op, g.inputs.map (wmap n m π)⟩

/-- A circuit with its wires renamed. -/
def relabel (n m : ℕ) (π : Fin n → Fin m) (C : Circuit) : Circuit :=
  ⟨C.gates.map (relGate n m π), wmap n m π C.output⟩

/-- One gate evaluated on a wire list. -/
def step (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

/-- The invariant: the wire lists match along the renaming. -/
def Rel (n m : ℕ) (π : Fin n → Fin m) (W W' : List Bool) : Prop :=
  n ≤ W.length ∧ W'.length + n = W.length + m ∧
    ∀ w : ℕ, W'.getD (wmap n m π w) false = W.getD w false

theorem rel_step (n m : ℕ) (π : Fin n → Fin m) (W W' : List Bool) (g : Gate)
    (h : Rel n m π W W') : Rel n m π (step W g) (step W' (relGate n m π g)) := by
  obtain ⟨h1, h2, h3⟩ := h
  have hv : (relGate n m π g).op.eval
      ((relGate n m π g).inputs.map fun i => W'.getD i false)
      = g.op.eval (g.inputs.map fun i => W.getD i false) := by
    simp only [relGate, List.map_map]
    congr 1
    apply List.map_congr_left
    intro a _
    exact h3 a
  refine ⟨by simp [step]; omega, by simp [step]; omega, ?_⟩
  intro w
  simp only [step, hv]
  rcases Nat.lt_trichotomy w W.length with hw | hw | hw
  · have hlt : wmap n m π w < W'.length := by
      unfold wmap
      split
      · have := (π ⟨w, by assumption⟩).2; omega
      · omega
    rw [List.getD_append _ _ _ _ hlt, List.getD_append _ _ _ _ hw]
    exact h3 w
  · have he : wmap n m π w = W'.length := by
      unfold wmap
      split
      · omega
      · omega
    rw [he, hw, getD_snoc_eq, getD_snoc_eq]
  · have hge : W'.length + 1 ≤ wmap n m π w := by
      unfold wmap
      split
      · omega
      · omega
    rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by simp; omega)]

theorem rel_fold (n m : ℕ) (π : Fin n → Fin m) (gs : List Gate) :
    ∀ W W' : List Bool, Rel n m π W W' →
      Rel n m π (gs.foldl step W) ((gs.map (relGate n m π)).foldl step W') := by
  induction gs with
  | nil => intro W W' h; exact h
  | cons g gs ih =>
    intro W W' h
    exact ih _ _ (rel_step n m π W W' g h)

theorem rel_init (n m : ℕ) (π : Fin n → Fin m) (x : Fin m → Bool) :
    Rel n m π (List.ofFn (x ∘ π)) (List.ofFn x) := by
  refine ⟨by simp, by simp; omega, ?_⟩
  intro w
  unfold wmap
  split
  · rename_i hw
    rw [List.getD_eq_getElem _ _ (by simp), List.getD_eq_getElem _ _ (by simpa using hw)]
    simp
  · rename_i hw
    rw [List.getD_eq_default _ _ (by simp), List.getD_eq_default _ _ (by simp; omega)]

/-- Renaming inputs along any map keeps the circuit size. -/
theorem relabel_size {n m : ℕ} (π : Fin n → Fin m) (h : (Fin n → Bool) → Bool) (s : ℕ)
    (hc : HasCircuitSize n h s) : HasCircuitSize m (fun x => h (x ∘ π)) s := by
  obtain ⟨C, ok, hsz, hev⟩ := hc
  refine ⟨relabel n m π C, ?_, ?_, ?_⟩
  · intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact ⟨(ok g0 hg0).1, by simpa [relGate] using (ok g0 hg0).2⟩
  · simpa [relabel, Circuit.size] using hsz
  · intro x
    show _ = h (x ∘ π)
    rw [← hev (x ∘ π)]
    have := (rel_fold n m π C.gates _ _ (rel_init n m π x)).2.2 C.output
    exact this

end Rewire

theorem circuit_of_clean {n s : ℕ} {f : (Fin n → Bool) → Bool} (h : HasClean n f s) : HasCircuitSize n f s := by
  obtain ⟨gs,o,hcl,hs,he⟩ := h
  exact ⟨⟨gs,o⟩,fun g hg => (clean_nok n gs hcl g hg).1,hs,he⟩

theorem split_one (sign join : Bool) (s : ℕ)
    (h : HasClean 3 (fun x => sign ^^ (x 0 ^^ (if join then x 1 || x 2 else x 1 && x 2))) s) : 5 ≤ s := by
  let f := fun x : Fin 3 → Bool => sign ^^ (x 0 ^^ (if join then x 1 || x 2 else x 1 && x 2))
  have hc : HasCircuitSize 3 f s := circuit_of_clean h
  have dep : ∃ x, f (Function.update x (Fin.last 2) (!x (Fin.last 2))) ≠ f x := by
    exact ⟨![false,!join,false],by cases sign <;> cases join <;> decide⟩
  have nc : ∃ y z : Fin 2 → Bool, f (Fin.snoc y (!join)) ≠ f (Fin.snoc z (!join)) := by
    exact ⟨![false,false],![true,false],by cases sign <;> cases join <;> decide⟩
  have co : (fun y : Fin 2 → Bool => f (Fin.snoc y (!join))) = (fun x : Fin 2 → Bool => xor (par 2 x) sign) := by
    funext x
    have diff : ∀ y : Fin 2 → Bool, f (Fin.snoc y (!join)) = xor (par 2 y) sign := by
      cases sign <;> cases join <;> decide
    exact diff x
  have nc' : ∃ y z : Fin 2 → Bool, xor (par 2 y) sign ≠ xor (par 2 z) sign := by
    exact ⟨![false,false],![true,false],by cases sign <;> decide⟩
  by_contra lim
  have hc' : HasCircuitSize 3 f (3+1) := by
    obtain ⟨C,hf,hs,he⟩ := hc
    exact ⟨C,hf,by omega,he⟩
  have red := gate_elim 2 f (!join) 3 dep nc hc'
  rw [co] at red
  have := par_lower4 1 sign 3 (clean_of _ _ _ nc' red)
  omega

theorem split_two (sign join : Bool) (s : ℕ)
    (h : HasClean 4 (fun x => sign ^^ (x 0 ^^ x 1 ^^ (if join then x 2 || x 3 else x 2 && x 3))) s) : 9 ≤ s := by
  let f := fun x : Fin 4 → Bool => sign ^^ (x 0 ^^ x 1 ^^ (if join then x 2 || x 3 else x 2 && x 3))
  have hc : HasCircuitSize 4 f s := circuit_of_clean h
  have dep : ∃ x, f (Function.update x (Fin.last 3) (!x (Fin.last 3))) ≠ f x := by
    exact ⟨![false,false,!join,false],by cases sign <;> cases join <;> decide⟩
  have nc : ∃ y z : Fin 3 → Bool, f (Fin.snoc y (!join)) ≠ f (Fin.snoc z (!join)) := by
    exact ⟨![false,false,false],![true,false,false],by cases sign <;> cases join <;> decide⟩
  have co : (fun y : Fin 3 → Bool => f (Fin.snoc y (!join))) = (fun x : Fin 3 → Bool => xor (par 3 x) sign) := by
    funext x
    have diff : ∀ y : Fin 3 → Bool, f (Fin.snoc y (!join)) = xor (par 3 y) sign := by
      cases sign <;> cases join <;> decide
    exact diff x
  have nc' : ∃ y z : Fin 3 → Bool, xor (par 3 y) sign ≠ xor (par 3 z) sign := by
    exact ⟨![false,false,false],![true,false,false],by cases sign <;> decide⟩
  by_contra lim
  have hc' : HasCircuitSize 4 f (7+1) := by
    obtain ⟨C,hf,hs,he⟩ := hc
    exact ⟨C,hf,by omega,he⟩
  have red := gate_elim 3 f (!join) 7 dep nc hc'
  rw [co] at red
  have := par_lower4 2 sign 7 (clean_of _ _ _ nc' red)
  omega

def origAdder (x : Fin 6 → Bool) : Bool :=
  Nat.testBit ((1 * (x 0).toNat + 2 * (x 1).toNat + 4 * (x 2).toNat) +
    (1 * (x 3).toNat + 2 * (x 4).toNat + 4 * (x 5).toNat)) 2

theorem split_adder (h : HasCircuitSize 6 origAdder 12) :
    HasClean 5 (fun x => false ^^ (x 0 ^^ x 1 ^^ ((x 2 && x 3) || ((x 2 || x 3) && x 4)))) 11 := by
  let r : Fin 6 → Fin 6 := ![4,2,0,5,3,1]
  let f := fun x : Fin 6 → Bool => origAdder (x ∘ r)
  have h' : HasCircuitSize 6 f (11+1) := Rewire.relabel_size r origAdder 12 h
  have dep : ∃ x, f (Function.update x (Fin.last 5) (!x (Fin.last 5))) ≠ f x := by
    exact ⟨![false,false,false,true,true,false],by decide⟩
  have nc : ∃ y z : Fin 5 → Bool, f (Fin.snoc y true) ≠ f (Fin.snoc z true) := by
    exact ⟨![false,false,false,false,false],![true,false,false,false,false],by decide⟩
  have red := clean_of _ _ _ nc (gate_elim 5 f true 11 dep nc h')
  have co : (fun y : Fin 5 → Bool => f (Fin.snoc y true)) =
      (fun y : Fin 5 → Bool => false ^^ (y 0 ^^ y 1 ^^ ((y 2 && y 3) || ((y 2 || y 3) && y 4)))) := by
    funext x
    have diff : ∀ y : Fin 5 → Bool, f (Fin.snoc y true) =
        (false ^^ (y 0 ^^ y 1 ^^ ((y 2 && y 3) || ((y 2 || y 3) && y 4)))) := by decide
    exact diff x
  rwa [co] at red

end PEqualNP.Outside.L_meta_10165.FirstGate

