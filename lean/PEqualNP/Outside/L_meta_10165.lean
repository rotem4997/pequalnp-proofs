theorem mixed_first_gate (n cap : ℕ) (f : (Fin (n+1) → Bool) → Bool) (tight : Fin (n+1) → Prop)
    (hnc : ∀ i b, ∃ y z : Fin n → Bool, f (ins i b y) ≠ f (ins i b z))
    (hess : ∀ i : Fin (n+1), ∃ x, f (Function.update x i (!x i)) ≠ f x)
    (hpair : ∀ i j : Fin (n+1), i ≠ j → ∀ b, ∃ x, x j = b ∧ f (Function.update x i (!x i)) ≠ f x)
    (hsens : ∀ i : Fin (n+1), ¬ tight i → ∀ x, f (Function.update x i (!x i)) ≠ f x)
    (three : ∀ i : Fin (n+1), tight i → ∀ b s, HasClean n (fun x => f (ins i b x)) s → cap < s+3)
    (four : ∀ (i : Fin (n+1)) b s, HasClean n (fun x => f (ins i b x)) s → cap < s+4) :
    ¬ HasClean (n+1) f cap := by
  classical
  intro hc
  have hex : ∃ s, HasClean (n+1) f s := ⟨cap,hc⟩
  obtain ⟨gs,o,hcl,hs,he⟩ := Nat.find_spec hex
  have hev : ∀ x : Fin (n+1) → Bool, vl gs x o = f x := he
  have hlen : gs.length ≤ cap := hs.trans (Nat.find_min' hex hc)
  have hmin : ∀ gs' o', CleanL (n+1) gs' → (∀ x, vl gs' x o' = f x) → gs.length ≤ gs'.length := by
    intro gs' o' hcl' he'
    exact hs.trans (Nat.find_min' hex ⟨gs', o', hcl', Nat.le_refl _, he'⟩)
  obtain ⟨w, hw⟩ := hess 0
  have hncf : ∃ u v : Fin (n+1) → Bool, vl gs u o ≠ vl gs v o :=
    ⟨_, _, by simpa only [hev] using hw⟩
  have M : LocalMin n gs o := {
    hcl := hcl
    hnc := by simpa only [hev] using hnc
    m1 := by
      intro p g hp c h
      have hpl := (List.getElem?_eq_some_iff.1 hp).1
      obtain ⟨gs',o',hc',hl',he'⟩ := drop_const (n+1) gs hcl o p c hpl h hncf
      have := hmin gs' o' hc' (fun x => (he' x).trans (hev x)); omega
    m2 := by
      intro p g hp j hj h
      have hpl := (List.getElem?_eq_some_iff.1 hp).1
      obtain ⟨gs',o',hc',hl',he'⟩ := drop_alias (n+1) gs hcl o p j hpl hj h hncf
      have := hmin gs' o' hc' (fun x => (he' x).trans (hev x)); omega
    nored := by
      rintro ⟨i,b,gs',o',hc',hl',he'⟩
      have := four i b gs'.length ⟨gs',o',hc',Nat.le_refl _,fun x => (he' x).trans (hev _)⟩
      omega }
  have hsupp : ∀ i : Fin (n+1), i ∈ (suppsFrom gs (inputSupps (n+1))).getD o ∅ := by
    intro i
    obtain ⟨u,hu⟩ := hess i
    by_contra hns
    apply hu
    rw [← hev, ← hev]
    exact (agree_wiresFrom (Function.update u i (!u i)) u gs _ _ _ (agree_inputs _ _)).2.2 o (by
      intro k hk
      have : k ≠ i := fun e => hns (e ▸ hk)
      simp [Function.update_of_ne this])
  have hoi : ∀ i : Fin (n+1), o ≠ i := fun i e => M.out i false false (by rw [e]; exact stF_self n gs i false)
  have hg0 : ∃ g, gs[0]? = some g := by
    cases e : gs with
    | nil =>
      obtain ⟨p,g,hp,_⟩ := exists_reader (n+1) 0 (fun a => a = (0 : Fin (n+1)).val) rfl gs o (hoi 0) (hsupp 0)
      simp [e] at hp
    | cons g l => exact ⟨g,rfl⟩
  obtain ⟨g,hg⟩ := hg0
  have hr3 (i : Fin (n+1)) (hit : tight i) (hr : i.val ∈ g.inputs)
      (alt : (∀ c, ∃ b, stF n gs i b (n+1) = Stat.const c) ∨ ∃ p g', p ≠ 0 ∧ gs[p]? = some g' ∧ i.val ∈ g'.inputs) : False := by
    obtain ⟨b,hb⟩ := three_core n gs hcl o hsupp M.out g hg i hr alt
    obtain ⟨j,hcl',he'⟩ := M.pass i b
    have hc' : HasClean n (fun x => f (ins i b x)) (passG n gs i b).length :=
      ⟨_,j,hcl',Nat.le_refl _,fun x => (he' x).trans (hev _)⟩
    have := three i hit b _ hc'
    change (passG n gs i b).length + 3 ≤ gs.length at hb
    omega
  have hbinary (i j : Fin (n+1)) (hne : i ≠ j) (hit : tight i)
      (hop : g.op = .and ∨ g.op = .or) (hi : i.val ∈ g.inputs) (hj : j.val ∈ g.inputs) : False := by
    apply hr3 i hit hi
    right
    by_contra hno
    obtain ⟨u,hu,hd⟩ := hpair i j hne (fixBit g)
    have habs (v : Fin (n+1) → Bool) (hv : v j = fixBit g) : vl gs v (n+1+0) = fixBit g :=
      vl_abs gs hcl v 0 g hg hop j hj (by rw [vl_input gs v j j.isLt]; exact hv)
    apply hd
    rw [← hev, ← hev]
    refine agree_B gs hcl _ _ (fun a => a = i.val) (o+1) ?_ ?_ o (by omega) (hoi i)
    · intro k hk hne'
      rw [vl_input gs _ k hk, vl_input gs _ k hk]
      exact Function.update_of_ne (fun e => hne' (congrArg Fin.val e)) _ _
    · intro p g' hp _ _ hr _
      obtain ⟨a,ha,ea⟩ := hr
      have ea' : a = i.val := ea
      have ep : p = 0 := by
        by_contra hp0
        exact hno ⟨p,g',hp0,hp,ea' ▸ ha⟩
      rw [ep,habs _ (by rw [Function.update_of_ne hne.symm]; exact hu),habs _ hu]
  have hsensitive (i : Fin (n+1)) (hi : ¬tight i) : Fact (Sensitive gs o i) :=
    ⟨fun x => by simpa only [hev] using hsens i hi x⟩
  rcases hcl 0 g hg with ⟨hop,j,hj,hin⟩ | ⟨hop,j,k,hj,hk,hin⟩
  · let i : Fin (n+1) := ⟨j,hj⟩
    by_cases hi : tight i
    · exact hr3 i hi (by rw [hin]; simp [i]) (Or.inl (first_any n gs g hg i (Or.inl ⟨hop,hin⟩)))
    · haveI := hsensitive i hi
      exact M.no_not i 0 g hg hop (by rw [hin]; simp [i])
  · let i : Fin (n+1) := ⟨j,hj⟩
    let v : Fin (n+1) := ⟨k,hk⟩
    have hi : i.val ∈ g.inputs := by rw [hin]; simp [i]
    have hv : v.val ∈ g.inputs := by rw [hin]; simp [v]
    by_cases hsame : j=k
    · subst k
      apply M.m2 0 g hg j (by omega)
      intro u
      rw [vl_gate gs hcl u 0 g hg,hin]
      rcases hop with ha|ha <;> rw [ha] <;> simp [GateOp.eval]
    · have hne : i ≠ v := fun e => hsame (congrArg Fin.val e)
      by_cases hti : tight i
      · exact hbinary i v hne hti hop hi hv
      by_cases htv : tight v
      · exact hbinary v i hne.symm htv hop hv hi
      haveI := hsensitive i hti
      haveI := hsensitive v htv
      exact M.pair_false i v hne 0 g hg hop hi hv

end PEqualNP.Outside.L_meta_10165.FirstGate

