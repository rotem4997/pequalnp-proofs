def endpoints : List ℕ := [0, 4, 1, 4, 2, 5, 3, 5, 0, 6, 1, 6, 2, 6, 2, 7, 3, 7, 5, 7, 6, 7]

def target (x : Fin 8 → Bool) : Bool :=
  decide (∃ i < endpoints.length / 2,
    (List.ofFn x).getD (endpoints.getD (2 * i) 0) false = true ∧
    (List.ofFn x).getD (endpoints.getD (2 * i + 1) 0) false = true)

def circuit : Circuit := ⟨[
  ⟨.or, [0, 1]⟩,
  ⟨.or, [2, 3]⟩,
  ⟨.or, [4, 6]⟩,
  ⟨.or, [5, 6]⟩,
  ⟨.or, [2, 7]⟩,
  ⟨.or, [5, 7]⟩,
  ⟨.and, [8, 10]⟩,
  ⟨.and, [9, 13]⟩,
  ⟨.and, [11, 12]⟩,
  ⟨.or, [14, 15]⟩,
  ⟨.or, [16, 17]⟩
], 18⟩

theorem allowed : ∀ g ∈ circuit.gates,
    (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length ≤ 2 := by
  intro g mem
  simp only [circuit, List.mem_cons, List.not_mem_nil, or_false] at mem
  rcases mem with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

set_option maxRecDepth 20000 in
set_option maxHeartbeats 15000000 in
