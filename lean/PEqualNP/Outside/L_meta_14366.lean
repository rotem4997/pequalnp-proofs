section

namespace Graph14366Lower

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

open CircuitHelpers

private def permutation : Fin 8 → Fin 8 := ![7, 5, 1, 3, 6, 2, 0, 4]

private def full (x : Fin 8 → Bool) : Bool := Graph14366Control.target (x ∘ permutation)

private def middle (x : Fin 7 → Bool) : Bool := full (Fin.snoc x false)

private def cut (b : Bool) (x : Fin 6 → Bool) : Bool := middle (Fin.snoc x b)

private theorem fullDepends :
    ∃ x : Fin 8 → Bool, full (Function.update x (Fin.last 7) (!x (Fin.last 7))) ≠ full x := by
  exact ⟨fun i => decide (i = 6), by decide +kernel⟩

private theorem middleNonconstant : ∃ x y, middle x ≠ middle y :=
  ⟨fun _ => false, fun _ => true, by decide +kernel⟩

private theorem middleDepends :
    ∃ x : Fin 7 → Bool, middle (Function.update x (Fin.last 6) (!x (Fin.last 6))) ≠ middle x := by
  exact ⟨fun i => decide (i = 5), by decide +kernel⟩

private theorem cutNonconstant (b : Bool) : ∃ x y, cut b x ≠ cut b y := by
  refine ⟨fun _ => false, fun _ => true, ?_⟩
  cases b <;> decide +kernel

private theorem cutDepends (b : Bool) :
    ∃ x : Fin 6 → Bool, cut b (Function.update x (Fin.last 5) (!x (Fin.last 5))) ≠ cut b x := by
  cases b
  · exact ⟨fun i => decide (i = 0), by decide +kernel⟩
  · exact ⟨fun _ => false, by decide +kernel⟩

private theorem cutFiveNonconstant (b : Bool) :
    ∃ x y : Fin 5 → Bool, cut b (Fin.snoc x false) ≠ cut b (Fin.snoc y false) := by
  refine ⟨fun _ => false, fun _ => true, ?_⟩
  cases b <;> decide +kernel

set_option maxRecDepth 20000 in
set_option maxHeartbeats 15000000 in
private theorem cutFiveExact :
    ∀ (b : Bool) (x : Fin 5 → Bool), cut b (Fin.snoc x false) = Small14366Lower.target x := by
  decide +kernel

theorem lower {s : Nat} (h : HasCircuitSize 8 Graph14366Control.target s) : 11 ≤ s := by
  by_contra! small
  have fullBound : HasCircuitSize 8 full (9 + 1) := by
    obtain ⟨C, legal, count, eval⟩ :=
      PermInputs.relabel_size permutation Graph14366Control.target s h
    exact ⟨C, legal, by omega, eval⟩
  have middleBound : HasCircuitSize 7 middle 9 :=
    gate_elim 7 full false 9 fullDepends middleNonconstant fullBound
  obtain ⟨b, size, budget, fit⟩ :=
    gate_elim_two 6 middle 9 middleDepends cutNonconstant middleBound
  have cutBound : HasCircuitSize 6 (cut b) (6 + 1) := by
    obtain ⟨C, legal, count, eval⟩ := fit
    exact ⟨C, legal, by omega, eval⟩
  have fiveBound := gate_elim 5 (cut b) false 6 (cutDepends b) (cutFiveNonconstant b) cutBound
  rw [funext (cutFiveExact b)] at fiveBound
  have := Small14366Lower.lower fiveBound
  omega

end Graph14366Lower

