-- Credit: the case-split reduction shape of foudress (R_meta_1710_64, #23768) and willakone
-- (R_meta_17910_64). This is a split on the output wire of x1: one of the 14 inputs, or a later wire; each piece is the step with that one extra hypothesis.
theorem PEqualNP.Outside.R_meta_17715_2
    (caseA : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), x1.output < (14 : ℕ) → x1.size ≤ (27 : ℕ) → PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 → (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) → PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ) = { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [(1 : ℕ), (8 : ℕ)] : PEqualNP.CircuitLowerBounds.Gate } → (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) → ¬PEqualNP.ReadK.IsSingleRead x1 (14 : ℕ) (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) [((0 : ℕ), (7 : ℕ))] → False)
    (caseB : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (14 : ℕ) ≤ x1.output → x1.size ≤ (27 : ℕ) → PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 → (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) → PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ) = { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [(1 : ℕ), (8 : ℕ)] : PEqualNP.CircuitLowerBounds.Gate } → (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) → ¬PEqualNP.ReadK.IsSingleRead x1 (14 : ℕ) (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) [((0 : ℕ), (7 : ℕ))] → False) :
    ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), x1.size ≤ (27 : ℕ) → PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 → (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) → PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ) = { op := PEqualNP.CircuitLowerBounds.GateOp.and, inputs := [(1 : ℕ), (8 : ℕ)] : PEqualNP.CircuitLowerBounds.Gate } → (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) → ¬PEqualNP.ReadK.IsSingleRead x1 (14 : ℕ) (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) [((0 : ℕ), (7 : ℕ))] → False := by
  intro x1
  rcases Nat.lt_or_ge x1.output (14 : ℕ) with h | h
  · exact @caseA x1 h
  · exact @caseB x1 h
