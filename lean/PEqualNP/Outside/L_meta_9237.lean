theorem verified (i : Nat) (hi : i < nodeCount) : nodeCheck i = true := by
  have hb : i/32 < 64 := by unfold nodeCount at hi; omega
  have h := List.all_eq_true.mp (verifiedChunk ⟨i/32,hb⟩) (i%32) (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  change (decide (i/32*32+i%32 ≥ nodeCount) || nodeCheck (i/32*32+i%32)) = true at h
  simpa [Nat.div_add_mod', Nat.not_le.mpr hi] using h

theorem exclude (c : Choices)
    (sem : ∀ s ∈ samples.toList, admissible (yesAt s) [∅,c 2,c 1,c 0]) :
    ∀ i < nodeCount, ¬contained c (atNode i).1 := by
  intro i
  induction i using Nat.strong_induction_on with
  | ind i ih =>
    intro hi fits
    let r := atNode i
    let s := atFrame r
    have ok := verified i hi
    simp only [nodeCheck,Bool.and_eq_true,beq_iff_eq,decide_eq_true_eq] at ok
    have sm : s ∈ samples.toList := by
      change (samples[r.2.1]?).getD default ∈ samples.toList
      rw [Array.getElem?_eq_getElem ok.1.1,Option.getD_some]
      simpa using Array.getElem_mem ok.1.1
    have v := samplesValid s sm
    have blocked := blockedAt v fits r.2.2.1 ok.1.2
    obtain ⟨j,hj,bad⟩ := predecessor (sem s sm) r.2.2.1 blocked
    obtain ⟨t,ht⟩ := refineBox v fits bad
    obtain ⟨lt,le⟩ := ok.2 j hj t
    exact ih _ lt (by omega) (contained_mono ht le)

theorem rootBox : (atNode 2025).1 = (0xffffff,0xffffff,0xffffff) := by decide +kernel

theorem fullContained (c : Choices) : contained c (0xffffff,0xffffff,0xffffff) := by
  intro j t _
  exact (show ∀ (j : Fin 3) (t : Fin 24),
    (wordAt (0xffffff,0xffffff,0xffffff) j.val).getLsbD t.val = true by decide +kernel) j t

def semantic {V : Type} (F : Set (Clause V)) (cs : List (Clause V)) : Prop :=
  ∀ A, consistent A → (∀ D ∈ F, stable A D) → admissible A cs

theorem semTail {V : Type} {F : Set (Clause V)} {C : Clause V} {cs}
    (h : semantic F (C::cs)) : semantic F cs :=
  fun A ok base => (h A ok base).1

theorem semCut {V : Type} {F : Set (Clause V)} {cs : List (Clause V)}
    (h : semantic F cs) (mem : ∅ ∈ cs) :
    ∃ rest, semantic F (∅ :: rest) ∧ rest.length < cs.length := by
  induction cs with
  | nil => simp at mem
  | cons C cs ih =>
    rcases List.mem_cons.mp mem with eq | mem
    · subst C
      exact ⟨cs,h,by simp⟩
    · obtain ⟨rest,hr,hlen⟩ := ih (semTail h) mem
      exact ⟨rest,hr,by simp; omega⟩

theorem semDouble {V : Type} {F : Set (Clause V)} {cs : List (Clause V)}
    (h : semantic F (∅::cs)) : semantic F (∅::∅::cs) := by
  intro A ok base
  refine ⟨h A ok base,?_⟩
  intro allStable
  have bad := allStable ∅ (by simp)
  simp [stable] at bad

theorem fourImpossible (a b c : Clause Small) :
    ¬semantic (PHP 4 3) [∅,c,b,a] := by
  intro sem
  let cs : Choices := ![a,b,c]
  have witness : ∀ s ∈ samples.toList, admissible (yesAt s) [∅,cs 2,cs 1,cs 0] := by
    intro s hs
    have v := samplesValid s hs
    exact sem _ v.1 (frameBase v)
  have bad := exclude cs witness 2025 (by decide)
  rw [rootBox] at bad
  exact bad (fullContained cs)

theorem smallLength {cs : List (Clause Small)} (h : semantic (PHP 4 3) cs)
    (mem : ∅ ∈ cs) : 5 ≤ cs.length := by
  by_contra! len
  obtain ⟨rest,hr,hrest⟩ := semCut h mem
  match rest with
  | [] => exact fourImpossible _ _ _ (semDouble (semDouble (semDouble hr)))
  | [a] => exact fourImpossible _ _ _ (semDouble (semDouble hr))
  | [b,a] => exact fourImpossible _ _ _ (semDouble hr)
  | [c,b,a] => exact fourImpossible _ _ _ hr
  | _ :: _ :: _ :: _ :: _ => simp at hrest; omega

abbrev Big := Fin 5 × Fin 4

-- Assign one pigeon to one hole and keep the remaining four by three grid.
def emb (q : Big) (l : Literal Small) : Literal Big :=
  ((q.1.succAbove l.1.1,q.2.succAbove l.1.2),l.2)

def fixed (q : Big) (l : Literal Big) : Bool :=
  if l.2 then decide (l.1=q)
  else decide (l.1≠q ∧ (l.1.1=q.1 ∨ l.1.2=q.2))

def hit (q : Big) (C : Clause Big) : Bool := decide (∃ l ∈ C, fixed q l = true)
def proj (q : Big) (C : Clause Big) : Clause Small := Finset.univ.filter (fun l => emb q l ∈ C)
def liftA (q : Big) (A : Literal Small → Prop) (l : Literal Big) : Prop :=
  fixed q l = true ∨ ∃ z, emb q z = l ∧ A z

theorem embInj : ∀ q i j, emb q i = emb q j → i = j := by decide +kernel
theorem embNeg (q : Big) (z : Literal Small) : negLit (emb q z) = emb q (negLit z) := rfl
theorem notFixed : ∀ q z, fixed q (emb q z) = false := by decide +kernel
theorem fixedCons : ∀ q l, fixed q l = true → fixed q (negLit l) = false := by decide +kernel
theorem partition : ∀ q l, fixed q l = true ∨ fixed q (negLit l) = true ∨ ∃ z, emb q z = l := by
  decide +kernel

theorem liftEmb {q A z} : liftA q A (emb q z) ↔ A z := by
  simp only [liftA,notFixed,Bool.false_eq_true,false_or]
  exact ⟨fun ⟨k,he,hk⟩ => embInj q k z he ▸ hk,fun hz => ⟨z,rfl,hz⟩⟩

theorem liftCons {q A} (ok : consistent A) : consistent (liftA q A) := by
  intro l h hn
  rcases h with hf | ⟨z,rfl,hz⟩
  · rcases hn with hg | ⟨z,hz,_⟩
    · simp [fixedCons q l hf] at hg
    · have eq : emb q (negLit z) = l := calc
        _ = negLit (emb q z) := rfl
        _ = negLit (negLit l) := congrArg negLit hz
        _ = l := by simp [negLit]
      simp [← eq,notFixed] at hf
  · exact ok z hz (liftEmb.mp hn)

theorem hitStable {q A C} (h : hit q C = true) : stable (liftA q A) C := by
  obtain ⟨l,hl,ht⟩ := of_decide_eq_true h
  exact Or.inl ⟨l,hl,Or.inl ht⟩

theorem projStable {q A C} (h : stable A (proj q C)) : stable (liftA q A) C := by
  rcases h with ⟨z,hz,ha⟩ | ⟨z,hz,t,ht,hne,a,b⟩
  · exact Or.inl ⟨emb q z,(Finset.mem_filter.mp hz).2,liftEmb.mpr ha⟩
  · exact Or.inr ⟨emb q z,(Finset.mem_filter.mp hz).2,emb q t,(Finset.mem_filter.mp ht).2,
      fun he => hne (embInj q z t he), fun he => a (liftEmb.mp he), fun he => b (liftEmb.mp he)⟩

theorem projDead {q A C} (miss : hit q C = false) (h : dead A (proj q C)) :
    dead (liftA q A) C := by
  intro l hl
  rcases partition q l with ht | hf | ⟨z,rfl⟩
  · have hh : hit q C = true := decide_eq_true ⟨l,hl,ht⟩
    simp [miss] at hh
  · exact Or.inl hf
  · exact liftEmb.mpr (h z (by simpa [proj] using hl))

def rowC {m n : ℕ} (i : Fin m) : Clause (Fin m × Fin n) :=
  Finset.univ.image (fun j : Fin n => ((i,j),true))
def colC {m n : ℕ} (i k : Fin m) (j : Fin n) : Clause (Fin m × Fin n) :=
  {((i,j),false),((k,j),false)}

theorem rowRestrict : ∀ q (i : Fin 5), hit q (rowC i) = true ∨
    ∃ k : Fin 4, proj q (rowC i) = rowC k := by decide +kernel

theorem colRestrict : ∀ q (i k : Fin 5) (j : Fin 4), i ≠ k →
    hit q (colC i k j) = true ∨ ∃ a b : Fin 4, ∃ h : Fin 3, a ≠ b ∧
      proj q (colC i k j) = colC a b h := by decide +kernel

theorem liftBase {q A} (base : ∀ D ∈ PHP 4 3, stable A D) :
    ∀ D ∈ PHP 5 4, stable (liftA q A) D := by
  rintro D (⟨i,rfl⟩ | ⟨i,k,j,hne,rfl⟩)
  · rcases rowRestrict q i with h | ⟨t,he⟩
    · exact hitStable h
    · apply projStable
      exact he ▸ base _ (Or.inl ⟨t,rfl⟩)
  · rcases colRestrict q i k j hne with h | ⟨a,b,t,ht,he⟩
    · exact hitStable h
    · apply projStable
      exact he ▸ base _ (Or.inr ⟨a,b,t,ht,rfl⟩)

def restrictRun (q : Big) (cs : List (Clause Big)) : List (Clause Small) :=
  (cs.filter (fun c => !hit q c)).map (proj q)

theorem projectAdmissible (q : Big) (A : Literal Small → Prop) (cs : List (Clause Big))
    (h : admissible (liftA q A) cs) : admissible A (restrictRun q cs) := by
  induction cs with
  | nil => trivial
  | cons C cs ih =>
    by_cases hh : hit q C = true
    · simpa [restrictRun,hh] using ih h.1
    · have miss : hit q C = false := by simpa using hh
      simp only [restrictRun,List.filter_cons,miss,Bool.not_false,
        ite_true,List.map_cons]
      refine ⟨ih h.1,?_⟩
      intro hs hd
      apply h.2 ?_ (projDead miss hd)
      intro D hD
      by_cases ht : hit q D = true
      · exact hitStable ht
      · apply projStable (hs _ ?_)
        exact List.mem_map.mpr ⟨D,by simp [hD,ht],rfl⟩

-- Two satisfied learned clauses would leave a four-clause run on the smaller grid.
theorem countHits {cs : List (Clause Big)} (h : semantic (PHP 5 4) cs)
    (contains : ∅ ∈ cs) (len : cs.length ≤ 6) (q : Big) : cs.countP (hit q) ≤ 1 := by
  have sem : semantic (PHP 4 3) (restrictRun q cs) :=
    fun A ok base => projectAdmissible q A cs (h _ (liftCons ok) (liftBase base))
  have smallEmpty : ∅ ∈ restrictRun q cs := by
    refine List.mem_map.mpr ⟨∅,by simp [hit,contains],?_⟩
    simp [proj]
  have low := smallLength sem smallEmpty
  have split := List.length_eq_countP_add_countP (hit q) (l := cs)
  simp only [restrictRun,List.length_map,← List.countP_eq_length_filter] at low
  have eq : (fun a : Clause Big => decide (¬hit q a = true)) = (fun c => !hit q c) := by
    funext c
    cases hit q c <;> rfl
  rw [eq] at split
  omega

-- Test a positive unit by setting it false. Test a negative unit by placing
-- its pigeon in its hole. Every other literal falsified by this test shares
-- a satisfying placement with the unit.
def unitTest (l k : Literal Big) : Bool :=
  if l.2 then decide (k = negLit l) else fixed l.1 k

theorem unitCons : ∀ l, ∀ k, unitTest l k = true → unitTest l (negLit k) = false := by decide +kernel
theorem killsUnit : ∀ l, unitTest l (negLit l) = true := by decide +kernel
theorem commonHit : ∀ l k, unitTest l (negLit k) = true →
    ∃ q, fixed q l = true ∧ fixed q k = true := by decide +kernel

theorem testRows : ∀ l (i : Fin 5), stable (fun k => unitTest l k = true) (rowC i) := by
  unfold stable
  decide +kernel
theorem testCols : ∀ l (i k : Fin 5) (j : Fin 4), i ≠ k →
    stable (fun v => unitTest l v = true) (colC i k j) := by
  unfold stable
  decide +kernel

theorem testBase (l : Literal Big) : ∀ D ∈ PHP 5 4, stable (fun k => unitTest l k = true) D := by
  rintro D (⟨i,rfl⟩ | ⟨i,k,j,ne,rfl⟩)
  · exact testRows l i
  · exact testCols l i k j ne

theorem blankRows : ∀ i : Fin 5, stable (fun _ => False) (rowC (n:=4) i) := by
  unfold stable
  decide +kernel
theorem blankCols : ∀ i k : Fin 5, ∀ j : Fin 4, i ≠ k →
    stable (fun _ => False) (colC i k j) := by unfold stable; decide +kernel
theorem blankBase : ∀ D ∈ PHP 5 4, stable (fun _ => False) D := by
  rintro D (⟨i,rfl⟩ | ⟨i,k,j,ne,rfl⟩)
  · exact blankRows i
  · exact blankCols i k j ne

theorem stableOfWide {A : Literal Big → Prop} {D : Clause Big}
    (size : 1 < D.card) (allowed : ∀ k ∈ D, ¬A (negLit k)) : stable A D := by
  obtain ⟨i,hi,j,hj,ne⟩ := Finset.one_lt_card.mp size
  exact Or.inr ⟨i,hi,j,hj,ne,allowed i hi,allowed j hj⟩

theorem wideRun {cs : List (Clause Big)} (sem : semantic (PHP 5 4) cs)
    (sep : ∀ q, cs.countP (hit q) ≤ 1) : ∀ C ∈ cs, 1 < C.card := by
  induction cs with
  | nil => simp
  | cons C cs ih =>
    have tailSep : ∀ q, cs.countP (hit q) ≤ 1 := by
      intro q
      have h := sep q
      rw [List.countP_cons] at h
      split at h <;> omega
    have wide := ih (semTail sem) tailSep
    have nonempty : C ≠ ∅ := by
      intro eq
      subst C
      have h := (sem _ (by simp [consistent]) blankBase).2
      exact h (fun d hd => stableOfWide (wide d hd) (by simp)) (by simp [dead])
    have nonsingle (l : Literal Big) : C ≠ {l} := by
      intro eq
      subst C
      have ok : consistent (fun k => unitTest l k = true) := by
        intro k hk
        simp [unitCons l k hk]
      have h := (sem _ ok (testBase l)).2
      apply h ?_ (by simpa [dead] using killsUnit l)
      intro D hd
      apply stableOfWide (wide D hd)
      intro k hk bad
      obtain ⟨q,h1,h2⟩ := commonHit l k bad
      have head : hit q {l} = true := by simp [hit,h1]
      have later : 0 < cs.countP (hit q) :=
        List.countP_pos_iff.mpr ⟨D,hd,decide_eq_true ⟨k,hk,h2⟩⟩
      have limit := sep q
      rw [List.countP_cons_of_pos head] at limit
      omega
    intro D hd
    rcases List.mem_cons.mp hd with rfl | ht
    · by_contra! hn
      have hp := Finset.card_pos.mpr (Finset.nonempty_iff_ne_empty.mpr nonempty)
      obtain ⟨l,hl⟩ := Finset.card_eq_one.mp (show D.card = 1 by omega)
      exact nonsingle l hl
    · exact wide D ht

end PEqualNP.Outside.L_meta_9237

open PEqualNP.Outside.L_meta_9237 in
theorem PEqualNP.Outside.L_meta_9237 : ¬ (∃ ρ : List (PEqualNP.ProofComplexity.Clause (Fin (4 + 1) × Fin 4)), PEqualNP.Search.IsRUPRun (PEqualNP.ProofComplexity.PHP (4 + 1) 4) ρ ∧ (∅ : PEqualNP.ProofComplexity.Clause (Fin (4 + 1) × Fin 4)) ∈ ρ ∧ ρ.length ≤ 6) := by
  rintro ⟨cs,run,contains,len⟩
  have sem : semantic (PEqualNP.ProofComplexity.PHP 5 4) cs :=
    fun _ ok base => run_admissible run ok base
  have impossible := wideRun sem (countHits sem contains len) ∅ contains
  simpa using impossible
