def atNode (i : Nat) : Node := ((blocks[i/32]?).getD #[])[i%32]?.getD default

def childIndex (r : Node) (j : Fin 3) (t : Fin 24) : Nat :=
  (r.2.2.2 >>> (11*(24*j.val+t.val))) % 2048

def atFrame (r : Node) : Frame := samples[r.2.1]?.getD default

def nodeCheck (i : Nat) : Bool :=
  let r := atNode i
  let s := atFrame r
  (r.2.1 < samples.size) &&
  (wordAt r.1 r.2.2.1.val &&& s.2 == 0) &&
  decide (∀ j : Fin 3, j.val < r.2.2.1.val → ∀ t : Fin 24,
    childIndex r j t < i ∧ boxLe (smaller r.1 s j t) (atNode (childIndex r j t)).1 = true)

def frameCheck (s : Frame) : Bool :=
  @decide (validFrame s) (by unfold validFrame stable yesAt; infer_instance)

theorem samplesValid : ∀ s ∈ samples.toList, validFrame s := by
  have check : samples.toList.all frameCheck = true := by decide +kernel
  intro s hs
  let : Decidable (validFrame s) := by unfold validFrame stable yesAt; infer_instance
  exact of_decide_eq_true (List.all_eq_true.mp check s hs)

