variable {V : Type}

-- The assignment records the literals already true. A stable clause is satisfied
-- or has at least two literals whose complements are still unassigned.
def stable (A : Literal V → Prop) (C : Clause V) : Prop :=
  (∃ l ∈ C, A l) ∨ ∃ l ∈ C, ∃ k ∈ C, l ≠ k ∧ ¬A (negLit l) ∧ ¬A (negLit k)

def dead (A : Literal V → Prop) (C : Clause V) : Prop :=
  ∀ l ∈ C, A (negLit l)

def consistent (A : Literal V → Prop) : Prop := ∀ l, A l → ¬A (negLit l)

theorem stable_nonempty {A : Literal V → Prop} {C : Clause V}
    (ok : consistent A) (h : stable A C) : ¬dead A C := by
  intro d
  rcases h with ⟨l,hl,ha⟩ | ⟨l,hl,k,hk,hne,ha,hb⟩
  · exact ok l ha (d l hl)
  · exact ha (d l hl)

theorem closed_forces {A : Literal V → Prop} {Γ : Set (Clause V)} {B : Set (Literal V)}
    (ok : consistent A) (known : ∀ C ∈ Γ, stable A C) (initial : ∀ l ∈ B, A l)
    {l : Literal V} (h : UPForces Γ B l) : A l := by
  induction h with
  | hyp h => exact initial _ h
  | @unit D l hd hl step ih =>
    rcases known D hd with ⟨k,hk,ha⟩ | ⟨k,hk,t,ht,hkt,h1,h2⟩
    · by_cases eq : k = l
      · simpa [eq] using ha
      · exact False.elim (ok k ha (ih k hk eq))
    · by_cases eq : k = l
      · exact False.elim (h2 (ih t ht (by grind)))
      · exact False.elim (h1 (ih k hk eq))

theorem disallow {A : Literal V → Prop} {Γ : Set (Clause V)} {C : Clause V}
    (ok : consistent A) (known : ∀ D ∈ Γ, stable A D) (h : IsRUP Γ C) : ¬dead A C := by
  intro d
  obtain ⟨D,hD,forces⟩ := h
  apply stable_nonempty ok (known D hD)
  intro l hl
  apply closed_forces ok known _ (forces l hl)
  rintro _ ⟨k,hk,rfl⟩
  exact d k hk

-- This test reads a run from newest to oldest. It asks only what must hold
-- while the older clauses are stable at the selected assignment.
def admissible (A : Literal V → Prop) : List (Clause V) → Prop
  | [] => True
  | C :: cs => admissible A cs ∧ ((∀ D ∈ cs, stable A D) → ¬dead A C)

theorem run_admissible {F : Set (Clause V)} {cs : List (Clause V)}
    (run : IsRUPRun F cs) {A : Literal V → Prop}
    (ok : consistent A) (base : ∀ D ∈ F, stable A D) : admissible A cs := by
  induction run with
  | nil => trivial
  | learn prev h ih =>
    refine ⟨ih,fun hs => disallow ok ?_ h⟩
    intro D hd
    exact hd.elim (base D) (hs D)

abbrev Small := Fin 4 × Fin 3
abbrev Word := BitVec 24

def slot (l : Literal Small) : Fin 24 :=
  ⟨2*(l.1.1.val*3+l.1.2.val)+(if l.2 then 0 else 1), by
    have := l.1.1.isLt
    have := l.1.2.isLt
    split <;> omega⟩

def lit (i : Fin 24) : Literal Small :=
  ((⟨i.val/6, by omega⟩, ⟨Nat.mod (i.val / 2) 3, Nat.mod_lt _ (by decide)⟩), decide (Nat.mod i.val 2 = 0))

theorem slot_lit : ∀ i, slot (lit i) = i := by decide +kernel
theorem lit_slot : ∀ l, lit (slot l) = l := by decide +kernel

abbrev Frame := Word × Word

def yesAt (s : Frame) (l : Literal Small) : Prop := s.1.getLsbD (slot l).val = true

def validFrame (s : Frame) : Prop :=
  (∀ l, yesAt s l → ¬yesAt s (negLit l)) ∧
  (∀ i : Fin 24, s.2.getLsbD i.val = !s.1.getLsbD (slot (negLit (lit i))).val) ∧
  (∀ i : Fin 4, stable (yesAt s) (Finset.univ.image (fun j : Fin 3 => ((i,j),true)))) ∧
  (∀ i k : Fin 4, ∀ j : Fin 3, i ≠ k →
    stable (yesAt s) {((i,j),false),((k,j),false)})

theorem frameBase {s : Frame} (v : validFrame s) : ∀ D ∈ PHP 4 3, stable (yesAt s) D := by
  rintro D (⟨i,rfl⟩ | ⟨i,k,j,hi,rfl⟩)
  · exact v.2.2.1 i
  · exact v.2.2.2 i k j hi



abbrev Box := Word × Word × Word
abbrev Choices := Fin 3 → Clause Small

def wordAt (b : Box) (i : Nat) : Word :=
  match i with
  | 0 => b.1
  | 1 => b.2.1
  | 2 => b.2.2
  | _ => 0

def contained (c : Choices) (b : Box) : Prop :=
  ∀ j : Fin 3, ∀ t : Fin 24, lit t ∈ c j → (wordAt b j.val).getLsbD t.val = true

def boxLe (u v : Box) : Bool :=
  (u.1 &&& v.1 == u.1) && (u.2.1 &&& v.2.1 == u.2.1) && (u.2.2 &&& v.2.2 == u.2.2)

theorem contained_mono {c u v} (h : contained c u) (le : boxLe u v = true) : contained c v := by
  intro j t ht
  have bit := h j t ht
  have eq : wordAt u j.val &&& wordAt v j.val = wordAt u j.val := by
    simp only [boxLe,Bool.and_eq_true,beq_iff_eq] at le
    fin_cases j
    · exact le.1.1
    · exact le.1.2
    · exact le.2
  have hx := congrArg (fun x : Word => x.getLsbD t.val) eq
  simp only [BitVec.getLsbD_and,bit,Bool.true_and] at hx
  exact hx

def changeWord (u : Box) (j : Fin 3) (w : Word) : Box :=
  (if j=0 then w else u.1,if j=1 then w else u.2.1,if j=2 then w else u.2.2)

theorem changeAt (u : Box) (j k : Fin 3) (w : Word) :
    wordAt (changeWord u j w) k.val = if k=j then w else wordAt u k.val := by
  fin_cases j <;> fin_cases k <;> rfl

def oneBit (i : Fin 24) : Word := 1 <<< i.val
theorem oneBit_spec : ∀ i j : Fin 24, (oneBit i).getLsbD j.val = decide (j=i) := by decide +kernel

def smaller (u : Box) (s : Frame) (j : Fin 3) (t : Fin 24) : Box :=
  let w := wordAt u j.val
  changeWord u j ((w &&& ~~~s.2) ||| (w &&& s.2 &&& ~~~s.1 &&& oneBit t))

theorem refineBox {c u s j} (v : validFrame s) (h : contained c u)
    (unstable : ¬stable (yesAt s) (c j)) : ∃ t, contained c (smaller u s j t) := by
  classical
  have onlyOne : ∀ i ∈ c j, ∀ k ∈ c j, ¬yesAt s (negLit i) → ¬yesAt s (negLit k) → i=k := by
    intro i hi k hk ai ak
    by_contra ne
    exact unstable (Or.inr ⟨i,hi,k,hk,ne,ai,ak⟩)
  have noTrue : ∀ k ∈ c j, ¬yesAt s k := fun k hk ha => unstable (Or.inl ⟨k,hk,ha⟩)
  obtain ⟨t,ht⟩ : ∃ t : Fin 24, ∀ z ∈ c j, ¬yesAt s (negLit z) → slot z=t := by
    by_cases ex : ∃ z ∈ c j, ¬yesAt s (negLit z)
    · obtain ⟨z,hz,ha⟩ := ex
      exact ⟨slot z,fun k hk hb => congrArg slot (onlyOne k hk z hz hb ha)⟩
    · exact ⟨0,fun k hk hb => False.elim (ex ⟨k,hk,hb⟩)⟩
  refine ⟨t,?_⟩
  intro k z hz
  have chosen := h k z hz
  simp only [smaller,changeAt]
  split
  · next eq =>
    subst k
    have absent := noTrue (lit z) hz
    have clear : s.1.getLsbD z.val = false := by simpa [yesAt,slot_lit] using absent
    have single : s.2.getLsbD z.val = true → z=t := by
      intro possible
      have hp : ¬yesAt s (negLit (lit z)) := by
        rw [v.2.1] at possible
        simpa [yesAt] using possible
      simpa [slot_lit] using ht (lit z) hz hp
    simp only [BitVec.getLsbD_or,BitVec.getLsbD_and,BitVec.getLsbD_not,z.isLt,decide_true,
      Bool.true_and,chosen,clear,oneBit_spec,Bool.not_false,Bool.and_true]
    cases pp : s.2.getLsbD z.val
    · simp
    · simp [single pp]
  · exact chosen

def clauseAt (cs : Choices) (k : Fin 4) : Clause Small :=
  if hk : k.val < 3 then cs ⟨k.val,hk⟩ else ∅

theorem blockedAt {s c u} (v : validFrame s) (h : contained c u)
    (k : Fin 4) (stop : wordAt u k.val &&& s.2 = 0) : dead (yesAt s) (clauseAt c k) := by
  intro l hl
  unfold clauseAt at hl
  split at hl
  · next hk =>
    have hb := h ⟨k.val,hk⟩ (slot l) (by simpa [lit_slot] using hl)
    have he := congrArg (fun x : Word => x.getLsbD (slot l).val) stop
    change (wordAt u k.val).getLsbD (slot l).val = true at hb
    simp only [BitVec.getLsbD_and,hb,Bool.true_and,v.2.1,lit_slot] at he
    simpa [yesAt] using he
  · simp at hl

theorem predecessor {A : Literal Small → Prop} {c : Choices}
    (h : admissible A [∅,c 2,c 1,c 0]) (k : Fin 4) (hd : dead A (clauseAt c k)) :
    ∃ j : Fin 3, j.val < k.val ∧ ¬stable A (c j) := by
  classical
  by_contra! allStable
  fin_cases k
  · exact h.1.1.1.2 (by simp) hd
  · exact h.1.1.2 (by simpa using allStable 0 (by decide)) hd
  · exact h.1.2 (by simpa using And.intro (allStable 1 (by decide)) (allStable 0 (by decide))) hd
  · apply h.2 ?_ hd
    simpa using And.intro (allStable 2 (by decide)) (And.intro (allStable 1 (by decide)) (allStable 0 (by decide)))

