def Tok (v : Nat) : Bool :=
  isPerm (Tt.getD v []) (TIt.getD v []) && isHom (Tt.getD v []) && get (Tt.getD v []) v == 0

def Sok (j : Nat) : Bool := isPerm (St.getD j []) (SIt.getD j []) && isHom (St.getD j [])

theorem T0 : (List.range' 0 6).all Tok = true := by decide +kernel
theorem T1 : (List.range' 6 6).all Tok = true := by decide +kernel
theorem T2 : (List.range' 12 6).all Tok = true := by decide +kernel
theorem T3 : (List.range' 18 6).all Tok = true := by decide +kernel
theorem T4 : (List.range' 24 6).all Tok = true := by decide +kernel
theorem T5 : (List.range' 30 6).all Tok = true := by decide +kernel
theorem T6 : (List.range' 36 6).all Tok = true := by decide +kernel
theorem S0 : (List.range' 0 7).all Sok = true := by decide +kernel
theorem S1 : (List.range' 7 7).all Sok = true := by decide +kernel
theorem S2 : (List.range' 14 7).all Sok = true := by decide +kernel

theorem Tall (v : Nat) (hv : v < 42) : Tok v = true := by
  have e : List.range 42 = List.range' 0 6 ++ List.range' 6 6 ++ List.range' 12 6 ++
      List.range' 18 6 ++ List.range' 24 6 ++ List.range' 30 6 ++ List.range' 36 6 := by decide
  have h : (List.range 42).all Tok = true := by
    rw [e]
    simp only [List.all_append, T0, T1, T2, T3, T4, T5, T6, Bool.and_self]
  rw [List.all_eq_true] at h
  exact h v (List.mem_range.2 hv)

theorem Sall (j : Nat) (hj : j < 21) : Sok j = true := by
  have e : List.range 21 = List.range' 0 7 ++ List.range' 7 7 ++ List.range' 14 7 := by decide
  have h : (List.range 21).all Sok = true := by
    rw [e]
    simp only [List.all_append, S0, S1, S2, Bool.and_self]
  rw [List.all_eq_true] at h
  exact h j (List.mem_range.2 hj)

def pairOK : Bool := (List.range 21).all fun p => (List.range' 21 21).all fun l =>
  adjB p l || (decide (21 ≤ get (Tt.getD p []) l ∧ get (Tt.getD p []) l < 42) &&
    get (St.getD (get (Tt.getD p []) l - 21) []) (get (Tt.getD p []) p) == 0 &&
    get (St.getD (get (Tt.getD p []) l - 21) []) (get (Tt.getD p []) l) == 22)

theorem pairOK_eq : pairOK = true := by decide +kernel

theorem Tperm (v : Nat) (hv : v < 42) : isPerm (Tt.getD v []) (TIt.getD v []) = true := by
  have h := Tall v hv
  simp only [Tok, Bool.and_eq_true] at h
  exact h.1.1

theorem Thom (v : Nat) (hv : v < 42) : isHom (Tt.getD v []) = true := by
  have h := Tall v hv
  simp only [Tok, Bool.and_eq_true] at h
  exact h.1.2

theorem Tzero (v : Nat) (hv : v < 42) : get (Tt.getD v []) v = 0 := by
  have h := Tall v hv
  simp only [Tok, Bool.and_eq_true, beq_iff_eq] at h
  exact h.2

theorem Sperm (j : Nat) (hj : j < 21) : isPerm (St.getD j []) (SIt.getD j []) = true := by
  have h := Sall j hj
  simp only [Sok, Bool.and_eq_true] at h
  exact h.1

theorem Shom (j : Nat) (hj : j < 21) : isHom (St.getD j []) = true := by
  have h := Sall j hj
  simp only [Sok, Bool.and_eq_true] at h
  exact h.2

theorem partA (x2 : Fin 42) : ∃ x3 : G ≃g G, x3 x2 = 0 := by
  refine ⟨mk _ _ (Tperm x2 x2.isLt) (Thom x2 x2.isLt), ?_⟩
  apply Fin.ext
  rw [mk_val]
  exact Tzero x2 x2.isLt

theorem partB (p l : Fin 42) (hp : (p : ℕ) < 21) (hl : 21 ≤ (l : ℕ)) (hn : ¬G.Adj p l) :
    ∃ x7 : G ≃g G, x7 p = 0 ∧ x7 l = 22 := by
  rw [adj_iff] at hn
  have hn' : adjB p l = false := by simpa using hn
  have h := pairOK_eq
  rw [pairOK, List.all_eq_true] at h
  have h4 := h p (List.mem_range.2 hp)
  rw [List.all_eq_true] at h4
  have h3 := h4 l (List.mem_range'_1.2 ⟨hl, by omega⟩)
  rw [hn', Bool.false_or] at h3
  simp only [Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at h3
  obtain ⟨⟨⟨hm1, hm2⟩, e1⟩, e2⟩ := h3
  have hj : get (Tt.getD p []) l - 21 < 21 := by omega
  refine ⟨(mk _ _ (Tperm p (by omega)) (Thom p (by omega))).trans
    (mk _ _ (Sperm _ hj) (Shom _ hj)), ?_, ?_⟩
  · apply Fin.ext
    rw [RelIso.trans_apply, mk_val, mk_val]
    exact e1
  · apply Fin.ext
    rw [RelIso.trans_apply, mk_val, mk_val]
    exact e2

