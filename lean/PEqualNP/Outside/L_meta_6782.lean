import Mathlib
import PEqualNP.Defs

/-!
The incidence graph of the order-4 plane (difference set {0,5,7,17,20} mod 21) is
vertex-transitive, and every non-incident point-line pair can be moved to (0, 22).
Explicit automorphisms are given as permutation tables (with inverse tables), found by a
small search: Tt v sends vertex v to 0 (a cyclic shift for points), St j fixes point 0 and
sends line 21+j to line 22 when j is not in the difference set. Each table is checked by
decide +kernel (bijection and adjacency preserved on all 42 x 42 pairs), in small chunks.
For a non-incident pair (p, l) the automorphism is Tt p followed by St (Tt p l - 21).
-/

namespace PEqualNP.Outside.L_meta_6782

def G : SimpleGraph (Fin 42) := SimpleGraph.fromRel fun (x1 x2 : Fin 42) =>
  (x1 : ℕ) < 21 ∧ 21 ≤ (x2 : ℕ) ∧ ((x2 : ℕ) + 21 - (x1 : ℕ)) % 21 ∈ [(0 : ℕ), 5, 7, 17, 20]

def adjB (a b : Nat) : Bool :=
  decide (a ≠ b ∧ ((a < 21 ∧ 21 ≤ b ∧ (b + 21 - a) % 21 ∈ [(0 : ℕ), 5, 7, 17, 20]) ∨
    (b < 21 ∧ 21 ≤ a ∧ (a + 21 - b) % 21 ∈ [(0 : ℕ), 5, 7, 17, 20])))

theorem adj_iff (x y : Fin 42) : G.Adj x y ↔ adjB x y = true := by
  simp only [G, adjB, SimpleGraph.fromRel_adj, decide_eq_true_eq, ne_eq, Fin.val_inj]

def get (P : List Nat) (a : Nat) : Nat := P.getD a 0

def isPerm (P Q : List Nat) : Bool := (List.range 42).all fun a =>
  decide (get P a < 42) && decide (get Q a < 42) && get Q (get P a) == a && get P (get Q a) == a

def isHom (P : List Nat) : Bool := (List.range 42).all fun a => (List.range 42).all fun b =>
  adjB (get P a) (get P b) == adjB a b

theorem perm_facts {P Q : List Nat} (h : isPerm P Q = true) (a : Nat) (ha : a < 42) :
    get P a < 42 ∧ get Q a < 42 ∧ get Q (get P a) = a ∧ get P (get Q a) = a := by
  simp only [isPerm, List.all_eq_true, List.mem_range, Bool.and_eq_true, decide_eq_true_eq,
    beq_iff_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h a ha
  exact ⟨h1, h2, h3, h4⟩

theorem hom_facts {P : List Nat} (h : isHom P = true) (a b : Nat) (ha : a < 42) (hb : b < 42) :
    adjB (get P a) (get P b) = adjB a b := by
  simp only [isHom, List.all_eq_true, List.mem_range, beq_iff_eq] at h
  exact h a ha b hb

def fn (P : List Nat) (a : Fin 42) : Fin 42 := ⟨get P a % 42, Nat.mod_lt _ (by decide)⟩

theorem fn_val {P : List Nat} (hb : ∀ a < 42, get P a < 42) (a : Fin 42) :
    (fn P a : ℕ) = get P a := Nat.mod_eq_of_lt (hb a a.isLt)

def mk (P Q : List Nat) (h1 : isPerm P Q = true) (h2 : isHom P = true) : G ≃g G where
  toFun := fn P
  invFun := fn Q
  left_inv := by
    intro a
    apply Fin.ext
    rw [fn_val (fun b hb => (perm_facts h1 b hb).2.1), fn_val (fun b hb => (perm_facts h1 b hb).1)]
    exact (perm_facts h1 a a.isLt).2.2.1
  right_inv := by
    intro a
    apply Fin.ext
    rw [fn_val (fun b hb => (perm_facts h1 b hb).1), fn_val (fun b hb => (perm_facts h1 b hb).2.1)]
    exact (perm_facts h1 a a.isLt).2.2.2
  map_rel_iff' := by
    intro a b
    show G.Adj (fn P a) (fn P b) ↔ G.Adj a b
    rw [adj_iff, adj_iff, fn_val (fun c hc => (perm_facts h1 c hc).1),
      fn_val (fun c hc => (perm_facts h1 c hc).1), hom_facts h2 a b a.isLt b.isLt]

theorem mk_val (P Q : List Nat) (h1 : isPerm P Q = true) (h2 : isHom P = true) (a : Fin 42) :
    ((mk P Q h1 h2 a : Fin 42) : ℕ) = get P a :=
  fn_val (fun c hc => (perm_facts h1 c hc).1) a

