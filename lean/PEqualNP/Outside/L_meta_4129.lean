theorem cert_sem (k : ℕ) (hk : k < 1885) :
    cx6 k &&& cx7 k = cx6 k ∧ uncN (cx7 k) = 0 ∧ pc11 (cx7 k) = 7 ∧
      uncN (cx6 k) &&& cu k = uncN (cx6 k) ∧ packF (cgs k) = cf k ∧ packOK (cgs k) 0 = true ∧
      pc11 (cx6 k) ≤ packC (cgs k) := by
  obtain ⟨j, hjd⟩ : ∃ j, k / 256 = j := ⟨_, rfl⟩
  have hj : j < 8 := by omega
  have hk' : k = 256 * j + k % 256 := by omega
  have h : certB k = true := by
    interval_cases j
    · rw [hk']; exact allBelow_spec _ _ certs_ok0 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok1 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok2 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok3 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok4 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok5 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok6 (k % 256) (by omega)
    · rw [hk']; exact allBelow_spec _ _ certs_ok7 (k % 256) (by omega)
  simp only [certB, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩ := h
  exact ⟨h1, h2, h3, h4, h5, h6, h7⟩

-- The table: certificate index of every mask, 11 bits each.

def TBL : List ℕ := [, , , , , , , , , , , , , , , ]

def EXCN : List ℕ := [36608, 44800, 44864, 44992, 48960, 52992, 53120, 53184, 57216, 61184, 61248,
  61312, 61376, 65280, 65344, 65408, 65472]

def maskK (m k : ℕ) : Bool := decide (k < 1885) && (m &&& cu k == cu k) && (m &&& cf k == 0)

def maskB (m : ℕ) : Bool := EXCN.contains m || maskK m (fetch TBL 4096 11 m)

