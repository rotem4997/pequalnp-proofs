import Mathlib
import PEqualNP.Defs

-- Certificate proof. For every edge set S (by its 16-bit mask m), a table names a certificate:
-- a set x6 (a minimum cover of the graph minus S), a 7-cover x7 of the graph with x6 inside it,
-- and a packing of vertex-disjoint small gadgets whose cover numbers add up to at least the size
-- of x6 (the lower bound). A certificate is valid for every mask that deletes all edges x6 misses
-- and keeps every gadget edge. The kernel checks the table, the certificates and the gadgets.

namespace PEqualNP.Outside.L_meta_4129_aux

open PEqualNP.MetaComplexity

def EL : List (ℕ × ℕ) := [(0, 9), (0, 10), (1, 4), (1, 8), (2, 5), (2, 10), (3, 6), (3, 7), (4, 8),
  (4, 10), (5, 8), (5, 9), (6, 7), (6, 10), (7, 9), (8, 9)]

abbrev GG : SimpleGraph (Fin 11) := PEqualNP.EdgeOwnership.edgeGraph 11 EL

def ea (i : Fin 16) : Fin 11 := Fin.ofNat 11 (EL.getD (i : ℕ) (0, 0)).1

def eb (i : Fin 16) : Fin 11 := Fin.ofNat 11 (EL.getD (i : ℕ) (0, 0)).2

-- Bits of tableIndex (same proofs as the project library helpers).

theorem ti_lt {m : ℕ} (x : Fin m → Bool) : tableIndex x < 2 ^ m := by
  have key : ∀ m : ℕ, ∑ i ∈ Finset.range m, 2 ^ i < 2 ^ m := by
    intro m
    induction m with
    | zero => simp
    | succ m ih => rw [Finset.sum_range_succ, pow_succ]; omega
  unfold tableIndex
  calc ∑ i : Fin m, (if x i = true then 2 ^ (i : ℕ) else 0) ≤ ∑ i : Fin m, 2 ^ (i : ℕ) :=
        Finset.sum_le_sum fun i _ => by split <;> simp
    _ < 2 ^ m := by rw [Fin.sum_univ_eq_sum_range (fun i => 2 ^ i) m]; exact key m

theorem ti_succ {m : ℕ} (x : Fin (m + 1) → Bool) :
    tableIndex x = (if x 0 = true then 1 else 0) + 2 * tableIndex (Fin.tail x) := by
  unfold tableIndex
  rw [Fin.sum_univ_succ, Finset.mul_sum]
  have h2 : (∑ i : Fin m, if x i.succ = true then 2 ^ ((i.succ : Fin (m + 1)) : ℕ) else 0)
      = ∑ i : Fin m, 2 * (if Fin.tail x i = true then 2 ^ (i : ℕ) else 0) :=
    Finset.sum_congr rfl (fun i _ => by
      by_cases hx : x i.succ = true <;> simp [hx, Fin.tail, pow_succ, mul_comm])
  rw [h2]
  simp

theorem testBit_ti_full : ∀ (m : ℕ) (x : Fin m → Bool) (j : ℕ),
    (tableIndex x).testBit j = if h : j < m then x ⟨j, h⟩ else false := by
  intro m
  induction m with
  | zero =>
    intro x j
    simp [tableIndex]
  | succ m ih =>
    intro x j
    rw [ti_succ]
    cases j with
    | zero =>
      rw [dif_pos (by omega)]
      show _ = x 0
      cases hx : x 0 <;> simp [Nat.testBit_zero, Nat.add_mul_mod_self_left]
    | succ j =>
      rw [Nat.testBit_succ]
      have e : ((if x 0 = true then 1 else 0) + 2 * tableIndex (Fin.tail x)) / 2
          = tableIndex (Fin.tail x) := by
        split_ifs <;> omega
      rw [e, ih]
      by_cases hj : j < m
      · rw [dif_pos hj, dif_pos (by omega)]; rfl
      · rw [dif_neg hj, dif_neg (by omega)]

theorem testBit_ti {m : ℕ} (x : Fin m → Bool) (i : Fin m) : (tableIndex x).testBit i = x i := by
  rw [testBit_ti_full, dif_pos i.isLt]

theorem testBit_ti_ge {m : ℕ} (x : Fin m → Bool) (j : ℕ) (h : m ≤ j) :
    (tableIndex x).testBit j = false := by
  rw [testBit_ti_full, dif_neg (by omega)]

-- Bit-level helpers.

def uncN (s : ℕ) : ℕ := tableIndex (fun i : Fin 16 => !(s.testBit (ea i) || s.testBit (eb i)))

def pc11 (a : ℕ) : ℕ := (Finset.univ.filter (fun v : Fin 11 => a.testBit v = true)).card

def fld (B w k : ℕ) : ℕ := (B >>> (w * k)) % 2 ^ w

def fetch (L : List ℕ) (per w k : ℕ) : ℕ := fld (L.getD (k / per) 0) w (k % per)

def allBelow (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n + 1 => p n && allBelow p n

theorem allBelow_spec (p : ℕ → Bool) (n : ℕ) (h : allBelow p n = true) :
    ∀ m < n, p m = true := by
  induction n with
  | zero => intro m hm; omega
  | succ n ih =>
    intro m hm
    simp only [allBelow, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hm with hm | hm
    · exact ih h.2 m hm
    · subst hm; exact h.1

-- Gadgets: (edge mask, vertex mask, lower bound on the cover number).

def GLS : List (ℕ × ℕ × ℕ) := [(4288, 200, 2), (2099, 1573, 3), (268, 274, 2), (16384, 640, 1), (64, 72, 1), (16, 36, 1), (2, 1025, 1), (512, 1040, 1), (8, 258, 1), (1, 513, 1), (2048, 544, 1), (32, 1028, 1), (1024, 288, 1), (4, 18, 1), (32768, 768, 1), (35840, 800, 2), (256, 272, 1), (1840, 1332, 3), (8192, 1088, 1), (128, 136, 1), (33539, 1809, 3), (4096, 192, 1), (28675, 1729, 3), (61964, 2002, 4), (35388, 1846, 4), (62512, 2020, 4), (26864, 1772, 4), (58304, 2008, 4), (32512, 2032, 4), (3599, 1843, 4), (28364, 2042, 5)]

def gF (g : ℕ) : ℕ := (GLS.getD g (0, 0, 0)).1

def gV (g : ℕ) : ℕ := (GLS.getD g (0, 0, 0)).2.1

def gC (g : ℕ) : ℕ := (GLS.getD g (0, 0, 0)).2.2

def gadgetB (f v c : ℕ) : Bool :=
  (List.finRange 16).all (fun i => !(f.testBit i) || (v.testBit (ea i) && v.testBit (eb i))) &&
    allBelow (fun a => a &&& v != a || uncN a &&& f != 0 || decide (c ≤ pc11 a)) 2048

set_option maxRecDepth 100000 in
theorem gadgets_ok : GLS.all (fun x => gadgetB x.1 x.2.1 x.2.2) = true := by
  decide +kernel

theorem gadget_sem3 (f v c : ℕ) (h : gadgetB f v c = true) :
    (∀ i : Fin 16, f.testBit i = true → v.testBit (ea i) = true ∧ v.testBit (eb i) = true) ∧
    ∀ a < 2048, a &&& v = a → uncN a &&& f = 0 → c ≤ pc11 a := by
  simp only [gadgetB, Bool.and_eq_true] at h
  obtain ⟨h1, h2⟩ := h
  constructor
  · intro i hi
    have := List.all_eq_true.mp h1 i (List.mem_finRange i)
    rw [hi] at this
    simpa using this
  · intro a ha hsub hun
    have := allBelow_spec _ _ h2 a ha
    simp only [hsub, hun, bne_self_eq_false, Bool.false_or, decide_eq_true_eq] at this
    exact this

set_option maxRecDepth 100000 in
theorem gadget_zero : gadgetB 0 0 0 = true := by
  decide +kernel

theorem gadget_sem (g : ℕ) :
    (∀ i : Fin 16, (gF g).testBit i = true →
      (gV g).testBit (ea i) = true ∧ (gV g).testBit (eb i) = true) ∧
    ∀ a < 2048, a &&& gV g = a → uncN a &&& gF g = 0 → gC g ≤ pc11 a := by
  by_cases hg : g < GLS.length
  · have hmem : GLS.getD g (0, 0, 0) ∈ GLS := by
      rw [List.getD_eq_getElem _ _ hg]; exact List.getElem_mem hg
    exact gadget_sem3 _ _ _ (List.all_eq_true.mp gadgets_ok _ hmem)
  · have hd : GLS.getD g (0, 0, 0) = (0, 0, 0) := List.getD_eq_default _ _ (by omega)
    have h := gadget_sem3 _ _ _ gadget_zero
    unfold gF gV gC
    rw [hd]
    exact h

-- Packings of vertex-disjoint gadgets.

def packOK : List ℕ → ℕ → Bool
  | [], _ => true
  | g :: gs, acc => (acc &&& gV g == 0) && packOK gs (acc ||| gV g)

def packF : List ℕ → ℕ
  | [] => 0
  | g :: gs => gF g ||| packF gs

def packC : List ℕ → ℕ
  | [] => 0
  | g :: gs => gC g + packC gs

def maskOf (A : Finset (Fin 11)) : ℕ := tableIndex (fun v : Fin 11 => decide (v ∈ A))

theorem maskOf_lt (A : Finset (Fin 11)) : maskOf A < 2048 := by
  have := ti_lt (fun v : Fin 11 => decide (v ∈ A))
  simpa [maskOf] using this

theorem maskOf_bit (A : Finset (Fin 11)) (v : Fin 11) : (maskOf A).testBit v = decide (v ∈ A) :=
  testBit_ti _ v

theorem maskOf_bit_ge (A : Finset (Fin 11)) (j : ℕ) (h : 11 ≤ j) : (maskOf A).testBit j = false :=
  testBit_ti_ge _ j h

theorem pc11_maskOf (A : Finset (Fin 11)) : pc11 (maskOf A) = A.card := by
  unfold pc11
  congr 1
  ext v
  simp [maskOf_bit]

theorem gadget_bound (g : ℕ) (T : Finset (Fin 11))
    (hT : ∀ i : Fin 16, (gF g).testBit i = true → ea i ∈ T ∨ eb i ∈ T) :
    gC g ≤ (T.filter (fun v : Fin 11 => (gV g).testBit v = true)).card := by
  obtain ⟨h1, h2⟩ := gadget_sem g
  rw [← pc11_maskOf]
  apply h2 _ (maskOf_lt _)
  · apply Nat.eq_of_testBit_eq
    intro j
    rw [Nat.testBit_and]
    by_cases hj : j < 11
    · have hb := maskOf_bit (T.filter (fun v : Fin 11 => (gV g).testBit v = true)) ⟨j, hj⟩
      simp only at hb
      rw [hb]
      by_cases hm : (⟨j, hj⟩ : Fin 11) ∈ T.filter (fun v : Fin 11 => (gV g).testBit v = true)
      · have hm' := hm
        simp only [Finset.mem_filter] at hm'
        simp only [hm, decide_true, Bool.true_and]
        exact hm'.2
      · simp [hm]
    · rw [maskOf_bit_ge _ j (by omega)]
      simp
  · apply Nat.eq_of_testBit_eq
    intro j
    rw [Nat.testBit_and, Nat.zero_testBit]
    by_cases hj : j < 16
    · have hu : (uncN (maskOf (T.filter (fun v : Fin 11 => (gV g).testBit v = true)))).testBit j =
          !((maskOf (T.filter (fun v : Fin 11 => (gV g).testBit v = true))).testBit (ea ⟨j, hj⟩) ||
            (maskOf (T.filter (fun v : Fin 11 => (gV g).testBit v = true))).testBit (eb ⟨j, hj⟩)) :=
        testBit_ti _ ⟨j, hj⟩
      rw [hu]
      cases hf : (gF g).testBit j
      · simp
      · obtain ⟨hva, hvb⟩ := h1 ⟨j, hj⟩ hf
        rcases hT ⟨j, hj⟩ hf with ht | ht
        · have hin : ea ⟨j, hj⟩ ∈ T.filter (fun v : Fin 11 => (gV g).testBit v = true) := by
            simp only [Finset.mem_filter]; exact ⟨ht, hva⟩
          simp [maskOf_bit, hin]
        · have hin : eb ⟨j, hj⟩ ∈ T.filter (fun v : Fin 11 => (gV g).testBit v = true) := by
            simp only [Finset.mem_filter]; exact ⟨ht, hvb⟩
          simp [maskOf_bit, hin]
    · have hu : (uncN (maskOf (T.filter (fun v : Fin 11 => (gV g).testBit v = true)))).testBit j = false :=
        testBit_ti_ge _ j (by omega)
      rw [hu]
      simp

theorem pack_bound (T : Finset (Fin 11)) : ∀ (gs : List ℕ) (acc : ℕ), packOK gs acc = true →
    (∀ i : Fin 16, (packF gs).testBit i = true → ea i ∈ T ∨ eb i ∈ T) →
    packC gs ≤ (T.filter (fun v : Fin 11 => acc.testBit v = false)).card := by
  intro gs
  induction gs with
  | nil => intro _ _ _; simp [packC]
  | cons g gs ih =>
    intro acc hok hcov
    simp only [packOK, Bool.and_eq_true, beq_iff_eq] at hok
    obtain ⟨hdis, hok⟩ := hok
    have hg := gadget_bound g T (fun i hi => hcov i (by simp [packF, Nat.testBit_or, hi]))
    have hr := ih (acc ||| gV g) hok (fun i hi => hcov i (by simp [packF, Nat.testBit_or, hi]))
    simp only [packC]
    have hdisj : Disjoint (T.filter (fun v : Fin 11 => (gV g).testBit v = true))
        (T.filter (fun v : Fin 11 => (acc ||| gV g).testBit v = false)) := by
      rw [Finset.disjoint_filter]
      intro v _ h1 h2
      simp [Nat.testBit_or, h1] at h2
    have hsub : T.filter (fun v : Fin 11 => (gV g).testBit v = true) ∪
        T.filter (fun v : Fin 11 => (acc ||| gV g).testBit v = false) ⊆
        T.filter (fun v : Fin 11 => acc.testBit v = false) := by
      intro v hv
      simp only [Finset.mem_union, Finset.mem_filter] at hv ⊢
      rcases hv with ⟨hT, hb⟩ | ⟨hT, hb⟩
      · refine ⟨hT, ?_⟩
        have := congrArg (fun x => x.testBit v) hdis
        simp [Nat.testBit_and, hb] at this
        exact this
      · refine ⟨hT, ?_⟩
        simp [Nat.testBit_or] at hb
        exact hb.1
    calc gC g + packC gs ≤ (T.filter (fun v : Fin 11 => (gV g).testBit v = true)).card +
          (T.filter (fun v : Fin 11 => (acc ||| gV g).testBit v = false)).card := Nat.add_le_add hg hr
      _ = (T.filter (fun v : Fin 11 => (gV g).testBit v = true) ∪
          T.filter (fun v : Fin 11 => (acc ||| gV g).testBit v = false)).card :=
            (Finset.card_union_of_disjoint hdisj).symm
      _ ≤ _ := Finset.card_le_card hsub

-- The certificates, packed: field k of a w-bit array B is fld B w k.

def X6P : List ℕ := [, , , , , , , , , , , , , , 0x2008018020060100301500c08c0200500c0180400901402c0600e0100240500b01402c0600c01a0380881202a0540c01a0200500e01d0300640e01c03a040089148240500a9198340600c91c0380741002104408c148290530a2140280540c0180312084188710a21c0e01cc288540c08a034a0845684119a142d08e11d]

def X7P : List ℕ := [, , , , , , , , , , , , , , 0x1f53eb6aed5dabb567d7a71f5e9d6acfa9f5e9dd39aeb5db576adaef4e6bad76d5dabb576adaeb5d6bbd38fae7a3ea7d5aee7a3ea7d5aeb5d6bad75aeb5d6ba7d4fa9f5cf47d4fab5dcf4d75aeb5d6bad74fa9f5b576aed5dabb576aed5dabb567d4fa9f53ebd3ba75abe9d6e6dcdabb567d4fa9f5e9c7d6d5b5db567d5aeb5d]

def UP : List ℕ := [, , , , , , , , , , , , , , ]

def FP : List ℕ := [, , , , , , , , , , , , , , ]

def GP : List ℕ := [, , , , , , , , , , , , , , ]

def cx6 (k : ℕ) : ℕ := fetch X6P 128 11 k

def cx7 (k : ℕ) : ℕ := fetch X7P 128 11 k

def cu (k : ℕ) : ℕ := fetch UP 128 16 k

def cf (k : ℕ) : ℕ := fetch FP 128 16 k

def cgs (k : ℕ) : List ℕ := (List.range 7).map (fun j => fetch GP 896 6 (7 * k + j))

def certB (k : ℕ) : Bool :=
  (cx6 k &&& cx7 k == cx6 k) && (uncN (cx7 k) == 0) && (pc11 (cx7 k) == 7) &&
    (uncN (cx6 k) &&& cu k == uncN (cx6 k)) && (packF (cgs k) == cf k) && packOK (cgs k) 0 &&
    decide (pc11 (cx6 k) ≤ packC (cgs k))

