        GG.IsVertexCover ↑x7 ∧ x6 ⊆ x7 ∧ x7.card = 7 := by
  have hlt : tableIndex (bS S) < 65536 := by
    have := ti_lt (bS S)
    simpa using this
  have hbit : ∀ i : Fin 16, (tableIndex (bS S)).testBit i = bS S i := fun i => testBit_ti _ i
  have hexc : EXCN.contains (tableIndex (bS S)) = false := by
    cases hc : EXCN.contains (tableIndex (bS S))
