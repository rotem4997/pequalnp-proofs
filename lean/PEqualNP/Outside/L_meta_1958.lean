theorem count (N t : ℕ) (I L P : Fin N → Fin N → Prop) [DecidableRel I]
    (hcov : ∀ p w, I p w → L p w ∨ P p w) :
    (Finset.univ.filter (fun pw : Fin N × Fin N => I pw.1 pw.2)).card + t ≤
      ∑ w : Fin N, Set.ncard {p : Fin N | L p w} +
        ∑ p : Fin N, min (N + 1) (Set.ncard {w : Fin N | P p w}) + t := by
  classical
  have hL : ∀ w, Set.ncard {p : Fin N | L p w} = (Finset.univ.filter (fun p => L p w)).card := by
    intro w
    rw [← Set.ncard_coe_finset]
    congr 1
    ext p
    simp
  have hP : ∀ p, min (N + 1) (Set.ncard {w : Fin N | P p w}) =
      (Finset.univ.filter (fun w => P p w)).card := by
    intro p
    have h1 : Set.ncard {w : Fin N | P p w} = (Finset.univ.filter (fun w => P p w)).card := by
      rw [← Set.ncard_coe_finset]
      congr 1
      ext w
      simp
    have h2 : (Finset.univ.filter (fun w => P p w)).card ≤ N := by
      calc _ ≤ (Finset.univ : Finset (Fin N)).card := Finset.card_filter_le _ _
        _ = N := by simp
    rw [h1]
    omega
  simp only [hL, hP]
  have hsumL : ∑ w : Fin N, (Finset.univ.filter (fun p => L p w)).card =
      (Finset.univ.filter (fun pw : Fin N × Fin N => L pw.1 pw.2)).card := by
    simp only [Finset.card_filter]
    rw [Fintype.sum_prod_type]
    exact Finset.sum_comm
  have hsumP : ∑ p : Fin N, (Finset.univ.filter (fun w => P p w)).card =
      (Finset.univ.filter (fun pw : Fin N × Fin N => P pw.1 pw.2)).card := by
    simp only [Finset.card_filter]
    rw [Fintype.sum_prod_type]
  rw [hsumL, hsumP]
  have hsub : Finset.univ.filter (fun pw : Fin N × Fin N => I pw.1 pw.2) ⊆
      Finset.univ.filter (fun pw : Fin N × Fin N => L pw.1 pw.2) ∪
        Finset.univ.filter (fun pw : Fin N × Fin N => P pw.1 pw.2) := by
    intro pw hpw
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_union] at hpw ⊢
    exact hcov _ _ hpw
  have := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
  omega

end PEqualNP.Outside.L_meta_1958

