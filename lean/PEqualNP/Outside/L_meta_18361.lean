def pc : ℕ → ℕ → ℕ
  | 0, _ => 0
  | f + 1, n => n % 2 + pc f (n / 2)

def cnt (c s : ℕ) : ℕ := (Finset.univ.filter (fun i : Fin 11 => c.testBit i = true ∧ s.testBit i = false)).card

def wt (P : List ℕ) : ℕ := (P.map (fun m => (pc 11 m + 1) / 2)).sum

def check (s k : ℕ) : Bool :=
  covers.any (fun c => decide (cnt c s ≤ k)) || packs.any (fun P => P.all (fun m => m &&& s == 0) && decide (k < wt P))

theorem check_all : ∀ s < 2048, ∀ k ≤ 4, check s k = true := by decide +kernel

theorem hL : ∀ m ∈ LL, m.bitIndices.length = pc 11 m := by decide +kernel

theorem hpacks : ∀ P ∈ packs, P.Pairwise (fun a b => a &&& b = 0) ∧ ∀ m ∈ P, m ∈ LL := by decide +kernel

theorem hcov : ∀ c ∈ covers, ∀ v w : Fin 11, (PEqualNP.EdgeOwnership.edgeGraph 11 [((0 : ℕ), (9 : ℕ)), ((0 : ℕ), (10 : ℕ)), ((1 : ℕ), (4 : ℕ)), ((1 : ℕ), (8 : ℕ)), ((2 : ℕ), (5 : ℕ)), ((2 : ℕ), (10 : ℕ)), ((3 : ℕ), (6 : ℕ)), ((3 : ℕ), (7 : ℕ)), ((4 : ℕ), (8 : ℕ)), ((4 : ℕ), (10 : ℕ)), ((5 : ℕ), (8 : ℕ)), ((5 : ℕ), (9 : ℕ)), ((6 : ℕ), (7 : ℕ)), ((6 : ℕ), (10 : ℕ)), ((7 : ℕ), (9 : ℕ)), ((8 : ℕ), (9 : ℕ))]).Adj v w → c.testBit v = true ∨ c.testBit w = true := by decide +kernel

def mkb (b : List Bool) : ℕ := b.foldr (fun x acc => x.toNat + 2 * acc) 0

theorem key : ∀ b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 : Bool, mkb [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10] < 2048 ∧ ∀ i : Fin 11, (mkb [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10]).testBit i = [b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10].getD i false := by decide +kernel

