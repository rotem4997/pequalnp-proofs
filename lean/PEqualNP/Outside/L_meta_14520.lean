def G (x : Fin 8 → Bool) : Bool :=
  (x 0 && x 4) || (x 1 && x 5) || (x 2 && x 5) || (x 1 && x 6) ||
  (x 2 && x 6) || (x 3 && x 6) || (x 0 && x 7) || (x 1 && x 7) ||
  (x 3 && x 7) || (x 5 && x 7) || (x 6 && x 7)

def G7 (x : Fin 7 → Bool) : Bool := G (ins (4 : Fin 8) false x)
def G6 (x : Fin 6 → Bool) : Bool := G7 (ins (0 : Fin 7) false x)
def G5 (x : Fin 5 → Bool) : Bool := G6 (ins (1 : Fin 6) false x)

theorem G_nc : G (fun _ => false) ≠ G (fun _ => true) := by decide
theorem G7_nc : G7 (fun _ => false) ≠ G7 (fun _ => true) := by decide
theorem G6_nc : G6 (fun _ => false) ≠ G6 (fun _ => true) := by decide
theorem G5_nc : G5 (fun _ => false) ≠ G5 (fun _ => true) := by decide

theorem G_dep :
    ∃ x : Fin 8 → Bool, G (Function.update x 4 (!x 4)) ≠ G x :=
  ⟨fun i => decide (i = 0), by decide⟩

theorem G7_dep :
    ∃ x : Fin 7 → Bool, G7 (Function.update x 0 (!x 0)) ≠ G7 x :=
  ⟨fun i => decide (i = 6), by decide⟩

theorem G6_dep :
    ∃ x : Fin 6 → Bool, G6 (Function.update x 1 (!x 1)) ≠ G6 x :=
  ⟨fun i => decide (i = 3), by decide⟩

set_option maxRecDepth 16000 in
theorem exact_core : ∀ x : Fin 5 → Bool, G5 x = Fan.F x := by decide +kernel

theorem binary_bound (gs : List Gate) (o : ℕ) (hg : ∀ g ∈ gs, legal g)
    (he : ∀ x : Fin 8 → Bool, vl gs x o = G x) : 10 ≤ binaryCost gs := by
  obtain ⟨r,j,rcl,rsz,rv⟩ := clean_preserves_binary 8 gs o hg
    ⟨fun _ => false,fun _ => true,by simpa only [he] using G_nc⟩
  have rg (x : Fin 8 → Bool) : vl r x j = G x := (rv x).trans (he x)
  have dep : ∃ x : Fin 8 → Bool, vl r (Function.update x 4 (!x 4)) j ≠ vl r x j := by
    simpa only [rg] using G_dep
  have nc7 : ∃ y z : Fin 7 → Bool, vl r (ins (4 : Fin 8) false y) j ≠
      vl r (ins (4 : Fin 8) false z) j :=
    ⟨fun _ => false,fun _ => true,by simpa only [rg, G7] using G7_nc⟩
  obtain ⟨r7,j7,rcl7,rsz7,rv7⟩ := pin_saves_binary 7 r j rcl 4 false dep nc7
  have rg7 (x : Fin 7 → Bool) : vl r7 x j7 = G7 x := (rv7 x).trans (rg _)
  have dep7 : ∃ x : Fin 7 → Bool, vl r7 (Function.update x 0 (!x 0)) j7 ≠ vl r7 x j7 := by
    simpa only [rg7] using G7_dep
  have nc6 : ∃ y z : Fin 6 → Bool, vl r7 (ins (0 : Fin 7) false y) j7 ≠
      vl r7 (ins (0 : Fin 7) false z) j7 :=
    ⟨fun _ => false,fun _ => true,by simpa only [rg7, G6] using G6_nc⟩
  obtain ⟨r6,j6,rcl6,rsz6,rv6⟩ := pin_saves_binary 6 r7 j7 rcl7 0 false dep7 nc6
  have rg6 (x : Fin 6 → Bool) : vl r6 x j6 = G6 x := (rv6 x).trans (rg7 _)
  have dep6 : ∃ x : Fin 6 → Bool, vl r6 (Function.update x 1 (!x 1)) j6 ≠ vl r6 x j6 := by
    simpa only [rg6] using G6_dep
  have nc5 : ∃ y z : Fin 5 → Bool, vl r6 (ins (1 : Fin 6) false y) j6 ≠
      vl r6 (ins (1 : Fin 6) false z) j6 :=
    ⟨fun _ => false,fun _ => true,by simpa only [rg6, G5] using G5_nc⟩
  obtain ⟨r5,j5,rcl5,rsz5,rv5⟩ := pin_saves_binary 5 r6 j6 rcl6 1 false dep6 nc5
  have legal5 : ∀ g ∈ r5, legal g := by
    intro g hg'
    simpa [legal,Ok] using (clean_nok _ _ rcl5 g hg').1
  have hlow := Fan.fan_bound r5 j5 legal5
    (fun x => (rv5 x).trans ((rg6 _).trans (exact_core x)))
  omega

def wg : List Gate :=
  [⟨.or,[1,3]⟩,⟨.or,[6,7]⟩,⟨.and,[8,9]⟩,⟨.or,[5,6]⟩,⟨.or,[1,7]⟩,⟨.or,[12,2]⟩,
   ⟨.and,[11,13]⟩,⟨.or,[4,7]⟩,⟨.and,[0,15]⟩,⟨.or,[10,14]⟩,⟨.or,[17,16]⟩]

theorem wlen : wg.length = 11 := rfl

theorem wf (g : Gate) (hg : g ∈ wg) : (g.op = .and ∨ g.op = .or) ∧ g.inputs.length ≤ 2 := by
  simp only [wg,List.mem_cons,List.not_mem_nil,or_false] at hg
  rcases hg with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;> simp

set_option maxRecDepth 16000 in
theorem we (x : Fin 8 → Bool) : Circuit.eval ⟨wg,18⟩ (List.ofFn x) = G x := by
  revert x
  decide +kernel

set_option maxRecDepth 16000 in
theorem bridge : ∀ x : Fin 8 → Bool, G x = decide (∃ i < ([0, 4, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7, 6, 7] : List ℕ).length / 2, (List.ofFn x).getD (([0, 4, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 4, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7, 6, 7] : List ℕ).getD (2 * i + 1) 0) false = true) := by decide +kernel

