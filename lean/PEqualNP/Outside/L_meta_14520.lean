theorem binaryCost_append (l r : List Gate) :
    binaryCost (l ++ r) = binaryCost l + binaryCost r := by
  simp [binaryCost]

private theorem bin_simplify_le (g : Gate) (s : ℕ) (rs : List Stat) :
    binaryCost (simplify g.op s rs).1.toList ≤ binaryCost [g] := by
  by_cases hn : g.op = .not
  · rcases rs with _ | ⟨r,rs⟩
    · simp [hn,simplify,simpNot,binaryCost,isBinary]
    · cases r <;> simp [hn,simplify,simpNot,binaryCost,isBinary]
  · have ht : isBinary g = true := by
      cases hop : g.op <;> simp_all [isBinary]
    have h := (List.length_filter_le isBinary ((simplify g.op s rs).1.toList)).trans
      (toList_length_le (simplify g.op s rs).1)
    simpa [binaryCost,ht] using h

private theorem bin_step_le (n : ℕ) (s : List Stat × List Gate) (g : Gate) :
    binaryCost (elimStep n s g).2 ≤ binaryCost s.2 + binaryCost [g] := by
  simp only [elimStep,binaryCost_append]
  exact Nat.add_le_add_left (bin_simplify_le g _ _) _

theorem bin_elim_le (n : ℕ) (gs : List Gate) (acc : List Stat × List Gate) :
    binaryCost (elim n gs acc).2 ≤ binaryCost acc.2 + binaryCost gs := by
  induction gs generalizing acc with
  | nil => simp [elim,binaryCost]
  | cons g gs ih =>
    change binaryCost (elim n gs (elimStep n acc g)).2 ≤
      binaryCost acc.2 + binaryCost ([g] ++ gs)
    rw [binaryCost_append]
    have h := ih (elimStep n acc g)
    have hh := bin_step_le n acc g
    omega

theorem bin_elim_save (n : ℕ) (gs : List Gate) (acc : List Stat × List Gate)
    (p : ℕ) (g : Gate) (hp : gs[p]? = some g) (hbin : isBinary g = true)
    (hOK : NOk g) (a : ℕ) (ha : a ∈ g.inputs) (hlt : a < acc.1.length + p)
    (c : Bool) (hc : (elim n gs acc).1.getD a (Stat.const false) = Stat.const c) :
    binaryCost (elim n gs acc).2 + 1 ≤ binaryCost acc.2 + binaryCost gs := by
  obtain ⟨pre,post,rfl,rfl⟩ := split_at gs p g hp
  have hpre := bin_elim_le n pre acc
  let before := elim n pre acc
  have hs : before.1.getD a (Stat.const false) = Stat.const c :=
    (elim_split_getD_lt n pre g post acc a (Stat.const false) hlt).symm.trans hc
  have drop : (simplify g.op (n + before.2.length)
      (g.inputs.map fun i => before.1.getD i (Stat.const false))).1 = none := by
    apply simplify_count
    · exact hOK.1.1
    · simpa using hOK.1.2
    · intro h
      simpa using hOK.2 h
    · exact ⟨c,List.mem_map.mpr ⟨a,ha,hs⟩⟩
  have hstep : (elimStep n before g).2 = before.2 := by
    simp only [elimStep,drop,Option.toList_none,List.append_nil]
  have hpost := bin_elim_le n post (elimStep n before g)
  rw [hstep] at hpost
  rw [elim_append]
  change binaryCost (elim n post (elimStep n before g)).2 + 1 ≤
    binaryCost acc.2 + binaryCost (pre ++ ([g] ++ post))
  simp only [binaryCost_append]
  have unit : binaryCost [g] = 1 := by simp [binaryCost,hbin]
  change binaryCost before.2 ≤ _ at hpre
  rw [unit]
  omega

theorem binary_touched (n : ℕ) (gs : List Gate) (o : ℕ) (hcl : CleanL (n + 1) gs)
    (i : Fin (n + 1)) (b : Bool)
    (hdep : ∃ x : Fin (n + 1) → Bool, vl gs (Function.update x i (!x i)) o ≠ vl gs x o)
    (hnc : ∃ y z : Fin n → Bool, vl gs (ins i b y) o ≠ vl gs (ins i b z) o) :
    ∃ (p : ℕ) (g : Gate), gs[p]? = some g ∧ isBinary g = true ∧
      ∃ a ∈ g.inputs, IsC n gs i b a := by
  classical
  by_contra hnone
  obtain ⟨x, hx⟩ := hdep
  let B : ℕ → Prop := IsC n gs i b
  have ho : ¬ B o := by
    rintro ⟨c,hc⟩
    obtain ⟨y,z,hyz⟩ := hnc
    exact hyz ((st_val_const n gs hcl i b o c hc y).trans
      (st_val_const n gs hcl i b o c hc z).symm)
  apply hx
  apply agree_B gs hcl (Function.update x i (!x i)) x B (o+1) _ _ o (by omega) ho
  · intro j hj hjB
    have ne : (⟨j,hj⟩ : Fin (n+1)) ≠ i := by
      intro e
      have e' := congrArg Fin.val e
      change j = (i : ℕ) at e'
      apply hjB
      refine ⟨b,?_⟩
      rw [e']
      exact stF_self n gs i b
    rw [vl_input gs _ j hj,vl_input gs _ j hj]
    simp [Function.update_of_ne ne]
  · intro p g hp _ hpB hr _
    obtain ⟨a,ha,hBa⟩ := hr
    exfalso
    rcases hcl p g hp with ⟨hop, j, _, hin⟩ | ⟨hBin, _, _, _, _, _⟩
    · apply hpB
      apply st_allconst n gs hcl i b p g hp
      intro t ht
      have e1 : a = j := by simpa [hin] using ha
      have e2 : t = j := by simpa [hin] using ht
      rwa [e2,←e1]
    · apply hnone
      exact ⟨p,g,hp,by rcases hBin with he|he <;> simp [isBinary,he],a,ha,hBa⟩

theorem clean_preserves_binary (n : ℕ) (gs : List Gate) (o : ℕ)
    (hOK : ∀ g ∈ gs, legal g)
    (hnc : ∃ y z : Fin n → Bool, vl gs y o ≠ vl gs z o) :
    ∃ (r : List Gate) (j : ℕ), CleanL n r ∧ binaryCost r ≤ binaryCost gs ∧
      ∀ y : Fin n → Bool, vl r y j = vl gs y o := by
  let acc := elim n gs (idStats n,[])
  have ok : ∀ g ∈ gs, Ok g := by
    intro g hg
    simpa [Ok,legal] using hOK g hg
  have hInv (y : Fin n → Bool) :
      Inv n (List.ofFn y) (wiresFrom gs (List.ofFn y)) acc :=
    inv_elim n _ (by simp) gs _ _ ok (inv_id n y)
  cases hh : acc.1.getD o (Stat.const false) with
  | const c =>
    obtain ⟨y,z,hyz⟩ := hnc
    have hy := ((hInv y).2 o).2
    have hz := ((hInv z).2 o).2
    rw [hh] at hy hz
    exact False.elim (hyz (hy.symm.trans hz))
  | wire j =>
    refine ⟨acc.2,j,?_,?_,?_⟩
    · exact clean_elim n (List.ofFn fun _ : Fin n => false) (by simp) gs _ _
        ok (inv_id n _) (by intro p g hp; simp at hp)
    · simpa [acc,binaryCost] using bin_elim_le n gs (idStats n,[])
    · intro y
      have hval := ((hInv y).2 o).2
      rw [hh] at hval
      exact hval

theorem pin_saves_binary (n : ℕ) (gs : List Gate) (o : ℕ) (hcl : CleanL (n + 1) gs)
    (i : Fin (n + 1)) (b : Bool)
    (hdep : ∃ x : Fin (n + 1) → Bool, vl gs (Function.update x i (!x i)) o ≠ vl gs x o)
    (hnc : ∃ y z : Fin n → Bool, vl gs (ins i b y) o ≠ vl gs (ins i b z) o) :
    ∃ (r : List Gate) (j : ℕ), CleanL n r ∧ binaryCost r + 1 ≤ binaryCost gs ∧
      ∀ y : Fin n → Bool, vl r y j = vl gs (ins i b y) o := by
  obtain ⟨p,g,hp,hbin,a,ha,c,hc⟩ := binary_touched n gs o hcl i b hdep hnc
  have hllt := (hcl p g hp).lt a ha
  have hs := bin_elim_save n gs (statAt n i b,[]) p g hp hbin
    ((hcl p g hp).nok) a ha (by show a < (statAt n i b).length + p; rw [statAt_length]; exact hllt) c hc
  cases hout : stF n gs i b o with
  | const d =>
    obtain ⟨y,z,hyz⟩ := hnc
    exact False.elim (hyz ((st_val_const n gs hcl i b o d hout y).trans
      (st_val_const n gs hcl i b o d hout z).symm))
  | wire j =>
    refine ⟨passG n gs i b,j,?_,?_,?_⟩
    · exact clean_elim n (List.ofFn fun _ : Fin n => false) (by simp) gs _ _
        (fun g hg => (clean_nok _ gs hcl g hg).1) (inv_at n i b _)
        (by intro p g hp; simp at hp)
    · simpa [passG,binaryCost] using hs
    · intro y
      exact (st_val_wire n gs hcl i b o j hout y).symm

end PEqualNP.Outside.L_meta_14520.BinaryPin
namespace PEqualNP.Outside.L_meta_14520
