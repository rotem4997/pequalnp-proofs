import PEqualNP.Defs

-- Split on the average size of the evidence sets over the lines that carry some.
-- If the sum is at most 22 times the number of such lines, the checked support bound
-- (L-meta-3684: such lines are at most twice the active gates) gives the factor 44.
-- Otherwise the evidence averages more than 22 points per line: that case remains.
-- The remaining case omits 2 at most q, which follows from 1894 at most N = q^2 + q + 1.
theorem PEqualNP.Outside.R_meta_4661_2
    (support : ∀ (x1 : ℕ) (x2 x3 : PEqualNP.CircuitLowerBounds.Circuit),   x2.output = x3.output →     PEqualNP.MetaComplexity.Monotone2 x2 →       x2.eval (List.ofFn fun (x6 : Fin (x1 + x1)) => Fin.addCases (fun (x7 : Fin x1) => Bool.true) (fun (x7 : Fin x1) => Bool.false) x6) = Bool.false →         have x7 : Fin x1 → Fin x1 → Fin (x1 + x1) → Bool := fun (x7 x8 : Fin x1) => PEqualNP.EdgeOwnership.pairInput (Fin.castAdd x1 x7) (Fin.natAdd x1 x8);         ∀ (x8 : Fin x1 → Finset (Fin x1)), (∀ (x9 x10 : Fin x1), x10 ∈ x8 x9 → x2.eval (List.ofFn (x7 x10 x9)) = Bool.true ∧ x3.eval (List.ofFn (x7 x10 x9)) = Bool.false) → Fintype.card { x10 : Fin x1 // (x8 x10).Nonempty } ≤ (2 : ℕ) * Fintype.card { x10 : Fin x2.size // (x2.wires (List.replicate (x1 + x1) Bool.false)).getD (x1 + x1 + ↑x10) Bool.false = Bool.false ∧ ∃ (x11 : Fin x1), ∃ x12 ∈ x8 x11, PEqualNP.EdgeOwnership.gateVal (x1 + x1) x2 (↑x10) (x7 x12 x11) = Bool.true })
    (dense : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit) (x6 : Fin x2 → Finset (Fin x2)),   have x7 : Finset (Fin x2) → List Bool := fun (x7 : Finset (Fin x2)) => List.ofFn (Fin.addCases (fun (x9 : Fin x2) => Decidable.decide ¬∃ x10 ∈ x7, x3 x9 x10) (fun (x9 : Fin x2) => Decidable.decide (x9 ∈ x7)));   have x8 : PEqualNP.CircuitLowerBounds.Circuit := { gates := List.map (fun (x8 : PEqualNP.CircuitLowerBounds.Gate) => if x8.op.eval [] = Bool.true ∧ x8.inputs.length = (2 : ℕ) ∧ (x8.inputs.all fun (x9 : ℕ) => Decidable.decide ((0 : ℕ) < (x5.lineDegrees (x2 + x2) (Finset.Ico x2 (x2 + x2))).getD x9 (0 : ℕ))) = Bool.true then { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [] : PEqualNP.CircuitLowerBounds.Gate } else x8) x5.gates, output := x5.output : PEqualNP.CircuitLowerBounds.Circuit };   have x9 : Fin x2 → Fin x2 → List Bool := fun (x9 x10 : Fin x2) => List.ofFn fun (x11 : Fin (x2 + x2)) => Decidable.decide (x11 = Fin.castAdd x2 x9 ∨ x11 = Fin.natAdd x2 x10);   have ne : ℕ := Fintype.card { l : Fin x2 // (x6 l).Nonempty };   (1894 : ℕ) ≤ (Finset.univ.biUnion x6).card → (1894 : ℕ) ≤ ne → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x14 : Fin x2), Fintype.card { x15 : Fin x2 // x3 x15 x14 } = x1 + (1 : ℕ)) → (∀ (x15 x16 : Fin x2), x15 ≠ x16 → ∃! x18 : Fin x2, x3 x15 x18 ∧ x3 x16 x18) → PEqualNP.MetaComplexity.IsMinimalMonoCircuit (x2 + x2) x5 → (∀ (x17 : Finset (Fin x2)), x17.card ≤ x1 → x5.eval (x7 x17) = Bool.false) → (∀ (x18 x19 : Fin x2), x19 ∈ x6 x18 → x3 x19 x18 ∧ x5.eval (x9 x19 x18) = Bool.true ∧ x8.eval (x9 x19 x18) = Bool.false) → 22 * ne < (Finset.univ.sigma x6).card → ∑ x19 : Fin x2, (x6 x19).card ≤ (44 : ℕ) * Fintype.card { x19 : Fin x5.size // (x5.wires (List.replicate (x2 + x2) Bool.false)).getD (x2 + x2 + ↑x19) Bool.false = Bool.false ∧ ∃ (x20 : Fin x2), ∃ x21 ∈ x6 x20, (x5.wires (x9 x21 x20)).getD (x2 + x2 + ↑x19) Bool.false = Bool.true }) :
    ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit) (x6 : Fin x2 → Finset (Fin x2)),   have x7 : Finset (Fin x2) → Fin (x2 + x2) → Bool := fun (x7 : Finset (Fin x2)) (x8 : Fin (x2 + x2)) => Fin.addCases (fun (x9 : Fin x2) => Decidable.decide ¬∃ x10 ∈ x7, x3 x9 x10) (fun (x9 : Fin x2) => Decidable.decide (x9 ∈ x7)) x8;   have x8 : PEqualNP.CircuitLowerBounds.Circuit := { gates := List.map (fun (x8 : PEqualNP.CircuitLowerBounds.Gate) => if x8.op.eval [] = Bool.true ∧ x8.inputs.length = (2 : ℕ) ∧ (x8.inputs.all fun (x9 : ℕ) => Decidable.decide ((0 : ℕ) < (x5.lineDegrees (x2 + x2) (Finset.Ico x2 (x2 + x2))).getD x9 (0 : ℕ))) = Bool.true then { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [] : PEqualNP.CircuitLowerBounds.Gate } else x8) x5.gates, output := x5.output : PEqualNP.CircuitLowerBounds.Circuit };   have x9 : Fin x2 → Fin x2 → Fin (x2 + x2) → Bool := fun (x9 x10 : Fin x2) (x11 : Fin (x2 + x2)) => Decidable.decide (x11 = Fin.castAdd x2 x9 ∨ x11 = Fin.natAdd x2 x10);   (1894 : ℕ) ≤ (Finset.univ.biUnion x6).card → (1894 : ℕ) ≤ Fintype.card { x11 : Fin x2 // (x6 x11).Nonempty } → (2 : ℕ) ≤ x1 → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x14 : Fin x2), Fintype.card { x15 : Fin x2 // x3 x15 x14 } = x1 + (1 : ℕ)) → (∀ (x15 x16 : Fin x2), x15 ≠ x16 → ∃! x18 : Fin x2, x3 x15 x18 ∧ x3 x16 x18) → PEqualNP.MetaComplexity.IsMinimalMonoCircuit (x2 + x2) x5 → (∀ (x17 : Finset (Fin x2)), x17.card ≤ x1 → x5.eval (List.ofFn (x7 x17)) = Bool.false) → (∀ (x18 x19 : Fin x2), x19 ∈ x6 x18 → x3 x19 x18 ∧ x5.eval (List.ofFn (x9 x19 x18)) = Bool.true ∧ x8.eval (List.ofFn (x9 x19 x18)) = Bool.false) → ∑ x19 : Fin x2, (x6 x19).card ≤ (44 : ℕ) * Fintype.card { x19 : Fin x5.size // (x5.wires (List.replicate (x2 + x2) Bool.false)).getD (x2 + x2 + ↑x19) Bool.false = Bool.false ∧ ∃ (x20 : Fin x2), ∃ x21 ∈ x6 x20, (x5.wires (List.ofFn (x9 x21 x20))).getD (x2 + x2 + ↑x19) Bool.false = Bool.true } := by
  intro q n inc inst c A
  dsimp only
  intro hpts hlns _hq horder hlines hunique hminimal hfalse hA
  classical
  by_cases h : 22 * Fintype.card { l : Fin n // (A l).Nonempty } < ∑ l : Fin n, (A l).card
  · exact dense q n inc c A hpts hlns horder hlines hunique hminimal hfalse hA
      (by rwa [Finset.card_sigma])
  · have hz := hfalse (∅ : Finset (Fin n)) (by simp)
    simp only [Finset.notMem_empty, false_and, exists_false, not_false_eq_true, decide_true,
      decide_false] at hz
    let pruned : PEqualNP.CircuitLowerBounds.Circuit := { gates := List.map (fun (x8 : PEqualNP.CircuitLowerBounds.Gate) => if x8.op.eval [] = Bool.true ∧ x8.inputs.length = (2 : ℕ) ∧ (x8.inputs.all fun (x9 : ℕ) => Decidable.decide ((0 : ℕ) < (c.lineDegrees (n + n) (Finset.Ico n (n + n))).getD x9 (0 : ℕ))) = Bool.true then { op := PEqualNP.CircuitLowerBounds.GateOp.or, inputs := [] : PEqualNP.CircuitLowerBounds.Gate } else x8) c.gates, output := c.output : PEqualNP.CircuitLowerBounds.Circuit }
    have hs := support n c pruned rfl hminimal.1 hz A (fun l p hp => (hA l p hp).2)
    exact (Nat.le_of_not_gt h).trans
      ((Nat.mul_le_mul_left 22 hs).trans_eq (Nat.mul_assoc 22 2 _).symm)
