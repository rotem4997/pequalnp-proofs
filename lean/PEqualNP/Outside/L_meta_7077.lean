    have h_eq : s(u, v) = s(t0, t1) := by
      rcases ht0_uv with rfl | rfl <;> rcases ht1_uv with rfl | rfl
      · exact (hne01 rfl).elim
      · rfl
      · exact Sym2.eq_swap
      · exact (hne01 rfl).elim
