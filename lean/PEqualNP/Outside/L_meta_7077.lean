    · have ht0_A0 : t_w ∈ A0 := Finset.mem_inter.mpr ⟨ht0, htw⟩
      dsimp only [K0]
      by_cases hA0 : A0.card ≤ 1
      · refine ⟨t_w, Finset.mem_union_left _ ?_, by simp⟩
        rw [if_pos hA0]; exact ht0_A0
      · refine ⟨t1, Finset.mem_union_left _ ?_, by simp⟩
        rw [if_neg hA0]; exact ht1
    · have ht1_B1 : t_w ∈ B1 := Finset.mem_inter.mpr ⟨ht1, htw⟩
      dsimp only [K1]
