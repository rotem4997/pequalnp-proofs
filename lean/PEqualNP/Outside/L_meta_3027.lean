-- points s p q are 0 1 2, lines r t are 0 1; edges sr, pr, qt
def Iw : Fin 3 → Fin 2 → Prop := fun p l =>
  (p.val = 0 ∧ l.val = 0) ∨ (p.val = 1 ∧ l.val = 0) ∨ (p.val = 2 ∧ l.val = 1)

instance instIw : DecidableRel Iw := fun p l =>
  inferInstanceAs (Decidable ((p.val = 0 ∧ l.val = 0) ∨ (p.val = 1 ∧ l.val = 0) ∨ (p.val = 2 ∧ l.val = 1)))

-- wires: inputs 0..4 (s p q r t), gates 5..16; gate 3 (wire 8) is c = s OR ((p OR q) AND (r OR t))
def Cw : Circuit :=
  { gates := [⟨GateOp.or, [1, 2]⟩, ⟨GateOp.or, [3, 4]⟩, ⟨GateOp.and, [5, 6]⟩,
      ⟨GateOp.or, [0, 7]⟩, ⟨GateOp.or, [1, 4]⟩, ⟨GateOp.or, [2, 3]⟩,
      ⟨GateOp.and, [9, 10]⟩, ⟨GateOp.or, [3, 4]⟩, ⟨GateOp.and, [11, 12]⟩,
      ⟨GateOp.and, [8, 13]⟩, ⟨GateOp.and, [0, 3]⟩, ⟨GateOp.or, [14, 15]⟩],
    output := 16 }

