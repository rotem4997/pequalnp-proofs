import Mathlib
import PEqualNP.Defs

-- The first productive gate has 31 possibilities up to input symmetries.
set_option maxRecDepth 10000 in
theorem PEqualNP.Outside.R_meta_3535_31
    (search : let A : List ℕ := [917681471495, 14877982776, 31886295695808, 257731333632, 42884715540480, 82789891276800, 248671168364609, 198670308900872, 158476001153026, 238332533547520, 176488259388544, 212188564308240, 280375465084964, 271282175770697, 280357743665737]; let reps : List ℕ := [1, 2, 512, 1024, 9739698184, 14336655368, 240547004928, 272595947064, 927693799487, 32803808084423, 43142442941952, 158482008182842, 158596264173058, 159393682624519, 176745990721152, 194218182251650, 198679179923466, 198685186883640, 198721861881352, 198967232331791, 229789638152466, 238334157529656, 238470001930754, 238590264880640, 271282448470091, 271287314055289, 271299360099913, 275888812335681, 280357747929675, 280358284993145, 280374927994441]; ∃ g ∈ reps, ∃ Z : List ℕ, Z.length ≤ 21 ∧ 262143 ∈ Z ∧ (∀ i : Fin Z.length, ∃ a ∈ (A ++ [g]) ++ Z.take i.val, ∃ b ∈ (A ++ [g]) ++ Z.take i.val, Z.get i = a &&& b ∨ Z.get i = a ||| b))
    (replay : let A : List ℕ := [917681471495, 14877982776, 31886295695808, 257731333632, 42884715540480, 82789891276800, 248671168364609, 198670308900872, 158476001153026, 238332533547520, 176488259388544, 212188564308240, 280375465084964, 271282175770697, 280357743665737]; let B : List ℕ := [95229015649943559, 63038587666488, 256462815680, 4292497062759936, 8521481482240, 14003410187812864, 55389823207997440, 189297016294081033, 155696362464477250, 218994303132270608, 183565875465490436, 229736628138025984, 270286071508633728, 288160007407550752, 191866593364673099, 193001360500003407, 7]; ∀ Z : List ℕ, (∀ i : Fin Z.length, ∃ a ∈ A ++ Z.take i.val, ∃ b ∈ A ++ Z.take i.val, Z.get i = a &&& b ∨ Z.get i = a ||| b) → ∃ Y : List ℕ, Y.length = Z.length ∧ (∀ i : Fin Y.length, ∃ a ∈ B ++ Y.take i.val, ∃ b ∈ B ++ Y.take i.val, Y.get i = a &&& b ∨ Y.get i = a ||| b) ∧ (262143 ∈ Z → ∃ f ∈ Y, f ||| 7 = 2097151)) :
    have x1 : List ℕ := [(95229015649943559 : ℕ), (63038587666488 : ℕ), (256462815680 : ℕ), (4292497062759936 : ℕ), (8521481482240 : ℕ), (14003410187812864 : ℕ), (55389823207997440 : ℕ), (189297016294081033 : ℕ), (155696362464477250 : ℕ), (218994303132270608 : ℕ), (183565875465490436 : ℕ), (229736628138025984 : ℕ), (270286071508633728 : ℕ), (288160007407550752 : ℕ)] ++ [(191866593364673099 : ℕ), (193001360500003407 : ℕ), (7 : ℕ)]; ∃ (x2 : List ℕ), x2.length ≤ (22 : ℕ) ∧ (∃ x3 ∈ x1 ++ x2, x3 ||| (7 : ℕ) = (2097151 : ℕ)) ∧ ∀ (x3 : Fin x2.length), ∃ x4 ∈ x1 ++ List.take (↑x3) x2, ∃ x5 ∈ x1 ++ List.take (↑x3) x2, x2.get x3 = x4 &&& x5 ∨ x2.get x3 = x4 ||| x5 := by
  let A : List ℕ := [917681471495, 14877982776, 31886295695808, 257731333632, 42884715540480, 82789891276800, 248671168364609, 198670308900872, 158476001153026, 238332533547520, 176488259388544, 212188564308240, 280375465084964, 271282175770697, 280357743665737]
  let reps : List ℕ := [1, 2, 512, 1024, 9739698184, 14336655368, 240547004928, 272595947064, 927693799487, 32803808084423, 43142442941952, 158482008182842, 158596264173058, 159393682624519, 176745990721152, 194218182251650, 198679179923466, 198685186883640, 198721861881352, 198967232331791, 229789638152466, 238334157529656, 238470001930754, 238590264880640, 271282448470091, 271287314055289, 271299360099913, 275888812335681, 280357747929675, 280358284993145, 280374927994441]

  have gates : ∀ g ∈ reps, ∃ a ∈ A, ∃ b ∈ A, g = a &&& b ∨ g = a ||| b := by decide +kernel
  dsimp only at search replay ⊢
  obtain ⟨g,hg,Z,small,found,tail⟩ := search
  have valid : ∀ i : Fin (g::Z).length, ∃ a ∈ A ++ (g::Z).take i.val, ∃ b ∈ A ++ (g::Z).take i.val,
      (g::Z).get i = a &&& b ∨ (g::Z).get i = a ||| b := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · simpa using gates g hg
    · simpa [List.get_eq_getElem,List.take_succ_cons,List.append_assoc,A] using tail j
  obtain ⟨Y,sz,well,cover⟩ := replay (g::Z) valid
  have length : Y.length ≤ 22 := by simp only [List.length_cons] at sz; omega
  obtain ⟨f,hf,eq⟩ := cover (List.mem_cons_of_mem _ found)
  exact ⟨Y,length,⟨f,List.mem_append_right _ hf,eq⟩,well⟩
