theorem litRow_val : ∀ x : Fin 4 → Bool, gg (litRow (PEqualNP.MetaComplexity.tableIndex x)) = (6 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x) := by decide +kernel

