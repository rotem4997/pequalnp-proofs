def N : ℕ := 

def ix (k : ℕ) : ℕ := (N >>> (10 * k)) % 1024

def pop (t : ℕ) : ℕ := (List.range 11).countP fun i => t.testBit i

def va (x : ℕ) : ℕ := (pop x + 1) / 2

def ckc (c : ℕ × List ℕ) : Bool :=
  decide (List.Pairwise (fun x y => x &&& y = 0) c.2) && c.2.all (fun x => L.contains x) &&
    decide (pop c.1 ≤ (c.2.map va).sum)

theorem k1 : K.all ckc = true := by
  decide +kernel

def ck1 (c : ℕ × List ℕ) (k : ℕ) : Bool :=
  c.2.all (fun x => x &&& k == 0) &&
    E.all fun e => (k ||| c.1).testBit e.1 || (k ||| c.1).testBit e.2

def cks (k : ℕ) : Bool := decide (ix k < K.length) && ck1 (K.getD (ix k) (0, [])) k

theorem k2 : ∀ (a : Fin 32) (b : Fin 64), cks (64 * a.val + b.val) = true := by
  decide +kernel

theorem k3 : ∀ x ∈ L, (x.bitIndices.length + 1) / 2 = va x := by
  intro x hx
  simp only [L, List.mem_cons, List.not_mem_nil, or_false] at hx
  rcases hx with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl |
    rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide +kernel

