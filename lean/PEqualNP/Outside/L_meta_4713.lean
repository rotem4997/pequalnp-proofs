theorem PEqualNP.Outside.L_meta_4713 : have x1 : SimpleGraph (Fin (11 : ℕ)) := PEqualNP.EdgeOwnership.edgeGraph (11 : ℕ) [((0 : ℕ), (9 : ℕ)), ((0 : ℕ), (10 : ℕ)), ((1 : ℕ), (4 : ℕ)), ((1 : ℕ), (8 : ℕ)), ((2 : ℕ), (5 : ℕ)), ((2 : ℕ), (10 : ℕ)), ((3 : ℕ), (6 : ℕ)), ((3 : ℕ), (7 : ℕ)), ((4 : ℕ), (8 : ℕ)), ((4 : ℕ), (10 : ℕ)), ((5 : ℕ), (8 : ℕ)), ((5 : ℕ), (9 : ℕ)), ((6 : ℕ), (7 : ℕ)), ((6 : ℕ), (10 : ℕ)), ((7 : ℕ), (9 : ℕ)), ((8 : ℕ), (9 : ℕ))]; have x2 : List ℕ := [(513 : ℕ), (1025 : ℕ), (18 : ℕ), (258 : ℕ), (36 : ℕ), (1028 : ℕ), (72 : ℕ), (136 : ℕ), (272 : ℕ), (1040 : ℕ), (288 : ℕ), (544 : ℕ), (192 : ℕ), (1088 : ℕ), (640 : ℕ), (768 : ℕ), (274 : ℕ), (200 : ℕ), (800 : ℕ), (1573 : ℕ), (1809 : ℕ), (1729 : ℕ), (1332 : ℕ)]; ∀ (x3 : Finset (Fin (11 : ℕ))), ∃ (x4 : List ℕ) (x5 : Finset (Fin (11 : ℕ))), List.Pairwise (fun (x6 x7 : ℕ) => x6 &&& x7 = (0 : ℕ)) x4 ∧ (∀ x6 ∈ x4, x6 ∈ x2 ∧ ∀ x8 ∈ x3, x6.testBit ↑x8 = Bool.false) ∧ x1.IsVertexCover ↑(x3 ∪ x5) ∧ x5.card ≤ (List.map (fun (x6 : ℕ) => (x6.bitIndices.length + (1 : ℕ)) / (2 : ℕ)) x4).sum := by
  intro G l S
  let k := Nat.ofBits fun i : Fin 11 => decide (i ∈ S)
  have hk : k < 2048 := Nat.ofBits_lt_two_pow _
  have hb : ∀ i : Fin 11, k.testBit i.val = decide (i ∈ S) := fun i => by
    simp only [k]
    rw [Nat.testBit_ofBits_lt _ _ i.isLt]
  have h2 := k2 ⟨k / 64, by omega⟩ ⟨k % 64, by omega⟩
  simp only [Nat.div_add_mod] at h2
  simp only [cks, ck1, Bool.and_eq_true, decide_eq_true_eq] at h2
  obtain ⟨hlen, hdis, hcov⟩ := h2
  set c := K.getD (ix k) (0, []) with hc
  have hcK : c ∈ K := by
    rw [hc, List.getD_eq_getElem _ _ hlen]
    exact List.getElem_mem hlen
  have h1 := List.all_eq_true.1 k1 c hcK
  simp only [ckc, Bool.and_eq_true, decide_eq_true_eq] at h1
  obtain ⟨⟨hpw, hmem⟩, hcard⟩ := h1
  have hmem' : ∀ x ∈ c.2, x ∈ L := fun x hx => by
    simpa using List.all_eq_true.1 hmem x hx
  refine ⟨c.2, Finset.univ.filter fun i : Fin 11 => c.1.testBit i.val = true, hpw,
    fun x hx => ⟨hmem' x hx, fun i hi => ?_⟩, ?_, ?_⟩
  · have h := List.all_eq_true.1 hdis x hx
    have h' : x &&& k = 0 := by simpa using h
    have e := congrArg (fun t => t.testBit i.val) h'
    simp only [Nat.testBit_and, hb i, hi, decide_true, Bool.and_true, Nat.zero_testBit] at e
    exact e
  · have key : ∀ p ∈ E, ∀ u v : Fin 11, u.val = p.1 → v.val = p.2 →
        (u ∈ S ∪ Finset.univ.filter fun i : Fin 11 => c.1.testBit i.val = true) ∨
        (v ∈ S ∪ Finset.univ.filter fun i : Fin 11 => c.1.testBit i.val = true) := by
      intro p hp u v hu hv
      have h := List.all_eq_true.1 hcov p hp
      rw [← hu, ← hv] at h
      simpa [Nat.testBit_or, hb] using h
    intro u v huv
    rcases huv.2 with h | h
    · exact_mod_cast key _ h u v rfl rfl
    · exact_mod_cast (key _ h v u rfl rfl).symm
  · have e : (List.map (fun x : ℕ => (x.bitIndices.length + 1) / 2) c.2) = c.2.map va :=
      List.map_congr_left fun x hx => k3 x (hmem' x hx)
    rw [e]
    refine le_trans (le_of_eq ?_) hcard
    rw [Finset.card_filter]
    simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, pop, List.range_succ, List.range_zero,
      List.countP_append, List.countP_cons, List.countP_nil]
    simp
    ring
