def table : BitVec 1024 := 0x10f0105020508c18a6860e806ac8ae9e28c180f8553080be50ddf79e6891afb9540580824024148640d9d7bca88c229000b07351f447af4000b014586ab804a45e55690e10a0073568658ad53050a01024508c1a7455fba3d65a6f1a6879a8a50004140274d0fd25a88822901b7982bb1d58483ac443c8c259092a9df2bc7573

theorem mono : Monotone2 circuit := by
  intro g hg
  obtain ⟨⟨b,i,j⟩, _, rfl⟩ := List.mem_map.mp (show g ∈ codes.map asGate from hg)
  cases b <;> simp [asGate]

theorem fan : FanInTwo circuit := by
  intro g hg
  obtain ⟨ho,hl⟩ := mono g hg
  refine ⟨?_,hl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ho ⊢
  tauto

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem raw_spec : ∀ u v : Fin 32,
    (raw.map fun w => w.getLsbD (32 * u.val + v.val)) = oneEach u v := by
  decide +kernel

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem calculated : (circuit.gates.foldl hcsStep raw).getD circuit.output 0 = table := by
  decide +kernel

theorem target_spec : ∀ u v : Fin 32, table.getLsbD (32*u.val + v.val) = Nat.testBit 0x10f0105020508c18a6860e806ac8ae9e28c180f8553080be50ddf79e6891afb9540580824024148640d9d7bca88c229000b07351f447af4000b014586ab804a45e55690e10a0073568658ad53050a01024508c1a7455fba3d65a6f1a6879a8a50004140274d0fd25a88822901b7982bb1d58483ac443c8c259092a9df2bc7573 (32*u.val+v.val) := by
  decide +kernel

