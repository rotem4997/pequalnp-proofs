/-- Every circuit of AND, OR and NOT gates of fan-in at most two computing the function on 4
inputs has at least 5 gates. -/
theorem lower : ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (11007 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t →
    5 ≤ t :=
  size_of_unsat2 4 4 fn rows (by decide) unsat

/-- The circuit of 5 gates computing the function. -/
def w : PEqualNP.CircuitLowerBounds.Circuit := ⟨[⟨PEqualNP.CircuitLowerBounds.GateOp.and, [1, 2]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [3]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.not, [4]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.and, [0, 6]⟩, ⟨PEqualNP.CircuitLowerBounds.GateOp.or, [5, 7]⟩], 8⟩

theorem fint : PEqualNP.MetaComplexity.FanInTwo w := by
  intro g hg
  simp only [w, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl <;> simp

set_option maxRecDepth 1000000 in
set_option maxHeartbeats 0 in
theorem upper : PEqualNP.MetaComplexity.HasCircuitSize 4 (fun x : Fin 4 → Bool => (11007 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) 5 :=
  ⟨w, fint, by decide, by decide +kernel⟩

