def litRow (r : ℕ) : ℕ := r + 16 * (15 - r)

theorem litRow_eq : ∀ x : Fin 4 → Bool,
    (List.ofFn fun i : Fin 8 => (litRow (PEqualNP.MetaComplexity.tableIndex x)).testBit i) =
      List.ofFn x ++ List.ofFn fun i => !x i := by decide +kernel

theorem litRow_val : ∀ x : Fin 4 → Bool, gg (litRow (PEqualNP.MetaComplexity.tableIndex x)) = (7 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x) := by decide +kernel

theorem litRow_all : ∀ r ∈ rows, ∃ x : Fin 4 → Bool, litRow (PEqualNP.MetaComplexity.tableIndex x) = r := by decide +kernel

theorem lower (t : ℕ) (h : PEqualNP.Represents.HasLitSize 4 (fun x : Fin 4 → Bool => (7 : ℕ).testBit (PEqualNP.MetaComplexity.tableIndex x)) t) : 3 ≤ t := by
  by_contra hlt
  obtain ⟨D, hD, hs, hr⟩ := h
  have hF : PEqualNP.MetaComplexity.FanInTwo D := fun g hg => by
    obtain ⟨h1, h2⟩ := hD g hg
    exact ⟨by rcases h1 with h | h <;> simp_all, h2⟩
  have hv := valid_ofCirc 8 2 gg (· ∈ rows) D hF (by have h0 : D.gates.length ≤ t := hs; omega) (fun r hm => by
    obtain ⟨x, rfl⟩ := litRow_all r hm
    show D.eval (List.ofFn fun i : Fin 8 => (litRow (PEqualNP.MetaComplexity.tableIndex x)).testBit i) = _
    rw [litRow_eq, hr, litRow_val])
  obtain ⟨M, hM, hnf, hlx⟩ := exists_nf2 ⟨_, hv⟩
  exact refuted ⟨val 8 2 M, enc2_sat (by decide) hM hnf hlx⟩

