        · simp [hgy] at hlen_y
      · simp [hsg] at hab
    push Not at habs

    have hout_last : T.output = n + (T.gates.length - 1) := by
      by_contra hne
      obtain ⟨g, hg, hmem⟩ := hunused (T.gates.length - 1) (by omega) hne
      obtain ⟨k, hk, rfl⟩ := List.mem_iff_getElem.mp hg
      have hlt := readsBack_mem hAO k hk (n + (T.gates.length - 1)) hmem
      omega
    have hn_pos : 0 < n := by
      have h0 : 0 < T.gates.length := by omega
      have hlen0 := hAO.2.2 _ (List.getElem_mem h0)
      rcases hgi : (T.gates[0]'h0).inputs with _ | ⟨u, _⟩
      · simp [hgi] at hlen0
      · have := readsBack_mem hAO 0 h0 u (by simp [hgi]); omega
    have hused' : ∀ j < T.gates.length - 1, ∃ g ∈ T.gates, n + j ∈ g.inputs := fun j hj =>
      hunused j (by omega) (by omega)
    have habs' : ∀ j (hj : j < T.gates.length),
        absorbBad (sOfGate n (T.gates[j]'hj)) ((T.gates.take j).map (sOfGate n)) = false :=
      fun j hj => Bool.eq_false_iff.mpr (habs j hj)
    have hdup' : ∀ i j (hi : i < T.gates.length) (hj : j < T.gates.length), i < j →
