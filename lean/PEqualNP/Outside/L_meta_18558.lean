private def varMask : Nat → Nat
  | 0 => 12297829382473034410
  | 1 => 14757395258967641292
  | 2 => 17361641481138401520
  | 3 => 18374966859414961920
  | 4 => 18446462603027742720
  | 5 => 18446744069414584320
  | _ => 0

private def evalFormulaTT : DMFormula 6 → Nat
  | DMFormula.lit i _ => varMask i.val
  | DMFormula.and x y => (evalFormulaTT x) &&& (evalFormulaTT y)
  | DMFormula.or x y => (evalFormulaTT x) ||| (evalFormulaTT y)

private def bitsToNat (f : Nat → Bool) (k : Nat) : Nat :=
  (List.range k).foldl (fun acc b => if f b then acc ||| (1 <<< b) else acc) 0

private def substMaskTT (m : Nat) (p : List Nat) : Nat :=
  let c0 := p.getD 0 0; let c1 := p.getD 1 0; let c2 := p.getD 2 0
  let c3 := p.getD 3 0; let c4 := p.getD 4 0; let c5 := p.getD 5 0
  bitsToNat (fun b =>
    let idx := (if b.testBit c0 then 1 else 0) + (if b.testBit c1 then 2 else 0) +
               (if b.testBit c2 then 4 else 0) + (if b.testBit c3 then 8 else 0) +
               (if b.testBit c4 then 16 else 0) + (if b.testBit c5 then 32 else 0)
    m.testBit idx) 64

private def checkEntry (e : Nat × Sum (DMFormula 6) (Nat × List Nat)) : Bool :=
  match e.2 with
  | Sum.inl phi => decide (phi.leaves ≤ 7) && (evalFormulaTT phi == e.1)
  | Sum.inr (mi, p) => decide (mi < 7 ∧ p.length = 6) && p.all (fun x => decide (x < 6)) &&
      (substMaskTT (magicList.getD mi 0) p == e.1)

