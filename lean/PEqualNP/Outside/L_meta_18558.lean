private def pairVals (s : List Nat) (vs : List Nat) (nv : Nat) : Nat × Nat × Nat :=
  match s with
  | [] => (varMask nv, varMask (nv + 1), nv + 2)
  | [x] => (vs.getD x 0, varMask nv, nv + 1)
  | [x, y] => (vs.getD x 0, vs.getD y 0, nv)
  | _ => (0, 0, nv)

private def leafOf (s : List Nat) (ls : List Nat) : Nat :=
  match s with
  | [] => 2
  | [x] => 1 + ls.getD x 0
  | [x, y] => ls.getD x 0 + ls.getD y 0
  | _ => 0

private def absorbBad (s : List Nat) (prev : List (List Nat)) : Bool :=
  match s with
  | [x, y] => (prev.getD y []).contains x
  | _ => false

private def checkOpsRec (S : List (List Nat)) (j : Nat) (vs : List Nat) (nv : Nat) (ops : List Bool) : Bool :=
  if j + 1 < S.length then
    let s := S.getD j []
    let (v1, v2, nv') := pairVals s vs nv
    let dup (b : Bool) : Bool :=
      if s.length != 2 then false else
      (List.range j).any (fun i => S.getD i [] == s && ops.getD i false == b)
    let okF := if dup false then true else checkOpsRec S (j + 1) (vs ++ [v1 &&& v2]) nv' (ops ++ [false])
    let okT := if dup true then true else checkOpsRec S (j + 1) (vs ++ [v1 ||| v2]) nv' (ops ++ [true])
    okF && okT
  else
    let s := S.getD j []
    let (v1, v2, _) := pairVals s vs nv
    let dupF : Bool :=
      if s.length != 2 then false else
      (List.range j).any (fun i => S.getD i [] == s && ops.getD i false == false)
    if dupF then true else hasKey (v1 &&& v2)
termination_by S.length - j

private def checkK3 : Bool :=
  let l0 := 2
  opts1.all fun s1 =>
    let l1 := leafOf s1 [l0]
    opts2.all fun s2 =>
      decide (leafOf s2 [l0, l1] < 8)

private def checkK4 : Bool :=
  let s0 : List Nat := []; let l0 := 2
  opts1.all fun s1 =>
    let l1 := leafOf s1 [l0]
    opts2.all fun s2 =>
      if absorbBad s2 [s0, s1] then true else
      let l2 := leafOf s2 [l0, l1]
      opts3.all fun s3 =>
        if absorbBad s3 [s0, s1, s2] then true else
        let l3 := leafOf s3 [l0, l1, l2]
        decide (l3 < 8)

private def checkK5 : Bool :=
  let s0 : List Nat := []; let l0 := 2
  opts1.all fun s1 =>
    let l1 := leafOf s1 [l0]
    opts2.all fun s2 =>
      if absorbBad s2 [s0, s1] then true else
      let l2 := leafOf s2 [l0, l1]
      opts3.all fun s3 =>
        if absorbBad s3 [s0, s1, s2] then true else
        let l3 := leafOf s3 [l0, l1, l2]
        opts4.all fun s4 =>
          if absorbBad s4 [s0, s1, s2, s3] then true else
          let l4 := leafOf s4 [l0, l1, l2, l3]
          if l4 < 8 then true else
          let S := [s0, s1, s2, s3, s4]
          if !(S.any (·.contains 0) && S.any (·.contains 1) && S.any (·.contains 2) && S.any (·.contains 3)) then true else
          decide ((2 - s0.length) + (2 - s1.length) + (2 - s2.length) + (2 - s3.length) + (2 - s4.length) ≤ 6) &&
          checkOpsRec S 0 [] 0 []

private def checkK6 : Bool :=
  let s0 : List Nat := []; let l0 := 2
  opts1.all fun s1 =>
    let l1 := leafOf s1 [l0]
    opts2.all fun s2 =>
      if absorbBad s2 [s0, s1] then true else
      let l2 := leafOf s2 [l0, l1]
      opts3.all fun s3 =>
        if absorbBad s3 [s0, s1, s2] then true else
        let l3 := leafOf s3 [l0, l1, l2]
        opts4.all fun s4 =>
          if absorbBad s4 [s0, s1, s2, s3] then true else
          let l4 := leafOf s4 [l0, l1, l2, l3]
          opts5.all fun s5 =>
            if absorbBad s5 [s0, s1, s2, s3, s4] then true else
            let l5 := leafOf s5 [l0, l1, l2, l3, l4]
            if l5 < 8 then true else
            let S := [s0, s1, s2, s3, s4, s5]
            if !(S.any (·.contains 0) && S.any (·.contains 1) && S.any (·.contains 2) && S.any (·.contains 3) && S.any (·.contains 4)) then true else
            decide ((2 - s0.length) + (2 - s1.length) + (2 - s2.length) + (2 - s3.length) + (2 - s4.length) + (2 - s5.length) ≤ 6) &&
            checkOpsRec S 0 [] 0 []

