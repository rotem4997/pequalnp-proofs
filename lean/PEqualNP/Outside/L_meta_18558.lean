private theorem magic_duals_ok :
    (List.range 7).all (fun mi =>
      let m := magicList.getD mi 0
      let d := magicDuals.getD mi (0, [])
      decide (d.1 < 7 ∧ d.2.length = 6) && d.2.all (fun x => decide (x < 6)) &&
      (List.range 64).all (fun b =>
        let p := d.2
        let idx := (if b.testBit (p.getD 0 0) then 1 else 0) + (if b.testBit (p.getD 1 0) then 2 else 0) +
                   (if b.testBit (p.getD 2 0) then 4 else 0) + (if b.testBit (p.getD 3 0) then 8 else 0) +
                   (if b.testBit (p.getD 4 0) then 16 else 0) + (if b.testBit (p.getD 5 0) then 32 else 0)
        (!(m.testBit (63 - b))) == (magicList.getD d.1 0).testBit idx)) = true := by
  decide +kernel

private def evalPos {n : Nat} : DMFormula n → (Fin n → Bool) → Bool
  | DMFormula.lit i _, x => x i
  | DMFormula.and f g, x => evalPos f x && evalPos g x
  | DMFormula.or f g, x => evalPos f x || evalPos g x

private lemma evalPos_eq_rec {n : Nat} (φ : DMFormula n) (x : Fin n → Bool) :
    evalPos φ x = DMFormula.rec (motive := fun _ => Bool) (fun i _ => x i)
      (fun _ _ a b => a && b) (fun _ _ a b => a || b) φ := by
  induction φ with
  | lit _ _ => rfl
  | and _ _ ih1 ih2 => simp [evalPos, ih1, ih2]
  | or _ _ ih1 ih2 => simp [evalPos, ih1, ih2]

private def pack6 (y : Fin 6 → Bool) : Nat :=
  ∑ j : Fin 6, if y j then ([1,2,4,8,16,32] : List Nat).getD j.val 0 else 0

private def Satisfies (n : Nat) (f : (Fin n → Bool) → Bool) : Prop :=
  (∃ φ : DMFormula n, φ.leaves ≤ 7 ∧ ∀ x : Fin n → Bool, f x = evalPos φ x) ∨
  ∃ m ∈ magicList, ∃ c : Fin 6 → Fin n, ∀ x : Fin n → Bool,
    f x = m.testBit (pack6 (fun j => x (c j)))

private def mkFin6 (b0 b1 b2 b3 b4 b5 : Bool) : Fin 6 → Bool
  | ⟨0, _⟩ => b0
  | ⟨1, _⟩ => b1
  | ⟨2, _⟩ => b2
  | ⟨3, _⟩ => b3
  | ⟨4, _⟩ => b4
  | ⟨5, _⟩ => b5

private lemma eq_mkFin6 (y : Fin 6 → Bool) :
    y = mkFin6 (y 0) (y 1) (y 2) (y 3) (y 4) (y 5) := by
  funext i
  fin_cases i <;> rfl

private lemma pack6_eq_sum6_bool : ∀ (b0 b1 b2 b3 b4 b5 : Bool),
    pack6 (mkFin6 b0 b1 b2 b3 b4 b5) =
      (if b0 then 1 else 0) + (if b1 then 2 else 0) + (if b2 then 4 else 0) +
      (if b3 then 8 else 0) + (if b4 then 16 else 0) + (if b5 then 32 else 0) := by
  decide

private lemma pack6_eq_sum6 (y : Fin 6 → Bool) :
    pack6 y = (if y 0 then 1 else 0) + (if y 1 then 2 else 0) + (if y 2 then 4 else 0) +
      (if y 3 then 8 else 0) + (if y 4 then 16 else 0) + (if y 5 then 32 else 0) := by
  conv_lhs => rw [eq_mkFin6 y]
  exact pack6_eq_sum6_bool _ _ _ _ _ _

private lemma pack6_lt_bool : ∀ (b0 b1 b2 b3 b4 b5 : Bool),
    pack6 (mkFin6 b0 b1 b2 b3 b4 b5) < 64 := by
  decide

private lemma pack6_lt (y : Fin 6 → Bool) : pack6 y < 64 := by
  rw [eq_mkFin6 y]
  exact pack6_lt_bool _ _ _ _ _ _

private lemma testBit_pack6_bool : ∀ (b0 b1 b2 b3 b4 b5 : Bool) (i : Fin 6),
    (pack6 (mkFin6 b0 b1 b2 b3 b4 b5)).testBit i.val = mkFin6 b0 b1 b2 b3 b4 b5 i := by
  decide

private lemma testBit_pack6 (y : Fin 6 → Bool) (i : Fin 6) :
    (pack6 y).testBit i.val = y i := by
  conv_lhs => rw [eq_mkFin6 y]
  conv_rhs => rw [eq_mkFin6 y]
  exact testBit_pack6_bool _ _ _ _ _ _ i

private lemma pack6_not_bool : ∀ (b0 b1 b2 b3 b4 b5 : Bool),
    pack6 (fun j => !(mkFin6 b0 b1 b2 b3 b4 b5 j)) = 63 - pack6 (mkFin6 b0 b1 b2 b3 b4 b5) := by
  decide

private lemma pack6_not (y : Fin 6 → Bool) :
    pack6 (fun j => !(y j)) = 63 - pack6 y := by
  conv_lhs => rw [eq_mkFin6 y]
  conv_rhs => rw [eq_mkFin6 y]
  exact pack6_not_bool _ _ _ _ _ _

private lemma testBit_varMask : ∀ (i : Fin 6) (b : Fin 64),
    (varMask i.val).testBit b.val = b.val.testBit i.val := by
  decide +kernel

private lemma testBit_evalFormulaTT (φ : DMFormula 6) (y : Fin 6 → Bool) :
    (evalFormulaTT φ).testBit (pack6 y) = evalPos φ y := by
  induction φ with
  | lit i b =>
    change (varMask i.val).testBit (pack6 y) = y i
    rw [testBit_varMask i ⟨pack6 y, pack6_lt y⟩, testBit_pack6 y i]
  | and x z ihx ihz =>
    change ((evalFormulaTT x) &&& (evalFormulaTT z)).testBit (pack6 y) =
      (evalPos x y && evalPos z y)
    rw [Nat.testBit_and, ihx, ihz]
  | or x z ihx ihz =>
    change ((evalFormulaTT x) ||| (evalFormulaTT z)).testBit (pack6 y) =
      (evalPos x y || evalPos z y)
    rw [Nat.testBit_or, ihx, ihz]

private lemma testBit_one_ne_zero (m : Nat) (hm : m ≠ 0) : Nat.testBit 1 m = false := by
  rw [Nat.testBit, Nat.shiftRight_eq_div_pow]
  have hpow : 1 < 2 ^ m := Nat.one_lt_two_pow hm
  rw [Nat.div_eq_of_lt hpow]
  rfl

private lemma testBit_bitsToNat (f : Nat → Bool) (k b : Nat) :
    (bitsToNat f k).testBit b = (decide (b < k) && f b) := by
  induction k with
  | zero => simp [bitsToNat]
  | succ k ih =>
    unfold bitsToNat at ih ⊢
    rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]
    by_cases hfk : f k = true
    · simp only [hfk, ite_true, Nat.testBit_or, ih, Nat.testBit_shiftLeft]
      by_cases hbk : b < k
      · have hne : ¬ (k ≤ b) := by omega
        have hlt : b < k + 1 := by omega
        simp [hbk, hne, hlt]
      · by_cases heq : b = k
        · subst heq; simp [hfk]
        · have h1 : ¬ (b < k + 1) := by omega
          have h2 : b - k ≠ 0 := by omega
          simp [hbk, h1, testBit_one_ne_zero _ h2]
    · have hfk' : f k = false := Bool.eq_false_iff.mpr hfk
      simp only [hfk', Bool.false_eq_true, ite_false, ih]
      by_cases hbk : b < k
      · have hlt : b < k + 1 := by omega
        simp [hbk, hlt]
      · by_cases heq : b = k
        · subst heq; simp [hfk']
        · have h1 : ¬ (b < k + 1) := by omega
          simp [hbk, h1]

private def mapFormula {n : Nat} (c : Fin 6 → Fin n) : DMFormula 6 → DMFormula n
  | DMFormula.lit i b => DMFormula.lit (c i) b
  | DMFormula.and x y => DMFormula.and (mapFormula c x) (mapFormula c y)
  | DMFormula.or x y => DMFormula.or (mapFormula c x) (mapFormula c y)

private lemma mapFormula_leaves {n : Nat} (c : Fin 6 → Fin n) (φ : DMFormula 6) :
    (mapFormula c φ).leaves = φ.leaves := by
  induction φ with
  | lit _ _ => rfl
  | and _ _ ih1 ih2 => simp [mapFormula, DMFormula.leaves, ih1, ih2]
  | or _ _ ih1 ih2 => simp [mapFormula, DMFormula.leaves, ih1, ih2]

private lemma mapFormula_evalPos {n : Nat} (c : Fin 6 → Fin n) (φ : DMFormula 6) (x : Fin n → Bool) :
    evalPos (mapFormula c φ) x = evalPos φ (fun j => x (c j)) := by
  induction φ with
  | lit _ _ => rfl
  | and _ _ ih1 ih2 => simp [mapFormula, evalPos, ih1, ih2]
  | or _ _ ih1 ih2 => simp [mapFormula, evalPos, ih1, ih2]

private lemma exists_witness_of_hasKey (tt : Nat) (h : hasKey tt = true) :
    ∃ w, checkEntry (tt, w) = true := by
  unfold hasKey at h
  dsimp only at h
  set r := (tt % 251) / 16
  set col := (tt % 251) % 16
  have hr_lt : r < keyGrid.length := by
    by_contra hge
    rw [List.getD_eq_default _ _ (Nat.le_of_not_lt hge)] at h
    simp at h
  have hr_lt_w : r < witnessGrid.length := by
    rw [keys_match, List.length_map] at hr_lt; exact hr_lt
  have hrow_eq : keyGrid.getD r [] = (witnessGrid[r]'hr_lt_w).map (fun b => b.map Prod.fst) := by
    rw [List.getD_eq_getElem _ _ hr_lt]
    simp [keys_match]
  rw [hrow_eq] at h
  have hc_lt : col < (witnessGrid[r]'hr_lt_w).length := by
    by_contra hge
    have hge' : ((witnessGrid[r]'hr_lt_w).map (fun b => b.map Prod.fst)).length ≤ col := by
      simpa using Nat.le_of_not_lt hge
    rw [List.getD_eq_default _ _ hge'] at h
    simp at h
  have hbuck_eq : ((witnessGrid[r]'hr_lt_w).map (fun b => b.map Prod.fst)).getD col [] =
      ((witnessGrid[r]'hr_lt_w)[col]'hc_lt).map Prod.fst := by
    rw [List.getD_eq_getElem _ _ (by simpa using hc_lt)]
    simp
  rw [hbuck_eq, List.contains_eq_mem, decide_eq_true_eq, List.mem_map] at h
  obtain ⟨⟨t', w⟩, hmem, ht'⟩ := h
  dsimp only at ht'
  subst ht'
  refine ⟨w, ?_⟩
  have h1 := List.all_eq_true.mp grid_valid _ (List.getElem_mem hr_lt_w)
  have h2 := List.all_eq_true.mp h1 _ (List.getElem_mem hc_lt)
  exact List.all_eq_true.mp h2 _ hmem

private lemma satisfies_of_hasKey {n : Nat} (f : (Fin n → Bool) → Bool) (tt : Nat)
    (c : Fin 6 → Fin n) (hkey : hasKey tt = true)
    (heq : ∀ x : Fin n → Bool, f x = tt.testBit (pack6 (fun j => x (c j)))) :
    Satisfies n f := by
  obtain ⟨w, hw⟩ := exists_witness_of_hasKey tt hkey
  cases w with
  | inl φ =>
    simp only [checkEntry, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hw
    left
    refine ⟨mapFormula c φ, by rw [mapFormula_leaves]; exact hw.1, fun x => ?_⟩
    rw [heq x, ← hw.2, testBit_evalFormulaTT, mapFormula_evalPos]
  | inr mp =>
    obtain ⟨mi, p⟩ := mp
    simp only [checkEntry, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq] at hw
    obtain ⟨⟨⟨hmi, hplen⟩, hpall⟩, hsub⟩ := hw
    have hpget : ∀ j : Fin 6, p.getD j.val 0 < 6 := by
      intro j
      have hj : j.val < p.length := by omega
      rw [List.getD_eq_getElem _ _ hj]
      exact of_decide_eq_true (List.all_eq_true.mp hpall _ (List.getElem_mem hj))
    right
    have hm_mem : magicList.getD mi 0 ∈ magicList := by
      have hml : mi < magicList.length := by simpa [magicList] using hmi
      rw [List.getD_eq_getElem _ _ hml]
      exact List.getElem_mem hml
    let c' : Fin 6 → Fin n := fun j => c ⟨p.getD j.val 0, hpget j⟩
    refine ⟨magicList.getD mi 0, hm_mem, c', fun x => ?_⟩
    rw [heq x, ← hsub]
    unfold substMaskTT
    rw [testBit_bitsToNat]
    have hlt := pack6_lt (fun j => x (c j))
    simp only [hlt, decide_true, Bool.true_and]
    congr 1
    conv_rhs => rw [pack6_eq_sum6]
    have htb (j : Fin 6) : (pack6 (fun k => x (c k))).testBit (p.getD j.val 0) = x (c' j) :=
      testBit_pack6 (fun k => x (c k)) ⟨p.getD j.val 0, hpget j⟩
    have h0 : (pack6 (fun k => x (c k))).testBit (p.getD 0 0) = x (c' 0) := htb 0
    have h1 : (pack6 (fun k => x (c k))).testBit (p.getD 1 0) = x (c' 1) := htb 1
    have h2 : (pack6 (fun k => x (c k))).testBit (p.getD 2 0) = x (c' 2) := htb 2
    have h3 : (pack6 (fun k => x (c k))).testBit (p.getD 3 0) = x (c' 3) := htb 3
    have h4 : (pack6 (fun k => x (c k))).testBit (p.getD 4 0) = x (c' 4) := htb 4
    have h5 : (pack6 (fun k => x (c k))).testBit (p.getD 5 0) = x (c' 5) := htb 5
    rw [h0, h1, h2, h3, h4, h5]

private def dualFormula {n : Nat} : DMFormula n → DMFormula n
  | DMFormula.lit i b => DMFormula.lit i b
  | DMFormula.and x y => DMFormula.or (dualFormula x) (dualFormula y)
  | DMFormula.or x y => DMFormula.and (dualFormula x) (dualFormula y)

private lemma dualFormula_leaves {n : Nat} (φ : DMFormula n) :
    (dualFormula φ).leaves = φ.leaves := by
  induction φ with
  | lit _ _ => rfl
  | and _ _ ih1 ih2 => simp [dualFormula, DMFormula.leaves, ih1, ih2]
  | or _ _ ih1 ih2 => simp [dualFormula, DMFormula.leaves, ih1, ih2]

private lemma dualFormula_evalPos {n : Nat} (φ : DMFormula n) (x : Fin n → Bool) :
    evalPos (dualFormula φ) x = !(evalPos φ (fun i => !(x i))) := by
  induction φ with
  | lit i b => simp [dualFormula, evalPos]
  | and a b iha ihb => simp [dualFormula, evalPos, iha, ihb]
  | or a b iha ihb => simp [dualFormula, evalPos, iha, ihb]

private lemma satisfies_dual {n : Nat} (f : (Fin n → Bool) → Bool)
    (h : Satisfies n (fun x => !(f (fun i => !(x i))))) : Satisfies n f := by
  rcases h with ⟨φ, hle, heq⟩ | ⟨m, hm, c, heq⟩
  · left
    refine ⟨dualFormula φ, by rw [dualFormula_leaves]; exact hle, fun x => ?_⟩
    rw [dualFormula_evalPos]
    have h1 := heq (fun i => !(x i))
    dsimp only at h1
    have hnn : (fun i => !(!(x i))) = x := by funext i; simp
    rw [hnn] at h1
    cases hfx : f x <;> simp_all
  · right
    have hidx : ∃ mi < 7, magicList.getD mi 0 = m := by
      simp only [magicList, List.mem_cons, List.not_mem_nil, or_false] at hm
      rcases hm with rfl | rfl | rfl | rfl | rfl | rfl | rfl
      · exact ⟨0, by omega, rfl⟩
      · exact ⟨1, by omega, rfl⟩
      · exact ⟨2, by omega, rfl⟩
      · exact ⟨3, by omega, rfl⟩
      · exact ⟨4, by omega, rfl⟩
      · exact ⟨5, by omega, rfl⟩
      · exact ⟨6, by omega, rfl⟩
    obtain ⟨mi, hmi, rfl⟩ := hidx
    have hd := List.all_eq_true.mp magic_duals_ok mi (List.mem_range.mpr hmi)
    dsimp only at hd
    set d := magicDuals.getD mi (0, [])
    simp only [Bool.and_eq_true, decide_eq_true_eq] at hd
    obtain ⟨⟨⟨hd1, hdlen⟩, hdall⟩, hdbits⟩ := hd
    have hdget : ∀ j : Fin 6, d.2.getD j.val 0 < 6 := by
      intro j
      have hj : j.val < d.2.length := by omega
      rw [List.getD_eq_getElem _ _ hj]
      exact of_decide_eq_true (List.all_eq_true.mp hdall _ (List.getElem_mem hj))
    have hm2 : magicList.getD d.1 0 ∈ magicList := by
      have hml : d.1 < magicList.length := by simpa [magicList] using hd1
      rw [List.getD_eq_getElem _ _ hml]
      exact List.getElem_mem hml
    let c' : Fin 6 → Fin n := fun j => c ⟨d.2.getD j.val 0, hdget j⟩
    refine ⟨magicList.getD d.1 0, hm2, c', fun x => ?_⟩
    have h1 := heq (fun i => !(x i))
    dsimp only at h1
    have hnn : (fun i => !(!(x i))) = x := by funext i; simp
    rw [hnn] at h1
    have hfx : f x = !((magicList.getD mi 0).testBit (pack6 (fun j => !(x (c j))))) := by
      cases hfx' : f x <;> simp_all
    rw [hfx, pack6_not (fun j => x (c j))]
    have hb := List.all_eq_true.mp hdbits (pack6 (fun j => x (c j)))
      (List.mem_range.mpr (pack6_lt _))
    have hb2 := eq_of_beq hb
    rw [hb2]
    congr 1
    conv_rhs => rw [pack6_eq_sum6]
    have htb (j : Fin 6) : (pack6 (fun k => x (c k))).testBit (d.2.getD j.val 0) = x (c' j) :=
      testBit_pack6 (fun k => x (c k)) ⟨d.2.getD j.val 0, hdget j⟩
    have h0 : (pack6 (fun k => x (c k))).testBit (d.2.getD 0 0) = x (c' 0) := htb 0
    have h1' : (pack6 (fun k => x (c k))).testBit (d.2.getD 1 0) = x (c' 1) := htb 1
    have h2 : (pack6 (fun k => x (c k))).testBit (d.2.getD 2 0) = x (c' 2) := htb 2
    have h3 : (pack6 (fun k => x (c k))).testBit (d.2.getD 3 0) = x (c' 3) := htb 3
    have h4 : (pack6 (fun k => x (c k))).testBit (d.2.getD 4 0) = x (c' 4) := htb 4
    have h5 : (pack6 (fun k => x (c k))).testBit (d.2.getD 5 0) = x (c' 5) := htb 5
    rw [h0, h1', h2, h3, h4, h5]

private def stepWires (w : List Bool) (g : Gate) : List Bool :=
  w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]

private lemma foldl_step_len (gs : List Gate) (w : List Bool) :
    (gs.foldl stepWires w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp
  | cons g gs ih =>
    rw [List.foldl_cons, ih]
    simp [stepWires]; omega

private lemma foldl_step_getD_lt (gs : List Gate) (w : List Bool) (i : Nat) (hi : i < w.length) :
    (gs.foldl stepWires w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    rw [List.foldl_cons, ih]
    · simp only [stepWires]
      rw [List.getD_eq_getElem _ _ (by simp; omega), List.getD_eq_getElem _ _ hi,
        List.getElem_append_left hi]
    · simp [stepWires]; omega

private lemma wires_getD_input (T : Circuit) (x : List Bool) (i : Nat) (hi : i < x.length) :
    (T.wires x).getD i false = x.getD i false :=
  foldl_step_getD_lt T.gates x i hi

private lemma wires_getD_gate (T : Circuit) (x : List Bool) (j : Nat) (hj : j < T.gates.length)
    (hrb : ∀ w ∈ (T.gates[j]'hj).inputs, w < x.length + j) :
    (T.wires x).getD (x.length + j) false =
      (T.gates[j]'hj).op.eval ((T.gates[j]'hj).inputs.map fun i => (T.wires x).getD i false) := by
  have hsplit : T.gates = T.gates.take j ++ (T.gates[j]'hj) :: T.gates.drop (j + 1) := by
    have h1 := (List.take_append_drop j T.gates).symm
    have h2 : T.gates.drop j = (T.gates[j]'hj) :: T.gates.drop (j + 1) :=
      List.drop_eq_getElem_cons hj
    rw [h2] at h1
    exact h1
  have hpref : ∀ w < x.length + j,
      (T.wires x).getD w false = ((T.gates.take j).foldl stepWires x).getD w false := by
    intro w hw
    change (T.gates.foldl stepWires x).getD w false = _
    conv_lhs => rw [hsplit, List.foldl_append]
    apply foldl_step_getD_lt
    rw [foldl_step_len, List.length_take, Nat.min_eq_left (Nat.le_of_lt hj)]
    exact hw
  change (T.gates.foldl stepWires x).getD (x.length + j) false = _
  conv_lhs => rw [hsplit, List.foldl_append, List.foldl_cons]
  set pref := (T.gates.take j).foldl stepWires x
  have hplen : pref.length = x.length + j := by
    rw [foldl_step_len, List.length_take, Nat.min_eq_left (Nat.le_of_lt hj)]
  rw [foldl_step_getD_lt _ (stepWires pref (T.gates[j]'hj)) (x.length + j) (by simp [stepWires, hplen])]
  simp only [stepWires]
  rw [List.getD_eq_getElem _ _ (by simp [hplen]), List.getElem_append_right (by omega)]
  simp only [hplen, Nat.sub_self, List.getElem_cons_zero]
  congr 1
  apply List.map_congr_left
  intro w hw
  exact (hpref w (hrb w hw)).symm

private lemma readsBack_mem {n : Nat} {T : Circuit} (h : IsAO2 n T) (j : Nat) (hj : j < T.gates.length)
    (w : Nat) (hw : w ∈ (T.gates[j]'hj).inputs) : w < n + j := by
  have hrb := h.2.1 j hj w
  have heq : gateAt T j = T.gates[j]'hj := by
    change T.gates.getD j _ = _
    exact List.getD_eq_getElem _ _ hj
  exact hrb (heq ▸ hw)

private def flipOp : GateOp → GateOp
  | GateOp.and => GateOp.or
  | GateOp.or => GateOp.and
  | op => op

private def flipOps (T : Circuit) : Circuit :=
  ⟨T.gates.map (fun g => ⟨flipOp g.op, g.inputs⟩), T.output⟩

private lemma flipOps_isAO2 {n : Nat} {T : Circuit} (h : IsAO2 n T) : IsAO2 n (flipOps T) := by
  refine ⟨?_, ?_, ?_⟩
  · intro g hg
    simp only [flipOps, List.mem_map] at hg
    obtain ⟨g', hg', rfl⟩ := hg
    rcases h.1 g' hg' with h' | h'
    · right; simp [flipOp, h']
    · left; simp [flipOp, h']
  · intro j hj w hw
    have hj' : j < T.gates.length := by simpa [flipOps] using hj
    have heq : gateAt (flipOps T) j =
        (⟨flipOp (T.gates[j]'hj').op, (T.gates[j]'hj').inputs⟩ : Gate) := by
      change (T.gates.map _).getD j _ = _
      rw [List.getD_eq_getElem _ _ (by simpa [flipOps] using hj), List.getElem_map]
    rw [heq] at hw
    exact readsBack_mem h j hj' w hw
  · intro g hg
    simp only [flipOps, List.mem_map] at hg
    obtain ⟨g', hg', rfl⟩ := hg
    exact h.2.2 g' hg'

private lemma flipOps_eval {n : Nat} {T : Circuit} (h : IsAO2 n T) (ho : T.output < n + T.size)
    (x : Fin n → Bool) :
    (flipOps T).eval (List.ofFn x) = !(T.eval (List.ofFn (fun i => !(x i)))) := by
  have hwire : ∀ w < n + T.gates.length,
      ((flipOps T).wires (List.ofFn x)).getD w false =
        !((T.wires (List.ofFn (fun i => !(x i)))).getD w false) := by
    intro w
    induction w using Nat.strong_induction_on with
    | ind w ih =>
      intro hw
      by_cases hwn : w < n
      · rw [wires_getD_input _ _ _ (by simpa using hwn),
          wires_getD_input _ _ _ (by simpa using hwn)]
        rw [List.getD_eq_getElem _ _ (by simpa using hwn),
          List.getD_eq_getElem _ _ (by simpa using hwn)]
        simp
      · set j := w - n
        have hj : j < T.gates.length := by omega
        have hjf : j < (flipOps T).gates.length := by simpa [flipOps] using hj
        have hw_eq : w = n + j := by omega
        have hlen1 : (List.ofFn x).length = n := List.length_ofFn
        have hlen2 : (List.ofFn (fun i => !(x i))).length = n := List.length_ofFn
        rw [hw_eq]
        have hf := wires_getD_gate (flipOps T) (List.ofFn x) j hjf (by
          rw [hlen1]; intro u hu; exact readsBack_mem (flipOps_isAO2 h) j hjf u hu)
        have ht := wires_getD_gate T (List.ofFn (fun i => !(x i))) j hj (by
          rw [hlen2]; intro u hu; exact readsBack_mem h j hj u hu)
        rw [hlen1] at hf; rw [hlen2] at ht
        rw [hf, ht]
        have hg_eq : (flipOps T).gates[j]'hjf = ⟨flipOp (T.gates[j]'hj).op, (T.gates[j]'hj).inputs⟩ := by
          simp [flipOps]
        rw [hg_eq]
        have hlen_in : (T.gates[j]'hj).inputs.length = 2 := h.2.2 _ (List.getElem_mem hj)
        rcases hli : (T.gates[j]'hj).inputs with _ | ⟨u, _ | ⟨v, _ | _⟩⟩
        · simp [hli] at hlen_in
        · simp [hli] at hlen_in
        · have hu : u < n + j := readsBack_mem h j hj u (by simp [hli])
          have hv : v < n + j := readsBack_mem h j hj v (by simp [hli])
          have ihu := ih u (by omega) (by omega)
          have ihv := ih v (by omega) (by omega)
          rcases h.1 _ (List.getElem_mem hj) with hop | hop
          · simp only [flipOp, hop, GateOp.eval, List.map_cons, List.map_nil, List.all_cons,
              List.all_nil, List.any_cons, List.any_nil, id_eq, Bool.and_true, Bool.or_false,
              ihu, ihv, Bool.not_and]
          · simp only [flipOp, hop, GateOp.eval, List.map_cons, List.map_nil, List.all_cons,
              List.all_nil, List.any_cons, List.any_nil, id_eq, Bool.and_true, Bool.or_false,
              ihu, ihv, Bool.not_or]
        · simp [hli] at hlen_in
  exact hwire T.output ho

private def remapWire (n j r w : Nat) : Nat :=
  if w < n + j then w else if w = n + j then r else w - 1

private def removeGate (n j r : Nat) (T : Circuit) : Circuit :=
  ⟨(T.gates.eraseIdx j).map (fun g => ⟨g.op, g.inputs.map (remapWire n j r)⟩),
   remapWire n j r T.output⟩

private lemma removeGate_size (n j r : Nat) (T : Circuit) (hj : j < T.gates.length) :
    (removeGate n j r T).size = T.size - 1 := by
  simp [removeGate, Circuit.size, List.length_eraseIdx, hj]

private lemma removeGate_ok {n j r : Nat} {T : Circuit}
    (hAO : IsAO2 n T) (hj : j < T.gates.length) (ho : T.output < n + T.size)
    (hcond :
      (T.output ≠ n + j ∧ ∀ g ∈ T.gates, n + j ∉ g.inputs) ∨
      (r < n + j ∧ ∀ x : Fin n → Bool,
        (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD r false)) :
    IsAO2 n (removeGate n j r T) ∧
    (removeGate n j r T).size < T.size ∧
    (removeGate n j r T).output < n + (removeGate n j r T).size ∧
    ∀ x : Fin n → Bool, (removeGate n j r T).eval (List.ofFn x) = T.eval (List.ofFn x) := by
  have hsize : (removeGate n j r T).size = T.gates.length - 1 := removeGate_size n j r T hj
  have hAO' : IsAO2 n (removeGate n j r T) := by
    refine ⟨?_, ?_, ?_⟩
    · intro g hg
      simp only [removeGate, List.mem_map] at hg
      obtain ⟨g', hg', rfl⟩ := hg
      exact hAO.1 g' (List.mem_of_mem_eraseIdx hg')
    · intro k hk w hw
      have hk_len : k < (T.gates.eraseIdx j).length := by simpa [removeGate] using hk
      have heq : gateAt (removeGate n j r T) k =
          (⟨((T.gates.eraseIdx j)[k]'hk_len).op,
           ((T.gates.eraseIdx j)[k]'hk_len).inputs.map (remapWire n j r)⟩ : Gate) := by
        change ((T.gates.eraseIdx j).map _).getD k _ = _
        rw [List.getD_eq_getElem _ _ (by simpa [removeGate] using hk), List.getElem_map]
      rw [heq] at hw
      simp only [List.mem_map] at hw
      obtain ⟨u, hu, rfl⟩ := hw
      by_cases hkj : k < j
      · have hge : (T.gates.eraseIdx j)[k]'hk_len = T.gates[k]'(by omega) :=
          List.getElem_eraseIdx_of_lt hk_len hkj
        rw [hge] at hu
        have hu_lt := readsBack_mem hAO k (by omega) u hu
        simp [remapWire, show u < n + j by omega, hu_lt]
      · have hk1 : k + 1 < T.gates.length := by
          rw [List.length_eraseIdx, ite_eq_left_iff.mpr (fun h => absurd hj h)] at hk_len; omega
        have hge : (T.gates.eraseIdx j)[k]'hk_len = T.gates[k + 1]'hk1 :=
          List.getElem_eraseIdx_of_ge hk_len (Nat.le_of_not_lt hkj)
        rw [hge] at hu
        have hu_lt := readsBack_mem hAO (k + 1) hk1 u hu
        unfold remapWire
        split_ifs with h1 h2
        · omega
        · rcases hcond with ⟨_, hunused⟩ | ⟨hr, _⟩
          · exact absurd (h2 ▸ hu) (hunused _ (List.getElem_mem hk1))
          · omega
        · omega
    · intro g hg
      simp only [removeGate, List.mem_map] at hg
      obtain ⟨g', hg', rfl⟩ := hg
      simp [hAO.2.2 g' (List.mem_of_mem_eraseIdx hg')]
  have ho' : (removeGate n j r T).output < n + (removeGate n j r T).size := by
    rw [hsize]
    change remapWire n j r T.output < n + (T.gates.length - 1)
    unfold remapWire
    split_ifs with h1 h2
    · omega
    · rcases hcond with ⟨hne, _⟩ | ⟨hr, _⟩
      · exact absurd h2 hne
      · omega
    · change T.output < n + T.gates.length at ho; omega
  have heval : ∀ x : Fin n → Bool, (removeGate n j r T).eval (List.ofFn x) = T.eval (List.ofFn x) := by
    intro x
    set D := removeGate n j r T
    have hsim : ∀ w < n + T.gates.length, w ≠ n + j →
        (D.wires (List.ofFn x)).getD (if w < n + j then w else w - 1) false =
          (T.wires (List.ofFn x)).getD w false := by
      intro w
      induction w using Nat.strong_induction_on with
      | ind w ih =>
        intro hw hne
        by_cases hwn : w < n
        · have hlt : w < n + j := by omega
          simp only [hlt, ite_true]
          rw [wires_getD_input D _ _ (by simpa using hwn),
            wires_getD_input T _ _ (by simpa using hwn)]
        · have htr : ∃ t, t < T.gates.length ∧ w = n + t := ⟨w - n, by omega, by omega⟩
          obtain ⟨t, ht, rfl⟩ := htr
          have hremap_val : ∀ u ∈ (T.gates[t]'ht).inputs,
              (D.wires (List.ofFn x)).getD (remapWire n j r u) false =
                (T.wires (List.ofFn x)).getD u false := by
            intro u hu
            have hu_lt := readsBack_mem hAO t ht u hu
            unfold remapWire
            split_ifs with h1 h2
            · have := ih u (by omega) (by omega) (by omega)
              simpa [h1] using this
            · rcases hcond with ⟨_, hunused⟩ | ⟨hr, heqv⟩
              · exact absurd (h2 ▸ hu) (hunused _ (List.getElem_mem ht))
              · have := ih r (by omega) (by omega) (by omega)
                rw [ite_eq_left_iff.mpr (fun h => absurd hr h)] at this
                rw [this, h2, ← heqv x]
            · have := ih u (by omega) (by omega) h2
              simpa [h1] using this
          have hlen_x : (List.ofFn x).length = n := List.length_ofFn
          by_cases htj : t < j
          · have hlt : n + t < n + j := by omega
            simp only [hlt, ite_true]
            have htd : t < D.gates.length := by
              change t < (removeGate n j r T).size; rw [hsize]; omega
            have hd := wires_getD_gate D (List.ofFn x) t htd (by
              rw [hlen_x]; intro u hu; exact readsBack_mem hAO' t htd u hu)
            have ht' := wires_getD_gate T (List.ofFn x) t ht (by
              rw [hlen_x]; intro u hu; exact readsBack_mem hAO t ht u hu)
            rw [hlen_x] at hd ht'
            rw [hd, ht']
            have hge : D.gates[t]'htd = ⟨(T.gates[t]'ht).op, (T.gates[t]'ht).inputs.map (remapWire n j r)⟩ := by
              simp only [D, removeGate, List.getElem_map]
              have hge' := List.getElem_eraseIdx_of_lt
                (by rw [List.length_eraseIdx, ite_eq_left_iff.mpr (fun h => absurd hj h)]; omega) htj
              rw [hge']
            rw [hge]; dsimp only
            congr 1
            rw [List.map_map]
            apply List.map_congr_left
            intro u hu
            exact hremap_val u hu
          · have hgt : ¬ (n + t < n + j) := by omega
            simp only [hgt, ite_false]
            have htd : t - 1 < D.gates.length := by
              change t - 1 < (removeGate n j r T).size; rw [hsize]; omega
            have hw1 : n + t - 1 = n + (t - 1) := by omega
            rw [hw1]
            have hd := wires_getD_gate D (List.ofFn x) (t - 1) htd (by
              rw [hlen_x]; intro u hu; exact readsBack_mem hAO' (t - 1) htd u hu)
            have ht' := wires_getD_gate T (List.ofFn x) t ht (by
              rw [hlen_x]; intro u hu; exact readsBack_mem hAO t ht u hu)
            rw [hlen_x] at hd ht'
            rw [hd, ht']
            have hge : D.gates[t - 1]'htd =
                ⟨(T.gates[t]'ht).op, (T.gates[t]'ht).inputs.map (remapWire n j r)⟩ := by
              simp only [D, removeGate, List.getElem_map]
              have hteq : t - 1 + 1 = t := by omega
              have hlen_er : t - 1 < (T.gates.eraseIdx j).length := by
                rw [List.length_eraseIdx, ite_eq_left_iff.mpr (fun h => absurd hj h)]; omega
              have hge' := List.getElem_eraseIdx_of_ge hlen_er (show j ≤ t - 1 by omega)
              simp only [hteq] at hge'
              rw [hge']
            rw [hge]; dsimp only
            congr 1
            rw [List.map_map]
            apply List.map_congr_left
            intro u hu
            exact hremap_val u hu
    change (D.wires (List.ofFn x)).getD (remapWire n j r T.output) false =
      (T.wires (List.ofFn x)).getD T.output false
    unfold remapWire
    split_ifs with h1 h2
    · have := hsim T.output ho (by omega)
      simpa [h1] using this
    · rcases hcond with ⟨hne, _⟩ | ⟨hr, heqv⟩
      · exact absurd h2 hne
      · have := hsim r (by omega) (by omega)
        rw [ite_eq_left_iff.mpr (fun h => absurd hr h)] at this
        rw [this, h2, ← heqv x]
    · have := hsim T.output ho h2
      simpa [h1] using this
  exact ⟨hAO', by rw [hsize]; change T.gates.length - 1 < T.gates.length; omega, ho', heval⟩

private def sOfGate (n : Nat) (g : Gate) : List Nat :=
  match g.inputs with
  | [u, w] =>
    if n ≤ u ∧ n ≤ w then (if u < w then [u - n, w - n] else [w - n, u - n])
    else if n ≤ u then [u - n]
    else if n ≤ w then [w - n]
    else []
  | _ => []

private def opOfGate (g : Gate) : Bool :=
  match g.op with
  | GateOp.or => true
  | _ => false

private def leavesOfGate (n : Nat) (g : Gate) : List (Fin n) :=
  match g.inputs with
  | [u, w] =>
    if hu : u < n then
      if hw : w < n then [⟨u, hu⟩, ⟨w, hw⟩] else [⟨u, hu⟩]
    else
      if hw : w < n then [⟨w, hw⟩] else []
  | _ => []

private lemma leavesOfGate_len (n : Nat) (g : Gate) (hlen : g.inputs.length = 2) :
    (leavesOfGate n g).length = 2 - (sOfGate n g).length := by
  rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
  · simp [hgi] at hlen
  · simp [hgi] at hlen
  · simp only [leavesOfGate, sOfGate, hgi]
    by_cases hu : u < n <;> by_cases hw : w < n
    · have h1 : ¬ (n ≤ u) := by omega
      have h2 : ¬ (n ≤ w) := by omega
      simp [hu, hw, h1, h2]
    · have h1 : ¬ (n ≤ u) := by omega
      have h2 : n ≤ w := by omega
      simp [hu, hw, h1, h2]
    · have h1 : n ≤ u := by omega
      have h2 : ¬ (n ≤ w) := by omega
      simp [hu, hw, h1, h2]
    · have h1 : n ≤ u := by omega
      have h2 : n ≤ w := by omega
      by_cases hlt : u < w <;> simp [hu, hw, h1, h2, hlt]
  · simp [hgi] at hlen

private lemma sOfGate_mem_opts (n j : Nat) (g : Gate)
    (hlen : g.inputs.length = 2) (hnodup : g.inputs.Nodup)
    (hrb : ∀ w ∈ g.inputs, w < n + j) :
    (j = 0 → sOfGate n g = []) ∧
    (j = 1 → sOfGate n g ∈ opts1) ∧
    (j = 2 → sOfGate n g ∈ opts2) ∧
    (j = 3 → sOfGate n g ∈ opts3) ∧
    (j = 4 → sOfGate n g ∈ opts4) ∧
    (j = 5 → sOfGate n g ∈ opts5) := by
  rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
  · simp [hgi] at hlen
  · simp [hgi] at hlen
  · have hu : u < n + j := hrb u (by simp [hgi])
    have hw : w < n + j := hrb w (by simp [hgi])
    have hne : u ≠ w := by simpa [hgi] using hnodup
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> (intro hj; subst hj; simp only [sOfGate, hgi])
    · have h1 : ¬ (n ≤ u) := by omega
      have h2 : ¬ (n ≤ w) := by omega
      simp [h1, h2]
    · split_ifs
      · omega
      · omega
      · have : u - n = 0 := by omega
        simp [this, opts1]
      · have : w - n = 0 := by omega
        simp [this, opts1]
      · simp [opts1]
    · split_ifs
      · have : u - n = 0 ∧ w - n = 1 := by omega
        simp [this.1, this.2, opts2]
      · have : w - n = 0 ∧ u - n = 1 := by omega
        simp [this.1, this.2, opts2]
      · have : u - n = 0 ∨ u - n = 1 := by omega
        rcases this with h | h <;> simp [h, opts2]
      · have : w - n = 0 ∨ w - n = 1 := by omega
        rcases this with h | h <;> simp [h, opts2]
      · simp [opts2]
    · split_ifs
      · have : (u - n = 0 ∧ w - n = 1) ∨ (u - n = 0 ∧ w - n = 2) ∨ (u - n = 1 ∧ w - n = 2) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp [h1, h2, opts3]
      · have : (w - n = 0 ∧ u - n = 1) ∨ (w - n = 0 ∧ u - n = 2) ∨ (w - n = 1 ∧ u - n = 2) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;> simp [h1, h2, opts3]
      · have : u - n = 0 ∨ u - n = 1 ∨ u - n = 2 := by omega
        rcases this with h | h | h <;> simp [h, opts3]
      · have : w - n = 0 ∨ w - n = 1 ∨ w - n = 2 := by omega
        rcases this with h | h | h <;> simp [h, opts3]
      · simp [opts3]
    · split_ifs
      · have : (u - n = 0 ∧ w - n = 1) ∨ (u - n = 0 ∧ w - n = 2) ∨ (u - n = 0 ∧ w - n = 3) ∨
               (u - n = 1 ∧ w - n = 2) ∨ (u - n = 1 ∧ w - n = 3) ∨ (u - n = 2 ∧ w - n = 3) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          simp [h1, h2, opts4]
      · have : (w - n = 0 ∧ u - n = 1) ∨ (w - n = 0 ∧ u - n = 2) ∨ (w - n = 0 ∧ u - n = 3) ∨
               (w - n = 1 ∧ u - n = 2) ∨ (w - n = 1 ∧ u - n = 3) ∨ (w - n = 2 ∧ u - n = 3) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          simp [h1, h2, opts4]
      · have : u - n = 0 ∨ u - n = 1 ∨ u - n = 2 ∨ u - n = 3 := by omega
        rcases this with h | h | h | h <;> simp [h, opts4]
      · have : w - n = 0 ∨ w - n = 1 ∨ w - n = 2 ∨ w - n = 3 := by omega
        rcases this with h | h | h | h <;> simp [h, opts4]
      · simp [opts4]
    · split_ifs
      · have : (u - n = 0 ∧ w - n = 1) ∨ (u - n = 0 ∧ w - n = 2) ∨ (u - n = 0 ∧ w - n = 3) ∨
               (u - n = 0 ∧ w - n = 4) ∨ (u - n = 1 ∧ w - n = 2) ∨ (u - n = 1 ∧ w - n = 3) ∨
               (u - n = 1 ∧ w - n = 4) ∨ (u - n = 2 ∧ w - n = 3) ∨ (u - n = 2 ∧ w - n = 4) ∨
               (u - n = 3 ∧ w - n = 4) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ |
                         ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          simp [h1, h2, opts5]
      · have : (w - n = 0 ∧ u - n = 1) ∨ (w - n = 0 ∧ u - n = 2) ∨ (w - n = 0 ∧ u - n = 3) ∨
               (w - n = 0 ∧ u - n = 4) ∨ (w - n = 1 ∧ u - n = 2) ∨ (w - n = 1 ∧ u - n = 3) ∨
               (w - n = 1 ∧ u - n = 4) ∨ (w - n = 2 ∧ u - n = 3) ∨ (w - n = 2 ∧ u - n = 4) ∨
               (w - n = 3 ∧ u - n = 4) := by omega
        rcases this with ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ |
                         ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ | ⟨h1, h2⟩ <;>
          simp [h1, h2, opts5]
      · have : u - n = 0 ∨ u - n = 1 ∨ u - n = 2 ∨ u - n = 3 ∨ u - n = 4 := by omega
        rcases this with h | h | h | h | h <;> simp [h, opts5]
      · have : w - n = 0 ∨ w - n = 1 ∨ w - n = 2 ∨ w - n = 3 ∨ w - n = 4 := by omega
        rcases this with h | h | h | h | h <;> simp [h, opts5]
      · simp [opts5]
  · simp [hgi] at hlen

private lemma mem_sOfGate_iff (n : Nat) (g : Gate) (hlen : g.inputs.length = 2) (k : Nat) :
    k ∈ sOfGate n g ↔ n + k ∈ g.inputs := by
  rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
  · simp [hgi] at hlen
  · simp [hgi] at hlen
  · simp only [sOfGate, hgi]
    split_ifs <;> simp <;> omega
  · simp [hgi] at hlen

private lemma sOfGate_eq_pair_iff (n : Nat) (g : Gate) (hlen : g.inputs.length = 2) (x y : Nat) :
    sOfGate n g = [x, y] → (g.inputs = [n + x, n + y] ∨ g.inputs = [n + y, n + x]) := by
  rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
  · simp [hgi] at hlen
  · simp [hgi] at hlen
  · intro hs
    simp only [sOfGate, hgi] at hs
    split_ifs at hs with h1 h2
    · simp only [List.cons.injEq, and_true] at hs
      left; have : u = n + x := by omega
      have : w = n + y := by omega
      simp [*]
    · simp only [List.cons.injEq, and_true] at hs
      right; have : u = n + y := by omega
      have : w = n + x := by omega
      simp [*]
    · simp at hs
    · simp at hs
  · simp [hgi] at hlen

private def unrollList (n : Nat) (hn : 0 < n) (gs : List Gate) : List (DMFormula n) :=
  gs.foldl (fun acc g =>
    let mk (w : Nat) : DMFormula n :=
      if h : w < n then DMFormula.lit ⟨w, h⟩ true
      else acc.getD (w - n) (DMFormula.lit ⟨0, hn⟩ true)
    let f := match g.inputs with
      | [u, w] =>
        if opOfGate g then DMFormula.or (mk u) (mk w) else DMFormula.and (mk u) (mk w)
      | _ => DMFormula.lit ⟨0, hn⟩ true
    acc ++ [f]) []

private def dagLeavesList (S : List (List Nat)) : List Nat :=
  S.foldl (fun acc s => acc ++ [leafOf s acc]) []

private lemma unrollList_props (n : Nat) (hn : 0 < n) (T : Circuit) (hAO : IsAO2 n T) :
    (∀ j < T.gates.length,
      ((unrollList n hn T.gates).getD j (DMFormula.lit ⟨0, hn⟩ true)).leaves =
        (dagLeavesList (T.gates.map (sOfGate n))).getD j 0) ∧
    (∀ (x : Fin n → Bool) (j : Nat), j < T.gates.length →
      evalPos ((unrollList n hn T.gates).getD j (DMFormula.lit ⟨0, hn⟩ true)) x =
        (T.wires (List.ofFn x)).getD (n + j) false) := by
  have haux : ∀ (gs : List Gate),
      (∀ g ∈ gs, (g.op = GateOp.and ∨ g.op = GateOp.or) ∧ g.inputs.length = 2) →
      (∀ j (hj : j < gs.length), ∀ w ∈ (gs[j]'hj).inputs, w < n + j) →
      (unrollList n hn gs).length = gs.length ∧
      (dagLeavesList (gs.map (sOfGate n))).length = gs.length ∧
      (∀ j < gs.length,
        ((unrollList n hn gs).getD j (DMFormula.lit ⟨0, hn⟩ true)).leaves =
          (dagLeavesList (gs.map (sOfGate n))).getD j 0) ∧
      (∀ (x : Fin n → Bool) (j : Nat), j < gs.length →
        evalPos ((unrollList n hn gs).getD j (DMFormula.lit ⟨0, hn⟩ true)) x =
          ((Circuit.mk gs 0).wires (List.ofFn x)).getD (n + j) false) := by
    intro gs
    induction gs using List.reverseRecOn with
    | nil => intro _ _; simp [unrollList, dagLeavesList]
    | append_singleton gs g ih =>
      intro hgo hrb
      have ih' := ih
        (fun g' hg' => hgo g' (List.mem_append_left _ hg'))
        (fun j hj w hw => by
          have hj' : j < (gs ++ [g]).length := by simp; omega
          have hget : (gs ++ [g])[j]'hj' = gs[j]'hj := List.getElem_append_left hj
          exact hrb j hj' w (hget ▸ hw))
      obtain ⟨hul, hdl, hlv, hev⟩ := ih'
      have hun_step : unrollList n hn (gs ++ [g]) = unrollList n hn gs ++ [
          let mk (w : Nat) : DMFormula n :=
            if h : w < n then DMFormula.lit ⟨w, h⟩ true
            else (unrollList n hn gs).getD (w - n) (DMFormula.lit ⟨0, hn⟩ true)
          match g.inputs with
          | [u, w] => if opOfGate g then DMFormula.or (mk u) (mk w) else DMFormula.and (mk u) (mk w)
          | _ => DMFormula.lit ⟨0, hn⟩ true] := by
        unfold unrollList; rw [List.foldl_append]; rfl
      have hdl_step : dagLeavesList ((gs ++ [g]).map (sOfGate n)) =
          dagLeavesList (gs.map (sOfGate n)) ++ [leafOf (sOfGate n g) (dagLeavesList (gs.map (sOfGate n)))] := by
        unfold dagLeavesList; rw [List.map_append, List.foldl_append]; rfl
      have hulen : (unrollList n hn (gs ++ [g])).length = (gs ++ [g]).length := by
        rw [hun_step]; simp [hul]
      have hdlen : (dagLeavesList ((gs ++ [g]).map (sOfGate n))).length = (gs ++ [g]).length := by
        rw [hdl_step]; simp [hdl]
      have hg_ok := hgo g (by simp)
      have hgrb : ∀ w ∈ g.inputs, w < n + gs.length := by
        intro w hw
        have hj' : gs.length < (gs ++ [g]).length := by simp
        have hget : (gs ++ [g])[gs.length]'hj' = g := by simp
        exact hrb gs.length hj' w (by rw [hget]; exact hw)
      refine ⟨hulen, hdlen, ?_, ?_⟩
      · intro j hj
        by_cases hlt : j < gs.length
        · rw [hun_step, hdl_step]
          rw [List.getD_eq_getElem _ _ (by simp [hul]; omega), List.getElem_append_left (by omega),
              List.getD_eq_getElem _ _ (by simp [hdl]; omega), List.getElem_append_left (by omega)]
          have := hlv j hlt
          rw [List.getD_eq_getElem _ _ (by omega), List.getD_eq_getElem _ _ (by omega)] at this
          exact this
        · have heqj : j = gs.length := by simp at hj; omega
          subst heqj
          rw [hun_step, hdl_step]
          rw [List.getD_eq_getElem _ _ (by simp [hul]), List.getElem_append_right (by omega),
              List.getD_eq_getElem _ _ (by simp [hdl]), List.getElem_append_right (by omega)]
          simp only [hul, hdl, Nat.sub_self, List.getElem_cons_zero]
          rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
          · simp [hgi] at hg_ok
          · simp [hgi] at hg_ok
          · have hu := hgrb u (by simp [hgi])
            have hw := hgrb w (by simp [hgi])
            have hmk_leaves (z : Nat) (hz : z < n + gs.length) :
                (if h : z < n then DMFormula.lit ⟨z, h⟩ true
                 else (unrollList n hn gs).getD (z - n) (DMFormula.lit ⟨0, hn⟩ true)).leaves =
                (if z < n then 1 else (dagLeavesList (gs.map (sOfGate n))).getD (z - n) 0) := by
              split_ifs with h1
              · rfl
              · exact hlv (z - n) (by omega)
            have hlv_op (f1 f2 : DMFormula n) :
                (if opOfGate g then DMFormula.or f1 f2 else DMFormula.and f1 f2).leaves =
                  f1.leaves + f2.leaves := by
              cases opOfGate g <;> rfl
            rw [hlv_op, hmk_leaves u hu, hmk_leaves w hw]
            unfold sOfGate; rw [hgi]
            by_cases hu' : u < n <;> by_cases hw' : w < n
            · have h1 : ¬ (n ≤ u) := by omega
              have h2 : ¬ (n ≤ w) := by omega
              simp [hu', hw', h1, h2, leafOf]
            · have h1 : ¬ (n ≤ u) := by omega
              have h2 : n ≤ w := by omega
              simp [hu', hw', h1, h2, leafOf]
            · have h1 : n ≤ u := by omega
              have h2 : ¬ (n ≤ w) := by omega
              simp [hu', hw', h1, h2, leafOf, Nat.add_comm]
            · have h1 : n ≤ u := by omega
              have h2 : n ≤ w := by omega
              by_cases hlt : u < w <;> simp [hu', hw', h1, h2, hlt, leafOf, Nat.add_comm]
          · simp [hgi] at hg_ok
      · intro x j hj
        have hlenx : (List.ofFn x).length = n := List.length_ofFn
        by_cases hlt : j < gs.length
        · rw [hun_step]
          rw [List.getD_eq_getElem _ _ (by simp [hul]; omega), List.getElem_append_left (by omega)]
          have h1 := hev x j hlt
          rw [List.getD_eq_getElem _ _ (by omega)] at h1
          rw [h1]
          change ((gs.foldl stepWires (List.ofFn x)).getD (n + j) false) =
            (((gs ++ [g]).foldl stepWires (List.ofFn x)).getD (n + j) false)
          rw [List.foldl_append]
          symm
          apply foldl_step_getD_lt
          rw [foldl_step_len, hlenx]; omega
        · have heqj : j = gs.length := by simp at hj; omega
          subst heqj
          rw [hun_step]
          rw [List.getD_eq_getElem _ _ (by simp [hul]), List.getElem_append_right (by omega)]
          simp only [hul, Nat.sub_self, List.getElem_cons_zero]
          have hw_gate := wires_getD_gate ⟨gs ++ [g], 0⟩ (List.ofFn x) gs.length (by simp) (by
            rw [hlenx]; intro u hu; exact hgrb u (by simpa using hu))
          rw [hlenx] at hw_gate
          rw [hw_gate]
          have hget_last : (gs ++ [g])[gs.length]'(by simp) = g := by simp
          simp only [hget_last]
          rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
          · simp [hgi] at hg_ok
          · simp [hgi] at hg_ok
          · have hu := hgrb u (by simp [hgi])
            have hw := hgrb w (by simp [hgi])
            have hmk_eval (z : Nat) (hz : z < n + gs.length) :
                evalPos (if h : z < n then DMFormula.lit ⟨z, h⟩ true
                  else (unrollList n hn gs).getD (z - n) (DMFormula.lit ⟨0, hn⟩ true)) x =
                ((Circuit.mk (gs ++ [g]) 0).wires (List.ofFn x)).getD z false := by
              split_ifs with h1
              · rw [wires_getD_input _ _ _ (by rw [hlenx]; exact h1),
                  List.getD_eq_getElem _ _ (by rw [hlenx]; exact h1), List.getElem_ofFn]
                rfl
              · have hz' : z - n < gs.length := by omega
                have hnz : n + (z - n) = z := by omega
                rw [hev x (z - n) hz', hnz]
                change ((gs.foldl stepWires (List.ofFn x)).getD z false) =
                  (((gs ++ [g]).foldl stepWires (List.ofFn x)).getD z false)
                rw [List.foldl_append]
                symm
                apply foldl_step_getD_lt
                rw [foldl_step_len, hlenx]; omega
            have heu := hmk_eval u hu
            have hew := hmk_eval w hw
            rcases hg_ok.1 with hop | hop
            · simp only [opOfGate, hop, Bool.false_eq_true, ite_false, evalPos, GateOp.eval,
                List.map_cons, List.map_nil, List.all_cons, List.all_nil, id_eq, Bool.and_true,
                heu, hew]
            · simp only [opOfGate, hop, ite_true, evalPos, GateOp.eval,
                List.map_cons, List.map_nil, List.any_cons, List.any_nil, id_eq, Bool.or_false,
                heu, hew]
          · simp [hgi] at hg_ok
  have hres := haux T.gates (fun g hg => ⟨hAO.1 g hg, hAO.2.2 g hg⟩)
    (fun j hj w hw => readsBack_mem hAO j hj w hw)
  exact ⟨hres.2.2.1, hres.2.2.2⟩

private def evalGenState (S : List (List Nat)) (j : Nat) (st : List Nat × Nat) : List Bool → List Nat × Nat
  | [] => st
  | b :: rest =>
    let s := S.getD j []
    let (v1, v2, nv') := pairVals s st.1 st.2
    let out := if b then (v1 ||| v2) else (v1 &&& v2)
    evalGenState S (j + 1) (st.1 ++ [out], nv') rest

private lemma evalGenState_append (S : List (List Nat)) (j : Nat) (st : List Nat × Nat)
    (l1 l2 : List Bool) :
    evalGenState S j st (l1 ++ l2) = evalGenState S (j + l1.length) (evalGenState S j st l1) l2 := by
  induction l1 generalizing j st with
  | nil => simp [evalGenState]
  | cons b rest ih =>
    simp only [List.cons_append, evalGenState, List.length_cons]
    rw [ih, show j + 1 + rest.length = j + (rest.length + 1) by omega]

private lemma checkOpsRec_sound (S : List (List Nat)) (j : Nat) (vs : List Nat) (nv : Nat)
    (opsPre opsRest : List Bool)
    (hrec : checkOpsRec S j vs nv opsPre = true)
    (hvs : vs.length = j)
    (hpre : opsPre.length = j)
    (hlen : j + opsRest.length = S.length)
    (hnonempty : opsRest ≠ [])
    (hlast : (opsPre ++ opsRest).getD (S.length - 1) false = false)
    (hnodup : ∀ t, j ≤ t → t < S.length → (S.getD t []).length = 2 →
      ∀ i < t, ¬ (S.getD i [] = S.getD t [] ∧
        (opsPre ++ opsRest).getD i false = (opsPre ++ opsRest).getD t false)) :
    hasKey ((evalGenState S j (vs, nv) opsRest).1.getD (S.length - 1) 0) = true := by
  induction opsRest generalizing j vs nv opsPre with
  | nil => exact absurd rfl hnonempty
  | cons b rest ih =>
    unfold checkOpsRec at hrec
    cases rest with
    | nil =>
      have hge : ¬ (j + 1 < S.length) := by simp at hlen; omega
      simp only [hge, ite_false] at hrec
      have hj_eq : S.length - 1 = j := by simp at hlen; omega
      have hb : b = false := by
        rw [hj_eq, List.getD_eq_getElem _ _ (by simp [hpre]),
          List.getElem_append_right (by omega)] at hlast
        simpa [hpre] using hlast
      subst hb
      have hdup : (if (S.getD j []).length != 2 then false else
          (List.range j).any (fun i => S.getD i [] == S.getD j [] && opsPre.getD i false == false)) = false := by
        split_ifs with h2
        · rfl
        · have h2' : (S.getD j []).length = 2 := by simpa using h2
          apply Bool.eq_false_iff.mpr
          intro hany
          rw [List.any_eq_true] at hany
          obtain ⟨i, hi, hmatch⟩ := hany
          rw [List.mem_range] at hi
          simp only [Bool.and_eq_true, beq_iff_eq] at hmatch
          have hnd := hnodup j (le_refl j) (by simp at hlen; omega) h2' i hi
          have hpi : (opsPre ++ [false]).getD i false = opsPre.getD i false := by
            rw [List.getD_eq_getElem _ _ (by simp [hpre]; omega),
                List.getD_eq_getElem _ _ (by omega), List.getElem_append_left (by omega)]
          have hpj : (opsPre ++ [false]).getD j false = false := by
            rw [List.getD_eq_getElem _ _ (by simp [hpre]), List.getElem_append_right (by omega)]
            simp [hpre]
          rw [hpi, hpj] at hnd
          exact hnd hmatch
      simp only [hdup, Bool.false_eq_true, ite_false] at hrec
      simp only [evalGenState, Bool.false_eq_true, ite_false]
      rw [hj_eq, List.getD_eq_getElem _ _ (by simp [hvs]), List.getElem_append_right (by omega)]
      simpa [hvs] using hrec
    | cons b2 rest2 =>
      have hlt : j + 1 < S.length := by simp at hlen; omega
      simp only [hlt, ite_true, Bool.and_eq_true] at hrec
      have hdup : (if (S.getD j []).length != 2 then false else
          (List.range j).any (fun i => S.getD i [] == S.getD j [] && opsPre.getD i false == b)) = false := by
        split_ifs with h2
        · rfl
        · have h2' : (S.getD j []).length = 2 := by simpa using h2
          apply Bool.eq_false_iff.mpr
          intro hany
          rw [List.any_eq_true] at hany
          obtain ⟨i, hi, hmatch⟩ := hany
          rw [List.mem_range] at hi
          simp only [Bool.and_eq_true, beq_iff_eq] at hmatch
          have hnd := hnodup j (le_refl j) (by omega) h2' i hi
          have hpi : (opsPre ++ b :: b2 :: rest2).getD i false = opsPre.getD i false := by
            rw [List.getD_eq_getElem _ _ (by simp [hpre]; omega),
                List.getD_eq_getElem _ _ (by omega), List.getElem_append_left (by omega)]
          have hpj : (opsPre ++ b :: b2 :: rest2).getD j false = b := by
            rw [List.getD_eq_getElem _ _ (by simp [hpre]), List.getElem_append_right (by omega)]
            simp [hpre]
          rw [hpi, hpj] at hnd
          exact hnd hmatch
      have hrec_b : checkOpsRec S (j + 1)
          (vs ++ [if b then (pairVals (S.getD j []) vs nv).1 ||| (pairVals (S.getD j []) vs nv).2.1
                 else (pairVals (S.getD j []) vs nv).1 &&& (pairVals (S.getD j []) vs nv).2.1])
          (pairVals (S.getD j []) vs nv).2.2 (opsPre ++ [b]) = true := by
        cases b
        · have h1 := hrec.1
          simp only [hdup, Bool.false_eq_true, ite_false] at h1
          exact h1
        · have h2 := hrec.2
          simp only [hdup, Bool.false_eq_true, ite_false] at h2
          exact h2
      have hassoc : (opsPre ++ [b]) ++ (b2 :: rest2) = opsPre ++ (b :: b2 :: rest2) := by simp
      simp only [evalGenState]
      exact ih (j + 1) _ _ (opsPre ++ [b]) hrec_b (by simp [hvs]) (by simp [hpre])
        (by simp at hlen ⊢; omega) (by simp) (by rw [hassoc]; exact hlast)
        (fun t ht1 ht2 ht3 i hit => by rw [hassoc]; exact hnodup t (by omega) ht2 ht3 i hit)

private lemma evalGenState_sim {n : Nat} (hn : 0 < n) (T : Circuit) (hAO : IsAO2 n T)
    (hle6 : (T.gates.flatMap (leavesOfGate n)).length ≤ 6) :
    let S := T.gates.map (sOfGate n)
    let ops := T.gates.map opOfGate
    let leafWires := T.gates.flatMap (leavesOfGate n)
    let c : Fin 6 → Fin n := fun i => leafWires.getD i.val ⟨0, hn⟩
    ∀ (x : Fin n → Bool) (j : Nat), j < T.gates.length →
      ((evalGenState S 0 ([], 0) ops).1.getD j 0).testBit (pack6 (fun i => x (c i))) =
        (T.wires (List.ofFn x)).getD (n + j) false := by
  intro S ops leafWires c x
  have hprefix : ∀ (k : Nat) (hk : k ≤ T.gates.length),
      let st := evalGenState S 0 ([], 0) (ops.take k)
      st.1.length = k ∧
      st.2 = ((T.gates.take k).flatMap (leavesOfGate n)).length ∧
      ∀ u < k, (st.1.getD u 0).testBit (pack6 (fun i => x (c i))) =
        (T.wires (List.ofFn x)).getD (n + u) false := by
    intro k
    induction k with
    | zero =>
      intro _
      simp [evalGenState]
    | succ k ih =>
      intro hk
      obtain ⟨hvl, hnv, hvu⟩ := ih (by omega)
      set st := evalGenState S 0 ([], 0) (ops.take k)
      have hkt : k < T.gates.length := by omega
      have hko : k < ops.length := by simp [ops, hkt]
      have htake_ops : ops.take (k + 1) = ops.take k ++ [ops[k]'hko] :=
        List.take_succ_eq_append_getElem hko
      have htake_g : T.gates.take (k + 1) = T.gates.take k ++ [T.gates[k]'hkt] :=
        List.take_succ_eq_append_getElem hkt
      have hlen_take_ops : (ops.take k).length = k := by
        rw [List.length_take, Nat.min_eq_left (by simp [ops]; omega)]
      have hstep_eq : evalGenState S 0 ([], 0) (ops.take (k + 1)) =
          evalGenState S k st [ops[k]'hko] := by
        rw [htake_ops, evalGenState_append, hlen_take_ops, Nat.zero_add]
      have hSk : S.getD k [] = sOfGate n (T.gates[k]'hkt) := by
        rw [List.getD_eq_getElem _ _ (by simp [S, hkt])]
        simp [S]
      have hopk : ops[k]'hko = opOfGate (T.gates[k]'hkt) := by simp [ops]
      set g := T.gates[k]'hkt
      have hglen : g.inputs.length = 2 := hAO.2.2 g (List.getElem_mem hkt)
      have hgop : g.op = GateOp.and ∨ g.op = GateOp.or := hAO.1 g (List.getElem_mem hkt)
      have hleaf_split : leafWires = (T.gates.take k).flatMap (leavesOfGate n) ++
          leavesOfGate n g ++ (T.gates.drop (k + 1)).flatMap (leavesOfGate n) := by
        have hg_all : T.gates = T.gates.take k ++ g :: T.gates.drop (k + 1) := by
          have h1 := (List.take_append_drop k T.gates).symm
          rw [List.drop_eq_getElem_cons hkt] at h1
          exact h1
        change T.gates.flatMap (leavesOfGate n) = _
        conv_lhs => rw [hg_all]
        simp [List.flatMap_append, List.append_assoc]
      have hleaf_get (idx : Nat) (hidx : idx < (leavesOfGate n g).length) :
          leafWires.getD (st.2 + idx) ⟨0, hn⟩ = (leavesOfGate n g)[idx]'hidx := by
        have hlt_w : st.2 + idx < leafWires.length := by
          rw [hleaf_split]; simp [hnv]; omega
        rw [List.getD_eq_getElem _ _ hlt_w]
        simp only [hleaf_split]
        rw [List.getElem_append_left (by simp [hnv]; omega),
            List.getElem_append_right (by omega)]
        simp [hnv]
      have hleaf_lt6 (idx : Nat) (hidx : idx < (leavesOfGate n g).length) : st.2 + idx < 6 := by
        have h1 : st.2 + idx < leafWires.length := by rw [hleaf_split]; simp [hnv]; omega
        have h2 : leafWires.length ≤ 6 := hle6
        omega
      have hvar_eval (idx : Nat) (hidx : idx < (leavesOfGate n g).length) :
          (varMask (st.2 + idx)).testBit (pack6 (fun i => x (c i))) =
            x ((leavesOfGate n g)[idx]'hidx) := by
        have h6 := hleaf_lt6 idx hidx
        rw [testBit_varMask ⟨st.2 + idx, h6⟩ ⟨pack6 (fun i => x (c i)), pack6_lt _⟩,
            testBit_pack6 (fun i => x (c i)) ⟨st.2 + idx, h6⟩]
        simp only [c]
        rw [hleaf_get idx hidx]
      have hnew_nv : (pairVals (sOfGate n g) st.1 st.2).2.2 =
          ((T.gates.take (k + 1)).flatMap (leavesOfGate n)).length := by
        rw [htake_g, List.flatMap_append, List.flatMap_cons, List.flatMap_nil, List.append_nil,
            List.length_append, ← hnv, leavesOfGate_len n g hglen]
        rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
        · simp [hgi] at hglen
        · simp [hgi] at hglen
        · simp only [sOfGate, hgi]
          split_ifs <;> simp [pairVals]
        · simp [hgi] at hglen
      have hnew_bit :
          (if opOfGate g then (pairVals (sOfGate n g) st.1 st.2).1 ||| (pairVals (sOfGate n g) st.1 st.2).2.1
           else (pairVals (sOfGate n g) st.1 st.2).1 &&& (pairVals (sOfGate n g) st.1 st.2).2.1).testBit
            (pack6 (fun i => x (c i))) = (T.wires (List.ofFn x)).getD (n + k) false := by
        have hlenx : (List.ofFn x).length = n := List.length_ofFn
        have hwg := wires_getD_gate T (List.ofFn x) k hkt (by
          rw [hlenx]; intro u hu; exact readsBack_mem hAO k hkt u hu)
        rw [hlenx] at hwg
        rw [hwg]
        change _ = g.op.eval (g.inputs.map fun i => (T.wires (List.ofFn x)).getD i false)
        rcases hgi : g.inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
        · simp [hgi] at hglen
        · simp [hgi] at hglen
        · have hu_rb : u < n + k := readsBack_mem hAO k hkt u (by simp [g, hgi])
          have hw_rb : w < n + k := readsBack_mem hAO k hkt w (by simp [g, hgi])
          have hwire_in (z : Nat) (hz : z < n) :
              (T.wires (List.ofFn x)).getD z false = x ⟨z, hz⟩ := by
            rw [wires_getD_input _ _ _ (by rw [hlenx]; exact hz),
                List.getD_eq_getElem _ _ (by rw [hlenx]; exact hz), List.getElem_ofFn]
          have hbit_op (v1 v2 : Nat) (b1 b2 : Bool)
              (hb1 : v1.testBit (pack6 (fun i => x (c i))) = b1)
              (hb2 : v2.testBit (pack6 (fun i => x (c i))) = b2) :
              (if opOfGate g then v1 ||| v2 else v1 &&& v2).testBit (pack6 (fun i => x (c i))) =
                g.op.eval [b1, b2] := by
            rcases hgop with hop | hop
            · simp [opOfGate, hop, GateOp.eval, Nat.testBit_and, hb1, hb2]
            · simp [opOfGate, hop, GateOp.eval, Nat.testBit_or, hb1, hb2]
          have hbit_op_comm (v1 v2 : Nat) (b1 b2 : Bool)
              (hb1 : v1.testBit (pack6 (fun i => x (c i))) = b1)
              (hb2 : v2.testBit (pack6 (fun i => x (c i))) = b2) :
              (if opOfGate g then v1 ||| v2 else v1 &&& v2).testBit (pack6 (fun i => x (c i))) =
                g.op.eval [b2, b1] := by
            rcases hgop with hop | hop
            · simp [opOfGate, hop, GateOp.eval, Nat.testBit_and, hb1, hb2, Bool.and_comm]
            · simp [opOfGate, hop, GateOp.eval, Nat.testBit_or, hb1, hb2, Bool.or_comm]
          simp only [List.map_cons, List.map_nil]
          by_cases hu : u < n <;> by_cases hw : w < n
          · have hs : sOfGate n g = [] := by
              simp [sOfGate, hgi, show ¬ (n ≤ u) by omega, show ¬ (n ≤ w) by omega]
            have hlg : leavesOfGate n g = [⟨u, hu⟩, ⟨w, hw⟩] := by simp [leavesOfGate, hgi, hu, hw]
            rw [hs]; simp only [pairVals]
            have h0 := hvar_eval 0 (by rw [hlg]; simp)
            have h1 := hvar_eval 1 (by rw [hlg]; simp)
            simp only [Nat.add_zero] at h0
            simp only [hlg, List.getElem_cons_zero, List.getElem_cons_succ] at h0 h1
            rw [hwire_in u hu, hwire_in w hw]
            exact hbit_op _ _ _ _ h0 h1
          · have hs : sOfGate n g = [w - n] := by
              simp [sOfGate, hgi, show ¬ (n ≤ u) by omega, show n ≤ w by omega]
            have hlg : leavesOfGate n g = [⟨u, hu⟩] := by simp [leavesOfGate, hgi, hu, hw]
            rw [hs]; simp only [pairVals]
            have h0 := hvar_eval 0 (by rw [hlg]; simp)
            simp only [Nat.add_zero, hlg, List.getElem_cons_zero] at h0
            have hwv := hvu (w - n) (by omega)
            rw [show n + (w - n) = w by omega] at hwv
            rw [hwire_in u hu]
            exact hbit_op_comm _ _ _ _ hwv h0
          · have hs : sOfGate n g = [u - n] := by
              simp [sOfGate, hgi, show n ≤ u by omega, show ¬ (n ≤ w) by omega]
            have hlg : leavesOfGate n g = [⟨w, hw⟩] := by simp [leavesOfGate, hgi, hu, hw]
            rw [hs]; simp only [pairVals]
            have h0 := hvar_eval 0 (by rw [hlg]; simp)
            simp only [Nat.add_zero, hlg, List.getElem_cons_zero] at h0
            have huv := hvu (u - n) (by omega)
            rw [show n + (u - n) = u by omega] at huv
            rw [hwire_in w hw]
            exact hbit_op _ _ _ _ huv h0
          · have huv := hvu (u - n) (by omega)
            have hwv := hvu (w - n) (by omega)
            rw [show n + (u - n) = u by omega] at huv
            rw [show n + (w - n) = w by omega] at hwv
            by_cases hlt : u < w
            · have hs : sOfGate n g = [u - n, w - n] := by
                simp [sOfGate, hgi, show n ≤ u by omega, show n ≤ w by omega, hlt]
              rw [hs]; simp only [pairVals]
              exact hbit_op _ _ _ _ huv hwv
            · have hs : sOfGate n g = [w - n, u - n] := by
                simp [sOfGate, hgi, show n ≤ u by omega, show n ≤ w by omega, hlt]
              rw [hs]; simp only [pairVals]
              exact hbit_op_comm _ _ _ _ hwv huv
        · simp [hgi] at hglen
      refine ⟨?_, ?_, ?_⟩
      · rw [hstep_eq]; simp [evalGenState, hvl]
      · rw [hstep_eq]; simp only [evalGenState, hSk, hopk]; exact hnew_nv
      · intro u hu
        rw [hstep_eq]; simp only [evalGenState, hSk, hopk]
        by_cases huk : u < k
        · rw [List.getD_eq_getElem _ _ (by simp [hvl]; omega), List.getElem_append_left (by omega)]
          have := hvu u huk
          rwa [List.getD_eq_getElem _ _ (by omega)] at this
        · have heq : u = k := by omega
          subst heq
          rw [List.getD_eq_getElem _ _ (by simp [hvl]), List.getElem_append_right (by omega)]
          simp only [hvl, Nat.sub_self, List.getElem_cons_zero]
          exact hnew_bit
  intro j hj
  have hfull := hprefix T.gates.length (le_refl _)
  have htake_all : ops.take T.gates.length = ops := List.take_of_length_le (by simp [ops])
  rw [htake_all] at hfull
  exact hfull.2.2 j hj

private lemma leafWires_length_eq {n : Nat} (T : Circuit) (hAO : IsAO2 n T) :
    (T.gates.flatMap (leavesOfGate n)).length =
      (T.gates.map (fun g => 2 - (sOfGate n g).length)).sum := by
  have haux : ∀ (gs : List Gate), (∀ g ∈ gs, g.inputs.length = 2) →
      (gs.flatMap (leavesOfGate n)).length = (gs.map (fun g => 2 - (sOfGate n g).length)).sum := by
    intro gs
    induction gs with
    | nil => intro _; simp
    | cons g rest ih =>
      intro hlen
      simp only [List.flatMap_cons, List.length_append, List.map_cons, List.sum_cons]
      rw [leavesOfGate_len n g (hlen g (by simp)), ih (fun g' hg' => hlen g' (by simp [hg']))]
  exact haux T.gates hAO.2.2

private lemma solveReduced {n : Nat} (hn : 0 < n) (T : Circuit) (hAO : IsAO2 n T)
    (hsz_pos : 1 ≤ T.gates.length) (hsz_le : T.gates.length ≤ 6)
    (hout : T.output = n + (T.gates.length - 1))
    (hnodup_in : ∀ j (hj : j < T.gates.length), (T.gates[j]'hj).inputs.Nodup)
    (hused : ∀ j < T.gates.length - 1, ∃ g ∈ T.gates, n + j ∈ g.inputs)
    (hno_absorb : ∀ j (hj : j < T.gates.length),
      absorbBad (sOfGate n (T.gates[j]'hj)) ((T.gates.take j).map (sOfGate n)) = false)
    (hno_dup : ∀ i j (hi : i < T.gates.length) (hj : j < T.gates.length), i < j →
      (sOfGate n (T.gates[j]'hj)).length = 2 →
      ¬ (sOfGate n (T.gates[i]'hi) = sOfGate n (T.gates[j]'hj) ∧
         opOfGate (T.gates[i]'hi) = opOfGate (T.gates[j]'hj)))
    (hlast_and : opOfGate (T.gates[T.gates.length - 1]'(by omega)) = false)
    (hbig : 8 ≤ (dagLeavesList (T.gates.map (sOfGate n))).getD (T.gates.length - 1) 0) :
    Satisfies n (fun x => T.eval (List.ofFn x)) := by
  set S := T.gates.map (sOfGate n)
  set ops := T.gates.map opOfGate
  have hS_len : S.length = T.gates.length := by simp [S]
  have hS_get (j : Nat) (hj : j < T.gates.length) : S.getD j [] = sOfGate n (T.gates[j]'hj) := by
    rw [List.getD_eq_getElem _ _ (by omega)]; simp [S]
  have hops_get (j : Nat) (hj : j < T.gates.length) : ops.getD j false = opOfGate (T.gates[j]'hj) := by
    rw [List.getD_eq_getElem _ _ (by simp [ops]; omega)]; simp [ops]
  have hS_used (j : Nat) (hj : j < T.gates.length - 1) : S.any (·.contains j) = true := by
    obtain ⟨g, hg, hmem⟩ := hused j hj
    rw [List.any_eq_true]
    refine ⟨sOfGate n g, List.mem_map_of_mem hg, ?_⟩
    rw [List.contains_eq_mem, decide_eq_true_eq, mem_sOfGate_iff n g (hAO.2.2 g hg)]
    exact hmem
  have hS_opts (j : Nat) (hj : j < T.gates.length) :=
    sOfGate_mem_opts n j (T.gates[j]'hj) (hAO.2.2 _ (List.getElem_mem hj)) (hnodup_in j hj)
      (fun w hw => readsBack_mem hAO j hj w hw)
  have finish56 (hslots : (T.gates.flatMap (leavesOfGate n)).length ≤ 6)
      (hrec : checkOpsRec S 0 [] 0 [] = true) :
      Satisfies n (fun x => T.eval (List.ofFn x)) := by
    have hkey : hasKey ((evalGenState S 0 ([], 0) ops).1.getD (S.length - 1) 0) = true := by
      apply checkOpsRec_sound S 0 [] 0 [] ops hrec rfl rfl
      · simp [ops, S]
      · intro hnil
        have h0 : T.gates.length = 0 := by
          have : ops.length = 0 := by rw [hnil]; rfl
          simpa [ops] using this
        omega
      · simp only [List.nil_append, hS_len]
        rw [hops_get (T.gates.length - 1) (by omega)]
        exact hlast_and
      · intro t _ ht ht2 i hit
        simp only [List.nil_append]
        rw [hS_len] at ht
        rw [hS_get t ht] at ht2 ⊢
        rw [hS_get i (by omega), hops_get i (by omega), hops_get t ht]
        exact hno_dup i t (by omega) ht hit ht2
    let leafWires := T.gates.flatMap (leavesOfGate n)
    let c : Fin 6 → Fin n := fun i => leafWires.getD i.val ⟨0, hn⟩
    apply satisfies_of_hasKey _ ((evalGenState S 0 ([], 0) ops).1.getD (S.length - 1) 0) c hkey
    intro x
    change (T.wires (List.ofFn x)).getD T.output false = _
    rw [hout, hS_len]
    exact (evalGenState_sim hn T hAO hslots x (T.gates.length - 1) (by omega)).symm
  have dl1 : (dagLeavesList [[]]).getD 0 0 = 2 := rfl
  have dl2 (s1 : List Nat) : (dagLeavesList [[], s1]).getD 1 0 = leafOf s1 [2] := rfl
  have dl3 (s1 s2 : List Nat) :
      (dagLeavesList [[], s1, s2]).getD 2 0 = leafOf s2 [2, leafOf s1 [2]] := rfl
  have dl4 (s1 s2 s3 : List Nat) :
      (dagLeavesList [[], s1, s2, s3]).getD 3 0 =
        leafOf s3 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]]] := rfl
  have dl5 (s1 s2 s3 s4 : List Nat) :
      (dagLeavesList [[], s1, s2, s3, s4]).getD 4 0 =
        leafOf s4 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]],
          leafOf s3 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]]]] := rfl
  have dl6 (s1 s2 s3 s4 s5 : List Nat) :
      (dagLeavesList [[], s1, s2, s3, s4, s5]).getD 5 0 =
        leafOf s5 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]],
          leafOf s3 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]]],
          leafOf s4 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]],
            leafOf s3 [2, leafOf s1 [2], leafOf s2 [2, leafOf s1 [2]]]]] := rfl
  have hbigS : 8 ≤ (dagLeavesList S).getD (T.gates.length - 1) 0 := hbig

  rcases hgl : T.gates with _ | ⟨g0, _ | ⟨g1, _ | ⟨g2, _ | ⟨g3, _ | ⟨g4, _ | ⟨g5, rest⟩⟩⟩⟩⟩⟩
  · simp [hgl] at hsz_pos
  ·
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have hSeq : S = [[]] := by simp [S, hgl, h0]
    rw [hSeq, hgl] at hbigS
    change 8 ≤ (dagLeavesList [[]]).getD 0 0 at hbigS
    rw [dl1] at hbigS; omega
  ·
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have h1 : sOfGate n g1 ∈ opts1 := by simpa [hgl] using (hS_opts 1 (by simp [hgl])).2.1 rfl
    have hSeq : S = [[], sOfGate n g1] := by simp [S, hgl, h0]
    rw [hSeq, hgl] at hbigS
    change 8 ≤ (dagLeavesList [[], sOfGate n g1]).getD 1 0 at hbigS
    rw [dl2] at hbigS
    simp only [opts1, List.mem_cons, List.not_mem_nil, or_false] at h1
    rcases h1 with h1 | h1 <;> (rw [h1] at hbigS; simp [leafOf] at hbigS)
  ·
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have h1 : sOfGate n g1 ∈ opts1 := by simpa [hgl] using (hS_opts 1 (by simp [hgl])).2.1 rfl
    have h2 : sOfGate n g2 ∈ opts2 := by simpa [hgl] using (hS_opts 2 (by simp [hgl])).2.2.1 rfl
    have hk := List.all_eq_true.mp (List.all_eq_true.mp checkK3_ok _ h1) _ h2
    simp only [decide_eq_true_eq] at hk
    have hSeq : S = [[], sOfGate n g1, sOfGate n g2] := by simp [S, hgl, h0]
    rw [hSeq, hgl] at hbigS
    change 8 ≤ (dagLeavesList [[], sOfGate n g1, sOfGate n g2]).getD 2 0 at hbigS
    rw [dl3] at hbigS; omega
  ·
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have h1 : sOfGate n g1 ∈ opts1 := by simpa [hgl] using (hS_opts 1 (by simp [hgl])).2.1 rfl
    have h2 : sOfGate n g2 ∈ opts2 := by simpa [hgl] using (hS_opts 2 (by simp [hgl])).2.2.1 rfl
    have h3 : sOfGate n g3 ∈ opts3 := by simpa [hgl] using (hS_opts 3 (by simp [hgl])).2.2.2.1 rfl
    have ha2 : absorbBad (sOfGate n g2) [[], sOfGate n g1] = false := by
      have := hno_absorb 2 (by simp [hgl]); simpa [hgl, h0] using this
    have ha3 : absorbBad (sOfGate n g3) [[], sOfGate n g1, sOfGate n g2] = false := by
      have := hno_absorb 3 (by simp [hgl]); simpa [hgl, h0] using this
    have hk1 := List.all_eq_true.mp checkK4_ok _ h1
    have hk2 := List.all_eq_true.mp hk1 _ h2
    simp only [ha2, Bool.false_eq_true, ite_false] at hk2
    have hk3 := List.all_eq_true.mp hk2 _ h3
    simp only [ha3, Bool.false_eq_true, ite_false, decide_eq_true_eq] at hk3
    have hSeq : S = [[], sOfGate n g1, sOfGate n g2, sOfGate n g3] := by simp [S, hgl, h0]
    rw [hSeq, hgl] at hbigS
    change 8 ≤ (dagLeavesList [[], sOfGate n g1, sOfGate n g2, sOfGate n g3]).getD 3 0 at hbigS
    rw [dl4] at hbigS; omega
  ·
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have h1 : sOfGate n g1 ∈ opts1 := by simpa [hgl] using (hS_opts 1 (by simp [hgl])).2.1 rfl
    have h2 : sOfGate n g2 ∈ opts2 := by simpa [hgl] using (hS_opts 2 (by simp [hgl])).2.2.1 rfl
    have h3 : sOfGate n g3 ∈ opts3 := by simpa [hgl] using (hS_opts 3 (by simp [hgl])).2.2.2.1 rfl
    have h4 : sOfGate n g4 ∈ opts4 := by simpa [hgl] using (hS_opts 4 (by simp [hgl])).2.2.2.2.1 rfl
    have ha2 : absorbBad (sOfGate n g2) [[], sOfGate n g1] = false := by
      have := hno_absorb 2 (by simp [hgl]); simpa [hgl, h0] using this
    have ha3 : absorbBad (sOfGate n g3) [[], sOfGate n g1, sOfGate n g2] = false := by
      have := hno_absorb 3 (by simp [hgl]); simpa [hgl, h0] using this
    have ha4 : absorbBad (sOfGate n g4) [[], sOfGate n g1, sOfGate n g2, sOfGate n g3] = false := by
      have := hno_absorb 4 (by simp [hgl]); simpa [hgl, h0] using this
    have hk1 := List.all_eq_true.mp checkK5_ok _ h1
    have hk2 := List.all_eq_true.mp hk1 _ h2
    simp only [ha2, Bool.false_eq_true, ite_false] at hk2
    have hk3 := List.all_eq_true.mp hk2 _ h3
    simp only [ha3, Bool.false_eq_true, ite_false] at hk3
    have hk4 := List.all_eq_true.mp hk3 _ h4
    simp only [ha4, Bool.false_eq_true, ite_false] at hk4
    have hSeq : S = [[], sOfGate n g1, sOfGate n g2, sOfGate n g3, sOfGate n g4] := by
      simp [S, hgl, h0]
    have hl4_ge : ¬ (leafOf (sOfGate n g4) [2, leafOf (sOfGate n g1) [2],
        leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]],
        leafOf (sOfGate n g3) [2, leafOf (sOfGate n g1) [2],
          leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]]]] < 8) := by
      rw [hSeq, hgl] at hbigS
      change 8 ≤ (dagLeavesList [[], sOfGate n g1, sOfGate n g2, sOfGate n g3, sOfGate n g4]).getD 4 0 at hbigS
      rw [dl5] at hbigS; omega
    have hu0 : S.any (·.contains 0) = true := hS_used 0 (by simp [hgl])
    have hu1 : S.any (·.contains 1) = true := hS_used 1 (by simp [hgl])
    have hu2 : S.any (·.contains 2) = true := hS_used 2 (by simp [hgl])
    have hu3 : S.any (·.contains 3) = true := hS_used 3 (by simp [hgl])
    rw [hSeq] at hu0 hu1 hu2 hu3
    simp only [hl4_ge, ite_false, hu0, hu1, hu2, hu3, Bool.and_true, Bool.not_true,
      Bool.false_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hk4
    have hslots : (T.gates.flatMap (leavesOfGate n)).length ≤ 6 := by
      rw [leafWires_length_eq T hAO]
      simp only [hgl, h0, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      have hlen_nil : ([] : List Nat).length = 0 := rfl
      rw [hlen_nil] at hk4
      omega
    exact finish56 hslots (by rw [hSeq]; exact hk4.2)
  ·
    have hrest : rest = [] := by
      cases rest with
      | nil => rfl
      | cons _ _ => simp [hgl] at hsz_le; omega
    subst hrest
    have h0 : sOfGate n g0 = [] := by simpa [hgl] using (hS_opts 0 (by simp [hgl])).1 rfl
    have h1 : sOfGate n g1 ∈ opts1 := by simpa [hgl] using (hS_opts 1 (by simp [hgl])).2.1 rfl
    have h2 : sOfGate n g2 ∈ opts2 := by simpa [hgl] using (hS_opts 2 (by simp [hgl])).2.2.1 rfl
    have h3 : sOfGate n g3 ∈ opts3 := by simpa [hgl] using (hS_opts 3 (by simp [hgl])).2.2.2.1 rfl
    have h4 : sOfGate n g4 ∈ opts4 := by simpa [hgl] using (hS_opts 4 (by simp [hgl])).2.2.2.2.1 rfl
    have h5 : sOfGate n g5 ∈ opts5 := by simpa [hgl] using (hS_opts 5 (by simp [hgl])).2.2.2.2.2 rfl
    have ha2 : absorbBad (sOfGate n g2) [[], sOfGate n g1] = false := by
      have := hno_absorb 2 (by simp [hgl]); simpa [hgl, h0] using this
    have ha3 : absorbBad (sOfGate n g3) [[], sOfGate n g1, sOfGate n g2] = false := by
      have := hno_absorb 3 (by simp [hgl]); simpa [hgl, h0] using this
    have ha4 : absorbBad (sOfGate n g4) [[], sOfGate n g1, sOfGate n g2, sOfGate n g3] = false := by
      have := hno_absorb 4 (by simp [hgl]); simpa [hgl, h0] using this
    have ha5 : absorbBad (sOfGate n g5) [[], sOfGate n g1, sOfGate n g2, sOfGate n g3, sOfGate n g4] = false := by
      have := hno_absorb 5 (by simp [hgl]); simpa [hgl, h0] using this
    have hk1 := List.all_eq_true.mp checkK6_ok _ h1
    have hk2 := List.all_eq_true.mp hk1 _ h2
    simp only [ha2, Bool.false_eq_true, ite_false] at hk2
    have hk3 := List.all_eq_true.mp hk2 _ h3
    simp only [ha3, Bool.false_eq_true, ite_false] at hk3
    have hk4 := List.all_eq_true.mp hk3 _ h4
    simp only [ha4, Bool.false_eq_true, ite_false] at hk4
    have hk5 := List.all_eq_true.mp hk4 _ h5
    simp only [ha5, Bool.false_eq_true, ite_false] at hk5
    have hSeq : S = [[], sOfGate n g1, sOfGate n g2, sOfGate n g3, sOfGate n g4, sOfGate n g5] := by
      simp [S, hgl, h0]
    have hl5_ge : ¬ (leafOf (sOfGate n g5) [2, leafOf (sOfGate n g1) [2],
        leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]],
        leafOf (sOfGate n g3) [2, leafOf (sOfGate n g1) [2],
          leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]]],
        leafOf (sOfGate n g4) [2, leafOf (sOfGate n g1) [2],
          leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]],
          leafOf (sOfGate n g3) [2, leafOf (sOfGate n g1) [2],
            leafOf (sOfGate n g2) [2, leafOf (sOfGate n g1) [2]]]]] < 8) := by
      rw [hSeq, hgl] at hbigS
      change 8 ≤ (dagLeavesList [[], sOfGate n g1, sOfGate n g2, sOfGate n g3, sOfGate n g4, sOfGate n g5]).getD 5 0 at hbigS
      rw [dl6] at hbigS; omega
    have hu0 : S.any (·.contains 0) = true := hS_used 0 (by simp [hgl])
    have hu1 : S.any (·.contains 1) = true := hS_used 1 (by simp [hgl])
    have hu2 : S.any (·.contains 2) = true := hS_used 2 (by simp [hgl])
    have hu3 : S.any (·.contains 3) = true := hS_used 3 (by simp [hgl])
    have hu4 : S.any (·.contains 4) = true := hS_used 4 (by simp [hgl])
    rw [hSeq] at hu0 hu1 hu2 hu3 hu4
    simp only [hl5_ge, ite_false, hu0, hu1, hu2, hu3, hu4, Bool.and_true, Bool.not_true,
      Bool.false_eq_true, Bool.and_eq_true, decide_eq_true_eq] at hk5
    have hslots : (T.gates.flatMap (leavesOfGate n)).length ≤ 6 := by
      rw [leafWires_length_eq T hAO]
      simp only [hgl, h0, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]
      have hlen_nil : ([] : List Nat).length = 0 := rfl
      rw [hlen_nil] at hk5
      omega
    exact finish56 hslots (by rw [hSeq]; exact hk5.2)

private lemma solveCircuit (s : Nat) (hs : s ≤ 6) :
    ∀ (n : Nat) (T : Circuit), IsAO2 n T → T.size = s → T.output < n + T.size →
      Satisfies n (fun x => T.eval (List.ofFn x)) := by
  induction s using Nat.strong_induction_on with
  | ind s ih =>
    intro n T hAO hsz ho
    have shrink (D : Circuit) (hD_AO : IsAO2 n D) (hD_lt : D.size < T.size)
        (hD_o : D.output < n + D.size)
        (hD_eq : ∀ x : Fin n → Bool, D.eval (List.ofFn x) = T.eval (List.ofFn x)) :
        Satisfies n (fun x => T.eval (List.ofFn x)) := by
      have hres := ih D.size (by omega) (by omega) n D hD_AO rfl hD_o
      rcases hres with ⟨φ, hle, heq⟩ | ⟨m, hm, c, heq⟩
      · exact Or.inl ⟨φ, hle, fun x => (hD_eq x).symm.trans (heq x)⟩
      · exact Or.inr ⟨m, hm, c, fun x => (hD_eq x).symm.trans (heq x)⟩

    by_cases hout_in : T.output < n
    · left
      refine ⟨DMFormula.lit ⟨T.output, hout_in⟩ true, by simp [DMFormula.leaves], fun x => ?_⟩
      change (T.wires (List.ofFn x)).getD T.output false = x ⟨T.output, hout_in⟩
      rw [wires_getD_input _ _ _ (by simpa using hout_in),
          List.getD_eq_getElem _ _ (by simpa using hout_in), List.getElem_ofFn]
    have hsz_pos : 1 ≤ T.gates.length := by change T.output < n + T.gates.length at ho; omega

    by_cases hunused : ∃ j < T.gates.length, T.output ≠ n + j ∧ ∀ g ∈ T.gates, n + j ∉ g.inputs
    · obtain ⟨j, hj, hne, hall⟩ := hunused
      obtain ⟨h1, h2, h3, h4⟩ := removeGate_ok (r := 0) hAO hj ho (Or.inl ⟨hne, hall⟩)
      exact shrink _ h1 h2 h3 h4
    push Not at hunused

    by_cases hdup_in : ∃ j, ∃ hj : j < T.gates.length, ¬ (T.gates[j]'hj).inputs.Nodup
    · obtain ⟨j, hj, hnd⟩ := hdup_in
      have hlen_g := hAO.2.2 _ (List.getElem_mem hj)
      rcases hgi : (T.gates[j]'hj).inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
      · simp [hgi] at hlen_g
      · simp [hgi] at hlen_g
      · have huw : u = w := by simpa [hgi] using hnd
        subst huw
        have hu_lt : u < n + j := readsBack_mem hAO j hj u (by simp [hgi])
        have heq_w : ∀ x : Fin n → Bool,
            (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD u false := by
          intro x
          have hwg := wires_getD_gate T (List.ofFn x) j hj (by
            rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
          rw [List.length_ofFn] at hwg; rw [hwg, hgi]
          rcases hAO.1 _ (List.getElem_mem hj) with hop | hop <;> simp [hop, GateOp.eval]
        obtain ⟨h1, h2, h3, h4⟩ := removeGate_ok hAO hj ho (Or.inr ⟨hu_lt, heq_w⟩)
        exact shrink _ h1 h2 h3 h4
      · simp [hgi] at hlen_g
    push Not at hdup_in

    by_cases hdup_g : ∃ i, ∃ j, ∃ hi : i < T.gates.length, ∃ hj : j < T.gates.length, i < j ∧
        (sOfGate n (T.gates[j]'hj)).length = 2 ∧
        sOfGate n (T.gates[i]'hi) = sOfGate n (T.gates[j]'hj) ∧
        opOfGate (T.gates[i]'hi) = opOfGate (T.gates[j]'hj)
    · obtain ⟨i, j, hi, hj, hij, h2, hs_eq, hop_eq⟩ := hdup_g
      rcases hsg : sOfGate n (T.gates[j]'hj) with _ | ⟨x0, _ | ⟨y0, _ | _⟩⟩
      · simp [hsg] at h2
      · simp [hsg] at h2
      · have hgi := sOfGate_eq_pair_iff n (T.gates[i]'hi) (hAO.2.2 _ (List.getElem_mem hi)) x0 y0 (hs_eq.trans hsg)
        have hgj := sOfGate_eq_pair_iff n (T.gates[j]'hj) (hAO.2.2 _ (List.getElem_mem hj)) x0 y0 hsg
        have heq_w : ∀ x : Fin n → Bool,
            (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD (n + i) false := by
          intro x
          have hwi := wires_getD_gate T (List.ofFn x) i hi (by
            rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO i hi z hz)
          have hwj := wires_getD_gate T (List.ofFn x) j hj (by
            rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
          rw [List.length_ofFn] at hwi hwj; rw [hwi, hwj]
          rcases hAO.1 _ (List.getElem_mem hi) with hopi | hopi <;>
          rcases hAO.1 _ (List.getElem_mem hj) with hopj | hopj
          · rcases hgi with hgi | hgi <;> rcases hgj with hgj | hgj <;>
              simp [hopi, hopj, hgi, hgj, GateOp.eval, Bool.and_comm]
          · simp [opOfGate, hopi, hopj] at hop_eq
          · simp [opOfGate, hopi, hopj] at hop_eq
          · rcases hgi with hgi | hgi <;> rcases hgj with hgj | hgj <;>
              simp [hopi, hopj, hgi, hgj, GateOp.eval, Bool.or_comm]
        obtain ⟨h1, h2', h3, h4⟩ := removeGate_ok hAO hj ho (Or.inr ⟨by omega, heq_w⟩)
        exact shrink _ h1 h2' h3 h4
      · simp [hsg] at h2
    push Not at hdup_g

    by_cases habs : ∃ j, ∃ hj : j < T.gates.length,
        absorbBad (sOfGate n (T.gates[j]'hj)) ((T.gates.take j).map (sOfGate n)) = true
    · obtain ⟨j, hj, hab⟩ := habs
      unfold absorbBad at hab
      rcases hsg : sOfGate n (T.gates[j]'hj) with _ | ⟨x0, _ | ⟨y0, _ | _⟩⟩
      · simp [hsg] at hab
      · simp [hsg] at hab
      · simp only [hsg] at hab
        have hgj := sOfGate_eq_pair_iff n (T.gates[j]'hj) (hAO.2.2 _ (List.getElem_mem hj)) x0 y0 hsg
        have hx_lt : n + x0 < n + j := by
          rcases hgj with hgj | hgj
          · exact readsBack_mem hAO j hj (n + x0) (by simp [hgj])
          · exact readsBack_mem hAO j hj (n + x0) (by simp [hgj])
        have hy_lt : n + y0 < n + j := by
          rcases hgj with hgj | hgj
          · exact readsBack_mem hAO j hj (n + y0) (by simp [hgj])
          · exact readsBack_mem hAO j hj (n + y0) (by simp [hgj])
        have hyj : y0 < j := by omega
        have hy_t : y0 < T.gates.length := by omega
        have hget_y : ((T.gates.take j).map (sOfGate n)).getD y0 [] = sOfGate n (T.gates[y0]'hy_t) := by
          have hlen_tk : ((T.gates.take j).map (sOfGate n)).length = j := by
            rw [List.length_map, List.length_take, Nat.min_eq_left (Nat.le_of_lt hj)]
          rw [List.getD_eq_getElem _ _ (by omega)]
          simp
        rw [hget_y, List.contains_eq_mem, decide_eq_true_eq,
            mem_sOfGate_iff n _ (hAO.2.2 _ (List.getElem_mem hy_t))] at hab
        have hlen_y := hAO.2.2 _ (List.getElem_mem hy_t)
        rcases hgy : (T.gates[y0]'hy_t).inputs with _ | ⟨u, _ | ⟨w, _ | _⟩⟩
        · simp [hgy] at hlen_y
        · simp [hgy] at hlen_y
        · simp only [hgy, List.mem_cons, List.not_mem_nil, or_false] at hab

          rcases hAO.1 _ (List.getElem_mem hj) with hopj | hopj <;>
          rcases hAO.1 _ (List.getElem_mem hy_t) with hopy | hopy
          ·
            have heq_w : ∀ x : Fin n → Bool,
                (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD (n + y0) false := by
              intro x
              have hwj := wires_getD_gate T (List.ofFn x) j hj (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
              have hwy := wires_getD_gate T (List.ofFn x) y0 hy_t (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO y0 hy_t z hz)
              rw [List.length_ofFn] at hwj hwy
              rw [hwj, hopj]
              rcases hgj with hgj | hgj <;>
                (rw [hgj]; simp only [GateOp.eval, List.map_cons, List.map_nil, List.all_cons,
                  List.all_nil, id_eq, Bool.and_true]; rw [hwy, hopy, hgy];
                  rcases hab with rfl | rfl <;>
                  (simp only [GateOp.eval, List.map_cons, List.map_nil, List.all_cons, List.all_nil,
                    id_eq, Bool.and_true]; cases (T.wires (List.ofFn x)).getD (n + x0) false <;> simp))
            obtain ⟨h1, h2', h3, h4⟩ := removeGate_ok hAO hj ho (Or.inr ⟨hy_lt, heq_w⟩)
            exact shrink _ h1 h2' h3 h4
          ·
            have heq_w : ∀ x : Fin n → Bool,
                (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD (n + x0) false := by
              intro x
              have hwj := wires_getD_gate T (List.ofFn x) j hj (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
              have hwy := wires_getD_gate T (List.ofFn x) y0 hy_t (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO y0 hy_t z hz)
              rw [List.length_ofFn] at hwj hwy
              rw [hwj, hopj]
              rcases hgj with hgj | hgj <;>
                (rw [hgj]; simp only [GateOp.eval, List.map_cons, List.map_nil, List.all_cons,
                  List.all_nil, id_eq, Bool.and_true]; rw [hwy, hopy, hgy];
                  rcases hab with rfl | rfl <;>
                  (simp only [GateOp.eval, List.map_cons, List.map_nil, List.any_cons, List.any_nil,
                    id_eq, Bool.or_false]; cases (T.wires (List.ofFn x)).getD (n + x0) false <;> simp))
            obtain ⟨h1, h2', h3, h4⟩ := removeGate_ok hAO hj ho (Or.inr ⟨hx_lt, heq_w⟩)
            exact shrink _ h1 h2' h3 h4
          ·
            have heq_w : ∀ x : Fin n → Bool,
                (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD (n + x0) false := by
              intro x
              have hwj := wires_getD_gate T (List.ofFn x) j hj (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
              have hwy := wires_getD_gate T (List.ofFn x) y0 hy_t (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO y0 hy_t z hz)
              rw [List.length_ofFn] at hwj hwy
              rw [hwj, hopj]
              rcases hgj with hgj | hgj <;>
                (rw [hgj]; simp only [GateOp.eval, List.map_cons, List.map_nil, List.any_cons,
                  List.any_nil, id_eq, Bool.or_false]; rw [hwy, hopy, hgy];
                  rcases hab with rfl | rfl <;>
                  (simp only [GateOp.eval, List.map_cons, List.map_nil, List.all_cons, List.all_nil,
                    id_eq, Bool.and_true]; cases (T.wires (List.ofFn x)).getD (n + x0) false <;> simp))
            obtain ⟨h1, h2', h3, h4⟩ := removeGate_ok hAO hj ho (Or.inr ⟨hx_lt, heq_w⟩)
            exact shrink _ h1 h2' h3 h4
          ·
            have heq_w : ∀ x : Fin n → Bool,
                (T.wires (List.ofFn x)).getD (n + j) false = (T.wires (List.ofFn x)).getD (n + y0) false := by
              intro x
              have hwj := wires_getD_gate T (List.ofFn x) j hj (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO j hj z hz)
              have hwy := wires_getD_gate T (List.ofFn x) y0 hy_t (by
                rw [List.length_ofFn]; intro z hz; exact readsBack_mem hAO y0 hy_t z hz)
              rw [List.length_ofFn] at hwj hwy
              rw [hwj, hopj]
              rcases hgj with hgj | hgj <;>
                (rw [hgj]; simp only [GateOp.eval, List.map_cons, List.map_nil, List.any_cons,
