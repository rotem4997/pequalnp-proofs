      intro i j hi hj hij h2 ⟨hs_eq, hop_eq⟩
      exact hdup_g i j hi hj hij h2 hs_eq hop_eq

    by_cases hsmall : (dagLeavesList (T.gates.map (sOfGate n))).getD (T.gates.length - 1) 0 ≤ 7
    · left
      obtain ⟨hlv, hev⟩ := unrollList_props n hn_pos T hAO
      refine ⟨(unrollList n hn_pos T.gates).getD (T.gates.length - 1) (DMFormula.lit ⟨0, hn_pos⟩ true),
        ?_, fun x => ?_⟩
      · rw [hlv (T.gates.length - 1) (by omega)]; exact hsmall
      · change (T.wires (List.ofFn x)).getD T.output false = _
        rw [hout_last]
        exact (hev x (T.gates.length - 1) (by omega)).symm

    have hbig : 8 ≤ (dagLeavesList (T.gates.map (sOfGate n))).getD (T.gates.length - 1) 0 := by omega
    cases hlast : opOfGate (T.gates[T.gates.length - 1]'(by omega))
    · exact solveReduced hn_pos T hAO hsz_pos (by change T.gates.length = s at hsz; omega)
        hout_last hdup_in hused' habs' hdup' hlast hbig
    · apply satisfies_dual
      have hfeq : (fun x : Fin n → Bool => !(T.eval (List.ofFn fun i => !(x i)))) =
          (fun x : Fin n → Bool => (flipOps T).eval (List.ofFn x)) := by
        funext x; exact (flipOps_eval hAO ho x).symm
      rw [hfeq]
      have hfs_eq : (flipOps T).gates.map (sOfGate n) = T.gates.map (sOfGate n) := by
        simp [flipOps, sOfGate]
      have hflast : opOfGate ((flipOps T).gates[(flipOps T).gates.length - 1]'(by simp [flipOps]; omega)) = false := by
        have hlen_f : (flipOps T).gates.length = T.gates.length := by simp [flipOps]
        have hget_f : (flipOps T).gates[(flipOps T).gates.length - 1]'(by omega) =
            ⟨flipOp (T.gates[T.gates.length - 1]'(by omega)).op,
             (T.gates[T.gates.length - 1]'(by omega)).inputs⟩ := by
          simp [flipOps]
        rw [hget_f]
        rcases hAO.1 _ (List.getElem_mem (show T.gates.length - 1 < T.gates.length by omega)) with hop | hop
        · simp [opOfGate, hop] at hlast
        · simp [opOfGate, flipOp, hop]
      apply solveReduced hn_pos (flipOps T) (flipOps_isAO2 hAO)
        (by simp [flipOps]; omega) (by simp [flipOps]; change T.gates.length = s at hsz; omega)
        (by simp [flipOps]; exact hout_last)
      · intro j hj
        have hj' : j < T.gates.length := by simpa [flipOps] using hj
        simpa [flipOps] using hdup_in j hj'
      · intro j hj
        have hj' : j < T.gates.length - 1 := by simpa [flipOps] using hj
        obtain ⟨g, hg, hmem⟩ := hused' j hj'
        exact ⟨⟨flipOp g.op, g.inputs⟩, List.mem_map_of_mem hg, hmem⟩
      · intro j hj
        have hj' : j < T.gates.length := by simpa [flipOps] using hj
        have ht_eq : ((flipOps T).gates.take j).map (sOfGate n) = (T.gates.take j).map (sOfGate n) := by
          rw [List.map_take, hfs_eq, ← List.map_take]
        rw [ht_eq]
        simpa [flipOps, sOfGate] using habs' j hj'
      · intro i j hi hj hij h2 ⟨hs_eq, hop_eq⟩
        have hi' : i < T.gates.length := by simpa [flipOps] using hi
        have hj' : j < T.gates.length := by simpa [flipOps] using hj
        have h2' : (sOfGate n (T.gates[j]'hj')).length = 2 := by simpa [flipOps, sOfGate] using h2
        have hs' : sOfGate n (T.gates[i]'hi') = sOfGate n (T.gates[j]'hj') := by
          simpa [flipOps, sOfGate] using hs_eq
        have hop_flip (g : Gate) (hg : g.op = GateOp.and ∨ g.op = GateOp.or) :
            opOfGate ⟨flipOp g.op, g.inputs⟩ = !(opOfGate g) := by
          rcases hg with h | h <;> simp [opOfGate, flipOp, h]
        have hop' : opOfGate (T.gates[i]'hi') = opOfGate (T.gates[j]'hj') := by
          simp only [flipOps, List.getElem_map] at hop_eq
          rw [hop_flip _ (hAO.1 _ (List.getElem_mem hi')),
              hop_flip _ (hAO.1 _ (List.getElem_mem hj'))] at hop_eq
          cases h1 : opOfGate (T.gates[i]'hi') <;> cases h2'' : opOfGate (T.gates[j]'hj') <;>
            simp_all
        exact hdup' i j hi' hj' hij h2' ⟨hs', hop'⟩
      · exact hflast
      · rw [hfs_eq]
        simpa [flipOps] using hbig

