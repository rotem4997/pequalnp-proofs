private def hasKey (tt : Nat) : Bool :=
  let h := tt % 251
  ((keyGrid.getD (h / 16) []).getD (h % 16) []).contains tt

private def opts1 : List (List Nat) := [[], [0]]
private def opts2 : List (List Nat) := [[], [0], [1], [0, 1]]
private def opts3 : List (List Nat) := [[], [0], [1], [2], [0, 1], [0, 2], [1, 2]]
