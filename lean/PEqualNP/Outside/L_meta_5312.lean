def NN : ℕ := 

def pk {α : Type} (A O : α → α → α) (o : Bool) (a b : α) : α := if o = true then O a b else A a b

def sel {α : Type} (r : ℕ) (u a b c : α) : α :=
  if r = 0 then u else if r = 1 then a else if r = 2 then b else c

def g4 {α : Type} (A O : α → α → α) (o0 o1 o2 o3 : Bool) (r2 r3 r4 r5 r6 r7 : ℕ) (u : ℕ → α) : α :=
  let w0 := pk A O o0 (u 0) (u 1)
  let w1 := pk A O o1 (sel r2 (u 2) w0 w0 w0) (sel r3 (u 3) w0 w0 w0)
  let w2 := pk A O o2 (sel r4 (u 4) w0 w1 w1) (sel r5 (u 5) w0 w1 w1)
  pk A O o3 (sel r6 (u 6) w0 w1 w2) (sel r7 (u 7) w0 w1 w2)

def mv (k : ℕ) : ℕ := if k < 8 then VS.getD k 0 else if k = 8 then FU else 0

def cm (f : ℕ) : List ℕ → ℕ → ℕ → ℕ
  | [], off, _ => if f.testBit off = true then FU else 0
  | t :: ms, off, w => (t &&& cm f ms (off + w) (2 * w)) ||| ((t ^^^ FU) &&& cm f ms off (2 * w))

def cd (o0 o1 o2 o3 : Bool) (r2 r3 r4 r5 r6 r7 : ℕ) : ℕ :=
