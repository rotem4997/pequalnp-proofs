def ext (Z : List Bool) (a : ℕ) : Bool := (true :: Z).getD a false

theorem gate (g : Gate) (hop : g.op = GateOp.and ∨ g.op = GateOp.or) (hlen : g.inputs.length ≤ 2) :
    ∃ (o : Bool) (a b : ℕ), ∀ Z : List Bool, Z.length < 1000 →
      g.op.eval (g.inputs.map fun i => Z.getD i false) =
        pk (· && ·) (· || ·) o (ext Z a) (ext Z b) := by
  have hF : ∀ Z : List Bool, Z.length < 1000 → ext Z 5000 = false := fun Z hZ =>
    List.getD_eq_default _ _ (by simp; omega)
  have hS : ∀ (Z : List Bool) i, ext Z (i + 1) = Z.getD i false := fun Z i => by simp [ext]
  match hI : g.inputs, hlen with
  | [], _ =>
    rcases hop with h | h
    · exact ⟨false, 0, 0, fun Z _ => by simp [h, GateOp.eval, pk, ext]⟩
    · exact ⟨true, 5000, 5000, fun Z hZ => by simp [h, GateOp.eval, pk, hF Z hZ]⟩
  | [a], _ =>
    rcases hop with h | h
    · exact ⟨false, a + 1, a + 1, fun Z _ => by simp [h, GateOp.eval, pk, hS]⟩
    · exact ⟨true, a + 1, a + 1, fun Z _ => by simp [h, GateOp.eval, pk, hS]⟩
  | [a, b], _ =>
    rcases hop with h | h
    · exact ⟨false, a + 1, b + 1, fun Z _ => by simp [h, GateOp.eval, pk, hS]⟩
    · exact ⟨true, a + 1, b + 1, fun Z _ => by simp [h, GateOp.eval, pk, hS]⟩

def rf (k a : ℕ) : ℕ := if 21 ≤ a ∧ a < 21 + k then a - 20 else 0

def lf (a : ℕ) : ℕ := if a ≤ 20 then a else 5000

theorem rf_lt (k a : ℕ) : rf k a < k + 1 := by
  unfold rf
  split_ifs <;> omega

