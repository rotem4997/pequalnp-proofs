  have e : ext (Z ++ ws) a = ((true :: Z) ++ ws).getD a false := rfl
  rw [e]
  by_cases h1 : a ≤ 20
  · have hr : rf ws.length a = 0 := by unfold rf; rw [if_neg (by omega)]
    rw [hr, sel, if_pos rfl, lf, if_pos h1, List.getD_eq_getElem?_getD,
      List.getElem?_append_left (by omega)]
    simp [ext, List.getD_eq_getElem?_getD]
  · rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by omega), hl]
    by_cases h2 : a < 21 + ws.length
    · obtain ⟨j, rfl⟩ : ∃ j, a = 21 + j := ⟨a - 21, by omega⟩
      have hr : rf ws.length (21 + j) = j + 1 := by unfold rf; rw [if_pos (by omega)]; omega
      have hj : j < 3 := by omega
      rw [hr, Nat.add_sub_cancel_left]
      interval_cases j <;> simp [sel, List.getD_eq_getElem?_getD]
    · have hr : rf ws.length a = 0 := by unfold rf; rw [if_neg (by omega)]
      have hf : ext Z 5000 = false := List.getD_eq_default _ _ (by omega)
      rw [hr, sel, if_pos rfl, lf, if_neg h1, hf, List.getElem?_eq_none (by omega)]
      rfl

