theorem g4_map {α β : Type} (φ : α → β) (A O : α → α → α) (A' O' : β → β → β)
    (hA : ∀ a b, φ (A a b) = A' (φ a) (φ b)) (hO : ∀ a b, φ (O a b) = O' (φ a) (φ b))
    (o0 o1 o2 o3 : Bool) (r2 r3 r4 r5 r6 r7 : ℕ) (u : ℕ → α) :
    φ (g4 A O o0 o1 o2 o3 r2 r3 r4 r5 r6 r7 u) =
      g4 A' O' o0 o1 o2 o3 r2 r3 r4 r5 r6 r7 fun i => φ (u i) := by
  have hp : ∀ o a b, φ (pk A O o a b) = pk A' O' o (φ a) (φ b) := by
    intro o a b
    unfold pk
    split_ifs
    · exact hO a b
    · exact hA a b
  have hs : ∀ r a b c d, φ (sel r a b c d) = sel r (φ a) (φ b) (φ c) (φ d) := by
    intro r a b c d
    unfold sel
    split_ifs <;> rfl
  simp only [g4, hp, hs]

theorem g4_congr {α : Type} (A O : α → α → α) (o0 o1 o2 o3 : Bool) (r2 r3 r4 r5 r6 r7 : ℕ)
    (u v : ℕ → α) (h : ∀ i < 8, u i = v i) :
    g4 A O o0 o1 o2 o3 r2 r3 r4 r5 r6 r7 u = g4 A O o0 o1 o2 o3 r2 r3 r4 r5 r6 r7 v := by
  simp only [g4, h 0 (by omega), h 1 (by omega), h 2 (by omega), h 3 (by omega), h 4 (by omega),
    h 5 (by omega), h 6 (by omega), h 7 (by omega)]

def bsum (w : ℕ) : List Bool → ℕ
  | [] => 0
  | b :: bs => w * b.toNat + bsum (2 * w) bs

theorem cm_bit (f : ℕ) (r : Fin 256) (ms : List ℕ) : ∀ off w, (cm f ms off w).testBit r.val =
    f.testBit (off + bsum w (ms.map fun t => t.testBit r.val)) := by
  induction ms with
  | nil =>
    intro off w
    simp only [cm, List.map_nil, bsum, Nat.add_zero]
    cases h : f.testBit off
    · simp
    · simp [fbit r]
  | cons t ms ih =>
    intro off w
    simp only [cm, List.map_cons, bsum, Nat.testBit_or, Nat.testBit_and, Nat.testBit_xor, fbit r, ih]
    cases t.testBit r.val
    · simp
    · simp [Nat.add_assoc]

