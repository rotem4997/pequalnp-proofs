    change (Z ++ [w0]) ++ [g1.op.eval (g1.inputs.map fun i => (Z ++ [w0]).getD i false)] = _
    rw [q1, List.append_assoc]
    rfl
  have s2 : F (Z ++ [w0, w1]) g2 = Z ++ [w0, w1, w2] := by
    change (Z ++ [w0, w1]) ++ [g2.op.eval (g2.inputs.map fun i => (Z ++ [w0, w1]).getD i false)] = _
    rw [q2, List.append_assoc]
    rfl
  have s3 : F (Z ++ [w0, w1, w2]) g3 = Z ++ [w0, w1, w2, w3] := by
    change (Z ++ [w0, w1, w2]) ++
      [g3.op.eval (g3.inputs.map fun i => (Z ++ [w0, w1, w2]).getD i false)] = _
    rw [q3, List.append_assoc]
    rfl
  have hev : C.eval x = w3 := by
    have e : C.wires x = F (F (F (F Z g0) g1) g2) g3 := by
      change List.foldl F x C.gates = _
      rw [hgs, List.foldl_append]
      rfl
    change (C.wires x).getD C.output false = _
    rw [e, s0, s1, s2, s3, hout, List.getD_eq_getElem?_getD,
      List.getElem?_append_right (by omega), hZ]
    rfl
  rw [hev]
  have hh := hk fun i => ext Z (lv i)
  have hg4 : g4 (· && ·) (· || ·) o0 o1 o2 o3 (rf 1 a1) (rf 1 b1) (rf 2 a2) (rf 2 b2) (rf 3 a3)
      (rf 3 b3) (fun i => ext Z (lv i)) = w3 := rfl
  rw [← hg4, hh]
  have hlist : (List.ofFn fun i : Fin 5 => if k i < 8 then ext Z (lv (k i)) else decide (k i = 8)) =
      List.ofFn fun i : Fin 5 => (true :: Z).getD
        (if k i < 8 then lv (k i) else if k i = 8 then 0 else 5000) false := by
    congr 1
    funext i
    by_cases h : k i < 8
    · rw [if_pos h, if_pos h]; rfl
    · rw [if_neg h, if_neg h]
      by_cases h' : k i = 8
      · rw [if_pos h', decide_eq_true h']; rfl
      · rw [if_neg h', decide_eq_false h']
        exact (List.getD_eq_default _ _ (by simp [hZ])).symm
  rw [hlist]
  congr 1
  exact (bits5 _ _ _ _ _).symm
