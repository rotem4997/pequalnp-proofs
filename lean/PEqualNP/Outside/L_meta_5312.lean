def mm (c i : ℕ) : ℕ := (c >>> (5 + 4 * i)) % 16

def ck (o0 o1 o2 o3 : Bool) (r2 r3 r4 r5 r6 r7 : ℕ) : Bool :=
  let c := cd o0 o1 o2 o3 r2 r3 r4 r5 r6 r7
