theorem positive_bound (s : ℕ) (h : HasCircuitSize 6 positive s) : 9 ≤ s := by
  obtain ⟨k, hk, hc⟩ := Pin.one_gate_at 5 positive 4 false s
    ⟨fun _ => false, by decide +kernel⟩ ⟨fun _ => false, fun i => decide (i = 5), by decide +kernel⟩ h
  let g : (Fin 6 → Bool) → Bool := fun x => positive (Function.update x 4 false)
  obtain ⟨t, ht, hd⟩ := Pin.one_gate_at 5 g 5 false k
    ⟨fun _ => false, by decide +kernel⟩ ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 1), by decide +kernel⟩ hc
  let pi : Fin 6 → Fin 4 := ![0,1,2,3,0,0]
  have hr := Pin.relabel_size pi (fun x => g (Function.update x 5 false)) t hd
  have e : (fun x : Fin 4 → Bool => g (Function.update (x ∘ pi) 5 false)) = Base.twoOfFour := by funext x; revert x; decide +kernel
  rw [e] at hr
  have hcore : 7 ≤ t := by
    by_contra hn
    obtain ⟨c, hx, hy, hz⟩ := hr
    exact Base.excludeTwo ⟨c, hx, by omega, hz⟩
  omega
