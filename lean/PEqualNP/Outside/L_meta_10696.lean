def base (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 2) || (x 0 && x 4) || (x 2 && x 4) || (x 0 && x 5) || (x 2 && x 5) || (x 4 && x 5) || (x 0 && x 6) || (x 2 && x 6) || (x 4 && x 6)
def target (x : Fin 7 → Bool) : Bool := base x || (x 6 && (x 1 || x 3)) || (x 1 && x 3)
def special : Finset (Fin 7) := {1,3}
lemma base_zero (x : Fin 7 → Bool) : base (zeroOn special x) = base x := by
  simp [base, zeroOn, special]
lemma base_update6 (x : Fin 7 → Bool) (b : Bool) : base (Function.update x 1 b) = base x := by
  simp [base, Function.update_apply]
lemma base_update7 (x : Fin 7 → Bool) (b : Bool) : base (Function.update x 3 b) = base x := by
  simp [base, Function.update_apply]
lemma deep_target : DeepHyp target special := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro y hy b
    simp [special] at hy
    rcases hy with rfl | rfl <;> cases b
    all_goals refine ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 2), ?_⟩
    all_goals simp [target,base,Function.update_apply]
  · intro y hy z hz hne
    simp [special] at hy hz
    rcases hy with rfl | rfl <;> rcases hz with rfl | rfl
    · exact (hne rfl).elim
    · rintro ⟨a,b,h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 6))
      cases a <;> cases b <;> simp [target,base,set2,Function.update_apply] at h0 h1
    · rintro ⟨a,b,h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 6))
      cases a <;> cases b <;> simp [target,base,set2,Function.update_apply] at h0 h1
    · exact (hne rfl).elim
  · intro y hy x hx
    have hg : base x = false := by
      have hz : base (zeroOn special x) = false := by simpa [target,zeroOn,special] using hx
      exact (base_zero x).symm.trans hz
    simp [special] at hy
    rcases hy with rfl | rfl
    · let x' := Function.update (Function.update x 1 false) 3 (!x 6)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [special] at hi
        simp [x',Function.update_of_ne hi.1,Function.update_of_ne hi.2]
      · simp [x']
      · simp [target,base_update6,base_update7,x',hg]
      · cases h5 : x 6 <;> simp [target,base_update6,base_update7,x',hg,h5]
    · let x' := Function.update (Function.update x 3 false) 1 (!x 6)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [special] at hi
        simp [x',Function.update_of_ne hi.1,Function.update_of_ne hi.2]
      · simp [x']
      · simp [target,base_update6,base_update7,x',hg]
      · cases h5 : x 6 <;> simp [target,base_update6,base_update7,x',hg,h5]
  · intro x hx
    have hg : base x = true := by
      have hz : base (zeroOn special x) = true := by simpa [target,zeroOn,special] using hx
      exact (base_zero x).symm.trans hz
    simp [target,hg]
  · decide
end PEqualNP.Outside.L_meta_10696.Maj.EdgeFn

