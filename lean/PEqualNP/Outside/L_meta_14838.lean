theorem rejected : Mask.search 6 core = false := by decide +kernel

theorem coreLower : Lower true core Mask.goal 7 := by
  intro p bank hr ha
  obtain ⟨k,S,hk,run,hs⟩ := reach_live (T:=Mask.goal) (by unfold proper; decide +kernel) (by decide +kernel) (by decide +kernel) hr ha
  by_contra! h
  have b := liveBuild run core.toFinset (fun a ha => List.mem_toFinset.mpr (hs a ha))
  have le : k ≤ 6 := by omega
  have lift {a b : ℕ} (hl : a ≤ b) (hb : Mask.build Mask.basicOps Mask.goal a core.toFinset) : Mask.build Mask.basicOps Mask.goal b core.toFinset := by
    induction hl with
    | refl => exact hb
    | step _ ih => exact Or.inl ih
  have yes := Mask.search_complete (Or.inl rfl) 6 core (by decide +kernel) (lift le b)
  exact Bool.noConfusion (rejected.symm.trans yes)
theorem disappears (a : Sig) (h : rename rm a = zero) : Constant (observe (rename rm a)) := by
  exact ⟨false, funext fun i => h ▸ bit_zero i⟩

theorem restricted : Lower true raw graph 10 := by
  have eq : rename rm graph = Mask.goal := by decide +kernel
  have supp (a : Sig) (ha : a ∈ raw) : rename rm a ∈ core ∨ rename rm a = zero := by
    have check : raw.all (fun z => decide (rename rm z ∈ core ∨ rename rm z = zero)) = true := by decide +kernel
    exact of_decide_eq_true (List.all_eq_true.mp check a ha)
  have zeroed (a : Sig) (ha : a ∈ gone) : rename rm a = zero := by
    simp only [gone,Finset.mem_insert,Finset.mem_singleton] at ha
    rcases ha with rfl|rfl|rfl <;> decide +kernel
  have singles : gone ⊆ raw.toFinset := by
    intro a ha
    simp only [gone,Finset.mem_insert,Finset.mem_singleton] at ha
    rcases ha with rfl|rfl|rfl <;> decide +kernel
  have card : gone.card = 3 := by decide +kernel
  have prior := lower_slice (u:=true) (roots:=raw) graph_proper (by decide +kernel) (by decide +kernel) (by unfold proper; decide +kernel : proper Mask.goal) rm eq (other:=core) (fun a ha => by
      rcases supp a ha with h | h
      · exact Or.inl (List.mem_map_of_mem h)
      · exact Or.inr (Or.inl (disappears a h))) gone (fun a ha => by
        have mem := List.mem_toFinset.mp (singles ha)
        rw [←sixList] at mem
        obtain ⟨i,hi⟩ := List.mem_ofFn.mp mem
        change raw.getD i.val zero = a at hi
        exact ⟨lowRow i,highRow i,allSixRequired.1 i,fun v hv hn => by
          rw [←sixList] at hv
          obtain ⟨j,rfl⟩ := List.mem_ofFn.mp hv
          apply allSixRequired.2 i j
          rintro rfl
          exact hn hi⟩) (fun a ha => disappears a (zeroed a ha)) 7 coreLower
  simpa only [card] using prior

theorem excluded : Impossible true graph 9 raw.toFinset := by
  intro k small run
  have steps := list_run run raw (by decide +kernel) rfl
  obtain ⟨q, bank, built, hit, limit⟩ := contraction (observe_proper graph_proper)
    steps (raw.map observe) Reach.start (fun _ h => Or.inl h)
  have bound := restricted q bank built hit
  omega
