-- Credit: the case-split reduction shape of foudress (R_meta_1710_64, #23768) and willakone
-- (R_meta_17910_64). This is a split on x1 at 400; each piece is the step with that one extra hypothesis.
theorem PEqualNP.Outside.R_meta_7907_2
    (caseA : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit), x1 < (400 : ℕ) → (300 : ℕ) ≤ x1 → x1 ≤ (399 : ℕ) → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x9 : Fin x2), Fintype.card { x10 : Fin x2 // x3 x10 x9 } = x1 + (1 : ℕ)) → (∀ (x10 x11 : Fin x2), x10 ≠ x11 → ∃! x13 : Fin x2, x3 x10 x13 ∧ x3 x11 x13) → PEqualNP.MetaComplexity.Monotone2 x5 → x2 + x2 ≤ x5.output → x5.output < x2 + x2 + x5.size → (∃ (x14 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x5.output - (x2 + x2)]? = Option.some x14 ∧ x14.op = PEqualNP.CircuitLowerBounds.GateOp.and) → (∀ (x15 : ℕ) (x16 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x15]? = Option.some x16 → ∃ (x18 : ℕ) (x19 : ℕ), x16.inputs = [x18, x19] ∧ x18 < x19 ∧ x19 < x2 + x2 + x15) → (∀ (x16 x17 : Fin x2), x3 x16 x17 → (PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 fun (x19 : Fin (x2 + x2)) => Decidable.decide (x19 = Fin.castAdd x2 x16 ∨ x19 = Fin.natAdd x2 x17)) = Bool.true) → (∀ (x17 : Fin (x2 + x2) → Bool), Fintype.card { x18 : Fin x2 // x17 (Fin.natAdd x2 x18) = Bool.true } ≤ x1 → (¬∃ (x19 : Fin x2) (x20 : Fin x2), x3 x19 x20 ∧ x17 (Fin.castAdd x2 x19) = Bool.true ∧ x17 (Fin.natAdd x2 x20) = Bool.true) → PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 x17 = Bool.false) → x2 * x1 ≤ (100 : ℕ) * x5.size)
    (caseB : ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit), (400 : ℕ) ≤ x1 → (300 : ℕ) ≤ x1 → x1 ≤ (399 : ℕ) → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x9 : Fin x2), Fintype.card { x10 : Fin x2 // x3 x10 x9 } = x1 + (1 : ℕ)) → (∀ (x10 x11 : Fin x2), x10 ≠ x11 → ∃! x13 : Fin x2, x3 x10 x13 ∧ x3 x11 x13) → PEqualNP.MetaComplexity.Monotone2 x5 → x2 + x2 ≤ x5.output → x5.output < x2 + x2 + x5.size → (∃ (x14 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x5.output - (x2 + x2)]? = Option.some x14 ∧ x14.op = PEqualNP.CircuitLowerBounds.GateOp.and) → (∀ (x15 : ℕ) (x16 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x15]? = Option.some x16 → ∃ (x18 : ℕ) (x19 : ℕ), x16.inputs = [x18, x19] ∧ x18 < x19 ∧ x19 < x2 + x2 + x15) → (∀ (x16 x17 : Fin x2), x3 x16 x17 → (PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 fun (x19 : Fin (x2 + x2)) => Decidable.decide (x19 = Fin.castAdd x2 x16 ∨ x19 = Fin.natAdd x2 x17)) = Bool.true) → (∀ (x17 : Fin (x2 + x2) → Bool), Fintype.card { x18 : Fin x2 // x17 (Fin.natAdd x2 x18) = Bool.true } ≤ x1 → (¬∃ (x19 : Fin x2) (x20 : Fin x2), x3 x19 x20 ∧ x17 (Fin.castAdd x2 x19) = Bool.true ∧ x17 (Fin.natAdd x2 x20) = Bool.true) → PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 x17 = Bool.false) → x2 * x1 ≤ (100 : ℕ) * x5.size) :
    ∀ (x1 x2 : ℕ) (x3 : Fin x2 → Fin x2 → Prop) [x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit), (300 : ℕ) ≤ x1 → x1 ≤ (399 : ℕ) → x2 = x1 ^ (2 : ℕ) + x1 + (1 : ℕ) → (∀ (x9 : Fin x2), Fintype.card { x10 : Fin x2 // x3 x10 x9 } = x1 + (1 : ℕ)) → (∀ (x10 x11 : Fin x2), x10 ≠ x11 → ∃! x13 : Fin x2, x3 x10 x13 ∧ x3 x11 x13) → PEqualNP.MetaComplexity.Monotone2 x5 → x2 + x2 ≤ x5.output → x5.output < x2 + x2 + x5.size → (∃ (x14 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x5.output - (x2 + x2)]? = Option.some x14 ∧ x14.op = PEqualNP.CircuitLowerBounds.GateOp.and) → (∀ (x15 : ℕ) (x16 : PEqualNP.CircuitLowerBounds.Gate), x5.gates[x15]? = Option.some x16 → ∃ (x18 : ℕ) (x19 : ℕ), x16.inputs = [x18, x19] ∧ x18 < x19 ∧ x19 < x2 + x2 + x15) → (∀ (x16 x17 : Fin x2), x3 x16 x17 → (PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 fun (x19 : Fin (x2 + x2)) => Decidable.decide (x19 = Fin.castAdd x2 x16 ∨ x19 = Fin.natAdd x2 x17)) = Bool.true) → (∀ (x17 : Fin (x2 + x2) → Bool), Fintype.card { x18 : Fin x2 // x17 (Fin.natAdd x2 x18) = Bool.true } ≤ x1 → (¬∃ (x19 : Fin x2) (x20 : Fin x2), x3 x19 x20 ∧ x17 (Fin.castAdd x2 x19) = Bool.true ∧ x17 (Fin.natAdd x2 x20) = Bool.true) → PEqualNP.MetaComplexity.circuitFun (x2 + x2) x5 x17 = Bool.false) → x2 * x1 ≤ (100 : ℕ) * x5.size := by
  intro x1 x2 x3 x4 x5
  rcases Nat.lt_or_ge x1 (400 : ℕ) with h | h
  · exact @caseA x1 x2 x3 x4 x5 h
