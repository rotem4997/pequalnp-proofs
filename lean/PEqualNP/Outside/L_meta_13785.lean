  ⟨.and, [1, 11]⟩,
  ⟨.or, [12, 8]⟩,
  ⟨.or, [0, 13]⟩
]

theorem wfits : Monotone2 ⟨wg, 14⟩ := by
  intro g hg
  simp only [wg, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> simp

theorem weval_fast : ∀ x : Fin 6 → Bool, Circuit.eval ⟨wg, 14⟩ (List.ofFn x) = Ffast x := by
  decide +kernel

theorem weval (x : Fin 6 → Bool) : Circuit.eval ⟨wg, 14⟩ (List.ofFn x) = F x :=
  (weval_fast x).trans (F_eq_Ffast x).symm

end PEqualNP.Outside.L_meta_13785_aux

open PEqualNP.Outside.L_meta_13785_aux in
theorem PEqualNP.Outside.L_meta_13785 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4278124270 * 2 ^ 32 + 4277075690) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4278124270 * 2 ^ 32 + 4277075690) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) := by
