    (try simp only [List.length_cons] at *) <;>
    simp only [Bool.or_eq_true, Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq, bne_iff_ne]
  · left; left; exact ⟨hc, by convert ht using 2; omega⟩
  · left; right; exact ⟨by omega, .inl ⟨by convert hc using 1; ac_rfl, by convert ht using 2; omega⟩⟩
  · left; right; exact ⟨by omega, .inr ⟨by convert hc using 1; ac_rfl, by convert ht using 2; omega⟩⟩
  · right; exact ⟨⟨by omega, by convert hc using 1; ac_rfl⟩, by convert ht using 2; omega⟩

theorem optimized_complete (n : ℕ) (ws : List W) (extra : ℕ) (hn : ws.Nodup)
    (room : extra + ws.length = n + 1) (h : live basicOps goal n ws.toFinset) :
    optimized n extra ws = true := by
  induction n generalizing ws extra with
  | zero => simp [optimized, singleton_list hn h]
  | succ k ih =>
    rcases first_live h with done | ⟨a, ha, b, hb, hab, z, hz, hout, needed, hs, tail⟩
    · simp [optimized, singleton_list hn done]
    · obtain ⟨r, hm, hp⟩ := pick_two (List.mem_toFinset.mp ha) (List.mem_toFinset.mp hb) hab
      have go {a b : W} (perm : ws.Perm (a :: b :: r))
          (hset : ws.toFinset = insert a (insert b needed)) (hop : z ∈ basicOps a b) :
          dispatch extra (optimized k) a b r = true := by
        obtain ⟨kept, hk, hnk, hfin⟩ := recover_kept perm hn hset
        have hznew : z ∉ kept := by
          intro hu
          apply hout
          rw [hset]
          exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (hfin ▸ (List.mem_toFinset.mpr hu)))
        have hnd : (z :: kept).Nodup := List.nodup_cons.mpr ⟨hznew, hnk⟩
        have hl : live basicOps goal k (z :: kept).toFinset := by
          simpa [hfin] using tail
        have hc := live_card hl
        rw [List.toFinset_card_of_nodup hnd, List.length_cons] at hc
        have len := perm.length_eq
        simp only [List.length_cons] at len
        apply dispatch_complete (k := k) (extra := extra) (optimized k) hop hk (by omega) (by omega) (cuts_full hl)
        apply ih _ _ hnd _ hl
        simp; omega
      simp only [optimized, Bool.or_eq_true, List.any_eq_true]
      right
      rcases hm with direct | swap
      · exact ⟨(a, b, r), direct, go hp hs hz⟩
      · exact ⟨(b, a, r), swap, go (hp.trans (.swap _ _ _)) (by rw [hs, Finset.insert_comm]) (ops_swap a b ▸ hz)⟩


def A : Fin 5 → Fin 5 → Bool := fun u v : Fin 5 => (11900594 : ℕ).testBit (5 * u.val + v.val)

def posL : List (Fin 5 × Fin 5) :=
  [(0, 1), (0, 4), (1, 0), (1, 2), (1, 4), (2, 0), (2, 2), (3, 0), (3, 1), (3, 3), (4, 0), (4, 1), (4, 3)]

def negL : List (Fin 5 × Fin 5) :=
  [(0, 0), (0, 2), (0, 3), (1, 1), (1, 3), (2, 1), (2, 3), (2, 4), (3, 2), (3, 4), (4, 2), (4, 4)]

def samp (k : Fin 312) : Fin 5 × Fin 5 :=
  if k.val < 156 then negL.getD (k.val % 12) (0, 0) else posL.getD ((k.val - 156) / 12) (0, 0)

theorem input_rows : ∀ k : Fin 312,
    rawInputs.map (bit k) = PEqualNP.Represents.oneEach (samp k).1 (samp k).2 := by
  decide +kernel

theorem goal_rows : ∀ k : Fin 312, bit k goal = A (samp k).1 (samp k).2 := by
  decide +kernel

theorem rows_eval (C : Circuit) (hr : PEqualNP.Represents.Represents A C) (k : Fin 312) :
    (C.gates.foldl step (rawInputs.map (bit k))).getD C.output false = bit k goal := by
  rw [input_rows k, goal_rows k]
  exact hr (samp k).1 (samp k).2

theorem initial_rep : represents inputs.toFinset rawInputs := by
  intro u hu
  exact .inr (.inr (List.mem_toFinset.mpr hu))

theorem get_build (C : Circuit) (hg : Monotone2 C) (hr : PEqualNP.Represents.Represents A C) :
    build basicOps goal C.gates.length inputs.toFinset :=
  compile C.gates C.output hg rawInputs inputs.toFinset initial_rep (rows_eval C hr)

theorem extend_live {m n : ℕ} {s : Finset W} (le : m ≤ n) (h : live basicOps goal m s) :
    live basicOps goal n s := by
  induction le with
  | refl => exact h
  | step _ ih => exact Or.inl ih

theorem inputs_nodup : inputs.Nodup := by decide +kernel

-- tryStep and step_complete are taken from the checked file lean/PEqualNP/Outside/L_meta_6340.lean of this
-- repository (PR 12632, Apache-2.0); the table of dead states follows its ReplayTree, here keyed by a number
-- (hsh) so that a lookup costs number comparisons. New here: optC (the search with a table per level), Good,
-- optC_complete, good_snoc, and the tables themselves.
def tryStep (next : ℕ → List W → Bool) (extra : ℕ) (ws : List W) : Bool :=
  ws == [goal] || (pairs ws).any (fun (a,b,r) => dispatch extra next a b r)

theorem step_complete {k extra : ℕ} {ws : List W} (hn : ws.Nodup)
    (room : extra + ws.length = k + 2) (h : live basicOps goal (k+1) ws.toFinset)
    (next : ℕ → List W → Bool)
    (child : ∀ l e, l.Nodup → e + l.length = k + 1 → live basicOps goal k l.toFinset → next e l = true) :
    tryStep next extra ws = true := by
  rcases first_live h with done | ⟨a, ha, b, hb, hab, z, hz, hout, needed, hs, tail⟩
  · simp [tryStep, singleton_list hn done]
  · obtain ⟨r, hm, hp⟩ := pick_two (List.mem_toFinset.mp ha) (List.mem_toFinset.mp hb) hab
    have go {a b : W} (perm : ws.Perm (a :: b :: r))
        (hset : ws.toFinset = insert a (insert b needed)) (hop : z ∈ basicOps a b) :
        dispatch extra next a b r = true := by
      obtain ⟨kept, hk, hnk, hfin⟩ := recover_kept perm hn hset
      have hznew : z ∉ kept := by
        intro hu
        apply hout
        rw [hset]
        exact Finset.mem_insert_of_mem (Finset.mem_insert_of_mem (hfin ▸ (List.mem_toFinset.mpr hu)))
      have hnd : (z :: kept).Nodup := List.nodup_cons.mpr ⟨hznew, hnk⟩
      have hl : live basicOps goal k (z :: kept).toFinset := by
        simpa [hfin] using tail
      have hc := live_card hl
      rw [List.toFinset_card_of_nodup hnd, List.length_cons] at hc
      have len := perm.length_eq
      simp only [List.length_cons] at len
      apply dispatch_complete (k := k) (extra := extra) next hop hk (by omega) (by omega) (cuts_full hl)
      exact child _ _ hnd (by simp; omega) hl
    simp only [tryStep, Bool.or_eq_true, List.any_eq_true]
    right
    rcases hm with direct | swap
    · exact ⟨(a, b, r), direct, go hp hs hz⟩
    · exact ⟨(b, a, r), swap, go (hp.trans (.swap _ _ _)) (by rw [hs, Finset.insert_comm]) (ops_swap a b ▸ hz)⟩



inductive ReplayTree where
  | nil
  | node (left : ReplayTree) (h : ℕ) (key : List W) (right : ReplayTree)

def ReplayTree.all (f : List W → Bool) : ReplayTree → Bool
  | .nil => true
  | .node l _ w r => l.all f && f w && r.all f

def ReplayTree.find (h : ℕ) (key : List W) : ReplayTree → Bool
  | .nil => false
  | .node l hw w r =>
    cond (Nat.beq h hw) (key == w) (cond (Nat.blt h hw) (l.find h key) (r.find h key))

theorem find_valid {f : List W → Bool} {h : ℕ} {key : List W} (t : ReplayTree) (ha : t.all f = true)
    (hm : t.find h key = true) : f key = true := by
  induction t with
  | nil => simp [ReplayTree.find] at hm
  | node l hw w r il ir =>
    simp only [ReplayTree.all, Bool.and_eq_true] at ha
    simp only [ReplayTree.find] at hm
    cases hb : Nat.beq h hw with
    | true =>
      rw [hb] at hm
      exact (eq_of_beq (show (key == w) = true from hm)) ▸ ha.1.2
    | false =>
      rw [hb] at hm
      cases hc : Nat.blt h hw with
      | true =>
        rw [hc] at hm
        exact il ha.1.1 hm
      | false =>
        rw [hc] at hm
        exact ir ha.2 hm

def ins (x : W) : List W → List W
  | [] => [x]
  | y :: ys => cond (Nat.ble x.toNat y.toNat) (x :: y :: ys) (y :: ins x ys)

def sortedW : List W → List W
  | [] => []
  | x :: xs => ins x (sortedW xs)

theorem ins_perm (x : W) (l : List W) : (ins x l).Perm (x :: l) := by
  induction l with
  | nil => exact .refl _
  | cons y ys ih =>
    simp only [ins]
    cases Nat.ble x.toNat y.toNat with
    | true => exact .refl _
    | false => exact (ih.cons y).trans (.swap _ _ _)

theorem sorted_perm (l : List W) : (sortedW l).Perm l := by
  induction l with
  | nil => exact .refl _
  | cons x xs ih => exact (ins_perm x _).trans (ih.cons x)

def hsh (l : List W) : ℕ := (l.foldl (fun s x => s + x.toNat * x.toNat) 0) % 4294967291

def sound (k : ℕ) (t : ReplayTree) : Prop :=
  ∀ (h : ℕ) (l : List W), t.find h l = true → l.Nodup → ¬live basicOps goal k l.toFinset


def optC (T : List ReplayTree) : ℕ → ℕ → List W → Bool
  | 0, _, ws => ws == [goal]
  | k + 1, extra, ws =>
    tryStep (fun e l => !((T.getD k ReplayTree.nil).find (hsh l) (sortedW l)) && optC T k e l) extra ws

def Good (T : List ReplayTree) : Prop := ∀ k, sound k (T.getD k ReplayTree.nil)

theorem optC_complete (T : List ReplayTree) (hT : Good T) (n : ℕ) (ws : List W) (extra : ℕ)
    (hn : ws.Nodup) (room : extra + ws.length = n + 1) (h : live basicOps goal n ws.toFinset) :
    optC T n extra ws = true := by
  induction n generalizing ws extra with
  | zero => simp [optC, singleton_list hn h]
  | succ k ih =>
    show tryStep _ extra ws = true
    refine step_complete hn (by omega) h _ (fun l e nd room' liveX => ?_)
    have hfind : (T.getD k ReplayTree.nil).find (hsh l) (sortedW l) = false := by
      cases hh : (T.getD k ReplayTree.nil).find (hsh l) (sortedW l) with
      | false => rfl
      | true =>
        have perm := sorted_perm l
        exact False.elim (hT k _ _ hh (perm.nodup_iff.mpr nd)
          (by simpa only [List.toFinset_eq_of_perm _ _ perm] using liveX))
    simp only [hfind, Bool.not_false, Bool.true_and]
    exact ih l e nd room' liveX

def blockedC (T : List ReplayTree) (k : ℕ) (l : List W) : Bool := !(optC T k (k + 1 - l.length) l)

theorem good_nil : Good [] := by
  intro k h l hm
  simp [ReplayTree.find] at hm

theorem good_snoc {T : List ReplayTree} {curr : ReplayTree} (hT : Good T)
    (hc : curr.all (blockedC T T.length) = true) : Good (T ++ [curr]) := by
  intro k h l hm hn hl
  rcases lt_trichotomy k T.length with hk | hk | hk
  · have e : (T ++ [curr]).getD k ReplayTree.nil = T.getD k ReplayTree.nil := by
      simp [List.getD_eq_getElem?_getD, List.getElem?_append_left hk]
    rw [e] at hm
    exact hT k h l hm hn hl
  · subst hk
    have e : (T ++ [curr]).getD T.length ReplayTree.nil = curr := by
      simp [List.getD_eq_getElem?_getD]
    rw [e] at hm
    have len := live_card hl
    rw [List.toFinset_card_of_nodup hn] at len
    have hopt := optC_complete T hT T.length l (T.length + 1 - l.length) hn (by omega) hl
    have hb := find_valid curr hc hm
    simp [blockedC, hopt] at hb
  · have e : (T ++ [curr]).getD k ReplayTree.nil = ReplayTree.nil := by
      apply List.getD_eq_default
      simp
      omega
    rw [e] at hm
    simp [ReplayTree.find] at hm

