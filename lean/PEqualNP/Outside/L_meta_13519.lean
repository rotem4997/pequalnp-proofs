  set out := (execN C.gates roots_10).getD C.output 0
  have hout : out &&& dom_10 = T &&& dom_10 := by
    apply Nat.eq_of_testBit_eq; intro r
    rw [Nat.testBit_and, Nat.testBit_and]
    by_cases hlt : r < 64
    · rw [dom_10_lt ⟨r, hlt⟩, Bool.and_true, Bool.and_true]
      have h1 := execN_bit C.gates roots_10 r (by omega) (fun g hg => (hfan g hg).1)
      have h2 := congrArg (fun l => l.getD C.output false) h1
      rw [roots_10_bits ⟨r, hlt⟩] at h2
      have hgd : ((execN C.gates roots_10).map (·.testBit r)).getD C.output false =
