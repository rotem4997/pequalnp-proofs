    intro gs
    induction gs with
    | nil => simp
    | cons g gs ih =>
      intro hm
      have ht := ih (fun a ha => hm a (List.mem_cons_of_mem g ha))
      dsimp only [PEqualNP.CircuitLowerBounds.GateOp.casesOn] at ht
      rcases hm g List.mem_cons_self with hg | hg <;> simp [List.countP_cons, hg, PEqualNP.CircuitLowerBounds.GateOp.casesOn] <;> omega
  have hm : ∀ g ∈ C.gates, g.op = PEqualNP.CircuitLowerBounds.GateOp.and ∨ g.op = PEqualNP.CircuitLowerBounds.GateOp.or := by
    intro g hg
    simpa only [Set.mem_insert_iff, Set.mem_singleton_iff] using (hmono g hg).1
  have hp := partition C.gates hm
  unfold PEqualNP.CircuitLowerBounds.Circuit.size at hsize
  omega
