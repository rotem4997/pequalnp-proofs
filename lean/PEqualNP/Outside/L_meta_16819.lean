def chAt (s i : Nat) : Nat := fld (CH s (i / 64)) 32 (i % 64)
def cidxH (s h : Nat) : Nat := bsr (chAt s) h 11 0 (CN s)
def checkCutByIdx (s : Nat) (ws : List Nat) (hint : Nat) : Bool :=
  match hint &&& 255 with
  | 0 => checkCutEntry dom_1 roots_1 7 s ws hint
  | 1 => checkCutEntry dom_2 roots_2 7 s ws hint
  | 2 => checkCutEntry dom_5 roots_5 6 s ws hint
  | 3 => checkCutEntry dom_0 roots_0 6 s ws hint
  | 4 => checkCutEntry dom_6 roots_6 6 s ws hint
  | 5 => checkCutEntry dom_7 roots_7 6 s ws hint
  | 6 => checkCutEntry dom_9 roots_9 6 s ws hint
  | 7 => checkCutEntry dom_12 roots_12 6 s ws hint
  | 8 => checkCutEntry dom_14 roots_14 5 s ws hint
  | 9 => checkCutEntry dom_15 roots_15 5 s ws hint
  | 10 => checkCutEntry dom_16 roots_16 5 s ws hint
  | 11 => checkCutEntry dom_17 roots_17 5 s ws hint
  | 12 => checkCutEntry dom_18 roots_18 5 s ws hint
  | 13 => checkCutEntry dom_11 roots_11 5 s ws hint
  | 14 => checkCutEntry dom_8 roots_8 5 s ws hint
  | 15 => checkCutEntry dom_19 roots_19 5 s ws hint
  | 16 => checkCutEntry dom_20 roots_20 4 s ws hint
  | 17 => checkCutEntry dom_13 roots_13 4 s ws hint
  | _ => false
def cutHitH (s h : Nat) (ws : List Nat) : Bool :=
  let i := cidxH s h
  decide (i < CN s) && (chAt s i == h) && checkCutByIdx s ws (fld (CV s (i / 32)) 32 (i % 32))

def cutHit (s : Nat) (ws : List Nat) : Bool := cutHitH s (hk 0 ws) ws

