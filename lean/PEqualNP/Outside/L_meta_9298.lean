abbrev Point := Fin 100
abbrev Color := Fin 9
abbrev State := Color → Nat

def forbidden (p : Point) : Nat := masks[p.val]!
def initial (k : Color) : Nat := seeds[k.val]!

private theorem forbidden_sound : ∀ p q : Point,
    (forbidden p).testBit q.val = true → clash p.val q.val = true := by
  decide +kernel

private theorem initial_sound : ∀ k : Color, ∀ q : Point,
    (initial k).testBit q.val = true →
      ∃ i : Fin 7, k.val = i.val ∧ clash (anchor i) q.val = true := by
  decide +kernel

-- Each certificate node names a pivot. Its children correspond to the
-- available colors in increasing order. The verifier checks every color.
def word (n : Nat) : Nat :=
  let chunk := chunks[n / 128]!
  chunk[n % 128]!

def pivot (n : Nat) : Point := Fin.ofNat 100 (word n % 100)
def nextNode (n : Nat) (k : Color) : Nat :=
  word n / 51200 + pops[(word n / 100 % 512) % (2 ^ k.val)]!

def mark (s : State) (p : Point) (k : Color) : State := fun j =>
  if j = k then s j ||| forbidden p else s j

def check : Nat → Nat → State → Bool
  | 0, _, _ => false
  | fuel + 1, n, s =>
    let p := pivot n
    cell p.val && (List.finRange 9).all (fun k =>
      (s k).testBit p.val || check fuel (nextNode n k) (mark s p k))

def Permits (s : State) (paint : Nat → Color) : Prop :=
  ∀ q : Point, cell q.val = true → (s (paint q.val)).testBit q.val = false

theorem check_sound (paint : Nat → Color)
    (proper : ∀ p q, cell p = true → cell q = true → clash p q = true →
      (paint p).val ≠ (paint q).val) (fuel n : Nat) (s : State)
    (ok : Permits s paint) (checked : check fuel n s = true) : False := by
  induction fuel generalizing n s with
  | zero => simp [check] at checked
  | succ fuel ih =>
    let p := pivot n
    have ht : cell p.val = true ∧ (List.finRange 9).all (fun k =>
        (s k).testBit p.val || check fuel (nextNode n k) (mark s p k)) = true :=
      Bool.and_eq_true_iff.mp checked
    let k := paint p.val
    have allowed : (s k).testBit p.val = false := ok p ht.1
    have branch := List.all_eq_true.mp ht.2 k (List.mem_finRange k)
    have checked' : check fuel (nextNode n k) (mark s p k) = true := by
      simpa only [allowed, Bool.false_or] using branch
    apply ih (nextNode n k) (mark s p k) _ checked'
    intro q hq
    by_cases same : paint q.val = k
    · have safe : (forbidden p).testBit q.val = false := by
        cases h : (forbidden p).testBit q.val with
        | false => rfl
        | true =>
          exact (proper p.val q.val ht.1 hq (forbidden_sound p q h)
            (congrArg Fin.val same.symm)).elim
      simp only [mark, ite_eq_left same, Nat.testBit_or, ok q hq, safe, Bool.false_or]
    · simpa only [mark, ite_eq_right same] using ok q hq

-- The root proof uses separately checked subtrees. Each cut is justified
-- by the transition of the same nine-color verifier used in each subtree.
private theorem check_step {fuel n : Nat} {s : State}
    (hp : cell (pivot n).val = true)
    (h : ∀ k : Color, (s k).testBit (pivot n).val = true ∨
      check fuel (nextNode n k) (mark s (pivot n) k) = true) :
    check (fuel + 1) n s = true := by
  apply Bool.and_eq_true_iff.mpr
  refine ⟨hp, List.all_eq_true.mpr ?_⟩
  intro k _
  exact Bool.or_eq_true_iff.mpr (h k)


private theorem all_colors {P : Color → Prop}
    (h0 : P 0) (h1 : P 1) (h2 : P 2) (h3 : P 3) (h4 : P 4)
    (h5 : P 5) (h6 : P 6) (h7 : P 7) (h8 : P 8) : ∀ k, P k := by
  intro k
  fin_cases k <;> assumption

