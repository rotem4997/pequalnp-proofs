import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_9298_aux

-- A cover labels each one-cell by a rectangle that contains it.
-- The labeling argument follows the certificate in upstream L-meta-10000.
abbrev Rect := Finset (Fin 10) × Finset (Fin 10)

def matrix : List Nat := [126, 413, 683, 839, 483, 725, 825, 822, 730, 492]

def entry (i j : Fin 10) : Bool := (matrix.getD i.val 0).testBit j.val

def row (p : Nat) : Fin 10 := Fin.ofNat 10 (p / 10)

def col (p : Nat) : Fin 10 := Fin.ofNat 10 p

def cell (p : Nat) : Bool := entry (row p) (col p)

def clash (p q : Nat) : Bool := !(entry (row p) (col q) && entry (row q) (col p))

def anchor (i : Fin 7) : Nat := ([1, 12, 27, 48, 56, 63, 79] : List Nat).getD i.val 0

private theorem anchor_cell : ∀ i : Fin 7, cell (anchor i) = true := by decide +kernel

private theorem anchor_clash : ∀ i j : Fin 7, i ≠ j → clash (anchor i) (anchor j) = true := by
  decide +kernel

private theorem cover_colors (L : List Rect) (size : L.length ≤ 9)
    (sound : ∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, entry i j = true)
    (covers : ∀ i j, entry i j = true → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) :
    ∃ color : Nat → Fin 9,
      (∀ p q, cell p = true → cell q = true → clash p q = true →
        (color p).val ≠ (color q).val) ∧
      ∀ i : Fin 7, (color (anchor i)).val = i.val := by
  classical
  have slots : ∀ p : Nat, ∃ k : Fin 9, cell p = true →
      ∃ r ∈ L, L[k.val]? = some r ∧ row p ∈ r.1 ∧ col p ∈ r.2 := by
    intro p
    by_cases hp : cell p = true
    · obtain ⟨r, hr, hrow, hcol⟩ := covers (row p) (col p) hp
      obtain ⟨k, hk, heq⟩ := List.mem_iff_getElem.mp hr
      refine ⟨⟨k, Nat.lt_of_lt_of_le hk size⟩, fun _ => ⟨r, hr, ?_, hrow, hcol⟩⟩
      simpa [List.getElem?_eq_getElem hk] using congrArg some heq
    · exact ⟨0, fun h => (hp h).elim⟩
  let paint (p : Nat) : Fin 9 := Classical.choose (slots p)
  have hPaint (p : Nat) : cell p = true → ∃ r ∈ L, L[(paint p).val]? = some r ∧ row p ∈ r.1 ∧ col p ∈ r.2 := Classical.choose_spec (slots p)
  have proper : ∀ p q, cell p = true → cell q = true → clash p q = true → paint p ≠ paint q := by
    intro p q hp hq hc same
    obtain ⟨r, hr, hri, hrRow, hrCol⟩ := hPaint p hp
    obtain ⟨s, hs, hsi, hsRow, hsCol⟩ := hPaint q hq
    rw [same, hsi] at hri
    have equal : s = r := Option.some.inj hri
    subst s
    have h1 := sound r hr (row p) hrRow (col q) hsCol
    have h2 := sound r hr (row q) hsRow (col p) hrCol
    simp [clash, h1, h2] at hc
  have anchorInj : Function.Injective (fun i : Fin 7 => paint (anchor i)) := by
    intro i j same
    by_contra different
    exact proper _ _ (anchor_cell i) (anchor_cell j) (anchor_clash i j different) same
  let small (i : Fin 7) : Fin 9 := Fin.castLE (by decide : 7 ≤ 9) i
  have smallInj : Function.Injective small := by
    intro i j h
    exact Fin.ext (congrArg (fun z : Fin 9 => z.val) h)
  obtain ⟨perm, renames⟩ := Equiv.Perm.exists_extending_pair small
    (fun i : Fin 7 => paint (anchor i)) smallInj anchorInj
  refine ⟨fun p => perm.symm (paint p), ?_, ?_⟩
  · intro p q hp hq hc h
    exact proper p q hp hq hc (perm.symm.injective (Fin.ext h))
  · intro i
    change (perm.symm (paint (anchor i))).val = i.val
    rw [← renames i, perm.symm_apply_apply]
    rfl

