import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_9982

-- Lower bound for a rectangle cover by an exhaustive search that the kernel runs.
-- Each rectangle of a supposed cover is tracked by a hull (a set of rows and a set of columns it is
-- known to contain). The certificate lists, in preorder, the entry each node of the search splits on: that
-- entry must lie in one of the rectangles already tracked (whose hull grows, and must stay inside the
-- colour) or in a new rectangle (allowed only while fewer than the stated number are in use). The kernel
-- replays the tree; a leaf is an entry that fits no tracked rectangle when none is left to open.

def rows : List ℕ := [32256, 29120, 19872, 11104, 5856, 28700, 19482, 10774, 5646, 16793, 8533, 4301, 2355, 1195, 615]

def E (i j : ℕ) : Bool := (rows.getD i 0).testBit j

def RC : ℕ := 1012045315454360172905361713358041908008924197717441927854111620608

def CC : ℕ := 1012045315454360172905361713358041908008924197717441927854111620608

def rc (i : ℕ) : ℕ := (RC >>> (15 * i)) % 2 ^ 15

def cc (j : ℕ) : ℕ := (CC >>> (15 * j)) % 2 ^ 15

abbrev Hull := ℕ × ℕ

def compat (h : Hull) (i j : ℕ) : Bool := (h.2 &&& rc i == h.2) && (h.1 &&& cc j == h.1)

def grow (h : Hull) (i j : ℕ) : Hull := (h.1 ||| 2 ^ i, h.2 ||| 2 ^ j)

def branchC (f : List Hull → List ℕ → Option (List ℕ)) (i j : ℕ) :
    List Hull → List Hull → List ℕ → Option (List ℕ)
  | _, [], s => some s
  | pre, h :: post, s =>
    if compat h i j then
      match f (pre.reverseAux (grow h i j :: post)) s with
      | none => none
      | some s' => branchC f i j (h :: pre) post s'
    else branchC f i j (h :: pre) post s

def run : ℕ → List Hull → List ℕ → Option (List ℕ)
  | 0, _, _ => none
  | _ + 1, _, [] => none
  | fuel + 1, hs, c :: s =>
    if Nat.blt (c / 15) 15 && (rc (c / 15)).testBit (c % 15) then
      match branchC (run fuel) (c / 15) (c % 15) [] hs s with
      | none => none
      | some s' =>
        if Nat.ble 12 hs.length then some s'
        else run fuel ((2 ^ (c / 15), 2 ^ (c % 15)) :: hs) s'
    else none

