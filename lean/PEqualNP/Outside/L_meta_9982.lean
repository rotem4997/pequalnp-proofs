abbrev Rect := Finset (Fin 15) × Finset (Fin 15)

def Sub (h : Hull) (r : Rect) : Prop :=
  (∀ a, h.1.testBit a = true → ∃ ha : a < 15, (⟨a, ha⟩ : Fin 15) ∈ r.1) ∧
  (∀ b, h.2.testBit b = true → ∃ hb : b < 15, (⟨b, hb⟩ : Fin 15) ∈ r.2)

def Mono (r : Rect) : Prop := ∀ i ∈ r.1, ∀ j ∈ r.2, E i.val j.val = true

theorem link : ∀ i : Fin 15, ∀ j : Fin 15,
    (rc i.val).testBit j.val = E i.val j.val ∧ (cc j.val).testBit i.val = E i.val j.val := by
  decide +kernel

theorem runOK : (run 92 [] cert).isSome = true := by
  decide +kernel

theorem compat_of (h : Hull) (r : Rect) (hs : Sub h r) (hm : Mono r) (i : Fin 15) (j : Fin 15)
    (hi : i ∈ r.1) (hj : j ∈ r.2) : compat h i.val j.val = true := by
  unfold compat
  rw [Bool.and_eq_true, beq_iff_eq, beq_iff_eq]
  constructor
  · apply Nat.eq_of_testBit_eq
    intro b
    rw [Nat.testBit_and]
    cases hb : h.2.testBit b with
    | false => rfl
    | true =>
      obtain ⟨hb', hmem⟩ := hs.2 b hb
      have e := hm i hi ⟨b, hb'⟩ hmem
      have l := (link i ⟨b, hb'⟩).1
      simp only [] at e l
      rw [l, e]
      rfl
  · apply Nat.eq_of_testBit_eq
    intro a
    rw [Nat.testBit_and]
    cases ha : h.1.testBit a with
    | false => rfl
    | true =>
      obtain ⟨ha', hmem⟩ := hs.1 a ha
      have e := hm ⟨a, ha'⟩ hmem j hj
      have l := (link ⟨a, ha'⟩ j).2
      simp only [] at e l
      rw [l, e]
      rfl

theorem grow_sub (h : Hull) (r : Rect) (hs : Sub h r) (i : Fin 15) (j : Fin 15)
    (hi : i ∈ r.1) (hj : j ∈ r.2) : Sub (grow h i.val j.val) r := by
  constructor
  · intro a ha
    simp only [grow, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at ha
    rcases ha with ha | ha
    · exact hs.1 a ha
    · subst ha
      exact ⟨i.isLt, hi⟩
  · intro b hb
    simp only [grow, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true, decide_eq_true_eq] at hb
    rcases hb with hb | hb
    · exact hs.2 b hb
    · subst hb
      exact ⟨j.isLt, hj⟩

theorem new_sub (r : Rect) (i : Fin 15) (j : Fin 15) (hi : i ∈ r.1) (hj : j ∈ r.2) :
    Sub ((2 ^ i.val, 2 ^ j.val) : Hull) r := by
  constructor
  · intro a ha
    simp only [Nat.testBit_two_pow, decide_eq_true_eq] at ha
    subst ha
    exact ⟨i.isLt, hi⟩
  · intro b hb
    simp only [Nat.testBit_two_pow, decide_eq_true_eq] at hb
    subst hb
    exact ⟨j.isLt, hj⟩

theorem branch_sound (f : List Hull → List ℕ → Option (List ℕ)) (i : Fin 15) (j : Fin 15) (r : Rect)
    (hm : Mono r) (hi : i ∈ r.1) (hj : j ∈ r.2) :
    ∀ (post pre : List Hull) (rs1 rs2 : List Rect) (s s' : List ℕ),
      branchC f i.val j.val pre post s = some s' →
      List.Forall₂ Sub pre.reverse rs1 → List.Forall₂ Sub post rs2 → r ∈ rs2 →
      ∃ hs' t t', f hs' t = some t' ∧ List.Forall₂ Sub hs' (rs1 ++ rs2) := by
  intro post
  induction post with
  | nil =>
    intro pre rs1 rs2 s s' _ _ h2 hr
    cases h2
    cases hr
  | cons h post ih =>
    intro pre rs1 rs2 s s' hb h1 h2 hr
    cases h2 with
    | cons hh0 hrest =>
      rename_i r0 rs2'
      unfold branchC at hb
      have h1' : List.Forall₂ Sub (h :: pre).reverse (rs1 ++ [r0]) := by
        rw [List.reverse_cons]
        exact List.rel_append h1 (List.Forall₂.cons hh0 List.Forall₂.nil)
      by_cases hr0 : r = r0
      · subst hr0
        have hc := compat_of h r hh0 hm i j hi hj
        rw [if_pos hc] at hb
        cases hf : f (pre.reverseAux (grow h i.val j.val :: post)) s with
        | none =>
          rw [hf] at hb
          cases hb
        | some s1 =>
          refine ⟨_, s, s1, hf, ?_⟩
          rw [List.reverseAux_eq]
          exact List.rel_append h1 (List.Forall₂.cons (grow_sub h r hh0 i j hi hj) hrest)
      · have hr' : r ∈ rs2' := by
          rcases List.mem_cons.mp hr with e | e
          · exact absurd e hr0
          · exact e
        by_cases hc : compat h i.val j.val = true
        · rw [if_pos hc] at hb
          cases hf : f (pre.reverseAux (grow h i.val j.val :: post)) s with
          | none =>
            rw [hf] at hb
            cases hb
          | some s1 =>
            rw [hf] at hb
            obtain ⟨hs', t, t', hc', hf'⟩ := ih (h :: pre) (rs1 ++ [r0]) rs2' s1 s' hb h1' hrest hr'
            exact ⟨hs', t, t', hc', by simpa [List.append_assoc] using hf'⟩
        · rw [if_neg hc] at hb
          obtain ⟨hs', t, t', hc', hf'⟩ := ih (h :: pre) (rs1 ++ [r0]) rs2' s s' hb h1' hrest hr'
          exact ⟨hs', t, t', hc', by simpa [List.append_assoc] using hf'⟩

theorem run_sound (L : List Rect) (hlen : L.length ≤ 12) (hmono : ∀ r ∈ L, Mono r)
    (hcov : ∀ (i : Fin 15) (j : Fin 15), E i.val j.val = true → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) :
    ∀ (fuel : ℕ) (hs : List Hull) (rs : List Rect) (s s' : List ℕ),
      List.Forall₂ Sub hs rs → rs.Subperm L → run fuel hs s = some s' → False := by
  intro fuel
  induction fuel with
  | zero =>
    intro hs rs s s' _ _ h
    simp [run] at h
  | succ fuel ih =>
    intro hs rs s s' hf hsub h
    cases s with
    | nil => simp [run] at h
    | cons c s =>
      unfold run at h
      by_cases hg : (Nat.blt (c / 15) 15 && (rc (c / 15)).testBit (c % 15)) = true
      · rw [if_pos hg] at h
        rw [Bool.and_eq_true, Nat.blt_eq] at hg
        obtain ⟨hi, hbit⟩ := hg
        have hj : c % 15 < 15 := Nat.mod_lt _ (by norm_num)
        have he : E (c / 15) (c % 15) = true := by
          have l := (link ⟨c / 15, hi⟩ ⟨c % 15, hj⟩).1
          simp only [] at l
          rw [← l]
          exact hbit
        obtain ⟨r, hrL, hri, hrj⟩ := hcov ⟨c / 15, hi⟩ ⟨c % 15, hj⟩ he
        cases hb : branchC (run fuel) (c / 15) (c % 15) [] hs s with
        | none =>
          rw [hb] at h
          cases h
        | some s1 =>
          rw [hb] at h
          by_cases hrs : r ∈ rs
          · obtain ⟨hs', t, t', hc', hf'⟩ := branch_sound (run fuel) ⟨c / 15, hi⟩ ⟨c % 15, hj⟩ r
              (hmono r hrL) hri hrj hs [] [] rs s s1 hb List.Forall₂.nil hf hrs
            exact ih hs' rs t t' (by simpa using hf') hsub hc'
          · have hsub' : (r :: rs).Subperm L := List.cons_subperm_of_not_mem_of_mem hrs hrL hsub
            have hl := hsub'.length_le
            have hl2 := hf.length_eq
            simp only [List.length_cons] at hl
            by_cases hfull : Nat.ble 12 hs.length = true
            · rw [Nat.ble_eq] at hfull
              omega
