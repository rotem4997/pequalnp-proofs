  | insert i s hi ih =>
    obtain ⟨a, ha, h⟩ := ih
    refine ⟨a ||| 2 ^ (i : ℕ), Nat.or_lt_two_pow ha (Nat.pow_lt_pow_right (by norm_num) i.isLt), ?_⟩
    intro j
    rw [Finset.mem_insert, h j, Nat.testBit_or, Nat.testBit_two_pow, Bool.or_eq_true,
      decide_eq_true_iff, Fin.val_inj]
    exact ⟨fun h => h.elim (fun h => Or.inr h.symm) Or.inl,
      fun h => h.elim Or.inr (fun h => Or.inl h.symm)⟩

