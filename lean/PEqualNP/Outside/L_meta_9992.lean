    obtain ⟨r, hr, hi, hj⟩ := complete i j yes
    exact ⟨chosen r.1, List.mem_map.mpr ⟨r, hr, rfl⟩, eq ▸ includesRectangle r.1 i hi j (fun a ha => sound r hr a ha j hj)⟩
