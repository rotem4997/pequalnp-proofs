theorem PEqualNP.Outside.L_meta_9992 : ¬ (∃ L : List (Finset (Fin 9) × Finset (Fin 9)), L.length ≤ 6 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([252, 504, 497, 483, 455, 399, 287, 63, 126] : List ℕ).getD i.val 0).testBit j.val = true) ∧ ∀ (i : Fin 9) (j : Fin 9), (([252, 504, 497, 483, 455, 399, 287, 63, 126] : List ℕ).getD i.val 0).testBit j.val = true → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) := by
