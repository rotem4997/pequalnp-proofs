def rows : List Nat := [252,504,497,483,455,399,287,63,126]
def entry (i j : I) := (rows.getD i.val 0).testBit j.val
def pool : List Nat := [0, 0xfc, 0x3f000, 0x1f0f8, 0x7c40000, 0x3c1e0f0, 0x7c3e000, 0xf18000000, 0x70381c0e0, 0xf0783c000, 0xf0f840000, 0x1c7000000000, 0xc40000000c4, 0x1c0e07038000, 0xc06030180c0, 0x1c1e0f040000, 0x1c3e18000000, 0x31e00000000000, 0x1180000000008c, 0x31000000031000, 0x11000000011088, 0x30381c0e040000, 0x10080402010080, 0x30180c06030000, 0x30783c18000000, 0x30f87000000000, 0x10884000000084, 0x47c0000000000000, 0x1c0e070000000000001c, 0x4600000000023000, 0x180c0600000000003018, 0x4440000004440000, 0x10080400000000402010, 0x4400000004422000, 0x40e0703818000000, 0x4020100804020000, 0x406030180c040000, 0x41e0f07000000000, 0x4020100804000000004, 0x43e1e00000000000, 0xc06030180000000000c, 0x4221000000021000, 0x8040201000000001008, 0x1f8000000000000000, 0x3c1e000000000000003c, 0x381c0000000000007038, 0x188000000000c40000, 0x30180000000000c06030, 0x118000000118000000, 0x20100000000100804020, 0x108000000108840000, 0x381c0e07000000000, 0x8040201008040000, 0x180c0603018000000, 0x783c1e00000000000, 0xf87c0000000000000, 0x88440000000440000, 0x7e000000000000000000, 0x7c00000000000000007c, 0x7800000000000000f078, 0x70000000000001c0e070, 0x62000000000310000000, 0x6000000000030180c060, 0x46000000046000000000, 0x44000000044000000044, 0x40000000040201008040, 0x42000000042210000000, 0xe070381c00000000000, 0x2010080402010000000, 0x6030180c06000000000, 0x1e0f0780000000000000, 0x3e1f0000000000000000, 0x22110000000110000000]

def Covered (rs : List Nat) (m : Nat) : Prop :=
  ∀ i : Cell, m.testBit i.val = true → ∃ a ∈ rs, a.testBit i.val = true

def Blocked (k m : Nat) : Prop :=
  ∀ rs : List Nat, rs.length ≤ k → (∀ a ∈ rs, a ∈ pool) → ¬ Covered rs m

theorem initial (m : Nat) (i : Cell) (hi : m.testBit i.val = true) : Blocked 0 m := by
  intro rs size _ cov
  have eq : rs = [] := List.length_eq_zero_iff.mp (by omega)
  obtain ⟨a, ha, _⟩ := cov i hi
  simp [eq] at ha

def residual (s m a : Nat) : Bool := ((s &&& m) == s) && ((s &&& a) == 0)

theorem step (k m : Nat) (p : Cell) (children : List Nat)
    (hp : m.testBit p = true)
    (ready : ∀ s ∈ children, Blocked k s)
    (checked : pool.all (fun a => !(a.testBit p) || children.any (fun s => residual s m a)) = true) :
    Blocked (k+1) m := by
  intro rs size valid cov
  obtain ⟨a, ha, ap⟩ := cov p hp
  have child := List.all_eq_true.mp checked a (valid a ha)
  simp only [ap, Bool.not_true, Bool.false_or] at child
  obtain ⟨s, hs, sub⟩ := List.any_eq_true.mp child
  have e₁ : s &&& m = s := eq_of_beq (Bool.and_eq_true_iff.mp sub).1
  have e₂ : s &&& a = 0 := eq_of_beq (Bool.and_eq_true_iff.mp sub).2
  obtain ⟨u, v, eq⟩ := List.mem_iff_append.mp ha
  subst rs
  apply ready s hs (u ++ v)
  · simp only [List.length_append, List.length_cons] at size ⊢
    omega
  · intro b hb
    apply valid b
    rcases List.mem_append.mp hb with h | h
    · exact List.mem_append_left _ h
    · exact List.mem_append_right _ (List.mem_cons_of_mem _ h)
  · intro i hi
    have h₁ := congrArg (fun x : Nat => x.testBit i) e₁
    have h₂ := congrArg (fun x : Nat => x.testBit i) e₂
    simp only [Nat.testBit_and, hi, Bool.true_and, Nat.zero_testBit] at h₁ h₂
    obtain ⟨b, hb, bi⟩ := cov i h₁
    refine ⟨b, ?_, bi⟩
    rcases List.mem_append.mp hb with hu | hv
    · exact List.mem_append_left _ hu
    · rcases List.mem_cons.mp hv with rfl | hv
      · simp [bi] at h₂
      · exact List.mem_append_right _ hv

theorem readyNil (k : Nat) : ∀ s ∈ ([] : List Nat), Blocked k s := by simp

theorem readyCons {k a : Nat} {l : List Nat} (ha : Blocked k a)
    (hl : ∀ s ∈ l, Blocked k s) : ∀ s ∈ a :: l, Blocked k s := by
  intro s hs
  rcases List.mem_cons.mp hs with rfl | h
  · exact ha
  · exact hl _ h


