  have hh := Nat.allLTTR_eq_true.mp (hv q) (b.val % 206) (Nat.mod_lt _ (by decide))
  have eq : Fin.ofNat 1236 (206*q.val+b.val % 206) = b := by
    apply Fin.ext
    change (206*(b.val/206)+b.val % 206) % 1236 = b.val
