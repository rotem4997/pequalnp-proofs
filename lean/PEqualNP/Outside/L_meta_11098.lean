  Nat.allLTTR 412 fun i _ =>
    let b : B := Fin.ofNat 1236 (412*q+i)
    Nat.blt (tabKV b.val) k.val || parcours (masqueVif b) cs

theorem bandes (k : K) (cs : List (Nat × Nat)) (h : solides (fond k) cs = true)
    (hs : ∀ q : Fin 3, bande k cs q.val = true) : audit (fond k) (permis k) cs = true := by
  apply croise _ _ _ h
  intro m hm
  obtain ⟨b,hb,rfl⟩ := List.mem_map.mp hm
  have hr : k ≤ rang b := of_decide_eq_true (List.mem_filter.mp hb).2
  let q : Fin 3 := ⟨b.val/412,by omega⟩
  have hh := Nat.allLTTR_eq_true.mp (hs q) (b.val % 412) (Nat.mod_lt _ (by decide))
  have eq : Fin.ofNat 1236 (412*q.val+b.val % 412) = b := by
    apply Fin.ext
    change (412*(b.val/412)+b.val % 412) % 1236 = b.val
    rw [show 412*(b.val/412)+b.val % 412 = b.val by omega,Nat.mod_eq_of_lt b.isLt]
  change (Nat.blt (tabKV (Fin.ofNat 1236 (412*q.val+b.val % 412)).val) k.val ||
    parcours (masqueVif (Fin.ofNat 1236 (412*q.val+b.val % 412))) cs) = true at hh
  rw [eq,(valeursV b).1,(valeursV b).2] at hh
  simpa only [Bool.or_eq_true,Nat.blt_eq,show ¬ (rang b).val < k.val from not_lt_of_ge hr,false_or] using hh

