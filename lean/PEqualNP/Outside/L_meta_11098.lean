theorem valeursV (b : B) : masqueVif b = masque b ∧ tabKV b.val = (rang b).val := by
  let q : Fin 6 := ⟨b.val/206,by omega⟩
  have hv : ∀ i : Fin 6, zoneV i.val = true := by
