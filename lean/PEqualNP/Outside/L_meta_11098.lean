theorem geoPetit (x c p : Nat) (hc : c < 2^p) : (x%2)*c < 2^p := by
  exact lt_of_le_of_lt (by simpa using Nat.mul_le_mul_right c (show x%2 ≤ 1 by omega)) hc
theorem geoBorne (p c n x : Nat) (hc : c < 2^p) : repete p c n x < 2^(p*n) := by
  induction n generalizing x with
  | zero => simp [repete]
  | succ n ih =>
    rw [repete, Nat.shiftLeft_eq, Nat.mul_succ, Nat.pow_add]
    calc
      _ < 2^p + repete p c n (x/2) * 2^p := Nat.add_lt_add_right (geoPetit x c p hc) _
      _ = (repete p c n (x/2)+1)*2^p := by rw [Nat.succ_mul, Nat.add_comm]
      _ ≤ _ := Nat.mul_le_mul_right _ (ih (x/2))
theorem geoRepLit (p c n x i : Nat) (hc : c < 2^p) (hi : i < n) (hb : x.testBit i = true) :
    (repete p c n x >>> (p*i)) % 2^p = c := by
  induction n generalizing x i with
  | zero => omega
  | succ n ih =>
    cases i with
    | zero =>
      rw [repete, Nat.mul_zero, Nat.shiftRight_zero, Nat.shiftLeft_eq, Nat.add_mul_mod_self_right,
        Nat.mod_two_eq_one_iff_testBit_zero.mpr hb, Nat.one_mul, Nat.mod_eq_of_lt hc]
    | succ i =>
      rw [Nat.mul_succ, Nat.add_comm (p*i), Nat.shiftRight_add, repete,
        Nat.shiftLeft_eq, Nat.shiftRight_eq_div_pow (_ + _) p, Nat.add_mul_div_right _ _ (Nat.two_pow_pos p),
        Nat.div_eq_of_lt (geoPetit x c p hc), Nat.zero_add]
      exact ih (x/2) i (by omega) ((Nat.testBit_succ x i).symm.trans hb)
theorem lit (b : B) (i : T) (hh : cell b (ti i) (tj i)) : touche (masque b) i := by
  rw [geoMasqueEq]
  have h₁ := geoRepLit (largeur*16) (geoCol b) 16 (mr (cap b)) (ti i).val
    (geoBorne largeur (base-1) 16 (mc (cap b)) (by decide)) (ti i).isLt hh.1
  have h₂ := geoRepLit largeur (base-1) 16 (mc (cap b)) (tj i).val (by decide) (tj i).isLt hh.2
  change (geoMasque b >>> ((largeur*16)*(ti i).val)) % 2^(largeur*16) = geoCol b at h₁
  change chiffre (geoCol b) (tj i).val = base-1 at h₂
  rw [← Nat.and_two_pow_sub_one_eq_mod] at h₁
  have h₃ := congrArg (fun x => chiffre x (tj i).val) h₁
  have h₄ : ∀ j : P, chiffre (2^(largeur*16)-1) j.val = base-1 := by decide +kernel
  simp only [chiffreEt,h₄,h₂] at h₃
  rw [show base = 2^largeur from rfl,Nat.and_two_pow_sub_one_eq_mod] at h₃
  have he : 16*(ti i).val + (tj i).val = i.val := by
    change 16 * (i.val / 16 % 16) + (i.val % 16) = i.val
    have := i.isLt; omega
  have hz : (largeur*16)*(ti i).val + largeur*(tj i).val = largeur*i.val := by
    rw [Nat.mul_assoc, ← Nat.mul_add,he]
  change (((geoMasque b >>> ((largeur*16)*(ti i).val)) >>> (largeur*(tj i).val)) % base) % base = base-1 at h₃
  rw [Nat.mod_mod,← Nat.shiftRight_add,hz] at h₃
  exact h₃
