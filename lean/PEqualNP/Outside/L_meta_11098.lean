def solides (f : Nat) : List (Nat × Nat) → Bool
  | [] => false
  | (w,M)::cs =>
    (w >>> (largeur*256) == 0 && (w &&& plafond == w) && (w &&& f == w)) &&
    (decide (8*M < total w) || solides f cs)

def parcours (m : Nat) : List (Nat × Nat) → Bool
  | [] => true
  | (w,M)::cs =>
    let v := Nat.mod (Nat.land w m) 16777215
    Nat.ble v M && (Nat.blt v (Nat.sub (Nat.mod w 16777215) (Nat.mul 7 M)) || parcours m cs)

theorem croise (f : Nat) (C : List Nat) (cs : List (Nat × Nat))
    (h : solides f cs = true) (s : ∀ m ∈ C, parcours m cs = true) : audit f C cs = true := by
  induction cs generalizing C with
  | nil => contradiction
  | cons p cs ih =>
    rcases p with ⟨w,M⟩
    simp only [solides,Bool.and_eq_true,Bool.or_eq_true] at h
    simp only [parcours,Bool.and_eq_true,Bool.or_eq_true,Nat.ble_eq,Nat.blt_eq] at s
    change ∀ m ∈ C, prix w m ≤ M ∧ (prix w m < total w - 7*M ∨ parcours m cs = true) at s
    simp only [Nat.lt_sub_iff_add_lt] at s
    simp only [audit,Bool.and_eq_true,Bool.or_eq_true,List.all_eq_true,decide_eq_true_eq]
    refine ⟨⟨?_, fun m hm => (s m hm).1⟩, ?_⟩
    · exact ⟨⟨h.1.1.1,leger w (beq_iff_eq.mp h.1.1.2)⟩,h.1.2⟩
    · rcases h.2 with hh|hh
      · exact Or.inl (of_decide_eq_true hh)
      · apply Or.inr; apply ih _ hh
        intro m hm
        obtain ⟨hm,ht⟩ := List.mem_filter.mp hm
        exact ((s m hm).2).resolve_left (Nat.not_lt_of_ge (of_decide_eq_true ht))

