    obtain ⟨b,hb,left,right⟩ := hs _ _ hh
    exact ⟨_,List.mem_map_of_mem hb,by simpa [cell,(invBits b 2 i).1,(invBits b 2 j).2,arr] using And.intro right left⟩
  · simp only [if_neg he] at hh
    obtain ⟨b,hb,left,right⟩ := hs _ _ hh
    exact ⟨_,List.mem_map_of_mem hb,by simpa [cell,(invBits b g i).1,(invBits b g j).2,he] using And.intro left right⟩
