theorem paiement (w : Nat) (h : controle w) (ms : List Nat)
    (hc : ∀ i : T, chiffre w i.val ≠ 0 → ∃ m ∈ ms, touche m i) :
    total w ≤ (ms.map (prix w)).sum := by
  rw [← totalExact w h]
  have aux (i : Nat) (hi : i < 256) : chiffre w i ≤ (ms.map (fun m => chiffre (w &&& m) i)).sum := by
    by_cases z : chiffre w i = 0
    · simp [z]
    obtain ⟨m,hm,hh⟩ := hc ⟨i,hi⟩ z
    have hx : chiffre (w &&& m) i = chiffre w i := by
      rw [chiffreEt,show chiffre m i = base-1 from hh]
      simp [base,Nat.and_two_pow_sub_one_eq_mod,chiffre]
    rw [← hx]
    exact List.single_le_sum (fun _ _ => Nat.zero_le _) _ (List.mem_map_of_mem hm)
  have eqn : (∑ i ∈ Finset.range 256,(ms.map (fun m => chiffre (w &&& m) i)).sum) = (ms.map (prix w)).sum := by
    clear hc aux
    induction ms with
    | nil => simp
    | cons m ms ih =>
      simp only [List.map_cons,List.sum_cons,Finset.sum_add_distrib,ih]
      exact congrArg (· + (ms.map (prix w)).sum) (scoreExact w m h.1 h.2)
  rw [← eqn]; exact Finset.sum_le_sum fun i hi => aux i (Finset.mem_range.mp hi)

theorem borne (w M : Nat) (ms : List Nat) (h : ∀ m ∈ ms, prix w m ≤ M) :
    (ms.map (prix w)).sum ≤ ms.length*M := by
  induction ms with
  | nil => simp
  | cons a l ih =>
    have h₁ := h a (by simp)
    have h₂ := ih (fun m hm => h m (by simp [hm]))
    simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.add_mul,one_mul]; omega
def cumul : Nat → Nat → Nat
  | 0,_ => 0
  | n+1,x => x % base + cumul n (x >>> largeur)
theorem cumulEq (n x : Nat) : cumul n x = somme n x := by
  induction n generalizing x with
  | zero => simp [cumul,somme]
  | succ n ih => rw [cumul,sommeSucc,ih]
def audit (fond : Nat) (C : List Nat) : List (Nat × Nat) → Bool
  | [] => false
  | (w,M)::cs =>
    (w >>> (largeur*256) == 0 && decide (cumul 256 w < base-1) && (w &&& fond == w) &&
      C.all (fun m => decide (prix w m ≤ M))) &&
    (decide (8*M < total w) || audit fond (C.filter fun m => decide (total w ≤ prix w m + 7*M)) cs)
theorem auditSon (fond : Nat) (ms : List Nat) (hl : ms.length ≤ 8)
    (couvert : ∀ i : T, chiffre fond i.val ≠ 0 → ∃ m ∈ ms,touche m i)
    (C : List Nat) (inc : ∀ m ∈ ms, m ∈ C) (cs : List (Nat × Nat)) (h : audit fond C cs = true) : False := by
  induction cs generalizing C with
  | nil => simp [audit] at h
  | cons c cs ih =>
    rcases c with ⟨w,M⟩
    simp only [audit,cumulEq,Bool.and_eq_true,Bool.or_eq_true,beq_iff_eq,decide_eq_true_eq,List.all_eq_true] at h
    obtain ⟨⟨⟨⟨ht,hc⟩,hf⟩,hb⟩,suite⟩ := h
    have cover : ∀ i : T, chiffre w i.val ≠ 0 → ∃ m ∈ ms,touche m i := by
      intro i hi; apply couvert i; intro hh
      have ee := congrArg (fun x => chiffre x i.val) hf
      simp only [chiffreEt,hh,Nat.and_zero] at ee; exact hi ee.symm
    have totalLe := paiement w ⟨ht,hc⟩ ms cover
    have bm : ∀ m ∈ ms, prix w m ≤ M := fun m hm => hb m (inc m hm)
    rcases suite with fin|rec
    · have hle := (borne w M ms bm).trans (Nat.mul_le_mul_right M hl); omega
    · apply ih _ _ rec
      intro m hm; apply List.mem_filter.mpr; refine ⟨inc m hm,decide_eq_true ?_⟩
      obtain ⟨u,v,eq⟩ := List.append_of_mem hm
      subst ms
      have hsum := borne w M (u++v) (fun q hq => bm q (List.mem_append.mpr ((List.mem_append.mp hq).imp id (List.mem_cons_of_mem m))))
      have hlen : (u++v).length ≤ 7 := by simpa using (show u.length+v.length ≤ 7 by simp at hl; omega)
      have hb' := hsum.trans (Nat.mul_le_mul_right M hlen)
      simp only [List.map_append,List.map_cons,List.sum_append,List.sum_cons] at totalLe hb'
      omega


