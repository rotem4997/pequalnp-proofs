theorem residu (n x : Nat) (hn : x >>> (largeur*n) = 0) :
    somme n x % (base-1) = x % (base-1) := by
  induction n generalizing x with
  | zero => simp at hn; simp [hn,somme]
  | succ n ih =>
    have ha : (x >>> largeur) >>> (largeur*n) = 0 := by
      simpa [Nat.shiftRight_add,Nat.mul_add,Nat.add_comm] using hn
    have hb := ih (x >>> largeur) ha
    have hc := Nat.mod_add_div x base
    have hd : x >>> largeur = x/base := Nat.shiftRight_eq_div_pow ..
    rw [sommeSucc,Nat.add_mod,hb,hd]
    conv_rhs => rw [← hc]
    conv_rhs => rw [Nat.add_mod, Nat.mul_mod]
    have hbase : base % (base-1) = 1 := by decide
    rw [hbase,one_mul,Nat.mod_mod]
theorem scoreExact (w m : Nat) (ht : w >>> (largeur*256) = 0) (hl : somme 256 w < base-1) :
    somme 256 (w &&& m) = (w &&& m) % (base-1) := by
  have hd : (w &&& m) >>> (largeur*256) = 0 := by rw [Nat.shiftRight_and_distrib,ht,Nat.zero_and]
  rw [← residu 256 _ hd,Nat.mod_eq_of_lt (lt_of_le_of_lt (sommeEt ..) hl)]
def prix (w m : Nat) := (w &&& m) % (base-1)
def total (w : Nat) := w % (base-1)
def controle (w : Nat) := w >>> (largeur*256) = 0 ∧ somme 256 w < base-1
theorem totalExact (w : Nat) (h : controle w) : somme 256 w = total w := by
