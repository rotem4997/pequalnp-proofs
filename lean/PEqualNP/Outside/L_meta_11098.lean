def repete (pas coef : Nat) : Nat → Nat → Nat
  | 0,_ => 0
  | n+1,x => (x % 2)*coef + ((repete pas coef n (x/2)) <<< pas)
def colonne (b : B) := repete largeur (base-1) 16 (mc (cap b))
def masque (b : B) := repete (16*largeur) 1 16 (mr (cap b)) * colonne b
def fond (k : K) := grille - masque (rep k)
def ti (i : T) : P := Fin.ofNat 16 (i.val/16)
