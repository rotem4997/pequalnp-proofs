def target (x : Fin 6 → Bool) := Nat.testBit (3937069736 * 2 ^ 32 + 3937053352) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)
def posBits : ℕ := 0xb91baebadae9a679658e3
def negBits : ℕ := 0x381b2a9acaa88669218a1
def sample (bank : ℕ) (i : Fin 14) (j : Fin 6) := bank.testBit (6*i.val+j.val)
def inputs : List ℕ := [0x40951ff,0x9a4ae93,0xac62f1c,0xb702fe0,0x1000,0xc001000]
def seeds : List Wire := [(false,0x40951ff),(false,0x9a4ae93),(false,0xac62f1c),(false,0xb702fe0),(false,0x1000),(true,0xc001000)]
set_option maxHeartbeats 10000000 in
theorem listed : ∀ i : Fin 14, seeds.map (read i.val)=List.ofFn (sample posBits i) ∧
    seeds.map (read (14+i.val))=List.ofFn (sample negBits i) := by decide +kernel
set_option maxHeartbeats 4000000 in
theorem labels : ∀ i : Fin 14, target (sample posBits i)=true ∧ target (sample negBits i)=false := by decide +kernel
theorem essential : ∀ a∈inputs, ∃ i : Fin 14, ∀ b∈inputs, b.testBit i.val≠b.testBit (14+i.val) → b=a := by decide +kernel
theorem initial {k S} (live : Live 14 k S) (sub : ∀ a∈S,a∈inputs) : S=inputs.toFinset := by
  apply Finset.Subset.antisymm (fun a ha => List.mem_toFinset.mpr (sub a ha))
  intro a ha
  obtain ⟨i,h⟩ := essential a (List.mem_toFinset.mp ha)
  obtain ⟨b,hb,sep⟩ := liveSeparates live i.val i.isLt
  exact h b (sub b hb) sep ▸ hb
theorem trace (C : Circuit) (fan : FanInTwo C) (eq : circuitFun 6 C=target) :
    ∃ k≤C.gates.countP counted, Live 14 k inputs.toFinset := by
  let final := execute C.gates seeds
  let out := final.getD C.output zero
  have ev (i : ℕ) : read i out = C.eval (seeds.map (read i)) := by
    rw [show read i out = (final.map (read i)).getD C.output false from (read_get i final C.output).symm]
    rw [show final=execute C.gates seeds from rfl,execute_read i _ _ fan];rfl
  have result (x : Fin 6 → Bool) : C.eval (List.ofFn x)=target x := congrFun eq x
  have good : Good 14 out.2 := by
    intro i hi same
    let j : Fin 14 := ⟨i,hi⟩
    have diff : read i out=read (14+i) out := by
      change (out.1 != out.2.testBit i) = (out.1 != out.2.testBit (14+i))
      rw [same]
    have p := ev i;have n := ev (14+i)
    rw [(listed j).1,result,(labels j).1] at p
    rw [(listed j).2,result,(labels j).2] at n
    rw [p,n] at diff;contradiction
  have nz : out.2≠0 := by
    intro z;have bad := good 0 (by decide);simp [z] at bad
  have found : out.2∈ reps final := (get_simple final C.output).resolve_left nz
  obtain ⟨k,S,limit,live,sub⟩ := extract good nz C.gates seeds found
  have keep : ∀ a∈reps seeds, a≠0 → a∈inputs := by decide +kernel
  have stays : ∀ a∈S, a∈inputs := fun a ha => keep a (sub a ha) (liveNonzero live a ha)
  exact ⟨k,limit,initial live stays ▸ live⟩

