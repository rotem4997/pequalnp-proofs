theorem PEqualNP.Outside.L_meta_12262 : ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 6 (fun x : Fin 6 → Bool => Nat.testBit (4269860992 * 2 ^ 32 + 3900735616) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0)) s → ∃ C : PEqualNP.CircuitLowerBounds.Circuit, PEqualNP.MetaComplexity.Monotone2 C ∧ C.size ≤ s ∧ ∀ x : Fin 6 → Bool, C.eval (List.ofFn x) = Nat.testBit (4269860992 * 2 ^ 32 + 3900735616) (∑ i : Fin 6, if x i then 2 ^ (i : ℕ) else 0) :=
  fun s hs => ⟨PEqualNP.Outside.L_meta_12262_aux.wit, PEqualNP.Outside.L_meta_12262_aux.wmono, le_trans PEqualNP.Outside.L_meta_12262_aux.wsize (PEqualNP.Outside.L_meta_12262_aux.lower s hs), PEqualNP.Outside.L_meta_12262_aux.weval⟩
