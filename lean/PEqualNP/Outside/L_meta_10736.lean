  intro rep repMem realRun
  have inNumeric : eW triPack triCfg rep ∈ frozenReps := by
    rw [← frozen_reps_exact]
    exact List.mem_map.mpr ⟨rep,repMem,rfl⟩
  have rejected := List.all_eq_true.mp all_six_reject _ inNumeric
  have notTags (i : Fin 6) : AllTagsLe3 (notState i) := by
    intro w wm
    rcases List.mem_cons.mp wm with rfl | fromRaw
    · exact (by decide : (2 : Nat) ≤ 3)
    · obtain ⟨j,_,rfl⟩ := List.mem_map.mp fromRaw
      exact le_rfl
  have orTags (i j : Fin 6) : AllTagsLe3 (orState i j) := by
    intro w wm
    rcases List.mem_cons.mp wm with rfl | fromRaw
    · exact Nat.zero_le 3
    · obtain ⟨k,_,rfl⟩ := List.mem_map.mp fromRaw
      change (if k=i ∨ k=j then 1 else 3) ≤ 3
      split <;> decide
  have tags : AllTagsLe3 rep := by
    simp [reps] at repMem
    rcases repMem with rfl | rfl | rfl | rfl | rfl | rfl
    · exact notTags 0
    · exact notTags 4
    · exact orTags 0 2
    · exact orTags 0 1
    · exact orTags 0 4
    · exact orTags 4 5
  have accepts := stock_sound tri_cfg_ok 9 (by decide) rep tags realRun
