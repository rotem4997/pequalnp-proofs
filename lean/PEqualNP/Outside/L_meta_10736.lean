private theorem restriction_matches : ∀ x : Fin 6 → Bool,
    target (Function.update (x ∘ withoutTwin) 4 false) = base x := by decide +kernel

private theorem full_lower_of_base (baseLower : ∀ s, HasCircuitSize 6 base s → 11 ≤ s)
    (s : ℕ) (computes : HasCircuitSize 7 target s) : 12 ≤ s := by
  have essential : ∃ x : Fin 7 → Bool, target (Function.update x 4 (!x 4)) ≠ target x :=
    ⟨fun i => decide (i = 0), by decide⟩
  have nonconstant : ∃ x y : Fin 7 → Bool,
      target (Function.update x 4 false) ≠ target (Function.update y 4 false) :=
    ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 2), by decide⟩
  obtain ⟨s', saved, restricted⟩ := q70 6 target 4 false s essential nonconstant computes
  have reindexed := yn withoutTwin _ s' restricted
  change HasCircuitSize 6 (fun x => target (Function.update (x ∘ withoutTwin) 4 false)) s' at reindexed
  rw [funext restriction_matches] at reindexed
  have smaller := baseLower s' reindexed
  omega

theorem replacement (baseLower : ∀ s, HasCircuitSize 6 base s → 11 ≤ s)
    (gates : List Gate) (output : ℕ)
    (legal : ∀ g ∈ gates, (g.op = .and ∨ g.op = .or ∨ g.op = .not) ∧ g.inputs.length ≤ 2)
    (computes : ∀ x, Circuit.eval ⟨gates, output⟩ (List.ofFn x) = target x) :
    ∃ gs : List Gate, ∃ o : ℕ,
      (∀ g ∈ gs, (g.op = .and ∨ g.op = .or) ∧ g.inputs.length ≤ 2) ∧
      gs.length ≤ gates.length ∧ ∀ x, Circuit.eval ⟨gs, o⟩ (List.ofFn x) = target x := by
  have legalBasis : FanInTwo ⟨gates, output⟩ := by
    simpa only [FanInTwo, Set.mem_insert_iff, Set.mem_singleton_iff] using legal
  have lower := full_lower_of_base baseLower gates.length
    ⟨⟨gates, output⟩, legalBasis, le_rfl, computes⟩
  let C := PEqualNP.Outside.L_meta_10736_aux.Upper.circuit
  exact ⟨C.gates, C.output, PEqualNP.Outside.L_meta_10736_aux.Upper.valid, lower,
    PEqualNP.Outside.L_meta_10736_aux.Upper.correct⟩

