theorem base_signed_lower_ten (t : ℕ) (computes : HasCircuitSize 6 graph t) : 10 ≤ t := by
  by_contra! tooSmall
  obtain ⟨size, cap, run⟩ := q88 graph 9 (fun _ => 1) graph_nonconstant graph_depends_on_every_vertex
    (fun i => Or.inr (Or.inl ⟨rfl, false_cofactor_nonconstant i, fun k circuit =>
      all_false_cofactors_at_least_eight i k (by simpa only [graph_eq_base] using circuit)⟩))
    t (by omega) computes
  change TR graph size singleUse at run
  have uses := run.len_le
  have inputCount : singleUse.length = 6 := by simp [singleUse]
  rw [inputCount] at uses
  have asSucc : size = (size - 1) + 1 := by omega
  have once : TR graph ((size - 1) + 1) singleUse := asSucc ▸ run
  have tags : AllTagsLe3 singleUse := by
    intro p h
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp h
    exact by change 1 ≤ 3; omega
  have accepted := wj graphCfg_ok (s := size - 1) (by omega) tags once
  rw [singleUse_eq, cfg_eq_concrete] at accepted
  have excluded := List.all_eq_true.mp singleUseBlocked (size - 1) (List.mem_range.mpr (by omega))
  rw [accepted] at excluded
  exact Bool.false_ne_true excluded

end Stock

