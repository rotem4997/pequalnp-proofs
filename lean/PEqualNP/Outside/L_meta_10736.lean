def endpoints : List ℕ :=
  [0,2,1,3,0,4,1,4,2,4,3,4,0,5,1,5,2,5,3,5,0,6,1,6,2,6,3,6,4,6,5,6]

def target (x : Fin 7 → Bool) : Bool :=
  decide (∃ i < endpoints.length / 2,
    (List.ofFn x).getD (endpoints.getD (2 * i) 0) false = true ∧
    (List.ofFn x).getD (endpoints.getD (2 * i + 1) 0) false = true)

def base (x : Fin 6 → Bool) : Bool :=
  (x 0 && x 2) || (x 1 && x 3) || (x 4 && x 5) ||
    ((x 4 || x 5) && ((x 0 || x 2) || (x 1 || x 3)))

def collapse (x : Fin 7 → Bool) (i : Fin 6) : Bool :=
  if i.val = 4 then x 4 || x 5 else if i.val = 5 then x 6 else x ⟨i.val, by omega⟩

