      rw [ht, encoded] at repMatch
      have permutation := (zv _ _).mp (y5 _ _ repMatch)
      exact rejects rep repMem (TagRun.perm permutation (wp p bijection preserves zrun))
  rw [start_eq_concrete, cfg_eq_concrete, frontier_cover] at pass
  cases pass

end Stock

