open PEqualNP.Outside.L_meta_10736_aux.CheckedSearch

def rawWire (i : Fin 6) : BFn 6 := fun x => x i

def notState (i : Fin 6) : List (BFn 6 × Nat) :=
  (invF (rawWire i),2) :: ((List.finRange 6).filter (· != i)).map (fun j => (rawWire j,3))

def orState (i j : Fin 6) : List (BFn 6 × Nat) :=
  (joinF (rawWire i) (rawWire j),0) :: (List.finRange 6).map (fun k =>
    (rawWire k,if k = i ∨ k = j then 1 else 3))

def reps : List (List (BFn 6 × Nat)) :=
  [notState 0, notState 4, orState 0 2, orState 0 1, orState 0 4, orState 4 5]

def automorphisms : List (List (Nat × Nat)) :=
  [[], [(0,2)], [(1,3)], [(0,2),(1,3)]].flatMap (fun p =>
    [[], [(0,1),(2,3)]].flatMap (fun q =>
      [[], [(4,5)]].map (fun r => p ++ q ++ r)))

def coversRep (words : List (Nat × Nat)) : Bool :=
  automorphisms.any (fun swaps =>
    reps.any (fun rep => jk (wx (q163 6 swaps) (q72 76 words)) (encTTWs 6 rep)))

set_option maxRecDepth 20000 in
set_option maxHeartbeats 0 in
theorem covers_reps : frontier.all coversRep = true := by decide +kernel

set_option maxRecDepth 20000 in
theorem auto_checked :
    automorphisms.all (fun swaps => kq 6 swaps && (ym (q163 6 swaps) (encTT 6 graph) == encTT 6 graph)) =
      true := by decide +kernel

theorem ten_requires_only_reps
    (rejects : ∀ rep ∈ reps, ¬ TR graph 9 rep) :
    ¬ TR graph 10 starts := by
  intro ten
  have safe : AllTagsLe3 starts := by
    intro p mem
    obtain ⟨j,rfl⟩ := List.mem_ofFn.mp mem
    exact le_rfl
  have pass : scanAll graphCfg 9 (eW rowPack graphCfg starts) (fun ws => !frontier.contains ws) = true := by
    apply q17 graphCfg_ok (by decide) safe ten
    intro zs _ zrun
    cases selected : frontier.contains (eW rowPack graphCfg zs) with
    | false => rfl
    | true =>
      exfalso
      have leaf := List.contains_iff_mem.mp selected
      have covered := List.all_eq_true.mp covers_reps _ leaf
      obtain ⟨swaps,swMem,swMatch⟩ := List.any_eq_true.mp covered
      obtain ⟨rep,repMem,repMatch⟩ := List.any_eq_true.mp swMatch
      have auto := List.all_eq_true.mp auto_checked _ swMem
      rw [Bool.and_eq_true,beq_iff_eq] at auto
      obtain ⟨p,bijection,preserves,encoded⟩ := yk (kw graph swaps auto.1 auto.2) zs
      have ht : q72 76 (eW rowPack graphCfg zs) = encTTWs 6 zs := by
        have eq : graphCfg.shTT = 76 := by rw [cfg_eq_concrete]; rfl
        rw [← eq]
