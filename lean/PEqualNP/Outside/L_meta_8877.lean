private lemma isLeastAO_of_minimal (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]
    (C : Circuit) (hMin : IsMinimalMonoCircuit n C) (hAO : IsAO2 n C)
    (hFun : circuitFun n C = graphFun G ∅) : IsLeastAO G C := by
  refine ⟨hAO, hFun, fun C' hAO' hFun' => ?_⟩
  have hMono' : Monotone2 C' := by
    intro g hg
    refine ⟨?_, ?_⟩
    · rcases hAO'.1 g hg with h | h <;> simp [h]
    · have h2 := hAO'.2.2 g hg; omega
  exact hMin.2 C' hMono' (hFun'.trans hFun.symm)

private lemma main_proof (n : ℕ) (G : SimpleGraph (Fin n)) [DecidableRel G.Adj]
    (h4 : NoFourCycle G) (hEne : G.edgeFinset.Nonempty)
    (C : Circuit) (g : ℕ)
    (hMin : IsMinimalMonoCircuit n C) (hAO : IsAO2 n C)
    (hFun : circuitFun n C = graphFun G ∅) (hT : TopForm G C)
    (hPos : 0 < {j : ℕ | j < C.gates.length ∧ (gateAt C j).op = GateOp.and ∧
      ∀ u v : Fin n, G.Adj u v → ¬Owns n C j u v}.ncard)
    (hJunk : junk G C = {g}) :
    ∃ D : Circuit, Monotone2 D ∧ circuitFun n D = graphFun G ∅ ∧ D.size ≤ C.size ∧
      {j : ℕ | j < D.gates.length ∧ (gateAt D j).op = GateOp.and ∧
        ∀ u v : Fin n, G.Adj u v → ¬Owns n D j u v}.ncard <
      {j : ℕ | j < C.gates.length ∧ (gateAt C j).op = GateOp.and ∧
        ∀ u v : Fin n, G.Adj u v → ¬Owns n C j u v}.ncard := by
  classical
  have hL : IsLeastAO G C := isLeastAO_of_minimal n G C hMin hAO hFun
  have ⟨hAcc, hMinCov⟩ := Part1491.main n G C h4 hEne hL hT
  have hCover : ∃ K : Finset (Fin n),
      PEqualNP.MetaComplexity.CoverPromise.IsVertexCover G K ∧
      G.edgeFinset.card + K.card ≤ C.size + 1 := by
    by_cases hU : (Ustar G C).Nonempty
    · obtain ⟨K, hKcov, hKbd⟩ := Part8103.Close.finalCover G C h4 hEne hL hT g hJunk hU
      have hJcard : (junk G C).card = 1 := by simp [hJunk]
      exact ⟨K, hKcov, by omega⟩
    · have hUempty : Ustar G C = ∅ := Finset.not_nonempty_iff_eq_empty.mp hU
      let G' := G.deleteEdges ↑(Ustar G C)
      let covers : Finset (Finset (Fin n)) :=
        Finset.univ.filter fun T => G'.IsVertexCover (T : Set (Fin n))
      have hUnivMem : (Finset.univ : Finset (Fin n)) ∈ covers := by
        simp only [covers, Finset.mem_filter, Finset.mem_univ, true_and]
        intro u v _
        exact Or.inl (Finset.mem_coe.mpr (Finset.mem_univ u))
      obtain ⟨K, hKmem, hKmin⟩ := Finset.exists_min_image covers Finset.card ⟨Finset.univ, hUnivMem⟩
      have hKvc' : G'.IsVertexCover (K : Set (Fin n)) := (Finset.mem_filter.mp hKmem).2
      have hIsMin : IsMinCover G' K :=
        ⟨hKvc', fun T' hT' => hKmin T' (Finset.mem_filter.mpr ⟨Finset.mem_univ T', hT'⟩)⟩
      have hKle : K.card ≤ (tops G C \ centreless G C).card := hMinCov K hIsMin
      have hKcov : PEqualNP.MetaComplexity.CoverPromise.IsVertexCover G K := by
        intro u v huv
        have huv' : G'.Adj u v := by
          simp only [G', hUempty, Finset.coe_empty, SimpleGraph.deleteEdges_empty]
          exact huv
        simpa using hKvc' huv'
      have hUcard : (Ustar G C).card = 0 := by simp [hUempty]
      exact ⟨K, hKcov, by omega⟩
  obtain ⟨K, hKcov, hKbd⟩ := hCover
  obtain ⟨D, hDmono, hDfun, hDsz, hDown⟩ := Part5355.main n G K hKcov
  rw [← SimpleGraph.coe_edgeFinset, Set.ncard_coe_finset] at hDsz
  have hEmpty : {j : ℕ | j < D.gates.length ∧ (gateAt D j).op = GateOp.and ∧
      ∀ u v : Fin n, G.Adj u v → ¬Owns n D j u v} = ∅ := by
    ext j
    simp only [Set.mem_empty_iff_false, iff_false]
    rintro ⟨hj, hand, hno⟩
    obtain ⟨u, v, hadj, hown⟩ := hDown j hj hand
    exact hno u v hadj hown
  refine ⟨D, hDmono, hDfun, by omega, ?_⟩
  rw [hEmpty, Set.ncard_empty]
  exact hPos

