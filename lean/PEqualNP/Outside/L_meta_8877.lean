theorem PEqualNP.Outside.L_meta_8877 :
    ∀ (x1 : ℕ) (x2 : SimpleGraph (Fin x1)) [x3 : DecidableRel x2.Adj],   (∀ (x4 x5 x6 : Fin x1), x2.Adj x4 x5 → x2.Adj x5 x6 → ¬x2.Adj x6 x4) →     PEqualNP.TopForm.NoFourCycle x2 →       x2.edgeFinset.Nonempty →         have x7 : PEqualNP.CircuitLowerBounds.Circuit → ℕ := fun (x7 : PEqualNP.CircuitLowerBounds.Circuit) => {x8 : ℕ | x8 < x7.gates.length ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt x7 x8).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ ∀ (x9 x10 : Fin x1), x2.Adj x9 x10 → ¬PEqualNP.EdgeOwnership.Owns x1 x7 x8 x9 x10}.ncard;         ∀ (x8 : PEqualNP.CircuitLowerBounds.Circuit) (x9 : ℕ), PEqualNP.MetaComplexity.IsMinimalMonoCircuit x1 x8 → PEqualNP.TopForm.IsAO2 x1 x8 → PEqualNP.MetaComplexity.circuitFun x1 x8 = PEqualNP.MetaComplexity.NestedCover.graphFun x2 ∅ → PEqualNP.TopForm.TopForm x2 x8 → (0 : ℕ) < x7 x8 → PEqualNP.TopForm.junk x2 x8 = {x9} → ∃ (x16 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x16 ∧ PEqualNP.MetaComplexity.circuitFun x1 x16 = PEqualNP.MetaComplexity.NestedCover.graphFun x2 ∅ ∧ x16.size ≤ x8.size ∧ x7 x16 < x7 x8 := by
  intro n G _ _ h4 hEne
  dsimp only
  intro C g hMin hAO hFun hT hPos hJunk
  exact PEqualNP.Outside.L_meta_8877.Glue.main_proof n G h4 hEne C g hMin hAO hFun hT hPos hJunk
