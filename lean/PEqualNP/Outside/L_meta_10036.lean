abbrev pcT := Fin 320
def largeur := 24
def base := 2^largeur
def chiffre (x i : Nat) := (x >>> (largeur*i)) % base
def somme (n x : Nat) : Nat := ∑ i ∈ Finset.range n, chiffre x i
theorem chiffreEt (x y i : Nat) : chiffre (x &&& y) i = chiffre x i &&& chiffre y i := by
  unfold chiffre base
  rw [Nat.shiftRight_and_distrib, Nat.and_mod_two_pow]
theorem sommeEt (n x y : Nat) : somme n (x &&& y) ≤ somme n x := by
  apply Finset.sum_le_sum
  intro i hi
  rw [chiffreEt]
  exact Nat.and_le_left
theorem decale (x i : Nat) : chiffre (x >>> largeur) i = chiffre x (i+1) := by
  simp [chiffre, Nat.shiftRight_add, Nat.mul_add, Nat.add_comm]
theorem sommeSucc (n x : Nat) : somme (n+1) x = x % base + somme n (x >>> largeur) := by
  simp only [somme,Finset.sum_range_succ',decale]
  simp [chiffre,Nat.add_comm]
theorem residu (n x : Nat) (hn : x >>> (largeur*n) = 0) :
    somme n x % (base-1) = x % (base-1) := by
  induction n generalizing x with
  | zero => simp at hn; simp [hn,somme]
  | succ n ih =>
    have ha : (x >>> largeur) >>> (largeur*n) = 0 := by
      simpa [Nat.shiftRight_add,Nat.mul_add,Nat.add_comm] using hn
    have hb := ih (x >>> largeur) ha
    have hc := Nat.mod_add_div x base
    have hd : x >>> largeur = x/base := Nat.shiftRight_eq_div_pow ..
    rw [sommeSucc,Nat.add_mod,hb,hd]
    conv_rhs => rw [← hc]
    conv_rhs => rw [Nat.add_mod, Nat.mul_mod]
    have hbase : base % (base-1) = 1 := by decide
    rw [hbase,one_mul,Nat.mod_mod]
theorem scoreExact (w m : Nat) (ht : w >>> (largeur*320) = 0) (hl : somme 320 w < base-1) :
    somme 320 (w &&& m) = (w &&& m) % (base-1) := by
  have hd : (w &&& m) >>> (largeur*320) = 0 := by rw [Nat.shiftRight_and_distrib,ht,Nat.zero_and]
  rw [← residu 320 _ hd,Nat.mod_eq_of_lt (lt_of_le_of_lt (sommeEt ..) hl)]
def prix (w m : Nat) := (w &&& m) % (base-1)
def total (w : Nat) := w % (base-1)
def controle (w : Nat) := w >>> (largeur*320) = 0 ∧ somme 320 w < base-1
theorem totalExact (w : Nat) (h : controle w) : somme 320 w = total w := by
  rw [total,← residu 320 w h.1,Nat.mod_eq_of_lt h.2]
abbrev touche (m : Nat) (i : pcT) := chiffre m i.val = base-1
set_option maxRecDepth 8192 in
theorem paiement (w : Nat) (h : controle w) (ms : List Nat)
    (hc : ∀ i : pcT, chiffre w i.val ≠ 0 → ∃ m ∈ ms, touche m i) :
    total w ≤ (ms.map (prix w)).sum := by
  rw [← totalExact w h]
  have aux (i : Nat) (hi : i < 320) : chiffre w i ≤ (ms.map (fun m => chiffre (w &&& m) i)).sum := by
    by_cases z : chiffre w i = 0
    · simp [z]
    obtain ⟨m,hm,hh⟩ := hc ⟨i,hi⟩ z
    have hx : chiffre (w &&& m) i = chiffre w i := by
      rw [chiffreEt,show chiffre m i = base-1 from hh]
      simp [base,Nat.and_two_pow_sub_one_eq_mod,chiffre]
    rw [← hx]
    exact List.single_le_sum (fun _ _ => Nat.zero_le _) _ (List.mem_map_of_mem hm)
  have eqn : (∑ i ∈ Finset.range 320,(ms.map (fun m => chiffre (w &&& m) i)).sum) = (ms.map (prix w)).sum := by
    clear hc aux
    induction ms with
    | nil => simp
    | cons m ms ih =>
      simp only [List.map_cons,List.sum_cons,Finset.sum_add_distrib,ih]
      exact congrArg (· + (ms.map (prix w)).sum) (scoreExact w m h.1 h.2)
  rw [← eqn]; exact Finset.sum_le_sum fun i hi => aux i (Finset.mem_range.mp hi)

theorem borne (w M : Nat) (ms : List Nat) (h : ∀ m ∈ ms, prix w m ≤ M) :
    (ms.map (prix w)).sum ≤ ms.length*M := by
  induction ms with
  | nil => simp
  | cons a l ih =>
    have h₁ := h a (by simp)
    have h₂ := ih (fun m hm => h m (by simp [hm]))
    simp only [List.map_cons,List.sum_cons,List.length_cons,Nat.add_mul,one_mul]; omega
def cumul : Nat → Nat → Nat
  | 0,_ => 0
  | n+1,x => x % base + cumul n (x >>> largeur)
theorem cumulEq (n x : Nat) : cumul n x = somme n x := by
  induction n generalizing x with
  | zero => simp [cumul,somme]
  | succ n ih => rw [cumul,sommeSucc,ih]
def pcBal {n : Nat} (f : Fin n → Bool) := Nat.allLTTR n (fun i h => f ⟨i,h⟩)
theorem pcExtrait {n : Nat} {f : Fin n → Bool} (h : pcBal f = true) (i : Fin n) : f i = true :=
  Nat.allLTTR_eq_true.mp h i.val i.isLt
def pcLot {n : Nat} [NeZero n] (f : Fin n → Bool) (q : Fin ((n+31)/32)) :=
  pcBal (n:=32) (fun j => f (Fin.ofNat n (32*q.val+j.val)))
theorem pcLots {n : Nat} [NeZero n] {f : Fin n → Bool} (h : ∀ q, pcLot f q = true) : pcBal f = true := by
  apply Nat.allLTTR_eq_true.mpr
  intro i hi
  let q : Fin ((n+31)/32) := ⟨i/32,by omega⟩
  let j : Fin 32 := ⟨i % 32,by omega⟩
  have eq : Fin.ofNat n (32*q.val+j.val) = (⟨i,hi⟩ : Fin n) := by
    apply Fin.ext; change (32*(i/32)+i % 32)%n=i
    rw [show 32*(i/32)+i % 32=i by omega,Nat.mod_eq_of_lt hi]
  have hh := pcExtrait (h q) j
  change f (Fin.ofNat n (32*q.val+j.val)) = true at hh
  rwa [eq] at hh
theorem pcTestUn {n} {p : Fin n → Prop} [DecidablePred p] (h : pcBal (fun i => decide (p i)) = true) : ∀ i,p i :=
  fun i => of_decide_eq_true (pcExtrait h i)
theorem pcTestDeux {n m} {p : Fin n → Fin m → Prop} [∀ i j, Decidable (p i j)]
    (h : pcBal (fun i => pcBal (fun j => decide (p i j))) = true) : ∀ i j,p i j :=
  fun i j => of_decide_eq_true (pcExtrait (pcExtrait h i) j)

def pcRep (pas coef : Nat) : Nat → Nat → Nat
  | 0,_ => 0
  | n+1,x => (x % 2)*coef + ((pcRep pas coef n (x/2)) <<< pas)
def pcCol (b : B) := pcRep largeur (base-1) 20 (mc b)
def pcMasque (b : B) := pcRep (largeur*20) (pcCol b) 16 (mr b)
def pcTi (i : pcT) : P := Fin.ofNat 16 (i.val/20)
def pcTj (i : pcT) : Q := Fin.ofNat 20 i.val
def pcHaut (b : B) : E := Fin.ofNat 48 (tag b)
def pcTestPrix (m : Nat) (b : B) (k : K) :=
  decide (prix (poids k) m ≤ lim k) ||
    ((hauts k).testBit (pcHaut b).val && (sp (pcHaut b) == b))
def pcVerifie (b : B) := pcBal (pcTestPrix (pcMasque b) b)

-- Une répétition place un chiffre par bit du masque source.
theorem pcPetit (x c p : Nat) (hc : c < 2^p) : (x%2)*c < 2^p := by
  exact lt_of_le_of_lt (by simpa using Nat.mul_le_mul_right c (show x%2 ≤ 1 by omega)) hc

theorem pcRepBorne (p c n x : Nat) (hc : c < 2^p) : pcRep p c n x < 2^(p*n) := by
  induction n generalizing x with
  | zero => simp [pcRep]
  | succ n ih =>
    rw [pcRep, Nat.shiftLeft_eq, Nat.mul_succ, Nat.pow_add]
    calc
      _ < 2^p + pcRep p c n (x/2) * 2^p := Nat.add_lt_add_right (pcPetit x c p hc) _
      _ = (pcRep p c n (x/2)+1)*2^p := by rw [Nat.succ_mul, Nat.add_comm]
      _ ≤ _ := Nat.mul_le_mul_right _ (ih (x/2))

theorem pcRepLit (p c n x i : Nat) (hc : c < 2^p) (hi : i < n) (hb : x.testBit i = true) :
    (pcRep p c n x >>> (p*i)) % 2^p = c := by
  induction n generalizing x i with
  | zero => omega
  | succ n ih =>
    cases i with
    | zero =>
      rw [pcRep, Nat.mul_zero, Nat.shiftRight_zero, Nat.shiftLeft_eq, Nat.add_mul_mod_self_right,
        Nat.mod_two_eq_one_iff_testBit_zero.mpr hb, Nat.one_mul, Nat.mod_eq_of_lt hc]
    | succ i =>
      rw [Nat.mul_succ, Nat.add_comm (p*i), Nat.shiftRight_add, pcRep,
        Nat.shiftLeft_eq, Nat.shiftRight_eq_div_pow (_ + _) p, Nat.add_mul_div_right _ _ (Nat.two_pow_pos p),
        Nat.div_eq_of_lt (pcPetit x c p hc), Nat.zero_add]
      exact ih (x/2) i (by omega) ((Nat.testBit_succ x i).symm.trans hb)

theorem pcLit (b : B) (i : pcT) (hr : pcTi i ∈ rs b) (hc : pcTj i ∈ cs b) :
    touche (pcMasque b) i := by
  have h₁ := pcRepLit (largeur*20) (pcCol b) 16 (mr b) (pcTi i).val
    (pcRepBorne largeur (base-1) 20 (mc b) (by decide)) (pcTi i).isLt (Finset.mem_filter.mp hr).2
  have h₂ := pcRepLit largeur (base-1) 20 (mc b) (pcTj i).val (by decide) (pcTj i).isLt
    (Finset.mem_filter.mp hc).2
  change (pcMasque b >>> ((largeur*20)*(pcTi i).val)) % 2^(largeur*20) = pcCol b at h₁
  change chiffre (pcCol b) (pcTj i).val = base-1 at h₂
  rw [← Nat.and_two_pow_sub_one_eq_mod] at h₁
  have h₃ := congrArg (fun x => chiffre x (pcTj i).val) h₁
  have h₄ : ∀ j : Q, chiffre (2^(largeur*20)-1) j.val = base-1 := by decide +kernel
  simp only [chiffreEt,h₄,h₂] at h₃
  rw [show base = 2^largeur from rfl,Nat.and_two_pow_sub_one_eq_mod] at h₃
  have he : 20*(pcTi i).val + (pcTj i).val = i.val := by
    change 20 * (i.val / 20 % 16) + (i.val % 20) = i.val
    have := i.isLt; omega
  have hz : (largeur*20)*(pcTi i).val + largeur*(pcTj i).val = largeur*i.val := by
    rw [Nat.mul_assoc, ← Nat.mul_add,he]
  change (((pcMasque b >>> ((largeur*20)*(pcTi i).val)) >>> (largeur*(pcTj i).val)) % base) % base = base-1 at h₃
  rw [Nat.mod_mod,← Nat.shiftRight_add,hz] at h₃
  exact h₃
