set_option maxHeartbeats 0 in
theorem pcSeuil : ∀ k : K, (10 - (pcFixes k).card) * lim k < total (poids k) := by
  apply pcTestUn
  decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem pcCible : ∀ (k : K) (i : pcT), chiffre (poids k) i.val ≠ 0 →
    zero (pcTi i) (pcTj i) ∧ ((pat k).all fun e =>
      !((mr (sp e)).testBit (pcTi i).val && (mc (sp e)).testBit (pcTj i).val)) = true := by
  apply pcTestDeux
  decide +kernel

theorem franchit (k : K) (s : List B) (hl : s.length ≤ 10) (hc : plein s)
    (hp : ∀ e ∈ pat k, sp e ∈ s) :
    ∃ e : E, (hauts k).testBit e.val = true ∧ sp e ∈ s := by
  by_contra hn
  let a := pcFixes k
  let t := s.toFinset \ a
  let ms := t.toList.map pcMasque
  have ha : a ⊆ s.toFinset := by
    intro b hb
    obtain ⟨e,he,rfl⟩ := Finset.mem_image.mp hb
    exact List.mem_toFinset.mpr (hp e (List.mem_toFinset.mp he))
  have hlen : ms.length ≤ 10 - a.card := by
    have ht : t.card + a.card = s.toFinset.card := Finset.card_sdiff_add_card_eq_card ha
    have hs := s.toFinset_card_le
    simp only [ms, List.length_map, Finset.length_toList]
    omega
  have hpay := paiement (poids k) (pcControle k) ms (by
    intro i hi
    obtain ⟨hz,hf⟩ := pcCible k i hi
    obtain ⟨b,hb,hr,hc'⟩ := hc _ _ hz
    have hb' : b ∉ a := by
      intro h
      obtain ⟨e,he,hbe⟩ := Finset.mem_image.mp h
      subst b
      have hn' := List.all_eq_true.mp hf e (List.mem_toFinset.mp he)
      have hu := (Finset.mem_filter.mp hr).2
      have hv := (Finset.mem_filter.mp hc').2
      simp only [hu,hv,Bool.and_self,Bool.not_true] at hn'
      exact Bool.noConfusion hn'
    have ht : b ∈ t := Finset.mem_sdiff.mpr ⟨List.mem_toFinset.mpr hb,hb'⟩
    exact ⟨pcMasque b,List.mem_map_of_mem (Finset.mem_toList.mpr ht),pcLit b i hr hc'⟩)
  have hbound := borne (poids k) (lim k) ms (by
    intro m hm
    obtain ⟨b,hb,rfl⟩ := List.mem_map.mp hm
    have ht := Finset.mem_sdiff.mp (Finset.mem_toList.mp hb)
    have hv := pcExtrait (f := pcTestPrix (pcMasque b) b) (pcExtrait pcTousPrix b) k
    change (decide (prix (poids k) (pcMasque b) ≤ lim k) ||
      ((hauts k).testBit (pcHaut b).val && (sp (pcHaut b) == b))) = true at hv
    simp only [Bool.or_eq_true,Bool.and_eq_true,decide_eq_true_eq,beq_iff_eq] at hv
    rcases hv with hm|⟨hh,hs⟩
    · exact hm
    · exact False.elim (hn ⟨pcHaut b, hh, by rw [hs]; exact List.mem_toFinset.mp ht.1⟩))
  exact (Nat.not_lt_of_ge (hpay.trans (hbound.trans (Nat.mul_le_mul_right _ hlen)))) (pcSeuil k)

def croise (i : P) : Finset Q := Finset.univ.filter fun j => decide (zero i j)

theorem resteQuinze : ∀ i : P, (croise i).card = 15 := by decide +kernel

def blocBon (a : B) : Bool :=
  Nat.allLTTR 16 fun i _ => !(mr a).testBit i || (mc a &&& rows.getD i 0 == 0)

def regBon (a : B) : Bool :=
  let z := (rs a).card * (cs a).card
  (decide (z ≤ 24) || (z == 30 && sp (Fin.ofNat 48 (tag a)) == a)) &&
    (z != 24 || (cs a).card % 2 == 0)

def pourBlocs {n : Nat} (f : Fin n → Bool) := Nat.allLTTR n fun i hi => f ⟨i,hi⟩

theorem parBlocs {n : Nat} [NeZero n] (f : Fin n → Bool)
    (h : ∀ q : Fin ((n+63)/64), pourBlocs (n:=64) (fun j => f (Fin.ofNat n (64*q.val+j.val))) = true) :
    ∀ i, f i = true := by
  intro i
  let q : Fin ((n+63)/64) := ⟨i.val/64,by have := i.isLt; omega⟩
  let j : Fin 64 := ⟨i.val % 64,by omega⟩
  have hh := Nat.allLTTR_eq_true.mp (h q) j.val j.isLt
  change f (Fin.ofNat n (64*(i.val/64)+i.val % 64)) = true at hh
  convert hh using 2
  apply Fin.ext
  change i.val = (64*(i.val/64)+i.val % 64) % n
  rw [show 64*(i.val/64)+i.val % 64=i.val by omega,Nat.mod_eq_of_lt i.isLt]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem testBlocBon : ∀ b, blocBon b = true := by
  apply parBlocs
  intro q; fin_cases q <;> decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem testRegBon : ∀ b, regBon b = true := by
  apply parBlocs
  intro q; fin_cases q <;> decide +kernel

theorem purs (b : B) (i : P) (hi : i ∈ rs b) (j : Q) (hj : j ∈ cs b) : zero i j := by
  have hh := Nat.allLTTR_eq_true.mp (testBlocBon b) i.val i.isLt
  have h1 : (mr b).testBit i.val = true := by simpa [rs] using hi
  have h2 : (mc b).testBit j.val = true := by simpa [cs] using hj
  have h3 : mc b &&& rows.getD i.val 0 = 0 := by simpa [h1] using hh
  have h4 := congrArg (fun v : Nat => v.testBit j.val) h3
  simpa [Nat.testBit_and,h2,zero] using h4

theorem donneSpecial (s : List B) (hl : s.length ≤ 10) (hc : plein s) : ∃ e : E, sp e ∈ s := by
  have reg (b : B) := testRegBon b
  simp only [regBon,Bool.and_eq_true,Bool.or_eq_true,decide_eq_true_eq,beq_iff_eq] at reg
  obtain ⟨b,hb,ha⟩ := necessiteSpecial rs cs croise resteQuinze
    (fun b i hi j hj => Finset.mem_filter.mpr ⟨Finset.mem_univ _,decide_eq_true (purs b i hi j hj)⟩)
    (fun b => (reg b).1.imp id And.left)
    (by intro b h; have hh := (reg b).2; simp [h] at hh; exact Nat.even_iff.mpr hh)
    s hl (by intro i j hj; exact hc i j (of_decide_eq_true (Finset.mem_filter.mp hj).2))
  rcases (reg b).1 with h|⟨_,h⟩
  · omega
  · exact ⟨_,h.symm ▸ hb⟩

def possible (u : List E) := ∃ s : List B, s.length ≤ 10 ∧ plein s ∧ ∀ e ∈ u, sp e ∈ s

theorem tagSpecial : ∀ e : E, tag (sp e) = e.val := by decide +kernel

theorem spInjective : Function.Injective sp := by
  intro e a h
  apply Fin.ext
  simpa only [tagSpecial] using congrArg tag h

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem zeroSym : ∀ g i j, zero (ir g i) (ic g j) ↔ zero i j := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem lignesSym : ∀ g e i, ir g i ∈ rs (sp e) → i ∈ rs (sp (et g e)) := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem colsSym : ∀ g e j, ic g j ∈ cs (sp e) → j ∈ cs (sp (et g e)) := by decide +kernel

theorem unPas (g : G) (u : List E) (h : possible u) : possible (u.map (et g)) := by
  classical
  obtain ⟨s,hl,hc,hp⟩ := h
  have ex (b : B) : ∃ d : B,
      (∀ i j, ir g i ∈ rs b → ic g j ∈ cs b → i ∈ rs d ∧ j ∈ cs d) ∧
      (∀ e, b = sp e → d = sp (et g e)) := by
    by_cases hb : ∃ e, b = sp e
    · obtain ⟨e,rfl⟩ := hb
      exact ⟨_,fun i j hi hj => ⟨lignesSym g e i hi,colsSym g e j hj⟩,
        fun f hf => congrArg (fun x => sp (et g x)) (spInjective hf)⟩
    · let a := Finset.univ.filter fun i => ir g i ∈ rs b
      let d := Finset.univ.filter fun j => ic g j ∈ cs b
      obtain ⟨t,ht⟩ := ferme a d (by
        intro i hi j hj
        exact (zeroSym g i j).mp (purs b _ (Finset.mem_filter.mp hi).2 _ (Finset.mem_filter.mp hj).2))
      exact ⟨t,fun i j hi hj => ht i (Finset.mem_filter.mpr ⟨Finset.mem_univ _,hi⟩)
        j (Finset.mem_filter.mpr ⟨Finset.mem_univ _,hj⟩),fun e he => False.elim (hb ⟨e,he⟩)⟩
  choose f hf hg using ex
  refine ⟨s.map f,by simpa using hl,?_,?_⟩
  · intro i j hz
    obtain ⟨b,hb,hi,hj⟩ := hc _ _ ((zeroSym g i j).mpr hz)
    exact ⟨_,List.mem_map_of_mem hb,hf b i j hi hj⟩
  · intro e he
    obtain ⟨a,ha,rfl⟩ := List.mem_map.mp he
    rw [← hg (sp a) a rfl]
    exact List.mem_map_of_mem (hp a ha)

def marche : List G → List E → List E
  | [],u => u
  | g::w,u => marche w (u.map (et g))

theorem suitMarche (w : List G) (u : List E) (h : possible u) : possible (marche w u) := by
  induction w generalizing u with
  | nil => exact h
  | cons g w ih => exact ih _ (unPas g u h)

theorem restreint {u v : List E} (h : possible u) (inc : ∀ e ∈ v, e ∈ u) : possible v := by
  obtain ⟨s,hl,hc,hp⟩ := h
  exact ⟨s,hl,hc,fun e he => hp e (inc e he)⟩

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem certificatMotifs : ∀ (k : K) (e : E), (hauts k).testBit e.val = true →
    anterieur k e < k ∧ ∀ a ∈ pat (anterieur k e), a ∈ marche (motifMot k e) (e :: pat k) := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem dernierMotif : ∀ (e : E), ∀ a ∈ pat 14, a ∈ marche (finMot e) [e] := by decide +kernel

theorem barre (k : K) : ¬ possible (pat k) := by
  induction hval : k.val using Nat.strong_induction_on generalizing k with
  | ind n ih =>
    rintro ⟨s,hl,hc,hp⟩
    obtain ⟨e,he,hs⟩ := franchit k s hl hc hp
    obtain ⟨lt,inc⟩ := certificatMotifs k e he
    have p : possible (e :: pat k) := ⟨s,hl,hc,by
      intro a ha
      rcases List.mem_cons.mp ha with rfl|h
      · exact hs
      · exact hp _ h⟩
    exact ih (anterieur k e).val (by rw [← hval]; exact Fin.lt_def.mp lt) _ rfl
      (restreint (suitMarche _ _ p) inc)

theorem aucune (s : List B) (hl : s.length ≤ 10) (hc : plein s) : False := by
  obtain ⟨e,he⟩ := donneSpecial s hl hc
  have p : possible [e] := ⟨s,hl,hc,by simpa using he⟩
  exact barre 14 (restreint (suitMarche _ _ p) (dernierMotif e))

