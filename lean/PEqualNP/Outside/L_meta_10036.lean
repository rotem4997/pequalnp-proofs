private theorem geoCalcul : ∀ i : P,
    Nat.allLTTR (geoNb i.val) (fun n _ => geoValide i.val n) = true := by
  intro i; fin_cases i <;> apply geoBlocs <;> intro q <;> fin_cases q <;> decide +kernel

private theorem geoEtape (i : P) (n : Nat) (hn : n < geoNb i.val) :
    geoPas i.val n < geoNb (i.val+1) ∧ (geoR (geoPas i.val n)).testBit i.val = true ∧
    geoR n &&& geoR (geoPas i.val n) = geoR n ∧
    geoC (geoPas i.val n) = geoC n &&& (1048575 - rows.getD i.val 0) := by
  have hx := Nat.allLTTR_eq_true.mp (geoCalcul i) n hn
  simpa only [geoValide, Bool.and_eq_true, decide_eq_true_eq, beq_iff_eq, and_assoc] using hx

private theorem geoCroissant : ∀ i : P, geoNb i.val ≤ geoNb (i.val+1) := by decide +kernel
private theorem geoInitial : ∀ j : Q, (geoC 0).testBit j.val = true := by decide +kernel
private theorem geoComplement : ∀ (i : P) (j : Q),
    zero i j → (1048575 - rows.getD i.val 0).testBit j.val = true := by decide +kernel

private theorem geoParcours (a : Finset P) (d : Finset Q)
    (hp : ∀ i ∈ a, ∀ j ∈ d, zero i j) (k : Nat) (hk : k ≤ 16) :
    ∃ n, n < geoNb k ∧ (∀ i ∈ a, i.val < k → (geoR n).testBit i.val = true) ∧
      ∀ j ∈ d, (geoC n).testBit j.val = true := by
  induction k with
  | zero => exact ⟨0, by decide, by simp, fun j _ => geoInitial j⟩
  | succ k ih =>
    obtain ⟨n,hn,ha,hd⟩ := ih (by omega)
    let p : P := ⟨k,by omega⟩
    by_cases h : p ∈ a
    · obtain ⟨ht,hr,he,hc⟩ := geoEtape p n hn
      refine ⟨geoPas k n,ht,?_,?_⟩
      · intro i hi hik
        by_cases e : i.val = k
        · have ep : i = p := Fin.ext e
          simpa [ep] using hr
        · have hx := congrArg (fun x : Nat => x.testBit i.val) he
          simpa [Nat.testBit_and, ha i hi (by omega)] using hx
      · intro j hj
        change (geoC (geoPas p.val n)).testBit j.val = true
        rw [hc, Nat.testBit_and, hd j hj, geoComplement p j (hp p h j hj)]
        rfl
    · refine ⟨n,lt_of_lt_of_le hn (geoCroissant p),?_,hd⟩
      intro i hi hik
      apply ha i hi
      have hne : i.val ≠ k := fun he => h ((show i = p from Fin.ext he) ▸ hi)
      omega

private theorem geoSortie (n : Nat) : geoNumero n < 6294 ∨ geoR n = 0 ∨ geoC n = 0 := by
  have hl : geoNumero n < 6296 := Nat.mod_lt _ (by decide)
  by_cases h : geoNumero n < 6294
  · exact Or.inl h
  · have e : geoNumero n = 6294 ∨ geoNumero n = 6295 := by omega
    rcases e with e|e
    · right; left; unfold geoR; rw [e]; decide +kernel
    · right; right; unfold geoC; rw [e]; decide +kernel

theorem ferme (a : Finset P) (d : Finset Q) (hp : ∀ i ∈ a, ∀ j ∈ d, zero i j) :
    ∃ b : B, ∀ i ∈ a, ∀ j ∈ d, i ∈ rs b ∧ j ∈ cs b := by
  obtain ⟨n,hn,ha,hd⟩ := geoParcours a d hp 16 (by decide)
  have hx := geoSortie n
  rcases hx with h|h|h
  · refine ⟨⟨geoNumero n,h⟩,?_⟩
    intro i hi j hj
    exact ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _,ha i hi i.isLt⟩,
           Finset.mem_filter.mpr ⟨Finset.mem_univ _,hd j hj⟩⟩
  · refine ⟨0,?_⟩
    intro i hi j hj
    have hf := ha i hi i.isLt
    simp [h] at hf
  · refine ⟨0,?_⟩
    intro i hi j hj
    have hf := hd j hj
    simp [h] at hf

theorem normalise (L : List (Finset P × Finset Q))
    (hp : ∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, zero i j)
    (hc : ∀ i j, zero i j → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) :
    ∃ s : List B, s.length ≤ L.length ∧ plein s := by
  classical
  let f : Finset P × Finset Q → B := fun r =>
    if h : r ∈ L then (ferme r.1 r.2 (hp r h)).choose else 0
  refine ⟨L.map f, by simp, ?_⟩
  intro i j hz
  obtain ⟨r,hr,hi,hj⟩ := hc i j hz
  refine ⟨f r,List.mem_map_of_mem hr,?_⟩
  simpa only [f, dite_eq_left hr] using (ferme r.1 r.2 (hp r hr)).choose_spec i hi j hj

theorem necessiteSpecial {B : Type} [DecidableEq B]
    (rs : B → Finset (Fin 16)) (cs : B → Finset (Fin 20))
    (Z : Fin 16 → Finset (Fin 20)) (taille : ∀ i, (Z i).card = 15)
    (pur : ∀ b i, i ∈ rs b → cs b ⊆ Z i)
    (petit : ∀ b, (rs b).card * (cs b).card ≤ 24 ∨ (rs b).card * (cs b).card = 30)
    (pair24 : ∀ b, (rs b).card * (cs b).card = 24 → Even (cs b).card)
    (s : List B) (hl : s.length ≤ 10)
    (couvre : ∀ i j, j ∈ Z i → ∃ b ∈ s, i ∈ rs b ∧ j ∈ cs b) :
    ∃ b ∈ s, (rs b).card * (cs b).card = 30 := by
  classical
  by_contra h
  -- Les indices de la liste préservent les multiplicités.
  let aire (k : Fin s.length) := (rs (s.get k)).card * (cs (s.get k)).card
  let sectionLigne (i : Fin 16) (k : Fin s.length) : Finset (Fin 20) :=
    if i ∈ rs (s.get k) then cs (s.get k) else ∅
  let largeur (i : Fin 16) := ∑ k : Fin s.length, (sectionLigne i k).card
  have hborne (k : Fin s.length) : aire k ≤ 24 := by
    rcases petit (s.get k) with hk | hk
    · exact hk
    · exact (h ⟨s.get k, List.get_mem s k, hk⟩).elim
  have hunion (i : Fin 16) :
      (Finset.univ : Finset (Fin s.length)).biUnion (sectionLigne i) = Z i := by
    ext j
    simp only [Finset.mem_biUnion, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨k, hj⟩
      by_cases hi : i ∈ rs (s.get k)
      · exact pur (s.get k) i hi (by simpa only [sectionLigne, ite_eq_left hi] using hj)
      · simp only [sectionLigne, ite_eq_right hi, Finset.notMem_empty] at hj
    · intro hj
      obtain ⟨b, hb, hi, hjb⟩ := couvre i j hj
      obtain ⟨k, rfl⟩ := List.mem_iff_get.mp hb
      exact ⟨k, by simpa only [sectionLigne, ite_eq_left hi] using hjb⟩
  have hligne (i : Fin 16) : 15 ≤ largeur i := by
    rw [← taille i, ← hunion i]
    exact Finset.card_biUnion_le
  -- Double comptage des cases, avec multiplicité de couverture.
  have htotal : (∑ i : Fin 16, largeur i) = ∑ k : Fin s.length, aire k := by
    unfold largeur
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro k _
    calc
      (∑ i : Fin 16, (sectionLigne i k).card) =
          ∑ i : Fin 16, if i ∈ rs (s.get k) then (cs (s.get k)).card else 0 := by
            apply Finset.sum_congr rfl
            intro i _
            by_cases hi : i ∈ rs (s.get k)
            · simp only [sectionLigne, ite_eq_left hi]
            · simp only [sectionLigne, ite_eq_right hi, Finset.card_empty]
      _ = aire k := by
        rw [Finset.sum_ite_mem_eq]
        simp [aire]
  have hbas : 240 ≤ ∑ i : Fin 16, largeur i := by
    calc
      240 = ∑ _i : Fin 16, (15 : ℕ) := by simp
      _ ≤ ∑ i : Fin 16, largeur i := Finset.sum_le_sum fun i _ => hligne i
  have hconst : (∑ _k : Fin s.length, (24 : ℕ)) ≤ 240 := by
    simp
    omega
  have hhaut : (∑ i : Fin 16, largeur i) ≤ 240 := by
    rw [htotal]
    exact (Finset.sum_le_sum fun k _ => hborne k).trans hconst
  have haire (k : Fin s.length) : aire k = 24 := by
    by_contra hn
    have hk : aire k < 24 := lt_of_le_of_ne (hborne k) hn
    have hs : (∑ l : Fin s.length, aire l) < ∑ _l : Fin s.length, (24 : ℕ) :=
      Finset.sum_lt_sum (fun l _ => hborne l) ⟨k, Finset.mem_univ k, hk⟩
    rw [← htotal] at hs
    exact (not_lt_of_ge hbas) (hs.trans_le hconst)
  have hzero : largeur 0 = 15 := by
    by_contra hn
    have hi : 15 < largeur 0 := lt_of_le_of_ne (hligne 0) (Ne.symm hn)
    have hs : (∑ _i : Fin 16, (15 : ℕ)) < ∑ i : Fin 16, largeur i :=
      Finset.sum_lt_sum (fun i _ => hligne i) ⟨0, Finset.mem_univ _, hi⟩
    exact (not_lt_of_ge hhaut) (by simpa using hs)
  have hpair : Even (largeur 0) := by
    unfold largeur
    refine Finset.even_sum _ fun k _ => ?_
    by_cases hk : (0 : Fin 16) ∈ rs (s.get k)
    · simpa only [sectionLigne, ite_eq_left hk] using pair24 (s.get k) (haire k)
    · simpa only [sectionLigne, ite_eq_right hk, Finset.card_empty] using
        (show Even (0 : ℕ) from ⟨0, rfl⟩)
  rw [hzero] at hpair
  exact (by decide : ¬ Even (15 : ℕ)) hpair

