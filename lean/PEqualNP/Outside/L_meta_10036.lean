theorem pcTousPrix : pcBal pcVerifie = true := by
  apply pcLots
  intro q; fin_cases q <;> decide +kernel

def pcFixes (k : K) : Finset B := (pat k).toFinset.image sp

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem pcControle (k : K) : controle (poids k) := by
  have H : ∀ k : K, poids k >>> (largeur*320) = 0 ∧ cumul 320 (poids k) < base-1 := by
    apply pcTestUn
    decide +kernel
  simpa only [controle,cumulEq] using H k

