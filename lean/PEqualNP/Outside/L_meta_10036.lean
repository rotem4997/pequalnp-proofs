-- Les états d'une couche représentent les intersections distinctes des lignes déjà traitées.
-- Passer une ligne conserve l'état ; l'ajouter utilise l'entrée correspondante de geoSucc.
private def geoR (n : Nat) := geoLignes (geoNumero n)
private def geoC (n : Nat) := geoColonnes (geoNumero n)
private def geoPas (i n : Nat) := geoSucc (geoDebut i + n)
private def geoValide (i n : Nat) : Bool :=
  let t := geoPas i n
  t < geoNb (i+1) && (geoR t).testBit i && (geoR n &&& geoR t == geoR n) &&
    (geoC t == geoC n &&& (1048575 - rows.getD i 0))

private theorem geoBlocs {n : Nat} {f : Nat → Bool} (h : ∀ q : Fin ((n+63)/64),
    Nat.allLTTR 64 (fun j _ => decide (64*q.val+j ≥ n) || f (64*q.val+j)) = true) :
    Nat.allLTTR n (fun i _ => f i) = true := by
  apply Nat.allLTTR_eq_true.mpr
  intro i hi
  let q : Fin ((n+63)/64) := ⟨i/64,by omega⟩
  have e : 64*q.val+i % 64 = i := by dsimp [q]; omega
  have hx := Nat.allLTTR_eq_true.mp (h q) (i % 64) (Nat.mod_lt _ (by decide))
  simpa [e, Nat.not_le_of_lt hi] using hx

