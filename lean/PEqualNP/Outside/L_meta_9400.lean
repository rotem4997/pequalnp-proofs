theorem globalPrices : ∀ k : Box, charge k ≤ 288 := by decide +kernel

theorem noSmall (S : Finset Box) (small : S.card ≤ 25)
    (all : ∀ p q, zero p q → ∃ k ∈ S, covered k p q) : False := by
  have each (p : Pt) : 240 ≤ ∑ k ∈ S, (localPrice (shapeAt p k) + localPrice (shapeAt p (dual k))) := by
    have left := weightedCover S (shapeAt p) (fun j => by
      obtain ⟨k,hk,hh⟩ := all p (neighbor p j) (neighborZero p j).1
      exact ⟨k,hk,localMembership hh⟩)
    have right := weightedCover S (fun k => shapeAt p (dual k)) (fun j => by
      obtain ⟨k,hk,hh⟩ := all (neighbor p j) p (neighborZero p j).2
      exact ⟨k,hk,localMembership (swapCovered k p (neighbor p j) hh)⟩)
    rw [Finset.sum_add_distrib]
    omega
  have lo : 7440 ≤ ∑ k ∈ S, charge k := calc
    7440 = ∑ _ : Pt, (240:ℕ) := by decide +kernel
    _ ≤ _ := Finset.sum_le_sum (fun p _ => each p)
    _ = _ := by rw [Finset.sum_comm]; rfl
  have hi := Finset.sum_le_sum (s := S) (fun k _ => globalPrices k)
  simp only [Finset.sum_const, Nat.nsmul_eq_mul] at hi
  omega

