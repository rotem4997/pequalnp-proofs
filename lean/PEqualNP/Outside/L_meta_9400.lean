theorem growFacts (e : Cap) (p : Pt) : member (capRows (grow e p)) p ∧
    capRows e &&& capRows (grow e p) = capRows e ∧
    capCols (grow e p) = capCols e ^^^ (capCols e &&& rowMask (p.val+1)) := by
  have ok := span_ok growAll e.val (Nat.zero_le _) e.isLt
  unfold checkState at ok
  have he : Fin.ofNat 374 e.val = e := by apply Fin.ext; exact Nat.mod_eq_of_lt e.isLt
  rw [he] at ok
  exact of_decide_eq_true (List.all_eq_true.mp ok p (by simp))

theorem initial : ∀ q : Pt, member (capCols 372) q := by decide +kernel
theorem adds (e : Cap) (p : Pt) : member (capRows (grow e p)) p := (growFacts e p).1
theorem preserves (e : Cap) (p i : Pt) (h : member (capRows e) i) : member (capRows (grow e p)) i := by
  have hb := congrArg (fun m : Nat => m.testBit (i.val+1)) (growFacts e p).2.1
  change (capRows e).testBit (i.val+1) = true at h
  simpa only [Nat.testBit_and, h, Bool.true_and] using hb

theorem intersects (e : Cap) (p j : Pt) (h : member (capCols e) j) (hz : zero p j) : member (capCols (grow e p)) j := by
  change (capCols (grow e p)).testBit (j.val+1) = true
  change (rowMask (p.val+1)).testBit (j.val+1) = false at hz
  change (capCols e).testBit (j.val+1) = true at h
  rw [(growFacts e p).2.2, Nat.testBit_xor, Nat.testBit_and, hz, h]
  rfl

def project (e : Cap) : Box := Fin.ofNat 372 e.val
theorem capCases : ∀ e : Cap, capRows e = 1 ∨ capCols e = 1 ∨
    (capRows e = rows (project e) ∧ capCols e = cols (project e)) := by decide +kernel
theorem emptyMask : ∀ p : Pt, ¬ member 1 p := by decide +kernel
theorem proper (e : Cap) (p q : Pt) (hp : member (capRows e) p) (hq : member (capCols e) q) : covered (project e) p q := by
  rcases capCases e with h | h | ⟨a,b⟩
  · exact (emptyMask p (h ▸ hp)).elim
  · exact (emptyMask q (h ▸ hq)).elim
  · exact ⟨a ▸ hp, b ▸ hq⟩

theorem closure (a b : Finset Pt) (clean : ∀ p∈a,∀ q∈b,zero p q) :
    ∃ e : Cap,(∀ p∈a,member (capRows e) p) ∧ (∀ q∈b,member (capCols e) q) := by
  classical
  induction a using Finset.induction_on with
  | empty => exact ⟨372,by simp,fun q _ => initial q⟩
  | @insert p a fresh ih =>
    obtain ⟨e,hr,hc⟩ := ih (fun i hi => clean i (Finset.mem_insert_of_mem hi))
    refine ⟨grow e p,?_,fun q hq => intersects e p q (hc q hq) (clean p (Finset.mem_insert_self p a) q hq)⟩
    intro i hi
    rcases Finset.mem_insert.mp hi with rfl|h
    · exact adds e i
    · exact preserves e p i (hr i h)
def orig (p : Pt) : Fin 32 := ⟨p.val+1,by have := p.isLt;omega⟩
def trim (s : Finset (Fin 32)) := Finset.univ.filter fun p : Pt => orig p∈s
theorem inside (s : Finset (Fin 32)) (p : Pt) : p∈trim s ↔ orig p∈s := by simp [trim]
abbrev Rect := Finset (Fin 32) × Finset (Fin 32)
def pure (r : Rect) := ∀ i∈r.1,∀ j∈r.2,(rowMask i.val).testBit j.val=false
theorem extendBox (r : Rect) (hp : pure r) :
    ∃ k : Box,∀ p q,orig p∈r.1 → orig q∈r.2 → covered k p q := by
  obtain ⟨e,left,right⟩ := closure (trim r.1) (trim r.2)
    (fun p h q hq => hp (orig p) ((inside _ _).mp h) (orig q) ((inside _ _).mp hq))
  exact ⟨project e,fun p q h hq => proper e p q (left p ((inside _ _).mpr h)) (right q ((inside _ _).mpr hq))⟩
theorem normalize (l : List Rect) (good : ∀ r∈l,pure r) :
    ∃ S : Finset Box,S.card≤l.length ∧ ∀ r∈l,∀ p q,orig p∈r.1 → orig q∈r.2 → ∃ k∈S,covered k p q := by
  induction l with
  | nil => exact ⟨∅,by simp,by simp⟩
  | cons r rs ih =>
    obtain ⟨k,hk⟩ := extendBox r (good r (List.mem_cons_self ..))
    obtain ⟨S,size,hh⟩ := ih (fun s hs => good s (List.mem_cons_of_mem r hs))
    refine ⟨insert k S,?_,?_⟩
    · have := Finset.card_insert_le k S
      simp only [List.length_cons]
      omega
    · intro s hs p q hp hq
      rcases List.mem_cons.mp hs with rfl|tail
      · exact ⟨k,Finset.mem_insert_self ..,hk _ _ hp hq⟩
      · obtain ⟨t,ht,h⟩ := hh s tail p q hp hq
        exact ⟨t,Finset.mem_insert_of_mem ht,h⟩

