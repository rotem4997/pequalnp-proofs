    ((Finset.univ : Finset Point4) \ pointsOf v).card = 8 := by decide +kernel

theorem weightedCover {K : Type} [DecidableEq K] (S : Finset K) (shape : K → LocalShape)
    (hcov : ∀ j : Point4, ∃ k ∈ S, j ∈ pointsOf (shape k)) :
    120 ≤ ∑ k ∈ S, localPrice (shape k) := by
  classical
  by_cases hfull : ∃ k ∈ S, localPrice (shape k) = 120
  · obtain ⟨k,hk,he⟩ := hfull
    have h := Finset.single_le_sum (f := fun u => localPrice (shape u)) (fun u _ => Nat.zero_le _) hk
    simpa only [he] using h
  have hn (k : K) (hk : k ∈ S) : localPrice (shape k) ≠ 120 := fun h => hfull ⟨k,hk,h⟩
  by_cases hplane : ∃ v ∈ S, localPrice (shape v) = 40
  · obtain ⟨v,hv,hprice⟩ := hplane
    let out (k : K) := (pointsOf (shape k)) \ (pointsOf (shape v))
    have hsub : ((Finset.univ : Finset Point4) \ pointsOf (shape v)) ⊆ (S.erase v).biUnion out := by
      intro j hj
      obtain ⟨k,hk,hj'⟩ := hcov j
      have hvj := (Finset.mem_sdiff.mp hj).2
      have hne : k ≠ v := fun h => hvj (h ▸ hj')
      exact Finset.mem_biUnion.mpr ⟨k,Finset.mem_erase.mpr ⟨hne,hk⟩,Finset.mem_sdiff.mpr ⟨hj',hvj⟩⟩
    have hcount := (Finset.card_le_card hsub).trans (Finset.card_biUnion_le ..)
    rw [outsideSize _ hprice] at hcount
    have bound := Finset.sum_le_sum (s := S.erase v) (fun k hk =>
      outsidePrice _ _ hprice (hn k (Finset.mem_of_mem_erase hk)))
    change (∑ k ∈ S.erase v,10*(out k).card) ≤ _ at bound
    rw [← Finset.mul_sum] at bound
    have split := Finset.sum_erase_add S (fun u => localPrice (shape u)) hv
    omega
  · have hsub : (Finset.univ : Finset Point4) ⊆ S.biUnion (fun k => pointsOf (shape k)) := by
      intro j _
      exact Finset.mem_biUnion.mpr (hcov j)
    have hcount := (Finset.card_le_card hsub).trans (Finset.card_biUnion_le ..)
    simp only [Finset.card_univ,Fintype.card_fin] at hcount
    have bound := Finset.sum_le_sum (s := S) (fun k hk =>
      smallPrice (shape k) (fun h => hplane ⟨k,hk,h⟩) (hn k hk))
    rw [← Finset.mul_sum] at bound
    omega


