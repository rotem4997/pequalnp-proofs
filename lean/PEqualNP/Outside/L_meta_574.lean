namespace PEqualNP.MetaComplexity.PathCircuitEdgeFn

theorem ml_of_front (hFront : StmtFront) : StmtML :=
  stmtML stmtAnd (stmtExt stmtLift stmtXMove hFront stmtWin (stmtTwo stmtExch stmtWin))

