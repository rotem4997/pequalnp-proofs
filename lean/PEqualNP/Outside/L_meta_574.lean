-- Shared results from PEqualNP.MetaComplexity.Helpers.EdgeFnFront.

namespace PEqualNP.MetaComplexity.PathCircuitEdgeFn

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.MetaComplexity.PathCircuitHelpers

open PEqualNP.MetaComplexity.PathCircuitHelpers.Readers

theorem front_suppsFrom_prefix {m : ℕ} (gs : List Gate) :
    ∀ L : List (Finset (Fin m)), ∃ T, suppsFrom gs L = L ++ T := by
  induction gs with
  | nil => intro L; exact ⟨[], by simp [suppsFrom]⟩
  | cons g gs ih =>
    intro L
    obtain ⟨T, hT⟩ := ih (L ++ [gateSupp L g])
    exact ⟨[gateSupp L g] ++ T, by
      show suppsFrom gs (L ++ [gateSupp L g]) = _
      rw [hT, List.append_assoc]⟩

theorem front_supp_input {m : ℕ} (gs : List Gate) (i : ℕ) (hi : i < m) :
    (suppsFrom gs (inputSupps m)).getD i ∅ = {(⟨i, hi⟩ : Fin m)} := by
  obtain ⟨T, hT⟩ := front_suppsFrom_prefix gs (inputSupps m)
  rw [hT, List.getD_append _ _ _ _ (by simp [inputSupps]; exact hi)]
  simp [inputSupps, hi]

theorem front_supp_beyond {m : ℕ} (gs : List Gate) (w : ℕ) (hw : m + gs.length ≤ w) :
    (suppsFrom gs (inputSupps m)).getD w ∅ = ∅ :=
  List.getD_eq_default _ _ (by rw [length_suppsFrom]; simp [inputSupps]; omega)

theorem front_supp_gate {m : ℕ} (gs : List Gate) (hcl : CleanL m gs) (p : ℕ) (g : Gate)
    (hp : gs[p]? = some g) (i : Fin m) :
    i ∈ (suppsFrom gs (inputSupps m)).getD (m + p) ∅ ↔
      ∃ a ∈ g.inputs, i ∈ (suppsFrom gs (inputSupps m)).getD a ∅ := by
  have hlt := (hcl p g hp).lt
  obtain ⟨pre, post, rfl, rfl⟩ := split_at gs p g hp
  set L0 := suppsFrom pre (inputSupps m) with hL0
  have hl0 : L0.length = m + pre.length := by rw [hL0, length_suppsFrom]; simp [inputSupps]
  have e : suppsFrom (pre ++ g :: post) (inputSupps m)
      = suppsFrom post (L0 ++ [gateSupp L0 g]) := by
    rw [suppsFrom_append]; rfl
  obtain ⟨T, hT⟩ := front_suppsFrom_prefix post (L0 ++ [gateSupp L0 g])
  have full : ∀ j, j < m + pre.length →
      (suppsFrom (pre ++ g :: post) (inputSupps m)).getD j ∅ = L0.getD j ∅ := by
    intro j hj
    rw [e, hT, List.getD_append _ _ _ _ (by simp [hl0]; omega), getD_snoc_ne _ _ _ _ (by omega)]
  have top : (suppsFrom (pre ++ g :: post) (inputSupps m)).getD (m + pre.length) ∅
      = gateSupp L0 g := by
    rw [e, hT, List.getD_append _ _ _ _ (by simp [hl0]), ← hl0, getD_snoc_eq]
  rw [top, mem_gateSupp]
  constructor
  · rintro ⟨a, ha, hia⟩
    exact ⟨a, ha, by rw [full a (hlt a ha)]; exact hia⟩
  · rintro ⟨a, ha, hia⟩
    exact ⟨a, ha, by rw [← full a (hlt a ha)]; exact hia⟩

section

variable {n : ℕ} {F : (Fin (n + 1) → Bool) → Bool} {D : Finset (Fin (n + 1))} {gs : List Gate}
  {o : ℕ}

theorem front_nlit (DH : DeepHyp F D) {y : Fin (n + 1)} (hy : y ∈ D) (c : Bool) :
    ¬ ∀ u, F u = xor (u y) c := by
  intro h
  obtain ⟨x, x', hx⟩ := DH.nc y hy false
  apply hx
  rw [h, h]
  simp

theorem front_fnc (DH : DeepHyp F D) {y : Fin (n + 1)} (hy : y ∈ D) :
    ∃ x x' : Fin (n + 1) → Bool, F x ≠ F x' := by
  obtain ⟨x, x', hx⟩ := DH.nc y hy false
  exact ⟨_, _, hx⟩

theorem front_dep (DH : DeepHyp F D) (L : Least (n + 1) F gs o) {y : Fin (n + 1)} (hy : y ∈ D) :
    y ∈ (suppsFrom gs (inputSupps (n + 1))).getD o ∅ := by
  have hz : zeroOn D (fun _ : Fin (n + 1) => false) = fun _ => false := by
    funext i; simp [zeroOn]
  obtain ⟨x', -, -, hF0, hF1⟩ := DH.win y hy (fun _ => false) (by rw [hz]; exact DH.zero)
  by_contra hno
  have hag := (agree_wiresFrom (Function.update x' y true) x' gs _ _ _
    (agree_inputs _ _)).2.2 o (by
      intro k hk
      have : k ≠ y := fun e => hno (e ▸ hk)
      simp [Function.update_of_ne this])
  have e : F (Function.update x' y true) = F x' := by
    rw [← L.hev, ← L.hev]
    exact hag
  rw [hF0, hF1] at e
  cases e

theorem front_dlit (L : Least (n + 1) F gs o) (hfnc : ∃ x x' : Fin (n + 1) → Bool, F x ≠ F x')
    (p0 : ℕ) (hmin : ∀ r < p0, ∀ g, gs[r]? = some g → (g.op = GateOp.and ∨ g.op = GateOp.or) →
      ∀ i ∈ D, i ∉ (suppsFrom gs (inputSupps (n + 1))).getD (n + 1 + r) ∅) :
    ∀ w, w < n + 1 + p0 → (∃ i ∈ D, i ∈ (suppsFrom gs (inputSupps (n + 1))).getD w ∅) →
      ∃ y ∈ D, ∃ c : Bool, (∀ u, vl gs u w = xor (u y) c) ∧
        (w = y ∨ ∃ pn, pn < p0 ∧ w = n + 1 + pn ∧ gs[pn]? = some ⟨GateOp.not, [(y : ℕ)]⟩) := by
  intro w
  induction w using Nat.strong_induction_on with
  | _ w ih =>
    rintro hw ⟨i, hi, his⟩
    by_cases hwn : w < n + 1
    · rw [front_supp_input gs w hwn, Finset.mem_singleton] at his
      subst his
      exact ⟨⟨w, hwn⟩, hi, false, fun u => by rw [vl_input gs u w hwn]; simp, Or.inl rfl⟩
    · obtain ⟨r, rfl⟩ : ∃ r, w = n + 1 + r := ⟨w - (n + 1), by omega⟩
      cases hg : gs[r]? with
      | none =>
        have hlen : gs.length ≤ r := List.getElem?_eq_none_iff.1 hg
        rw [front_supp_beyond gs _ (by omega)] at his
        simp at his
      | some g =>
        have hrl : r < gs.length := (List.getElem?_eq_some_iff.1 hg).1
        rcases L.hcl r g hg with ⟨hop, j, hj, hin⟩ | ⟨hop, _⟩
        · obtain ⟨a, ha, hia⟩ := (front_supp_gate gs L.hcl r g hg i).1 his
          rw [hin, List.mem_singleton] at ha
          subst ha
          obtain ⟨y, hy, c, hv, hs⟩ := ih a (by omega) (by omega) ⟨i, hi, hia⟩
          rcases hs with e | ⟨pn, hpn, e, hgpn⟩
          · have hge : g = ⟨GateOp.not, [(y : ℕ)]⟩ := by
              cases g
              simp only at hop hin
              rw [hop, hin, e]
            refine ⟨y, hy, !c, fun u => ?_, Or.inr ⟨r, by omega, rfl, by rw [← hge]; exact hg⟩⟩
            rw [vl_not gs L.hcl u r g hg a hop hin, hv]
            cases u y <;> cases c <;> rfl
          · exfalso
            have hpl : pn < gs.length := (List.getElem?_eq_some_iff.1 hgpn).1
            refine L.no_alias hfnc r hrl y (by have := y.isLt; omega) (fun u => ?_)
            rw [vl_not gs L.hcl u r g hg a hop hin, e,
              vl_not gs L.hcl u pn _ hgpn (y : ℕ) rfl rfl, vl_input gs u y y.isLt]
            simp
        · exact absurd his (hmin r (by omega) g hg hop i hi)

theorem front_out (DH : DeepHyp F D) (L : Least (n + 1) F gs o) (p : ℕ) (g : Gate)
    (hg : gs[p]? = some g) (hop : g.op = GateOp.and ∨ g.op = GateOp.or) (l : ℕ)
    (hl : l ∈ g.inputs) {y : Fin (n + 1)} (hy : y ∈ D) (c : Bool)
    (hv : ∀ u, vl gs u l = xor (u y) c) : o ≠ n + 1 + p := by
  intro e
  obtain ⟨x, x', hx⟩ := DH.nc y hy (xor (fixBit g) c)
  have hc : ∀ z : Fin (n + 1) → Bool, F (Function.update z y (xor (fixBit g) c)) = fixBit g := by
    intro z
    rw [← L.hev, e]
    refine vl_abs gs L.hcl _ p g hg hop l hl ?_
    rw [hv]
    simp
  exact hx (by rw [hc, hc])

theorem front_two (DH : DeepHyp F D) (L : Least (n + 1) F gs o) (OR : OneReader D gs) (p : ℕ)
    (g : Gate) (hg : gs[p]? = some g) (hop : g.op = GateOp.and ∨ g.op = GateOp.or) (j k : ℕ)
    (hin : g.inputs = [j, k]) (hj : j < n + 1 + p) (hk : k < n + 1 + p)
    (yj : Fin (n + 1)) (hyj : yj ∈ D) (cj : Bool) (hvj : ∀ u, vl gs u j = xor (u yj) cj)
    (hsj : j = yj ∨ ∃ pn, pn < p ∧ j = n + 1 + pn ∧ gs[pn]? = some ⟨GateOp.not, [(yj : ℕ)]⟩)
    (yk : Fin (n + 1)) (hyk : yk ∈ D) (ck : Bool) (hvk : ∀ u, vl gs u k = xor (u yk) ck)
    (hsk : k = yk ∨ ∃ pn, pn < p ∧ k = n + 1 + pn ∧ gs[pn]? = some ⟨GateOp.not, [(yk : ℕ)]⟩) :
    False := by
  have hfnc := front_fnc DH hyj
  have htl : p < gs.length := (List.getElem?_eq_some_iff.1 hg).1
  have hRj : Reads gs p j := ⟨g, hg, by rw [hin]; simp⟩
  have hRk : Reads gs p k := ⟨g, hg, by rw [hin]; simp⟩

  have hopnd : ∀ (w : ℕ) (v : Fin (n + 1)), v ∈ D → Reads gs p w →
      (w = v ∨ ∃ pn, pn < p ∧ w = n + 1 + pn ∧ gs[pn]? = some ⟨GateOp.not, [(v : ℕ)]⟩) →
      ∀ p' a, (a = (v : ℕ) ∨ a = w) → Reads gs p' a → n + 1 + p' ≠ w → p' = p := by
    intro w v hv hw hs p' a ha hr hne
    rcases hs with e | ⟨r, _, er, hg'⟩
    · have ha' : a = v := by
        rcases ha with ha | ha
        · exact ha
        · rw [ha, e]
      rw [ha'] at hr
      exact OR.1 v hv p' p hr (by rw [← e]; exact hw)
    · have hrv : Reads gs r v := ⟨_, hg', by simp⟩
      rcases ha with ha | ha
      · rw [ha] at hr
        have := OR.1 v hv p' r hr hrv
        exact (hne (by rw [this, er])).elim
      · rw [ha, er] at hr
        rw [er] at hw
        exact OR.2 v hv r hg' p' p hr hw

  have hvjk : yj ≠ yk := by
    intro e
    have hjk : j ≠ k := by
      intro e'
      subst e'
      exact L.no_alias hfnc p htl j hj (fun u => by
        rw [vl_gate gs L.hcl u p g hg, hin]
        rcases hop with h | h <;> rw [h] <;> simp [GateOp.eval])
    rcases hsj with ej | ⟨r1, hr1, ej, hg1⟩ <;> rcases hsk with ek | ⟨r2, hr2, ek, hg2⟩
    · exact hjk (by rw [ej, ek, e])
    · have := OR.1 yj hyj p r2 (by rw [← ej]; exact hRj) ⟨_, hg2, by rw [← e]; simp⟩
      omega
    · have := OR.1 yk hyk p r1 (by rw [← ek]; exact hRk) ⟨_, hg1, by rw [e]; simp⟩
      omega
    · have := OR.1 yj hyj r1 r2 ⟨_, hg1, by simp⟩ ⟨_, hg2, by rw [← e]; simp⟩
      exact hjk (by rw [ej, ek, this])

  have KC : ∀ u u' : Fin (n + 1) → Bool, (∀ i, i ≠ yj → i ≠ yk → u i = u' i) →
      vl gs u (n + 1 + p) = vl gs u' (n + 1 + p) → F u = F u' := by
    intro u u' hagr hgv
    rw [← L.hev, ← L.hev]
    refine agree_B gs L.hcl u u' (fun a => a = (yj : ℕ) ∨ a = (yk : ℕ) ∨ a = j ∨ a = k) (o + 1)
      ?_ ?_ o (by omega) ?_
    · intro a ha hBa
      have hBa' : ¬ (a = (yj : ℕ) ∨ a = (yk : ℕ) ∨ a = j ∨ a = k) := hBa
      rw [vl_input gs u a ha, vl_input gs u' a ha]
      apply hagr
      · intro e
        exact hBa' (Or.inl (congrArg Fin.val e))
      · intro e
        exact hBa' (Or.inr (Or.inl (congrArg Fin.val e)))
    · intro p' g' hp' _ hB' hr _
      have hB'' : ¬ (n + 1 + p' = (yj : ℕ) ∨ n + 1 + p' = (yk : ℕ) ∨ n + 1 + p' = j ∨
          n + 1 + p' = k) := hB'
      obtain ⟨a, ha, hBa⟩ := hr
      have hBa' : a = (yj : ℕ) ∨ a = (yk : ℕ) ∨ a = j ∨ a = k := hBa
      have hR : Reads gs p' a := ⟨g', hp', ha⟩
      have hpt : p' = p := by
        rcases hBa' with e | e | e | e
        · exact hopnd j yj hyj hRj hsj p' a (Or.inl e) hR
            (fun e' => hB'' (Or.inr (Or.inr (Or.inl e'))))
        · exact hopnd k yk hyk hRk hsk p' a (Or.inl e) hR
            (fun e' => hB'' (Or.inr (Or.inr (Or.inr e'))))
        · exact hopnd j yj hyj hRj hsj p' a (Or.inr e) hR
            (fun e' => hB'' (Or.inr (Or.inr (Or.inl e'))))
        · exact hopnd k yk hyk hRk hsk p' a (Or.inr e) hR
            (fun e' => hB'' (Or.inr (Or.inr (Or.inr e'))))
      rw [hpt]
      exact hgv
    · intro hB
      have hB' : o = (yj : ℕ) ∨ o = (yk : ℕ) ∨ o = j ∨ o = k := hB
      rcases hB' with e | e | e | e
      · exact front_nlit DH hyj false (fun x => by
          rw [← L.hev, e, vl_input gs x yj yj.isLt]; simp)
      · exact front_nlit DH hyk false (fun x => by
          rw [← L.hev, e, vl_input gs x yk yk.isLt]; simp)
      · exact front_nlit DH hyj cj (fun x => by rw [← L.hev, e, hvj])
      · exact front_nlit DH hyk ck (fun x => by rw [← L.hev, e, hvk])
  have hag : ∀ (x : Fin (n + 1) → Bool) (a b a' b' : Bool), ∀ i, i ≠ yj → i ≠ yk →
      set2 x yj a yk b i = set2 x yj a' yk b' i := by
    intro x a b a' b' i e1 e2
    rw [set2_o x yj yk a b i e1 e2, set2_o x yj yk a' b' i e1 e2]
  have hval : ∀ (x : Fin (n + 1) → Bool) (a b : Bool),
      vl gs (set2 x yj a yk b) (n + 1 + p) = g.op.eval [xor a cj, xor b ck] := by
    intro x a b
    rw [vl_gate gs L.hcl _ p g hg, hin]
    simp only [List.map_cons, List.map_nil]
    rw [hvj, hvk, set2_p x hvjk, set2_q x]
  apply DH.nf yj hyj yk hyk hvjk
  rcases hop with hop | hop
  · refine ⟨!cj, !ck, fun x => ⟨KC _ _ (hag x _ _ _ _) ?_, KC _ _ (hag x _ _ _ _) ?_⟩⟩ <;>
      rw [hval, hval, hop] <;> cases cj <;> cases ck <;> rfl
  · refine ⟨cj, ck, fun x => ⟨KC _ _ (hag x _ _ _ _) ?_, KC _ _ (hag x _ _ _ _) ?_⟩⟩ <;>
      rw [hval, hval, hop] <;> cases cj <;> cases ck <;> rfl

end

theorem stmtFront : StmtFront := by
  intro n F D gs o DH hD L OR
  classical
  obtain ⟨y0, hy0⟩ := hD
  have hfnc := front_fnc DH hy0
  by_cases hex : ∃ p g, gs[p]? = some g ∧ (g.op = GateOp.and ∨ g.op = GateOp.or) ∧
      ∃ i ∈ D, i ∈ (suppsFrom gs (inputSupps (n + 1))).getD (n + 1 + p) ∅
  · obtain ⟨g, hg, hop, i, hi, his⟩ := Nat.find_spec hex
    set p := Nat.find hex with hpdef
    have hmin : ∀ r < p, ∀ g', gs[r]? = some g' → (g'.op = GateOp.and ∨ g'.op = GateOp.or) →
        ∀ i ∈ D, i ∉ (suppsFrom gs (inputSupps (n + 1))).getD (n + 1 + r) ∅ :=
      fun r hr g' hg' hop' i hi his => Nat.find_min hex hr ⟨g', hg', hop', i, hi, his⟩
    rcases L.hcl p g hg with ⟨hop2, _⟩ | ⟨_, j, k, hj, hk, hin⟩
    · rcases hop with h | h <;> rw [h] at hop2 <;> cases hop2
    obtain ⟨a, ha, hia⟩ := (front_supp_gate gs L.hcl p g hg i).1 his
    rw [hin] at ha
    have hlitof : ∀ (w : ℕ) (y : Fin (n + 1)),
        (w = y ∨ ∃ pn, pn < p ∧ w = n + 1 + pn ∧ gs[pn]? = some ⟨GateOp.not, [(y : ℕ)]⟩) →
        IsLit (n + 1) gs y w := by
      rintro w y (e | ⟨pn, _, e, hpn⟩)
      · exact Or.inl e
      · exact Or.inr ⟨pn, e, hpn⟩
    by_cases mj : ∃ i ∈ D, i ∈ (suppsFrom gs (inputSupps (n + 1))).getD j ∅ <;>
      by_cases mk : ∃ i ∈ D, i ∈ (suppsFrom gs (inputSupps (n + 1))).getD k ∅
    · exfalso
      obtain ⟨yj, hyj, cj, hvj, hsj⟩ := front_dlit L hfnc p hmin j hj mj
      obtain ⟨yk, hyk, ck, hvk, hsk⟩ := front_dlit L hfnc p hmin k hk mk
      exact front_two DH L OR p g hg hop j k hin hj hk yj hyj cj hvj hsj yk hyk ck hvk hsk
    · obtain ⟨y, hy, c, hv, hs⟩ := front_dlit L hfnc p hmin j hj mj
      refine ⟨p, g, y, j, k, ⟨hg, hop, Or.inl hin, hy, hlitof j y hs,
        fun y' hy' hm => mk ⟨y', hy', hm⟩⟩,
        front_out DH L p g hg hop j (by rw [hin]; simp) hy c hv⟩
    · obtain ⟨y, hy, c, hv, hs⟩ := front_dlit L hfnc p hmin k hk mk
      refine ⟨p, g, y, k, j, ⟨hg, hop, Or.inr hin, hy, hlitof k y hs,
        fun y' hy' hm => mj ⟨y', hy', hm⟩⟩,
        front_out DH L p g hg hop k (by rw [hin]; simp) hy c hv⟩
    · exfalso
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
      rcases ha with rfl | rfl
      · exact mj ⟨i, hi, hia⟩
      · exact mk ⟨i, hi, hia⟩
  · exfalso
    have hmin : ∀ r < gs.length, ∀ g', gs[r]? = some g' →
        (g'.op = GateOp.and ∨ g'.op = GateOp.or) →
        ∀ i ∈ D, i ∉ (suppsFrom gs (inputSupps (n + 1))).getD (n + 1 + r) ∅ :=
      fun r _ g' hg' hop' i hi his => hex ⟨r, g', hg', hop', i, hi, his⟩
    by_cases hol : o < n + 1 + gs.length
    · obtain ⟨y, hy, c, hv, _⟩ := front_dlit L hfnc gs.length hmin o hol
        ⟨y0, hy0, front_dep DH L hy0⟩
      exact front_nlit DH hy c (fun u => by rw [← L.hev, hv])
    · obtain ⟨x, x', hxx⟩ := hfnc
      apply hxx
      rw [← L.hev, ← L.hev, vl_beyond gs x o (by omega), vl_beyond gs x' o (by omega)]

end PEqualNP.MetaComplexity.PathCircuitEdgeFn

-- Shared results from PEqualNP.MetaComplexity.Helpers.EdgeFnFinal.

namespace PEqualNP.MetaComplexity.PathCircuitEdgeFn

theorem stmtML_final : StmtML := ml_of_front stmtFront

end PEqualNP.MetaComplexity.PathCircuitEdgeFn
namespace Path574
open PEqualNP.MetaComplexity PEqualNP.MetaComplexity.PathCircuitEdgeFn PEqualNP.MetaComplexity.PathCircuitHelpers.Readers

private abbrev old {N k : ℕ} (x : Fin (N+k) → Bool) : Fin N → Bool := fun i => x (Fin.castAdd k i)
private abbrev fresh {N k : ℕ} (x : Fin (N+k) → Bool) : Fin k → Bool := fun i => x (Fin.natAdd N i)

private def pathFn (N k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (x : Fin (N+k) → Bool) : Bool := g (old x) || decide (∃ i : Fin k, fresh x i = true ∧
      ((i.val = 0 ∧ old x u = true) ∨ (i.val+1=k ∧ old x v=true) ∨
       ∃ j : Fin k, j.val=i.val+1 ∧ fresh x j=true))

private def D (N k : ℕ) : Finset (Fin (N+k)) := (Finset.univ.filter (fun (i : Fin k) => 0 < i.val ∧ i.val+1 < k)).image (Fin.natAdd N)

private def adj {k : ℕ} (p q : Fin k) : Prop := p.val+1=q.val ∨ q.val+1=p.val

private theorem fresh_mem (N k : ℕ) (p : Fin k) (h0 : 0 < p.val) (hl : p.val+1 < k) : Fin.natAdd N p ∈ D N k :=
  Finset.mem_image.mpr ⟨p,by simp [h0,hl],rfl⟩
private theorem old_out (N k : ℕ) (i : Fin N) : Fin.castAdd k i ∉ D N k := by
  rintro h
  obtain ⟨j,_,he⟩ := Finset.mem_image.mp h
  have hh := congrArg Fin.val he
  simp only [Fin.val_natAdd,Fin.val_castAdd] at hh
  omega
private theorem old_ne {N k : ℕ} (i : Fin N) (j : Fin k) : Fin.castAdd k i ≠ Fin.natAdd N j := by
  intro he
  have hh := congrArg Fin.val he
  simp only [Fin.val_natAdd,Fin.val_castAdd] at hh
  omega

@[simp] private theorem old_append {N k : ℕ} (y : Fin N → Bool) (z : Fin k → Bool) :
    old (Fin.append y z) = y := funext (fun i => Fin.append_left y z i)
@[simp] private theorem fresh_append {N k : ℕ} (y : Fin N → Bool) (z : Fin k → Bool) (i : Fin k) :
    fresh (Fin.append y z) i = z i := Fin.append_right ..
@[simp] private theorem old_update {N k : ℕ} (x : Fin (N+k) → Bool) (j : Fin k) (b : Bool) :
    old (Function.update x (Fin.natAdd N j) b)=old x := by
  funext i
  exact Function.update_of_ne (old_ne i j) _ _
private theorem fresh_update {N k : ℕ} (x : Fin (N+k) → Bool) (j i : Fin k) (b : Bool) :
    fresh (Function.update x (Fin.natAdd N j) b) i = if i=j then b else fresh x i := by
  by_cases he : i=j
  · subst i; simp [fresh]
  · have hn : Fin.natAdd N i ≠ Fin.natAdd N j := fun h => he ((Fin.natAdd_inj N).mp h)
    simp [fresh,he,Function.update_of_ne hn]

private theorem false_path {N k : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (x : Fin (N+k) → Bool) (hg : g (old x)=false)
    (hu : ∀ i : Fin k, fresh x i=true → i.val=0 → old x u ≠ true)
    (hv : ∀ i : Fin k, fresh x i=true → i.val+1=k → old x v ≠ true)
    (hsep : ∀ i j : Fin k, fresh x i=true → fresh x j=true → j.val ≠ i.val+1) :
    pathFn N k u v g x=false := by
  unfold pathFn
  rw [hg,Bool.false_or,decide_eq_false_iff_not]
  rintro ⟨i,hi,⟨he,hu'⟩ | ⟨he,hv'⟩ | ⟨j,hj,hj'⟩⟩
  · exact hu i hi he hu'
  · exact hv i hi he hv'
  · exact hsep i j hi hj' hj

private theorem true_path {N k : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (x : Fin (N+k) → Bool) (r p : Fin k) (h : adj r p) (hr : fresh x r=true)
    (hp : fresh x p=true) : pathFn N k u v g x=true := by
  unfold pathFn
  simp only [Bool.or_eq_true,decide_eq_true_eq]
  right
  rcases h with h|h
  · exact ⟨r,hr,Or.inr (Or.inr ⟨p,h.symm,hp⟩)⟩
  · exact ⟨p,hp,Or.inr (Or.inr ⟨r,h.symm,hr⟩)⟩


private theorem front_neighbor {k : ℕ} (p q : Fin k) (hp : 0 < p.val) (hq : 0 < q.val)
    (hne : p ≠ q) : ∃ r : Fin k,
    (adj r p ∧ ¬adj r q ∧ r ≠ q) ∨ (adj r q ∧ ¬adj r p ∧ r ≠ p) := by
  have hn : p.val ≠ q.val := fun he => hne (Fin.ext he)
  by_cases h : p.val < q.val
  · let r : Fin k := ⟨p.val-1,by omega⟩
    have hr : r.val+1=p.val := by simp [r]; omega
    exact ⟨r,Or.inl ⟨Or.inl hr,by unfold adj; omega,fun he => by have := congrArg Fin.val he; omega⟩⟩
  · let r : Fin k := ⟨q.val-1,by omega⟩
    have hr : r.val+1=q.val := by simp [r]; omega
    exact ⟨r,Or.inr ⟨Or.inl hr,by unfold adj; omega,fun he => by have := congrArg Fin.val he; omega⟩⟩

private theorem interior_neighbor {k : ℕ} (hk : 7 ≤ k) (p : Fin k) (hp : 0 < p.val)
    (hl : p.val+1 < k) : ∃ r : Fin k, adj r p ∧ 1 < r.val ∧ r.val+2 < k := by
  by_cases h : p.val+3 < k
  · let r : Fin k := ⟨p.val+1,by omega⟩
    have hr : r.val=p.val+1 := rfl
    exact ⟨r,Or.inr hr.symm,by omega,by omega⟩
  · let r : Fin k := ⟨p.val-1,by omega⟩
    have hr : r.val+1=p.val := by simp [r]; omega
    exact ⟨r,Or.inl hr,by omega,by omega⟩

private theorem one_truth {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (gz : g (fun _ => false)=false) (r p q : Fin k) (hrp : adj r p) (hrq : ¬ adj r q)
    (a b : Bool) (x : Fin (N+k) → Bool) (ho : old x = fun _ => false)
    (hs : ∀ i, fresh x i = true ↔ (i=p ∧ a=true) ∨ (i=q ∧ b=true) ∨ i=r) :
    pathFn N k u v g x = a := by
  cases a with
  | true => exact true_path x r p hrp ((hs r).mpr (Or.inr (Or.inr rfl))) ((hs p).mpr (Or.inl ⟨rfl,rfl⟩))
  | false =>
    apply false_path x (ho ▸ gz) (fun _ _ _ ht => Bool.false_ne_true ((congrFun ho u).symm.trans ht))
      (fun _ _ _ ht => Bool.false_ne_true ((congrFun ho v).symm.trans ht))
    intro i j hi hj
    have h1 := (hs i).mp hi
    have h2 := (hs j).mp hj
    simp only [Bool.false_eq_true, and_false, false_or] at h1 h2
    unfold adj at hrq
    rcases h1 with ⟨rfl,_⟩|rfl <;> rcases h2 with ⟨rfl,_⟩|rfl <;> omega

private theorem no_funnel {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (gz : g (fun _ => false)=false) (p q : Fin k) (hp : 0 < p.val) (hq : 0 < q.val)
    (hne : p≠q) : ¬ PairFunnel (pathFn N k u v g) (Fin.natAdd N p) (Fin.natAdd N q) := by
  obtain ⟨r,hr⟩ := front_neighbor p q hp hq hne
  have hnrp : r ≠ p := by
    rcases hr with ⟨ha,_,_⟩|⟨_,_,ha⟩
    · intro he; subst p; unfold adj at ha; omega
    · exact ha
  have hnrq : r ≠ q := by
    rcases hr with ⟨_,_,ha⟩|⟨ha,_,_⟩
    · exact ha
    · intro he; subst q; unfold adj at ha; omega
  let x := Fin.append (fun _ : Fin N => false) (fun i : Fin k => decide (i=r))
  let t := fun a b => set2 x (Fin.natAdd N p) a (Fin.natAdd N q) b
  have ho (a b : Bool) : old (t a b) = fun _ : Fin N => false := by simp [t,set2,x]
  have hs (a b : Bool) (i : Fin k) : fresh (t a b) i = true ↔
      (i=p ∧ a=true) ∨ (i=q ∧ b=true) ∨ i=r := by
    by_cases h1 : i=p <;> by_cases h2 : i=q <;> simp_all [t,set2,fresh_update,x,Ne.symm hnrp,Ne.symm hnrq]
  rintro ⟨a,b,hf⟩
  have h := hf x
  change pathFn N k u v g (t (!a) b) = pathFn N k u v g (t a (!b)) ∧
    pathFn N k u v g (t a (!b))=pathFn N k u v g (t (!a) (!b)) at h
  rcases hr with ⟨ha,hb,_⟩|⟨ha,hb,_⟩
  · have htab (z w : Bool) := one_truth u v g gz r p q ha hb z w (t z w) (ho z w) (hs z w)
    simp only [htab] at h
    cases a <;> simp at h
  · have htab (z w : Bool) := one_truth u v g gz r q p ha hb w z (t z w) (ho z w)
      (fun i => by simpa only [or_left_comm] using hs z w i)
    simp only [htab] at h
    cases b <;> simp at h

private theorem add_single_false {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (z : Fin (N+k) → Bool) (r : Fin k) (hr0 : 0 < r.val) (hrl : r.val+1 < k)
    (hz : pathFn N k u v g z=false) (hr : ∀ i : Fin k, adj i r → fresh z i=false) :
    pathFn N k u v g (Function.update z (Fin.natAdd N r) true)=false := by
  let x := Function.update z (Fin.natAdd N r) true
  have hx (i : Fin k) (hin : i≠r) : fresh x i = fresh z i := by simp [x,fresh_update,hin]
  simp only [pathFn, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hz
  have hprev (i : Fin k) (hi : fresh z i=true) :
      ¬((i.val=0 ∧ old z u=true) ∨ (i.val+1=k ∧ old z v=true) ∨
        ∃ j : Fin k, j.val=i.val+1 ∧ fresh z j=true) := fun he => hz.2 ⟨i,hi,he⟩
  apply false_path x (by simpa only [x,old_update] using hz.1)
  · intro i hi he hbit
    have hn : i≠r := fun h => by subst i; omega
    exact hprev i ((hx i hn) ▸ hi) (Or.inl ⟨he,((congrFun (old_update z r true) u).symm.trans hbit)⟩)
  · intro i hi he hbit
    have hn : i≠r := fun h => by subst i; omega
    exact hprev i ((hx i hn) ▸ hi) (Or.inr (Or.inl ⟨he,((congrFun (old_update z r true) v).symm.trans hbit)⟩))
  · intro i j hi hj he
    by_cases h1 : i=r
    · subst i
      have hn : j≠r := fun h => by subst j; omega
      have hzj := hr j (Or.inr he.symm)
      rw [hx j hn,hzj] at hj
      cases hj
    · by_cases h2 : j=r
      · subst j
        have hzi := hr i (Or.inl he.symm)
        rw [hx i h1,hzi] at hi
        cases hi
      · exact hprev i ((hx i h1) ▸ hi) (Or.inr (Or.inr ⟨j,he,(hx j h2) ▸ hj⟩))

private theorem path_deep (N k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hk : 7 ≤ k) (hg : ∃ y z, g y ≠ g z) (gz : g (fun _ => false)=false) :
    DeepHyp (pathFn N k u v g) (D N k) := by
  have inD (p : Fin (N+k)) (hp : p ∈ D N k) :
      ∃ i : Fin k, 0 < i.val ∧ i.val+1 < k ∧ p=Fin.natAdd N i := by
    obtain ⟨i,hi,he⟩ := Finset.mem_image.mp hp
    have hh := (Finset.mem_filter.mp hi).2
    exact ⟨i,hh.1,hh.2,he.symm⟩
  have zold (x : Fin (N+k) → Bool) : old (zeroOn (D N k) x)=old x := by
    funext i
    simp [old,zeroOn,old_out]
  have zfresh (x : Fin (N+k) → Bool) (i : Fin k) (h0 : 0 < i.val) (hl : i.val+1 < k) :
      fresh (zeroOn (D N k) x) i=false := by
    simp [fresh,zeroOn,fresh_mem N k i h0 hl]
  have g1 : ∃ y, g y=true := by
    obtain ⟨y,z,h⟩ := hg
    cases hh : g y
    · exact ⟨z,by cases hh' : g z <;> simp_all⟩
    · exact ⟨y,hh⟩
  refine ⟨?_,?_,?_,?_,?_⟩
  · intro w hw b
    obtain ⟨p,h0,hl,rfl⟩ := inD w hw
    obtain ⟨y,hy⟩ := g1
    let x0 : Fin (N+k) → Bool := Fin.append (fun _ : Fin N => false) (fun _ : Fin k => false)
    let x1 : Fin (N+k) → Bool := Fin.append y (fun _ : Fin k => false)
    let z := Function.update x0 (Fin.natAdd N p) b
    have ho : old z=fun _ : Fin N => false := by simp [z,x0]
    have hs (i : Fin k) (hi : fresh z i=true) : i=p := by
      by_contra hn
      simp [z,fresh_update,x0,hn] at hi
    have hfalse : pathFn N k u v g z=false := by
      apply false_path z (ho ▸ gz)
      · intro i hi he; rw [hs i hi] at he; omega
      · intro i hi he; rw [hs i hi] at he; omega
      · intro i j hi hj; rw [hs i hi,hs j hj]; omega
    have htrue : pathFn N k u v g (Function.update x1 (Fin.natAdd N p) b)=true := by
      simp only [pathFn,old_update,x1,old_append,hy,Bool.true_or]
    exact ⟨x0,x1,by change pathFn N k u v g z ≠ _; rw [hfalse,htrue]; decide⟩
  · intro w hw w' hw' hn
    obtain ⟨p,hp,_,rfl⟩ := inD w hw
    obtain ⟨q,hq,_,rfl⟩ := inD w' hw'
    exact no_funnel u v g gz p q hp hq (fun he => hn (congrArg _ he))
  · intro w hw x hz
    obtain ⟨p,h0,hl,rfl⟩ := inD w hw
    obtain ⟨r,ha,hr0,hrl⟩ := interior_neighbor hk p h0 hl
    have hne : p≠r := by intro he; subst p; unfold adj at ha; omega
    let z := zeroOn (D N k) x
    let x' := Function.update z (Fin.natAdd N r) true
    have hf : pathFn N k u v g x'=false := by
      apply add_single_false u v g z r (by omega) (by omega) hz
      intro i hi
      unfold adj at hi
      exact zfresh x i (by omega) (by omega)
    have he (i : Fin (N+k)) (hi : i ∉ D N k) : x' i=x i := by
      have hri : i≠Fin.natAdd N r := fun h => hi (h ▸ fresh_mem N k r (by omega) (by omega))
      simp [x',z,zeroOn,hi,Function.update_of_ne hri]
    have hp : fresh x' p=false := by simp [x',fresh_update,hne,z,zfresh x p h0 hl]
    have hrr : fresh x' r=true := by simp [x',fresh_update]
    refine ⟨x',he,hp,hf,?_⟩
    apply true_path _ r p ha
    · simp [fresh_update,Ne.symm hne,hrr]
    · simp [fresh_update]
  · intro x hx
    have nz (i : Fin k) (h : fresh (zeroOn (D N k) x) i=true) : fresh x i=true := by
      change (if Fin.natAdd N i ∈ D N k then false else x (Fin.natAdd N i))=true at h
      split at h
      · cases h
      · exact h
    simp only [pathFn,zold,Bool.or_eq_true,decide_eq_true_eq] at hx ⊢
    rcases hx with hg|⟨i,hi,hh⟩
    · exact Or.inl hg
    · refine Or.inr ⟨i,nz i hi,?_⟩
      rcases hh with hh|hh|⟨j,hj,hv⟩
      · exact Or.inl ⟨hh.1, (congrFun (zold x) u).symm.trans hh.2⟩
      · exact Or.inr (Or.inl ⟨hh.1,(congrFun (zold x) v).symm.trans hh.2⟩)
      · exact Or.inr (Or.inr ⟨j,hj,nz j hv⟩)
  · simp [pathFn,old,fresh,gz]

private theorem path_pay (N k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hk : 7 ≤ k) (hg : ∃ y z, g y ≠ g z) (gz : g (fun _ => false)=false)
    (hML : StmtML) (s : ℕ) (hc : HasCircuitSize (N+k) (pathFn N k u v g) s) :
    ∃ p : Fin k, 0 < p.val ∧ p.val+1 < k ∧
      ((∃ t : ℕ, t+3 ≤ s ∧ HasCircuitSize (N+k)
        (fun x => pathFn N k u v g (Function.update x (Fin.natAdd N p) false)) t) ∨
       (∃ t : ℕ, t+4 ≤ s ∧ HasCircuitSize (N+k)
        (fun x => pathFn N k u v g (Function.update x (Fin.natAdd N p) true)) t)) := by
  cases k with
  | zero => omega
  | succ k =>
    let i : Fin (k+1) := ⟨1,by omega⟩
    have hi : i.val=1 := rfl
    have hn : (D N (k+1)).Nonempty := ⟨Fin.natAdd N i,fresh_mem N _ i (by omega) (by omega)⟩
    obtain ⟨w,hw,h⟩ := hML (N+k) (pathFn N (k+1) u v g) (D N (k+1)) s
      (path_deep N _ u v g hk hg gz) hn hc
    obtain ⟨p,hp,rfl⟩ := Finset.mem_image.mp hw
    have hcond := (Finset.mem_filter.mp hp).2
    exact ⟨p,hcond.1,hcond.2,h⟩


end Path574

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

namespace PathGateReduction

-- The constant-propagation pass follows L_meta_468.

private def wiresFrom (gs : List Gate) (w : List Bool) : List Bool :=
  gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) w

private lemma wiresFrom_nil (w : List Bool) : wiresFrom [] w = w := rfl

private lemma wiresFrom_cons (g : Gate) (gs : List Gate) (w : List Bool) :
    wiresFrom (g :: gs) w =
      wiresFrom gs (w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) := rfl

private lemma wiresFrom_append (gs₁ gs₂ : List Gate) (w : List Bool) :
    wiresFrom (gs₁ ++ gs₂) w = wiresFrom gs₂ (wiresFrom gs₁ w) := by
  induction gs₁ generalizing w with
  | nil => rfl
  | cons g gs ih => simp only [List.cons_append, wiresFrom_cons, ih]

private lemma wiresFrom_length (gs : List Gate) (w : List Bool) :
    (wiresFrom gs w).length = w.length + gs.length := by
  induction gs generalizing w with
  | nil => simp [wiresFrom]
  | cons g gs ih =>
    rw [wiresFrom_cons, ih]
    simp
    omega

private lemma getD_snoc_lt {α : Type*} (l : List α) (x d : α) (i : ℕ) (hi : i < l.length) :
    (l ++ [x]).getD i d = l.getD i d := by
  simp [List.getD, List.getElem?_append_left hi]

private lemma getD_snoc_eq {α : Type*} (l : List α) (x d : α) (i : ℕ) (hi : i = l.length) :
    (l ++ [x]).getD i d = x := by
  subst hi
  simp [List.getD]

private lemma getD_snoc_ne {α : Type*} (l : List α) (x d : α) (i : ℕ) (hi : i ≠ l.length) :
    (l ++ [x]).getD i d = l.getD i d := by
  by_cases hlt : i < l.length
  · exact getD_snoc_lt l x d i hlt
  · rw [List.getD_eq_default _ _ (by simp; omega), List.getD_eq_default _ _ (by omega)]

private lemma wiresFrom_getD_lt (gs : List Gate) (w : List Bool) (i : ℕ) (hi : i < w.length) :
    (wiresFrom gs w).getD i false = w.getD i false := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    rw [wiresFrom_cons, ih _ (by simp; omega)]
    exact getD_snoc_lt _ _ _ _ hi

private def OkGate (g : Gate) : Prop :=
  g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2

private def NOkGate (g : Gate) : Prop :=
  OkGate g ∧ (g.op = GateOp.not → g.inputs.length ≤ 1)

private def normGate (g : Gate) : Gate :=
  match g.op with
  | GateOp.not => ⟨GateOp.not, g.inputs.take 1⟩
  | _ => g

private lemma normGate_eval (g : Gate) (F : ℕ → Bool) :
    (normGate g).op.eval ((normGate g).inputs.map F) = g.op.eval (g.inputs.map F) := by
  obtain ⟨op, inputs⟩ := g
  cases op <;> simp only [normGate]
  cases inputs <;> simp [GateOp.eval]

private lemma normGate_nok (g : Gate) (h : OkGate g) : NOkGate (normGate g) := by
  obtain ⟨op, inputs⟩ := g
  obtain ⟨hop, hlen⟩ := h
  rcases hop with h | h | h
  · have : op = GateOp.and := h
    subst this
    exact ⟨⟨Or.inl rfl, hlen⟩, by simp [normGate]⟩
  · have : op = GateOp.or := h
    subst this
    exact ⟨⟨Or.inr (Or.inl rfl), hlen⟩, by simp [normGate]⟩
  · have : op = GateOp.not := h
    subst this
    refine ⟨⟨Or.inr (Or.inr rfl), ?_⟩, fun _ => ?_⟩
    · simp [normGate]
    · simp [normGate]

private lemma wiresFrom_norm (gs : List Gate) (w : List Bool) :
    wiresFrom (gs.map normGate) w = wiresFrom gs w := by
  induction gs generalizing w with
  | nil => rfl
  | cons g gs ih =>
    rw [List.map_cons, wiresFrom_cons, wiresFrom_cons, normGate_eval, ih]

private def statVal (w : List Bool) : Bool ⊕ ℕ → Bool
  | Sum.inl c => c
  | Sum.inr j => w.getD j false

private def statValid (m : ℕ) : Bool ⊕ ℕ → Prop
  | Sum.inl _ => True
  | Sum.inr j => j < m

private def simpNot (m : ℕ) : List (Bool ⊕ ℕ) → Option Gate × (Bool ⊕ ℕ)
  | [] => (none, Sum.inl true)
  | Sum.inl c :: _ => (none, Sum.inl (!c))
  | Sum.inr j :: _ => (some ⟨GateOp.not, [j]⟩, Sum.inr m)

private def simpAnd (m : ℕ) : List (Bool ⊕ ℕ) → Option Gate × (Bool ⊕ ℕ)
  | [] => (none, Sum.inl true)
  | [Sum.inl c] => (none, Sum.inl c)
  | [Sum.inr j] => (none, Sum.inr j)
  | [Sum.inl c, Sum.inl d] => (none, Sum.inl (c && d))
  | [Sum.inl c, Sum.inr j] => (none, bif c then Sum.inr j else Sum.inl false)
  | [Sum.inr j, Sum.inl c] => (none, bif c then Sum.inr j else Sum.inl false)
  | [Sum.inr j, Sum.inr k] => (some ⟨GateOp.and, [j, k]⟩, Sum.inr m)
  | _ => (none, Sum.inl false)

private def simpOr (m : ℕ) : List (Bool ⊕ ℕ) → Option Gate × (Bool ⊕ ℕ)
  | [] => (none, Sum.inl false)
  | [Sum.inl c] => (none, Sum.inl c)
  | [Sum.inr j] => (none, Sum.inr j)
  | [Sum.inl c, Sum.inl d] => (none, Sum.inl (c || d))
  | [Sum.inl c, Sum.inr j] => (none, bif c then Sum.inl true else Sum.inr j)
  | [Sum.inr j, Sum.inl c] => (none, bif c then Sum.inl true else Sum.inr j)
  | [Sum.inr j, Sum.inr k] => (some ⟨GateOp.or, [j, k]⟩, Sum.inr m)
  | _ => (none, Sum.inl false)

private def simplifyGate (op : GateOp) (m : ℕ) (ins : List (Bool ⊕ ℕ)) :
    Option Gate × (Bool ⊕ ℕ) :=
  match op with
  | GateOp.and => simpAnd m ins
  | GateOp.or => simpOr m ins
  | GateOp.not => simpNot m ins
  | _ => (none, Sum.inl false)

private lemma simplifyGate_ok (op : GateOp) (m : ℕ) (ins : List (Bool ⊕ ℕ)) :
    ∀ g ∈ (simplifyGate op m ins).1, OkGate g := by
  intro g hg
  cases op <;> simp only [simplifyGate] at hg
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpAnd] at hg
    subst hg; simp [OkGate]
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨c, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp [simpOr] at hg
    subst hg; simp [OkGate]
  · rcases ins with _ | ⟨a, l⟩ <;> (try cases a) <;>
      simp [simpNot] at hg
    subst hg; simp [OkGate]
  · simp at hg
  · simp at hg

private lemma simplifyGate_none_of_const (op : GateOp) (m : ℕ) (ins : List (Bool ⊕ ℕ))
    (hop : op = GateOp.and ∨ op = GateOp.or ∨ op = GateOp.not) (hlen : ins.length ≤ 2)
    (hnot : op = GateOp.not → ins.length ≤ 1) (hc : ∃ c, Sum.inl c ∈ ins) :
    (simplifyGate op m ins).1 = none := by
  obtain ⟨c, hc⟩ := hc
  rcases hop with rfl | rfl | rfl
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp_all [simplifyGate, simpAnd]
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩ <;> (try cases a) <;> (try cases b) <;>
      simp_all [simplifyGate, simpOr]
  · have := hnot rfl
    rcases ins with _ | ⟨a, _ | ⟨b, l⟩⟩ <;> (try cases a) <;> simp_all [simplifyGate, simpNot]

private lemma simplifyGate_and_false (m : ℕ) (ins : List (Bool ⊕ ℕ))
    (hlen : ins.length ≤ 2) (hf : Sum.inl false ∈ ins) :
    simplifyGate GateOp.and m ins = (none, Sum.inl false) := by
  rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
  · simp at hf
  · cases a <;> simp_all [simplifyGate, simpAnd]
  · cases a with
    | inl c =>
      cases b with
      | inl d => cases c <;> cases d <;> simp_all [simplifyGate, simpAnd]
      | inr j => cases c <;> simp_all [simplifyGate, simpAnd]
    | inr i =>
      cases b with
      | inl d => cases d <;> simp_all [simplifyGate, simpAnd]
      | inr j => simp at hf
  · simp at hlen

private lemma simplifyGate_not_const (m : ℕ) (c : Bool) :
    simplifyGate GateOp.not m [Sum.inl c] = (none, Sum.inl (!c)) := rfl

private lemma simplifyGate_sound (op : GateOp)
    (hop : op = GateOp.and ∨ op = GateOp.or ∨ op = GateOp.not)
    (w : List Bool) (ins : List (Bool ⊕ ℕ)) (hlen : ins.length ≤ 2)
    (hv : ∀ s ∈ ins, statValid w.length s) :
    statValid (w.length + (simplifyGate op w.length ins).1.toList.length)
      (simplifyGate op w.length ins).2 ∧
    statVal (wiresFrom (simplifyGate op w.length ins).1.toList w)
      (simplifyGate op w.length ins).2 = op.eval (ins.map (statVal w)) := by
  rcases hop with rfl | rfl | rfl
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
    · simp [simplifyGate, simpAnd, statValid, statVal, GateOp.eval]
    · cases a <;> simp_all [simplifyGate, simpAnd, statValid, statVal, GateOp.eval, wiresFrom]
    · cases a with
      | inl c =>
        cases b with
        | inl d => simp_all [simplifyGate, simpAnd, statValid, statVal, GateOp.eval]
        | inr j => cases c <;> simp_all [simplifyGate, simpAnd, statValid, statVal, GateOp.eval, wiresFrom]
      | inr i =>
        cases b with
        | inl d => cases d <;> simp_all [simplifyGate, simpAnd, statValid, statVal, GateOp.eval, wiresFrom]
        | inr j => simp_all [simplifyGate, simpAnd, statValid, statVal, GateOp.eval, wiresFrom]
    · simp at hlen
  · rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
    · simp [simplifyGate, simpOr, statValid, statVal, GateOp.eval]
    · cases a <;> simp_all [simplifyGate, simpOr, statValid, statVal, GateOp.eval, wiresFrom]
    · cases a with
      | inl c =>
        cases b with
        | inl d => simp_all [simplifyGate, simpOr, statValid, statVal, GateOp.eval]
        | inr j => cases c <;> simp_all [simplifyGate, simpOr, statValid, statVal, GateOp.eval, wiresFrom]
      | inr i =>
        cases b with
        | inl d => cases d <;> simp_all [simplifyGate, simpOr, statValid, statVal, GateOp.eval, wiresFrom]
        | inr j => simp_all [simplifyGate, simpOr, statValid, statVal, GateOp.eval, wiresFrom]
    · simp at hlen
  · rcases ins with _ | ⟨a, l⟩
    · simp [simplifyGate, simpNot, statValid, statVal, GateOp.eval]
    · cases a <;> simp_all [simplifyGate, simpNot, statValid, statVal, GateOp.eval, wiresFrom]

private def elimStep (m : ℕ) (acc : List (Bool ⊕ ℕ) × List Gate) (g : Gate) :
    List (Bool ⊕ ℕ) × List Gate :=
  let r := simplifyGate g.op (m + acc.2.length)
    (g.inputs.map fun i => acc.1.getD i (Sum.inl false))
  (acc.1 ++ [r.2], acc.2 ++ r.1.toList)

private def elimPass (m : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate) :
    List (Bool ⊕ ℕ) × List Gate :=
  gs.foldl (elimStep m) acc

private lemma elimPass_cons (m : ℕ) (g : Gate) (gs : List Gate)
    (acc : List (Bool ⊕ ℕ) × List Gate) :
    elimPass m (g :: gs) acc = elimPass m gs (elimStep m acc g) := rfl

private lemma elimPass_append (m : ℕ) (gs₁ gs₂ : List Gate)
    (acc : List (Bool ⊕ ℕ) × List Gate) :
    elimPass m (gs₁ ++ gs₂) acc = elimPass m gs₂ (elimPass m gs₁ acc) := by
  induction gs₁ generalizing acc with
  | nil => rfl
  | cons g gs ih => simp only [List.cons_append, elimPass_cons, ih]

private lemma elimPass_fst_len (m : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate) :
    (elimPass m gs acc).1.length = acc.1.length + gs.length := by
  induction gs generalizing acc with
  | nil => simp [elimPass]
  | cons g gs ih =>
    rw [elimPass_cons, ih]
    simp [elimStep]
    omega

private lemma elimPass_getD_lt (m k : ℕ) (d : Bool ⊕ ℕ) (gs : List Gate)
    (acc : List (Bool ⊕ ℕ) × List Gate) (hk : k < acc.1.length) :
    (elimPass m gs acc).1.getD k d = acc.1.getD k d := by
  induction gs generalizing acc with
  | nil => rfl
  | cons g gs ih =>
    rw [elimPass_cons, ih _ (by simp [elimStep]; omega)]
    exact getD_snoc_lt _ _ _ _ hk

private lemma toList_opt_len_le {α : Type*} (o : Option α) : o.toList.length ≤ 1 := by
  cases o <;> simp

private lemma elimPass_ok (m : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate)
    (h : ∀ g ∈ acc.2, OkGate g) : ∀ g ∈ (elimPass m gs acc).2, OkGate g := by
  induction gs generalizing acc with
  | nil => exact h
  | cons g gs ih =>
    rw [elimPass_cons]
    apply ih
    intro g' hg'
    rcases List.mem_append.1 hg' with h1 | h1
    · exact h g' h1
    · exact simplifyGate_ok _ _ _ g' (by simpa using h1)

private lemma elimPass_len (m : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate) :
    (elimPass m gs acc).2.length ≤ acc.2.length + gs.length := by
  induction gs generalizing acc with
  | nil => simp [elimPass]
  | cons g gs ih =>
    rw [elimPass_cons, List.length_cons]
    have h1 := ih (elimStep m acc g)
    have h2 : (elimStep m acc g).2.length ≤ acc.2.length + 1 := by
      simp only [elimStep, List.length_append]
      have := toList_opt_len_le (simplifyGate g.op (m + acc.2.length)
        (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1
      omega
    omega

private lemma elimPass_len_lt (m k : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate)
    (hok : ∀ g ∈ gs, NOkGate g) (hk : k < acc.1.length)
    (hc : ∃ c, acc.1.getD k (Sum.inl false) = Sum.inl c)
    (hex : ∃ g ∈ gs, k ∈ g.inputs) :
    (elimPass m gs acc).2.length + 1 ≤ acc.2.length + gs.length := by
  induction gs generalizing acc with
  | nil => obtain ⟨g, hg, _⟩ := hex; simp at hg
  | cons g gs ih =>
    rw [elimPass_cons, List.length_cons]
    by_cases hkg : k ∈ g.inputs
    · obtain ⟨c, hc⟩ := hc
      have hnok := hok g List.mem_cons_self
      have hnone : (simplifyGate g.op (m + acc.2.length)
          (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1 = none := by
        apply simplifyGate_none_of_const
        · exact hnok.1.1
        · simpa using hnok.1.2
        · intro h; simpa using hnok.2 h
        · exact ⟨c, List.mem_map.2 ⟨k, hkg, hc⟩⟩
      have h2 : (elimStep m acc g).2.length = acc.2.length := by
        simp only [elimStep, hnone, Option.toList_none, List.append_nil]
      have := elimPass_len m gs (elimStep m acc g)
      omega
    · have hex' : ∃ g' ∈ gs, k ∈ g'.inputs := by
        obtain ⟨g', hg', hk'⟩ := hex
        rcases List.mem_cons.1 hg' with rfl | h
        · exact absurd hk' hkg
        · exact ⟨g', h, hk'⟩
      have h1 := ih (elimStep m acc g) (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg'))
        (by simp [elimStep]; omega)
        (by
          obtain ⟨c, hc⟩ := hc
          exact ⟨c, by simp only [elimStep]; rw [getD_snoc_lt _ _ _ _ hk]; exact hc⟩)
        hex'
      have h2 : (elimStep m acc g).2.length ≤ acc.2.length + 1 := by
        simp only [elimStep, List.length_append]
        have := toList_opt_len_le (simplifyGate g.op (m + acc.2.length)
          (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1
        omega
      omega

private lemma elimPass_len_two (m k : ℕ) (gs : List Gate) (acc : List (Bool ⊕ ℕ) × List Gate)
    (hok : ∀ g ∈ gs, NOkGate g) (hk : k < acc.1.length)
    (hc : ∃ c, acc.1.getD k (Sum.inl false) = Sum.inl c)
    (htwo : 2 ≤ (gs.filter (fun g => decide (k ∈ g.inputs))).length) :
    (elimPass m gs acc).2.length + 2 ≤ acc.2.length + gs.length := by
  induction gs generalizing acc with
  | nil => simp at htwo
  | cons g gs ih =>
    rw [elimPass_cons, List.length_cons]
    by_cases hkg : k ∈ g.inputs
    · obtain ⟨c, hc⟩ := hc
      have hnok := hok g List.mem_cons_self
      have hnone : (simplifyGate g.op (m + acc.2.length)
          (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1 = none := by
        apply simplifyGate_none_of_const
        · exact hnok.1.1
        · simpa using hnok.1.2
        · intro h; simpa using hnok.2 h
        · exact ⟨c, List.mem_map.2 ⟨k, hkg, hc⟩⟩
      have h2 : (elimStep m acc g).2.length = acc.2.length := by
        simp only [elimStep, hnone, Option.toList_none, List.append_nil]
      have hfilt : 1 ≤ (gs.filter (fun g => decide (k ∈ g.inputs))).length := by
        simp [hkg] at htwo
        omega
      have hex' : ∃ g' ∈ gs, k ∈ g'.inputs := by
        have hne : gs.filter (fun g => decide (k ∈ g.inputs)) ≠ [] := by
          intro hnil; rw [hnil] at hfilt; simp at hfilt
        obtain ⟨g', hg'⟩ := List.exists_mem_of_ne_nil _ hne
        rw [List.mem_filter] at hg'
        exact ⟨g', hg'.1, of_decide_eq_true hg'.2⟩
      have h1 := elimPass_len_lt m k gs (elimStep m acc g)
        (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg'))
        (by simp [elimStep]; omega)
        ⟨c, by simp only [elimStep]; rw [getD_snoc_lt _ _ _ _ hk]; exact hc⟩
        hex'
      omega
    · have htwo' : 2 ≤ (gs.filter (fun g => decide (k ∈ g.inputs))).length := by
        simpa [hkg] using htwo
      have h1 := ih (elimStep m acc g) (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg'))
        (by simp [elimStep]; omega)
        (by
          obtain ⟨c, hc⟩ := hc
          exact ⟨c, by simp only [elimStep]; rw [getD_snoc_lt _ _ _ _ hk]; exact hc⟩)
        htwo'
      have h2 : (elimStep m acc g).2.length ≤ acc.2.length + 1 := by
        simp only [elimStep, List.length_append]
        have := toList_opt_len_le (simplifyGate g.op (m + acc.2.length)
          (g.inputs.map fun i => acc.1.getD i (Sum.inl false))).1
        omega
      omega

private def ElimInv (m : ℕ) (w_in w_old : List Bool)
    (acc : List (Bool ⊕ ℕ) × List Gate) : Prop :=
  w_in.length = m ∧
  acc.1.length = w_old.length ∧
  ∀ i : ℕ,
    statValid (m + acc.2.length) (acc.1.getD i (Sum.inl false)) ∧
    statVal (wiresFrom acc.2 w_in) (acc.1.getD i (Sum.inl false)) = w_old.getD i false

private lemma elimInv_step (m : ℕ) (w_in w_old : List Bool)
    (acc : List (Bool ⊕ ℕ) × List Gate) (g : Gate) (hok : OkGate g)
    (hinv : ElimInv m w_in w_old acc) :
    ElimInv m w_in (w_old ++ [g.op.eval (g.inputs.map fun i => w_old.getD i false)])
      (elimStep m acc g) := by
  obtain ⟨hwin, hlen, hi⟩ := hinv
  set w_new := wiresFrom acc.2 w_in with hw_new
  have hw_len : w_new.length = m + acc.2.length := by
    rw [hw_new, wiresFrom_length, hwin]
  set ins := g.inputs.map fun i => acc.1.getD i (Sum.inl false) with hins
  have hins_len : ins.length ≤ 2 := by simp [hins]; exact hok.2
  have hins_val : ∀ s ∈ ins, statValid w_new.length s := by
    intro s hs
    obtain ⟨idx, _, rfl⟩ := List.mem_map.1 hs
    rw [hw_len]
    exact (hi idx).1
  have hsound := simplifyGate_sound g.op hok.1 w_new ins hins_len hins_val
  rw [hw_len] at hsound
  refine ⟨hwin, by simp [elimStep, hlen], ?_⟩
  intro i
  simp only [elimStep]
  by_cases hieq : i = acc.1.length
  · rw [getD_snoc_eq _ _ _ _ hieq, getD_snoc_eq _ _ _ _ (by omega)]
    refine ⟨?_, ?_⟩
    · rw [List.length_append, ← Nat.add_assoc]
      exact hsound.1
    · rw [wiresFrom_append, ← hw_new, hsound.2]
      congr 1
      rw [hins, List.map_map]
      apply List.map_congr_left
      intro idx _
      exact (hi idx).2
  · rw [getD_snoc_ne _ _ _ _ hieq, getD_snoc_ne _ _ _ _ (by omega)]
    have ⟨hv, hval⟩ := hi i
    refine ⟨?_, ?_⟩
    · cases hst : acc.1.getD i (Sum.inl false) with
      | inl c => trivial
      | inr j =>
        rw [hst] at hv
        simp only [statValid, List.length_append] at hv ⊢
        omega
    · cases hst : acc.1.getD i (Sum.inl false) with
      | inl c =>
        rw [hst] at hval
        exact hval
      | inr j =>
        rw [hst] at hv hval
        simp only [statValid] at hv
        simp only [statVal] at hval ⊢
        rw [wiresFrom_append, ← hw_new, wiresFrom_getD_lt _ _ _ (by omega)]
        exact hval

private lemma elimInv_pass (m : ℕ) (w_in : List Bool) (gs : List Gate)
    (w_old : List Bool) (acc : List (Bool ⊕ ℕ) × List Gate)
    (hok : ∀ g ∈ gs, OkGate g) (hinv : ElimInv m w_in w_old acc) :
    ElimInv m w_in (wiresFrom gs w_old) (elimPass m gs acc) := by
  induction gs generalizing w_old acc with
  | nil => exact hinv
  | cons g gs ih =>
    rw [wiresFrom_cons, elimPass_cons]
    exact ih _ _ (fun g' hg' => hok g' (List.mem_cons_of_mem _ hg'))
      (elimInv_step m w_in w_old acc g (hok g List.mem_cons_self) hinv)

private lemma ofFn_getD_lt {α : Type*} {m : ℕ} (f : Fin m → α) (d : α) (i : ℕ) (hi : i < m) :
    (List.ofFn f).getD i d = f ⟨i, hi⟩ := by
  rw [List.getD_eq_getElem _ _ (by simp; exact hi), List.getElem_ofFn]

private def initVar (m : ℕ) (v : Fin m) (b : Bool) : List (Bool ⊕ ℕ) :=
  List.ofFn fun i : Fin m => if i = v then Sum.inl b else Sum.inr (i : ℕ)

private lemma elimInv_initVar (m : ℕ) (v : Fin m) (b : Bool) (x : Fin m → Bool) :
    ElimInv m (List.ofFn x) (List.ofFn (Function.update x v b)) (initVar m v b, []) := by
  refine ⟨by simp, by simp [initVar], ?_⟩
  intro i
  by_cases hi : i < m
  · have hget : (initVar m v b).getD i (Sum.inl false) =
        if (⟨i, hi⟩ : Fin m) = v then Sum.inl b else Sum.inr i := by
      rw [initVar, ofFn_getD_lt _ _ _ hi]
    rw [hget]
    by_cases heq : (⟨i, hi⟩ : Fin m) = v
    · simp only [heq, ↓reduceIte, statValid, statVal]
      rw [ofFn_getD_lt _ _ _ hi, heq, Function.update_self]
      exact ⟨trivial, rfl⟩
    · simp only [heq, ↓reduceIte, statValid, statVal, wiresFrom_nil]
      refine ⟨by omega, ?_⟩
      rw [ofFn_getD_lt _ _ _ hi, ofFn_getD_lt _ _ _ hi, Function.update_of_ne heq]
  · rw [List.getD_eq_default _ _ (by simp [initVar]; omega),
        List.getD_eq_default _ _ (by simp; omega)]
    exact ⟨trivial, rfl⟩

private lemma simplifyGate_or_true (m : ℕ) (ins : List (Bool ⊕ ℕ))
    (hlen : ins.length ≤ 2) (ht : Sum.inl true ∈ ins) :
    simplifyGate GateOp.or m ins = (none, Sum.inl true) := by
  rcases ins with _ | ⟨a, _ | ⟨b, _ | ⟨d, l⟩⟩⟩
  · simp at ht
  · cases a <;> simp_all [simplifyGate, simpOr]
  · cases a with
    | inl c =>
      cases b with
      | inl d => cases c <;> cases d <;> simp_all [simplifyGate, simpOr]
      | inr j => cases c <;> simp_all [simplifyGate, simpOr]
    | inr i =>
      cases b with
      | inl d => cases d <;> simp_all [simplifyGate, simpOr]
      | inr j => simp at ht
  · simp at hlen

private lemma elimPass_nil (m : ℕ) (acc : List (Bool ⊕ ℕ) × List Gate) :
    elimPass m [] acc = acc := rfl

private lemma wiresFrom_agree (gs : List Gate) (B : Set ℕ) (w₁ w₂ : List Bool)
    (hlen : w₁.length = w₂.length) (hB : ∀ b ∈ B, b < w₁.length)
    (hagree : ∀ i ∉ B, w₁.getD i false = w₂.getD i false)
    (hread : ∀ g ∈ gs, ∀ i ∈ g.inputs, i ∉ B) :
    (wiresFrom gs w₁).length = (wiresFrom gs w₂).length ∧
    ∀ i ∉ B, (wiresFrom gs w₁).getD i false = (wiresFrom gs w₂).getD i false := by
  induction gs generalizing w₁ w₂ with
  | nil => exact ⟨hlen, hagree⟩
  | cons g gs ih =>
    rw [wiresFrom_cons, wiresFrom_cons]
    have hmap : (g.inputs.map fun i => w₁.getD i false) =
        (g.inputs.map fun i => w₂.getD i false) := by
      apply List.map_congr_left
      intro i hi
      exact hagree i (hread g List.mem_cons_self i hi)
    rw [hmap]
    apply ih
    · simp [hlen]
    · intro b hb; simp; have := hB b hb; omega
    · intro i hi
      by_cases hlt : i < w₁.length
      · rw [getD_snoc_lt _ _ _ _ hlt, getD_snoc_lt _ _ _ _ (by omega)]
        exact hagree i hi
      · by_cases heq : i = w₁.length
        · rw [getD_snoc_eq _ _ _ _ heq, getD_snoc_eq _ _ _ _ (by omega)]
        · rw [List.getD_eq_default _ _ (by simp; omega),
              List.getD_eq_default _ _ (by simp; omega)]
    · intro g' hg'
      exact hread g' (List.mem_cons_of_mem _ hg')

private lemma elim_one_var {m s : ℕ} {F : (Fin m → Bool) → Bool} (v : Fin m) (b : Bool)
    (hC : HasCircuitSize m F s)
    (hdep : ∃ x : Fin m → Bool, F (Function.update x v false) ≠ F (Function.update x v true))
    (hnc : ∃ x x' : Fin m → Bool, F (Function.update x v b) ≠ F (Function.update x' v b)) :
    1 ≤ s ∧ HasCircuitSize m (fun x => F (Function.update x v b)) (s - 1) := by
  obtain ⟨C, hok, hsz, hev⟩ := hC
  set gs := C.gates.map normGate with hgs
  have hnok : ∀ g ∈ gs, NOkGate g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok g0 (hok g0 hg0)
  have hout_ne : C.output ≠ (v : ℕ) := by
    intro heq
    obtain ⟨x, x', hne⟩ := hnc
    have h1 := hev (Function.update x v b)
    have h2 := hev (Function.update x' v b)
    have hw1 : (C.wires (List.ofFn (Function.update x v b))).getD (v : ℕ) false = b := by
      show (wiresFrom C.gates (List.ofFn (Function.update x v b))).getD (v : ℕ) false = b
      rw [wiresFrom_getD_lt _ _ _ (by simp), ofFn_getD_lt _ _ _ v.isLt]
      simp
    have hw2 : (C.wires (List.ofFn (Function.update x' v b))).getD (v : ℕ) false = b := by
      show (wiresFrom C.gates (List.ofFn (Function.update x' v b))).getD (v : ℕ) false = b
      rw [wiresFrom_getD_lt _ _ _ (by simp), ofFn_getD_lt _ _ _ v.isLt]
      simp
    have e1 : F (Function.update x v b) = b := by
      rw [← h1]; show (C.wires _).getD C.output false = b; rw [heq]; exact hw1
    have e2 : F (Function.update x' v b) = b := by
      rw [← h2]; show (C.wires _).getD C.output false = b; rw [heq]; exact hw2
    exact hne (e1.trans e2.symm)
  have hex : ∃ g ∈ gs, (v : ℕ) ∈ g.inputs := by
    by_contra hno
    have hno' : ∀ g ∈ gs, (v : ℕ) ∉ g.inputs := fun g hg hv => hno ⟨g, hg, hv⟩
    obtain ⟨x, hne⟩ := hdep
    have hag := wiresFrom_agree gs {(v : ℕ)}
      (List.ofFn (Function.update x v false))
      (List.ofFn (Function.update x v true))
      (by simp)
      (by intro u hu; simp at hu; subst hu; simp)
      (by
        intro i hi
        simp at hi
        by_cases hlt : i < m
        · have hne' : (⟨i, hlt⟩ : Fin m) ≠ v := by
            intro h; apply hi; exact congrArg Fin.val h
          rw [ofFn_getD_lt _ _ _ hlt, ofFn_getD_lt _ _ _ hlt,
              Function.update_of_ne hne', Function.update_of_ne hne']
        · rw [List.getD_eq_default _ _ (by simp; omega),
              List.getD_eq_default _ _ (by simp; omega)])
      (by
        intro g hg i hi hmem
        simp at hmem
        subst hmem
        exact hno' g hg hi)
    have hco : C.output ∉ ({(v : ℕ)} : Set ℕ) := by simpa using hout_ne
    have hEq := hag.2 C.output hco
    rw [hgs, wiresFrom_norm, wiresFrom_norm] at hEq
    exact hne ((hev _).symm.trans (hEq.trans (hev _)))
  set acc := elimPass m gs (initVar m v b, []) with hacc
  have hlen : acc.2.length + 1 ≤ gs.length := by
    have := elimPass_len_lt m (v : ℕ) gs (initVar m v b, []) hnok
      (by simp [initVar])
      ⟨b, by rw [initVar, ofFn_getD_lt _ _ _ v.isLt]; simp⟩
      hex
    rw [← hacc] at this
    simpa using this
  have hgs_len : gs.length = C.gates.length := by simp [hgs]
  have hsz' : C.gates.length ≤ s := hsz
  have hval : ∀ x : Fin m → Bool,
      statVal (wiresFrom acc.2 (List.ofFn x)) (acc.1.getD C.output (Sum.inl false)) =
        F (Function.update x v b) := by
    intro x
    have hinv := elimInv_pass m (List.ofFn x) gs _ (initVar m v b, [])
      (fun g hg => (hnok g hg).1) (elimInv_initVar m v b x)
    rw [← hacc] at hinv
    rw [(hinv.2.2 C.output).2, hgs, wiresFrom_norm]
    exact hev (Function.update x v b)
  cases hst : acc.1.getD C.output (Sum.inl false) with
  | inl c =>
    obtain ⟨x, x', hne⟩ := hnc
    have hx := hval x; have hx' := hval x'
    rw [hst] at hx hx'
    exact absurd (hx.symm.trans hx') hne
  | inr j =>
    refine ⟨by omega, ⟨acc.2, j⟩, elimPass_ok m gs _ (by simp), ?_, ?_⟩
    · show acc.2.length ≤ s - 1
      omega
    · intro x
      have := hval x
      rw [hst] at this
      exact this

private lemma list_split_unique_filter {α : Type*} (p : α → Bool) (l : List α)
    (h : (l.filter p).length = 1) :
    ∃ l₁ a l₂, l = l₁ ++ [a] ++ l₂ ∧ p a = true ∧
      (∀ x ∈ l₁, p x = false) ∧ (∀ x ∈ l₂, p x = false) := by
  induction l with
  | nil => simp at h
  | cons x xs ih =>
    cases hpx : p x with
    | true =>
      have h0 : (xs.filter p).length = 0 := by
        simp only [List.filter_cons, hpx, ↓reduceIte, List.length_cons] at h
        omega
      have hnil : xs.filter p = [] := List.eq_nil_of_length_eq_zero h0
      refine ⟨[], x, xs, rfl, hpx, by simp, ?_⟩
      intro y hy
      by_contra hpy
      have hpyt : p y = true := by cases hp : p y <;> simp_all
      have : y ∈ xs.filter p := List.mem_filter.2 ⟨hy, hpyt⟩
      rw [hnil] at this
      simp at this
    | false =>
      have h1 : (xs.filter p).length = 1 := by
        simpa [hpx] using h
      obtain ⟨l₁, a, l₂, rfl, hpa, hl₁, hl₂⟩ := ih h1
      refine ⟨x :: l₁, a, l₂, by simp, hpa, ?_, hl₂⟩
      intro y hy
      rcases List.mem_cons.1 hy with rfl | hy'
      · exact hpx
      · exact hl₁ y hy'

private lemma elim_two_var {m s : ℕ} {F : (Fin m → Bool) → Bool} (v : Fin m)
    (hC : HasCircuitSize m F s)
    (hdep : ∃ x : Fin m → Bool, F (Function.update x v false) ≠ F (Function.update x v true))
    (hnc0 : ∃ x x' : Fin m → Bool,
      F (Function.update x v false) ≠ F (Function.update x' v false))
    (hnc1 : ∃ x x' : Fin m → Bool,
      F (Function.update x v true) ≠ F (Function.update x' v true)) :
    2 ≤ s ∧ (HasCircuitSize m (fun x => F (Function.update x v false)) (s - 2) ∨
      HasCircuitSize m (fun x => F (Function.update x v true)) (s - 2)) := by
  obtain ⟨C, hok, hsz, hev⟩ := hC
  set gs := C.gates.map normGate with hgs
  have hnok : ∀ g ∈ gs, NOkGate g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok g0 (hok g0 hg0)
  have hgs_len : gs.length = C.gates.length := by simp [hgs]
  have hsz' : C.gates.length ≤ s := hsz
  have hout_ne : C.output ≠ (v : ℕ) := by
    intro heq
    obtain ⟨x, x', hne⟩ := hnc0
    have h1 := hev (Function.update x v false)
    have h2 := hev (Function.update x' v false)
    have hw1 : (C.wires (List.ofFn (Function.update x v false))).getD (v : ℕ) false = false := by
      show (wiresFrom C.gates (List.ofFn (Function.update x v false))).getD (v : ℕ) false = false
      rw [wiresFrom_getD_lt _ _ _ (by simp), ofFn_getD_lt _ _ _ v.isLt]
      simp
    have hw2 : (C.wires (List.ofFn (Function.update x' v false))).getD (v : ℕ) false = false := by
      show (wiresFrom C.gates (List.ofFn (Function.update x' v false))).getD (v : ℕ) false = false
      rw [wiresFrom_getD_lt _ _ _ (by simp), ofFn_getD_lt _ _ _ v.isLt]
      simp
    have e1 : F (Function.update x v false) = false := by
      rw [← h1]; show (C.wires _).getD C.output false = false; rw [heq]; exact hw1
    have e2 : F (Function.update x' v false) = false := by
      rw [← h2]; show (C.wires _).getD C.output false = false; rw [heq]; exact hw2
    exact hne (e1.trans e2.symm)
  set cnt := (gs.filter (fun g => decide ((v : ℕ) ∈ g.inputs))).length with hcnt
  by_cases hge2 : 2 ≤ cnt
  · set acc := elimPass m gs (initVar m v false, []) with hacc
    have hlen : acc.2.length + 2 ≤ gs.length := by
      have := elimPass_len_two m (v : ℕ) gs (initVar m v false, []) hnok
        (by simp [initVar])
        ⟨false, by rw [initVar, ofFn_getD_lt _ _ _ v.isLt]; simp⟩
        (by rw [← hcnt]; exact hge2)
      rw [← hacc] at this
      simpa using this
    have hval : ∀ x : Fin m → Bool,
        statVal (wiresFrom acc.2 (List.ofFn x)) (acc.1.getD C.output (Sum.inl false)) =
          F (Function.update x v false) := by
      intro x
      have hinv := elimInv_pass m (List.ofFn x) gs _ (initVar m v false, [])
        (fun g hg => (hnok g hg).1) (elimInv_initVar m v false x)
      rw [← hacc] at hinv
      rw [(hinv.2.2 C.output).2, hgs, wiresFrom_norm]
      exact hev (Function.update x v false)
    cases hst : acc.1.getD C.output (Sum.inl false) with
    | inl c =>
      obtain ⟨x, x', hne⟩ := hnc0
      have hx := hval x; have hx' := hval x'
      rw [hst] at hx hx'
      exact absurd (hx.symm.trans hx') hne
    | inr j =>
      refine ⟨by omega, Or.inl ⟨⟨acc.2, j⟩, elimPass_ok m gs _ (by simp), ?_, ?_⟩⟩
      · show acc.2.length ≤ s - 2; omega
      · intro x; have := hval x; rw [hst] at this; exact this
  · by_cases hzero : cnt = 0
    · exfalso
      have hnil : gs.filter (fun g => decide ((v : ℕ) ∈ g.inputs)) = [] :=
        List.eq_nil_of_length_eq_zero (by rw [← hcnt]; exact hzero)
      obtain ⟨x, hne⟩ := hdep
      have hag := wiresFrom_agree gs {(v : ℕ)}
        (List.ofFn (Function.update x v false))
        (List.ofFn (Function.update x v true))
        (by simp)
        (by intro u hu; simp at hu; subst hu; simp)
        (by
          intro i hi; simp at hi
          by_cases hlt : i < m
          · have hne' : (⟨i, hlt⟩ : Fin m) ≠ v := by
              intro h; apply hi; exact congrArg Fin.val h
            rw [ofFn_getD_lt _ _ _ hlt, ofFn_getD_lt _ _ _ hlt,
                Function.update_of_ne hne', Function.update_of_ne hne']
          · rw [List.getD_eq_default _ _ (by simp; omega),
                List.getD_eq_default _ _ (by simp; omega)])
        (by
          intro g hg i hi hmem
          simp at hmem; subst hmem
          have : g ∈ gs.filter (fun g => decide ((v : ℕ) ∈ g.inputs)) :=
            List.mem_filter.2 ⟨hg, decide_eq_true hi⟩
          rw [hnil] at this; simp at this)
      have hEq := hag.2 C.output (by simpa using hout_ne)
      rw [hgs, wiresFrom_norm, wiresFrom_norm] at hEq
      exact hne ((hev _).symm.trans (hEq.trans (hev _)))
    · have hone : (gs.filter (fun g => decide ((v : ℕ) ∈ g.inputs))).length = 1 := by
        rw [← hcnt]; omega
      have hsp := list_split_unique_filter (fun g => decide ((v : ℕ) ∈ g.inputs)) gs hone
      rcases hsp with ⟨gs₁, g₁, gs₂, hsplit, hg₁in, hgs₁no, hgs₂no⟩
      have hv_in : (v : ℕ) ∈ g₁.inputs := of_decide_eq_true hg₁in
      have hnok₁ : NOkGate g₁ := hnok g₁ (by rw [hsplit]; simp)
      set b : Bool := match g₁.op with | GateOp.or => true | _ => false with hb
      have hncb : ∃ x x' : Fin m → Bool,
          F (Function.update x v b) ≠ F (Function.update x' v b) := by
        cases hbc : b with
        | false => exact hnc0
        | true => exact hnc1
      set acc₁ := elimPass m gs₁ (initVar m v b, []) with hacc₁
      set accM := elimStep m acc₁ g₁ with haccM
      set acc := elimPass m gs₂ accM with hacc
      have hacc_eq : acc = elimPass m gs (initVar m v b, []) := by
        rw [hsplit, elimPass_append, elimPass_append, ← hacc₁, elimPass_cons, elimPass_nil, ← haccM]
      have hacc₁_len : acc₁.1.length = m + gs₁.length := by
        rw [hacc₁, elimPass_fst_len]; simp [initVar]
      have hacc₁_v : acc₁.1.getD (v : ℕ) (Sum.inl false) = Sum.inl b := by
        rw [hacc₁, elimPass_getD_lt _ _ _ _ _ (by simp [initVar])]
        rw [initVar, ofFn_getD_lt _ _ _ v.isLt]
        simp
      have hmid_props : accM.2.length = acc₁.2.length ∧
          ∃ c : Bool, accM.1.getD (m + gs₁.length) (Sum.inl false) = Sum.inl c := by
        have hmem : Sum.inl b ∈ (g₁.inputs.map fun i => acc₁.1.getD i (Sum.inl false)) :=
          List.mem_map.2 ⟨(v : ℕ), hv_in, hacc₁_v⟩
        have hres : ∃ c : Bool,
            simplifyGate g₁.op (m + acc₁.2.length)
              (g₁.inputs.map fun i => acc₁.1.getD i (Sum.inl false)) = (none, Sum.inl c) := by
          rcases hnok₁.1.1 with hop | hop | hop
          · have : g₁.op = GateOp.and := hop
            have hbf : b = false := by simp [hb, this]
            rw [this]
            rw [hbf] at hmem
            exact ⟨false, simplifyGate_and_false _ _ (by simp; exact hnok₁.1.2) hmem⟩
          · have : g₁.op = GateOp.or := hop
            have hbt : b = true := by simp [hb, this]
            rw [this]
            rw [hbt] at hmem
            exact ⟨true, simplifyGate_or_true _ _ (by simp; exact hnok₁.1.2) hmem⟩
          · have : g₁.op = GateOp.not := hop
            have hbf : b = false := by simp [hb, this]
            have hlen1 : g₁.inputs.length ≤ 1 := hnok₁.2 this
            have hsing : g₁.inputs = [(v : ℕ)] := by
              rcases hgi : g₁.inputs with _ | ⟨a, _ | ⟨d, l⟩⟩
              · rw [hgi] at hv_in; simp at hv_in
              · rw [hgi] at hv_in; simp at hv_in; subst hv_in; rfl
              · rw [hgi] at hlen1; simp at hlen1
            rw [this, hsing, List.map_singleton, hacc₁_v, hbf]
            exact ⟨true, simplifyGate_not_const _ false⟩
        obtain ⟨c, hc⟩ := hres
        refine ⟨by simp only [haccM, elimStep, hc, Option.toList_none, List.append_nil], c, ?_⟩
        simp only [haccM, elimStep, hc]
        exact getD_snoc_eq _ _ _ _ hacc₁_len.symm
      have hval : ∀ x : Fin m → Bool,
          statVal (wiresFrom acc.2 (List.ofFn x)) (acc.1.getD C.output (Sum.inl false)) =
            F (Function.update x v b) := by
        intro x
        have hinv := elimInv_pass m (List.ofFn x) gs _ (initVar m v b, [])
          (fun g hg => (hnok g hg).1) (elimInv_initVar m v b x)
        rw [← hacc_eq] at hinv
        rw [(hinv.2.2 C.output).2, hgs, wiresFrom_norm]
        exact hev (Function.update x v b)
      have hout_ne_w1 : C.output ≠ m + gs₁.length := by
        intro heq
        obtain ⟨c, hc⟩ := hmid_props.2
        have hacc_w1 : acc.1.getD C.output (Sum.inl false) = Sum.inl c := by
          rw [heq, hacc, elimPass_getD_lt _ _ _ _ _ (by simp [haccM, elimStep, hacc₁_len])]
          exact hc
        obtain ⟨x, x', hne⟩ := hncb
        have hx := hval x; have hx' := hval x'
        rw [hacc_w1] at hx hx'
        exact hne (hx.symm.trans hx')
      have hex₂ : ∃ g ∈ gs₂, m + gs₁.length ∈ g.inputs := by
        by_contra hno
        have hno' : ∀ g ∈ gs₂, m + gs₁.length ∉ g.inputs := fun g hg hw => hno ⟨g, hg, hw⟩
        obtain ⟨x, hne⟩ := hdep
        have hag₁ := wiresFrom_agree gs₁ {(v : ℕ)}
          (List.ofFn (Function.update x v false))
          (List.ofFn (Function.update x v true))
          (by simp)
          (by intro u hu; simp at hu; subst hu; simp)
          (by
            intro i hi; simp at hi
            by_cases hlt : i < m
            · have hne' : (⟨i, hlt⟩ : Fin m) ≠ v := by
                intro h; apply hi; exact congrArg Fin.val h
              rw [ofFn_getD_lt _ _ _ hlt, ofFn_getD_lt _ _ _ hlt,
                  Function.update_of_ne hne', Function.update_of_ne hne']
            · rw [List.getD_eq_default _ _ (by simp; omega),
                  List.getD_eq_default _ _ (by simp; omega)])
          (by
            intro g hg i hi hmem
            simp at hmem; subst hmem
            have := hgs₁no g hg
            simp [hi] at this)
        set w0 := wiresFrom gs₁ (List.ofFn (Function.update x v false))
        set w1 := wiresFrom gs₁ (List.ofFn (Function.update x v true))
        have hw0_len : w0.length = m + gs₁.length := by simp [w0, wiresFrom_length]
        have hw1_len : w1.length = m + gs₁.length := by simp [w1, wiresFrom_length]
        have hag₂ := wiresFrom_agree gs₂ {(v : ℕ), m + gs₁.length}
          (wiresFrom [g₁] w0) (wiresFrom [g₁] w1)
          (by simp [wiresFrom_length, hw0_len, hw1_len])
          (by
            intro u hu
            rcases hu with rfl | rfl
            · simp [wiresFrom_length, hw0_len]; omega
            · simp [wiresFrom_length, hw0_len])
          (by
            intro i hi
            have hiv : i ≠ (v : ℕ) := fun h => hi (Or.inl h)
            have hiw : i ≠ m + gs₁.length := fun h => hi (Or.inr h)
            simp only [wiresFrom_cons, wiresFrom_nil]
            rw [getD_snoc_ne _ _ _ _ (by omega), getD_snoc_ne _ _ _ _ (by omega)]
            exact hag₁.2 i (by simpa using hiv))
          (by
            intro g hg i hi hmem
            rcases hmem with rfl | rfl
            · have := hgs₂no g hg; simp [hi] at this
            · exact hno' g hg hi)
        have hco : C.output ∉ ({(v : ℕ), m + gs₁.length} : Set ℕ) := by
          intro h; rcases h with h | h
          · exact hout_ne h
          · exact hout_ne_w1 h
        have hEq := hag₂.2 C.output hco
        have hrew0 : wiresFrom gs₂ (wiresFrom [g₁] w0) =
            wiresFrom gs (List.ofFn (Function.update x v false)) := by
          rw [hsplit, wiresFrom_append, wiresFrom_append]
        have hrew1 : wiresFrom gs₂ (wiresFrom [g₁] w1) =
            wiresFrom gs (List.ofFn (Function.update x v true)) := by
          rw [hsplit, wiresFrom_append, wiresFrom_append]
        rw [hrew0, hrew1, hgs, wiresFrom_norm, wiresFrom_norm] at hEq
        exact hne ((hev _).symm.trans (hEq.trans (hev _)))
      have hlen₂ := elimPass_len_lt m (m + gs₁.length) gs₂ accM
        (fun g hg => hnok g (by rw [hsplit]; simp [hg]))
        (by simp [haccM, elimStep, hacc₁_len])
        hmid_props.2
        hex₂
      rw [← hacc] at hlen₂
      have hlen₁ : acc₁.2.length ≤ gs₁.length := by
        have := elimPass_len m gs₁ (initVar m v b, [])
        rw [← hacc₁] at this; simpa using this
      have hsplit_len : gs.length = gs₁.length + 1 + gs₂.length := by
        rw [hsplit]; simp; omega
      have htot : acc.2.length + 2 ≤ gs.length := by omega
      cases hst : acc.1.getD C.output (Sum.inl false) with
      | inl c =>
        obtain ⟨x, x', hne⟩ := hncb
        have hx := hval x; have hx' := hval x'
        rw [hst] at hx hx'
        exact absurd (hx.symm.trans hx') hne
      | inr j =>
        have hres : HasCircuitSize m (fun x => F (Function.update x v b)) (s - 2) := by
          refine ⟨⟨acc.2, j⟩, ?_, ?_, ?_⟩
          · rw [hacc_eq]; exact elimPass_ok m gs _ (by simp)
          · show acc.2.length ≤ s - 2; omega
          · intro x; have := hval x; rw [hst] at this; exact this
        refine ⟨by omega, ?_⟩
        cases hbc : b with
        | false => rw [hbc] at hres; exact Or.inl hres
        | true => rw [hbc] at hres; exact Or.inr hres

end PathGateReduction
namespace Path574
open PEqualNP.MetaComplexity

private abbrev indep {m : ℕ} (F : (Fin m → Bool) → Bool) (p : Fin m) : Prop :=
  ∀ x b, F (Function.update x p b) = F x

private abbrev varies {m : ℕ} (F : (Fin m → Bool) → Bool) : Prop := ∃ x y, F x ≠ F y

private theorem peel_one {m s : ℕ} (B : (Fin m → Bool) → Bool) (p q : Fin m) (hpq : p ≠ q)
    (safe : indep B p) (variesB : varies B) (possible : ∃ x, B x = false ∧ x q = true)
    (size : HasCircuitSize m (fun x => B x || (x p && x q)) s) :
    ∃ a, a+1 ≤ s ∧ HasCircuitSize m B a := by
  let F (x : Fin m → Bool) := B x || (x p && x q)
  have off (x : Fin m → Bool) : F (Function.update x p false) = B x := by simp [F,safe]
  have on (x : Fin m → Bool) : F (Function.update x p true) = (B x || x q) := by
    simp [F, safe, Function.update_of_ne hpq.symm]
  obtain ⟨x,hx,hq⟩ := possible
  obtain ⟨a,b,hab⟩ := variesB
  have ⟨h,hs⟩ := PathGateReduction.elim_one_var (F:=F) p false size
    ⟨x,by simp [off,on,hx,hq]⟩ ⟨a,b,by simpa only [off] using hab⟩
  exact ⟨s-1,by omega,by simpa only [off] using hs⟩

private theorem peel_two {m s : ℕ} (B : (Fin m → Bool) → Bool) (p q t : Fin m)
    (hpq : p ≠ q) (hpt : p ≠ t) (hqt : q ≠ t) (bp : indep B p) (bq : indep B q)
    (vb : varies B) (possible : ∃ x, B x = false ∧ x t = false)
    (size : HasCircuitSize m (fun x => B x || (x q && (x t || x p))) s) :
    (∃ a, a+2 ≤ s ∧ HasCircuitSize m (fun x => B x || (x q && x t)) a) ∨
    (∃ a, a+3 ≤ s ∧ HasCircuitSize m B a) := by
  let F (x : Fin m → Bool) := B x || (x q && (x t || x p))
  let J (x : Fin m → Bool) := B x || x q
  have off (x : Fin m → Bool) : F (Function.update x p false) = (B x || (x q && x t)) := by
    simp [F,bp,Function.update_of_ne hpq.symm,Function.update_of_ne hpt.symm]
  have on (x : Fin m → Bool) : F (Function.update x p true) = J x := by
    simp [F,J,bp,Function.update_of_ne hpq.symm]
  have zero (x : Fin m → Bool) : J (Function.update x q false) = B x := by simp [J,bq]
  have atzero (x : Fin m → Bool) :
      F (Function.update (Function.update x q false) p false) = B x := by simp [off,bq]
  obtain ⟨x,hx,ht⟩ := possible
  obtain ⟨a,b,hab⟩ := vb
  have hdep : ∃ y, F (Function.update y p false) ≠ F (Function.update y p true) := by
    refine ⟨Function.update x q true,?_⟩
    simp [off,on,J,bq,hx,Function.update_of_ne hqt.symm,ht]
  obtain ⟨hsz,hs | hs⟩ := PathGateReduction.elim_two_var (F:=F) p size hdep
    ⟨Function.update a q false, Function.update b q false, by simpa only [atzero] using hab⟩
    ⟨Function.update a q false, Function.update b q false, by simpa only [on,zero] using hab⟩
  · exact Or.inl ⟨s-2,by omega,by simpa only [off] using hs⟩
  · have hj : HasCircuitSize m J (s-2) := by simpa only [on] using hs
    have hdepJ : ∃ y, J (Function.update y q false) ≠ J (Function.update y q true) :=
      ⟨x,by simp [J,bq,hx]⟩
    obtain ⟨h,hd⟩ := PathGateReduction.elim_one_var (F:=J) q false hj hdepJ ⟨a,b,by simpa only [zero] using hab⟩
    exact Or.inr ⟨s-2-1,by omega,by simpa only [zero] using hd⟩

end Path574
namespace Path574

private def arm {m : ℕ} (x : Fin m → Bool) (root : Fin m) : List (Fin m) → Bool
  | [] => false
  | p::ps => (x root && x p) || arm x p ps

end Path574
namespace Path574

private theorem arm_congr {m : ℕ} (x y : Fin m → Bool) (r : Fin m) (xs : List (Fin m))
    (hr : x r = y r) (hxs : ∀ i∈xs, x i = y i) : arm x r xs = arm y r xs := by
  induction xs generalizing r with
  | nil => rfl
  | cons p ps ih =>
    have hp := hxs p (by simp)
    rw [arm, arm, hr, hp, ih p hp (fun i hi => hxs i (by simp [hi]))]

private theorem arm_zero_on {m : ℕ} (x : Fin m → Bool) (r : Fin m) (xs : List (Fin m))
    (h : ∀ i∈xs, x i = false) : arm x r xs = false := by
  induction xs generalizing r with
  | nil => rfl
  | cons p ps ih => simp [arm,h p (by simp),ih p (fun i hi => h i (by simp [hi]))]

private def tip {α : Type*} (r : α) (xs : List α) : α := xs.foldl (fun _ z => z) r

private theorem arm_snoc {m : ℕ} (x : Fin m → Bool) (r q : Fin m) (xs : List (Fin m)) :
    arm x r (xs++[q]) = (arm x r xs || (x (tip r xs) && x q)) := by
  induction xs generalizing r with
  | nil => simp [arm, tip]
  | cons p ps ih => simp [arm,ih,Bool.or_assoc,tip]

private theorem arm_snoc_pair {m : ℕ} (x : Fin m → Bool) (r q p : Fin m) (xs : List (Fin m)) :
    arm x r (xs++[q,p]) = (arm x r xs || (x q && (x (tip r xs) || x p))) := by
  have h : xs++[q,p] = (xs++[q])++[p] := by simp
  rw [h,arm_snoc,arm_snoc]
  simp only [tip, List.foldl_append, List.foldl_cons, List.foldl_nil]
  cases x q <;> simp [Bool.or_assoc]

private theorem last_in {α : Type*} (xs : List α) (r : α) : tip r xs = r ∨ tip r xs ∈ xs := by
  induction xs generalizing r with
  | nil => exact Or.inl rfl
  | cons p ps ih =>
    change tip p ps = r ∨ tip p ps ∈ p::ps
    rcases ih p with h|h
    · exact Or.inr (List.mem_cons.mpr (Or.inl h))
    · exact Or.inr (List.mem_cons.mpr (Or.inr h))

end Path574
namespace Path574
open PEqualNP.MetaComplexity

private def armsFn {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (L R : List (Fin (N+k))) (x : Fin (N+k) → Bool) : Bool :=
  g (fun i => x (Fin.castAdd k i)) || arm x (Fin.castAdd k u) L || arm x (Fin.castAdd k v) R

private def P {N : ℕ} (k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool) (a b s : ℕ) : Prop :=
  ∃ L R : List (Fin (N+k)), L.length=a ∧ R.length=b ∧
    (∀ j ∈ L++R, N≤j.val) ∧ (L++R).Nodup ∧ HasCircuitSize (N+k) (armsFn u v g L R) s

end Path574
namespace Path574
open PEqualNP.MetaComplexity

private theorem outside_old {N k : ℕ} {p : Fin (N+k)} (hp : N ≤ p.val) (v : Fin N) :
    Fin.castAdd k v ≠ p := by
  intro h
  have hv := congrArg Fin.val h
  change v.val=p.val at hv
  omega

private theorem arms_ignore {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (L R : List (Fin (N+k))) (p : Fin (N+k)) (hp : N ≤ p.val)
    (hL : p ∉ L) (hR : p ∉ R) : indep (armsFn u v g L R) p := by
  intro x b
  have ho (i : Fin N) : Function.update x p b (Fin.castAdd k i) = x (Fin.castAdd k i) :=
    Function.update_of_ne (outside_old hp i) _ _
  have la := arm_congr (Function.update x p b) x (Fin.castAdd k u) L (ho u)
    (fun j hj => Function.update_of_ne (fun (hjp : j=p) => hL (hjp ▸ hj)) _ _)
  have ra := arm_congr (Function.update x p b) x (Fin.castAdd k v) R (ho v)
    (fun j hj => Function.update_of_ne (fun (hjp : j=p) => hR (hjp ▸ hj)) _ _)
  exact congrArg₂ Bool.or (congrArg₂ Bool.or (congrArg g (funext ho)) la) ra

private theorem padding {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (L R : List (Fin (N+k))) (fresh : ∀ j∈L++R, N≤j.val) (y : Fin N → Bool) :
    armsFn u v g L R (Fin.append y (fun _ : Fin k => false)) = g y := by
  let x := Fin.append y (fun _ : Fin k => false)
  have hz (j : Fin (N+k)) (hj : j∈L++R) : x j = false := by
    have hh := fresh j hj
    let i : Fin k := ⟨j.val-N, by have := j.isLt; omega⟩
    have eq : j=Fin.natAdd N i := Fin.ext (by change j.val=N+(j.val-N); omega)
    rw [eq]; exact Fin.append_right _ _ i
  have hL := arm_zero_on x (Fin.castAdd k u) L (fun j hj => hz j (List.mem_append_left R hj))
  have hR := arm_zero_on x (Fin.castAdd k v) R (fun j hj => hz j (List.mem_append_right L hj))
  change (g (fun i => x (Fin.castAdd k i)) || arm x _ L || arm x _ R) = _
  rw [hL,hR]
  simp [x,Fin.append_left]

private theorem arms_vary {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (L R : List (Fin (N+k))) (fresh : ∀ j∈L++R, N≤j.val) (hg : varies g) : varies (armsFn u v g L R) := by
  obtain ⟨x,y,hxy⟩ := hg
  exact ⟨Fin.append x (fun _ => false),Fin.append y (fun _ => false),by simpa only [padding u v g L R fresh] using hxy⟩

private theorem all_zero {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (L R : List (Fin (N+k))) (hg : g (fun _ => false)=false) : armsFn u v g L R (fun _ => false) = false := by
  simp [armsFn,hg,arm_zero_on (fun _ => false) _ _ (fun _ _ => rfl)]

private theorem left_pair_list {N k s : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hg : varies g) (hzero : g (fun _ => false) = false)
    (L R : List (Fin (N+k))) (q p : Fin (N+k))
    (fresh : ∀ j∈(L++[q,p])++R, N≤j.val) (nd : ((L++[q,p])++R).Nodup)
    (hs : HasCircuitSize (N+k) (armsFn u v g (L++[q,p]) R) s) :
    (∃ a, a+2≤s ∧ HasCircuitSize (N+k) (armsFn u v g (L++[q]) R) a) ∨
    (∃ a, a+3≤s ∧ HasCircuitSize (N+k) (armsFn u v g L R) a) := by
  let t := tip (Fin.castAdd k u) L
  have ht := last_in L (Fin.castAdd k u)
  have nq : N≤q.val := fresh _ (by simp)
  have np : N≤p.val := fresh _ (by simp)
  have d := List.nodup_append.mp nd
  have e := List.nodup_append.mp d.1
  have hqL : q ∉ L := fun h => e.2.2 q h q (by simp) rfl
  have hpL : p ∉ L := fun h => e.2.2 p h p (by simp) rfl
  have hqR : q ∉ R := fun h => d.2.2 q (by simp) q h rfl
  have hpR : p ∉ R := fun h => d.2.2 p (by simp) p h rfl
  have hpq : p≠q := by have := e.2.1; simpa [ne_comm] using this
  have hqt : q ≠ t := by rcases ht with eq|hm; exact (eq ▸ (outside_old nq u)).symm; exact fun h => hqL (h ▸ hm)
  have hpt : p ≠ t := by rcases ht with eq|hm; exact (eq ▸ (outside_old np u)).symm; exact fun h => hpL (h ▸ hm)
  have fr (i : Fin (N+k)) (hi : i∈L++R) : N ≤ i.val := by
    apply fresh
    rcases List.mem_append.mp hi with h|h
    · exact List.mem_append_left _ (List.mem_append_left _ h)
    · exact List.mem_append_right _ h
  let B := armsFn u v g L R
  have eq : armsFn u v g (L++[q,p]) R = fun x => B x || (x q && (x t || x p)) := by
    funext x
    simp only [B,armsFn,arm_snoc_pair,t]
    ac_rfl
  obtain ⟨a,ha,hh⟩ | alt := peel_two B p q t hpq hpt hqt (arms_ignore u v g L R p np hpL hpR)
    (arms_ignore u v g L R q nq hqL hqR) (arms_vary u v g L R fr hg)
    ⟨fun _ => false,all_zero u v g L R hzero,rfl⟩ (eq ▸ hs)
  · refine Or.inl ⟨a,ha,?_⟩
    have eq' : armsFn u v g (L++[q]) R = (fun x => B x || (x q && x t)) := by
      funext x
      simp only [B,armsFn,arm_snoc,t]
      rw [Bool.and_comm (x (tip _ _)) (x q)]
      ac_rfl
    exact eq' ▸ hh
  · exact Or.inr alt

private theorem left_single_list {N k s : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hg : varies g) (witness : ∃ y, y u = true ∧ g y = false)
    (R : List (Fin (N+k))) (p : Fin (N+k))
    (fresh : ∀ j∈[p]++R, N≤j.val) (nd : ([p]++R).Nodup)
    (hs : HasCircuitSize (N+k) (armsFn u v g [p] R) s) :
    ∃ a, a+1 ≤ s ∧ HasCircuitSize (N+k) (armsFn u v g [] R) a := by
  have fp := fresh p (by simp)
  have fr : ∀ j∈[]++R, N≤j.val := fun j hj => fresh j (by simp_all)
  have hp : p ∉ R := (List.nodup_cons.mp nd).1
  let B := armsFn u v g [] R
  obtain ⟨y,hy,hy'⟩ := witness
  have eq : armsFn u v g [p] R = fun x => B x || (x p && x (Fin.castAdd k u)) := by
    funext x
    simp only [B,armsFn,arm,Bool.or_false]
    rw [Bool.and_comm (x p) _]
    ac_rfl
  exact peel_one B p (Fin.castAdd k u) (outside_old fp u).symm (arms_ignore u v g [] R p fp (by simp) hp)
    (arms_vary u v g [] R fr hg)
    ⟨Fin.append y (fun _ => false), by simpa [B,padding u v g [] R fr] using hy', by simpa [Fin.append_left] using hy⟩ (eq ▸ hs)

end Path574

namespace PathGateReduction
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

private theorem assign_inputs {n m s : ℕ} {F : (Fin m → Bool) → Bool} {X : (Fin n → Bool) → Bool}
    (assign : Fin m → Bool ⊕ Fin n) (hc : HasCircuitSize m F s)
    (he : ∀ y : Fin n → Bool, F (fun j => (assign j).elim id y) = X y)
    (hnc : ∃ y y', X y ≠ X y') : HasCircuitSize n X s := by
  obtain ⟨C, hok, hsz, hev⟩ := hc
  let gs := C.gates.map normGate
  have hgood : ∀ g ∈ gs, NOkGate g := by
    intro g hg
    obtain ⟨g0, hg0, rfl⟩ := List.mem_map.1 hg
    exact normGate_nok g0 (hok g0 hg0)
  let env (y : Fin n → Bool) (j : Fin m) : Bool := (assign j).elim id y
  let wire (j : Fin m) : Bool ⊕ ℕ := (assign j).map id Fin.val
  let init := List.ofFn wire
  let acc := elimPass n gs (init, [])
  have hinv (y : Fin n → Bool) :
      ElimInv n (List.ofFn y) (wiresFrom gs (List.ofFn (env y))) acc := by
    apply elimInv_pass n (List.ofFn y) gs _ (init, []) (fun g hg => (hgood g hg).1)
    refine ⟨by simp, by simp [init], ?_⟩
    intro i
    by_cases hi : i < m
    · change statValid _ ((List.ofFn wire).getD i _) ∧ _
      rw [ofFn_getD_lt _ _ _ hi]
      change statValid n (wire ⟨i,hi⟩) ∧ statVal (List.ofFn y) (wire ⟨i,hi⟩) = (List.ofFn (env y)).getD i false
      rw [ofFn_getD_lt _ _ _ hi]
      unfold wire env
      cases h : assign ⟨i,hi⟩ with
      | inl _ => exact ⟨trivial,rfl⟩
      | inr a => exact ⟨a.isLt, ofFn_getD_lt _ _ _ a.isLt⟩
    · rw [List.getD_eq_default _ _ (by simp [init]; omega), List.getD_eq_default _ _ (by simp; omega)]
      exact ⟨trivial,rfl⟩
  have hval (y : Fin n → Bool) :
      statVal (wiresFrom acc.2 (List.ofFn y)) (acc.1.getD C.output (.inl false)) = X y := by
    rw [((hinv y).2.2 C.output).2]
    change (wiresFrom (C.gates.map normGate) _).getD _ false = _
    rw [wiresFrom_norm]
    exact (hev _).trans (he y)
  cases hout : acc.1.getD C.output (.inl false) with
  | inl b =>
    obtain ⟨x,y,hxy⟩ := hnc
    have hx := hval x
    have hy := hval y
    rw [hout] at hx hy
    exact (hxy (hx.symm.trans hy)).elim
  | inr j =>
    refine ⟨⟨acc.2,j⟩,elimPass_ok n gs _ (by simp),?_,?_⟩
    · have hh := elimPass_len n gs (init,[])
      change acc.2.length ≤ s
      have hlen : gs.length = C.gates.length := by simp [gs]
      change acc.2.length ≤ [].length + gs.length at hh
      change C.gates.length ≤ s at hsz
      simpa using hh.trans (by simpa [hlen] using hsz)
    · intro x
      have hh := hval x
      rw [hout] at hh
      exact hh

end PathGateReduction

namespace Path574
open PEqualNP.MetaComplexity

private def pendantFn {N : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool) (x : Fin (N+2) → Bool) : Bool :=
  g (fun i => x (Fin.castAdd 2 i)) || (x (Fin.castAdd 2 u) && x (Fin.natAdd N (0 : Fin 2))) ||
    (x (Fin.castAdd 2 v) && x (Fin.natAdd N (1 : Fin 2)))

private theorem P_swap {N k a b s : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (h : P k u v g a b s) : P k v u g b a s := by
  obtain ⟨L,R,hl,hr,hfresh,hnd,hsize⟩ := h
  refine ⟨R,L,hr,hl,?_,hnd.perm List.perm_append_comm,?_⟩
  · intro j hj
    exact hfresh j (List.mem_append.mpr (List.mem_append.mp hj).symm)
  · have he : armsFn v u g R L = armsFn u v g L R := by
      funext x
      simp only [armsFn,Bool.or_assoc]
      rw [Bool.or_comm (arm x (Fin.castAdd k v) R)]
    rwa [he]

private theorem P_base {N k s : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (hg : ∃ x y, g x ≠ g y) (h : P k u v g 0 0 s) : HasCircuitSize N g s := by
  obtain ⟨L,R,hl,hr,_,_,hs⟩ := h
  obtain rfl : L=[] := List.length_eq_zero_iff.mp hl
  obtain rfl : R=[] := List.length_eq_zero_iff.mp hr
  let assn (j : Fin (N+k)) : Bool ⊕ Fin N := if hj : j.val<N then .inr ⟨j.val,hj⟩ else .inl false
  apply PathGateReduction.assign_inputs assn hs _ hg
  intro y
  have ev (i : Fin N) : (assn (Fin.castAdd k i)).elim id y = y i := by simp [assn,i.isLt]
  simp only [armsFn,arm,Bool.or_false,ev]

private theorem P_pendant {N k s : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (hg : ∃ x y, g x ≠ g y) (h : P k u v g 1 1 s) : HasCircuitSize (N+2) (pendantFn u v g) s := by
  obtain ⟨L,R,hl,hr,hfresh,hnd,hs⟩ := h
  obtain ⟨p,rfl⟩ := List.length_eq_one_iff.mp hl
  obtain ⟨q,rfl⟩ := List.length_eq_one_iff.mp hr
  have hp := hfresh p (by simp)
  have hq := hfresh q (by simp)
  have hpq : p≠q := by simpa using hnd
  let assn (j : Fin (N+k)) : Bool ⊕ Fin (N+2) :=
    if hj : j.val<N then .inr (Fin.castAdd 2 ⟨j.val,hj⟩)
    else if j=p then .inr (Fin.natAdd N (0:Fin 2))
    else if j=q then .inr (Fin.natAdd N (1:Fin 2)) else .inl false
  apply PathGateReduction.assign_inputs assn hs
  · intro y
    have ev (i : Fin N) : (assn (Fin.castAdd k i)).elim id y = y (Fin.castAdd 2 i) := by
      simp [assn,i.isLt]
      rfl
    have ep : (assn p).elim id y = y (Fin.natAdd N (0:Fin 2)) := by
      simp [assn, show ¬p.val<N by omega]
    have eq : (assn q).elim id y = y (Fin.natAdd N (1:Fin 2)) := by
      simp [assn, show ¬q.val<N by omega, hpq.symm]
    simp only [armsFn,arm,pendantFn,Bool.or_false,ev,ep,eq]
  · obtain ⟨y,z,hy⟩ := hg
    let lift (x : Fin N → Bool) : Fin (N+2) → Bool :=
      Fin.addCases (motive:=fun _ => Bool) x (fun _=>false)
    have he (x : Fin N → Bool) : pendantFn u v g (lift x) = g x := by
      simp [pendantFn,lift,Fin.addCases_right]
    exact ⟨lift y,lift z,by simpa only [he] using hy⟩

end Path574

namespace OddPath574

private theorem strip_arm (P : ℕ → ℕ → Prop)
    (one : ∀ s, P 1 s → ∃ t, t+1 ≤ s ∧ P 0 t)
    (step : ∀ k s, P (k+2) s →
      (∃ t, t+2 ≤ s ∧ P (k+1) t) ∨ (∃ t, t+3 ≤ s ∧ P k t)) :
    ∀ h, (∀ s, P (2*h) s → ∃ t, 3*h+t ≤ s ∧ P 0 t) ∧
      (∀ s, P (2*h+1) s → (∃ t, 3*h+2+t ≤ s ∧ P 0 t) ∨
        (∃ t, 3*h+t ≤ s ∧ P 1 t)) := by
  intro h
  induction h with
  | zero =>
    exact ⟨fun s hp => ⟨s,by omega,hp⟩, fun s hp => Or.inr ⟨s,by omega,hp⟩⟩
  | succ h ih =>
    obtain ⟨even,odd⟩ := ih
    have nextEven (s : ℕ) (hp : P (2*(h+1)) s) : ∃ t, 3*(h+1)+t ≤ s ∧ P 0 t := by
      rw [show 2*(h+1)=2*h+2 by omega] at hp
      rcases step _ _ hp with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
      · rcases odd _ hp with ⟨a,ha,hp⟩|⟨a,ha,hp⟩
        · exact ⟨a,by omega,hp⟩
        · obtain ⟨b,hb,hp⟩ := one _ hp
          exact ⟨b,by omega,hp⟩
      · obtain ⟨a,ha,hp⟩ := even _ hp
        exact ⟨a,by omega,hp⟩
    refine ⟨nextEven,?_⟩
    intro s hp
    rw [show 2*(h+1)+1 = (2*h+1)+2 by omega] at hp
    rcases step _ _ hp with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
    · rw [show 2*h+1+1=2*(h+1) by omega] at hp
      obtain ⟨a,ha,hp⟩ := nextEven _ hp
      exact Or.inl ⟨a,by omega,hp⟩
    · rcases odd _ hp with ⟨a,ha,hp⟩|⟨a,ha,hp⟩
      · exact Or.inl ⟨a,by omega,hp⟩
      · exact Or.inr ⟨a,by omega,hp⟩

/-- The two detached arms have even total length. They pay three gates per two vertices,
or finish with one pendant at each old anchor. -/
theorem strip_two (P : ℕ → ℕ → ℕ → Prop)
    (left1 : ∀ l s, P 1 l s → ∃ t, t+1 ≤ s ∧ P 0 l t)
    (right1 : ∀ k s, P k 1 s → ∃ t, t+1 ≤ s ∧ P k 0 t)
    (left2 : ∀ k l s, P (k+2) l s →
      (∃ t, t+2 ≤ s ∧ P (k+1) l t) ∨ (∃ t, t+3 ≤ s ∧ P k l t))
    (right2 : ∀ k l s, P k (l+2) s →
      (∃ t, t+2 ≤ s ∧ P k (l+1) t) ∨ (∃ t, t+3 ≤ s ∧ P k l t))
    (k l h s : ℕ) (he : k+l=2*h) (hp : P k l s) :
    (∃ t, 3*h+t ≤ s ∧ P 0 0 t) ∨ (∃ t, 3*h+t ≤ s+3 ∧ P 1 1 t) := by
  have left (l a : ℕ) := strip_arm (fun k s => P k l s) (left1 l)
    (fun k => left2 k l) a
  have right (k a : ℕ) := strip_arm (P k) (right1 k) (right2 k) a
  let a := k/2
  let b := l/2
  by_cases even : k % 2 = 0
  · have hk : k=2*a := by dsimp [a]; omega
    have hl : l=2*b := by dsimp [b]; omega
    have hab : h=a+b := by omega
    rw [hk] at hp
    obtain ⟨t,ht,hp⟩ := (left l a).1 _ hp
    rw [hl] at hp
    obtain ⟨z,hz,hp⟩ := (right 0 b).1 _ hp
    exact Or.inl ⟨z,by omega,hp⟩
  · have hk : k=2*a+1 := by dsimp [a]; omega
    have hl : l=2*b+1 := by dsimp [b]; omega
    have hab : h=a+b+1 := by omega
    rw [hk] at hp
    rcases (left l a).2 _ hp with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
    · rw [hl] at hp
      rcases (right 0 b).2 _ hp with ⟨z,hz,hp⟩|⟨z,hz,hp⟩
      · exact Or.inl ⟨z,by omega,hp⟩
      · obtain ⟨y,hy,hp⟩ := right1 _ _ hp
        exact Or.inl ⟨y,by omega,hp⟩
    · rw [hl] at hp
      rcases (right 1 b).2 _ hp with ⟨z,hz,hp⟩|⟨z,hz,hp⟩
      · obtain ⟨y,hy,hp⟩ := left1 _ _ hp
        exact Or.inl ⟨y,by omega,hp⟩
      · exact Or.inr ⟨z,by omega,hp⟩

/-- Finish after the paying theorem cut. A false cut costs three and leaves 2h
vertices. A true cut costs six including its two newly free inputs. -/
theorem finish_arms (P : ℕ → ℕ → ℕ → Prop)
    (strip : ∀ k l h s, k+l=2*h → P k l s →
      (∃ t, 3*h+t ≤ s ∧ P 0 0 t) ∨ (∃ t, 3*h+t ≤ s+3 ∧ P 1 1 t))
    (h s : ℕ)
    (cut : ∃ k l d, P k l d ∧ ((k+l=2*h ∧ d+3≤s) ∨ (k+l+2=2*h ∧ d+6≤s))) :
    ∃ t, (3*h+t+3 ≤ s ∧ P 0 0 t) ∨ (3*h+t ≤ s ∧ P 1 1 t) := by
  obtain ⟨k,l,d,hp,hcut⟩ := cut
  rcases hcut with ⟨hl,hd⟩|⟨hl,hd⟩
  · rcases strip k l h d hl hp with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
    · exact ⟨t,Or.inl ⟨by omega,hp⟩⟩
    · exact ⟨t,Or.inr ⟨by omega,hp⟩⟩
  · rcases strip k l (h-1) d (by omega) hp with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
    · exact ⟨t,Or.inl ⟨by omega,hp⟩⟩
    · exact ⟨t,Or.inr ⟨by omega,hp⟩⟩

end OddPath574

namespace Path574
open PEqualNP.MetaComplexity

private def LeftRules {N : ℕ} (k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool) : Prop :=
  (∀ l s, P k u v g 1 l s → ∃ t, t+1 ≤ s ∧ P k u v g 0 l t) ∧
  (∀ a l s, P k u v g (a+2) l s →
    (∃ t, t+2≤s ∧ P k u v g (a+1) l t) ∨ (∃ t, t+3≤s ∧ P k u v g a l t))

private theorem conclude {N k h s : ℕ} {u v : Fin N} {g : (Fin N → Bool) → Bool}
    (hg : ∃ x y, g x≠g y)
    (left : LeftRules k u v g) (right : LeftRules k v u g)
    (cut : ∃ a b d, P k u v g a b d ∧ ((a+b=2*h ∧ d+3≤s) ∨ (a+b+2=2*h ∧ d+6≤s))) :
    ∃ t, (3*h+t+3≤s ∧ HasCircuitSize N g t) ∨
      (3*h+t≤s ∧ HasCircuitSize (N+2) (pendantFn u v g) t) := by
  have right1 (a s : ℕ) (hp : P k u v g a 1 s) : ∃ t, t+1≤s ∧ P k u v g a 0 t := by
    obtain ⟨t,ht,hp⟩ := right.1 a s (P_swap hp)
    exact ⟨t,ht,P_swap hp⟩
  have right2 (a b s : ℕ) (hp : P k u v g a (b+2) s) :
      (∃ t, t+2≤s ∧ P k u v g a (b+1) t) ∨ (∃ t, t+3≤s ∧ P k u v g a b t) := by
    rcases right.2 b a s (P_swap hp) with ⟨t,ht,hp⟩|⟨t,ht,hp⟩
    · exact Or.inl ⟨t,ht,P_swap hp⟩
    · exact Or.inr ⟨t,ht,P_swap hp⟩
  have strip := OddPath574.strip_two (P k u v g) left.1 right1 left.2 right2
  obtain ⟨t,ht|ht⟩ := OddPath574.finish_arms _ strip h s cut
  · exact ⟨t,Or.inl ⟨ht.1,P_base hg ht.2⟩⟩
  · exact ⟨t,Or.inr ⟨ht.1,P_pendant hg ht.2⟩⟩

end Path574

namespace Path574
open PEqualNP.MetaComplexity

private def ListSingle {N : ℕ} (k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool) : Prop :=
  ∀ (R : List (Fin (N+k))) (p : Fin (N+k)) (s : ℕ),
    (∀ j ∈ [p]++R, N≤j.val) → ([p]++R).Nodup →
    HasCircuitSize (N+k) (armsFn u v g [p] R) s →
    ∃ t, t+1 ≤ s ∧ HasCircuitSize (N+k) (armsFn u v g [] R) t

private def ListPair {N : ℕ} (k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool) : Prop :=
  ∀ (L R : List (Fin (N+k))) (q p : Fin (N+k)) (s : ℕ),
    (∀ j ∈ (L++[q,p])++R, N≤j.val) → ((L++[q,p])++R).Nodup →
    HasCircuitSize (N+k) (armsFn u v g (L++[q,p]) R) s →
    (∃ t, t+2 ≤ s ∧ HasCircuitSize (N+k) (armsFn u v g (L++[q]) R) t) ∨
    (∃ t, t+3 ≤ s ∧ HasCircuitSize (N+k) (armsFn u v g L R) t)

private theorem split_last_two {α : Type*} (L : List α) (n : ℕ) (h : L.length=n+2) :
    ∃ L' q p, L'.length=n ∧ L=L'++[q,p] := by
  rcases List.eq_nil_or_concat L with rfl|⟨rest,p,hr⟩
  · simp at h
  rw [List.concat_eq_append] at hr
  rcases List.eq_nil_or_concat rest with rfl|⟨L',q,hL⟩
  · simp [hr] at h
  rw [List.concat_eq_append] at hL
  rw [hL,List.append_assoc] at hr
  have hlen : L'.length=n := by simp [hr] at h; omega
  exact ⟨L',q,p,hlen,hr⟩

private theorem left_rules_of_lists {N : ℕ} (k : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (one : ListSingle k u v g) (pair : ListPair k u v g) : LeftRules k u v g := by
  constructor
  · intro l s hp
    obtain ⟨L,R,lenL,lenR,fr,nd,hs⟩ := hp
    obtain ⟨p,rfl⟩ := List.length_eq_one_iff.mp lenL
    obtain ⟨t,hpay,ht⟩ := one R p s fr nd hs
    have hsub : ([]++R).Sublist ([p]++R) := by simp
    exact ⟨t,hpay,[],R,rfl,lenR,fun j hj => fr j (hsub.subset hj),List.Nodup.sublist hsub nd,ht⟩
  · intro a l s hp
    obtain ⟨L,R,lenL,lenR,fr,nd,hs⟩ := hp
    obtain ⟨L',q,p,hlen,rfl⟩ := split_last_two L a lenL
    rcases pair L' R q p s fr nd hs with ⟨t,hpay,ht⟩|⟨t,hpay,ht⟩
    · have hsub : ((L'++[q])++R).Sublist ((L'++[q,p])++R) :=
        ((List.sublist_append_left [q] [p]).append_left L').append_right R
      exact Or.inl ⟨t,hpay,L'++[q],R,by simp [hlen],lenR,fun j hj => fr j (hsub.subset hj),
        List.Nodup.sublist hsub nd,ht⟩
    · have hsub : (L'++R).Sublist ((L'++[q,p])++R) := (List.sublist_append_left L' [q,p]).append_right R
      exact Or.inr ⟨t,hpay,L',R,hlen,lenR,fun j hj => fr j (hsub.subset hj),
        List.Nodup.sublist hsub nd,ht⟩

end Path574

namespace Path574

private theorem arm_indices {m : ℕ} (x : Fin m → Bool) (r d : Fin m) (xs : List (Fin m)) :
    arm x r xs = true ↔ ∃ i < xs.length,
      x ((r::xs).getD i d) = true ∧ x ((r::xs).getD (i+1) d) = true := by
  induction xs generalizing r with
  | nil => simp [arm]
  | cons p xs ih =>
    simp only [arm,Bool.or_eq_true,Bool.and_eq_true,ih]
    constructor
    · rintro (h | ⟨i,hi,hy,hz⟩)
      · exact ⟨0,by simp, h.1,h.2⟩
      · exact ⟨i+1,by simp; omega,hy,hz⟩
    · rintro ⟨i,hi,h1,h2⟩
      cases i with
      | zero => exact Or.inl ⟨h1,h2⟩
      | succ i => exact Or.inr ⟨i,by simp at hi; omega,h1,h2⟩

private theorem arm_append {m : ℕ} (x : Fin m → Bool) (r : Fin m)
    (l a : List (Fin m)) : arm x r (l++a) = (arm x r l || arm x (l.getLastD r) a) := by
  induction l generalizing r with
  | nil => simp [arm]
  | cons p l ih =>
    rw [List.cons_append,arm,arm,ih]
    rw [List.getLastD_cons]
    simp [Bool.or_assoc]

private theorem arm_reverse_endpoint {m : ℕ} (x : Fin m → Bool) (r v : Fin m) (l : List (Fin m)) :
    arm x r (l++[v]) = arm x v (l.reverse++[r]) := by
  induction l generalizing r with
  | nil => simp [arm,Bool.and_comm]
  | cons p l ih =>
    simp only [List.cons_append,arm,List.reverse_cons]
    rw [ih,arm_append x v (l.reverse++[p]) [r]]
    simp [arm,Bool.and_comm,Bool.or_comm]

private theorem arm_cut {m : ℕ} (x : Fin m → Bool) (u v a p b : Fin m) (l r : List (Fin m)) :
    arm x u (l ++ [a,p,b] ++ r ++ [v]) =
      if x p then
        (arm x u l || arm x v r.reverse || x a || x b)
      else
        (arm x u (l++[a]) || arm x v (r.reverse++[b])) := by
  have h := arm_reverse_endpoint x b v r
  simp only [List.append_assoc,List.cons_append,List.nil_append]
  rw [arm_append x u l,arm,arm,arm,h,arm_append x u l [a],arm_append x v r.reverse [b]]
  simp only [arm,Bool.or_false]
  cases x p <;> cases x a <;> cases x b <;> simp [Bool.or_assoc,Bool.or_comm,Bool.or_left_comm]

private def freshList (N k : ℕ) : List (Fin (N+k)) := List.ofFn (Fin.natAdd N : Fin k → _)

private theorem full_as_arm {N k : ℕ} (hk : 0<k) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (x : Fin (N+k) → Bool) :
    pathFn N k u v g x =
      (g (old x) || arm x (Fin.castAdd k u) (freshList N k ++ [Fin.castAdd k v])) := by
  let U := Fin.castAdd k u
  let V := Fin.castAdd k v
  let l := freshList N k
  have hl : l.length = k := by simp [l,freshList]
  have elem (i : Fin k) : (l++[V]).getD i.val U = Fin.natAdd N i := by
    rw [List.getD_eq_getElem _ _ (by simp [hl])]
    rw [List.getElem_append_left (by simpa only [hl] using i.isLt)]
    simp [l,freshList]
  have last : (l++[V]).getD k U = V := by
    rw [List.getD_eq_getElem _ _ (by simp [hl]),List.getElem_append_right (by omega)]
    simp [hl]
  change (g (old x) || decide _) = (g (old x) || arm x U (l++[V]))
  congr 1
  apply Bool.eq_iff_iff.mpr
  rw [decide_eq_true_eq,arm_indices x U U]
  constructor
  · rintro ⟨i,hi,⟨ha,hu⟩|⟨hb,hv⟩|⟨j,hj,hjv⟩⟩
    · refine ⟨0,by simp,hu,?_⟩
      change x ((l++[V]).getD 0 U) = true
      rw [←ha,elem]
      exact hi
    · refine ⟨i.val+1,by simp [hl],?_,?_⟩
      · change x ((l++[V]).getD i.val U) = true
        rw [elem]; exact hi
      · change x ((l++[V]).getD (i.val+1) U) = true
        rw [hb,last]; exact hv
    · refine ⟨i.val+1,by simp [hl],?_,?_⟩
      · change x ((l++[V]).getD i.val U) = true
        rw [elem]; exact hi
      · change x ((l++[V]).getD (i.val+1) U) = true
        rw [←hj,elem]; exact hjv
  · rintro ⟨a,ha,hs,ht⟩
    simp [hl] at ha
    cases a with
    | zero =>
      let i : Fin k := ⟨0,hk⟩
      refine ⟨i,?_,Or.inl ⟨rfl,hs⟩⟩
      change x ((l++[V]).getD i.val U) = true at ht
      rwa [elem] at ht
    | succ a =>
      let i : Fin k := ⟨a,by omega⟩
      change x ((l++[V]).getD i.val U) = true at hs
      rw [elem] at hs
      refine ⟨i,hs,?_⟩
      change x ((l++[V]).getD (a+1) U) = true at ht
      by_cases hj : a+1 = k
      · rw [hj,last] at ht
        exact Or.inr (Or.inl ⟨hj,ht⟩)
      · let j : Fin k := ⟨a+1,by omega⟩
        change x ((l++[V]).getD j.val U) = true at ht
        rw [elem] at ht
        exact Or.inr (Or.inr ⟨j,rfl,ht⟩)

end Path574

namespace Path574
open PEqualNP.MetaComplexity

private theorem arm_update_out {m : ℕ} (x : Fin m → Bool) (r p : Fin m) (xs : List (Fin m))
    (b : Bool) (hr : r ≠ p) (hl : p ∉ xs) :
    arm (Function.update x p b) r xs = arm x r xs := by
  induction xs generalizing r with
  | nil => rfl
  | cons a xs ih =>
    obtain ⟨hna,hxs⟩ : p ≠ a ∧ p ∉ xs := by simpa using hl
    simp only [arm,Function.update_of_ne hr, Function.update_of_ne hna.symm,ih a hna.symm hxs]

private theorem remove_bare {m s : ℕ} (F : (Fin m → Bool) → Bool) (a : Fin m)
    (hu : ∀ x b, F (Function.update x a b) = F x) (hn : ∃ x y, F x ≠ F y)
    (hc : HasCircuitSize m (fun x => F x || x a) s) : 1 ≤ s ∧ HasCircuitSize m F (s-1) := by
  obtain ⟨x,y,hd⟩ := hn
  obtain ⟨z,hz⟩ : ∃ z, F z = false := by
    cases hx : F x <;> cases hy : F y <;> simp_all <;> aesop
  have h1 := PathGateReduction.elim_one_var a false hc ⟨z, by simp [hu,hz]⟩
    ⟨x,y,by simpa [hu] using hd⟩
  simpa only [hu,Function.update_self,Bool.or_false] using h1

private theorem remove_two_bare {m s : ℕ} (F : (Fin m → Bool) → Bool) (a b : Fin m)
    (hab : a ≠ b) (ha : ∀ x t, F (Function.update x a t)=F x)
    (hb : ∀ x t, F (Function.update x b t)=F x) (hn : ∃ x y, F x ≠ F y)
    (hc : HasCircuitSize m (fun x => F x || x a || x b) s) :
    2 ≤ s ∧ HasCircuitSize m F (s-2) := by
  obtain ⟨x,y,hd⟩ := hn
  have hna : ∃ x y, (F x || x a) ≠ (F y || y a) :=
    ⟨Function.update x a false,Function.update y a false,by simpa only [ha,Function.update_self,Bool.or_false] using hd⟩
  obtain ⟨hs1,hc1⟩ := remove_bare (fun x => F x || x a) b
    (fun x t => by simp [hb,Function.update_of_ne hab]) hna hc
  obtain ⟨hs2,hc2⟩ := remove_bare F a ha ⟨x,y,hd⟩ hc1
  exact ⟨by omega,hc2⟩

end Path574

namespace Path574
open PEqualNP.MetaComplexity

private theorem list_split_at {N k : ℕ} (p : Fin k) (h0 : 0<p.val) (h1 : p.val+1<k) :
    ∃ (l r : List (Fin (N+k))) (a b : Fin (N+k)),
      freshList N k = l ++ [a,Fin.natAdd N p,b] ++ r ∧ l.length+1=p.val ∧
      (l.length+r.length+3=k) := by
  let all := freshList N k
  have hlen : all.length=k := by simp [all,freshList]
  let ia : ℕ := p.val-1
  have ha : ia<all.length := by unfold ia; omega
  have hp : p.val<all.length := by omega
  have hb : p.val+1<all.length := by omega
  let l := all.take ia
  let r := all.drop (p.val+2)
  let a := all[ia]
  let b := all[p.val+1]
  have hpv : all[p.val] = Fin.natAdd N p := by simp [all,freshList]
  have hcut : all = l ++ [a,Fin.natAdd N p,b] ++ r := by
    have dz := List.drop_eq_getElem_cons ha
    have dp := List.drop_eq_getElem_cons hp
    have db := List.drop_eq_getElem_cons hb
    have hn : ia+1=p.val := by unfold ia; omega
    rw [hn] at dz
    calc
      all = l ++ all.drop ia := (List.take_append_drop ia all).symm
      _ = _ := by rw [dz,dp,db,hpv]; simp [a,b,r]
  refine ⟨l,r,a,b,hcut,?_,?_⟩
  · simp [l,ia,hlen]; omega
  · simp [l,r,ia,hlen]; omega

private theorem arm_all_false {m : ℕ} (x : Fin m → Bool) (r : Fin m) (L : List (Fin m))
    (h : ∀ a ∈ L, x a = false) : arm x r L = false := by
  induction L generalizing r with
  | nil => rfl
  | cons a l ih => simp [arm,h a (by simp),ih a (fun q hq => h q (by simp [hq]))]

private theorem arms_nc {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hg : ∃ y z, g y ≠ g z) (l r : List (Fin (N+k)))
    (hf : ∀ w ∈ l++r, N≤w.val) : ∃ x y, armsFn u v g l r x ≠ armsFn u v g l r y := by
  let x (y : Fin N → Bool) := Fin.append y (fun _ : Fin k => false)
  have val (y : Fin N → Bool) : armsFn u v g l r (x y) = g y := by
    have base (i : Fin N) : x y (Fin.castAdd k i)=y i := Fin.append_left ..
    have zero (w : Fin (N+k)) (hw : w ∈ l++r) : x y w=false := by
      have hh := hf w hw
      let j : Fin k := ⟨w.val-N,by omega⟩
      have he : w = Fin.natAdd N j := by apply Fin.ext; simp [j]; omega
      rw [he]; exact Fin.append_right ..
    rw [armsFn,arm_all_false _ _ _ (fun w hw => zero w (List.mem_append_left _ hw)),
      arm_all_false _ _ _ (fun w hw => zero w (List.mem_append_right _ hw))]
    simp [base]
  obtain ⟨y,z,hyz⟩ := hg
  exact ⟨x y,x z,by rwa [val,val]⟩

private theorem arms_indep {N k : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (l r : List (Fin (N+k))) (p : Fin (N+k)) (hf : N≤p.val) (hp : p ∉ l ∧ p ∉ r)
    (x : Fin (N+k) → Bool) (b : Bool) :
    armsFn u v g l r (Function.update x p b) = armsFn u v g l r x := by
  have hne (i : Fin N) : Fin.castAdd k i ≠ p := by
    intro h; have hh := congrArg Fin.val h; change i.val=p.val at hh; omega
  simp only [armsFn, Function.update_of_ne (hne _),
    arm_update_out x _ p l b (hne _) hp.1, arm_update_out x _ p r b (hne _) hp.2]

private theorem cut_paid {N k s : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hg : ∃ y z, g y ≠ g z) (p : Fin k) (h0 : 0<p.val) (h1 : p.val+1<k)
    (hc : (∃ t : ℕ, t+3 ≤ s ∧ HasCircuitSize (N+k)
        (fun x => pathFn N k u v g (Function.update x (Fin.natAdd N p) false)) t) ∨
       (∃ t : ℕ, t+4 ≤ s ∧ HasCircuitSize (N+k)
        (fun x => pathFn N k u v g (Function.update x (Fin.natAdd N p) true)) t)) :
    ∃ a b d, P k u v g a b d ∧ ((a+b+1=k ∧ d+3≤s) ∨ (a+b+3=k ∧ d+6≤s)) := by
  classical
  obtain ⟨l,r,a,b,hs,hl,hlen⟩ := list_split_at (N:=N) p h0 h1
  let pw := Fin.natAdd N p
  let L := l++[a]
  let R := r.reverse++[b]
  have hnd : (freshList N k).Nodup := List.nodup_ofFn_ofInjective (fun i j h => (Fin.natAdd_inj N).mp h)
  have hf0 (w : Fin (N+k)) (h : w ∈ freshList N k) : N≤w.val := by
    obtain ⟨j,rfl⟩ := List.mem_ofFn.mp h
    simp
  have hnorm : (l ++ a::pw::b::r).Nodup := by simpa only [hs,List.append_assoc,List.cons_append,List.nil_append] using hnd
  have H := List.nodup_append.mp hnorm
  have facts : a ≠ pw ∧ a ≠ b ∧ a ∉ r ∧ pw ≠ b ∧ pw ∉ r ∧ b ∉ r ∧ r.Nodup := by
    simpa only [List.nodup_cons,List.mem_cons,not_or,and_assoc] using H.2.1
  have avoid (w : Fin (N+k)) (hw : w ∈ a::pw::b::r) : w ∉ l := fun hm => H.2.2 w hm w hw rfl
  have fresh (w : Fin (N+k)) (hw : w ∈ l ∨ w=a ∨ w=pw ∨ w=b ∨ w∈r) : N≤w.val := by
    apply hf0 w
    rw [hs]
    simpa only [List.append_assoc,List.cons_append,List.nil_append,List.mem_append,List.mem_cons] using hw
  have hpair : (l++r.reverse).Nodup := by
    refine List.nodup_append.mpr ⟨H.1,?_,?_⟩
    · simpa using facts.2.2.2.2.2.2
    · intro a ha b hb
      exact H.2.2 a ha b (by simp only [List.mem_reverse] at hb; simp [hb])
  have hbig : (L++R).Nodup := by
    simp only [L,R,List.append_assoc,List.singleton_append,List.nodup_append,List.nodup_cons,
      List.mem_append,List.mem_reverse,List.mem_singleton,not_or]
    grind [List.nodup_append, List.nodup_reverse]
  have fsmall (w : Fin (N+k)) (hw : w ∈ l++r.reverse) : N≤w.val := by
    simp only [List.mem_append,List.mem_reverse] at hw
    exact fresh _ (hw.elim Or.inl (fun h => Or.inr (Or.inr (Or.inr (Or.inr h)))))
  have fbig (w : Fin (N+k)) (hw : w ∈ L++R) : N≤w.val := by
    simp only [L,R,List.mem_append,List.mem_singleton,List.mem_reverse] at hw
    apply fresh; tauto
  have hpi : pw ∉ L ∧ pw ∉ R := by
    simp only [L,R,List.mem_append,List.mem_singleton,List.mem_reverse,not_or]
    exact ⟨⟨avoid _ (by simp),facts.1.symm⟩,facts.2.2.2.2.1,facts.2.2.2.1⟩
  have smallPw : pw ∉ l ∧ pw ∉ r.reverse := ⟨avoid _ (by simp),by simpa using facts.2.2.2.2.1⟩
  have ha : a ∉ l ∧ a ∉ r.reverse := ⟨avoid _ (by simp),by simpa using facts.2.2.1⟩
  have hb : b ∉ l ∧ b ∉ r.reverse := ⟨avoid _ (by simp),by simpa using facts.2.2.2.2.2.1⟩
  let S := armsFn u v g l r.reverse
  let T := armsFn u v g L R
  have hie (x : Fin (N+k) → Bool) (f : Bool) :
      pathFn N k u v g (Function.update x pw f) =
        if f then (S x || x a || x b) else T x := by
    let y := Function.update x pw f
    have hh := full_as_arm (by omega : 0<k) u v g y
    rw [hs] at hh
    have he := arm_cut y (Fin.castAdd k u) (Fin.castAdd k v) a pw b l r
    rw [he] at hh
    have hpv : y pw = f := Function.update_self ..
    have hpa : y a = x a := Function.update_of_ne facts.1 ..
    have hpb : y b = x b := Function.update_of_ne facts.2.2.2.1.symm ..
    have hpf : N ≤ pw.val := by simp [pw]
    cases f
    · simp only [hpv,Bool.false_eq_true,ite_false] at hh
      have ht := arms_indep u v g L R pw hpf hpi x false
      change T y = T x at ht
      exact hh.trans ((Bool.or_assoc _ _ _).symm.trans ht)
    · simp only [hpv,ite_true,hpa,hpb] at hh
      have ht := arms_indep u v g l r.reverse pw hpf smallPw x true
      change S y = S x at ht
      rw [←ht]
      exact hh.trans (by simp only [S,armsFn,Bool.or_assoc,ite_true])
  rcases hc with ⟨t,ht,hc⟩ | ⟨t,ht,hc⟩
  · have he : (fun x => pathFn N k u v g (Function.update x pw false)) = T := funext (fun x => hie x false)
    rw [he] at hc
    refine ⟨L.length,R.length,t,⟨L,R,rfl,rfl,fbig,hbig,hc⟩,Or.inl ⟨?_,ht⟩⟩
    simp [L,R]; omega
  · have he : (fun x => pathFn N k u v g (Function.update x pw true)) = (fun x => S x || x a || x b) :=
      funext (fun x => hie x true)
    rw [he] at hc
    obtain ⟨ht',hsmall⟩ := remove_two_bare S a b facts.2.1
      (arms_indep u v g l r.reverse a (fresh _ (by tauto)) ha)
      (arms_indep u v g l r.reverse b (fresh _ (by tauto)) hb) (arms_nc u v g hg l r.reverse fsmall) hc
    refine ⟨l.length,r.reverse.length,t-2,⟨l,r.reverse,rfl,rfl,fsmall,hpair,hsmall⟩,Or.inr ⟨?_,by omega⟩⟩
    simpa using hlen

end Path574

theorem PEqualNP.Outside.L_meta_574 : ∀ (N h : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool), u ≠ v → 3 ≤ h → (∃ y y' : Fin N → Bool, g y ≠ g y') → g (fun _ : Fin N => false) = false → (∃ x : Fin N → Bool, x u = true ∧ g x = false) → (∃ x : Fin N → Bool, x v = true ∧ g x = false) → ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize (N + (2 * h + 1)) (fun x : Fin (N + 2 * h + 1) → Bool => g (fun i : Fin N => x (Fin.castAdd (2 * h + 1) i)) || decide (∃ i : Fin (2 * h + 1), x (Fin.natAdd N i) = true ∧ ((i.val = 0 ∧ x (Fin.castAdd (2 * h + 1) u) = true) ∨ (i.val + 1 = 2 * h + 1 ∧ x (Fin.castAdd (2 * h + 1) v) = true) ∨ ∃ j : Fin (2 * h + 1), j.val = i.val + 1 ∧ x (Fin.natAdd N j) = true))) s → ∃ s' : ℕ, (3 * h + s' + 3 ≤ s ∧ PEqualNP.MetaComplexity.HasCircuitSize N g s') ∨ (3 * h + s' ≤ s ∧ PEqualNP.MetaComplexity.HasCircuitSize (N + 2) (fun x : Fin (N + 2) → Bool => g (fun i : Fin N => x (Fin.castAdd 2 i)) || (x (Fin.castAdd 2 u) && x (Fin.natAdd N (0 : Fin 2))) || (x (Fin.castAdd 2 v) && x (Fin.natAdd N (1 : Fin 2)))) s') := by
  intro N h u v g _ hh hg hzero hu hv s hs
  have rules (a b : Fin N) (ha : ∃ x, x a = true ∧ g x = false) : Path574.LeftRules (2*h+1) a b g := by
    apply Path574.left_rules_of_lists
    · intro R p z fr nd hc
      exact Path574.left_single_list a b g hg ha R p fr nd hc
    · intro L R q p z fr nd hc
      exact Path574.left_pair_list a b g hg hzero L R q p fr nd hc
  obtain ⟨p,hp,hq,branch⟩ := Path574.path_pay N (2*h+1) u v g (by omega) hg hzero
    PEqualNP.MetaComplexity.PathCircuitEdgeFn.stmtML_final s hs
  obtain ⟨a,b,d,hd,cut⟩ := Path574.cut_paid u v g hg p hp hq branch
  apply Path574.conclude (h:=h) hg (rules u v hu) (rules v u hv)
  refine ⟨a,b,d,hd,?_⟩
  rcases cut with ⟨he,hsav⟩|⟨he,hsav⟩
  · exact Or.inl ⟨by omega,hsav⟩
  · exact Or.inr ⟨by omega,hsav⟩
