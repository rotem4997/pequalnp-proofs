  set out := (execN C.gates roots_18).getD C.output 0
  have hout : out &&& dom_18 = T &&& dom_18 := by
    apply Nat.eq_of_testBit_eq; intro r
    rw [Nat.testBit_and, Nat.testBit_and]
    by_cases hlt : r < 64
