import PEqualNP.Defs

-- Reduction for L-meta-3491: the counting bound (edges + vertex cover <= size + 1)
-- for AO2 circuits computing a 4-cycle-free bipartite incidence function splits
-- into the two halves of the intended argument.
-- h_norm: every such circuit can be replaced by a two-level one no larger:
-- point wires are point inputs or OR gates over point wires, line wires are
-- line inputs or OR gates over line wires, and every AND gate reads one line
-- wire and one point wire.
-- h_count: for a circuit already in that two-level form, the counting works:
-- each AND gate's accepted pairs form a complete bipartite piece, which the
-- 4-cycle-free hypothesis forces to be a star, and the stars assemble into a
-- vertex cover S with (incid R).card + S.card <= size + 1.
theorem PEqualNP.Outside.R_meta_3491_1
    (h_norm : ∀ (a b : ℕ) (R : Fin a → Fin b → Prop) [DecidableRel R] (C : PEqualNP.CircuitLowerBounds.Circuit), (∀ (p p' : Fin a) (l l' : Fin b), p ≠ p' → l ≠ l' → ¬(R p l ∧ R p l' ∧ R p' l ∧ R p' l')) → PEqualNP.TopForm.IsAO2 (a + b) C → (∀ (z : Fin (a + b) → Bool), PEqualNP.MetaComplexity.circuitFun (a + b) C z = Decidable.decide (∃ (p : Fin a) (l : Fin b), R p l ∧ z (Fin.castAdd b p) = Bool.true ∧ z (Fin.natAdd a l) = Bool.true)) → ∃ (D : PEqualNP.CircuitLowerBounds.Circuit) (P L : Finset ℕ), PEqualNP.TopForm.IsAO2 (a + b) D ∧ (∀ (z : Fin (a + b) → Bool), PEqualNP.MetaComplexity.circuitFun (a + b) D z = Decidable.decide (∃ (p : Fin a) (l : Fin b), R p l ∧ z (Fin.castAdd b p) = Bool.true ∧ z (Fin.natAdd a l) = Bool.true)) ∧ D.size ≤ C.size ∧ (∀ w ∈ P, w < a ∨ ∃ i < D.gates.length, w = a + b + i ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ ∀ u ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs, u ∈ P) ∧ (∀ w ∈ L, (a ≤ w ∧ w < a + b) ∨ ∃ i < D.gates.length, w = a + b + i ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ ∀ u ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs, u ∈ L) ∧ ∀ i < D.gates.length, (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.and → ∃ (x y : ℕ), (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs = [x, y] ∧ x ∈ L ∧ y ∈ P)
    (h_count : ∀ (a b : ℕ) (R : Fin a → Fin b → Prop) [DecidableRel R] (D : PEqualNP.CircuitLowerBounds.Circuit) (P L : Finset ℕ), (∀ (p p' : Fin a) (l l' : Fin b), p ≠ p' → l ≠ l' → ¬(R p l ∧ R p l' ∧ R p' l ∧ R p' l')) → PEqualNP.TopForm.IsAO2 (a + b) D → (∀ (z : Fin (a + b) → Bool), PEqualNP.MetaComplexity.circuitFun (a + b) D z = Decidable.decide (∃ (p : Fin a) (l : Fin b), R p l ∧ z (Fin.castAdd b p) = Bool.true ∧ z (Fin.natAdd a l) = Bool.true)) → (∀ w ∈ P, w < a ∨ ∃ i < D.gates.length, w = a + b + i ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ ∀ u ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs, u ∈ P) → (∀ w ∈ L, (a ≤ w ∧ w < a + b) ∨ ∃ i < D.gates.length, w = a + b + i ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.or ∧ ∀ u ∈ (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs, u ∈ L) → (∀ i < D.gates.length, (PEqualNP.MetaComplexity.NestedCover.gateAt D i).op = PEqualNP.CircuitLowerBounds.GateOp.and → ∃ (x y : ℕ), (PEqualNP.MetaComplexity.NestedCover.gateAt D i).inputs = [x, y] ∧ x ∈ L ∧ y ∈ P) → ∃ (S : Finset (Fin (a + b))), (∀ (p : Fin a) (l : Fin b), R p l → Fin.castAdd b p ∈ S ∨ Fin.natAdd a l ∈ S) ∧ (PEqualNP.ReadTwo.incid R).card + S.card ≤ D.size + 1) :
    ∀ (x1 x2 : ℕ) (x3 : Fin x1 → Fin x2 → Prop) [_x4 : DecidableRel x3] (x5 : PEqualNP.CircuitLowerBounds.Circuit), (∀ (x6 x7 : Fin x1) (x8 x9 : Fin x2), x6 ≠ x7 → x8 ≠ x9 → ¬(x3 x6 x8 ∧ x3 x6 x9 ∧ x3 x7 x8 ∧ x3 x7 x9)) → PEqualNP.TopForm.IsAO2 (x1 + x2) x5 → (∀ (x8 : Fin (x1 + x2) → Bool), PEqualNP.MetaComplexity.circuitFun (x1 + x2) x5 x8 = Decidable.decide (∃ (x9 : Fin x1) (x10 : Fin x2), x3 x9 x10 ∧ x8 (Fin.castAdd x2 x9) = Bool.true ∧ x8 (Fin.natAdd x1 x10) = Bool.true)) → ∃ (x9 : Finset (Fin (x1 + x2))), (∀ (x10 : Fin x1) (x11 : Fin x2), x3 x10 x11 → Fin.castAdd x2 x10 ∈ x9 ∨ Fin.natAdd x1 x11 ∈ x9) ∧ (PEqualNP.ReadTwo.incid x3).card + x9.card ≤ x5.size + (1 : ℕ) := by
  intro a b R inst C h4 hao hcomp
  obtain ⟨D, P, L, hDao, hDcomp, hsize, hP, hL, hA⟩ := h_norm a b R C h4 hao hcomp
  obtain ⟨S, hS, hcard⟩ := h_count a b R D P L h4 hDao hDcomp hP hL hA
  exact ⟨S, hS, by omega⟩
