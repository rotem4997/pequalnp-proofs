open PEqualNP.MetaComplexity PEqualNP.CircuitLowerBounds
open PEqualNP.Outside.L_meta_10824.Maj.Helpers
open PEqualNP.Outside.L_meta_10824.Maj.Helpers.Readers

def base (x : Fin 9 → Bool) : Bool :=
  (x 1 && x 6) || (x 2 && x 6) || (x 1 && x 7) || (x 3 && x 7) ||
  (x 2 && x 8) || (x 3 && x 8) || (x 6 && x 8)

def target (x : Fin 9 → Bool) : Bool :=
  base x || (x 0 && (x 4 || x 5)) || (x 4 && x 5)

lemma base_update4 (x : Fin 9 → Bool) (b : Bool) : base (Function.update x 4 b) = base x := by
  simp [base, Function.update_apply]

lemma base_update5 (x : Fin 9 → Bool) (b : Bool) : base (Function.update x 5 b) = base x := by
  simp [base, Function.update_apply]

end PEqualNP.Outside.L_meta_10824.Maj.EdgeFn

namespace PEqualNP.Outside.L_meta_10824
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open PEqualNP.Outside.L_meta_10824.Maj.Helpers.PermInputs
open PEqualNP.Outside.L_meta_10824.Maj.Helpers.Forest

def orF (z : Fin 9) (x : Fin 9 → Bool) : Bool :=
  Maj.EdgeFn.base x || x z

def twoOrF (z : Fin 9) (x : Fin 9 → Bool) : Bool :=
  Maj.EdgeFn.base x || x 0 || x z

-- Append three gates to recover the eight-input graph from the smaller base.
theorem extend_star (f : (Fin 8 → Bool) → Bool) (hnc : ∃ x y, f x ≠ f y)
    (s : ℕ) (h : HasCircuitSize 8 f s) :
    HasCircuitSize 8 (fun x => f x || (x 4 && (x 7 || x 0))) (s+3) := by
  obtain ⟨C, fan, small, eval⟩ := h
  let off := 8 + C.gates.length
  let tail : List Gate := [⟨.or,[7,0]⟩, ⟨.and,[4,off]⟩, ⟨.or,[C.output,off+1]⟩]
  refine ⟨⟨C.gates ++ tail,off+2⟩, ?_, ?_, ?_⟩
  · intro g hg
    change g ∈ C.gates ++ tail at hg
    rcases List.mem_append.mp hg with h | h
    · exact fan g h
    · simp only [tail,List.mem_cons,List.not_mem_nil,or_false] at h
      rcases h with rfl | rfl | rfl <;> simp
  · change C.gates.length ≤ s at small
    change (C.gates ++ tail).length ≤ s+3
    simp [tail,small]
  · intro x
    let w := Maj.Helpers.wiresFrom C.gates (List.ofFn x)
    have lw : w.length = off := by simp [w,off,Maj.Helpers.length_wiresFrom]
    have ho : C.output < off := Maj.EdgeFn.out_lt_of_nc (F := f) (gs := C.gates) eval hnc
    have ho' : C.output < w.length := lw ▸ ho
    have hv : w.getD C.output false = f x := eval x
    have inw (i : Fin 8) : w.getD i.val false = x i := Maj.Helpers.vl_input _ _ _ i.isLt
    have p0 := inw 0
    have p4 := inw 4
    have p7 := inw 7
    change w.getD 0 false = x 0 at p0
    change w.getD 4 false = x 4 at p4
    change w.getD 7 false = x 7 at p7
    have h4 : 4 < w.length := by rw [lw]; dsimp [off]; omega
    have first (xs : List Bool) (i : ℕ) (hi : i < w.length) :
        (w ++ xs).getD i false = w.getD i false := List.getD_append _ _ _ _ hi
    have result : (Maj.Helpers.wiresFrom tail w).getD (off+2) false = (f x || (x 4 && (x 7 || x 0))) := by
      change (Maj.Helpers.wiresFrom [⟨.or,[7,0]⟩, ⟨.and,[4,off]⟩, ⟨.or,[C.output,off+1]⟩] w).getD (off+2) false =
        (f x || (x 4 && (x 7 || x 0)))
      rw [← lw]
      have atOffset (ls : List Bool) (n : ℕ) :
          (w ++ ls).getD (w.length+n) false = ls.getD n false := by
        rw [List.getD_append_right _ _ _ _ (by omega)]
        simp
      have atEnd (ls : List Bool) : (w ++ ls).getD w.length false = ls.getD 0 false := by
        simpa using atOffset ls 0
      simp [Maj.Helpers.wiresFrom, GateOp.eval, ← List.getD_eq_getElem?_getD,
        first _ _ h4, first _ _ ho', hv, p0, p4, p7, List.append_assoc, atOffset, atEnd]
      rfl
    change (Maj.Helpers.wiresFrom (C.gates ++ tail) (List.ofFn x)).getD (off+2) false = _
    rw [Maj.Helpers.wiresFrom_append]
    exact result

theorem base_bound (s : ℕ) (h : HasCircuitSize 9 Maj.EdgeFn.base s) : 9 ≤ s := by
  let π : Fin 9 → Fin 8 := ![4,5,2,3,0,7,1,6,0]
  let f : (Fin 8 → Bool) → Bool := fun x => Maj.EdgeFn.base (x ∘ π)
  have hc : HasCircuitSize 8 f s := relabel_size π _ s h
  have nc : ∃ x y, f x ≠ f y := ⟨fun _ => false, fun _ => true, by decide +kernel⟩
  have hg := extend_star f nc s hc
  have equiv : (fun x : Fin 8 → Bool => f x || (x 4 && (x 7 || x 0))) = (fun x : Fin 8 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 0 && x 4) || (x 1 && x 2) || (x 1 && x 5) || (x 3 && x 6) || (x 4 && x 7) || (x 5 && x 6)) := by
    funext x
    revert x
    decide +kernel
  rw [equiv] at hg
  have hb := Stock.stockBound (s+3) hg
  omega

theorem orF_bound (z : Fin 9) (hz : z = 4 ∨ z = 5) (s : ℕ)
    (h : HasCircuitSize 9 (orF z) s) : 10 ≤ s := by
  have hs1 : 1 ≤ s := by
    have hd := dep_lower_set 9 (orF z) {1, 6} (by
      intro i hi
      simp only [Finset.mem_insert, Finset.mem_singleton] at hi
      rcases hz with rfl | rfl <;> rcases hi with rfl | rfl
      · exact ⟨fun k => decide (k = 6), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 1), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 6), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 1), by decide +kernel⟩) s h
    have hc : ({1, 6} : Finset (Fin 9)).card = 2 := by decide
    omega
  have hd_z : ∃ x : Fin 9 → Bool, orF z (Function.update x z (!x z)) ≠ orF z x := by
    rcases hz with rfl | rfl <;> exact ⟨fun _ => false, by decide +kernel⟩
  have hn_z : ∃ x y : Fin 9 → Bool,
      orF z (Function.update x z false) ≠ orF z (Function.update y z false) := by
    rcases hz with rfl | rfl <;>
      exact ⟨fun _ => false, fun i => decide (i = 1 ∨ i = 6), by decide +kernel⟩
  have h_succ : HasCircuitSize 9 (orF z) ((s - 1) + 1) := by
    rwa [Nat.sub_add_cancel hs1]
  have hc1 := one_gate_at 8 (orF z) z false (s - 1) hd_z hn_z h_succ
  have heq : (fun x : Fin 9 → Bool => orF z (Function.update x z false)) = Maj.EdgeFn.base := by
    rcases hz with rfl | rfl <;> funext x <;> simp [orF, Maj.EdgeFn.base_update4, Maj.EdgeFn.base_update5]
  rw [heq] at hc1
  have hb := base_bound (s - 1) hc1
  omega

theorem twoOrF_bound (z : Fin 9) (hz : z = 4 ∨ z = 5) (s : ℕ)
    (h : HasCircuitSize 9 (twoOrF z) s) : 11 ≤ s := by
  have hs1 : 1 ≤ s := by
    have hd := dep_lower_set 9 (twoOrF z) {1, 6} (by
      intro i hi
      simp only [Finset.mem_insert, Finset.mem_singleton] at hi
      rcases hz with rfl | rfl <;> rcases hi with rfl | rfl
      · exact ⟨fun k => decide (k = 6), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 1), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 6), by decide +kernel⟩
      · exact ⟨fun k => decide (k = 1), by decide +kernel⟩) s h
    have hc : ({1, 6} : Finset (Fin 9)).card = 2 := by decide
    omega
  have hd_0 : ∃ x : Fin 9 → Bool, twoOrF z (Function.update x 0 (!x 0)) ≠ twoOrF z x := by
    rcases hz with rfl | rfl <;> exact ⟨fun _ => false, by decide +kernel⟩
  have hn_0 : ∃ x y : Fin 9 → Bool,
      twoOrF z (Function.update x 0 false) ≠ twoOrF z (Function.update y 0 false) := by
    rcases hz with rfl | rfl <;>
      exact ⟨fun _ => false, fun i => decide (i = 1 ∨ i = 6), by decide +kernel⟩
  have h_succ : HasCircuitSize 9 (twoOrF z) ((s - 1) + 1) := by
    rwa [Nat.sub_add_cancel hs1]
  have hc1 := one_gate_at 8 (twoOrF z) 0 false (s - 1) hd_0 hn_0 h_succ
  have heq : (fun x : Fin 9 → Bool => twoOrF z (Function.update x 0 false)) = orF z := by
    rcases hz with rfl | rfl <;> funext x <;> revert x <;> decide +kernel
  rw [heq] at hc1
  have hb := orF_bound z hz (s - 1) hc1
  omega

theorem true_case (y : Fin 9) (hy : y = 4 ∨ y = 5) (s : ℕ)
    (h : HasCircuitSize 9 (fun x => Maj.EdgeFn.target (Function.update x y true)) s) : 11 ≤ s := by
  rcases hy with rfl | rfl
  · have heq : (fun x : Fin 9 → Bool => Maj.EdgeFn.target (Function.update x 4 true)) = twoOrF 5 := by
      funext x; revert x; decide +kernel
    rw [heq] at h
    exact twoOrF_bound 5 (Or.inr rfl) s h
  · have heq : (fun x : Fin 9 → Bool => Maj.EdgeFn.target (Function.update x 5 true)) = twoOrF 4 := by
      funext x; revert x; decide +kernel
    rw [heq] at h
    exact twoOrF_bound 4 (Or.inl rfl) s h

end PEqualNP.Outside.L_meta_10824


namespace PEqualNP.Outside.L_meta_10824.Bridge
open PEqualNP.Outside.L_meta_10824.Maj.EdgeFn
open PEqualNP.MetaComplexity PEqualNP.CircuitLowerBounds
open PEqualNP.Outside.L_meta_10824.Maj.Helpers
open PEqualNP.Outside.L_meta_10824.Maj.Helpers.Readers

def bridgeBase (x : Fin 9 → Bool) : Bool :=
  (x 1 && x 6) || (x 2 && x 6) || (x 1 && x 7) || (x 3 && x 7) ||
  (x 2 && x 8) || (x 3 && x 8) || (x 6 && x 8) || (x 0 && x 8)

def bridgeFun (x : Fin 9 → Bool) : Bool :=
  bridgeBase x || (x 0 && (x 4 || x 5)) || (x 4 && x 5)

def bridgeSet : Finset (Fin 9) := {4, 5}

lemma bridgeBase_zero (x : Fin 9 → Bool) : bridgeBase (zeroOn bridgeSet x) = bridgeBase x := by
  simp [bridgeBase, zeroOn, bridgeSet]

lemma bridgeBase_update4 (x : Fin 9 → Bool) (b : Bool) : bridgeBase (Function.update x 4 b) = bridgeBase x := by
  simp [bridgeBase, Function.update_apply]

lemma bridgeBase_update5 (x : Fin 9 → Bool) (b : Bool) : bridgeBase (Function.update x 5 b) = bridgeBase x := by
  simp [bridgeBase, Function.update_apply]

lemma bridgeDeep : DeepHyp bridgeFun bridgeSet := by
  classical
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · intro y hy b
    simp [bridgeSet] at hy
    rcases hy with rfl | rfl <;> cases b
    all_goals refine ⟨fun _ => false, fun i => decide (i = 1 ∨ i = 6), ?_⟩
    all_goals simp [bridgeFun, bridgeBase, Function.update_apply]
  · intro y hy z hz hne
    simp [bridgeSet] at hy hz
    rcases hy with rfl | rfl <;> rcases hz with rfl | rfl
    · exact (hne rfl).elim
    · rintro ⟨a, b, h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 0))
      cases a <;> cases b <;> simp [bridgeFun, bridgeBase, set2, Function.update_apply] at h0 h1
    · rintro ⟨a, b, h⟩
      have h0 := h (fun _ => false)
      have h1 := h (fun i => decide (i = 0))
      cases a <;> cases b <;> simp [bridgeFun, bridgeBase, set2, Function.update_apply] at h0 h1
    · exact (hne rfl).elim
  · intro y hy x hx
    have hg : bridgeBase x = false := by
      have hz : bridgeBase (zeroOn bridgeSet x) = false := by simpa [bridgeFun, zeroOn, bridgeSet] using hx
      exact (bridgeBase_zero x).symm.trans hz
    simp [bridgeSet] at hy
    rcases hy with rfl | rfl
    · let x' := Function.update (Function.update x 4 false) 5 (!x 0)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [bridgeSet] at hi
        simp [x', Function.update_of_ne hi.1, Function.update_of_ne hi.2]
      · simp [x']
      · simp [bridgeFun, bridgeBase_update4, bridgeBase_update5, x', hg]
      · cases h0 : x 0 <;> simp [bridgeFun, bridgeBase_update4, bridgeBase_update5, x', hg, h0]
    · let x' := Function.update (Function.update x 5 false) 4 (!x 0)
      refine ⟨x', ?_, ?_, ?_, ?_⟩
      · intro i hi
        simp [bridgeSet] at hi
        simp [x', Function.update_of_ne hi.1, Function.update_of_ne hi.2]
      · simp [x']
      · simp [bridgeFun, bridgeBase_update4, bridgeBase_update5, x', hg]
      · cases h0 : x 0 <;> simp [bridgeFun, bridgeBase_update4, bridgeBase_update5, x', hg, h0]
  · intro x hx
    have hg : bridgeBase x = true := by
      have hz : bridgeBase (zeroOn bridgeSet x) = true := by simpa [bridgeFun, zeroOn, bridgeSet] using hx
      exact (bridgeBase_zero x).symm.trans hz
    simp [bridgeFun, hg]
  · decide

end PEqualNP.Outside.L_meta_10824.Bridge


namespace PEqualNP.Outside.L_meta_10824.Bridge
open PEqualNP.MetaComplexity
open PEqualNP.Outside.L_meta_10824.Maj.Helpers.PermInputs

-- The false restriction leaves a 12-gate lower bound and removes three gates.
-- The true restriction leaves an 11-gate lower bound and removes four gates.
theorem mainBridge : ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 9 (fun x : Fin 9 → Bool => (x 0 && x 4) || (x 0 && x 5) || (x 4 && x 5) || (x 1 && x 6) || (x 2 && x 6) || (x 1 && x 7) || (x 3 && x 7) || (x 0 && x 8) || (x 2 && x 8) || (x 3 && x 8) || (x 6 && x 8)) t → 15 ≤ t := by
  intro t h
  have e : (fun x : Fin 9 → Bool => (x 0 && x 4) || (x 0 && x 5) || (x 4 && x 5) || (x 1 && x 6) || (x 2 && x 6) || (x 1 && x 7) || (x 3 && x 7) || (x 0 && x 8) || (x 2 && x 8) || (x 3 && x 8) || (x 6 && x 8)) = bridgeFun := by
    funext x
    revert x
    decide +kernel
  rw [e] at h
  obtain ⟨y, hy, hc⟩ := PEqualNP.Outside.L_meta_10824.Maj.stmtML_final 8 bridgeFun bridgeSet t bridgeDeep (by simp [bridgeSet]) h
  have hy' : y = 4 ∨ y = 5 := by simpa [bridgeSet] using hy
  rcases hc with ⟨s, hs, hf⟩ | ⟨s, hs, ht⟩
  · have lower : 12 ≤ s := by
      rcases hy' with rfl | rfl
      · let π : Fin 9 → Fin 8 := ![4, 5, 2, 3, 0, 7, 1, 6, 0]
        have hr := relabel_size π _ s hf
        have e' : (fun x : Fin 8 → Bool => bridgeFun (Function.update (x ∘ π) 4 false)) = (fun x : Fin 8 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 0 && x 4) || (x 1 && x 2) || (x 1 && x 5) || (x 3 && x 6) || (x 4 && x 7) || (x 5 && x 6)) := by
          funext x
          revert x
          decide +kernel
        exact PEqualNP.Outside.L_meta_10824.Stock.stockBound s (e' ▸ hr)
      · let π : Fin 9 → Fin 8 := ![4, 5, 2, 3, 7, 0, 1, 6, 0]
        have hr := relabel_size π _ s hf
        have e' : (fun x : Fin 8 → Bool => bridgeFun (Function.update (x ∘ π) 5 false)) = (fun x : Fin 8 → Bool => (x 0 && x 1) || (x 0 && x 2) || (x 0 && x 3) || (x 0 && x 4) || (x 1 && x 2) || (x 1 && x 5) || (x 3 && x 6) || (x 4 && x 7) || (x 5 && x 6)) := by
          funext x
          revert x
          decide +kernel
        exact PEqualNP.Outside.L_meta_10824.Stock.stockBound s (e' ▸ hr)
    omega
  · have equiv : (fun x : Fin 9 → Bool => bridgeFun (Function.update x y true)) =
        (fun x : Fin 9 → Bool => PEqualNP.Outside.L_meta_10824.Maj.EdgeFn.target (Function.update x y true)) := by
      rcases hy' with rfl | rfl <;> funext x <;> revert x <;> decide +kernel
    have lower := PEqualNP.Outside.L_meta_10824.true_case y hy' s (equiv ▸ ht)
    omega

end PEqualNP.Outside.L_meta_10824.Bridge

theorem PEqualNP.Outside.L_meta_10824 : ∀ t : ℕ, PEqualNP.MetaComplexity.HasCircuitSize 9 (fun x : Fin 9 → Bool => (x 0 && x 4) || (x 0 && x 5) || (x 4 && x 5) || (x 1 && x 6) || (x 2 && x 6) || (x 1 && x 7) || (x 3 && x 7) || (x 0 && x 8) || (x 2 && x 8) || (x 3 && x 8) || (x 6 && x 8)) t → 15 ≤ t :=
  PEqualNP.Outside.L_meta_10824.Bridge.mainBridge
