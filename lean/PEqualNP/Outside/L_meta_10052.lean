def transition (q : Fin 82) (i : Fin 16) : Fin 82 × Fin 16 :=
  let z := ((moves.getD q.val #[]).getD i.val 0)
  (Fin.ofNat 82 (z / 16), Fin.ofNat 16 z)

theorem entry : ∀ i j : Fin 16, adj i j = true ↔ (raw.getD i.val 0).testBit j.val = false := by decide +kernel

theorem top : ∀ j, bits 81 j = true := by decide +kernel

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
theorem step : ∀ q i j, bits (transition q i).1 (j - (transition q i).2) = (bits q j && adj i j) := by decide +kernel

theorem shift (i j s : Fin 16) : adj (i-s) (j-s) = adj i j := by
  unfold adj
  congr 2
  abel

theorem intersection (R : Finset (Fin 16)) :
    ∃ q : Fin 82, ∃ s : Fin 16, ∀ j, bits q (j-s) = true ↔ ∀ i ∈ R, adj i j = true := by
  induction R using Finset.induction_on with
  | empty =>
    refine ⟨81,0,fun j => ?_⟩
    simp [top]
  | @insert i R hi ih =>
    obtain ⟨q,s,hq⟩ := ih
    let p := transition q (i-s)
    refine ⟨p.1,s+p.2,fun j => ?_⟩
    have he : j-(s+p.2) = (j-s)-p.2 := by abel
    rw [he, step, shift, Bool.and_eq_true, hq, Finset.forall_mem_insert]
    exact and_comm

def offsets : Array ℕ := #[0, 5, 11, 12]
def offset (u : Fin 4) : Fin 16 := Fin.ofNat 16 (offsets.getD u.val 0)

theorem present : ∀ (i : Fin 16) (t : Fin 4), adj i (i+offset t) = true := by decide +kernel

def containing (q : Fin 82) (i : Fin 16) : Bool :=
  ((#[16377, 32754, 65508, 65481, 65427, 65319, 65103, 64671, 63807, 62079, 58623, 51711, 37887, 10239, 20478, 40956] : Array ℕ).getD i.val 0 &&& masks.getD q.val 0) == masks.getD q.val 0

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
theorem allow : ∀ q i, (∀ j, bits q j = true → adj i j = true) → containing q i = true := by decide +kernel

def within (q : Fin 82) : Finset (Fin 16 × Fin 4) :=
  Finset.univ.filter fun p => containing q p.1 && bits q (p.1 + offset p.2)

set_option maxRecDepth 10000 in
set_option maxHeartbeats 8000000 in
theorem bound : ∀ q, (within q).card ≤ 9 := by decide +kernel

def hits (r : Finset (Fin 16) × Finset (Fin 16)) : Finset (Fin 16 × Fin 4) :=
  Finset.univ.filter fun p => p.1 ∈ r.1 ∧ p.1 + offset p.2 ∈ r.2

theorem single (r : Finset (Fin 16) × Finset (Fin 16))
    (safe : ∀ i ∈ r.1, ∀ j ∈ r.2, adj i j = true) : (hits r).card ≤ 9 := by
  obtain ⟨q,s,hq⟩ := intersection r.1
  let move : (Fin 16 × Fin 4) ↪ (Fin 16 × Fin 4) :=
    ⟨fun p => (p.1-s,p.2), by
      intro a b h
      change (a.1 - s, a.2) = (b.1 - s, b.2) at h
      obtain ⟨ha,hb⟩ := Prod.mk.inj h
      exact Prod.ext (sub_left_inj.mp ha) hb⟩
  have sub : (hits r).map move ⊆ within q := by
    intro y hy
    obtain ⟨p,hp,rfl⟩ := Finset.mem_map.mp hy
    obtain ⟨hi,hj⟩ := (Finset.mem_filter.mp hp).2
    apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_univ _, Bool.and_eq_true_iff.mpr ⟨?_,?_⟩⟩
    · apply allow
      intro j h
      have x := (hq (j+s)).mp (by simpa using h) p.1 hi
      have eq := shift p.1 (j+s) s
      change adj (p.1 - s) j = true
      simpa only [add_sub_cancel_right] using eq.trans x
    · change bits q ((p.1-s) + offset p.2) = true
      have eq : (p.1-s) + offset p.2 = (p.1 + offset p.2)-s := by abel
      rw [eq]
      exact (hq _).mpr fun i h => safe i h _ hj
  simpa using (Finset.card_le_card sub).trans (bound q)

