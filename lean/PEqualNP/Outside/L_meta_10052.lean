theorem PEqualNP.Outside.L_meta_10052 : ¬ (∃ L : List (Finset (Fin 16) × Finset (Fin 16)), L.length ≤ 7 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([49158, 32781, 27, 54, 108, 216, 432, 864, 1728, 3456, 6912, 13824, 27648, 55296, 45057, 24579] : List ℕ).getD i.val 0).testBit j.val = false) ∧ ∀ (i : Fin 16) (j : Fin 16), (([49158, 32781, 27, 54, 108, 216, 432, 864, 1728, 3456, 6912, 13824, 27648, 55296, 45057, 24579] : List ℕ).getD i.val 0).testBit j.val = false → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) := by
  rintro ⟨L, hl, safe, cover⟩
  have hu : (Finset.univ : Finset (Fin 16 × Fin 4)) ⊆ L.toFinset.biUnion hits := by
    intro p _
    obtain ⟨r,hr,hi,hj⟩ := cover _ _ ((entry _ _).mp (present p.1 p.2))
    exact Finset.mem_biUnion.mpr ⟨r,List.mem_toFinset.mpr hr,Finset.mem_filter.mpr ⟨Finset.mem_univ _,hi,hj⟩⟩
  have total := Finset.card_le_card hu
  have boxes := Finset.card_biUnion_le_card_mul L.toFinset hits 9 (fun r hr => single r (fun i hi j hj => (entry i j).mpr (safe r (List.mem_toFinset.mp hr) i hi j hj)))
  have count := List.toFinset_card_le L
  simp only [Finset.card_univ, Fintype.card_prod, Fintype.card_fin] at total
  omega
