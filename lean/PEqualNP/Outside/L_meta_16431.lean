  rcases condition with full | absent
  · have eq : ws = inputs := beq_iff_eq.mp full
    subst ws
    exact Bool.noConfusion (allFirstPairs.symm.trans searchOK.2)
  · have diff : cuts ws ≠ -1 := by simpa using absent
    exact diff searchOK.1.2

