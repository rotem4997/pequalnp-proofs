theorem PEqualNP.Outside.L_gct_247 :
    ¬ (∀ (s : Fin 3 → ℝ) (g : Fin 3 → Polynomial ℝ), (∀ i, s i = 1 ∨ s i = -1) → (∀ i, (g i).support.card ≤ 5) → ((((Finset.univ : Finset (Fin 3)).sum fun i => Polynomial.C (s i) * g i ^ 3)).roots.toFinset.filter (fun x : ℝ => 0 < x)).card ≤ 26) := by
  intro h
  open PEqualNP.Outside.L_gct_247 in
  exact by
    have limit := h (fun _ => 1) gs (fun _ => Or.inl rfl) gs_card
    change (P.roots.toFinset.filter (fun x : ℝ => 0 < x)).card ≤ 26 at limit
    have lower := roots_lower
    norm_num [count] at lower
    omega
