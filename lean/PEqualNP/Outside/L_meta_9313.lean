def feasible (foot : β → Finset α) (U : Finset α) (A : Finset β) (k : ℕ) :=
  ∃ T : Finset β, T ⊆ A ∧ T.card ≤ k ∧ U ⊆ T.biUnion foot

def wt (w : α → ℕ) (U : Finset α) := ∑ t ∈ U, w t

theorem weightsOfCover (foot : β → Finset α) (U : Finset α) (T : Finset β) (w : α → ℕ)
    (cover : U ⊆ T.biUnion foot) : wt w U ≤ ∑ r ∈ T, wt w (U ∩ foot r) := by
  classical
  calc
    wt w U ≤ ∑ t ∈ U, ∑ r ∈ T, if t ∈ foot r then w t else 0 := by
      apply Finset.sum_le_sum
      intro t ht
      obtain ⟨r,hr,how⟩ := Finset.mem_biUnion.mp (cover ht)
      simpa only [ite_eq_left how] using
        (Finset.single_le_sum (f := fun b => if t ∈ foot b then w t else 0) (fun _ _ => Nat.zero_le _) hr)
    _ = ∑ r ∈ T, ∑ t ∈ U, if t ∈ foot r then w t else 0 := Finset.sum_comm
    _ = ∑ r ∈ T, wt w (U ∩ foot r) := by
      apply Finset.sum_congr rfl
      intro r hr
      unfold wt
      rw [← Finset.sum_filter]
      congr 1

theorem weightRefutes (foot : β → Finset α) (U : Finset α) (A : Finset β) (k m : ℕ)
    (w : α → ℕ) (total : k*m < wt w U)
    (each : ∀ r ∈ A, wt w (U ∩ foot r) ≤ m) : ¬ feasible foot U A k := by
  rintro ⟨T,allowed,size,cov⟩
  have sumle := Finset.sum_le_sum (s:=T) (f:=fun r => wt w (U ∩ foot r)) (g:=fun _ => m)
    (fun r hr => each r (allowed hr))
  have h : wt w U ≤ T.card * m := by
    simpa only [Finset.sum_const,Nat.nsmul_eq_mul] using (weightsOfCover foot U T w cov).trans sumle
  exact (Nat.not_lt_of_ge (h.trans (Nat.mul_le_mul_right m size))) total

theorem leftChild (foot : β → Finset α) (U : Finset α) (A T : Finset β) (k : ℕ)
    (allowed : T ⊆ A) (size : T.card ≤ k) (cov : U ⊆ T.biUnion foot)
    (r : β) (hr : r ∈ T) : feasible foot (U \ foot r) (A.erase r) (k-1) := by
  refine ⟨T.erase r, ?_, ?_, ?_⟩
  · intro t ht
    exact Finset.mem_erase.mpr ⟨(Finset.mem_erase.mp ht).1,allowed (Finset.mem_erase.mp ht).2⟩
  · rw [Finset.card_erase_of_mem hr]
    omega
  · intro x hx
    obtain ⟨q,hq,hit⟩ := Finset.mem_biUnion.mp (cov (Finset.mem_sdiff.mp hx).1)
    have neq : q ≠ r := by
      rintro rfl
      exact (Finset.mem_sdiff.mp hx).2 hit
    exact Finset.mem_biUnion.mpr ⟨q,Finset.mem_erase.mpr ⟨neq,hq⟩,hit⟩

