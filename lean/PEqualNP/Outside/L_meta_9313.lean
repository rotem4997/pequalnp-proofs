theorem allClassified (m : Fin 8192) : classifies m.val := by
  let b : Fin 128 := ⟨m.val / 64,by omega⟩
  let z : Fin 64 := ⟨m.val % 64, Nat.mod_lt _ (by decide)⟩
  have h := chunks b z
  have e : 64*b.val+z.val = m.val := Nat.div_add_mod _ _
  exact e ▸ h


def rowBits (A : Finset V) : ℕ := A.fold (· ||| ·) 0 (fun i => 2^i.val)

theorem rowBits_bit (A : Finset V) (i : V) : (rowBits A).testBit i.val = true ↔ i ∈ A := by
  induction A using Finset.induction_on with
  | empty => simp [rowBits]
  | insert j A hj ih =>
    simp only [rowBits, Finset.fold_insert hj, Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow,
      decide_eq_true_eq, Finset.mem_insert] at *
    simpa only [Fin.val_inj, eq_comm (a := j)] using (or_congr Iff.rfl ih)

def mask (A : Finset V) : Fin 8192 := Fin.ofNat 8192 (rowBits A)

theorem mask_bit (A : Finset V) (i : V) : (mask A).val.testBit i.val = true ↔ i ∈ A := by
  change ((rowBits A) % (2^13)).testBit i.val = true ↔ _
  simp only [Nat.testBit_mod_two_pow, decide_eq_true i.isLt, Bool.true_and, rowBits_bit]

theorem full_bit (j : V) : (8191 : ℕ).testBit j.val = true := by
  change (2^13-1 : ℕ).testBit j.val = true
  exact (Nat.testBit_two_pow_sub_one 13 j.val).trans (decide_eq_true j.isLt)

theorem common_bit (A : Finset V) (j : V)
    (clean : ∀ i ∈ A, (rowWord i.val).testBit j.val = false) :
    (common (mask A).val).testBit j.val = true := by
  unfold common
  apply List.foldlRecOn (motive := fun s : ℕ => s.testBit j.val = true) _ _ (full_bit j)
  intro b hb i hi
  have bound := List.mem_range.mp hi
  let v : V := ⟨i,bound⟩
  by_cases hm : (mask A).val.testBit i = true
  · have mem : v ∈ A := (mask_bit A v).mp hm
    have hz : (rowWord i).testBit j.val = false := clean v mem
    simp only [step,hm,ite_true,Nat.testBit_and,Nat.testBit_xor,full_bit j,hz,hb,
      Bool.xor_false, Bool.true_and]
  · simp [step,hm,hb]

theorem keepBit {a b i : ℕ} (h : a &&& b = a) (keep : a.testBit i = true) :
    b.testBit i = true := by
  have eq := congrArg (fun n : ℕ => n.testBit i) h
  simpa only [Nat.testBit_and,keep,Bool.true_and] using eq

theorem hit (A B : Finset V) (clean : ∀ i ∈ A, ∀ j ∈ B, (rowWord i.val).testBit j.val = false)
    (c : C) (hi : rowOf c ∈ A) (hj : colOf c ∈ B) : c ∈ foot (toRect (mask A).val) := by
  have ri := (mask_bit A (rowOf c)).mpr hi
  have cj := common_bit A (colOf c) (fun i h => clean i h _ hj)
  rcases allClassified (mask A) with h | h | ⟨hr,hc⟩
  · rw [h] at ri
    simp at ri
  · rw [h] at cj
    simp at cj
  · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,by
      simp only [inRect,keepBit hr ri,keepBit hc cj,Bool.and_self]⟩

theorem extendCover (L : List (Finset V × Finset V)) (size : L.length ≤ 11)
    (clean : ∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (rowWord i.val).testBit j.val = false)
    (cover : ∀ i j : V, (rowWord i.val).testBit j.val = false →
      ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) :
    feasible foot Finset.univ Finset.univ 11 := by
  let rect (r : Finset V × Finset V) := toRect (mask r.1).val
  refine ⟨L.toFinset.image rect,Finset.subset_univ _,?_,?_⟩
  · exact (Finset.card_image_le).trans ((List.toFinset_card_le (l := L)).trans size)
  · intro c _
    obtain ⟨r,hr,hi,hj⟩ := cover (rowOf c) (colOf c) (zeroCells c)
    exact Finset.mem_biUnion.mpr ⟨rect r,Finset.mem_image.mpr ⟨r,List.mem_toFinset.mpr hr,rfl⟩,
      hit r.1 r.2 (clean r hr) c hi hj⟩


