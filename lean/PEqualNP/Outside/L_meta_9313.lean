  lane table 700 (c % 8)
def assembleCol : ℕ → ℕ → ℕ
  | 0, _ => 0
  | n+1, p => (1 <<< (22*(p % 1024))) + assembleCol n (p >>> 10)
def column (c : ℕ) := assembleCol 70 (columnRows c)
def vector (b w : ℕ) := rawSum (fun c => lane w b c * column c) 117
def scanVector (b w m mask : ℕ) :=
  forceNat (vector b w) fun v => forceNat m fun m => forceNat mask fun mask =>
  allN (fun r => decide (lane v 22 r ≤ m) || mask.testBit r) 702

def digits : ℕ → ℕ → (ℕ → ℕ) → ℕ
  | 0, _, _ => 0
  | n+1, a, f => f a + 4194304 * digits n (a+1) f

theorem digits_zero (n a : ℕ) : digits n a (fun _ => 0) = 0 := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => simp [digits,ih]

theorem digits_add (n a : ℕ) (f g : ℕ → ℕ) :
    digits n a (fun i => f i + g i) = digits n a f + digits n a g := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => simp only [digits,ih,Nat.mul_add]; omega

theorem digits_mul (n a k : ℕ) (f : ℕ → ℕ) :
    digits n a (fun i => k*f i) = k * digits n a f := by
  induction n generalizing a with
  | zero => simp [digits]
  | succ n ih => simp only [digits,ih,Nat.mul_add,Nat.mul_left_comm 4194304 k]

theorem digits_get (n a i : ℕ) (f : ℕ → ℕ) (hf : ∀ j, f j < 4194304) (hi : i<n) :
    (digits n a f / 4194304 ^ i) % 4194304 = f (a+i) := by
  induction n generalizing a i with
  | zero => omega
  | succ n ih =>
    cases i with
    | zero => simp [digits,Nat.mod_eq_of_lt (hf a)]
    | succ i =>
      rw [digits, Nat.pow_succ', ← Nat.div_div_eq_div_mul,
        Nat.add_mul_div_left _ _ (by decide), Nat.div_eq_of_lt (hf a), Nat.zero_add]
      have h := ih (a+1) i (by omega)
      simpa only [Nat.add_right_comm a 1 i,Nat.add_succ,Nat.add_zero] using h

def entry (c r : ℕ) : ℕ := if inRect (Fin.ofNat 702 r) (Fin.ofNat 117 c) then 1 else 0

set_option maxRecDepth 8000 in
theorem columns_valid : allN (fun c => decide (column c = digits 702 0 (entry c))) 117 = true := by decide +kernel

theorem col_valid (c : ℕ) (h : c<117) : column c = digits 702 0 (entry c) :=
  of_decide_eq_true ((allN_true ..).mp columns_valid c h)

theorem raw_congr (n : ℕ) (f g : ℕ → ℕ) (h : ∀ i<n, f i=g i) : rawSum f n = rawSum g n := by
  rw [rawSum_eq,rawSum_eq]
  exact Finset.sum_congr rfl (fun i hi => h i (Finset.mem_range.mp hi))

theorem digits_sum (t n a : ℕ) (f : ℕ → ℕ → ℕ) :
    rawSum (fun c => digits n a (f c)) t = digits n a (fun r => rawSum (fun c => f c r) t) := by
  induction t with
  | zero => simp [rawSum,digits_zero]
  | succ t ih => simp only [rawSum,ih,digits_add]

theorem vector_eq (b w : ℕ) : vector b w =
    digits 702 0 (fun r => rawSum (fun c => lane w b c * entry c r) 117) := by
  unfold vector
  rw [← digits_sum]
  apply raw_congr
  intro c hc
  rw [col_valid c hc,digits_mul]

theorem vector_digit (b w : ℕ) (hb : b ≤ 15) (r : R) : lane (vector b w) 22 r.val =
    rawSum (fun c => lane w b c * entry c r.val) 117 := by
  let f := fun j => rawSum (fun c => lane w b c * entry c j) 117
  have bd : ∀ c, lane w b c ≤ 32768 := by
    intro c
    exact (Nat.mod_lt _ (Nat.two_pow_pos _)).le.trans (Nat.pow_le_pow_right (by decide) hb)
  have bounds : ∀ j, f j < 4194304 := by
    intro j
    have small := Finset.sum_le_sum (s := Finset.range 117)
      (f := fun c => lane w b c * entry c j) (g := fun _ => 32768)
      (fun c _ => by unfold entry; split <;> simp [bd c])
    have lim : f j ≤ 117 * 32768 := by
      dsimp only [f]
      rw [rawSum_eq]
      simpa only [Finset.sum_const,Finset.card_range,Nat.nsmul_eq_mul] using small
    exact lim.trans_lt (by decide)
  have h := digits_get 702 0 r.val f bounds r.isLt
  rw [vector_eq]
  change (digits 702 0 f >>> (22*r.val)) % (2^22) = f r.val
  rw [Nat.shiftRight_eq_div_pow,Nat.pow_mul]
  rw [show (2 : ℕ)^22 = 4194304 by decide]
  simpa only [Nat.zero_add] using h

theorem vector_bound (b w : ℕ) (hb : b ≤ 15) (U : Finset C) (r : R) :
    wt (fun c : C => lane w b c.val) (U ∩ foot r) ≤ lane (vector b w) 22 r.val := by
  rw [vector_digit b w hb r,rawSum_eq, ← Fin.sum_univ_eq_sum_range _ 117]
  calc
    _ ≤ wt (fun c : C => lane w b c.val) (foot r) := Finset.sum_le_sum_of_subset Finset.inter_subset_right
    _ = _ := by
      unfold wt foot
      rw [Finset.sum_filter]
      apply Finset.sum_congr rfl
      intro c _
      have er : Fin.ofNat 702 r.val = r := Fin.ext (Nat.mod_eq_of_lt r.isLt)
      have ec : Fin.ofNat 117 c.val = c := Fin.ext (Nat.mod_eq_of_lt c.isLt)
      simp only [entry,er,ec]
      split <;> simp_all

theorem scanVector_eq (b w m mask : ℕ) : scanVector b w m mask =
    allN (fun r => decide (lane (vector b w) 22 r ≤ m) || mask.testBit r) 702 := by
  simp only [scanVector,force_eq]

def nodeOK (n : ℕ) : Bool :=
  let b := bWidth n
  let w := nodeWord n
  let es := edges n
  let m := cap n
  let mask := edgeMask es
  decide (budget n * m < rawSum (lane w b) 117) &&
  ((state n).all (fun r => decide (score b w 12 (packedSlots r.val) = 0)) &&
   (scanVector b w m mask &&
    es.all (edgeOK n)))


theorem mask_has (es : List ℕ) (r : R) : (edgeMask es).testBit r.val = true ↔
    ∃ e ∈ es, edgeRect e = r := by
  induction es with
  | nil => simp [edgeMask]
  | cons e es ih =>
    simp only [edgeMask,Nat.testBit_or,Nat.testBit_two_pow,Bool.or_eq_true,decide_eq_true_eq,
      Fin.val_inj,ih,List.mem_cons,exists_eq_or_imp]

theorem mass_remaining (s : List R) (b w : ℕ)
    (clears : ∀ r ∈ s, score b w 12 (packedSlots r.val) = 0) :
    wt (fun c : C => lane w b c.val) (remaining s) = rawSum (lane w b) 117 := by
  rw [← total_eq]
  apply Finset.sum_subset (Finset.subset_univ _)
  intro c _ h
  have hx : ¬ ∀ r ∈ s, c ∉ foot r := fun hc => h ((remaining_mem ..).mpr hc)
  push Not at hx
  obtain ⟨r,hr,hit⟩ := hx
  have single : lane w b c.val ≤ wt (fun q : C => lane w b q.val) (Finset.univ ∩ foot r) :=
    Finset.single_le_sum (f := fun q : C => lane w b q.val) (fun _ _ => Nat.zero_le _)
      (Finset.mem_inter.mpr ⟨Finset.mem_univ _,hit⟩)
  have hbound := (single.trans (score_bound b w Finset.univ r)).trans_eq (clears r hr)
  exact Nat.le_zero.mp hbound

theorem edge_correct (n e : ℕ) (h : edgeOK n e = true) :
    n < dest e ∧ dest e < 1543 ∧ budget (dest e) = budget n - 1 ∧
      (sol (edgeRect e :: state n) (budget n - 1) → sol (state (dest e)) (budget (dest e))) := by
  obtain ⟨valid,subset⟩ := Bool.and_eq_true_iff.mp h
  obtain ⟨later,inRange,eq⟩ := of_decide_eq_true valid
  refine ⟨later,inRange,eq,?_⟩
  rw [eq]
  intro hsol
  apply sol_mono _ _ _ _ (sol_moves 6 (e >>> 21) _ _ hsol)
  intro r hr
  exact List.contains_iff_mem.mp (List.all_eq_true.mp subset r hr)

theorem reject_node (n : ℕ) (checks : nodeOK n = true)
    (children : ∀ d, n < d → d < 1543 → ¬ sol (state d) (budget d)) :
    ¬ sol (state n) (budget n) := by
  obtain ⟨total,more⟩ := Bool.and_eq_true_iff.mp checks
  obtain ⟨clear,more⟩ := Bool.and_eq_true_iff.mp more
  obtain ⟨candidate,bounds⟩ := Bool.and_eq_true_iff.mp more
  let U := remaining (state n)
  let w := fun c : C => lane (nodeWord n) (bWidth n) c.val
  have large : budget n * cap n < wt w U := by
    rw [mass_remaining]
    · exact of_decide_eq_true total
    · intro r hr
      exact of_decide_eq_true (List.all_eq_true.mp clear r hr)
  rintro ⟨T,allowed,size,cov⟩
  have sel : ∃ r ∈ T, cap n < wt w (U ∩ foot r) := by
    by_contra! h
    apply weightRefutes foot U T (budget n) (cap n) w large h
    exact ⟨T,Finset.Subset.rfl,size,cov⟩
  obtain ⟨r,hr,heavy⟩ := sel
  have hb : bWidth n ≤ 15 := Nat.le_of_lt_succ (Nat.mod_lt _ (by decide : 0 < 16))
  have high := heavy.trans_le (vector_bound (bWidth n) (nodeWord n) hb U r)
  rw [scanVector_eq] at candidate
  have listed := (allN_true ..).mp candidate r.val r.isLt
  rcases Bool.or_eq_true_iff.mp listed with small | mask
  · exact (Nat.not_le_of_lt high) (of_decide_eq_true small)
  · obtain ⟨e,he,matchR⟩ := (mask_has ..).mp mask
    obtain ⟨later,inRange,_,send⟩ := edge_correct n e (List.all_eq_true.mp bounds e he)
    apply children (dest e) later inRange
    apply send
    rw [matchR]
    obtain ⟨T',_,size',cov'⟩ := leftChild foot U Finset.univ T (budget n) allowed size cov r hr
    refine ⟨T',Finset.subset_univ _,size',?_⟩
    rw [remaining_cons]
    exact cov'

theorem sound (checks : ∀ n < 1543, nodeOK n = true) (n : ℕ) (hn : n < 1543) :
    ¬ sol (state n) (budget n) := by
  apply reject_node n (checks n hn)
  intro d later inRange
  exact sound checks d inRange
termination_by 1543-n


