theorem genTests : allN testGen 10 = true := by decide +kernel

theorem gen_parts (g : Fin 10) : testGen g.val = true := (allN_true ..).mp genTests _ g.isLt

theorem gen_back (g : Fin 10) (c : C) : genC g (genC (inverseGen g) c) = c := by
  have h := (Bool.and_eq_true_iff.mp (gen_parts g)).1
  have e := (allN_true ..).mp h c.val c.isLt
  have eg : Fin.ofNat 10 g.val = g := Fin.ext (Nat.mod_eq_of_lt g.isLt)
  have ec : Fin.ofNat 117 c.val = c := Fin.ext (Nat.mod_eq_of_lt c.isLt)
  simpa only [eg,ec,decide_eq_true_eq] using e

theorem gen_preserves (g : Fin 10) (r : R) (c : C) (h : c ∈ foot r) :
    genC g c ∈ foot (genR g r) := by
  have check := (Bool.and_eq_true_iff.mp (gen_parts g)).2
  have listed := (allN_true ..).mp check r.val r.isLt
  have eg : Fin.ofNat 10 g.val = g := Fin.ext (Nat.mod_eq_of_lt g.isLt)
  have er : Fin.ofNat 702 r.val = r := Fin.ext (Nat.mod_eq_of_lt r.isLt)
  have ec : Fin.ofNat 117 c.val = c := Fin.ext (Nat.mod_eq_of_lt c.isLt)
  simp only [er,eg] at listed
  have x := List.all_eq_true.mp listed c.val (slots_cover r c h)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, by simpa only [ec,decide_eq_false (Nat.not_le.mpr c.isLt),Bool.false_or] using x⟩

def remaining (s : List R) : Finset C := Finset.univ \ s.toFinset.biUnion foot
def sol (s : List R) (k : ℕ) := feasible foot (remaining s) Finset.univ k

theorem remaining_mem (s : List R) (c : C) : c ∈ remaining s ↔ ∀ r ∈ s, c ∉ foot r := by
  simp [remaining]

theorem remaining_cons (s : List R) (r : R) : remaining (r::s) = remaining s \ foot r := by
  ext c
  simp only [remaining_mem, List.mem_cons, forall_eq_or_imp, Finset.mem_sdiff]
  tauto

theorem sol_mono (s t : List R) (k : ℕ) (h : ∀ r ∈ s, r ∈ t) : sol s k → sol t k := by
  rintro ⟨T,ha,size,cov⟩
  refine ⟨T,ha,size,?_⟩
  intro c hc
  exact cov ((remaining_mem ..).mpr (fun r hr => (remaining_mem ..).mp hc r (h r hr)))

theorem sol_gen (g : Fin 10) (s : List R) (k : ℕ) : sol s k → sol (s.map (genR g)) k := by
  rintro ⟨T,_,size,cov⟩
  refine ⟨T.image (genR g),Finset.subset_univ _,Finset.card_image_le.trans size,?_⟩
  intro c hc
  let a := genC (inverseGen g) c
  have eq : genC g a = c := gen_back g c
  have ha : a ∈ remaining s := by
    apply (remaining_mem ..).mpr
    intro r hr hit
    exact (remaining_mem ..).mp hc (genR g r) (List.mem_map.mpr ⟨r,hr,rfl⟩)
      (eq ▸ gen_preserves g r a hit)
  obtain ⟨r,hr,hit⟩ := Finset.mem_biUnion.mp (cov ha)
  exact Finset.mem_biUnion.mpr ⟨genR g r,Finset.mem_image.mpr ⟨r,hr,rfl⟩,eq ▸ gen_preserves g r a hit⟩

