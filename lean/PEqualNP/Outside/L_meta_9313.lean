def score (b w : ℕ) : ℕ → ℕ → ℕ
  | 0, _ => 0
  | n+1, p => lane w b (p % 128) + score b w n (p >>> 7)
def allN (p : ℕ → Bool) : ℕ → Bool
  | 0 => true
  | n+1 => p n && allN p n
theorem allN_true (p : ℕ → Bool) : ∀ n, allN p n = true ↔ ∀ x < n, p x = true := by
  intro n
  induction n with
  | zero => simp [allN]
  | succ n ih =>
    rw [allN,Bool.and_eq_true,ih]
    constructor
    · rintro ⟨hn,smaller⟩ x hx
      rcases Nat.lt_succ_iff_lt_or_eq.mp hx with h | rfl
      · exact smaller _ h
      · exact hn
    · intro h
      exact ⟨h _ (by omega),fun i hi => h i (by omega)⟩

def slots : ℕ → ℕ → List ℕ
  | 0, _ => []
  | n+1, p => p % 128 :: slots n (p >>> 7)

theorem score_sum (b w : ℕ) : ∀ n p, score b w n p = ((slots n p).map (lane w b)).sum := by
  intro n
  induction n with
  | zero => simp [score,slots]
  | succ n ih => intro p; simp [score,slots,ih]

def tableRowOK (r : ℕ) : Bool :=
  allN (fun i => !(inRect (Fin.ofNat 702 r) (Fin.ofNat 117 i)) ||
    ((slots 12 (packedSlots r)).contains i)) 117

set_option maxRecDepth 6000 in
theorem slots_cover_table : allN tableRowOK 702 = true := by decide +kernel

theorem slots_cover (r : R) (c : C) (h : c ∈ foot r) : c.val ∈ slots 12 (packedSlots r.val) := by
  have selected := (Finset.mem_filter.mp h).2
  have hr := (allN_true ..).mp slots_cover_table r.val r.isLt
  have hc := (allN_true ..).mp hr c.val c.isLt
  have er : Fin.ofNat 702 r.val = r := Fin.ext (Nat.mod_eq_of_lt r.isLt)
  have ec : Fin.ofNat 117 c.val = c := Fin.ext (Nat.mod_eq_of_lt c.isLt)
  simpa only [er,ec,selected,Bool.not_true,Bool.false_or,List.contains_iff_mem] using hc

theorem sum_toFinset_bound (l : List ℕ) (f : ℕ → ℕ) : ∑ i ∈ l.toFinset, f i ≤ (l.map f).sum := by
  induction l with
  | nil => simp
  | cons a l ih =>
    by_cases h : a ∈ l.toFinset
    · simp only [List.toFinset_cons,Finset.insert_eq_of_mem h,List.map_cons,List.sum_cons]
      omega
    · simp only [List.toFinset_cons,Finset.sum_insert h,List.map_cons,List.sum_cons]
      omega

theorem score_bound (b w : ℕ) (U : Finset C) (r : R) :
    wt (fun c : C => lane w b c.val) (U ∩ foot r) ≤ score b w 12 (packedSlots r.val) := by
  let V := U ∩ foot r
  have subset : V.image Fin.val ⊆ (slots 12 (packedSlots r.val)).toFinset := by
    intro i hi
    obtain ⟨c,hc,rfl⟩ := Finset.mem_image.mp hi
    exact List.mem_toFinset.mpr (slots_cover r c (Finset.mem_inter.mp hc).2)
  calc
    _ = ∑ i ∈ V.image Fin.val, lane w b i := by
      unfold wt
      rw [Finset.sum_image (fun x _ y _ h => Fin.ext h)]
    _ ≤ ∑ i ∈ (slots 12 (packedSlots r.val)).toFinset, lane w b i := Finset.sum_le_sum_of_subset subset
    _ ≤ _ := by rw [score_sum]; exact sum_toFinset_bound _ _

def rawSum (f : ℕ → ℕ) : ℕ → ℕ
  | 0 => 0
  | n+1 => rawSum f n + f n

theorem rawSum_eq (f : ℕ → ℕ) (n : ℕ) : rawSum f n = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp [rawSum]
  | succ n ih => simp [rawSum,ih,Finset.sum_range_succ]

theorem total_eq (b w : ℕ) : wt (fun c : C => lane w b c.val) Finset.univ = rawSum (lane w b) 117 := by
  unfold wt
  rw [rawSum_eq]
  exact Fin.sum_univ_eq_sum_range (lane w b) 117


