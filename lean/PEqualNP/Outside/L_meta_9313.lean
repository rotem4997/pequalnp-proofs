theorem verified_nodes (n : ℕ) (hn : n < 1543) : nodeOK n = true := by
  let b : Fin 97 := ⟨n / 16, by omega⟩
  have eq : 16*b.val+n % 16=n := Nat.div_add_mod _ _
  have lo : n % 16 < 16 := Nat.mod_lt _ (by decide)
  have hi : n % 16 < min 16 (1543-16*b.val) := lt_min lo (by omega)
  have h := (allN_true ..).mp (checks b) (n % 16) hi
  exact eq ▸ h

