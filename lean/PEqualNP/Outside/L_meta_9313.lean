def bWidth (n : ℕ) := metadata n % 16
def depth (n : ℕ) := (metadata n >>> 4) % 8
def budget (n : ℕ) := 11 - depth n
def cap (n : ℕ) := (metadata n >>> 7) % 32768
def nodeWord (n : ℕ) := (weightBlock n >>> ((metadata n >>> 22) % 65536)) % (2^(117*bWidth n))
def unpackState : ℕ → ℕ → List R
  | 0, _ => []
  | n+1, p => Fin.ofNat 702 (p % 1024) :: unpackState n (p >>> 10)
def state (n : ℕ) := unpackState (depth n) (metadata n >>> 38)
def edges (n : ℕ) := (List.range (edgeStart (n+1) - edgeStart n)).map (fun j => edgeAt (edgeStart n+j))
def edgeRect (e : ℕ) : R := Fin.ofNat 702 (e % 1024)
def dest (e : ℕ) := (e >>> 10) % 2048
def edgeMask : List ℕ → ℕ
  | [] => 0
  | e::es => (2^(edgeRect e).val) ||| edgeMask es
def edgeOK (n e : ℕ) : Bool :=
  decide (n < dest e ∧ dest e < 1543 ∧ budget (dest e) = budget n - 1) &&
  (moveState 6 (e >>> 21) (edgeRect e :: state n)).all (fun r => (state (dest e)).contains r)
def forceNat {α : Type} (x : ℕ) (f : ℕ → α) := match x with
  | 0 => f 0
  | n+1 => f (n+1)
theorem force_eq {α : Type} (x : ℕ) (f : ℕ → α) : forceNat x f = f x := by cases x <;> rfl

