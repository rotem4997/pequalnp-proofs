def inverseGen (g : Fin 10) : Fin 10 := Fin.ofNat 10 (lane 0x8967453120 4 g.val)
def testGen (i : ℕ) : Bool :=
  let g := Fin.ofNat 10 i
  allN (fun x => let c := Fin.ofNat 117 x
                 decide (genC g (genC (inverseGen g) c) = c)) 117 &&
  allN (fun x => let r := Fin.ofNat 702 x
                 (slots 12 (packedSlots r.val)).all (fun y =>
                   decide (117 ≤ y) || inRect (genR g r) (genC g (Fin.ofNat 117 y)))) 702

