lemma choicesEmpty : choices0 = false := by decide +kernel

lemma noRanks :
    ∀ v0 : Fin 5,
    ∀ v1 : Fin 5,
    (v0 ≠ v1) →
    ∀ v6 : Fin 5,
    (v1 ≠ v6 ∧ (v0 = v6 → v1 ≤ v0)) →
    ∀ v5 : Fin 5,
    (v0 ≠ v5 ∧ (v1 = v5 → v6 ≤ v1) ∧ (v5 = v6 → v1 ≤ v5)) →
    ∀ v8 : Fin 5,
    (v5 ≠ v8 ∧ v6 ≠ v8 ∧ (v0 = v8 → v5 ≤ v0) ∧ (v1 = v5 → v8 ≤ v1) ∧ (v1 = v8 → v6 ≤ v1) ∧ (v5 = v6 → v8 ≤ v5)) →
    ∀ v3 : Fin 5,
    (v3 ≠ v8 ∧ (v0 = v3 → v1 ≤ v0) ∧ (v0 = v3 → v5 ≤ v0) ∧ (v0 = v8 → v3 ≤ v0) ∧ (v1 = v3 → v6 ≤ v1) ∧ (v1 = v3 → v8 ≤ v1) ∧ (v1 = v8 → v3 ≤ v1) ∧ (v3 = v5 → v8 ≤ v3) ∧ (v3 = v6 → v1 ≤ v3) ∧ (v3 = v6 → v8 ≤ v3)) →
    ∀ v4 : Fin 5,
    (v3 ≠ v4 ∧ (v0 = v4 → v5 ≤ v0) ∧ (v1 = v4 → v0 ≤ v1) ∧ (v3 = v5 → v4 ≤ v3) ∧ (v4 = v5 → v0 ≤ v4) ∧ (v4 = v8 → v3 ≤ v4)) →
    ∀ v2 : Fin 5,
    (v2 ≠ v3 ∧ (v0 = v2 → v3 ≤ v0) ∧ (v2 = v4 → v3 ≤ v2) ∧ (v2 = v5 → v0 ≤ v2) ∧ (v2 = v8 → v3 ≤ v2) ∧ (v2 = v8 → v6 ≤ v2) ∧ (v3 = v5 → v2 ≤ v3)) →
    ∀ v7 : Fin 5,
    (v2 ≠ v7 ∧ v5 ≠ v7 ∧ (v0 = v2 → v7 ≤ v0) ∧ (v0 = v7 → v2 ≤ v0) ∧ (v0 = v7 → v5 ≤ v0) ∧ (v1 = v2 → v7 ≤ v1) ∧ (v1 = v5 → v7 ≤ v1) ∧ (v1 = v7 → v2 ≤ v1) ∧ (v2 = v5 → v7 ≤ v2) ∧ (v2 = v6 → v7 ≤ v2) ∧ (v3 = v7 → v2 ≤ v3) ∧ (v4 = v7 → v3 ≤ v4) ∧ (v6 = v7 → v2 ≤ v6) ∧ (v7 = v8 → v2 ≤ v7) ∧ (v7 = v8 → v5 ≤ v7)) →
    False := by
  intro v0 v1 g1 v6 g6 v5 g5 v8 g8 v3 g3 v4 g4 v2 g2 v7 g7
  have h7 : choices7 v0 v1 v6 v5 v8 v3 v4 v2 = true :=
    List.any_eq_true.mpr ⟨v7, List.mem_finRange v7, decide_eq_true g7⟩
  have h2 : choices2 v0 v1 v6 v5 v8 v3 v4 = true :=
    List.any_eq_true.mpr ⟨v2, List.mem_finRange v2, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g2, h7⟩⟩
  have h4 : choices4 v0 v1 v6 v5 v8 v3 = true :=
    List.any_eq_true.mpr ⟨v4, List.mem_finRange v4, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g4, h2⟩⟩
  have h3 : choices3 v0 v1 v6 v5 v8 = true :=
    List.any_eq_true.mpr ⟨v3, List.mem_finRange v3, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g3, h4⟩⟩
  have h8 : choices8 v0 v1 v6 v5 = true :=
    List.any_eq_true.mpr ⟨v8, List.mem_finRange v8, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g8, h3⟩⟩
  have h5 : choices5 v0 v1 v6 = true :=
    List.any_eq_true.mpr ⟨v5, List.mem_finRange v5, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g5, h8⟩⟩
  have h6 : choices6 v0 v1 = true :=
    List.any_eq_true.mpr ⟨v6, List.mem_finRange v6, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g6, h5⟩⟩
  have h1 : choices1 v0 = true :=
    List.any_eq_true.mpr ⟨v1, List.mem_finRange v1, Bool.and_eq_true_iff.mpr ⟨decide_eq_true g1, h6⟩⟩
  have h0 : choices0  = true :=
    List.any_eq_true.mpr ⟨v0, List.mem_finRange v0, h1⟩
  exact Bool.noConfusion (choicesEmpty.symm.trans h0)

