def W (x1 x2 x3 : Nat) (x4 x5 : Bool) : Nat :=
  (T.getD x1 []).getD ((x2 * 10 + x3) * 4 + (if x4 then 2 else 0) + (if x5 then 1 else 0)) 0

def edgeF (f : Fin 10 → Bool) : Bool :=
  (List.finRange 10).any fun i => (List.finRange 10).any fun j =>
    f i && f j && (Ls.getD i 0).testBit j

def good (x1 x2 x3 : Fin 10) (x4 x5 : Bool) : Bool :=
  let f := fun i : Fin 10 => (W x1 x2 x3 x4 x5).testBit i
  f x2 == x4 && f x3 == x5 && !edgeF (Function.update f x1 false) &&
    edgeF (Function.update f x1 true)

def ok (x1 : Fin 10) : Bool := (List.finRange 10).all fun x2 => (List.finRange 10).all fun x3 =>
  [false, true].all fun x4 => [false, true].all fun x5 =>
  (x1 == x2 || x1 == x3 || x2 == x3 || (x4 && x5 && (Ls.getD x2 0).testBit x3)) ||
    good x1 x2 x3 x4 x5

theorem ok0 : ok 0 = true := by decide +kernel
theorem ok1 : ok 1 = true := by decide +kernel
theorem ok2 : ok 2 = true := by decide +kernel
theorem ok3 : ok 3 = true := by decide +kernel
theorem ok4 : ok 4 = true := by decide +kernel
theorem ok5 : ok 5 = true := by decide +kernel
theorem ok6 : ok 6 = true := by decide +kernel
theorem ok7 : ok 7 = true := by decide +kernel
theorem ok8 : ok 8 = true := by decide +kernel
theorem ok9 : ok 9 = true := by decide +kernel

theorem ok_all (x1 : Fin 10) : ok x1 = true := by
  fin_cases x1
  exacts [ok0, ok1, ok2, ok3, ok4, ok5, ok6, ok7, ok8, ok9]

theorem good_of (x1 x2 x3 : Fin 10) (x4 x5 : Bool) (h12 : x1 ≠ x2) (h13 : x1 ≠ x3)
    (h23 : x2 ≠ x3) (hn : ¬(x4 = true ∧ x5 = true ∧ (Ls.getD x2 0).testBit x3 = true)) :
    good x1 x2 x3 x4 x5 = true := by
  have h := ok_all x1
  unfold ok at h
  simp only [List.all_eq_true, List.mem_finRange, true_implies] at h
  have h' := h x2 x3 x4 (by cases x4 <;> simp) x5 (by cases x5 <;> simp)
  have e1 : (x1 == x2) = false := by simpa using h12
  have e2 : (x1 == x3) = false := by simpa using h13
  have e3 : (x2 == x3) = false := by simpa using h23
  have e4 : (x4 && x5 && (Ls.getD x2 0).testBit x3) = false := by
    cases x4 <;> cases x5 <;> simp_all
  rw [e1, e2, e3, e4] at h'
  simpa using h'

theorem edgeF_eq (f : Fin 10 → Bool) :
    decide (∃ (i : Fin 10) (j : Fin 10), f i = true ∧ f j = true ∧
      (Ls.getD i 0).testBit j = true) = edgeF f := by
  rw [Bool.eq_iff_iff]
  simp [edgeF, List.any_eq_true, and_assoc]

