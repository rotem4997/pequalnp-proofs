          prefixBase _ (by simp) _ j x rfl pin pbound (pval x)
        have h1 : Wires f w' W := h0.run pre
        have len (gs : List Gate) (z : List Bool) : (gs.foldl step z).length=z.length+gs.length := by
          induction gs generalizing z with
          | nil => simp
          | cons h gs ih =>
            rw [List.foldl_cons,ih]
            simp [step]; omega
        have wn : w'.length=n := by simp [w',w,step,len,n]
        have tw : t < w'.length := by
          change t < 8+(g::pre).length at below
          rw [wn]
          dsimp [n]
          simp only [List.length_cons] at below; omega
        have h2 : Wires u (w'++[w'.getD t false]) W := by
          simpa [u,←wn] using h1.withDuplicate t tw
        have h3 := (h2.run B.gates).value B.output
        change ((pre.map (remap f) ++ B.gates.map (remap u)).foldl step (augment x j)).getD (u B.output) false = table x
        rw [List.foldl_append]
        exact h3.symm.trans ((pred x).trans (tables_eq x))
      have lb := lower j D dok good
      simp [D,Circuit.size] at lb size
      omega

