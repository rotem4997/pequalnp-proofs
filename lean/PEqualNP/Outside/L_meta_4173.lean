def step (w : List Bool) (g : Gate) := w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]
def remap (f : Nat → Nat) (g : Gate) : Gate := ⟨g.op,g.inputs.map f⟩

structure Wires (f : Nat → Nat) (w W : List Bool) : Prop where
  value : ∀ i, w.getD i false = W.getD (f i) false
  valid : ∀ i, i < w.length → f i < W.length
  future : ∀ i, w.length ≤ i → f i = W.length+(i-w.length)

theorem readSnoc (w : List Bool) (b : Bool) (i : Nat) :
    (w++[b]).getD i false = if i = w.length then b else w.getD i false := by
  by_cases eq : i = w.length
  · subst i; simp [List.getD]
  · rw [if_neg eq]
    by_cases lt : i < w.length
    · simp [List.getD,List.getElem?_append_left lt]
    · rw [List.getD_eq_default _ _ (by simp; omega),List.getD_eq_default _ _ (by omega)]

theorem Wires.snoc (h : Wires f w W) (b : Bool) : Wires f (w++[b]) (W++[b]) := by
  have iff (i) : f i = W.length ↔ i = w.length := by
    by_cases lt : i < w.length
    · have := h.valid i lt; omega
    · have := h.future i (by omega); omega
  refine ⟨fun i => ?_,fun i hi => ?_,fun i hi => ?_⟩
  · simp only [readSnoc,iff,h.value]
  · simp only [List.length_append,List.length_singleton] at hi ⊢
    by_cases lt : i < w.length
    · have := h.valid i lt; omega
    · have := h.future i (by omega); omega
  · simp only [List.length_append,List.length_singleton] at hi ⊢
    have := h.future i (by omega); omega

theorem Wires.run (gs : List Gate) (h : Wires f w W) :
    Wires f (gs.foldl step w) ((gs.map (remap f)).foldl step W) := by
  induction gs generalizing w W with
  | nil => exact h
  | cons g gs ih =>
    apply ih
    have eq : (g.inputs.map fun i => w.getD i false) =
         ((remap f g).inputs.map fun i => W.getD i false) := by
      simp only [remap,List.map_map]
      apply List.map_congr_left
      intro i _; exact h.value i
    unfold step
    rw [←eq]
    exact h.snoc (g.op.eval (g.inputs.map fun i => w.getD i false))

def duplicate (f : Nat → Nat) (n pin i : Nat) :=
  if i < n then f i else if i = n then f pin else f (i-1)

theorem Wires.withDuplicate (h : Wires f w W) (t : Nat) (ht : t < w.length) :
    Wires (duplicate f w.length t) (w++[w.getD t false]) W := by
  refine ⟨fun i => ?_,fun i hi => ?_,fun i hi => ?_⟩
  · rw [readSnoc]
    by_cases lt : i < w.length
    · simp only [duplicate,if_pos lt,if_neg (Nat.ne_of_lt lt),h.value]
    · by_cases eq : i = w.length
      · simp only [duplicate,if_neg lt,if_pos eq,h.value]
      · rw [if_neg eq]
        have fut := h.future (i-1) (by omega)
        have fi : W.length ≤ f (i-1) := by omega
