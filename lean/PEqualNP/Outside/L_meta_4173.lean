  | mk o ins =>
    dsimp at op
    subst o
    change ∃ j pin, pin < 11 ∧ ∀ x : Fin 8 → Bool, GateOp.not.eval _ = _
    cases ins with
    | nil =>
      refine ⟨0,9,by decide,?_⟩
      intro x
      simp [GateOp.eval,augment,List.getD]
    | cons i is =>
      by_cases hi : i < 8
      · refine ⟨⟨i,hi⟩,8,by decide,?_⟩
        intro x
        simp [GateOp.eval,augment,List.getD,hi]
        change (List.ofFn x)[i]'(by simpa using hi) = _
        simp only [List.getElem_ofFn]
      · refine ⟨0,9,by decide,?_⟩
        intro x
        simp [GateOp.eval,augment,List.getD,hi]

def table (x : Fin 8 → Bool) : Bool := [1,12,23,4,15,26,37,46,57,74].any fun c : Nat =>
  x (Fin.ofNat 8 (c / 10)) && x (Fin.ofNat 8 (c % 10))

def target (x : Fin 8 → Bool) : Bool :=
  x 0 && x 1 || x 1 && x 2 || x 2 && x 3 || x 0 && x 4 || x 1 && x 5 ||
    x 2 && x 6 || x 3 && x 7 || x 4 && x 6 || x 5 && x 7 || x 7 && x 4

theorem tables_eq : ∀ x, target x = table x := by decide +kernel

def SignedLower := ∀ (j : Fin 8) (D : Circuit), FanInTwo D →
    (∀ x : Fin 8 → Bool, D.eval (augment x j) = table x) → 13 ≤ D.size

theorem deny (lower : SignedLower) (A B : Circuit) (t : Nat)
