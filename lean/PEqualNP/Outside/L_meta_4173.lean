      B.eval (A.wires (List.ofFn x) ++ [(A.wires (List.ofFn x)).getD t false]) = target x) : False := by
  cases A with
  | mk gs o =>
    cases gs with
    | nil =>
      change t < 8+0 at below
      omega
    | cons g pre =>
      have notg := first g rfl
      obtain ⟨j,pin,pbound,pval⟩ := firstNot g notg
      let f := prefixPin pin
      let n := 9+pre.length
      let u := duplicate f n t
      let D : Circuit := ⟨pre.map (remap f) ++ B.gates.map (remap u),u B.output⟩
