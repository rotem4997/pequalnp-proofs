def prefixPin (t i : Nat) := if i < 8 then i else if i = 8 then t else i+2
def augment (x : Fin 8 → Bool) (j : Fin 8) := List.ofFn x ++ [!x j,true,false]

theorem prefixBase (w : List Bool) (hw : w.length = 8) (z : Bool) (j : Fin 8) (x : Fin 8 → Bool)
    (wdef : w = List.ofFn x) (pin : Nat) (hp : pin < 11) (hv : z = (augment x j).getD pin false) :
    Wires (prefixPin pin) (w++[z]) (augment x j) := by
  subst w
  have hs : (augment x j).length = 11 := by simp [augment]
  refine ⟨fun i => ?_,fun i hi => ?_,fun i hi => ?_⟩
  · rw [readSnoc,hw]
    by_cases lt : i < 8
    · have l : i  <  (List.ofFn x).length := by simpa using lt
      simp only [prefixPin,if_pos lt,if_neg (Nat.ne_of_lt lt),augment,List.getD,List.getElem?_append_left l]
    · by_cases eq : i = 8
      · simpa [prefixPin,lt,eq] using hv
      · have lt' : (augment x j).length ≤ i+2 := by omega
        simp only [prefixPin,if_neg lt,if_neg eq,List.getD_eq_default _ _ (by omega : (List.ofFn x).length ≤ i),
          List.getD_eq_default _ _ lt']
  · simp only [List.length_append,List.length_singleton,hw,hs] at hi ⊢
    by_cases lt : i < 8
    · simpa [prefixPin,lt] using (show i < 11 by omega)
    · have eq : i = 8 := by omega
      simpa [prefixPin,lt,eq] using hp
  · simp only [List.length_append,List.length_singleton,hw,hs] at hi ⊢
    rw [prefixPin,if_neg (by omega),if_neg (by omega)]
    omega

