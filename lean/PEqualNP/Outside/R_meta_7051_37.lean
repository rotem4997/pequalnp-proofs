import PEqualNP.Defs

-- A case split on the output wire of the circuit. Either the output is one of the 42 input
-- wires (the circuit returns one input bit), or it is a later wire, produced by a gate or
-- past the end of the circuit. Each case is the step with that one extra hypothesis.
theorem PEqualNP.Outside.R_meta_7051_37
    (outIn : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), x1.output < (42 : ℕ) → PEqualNP.MetaComplexity.Monotone2 x1 → x1.size ≤ (124 : ℕ) → (∀ (x4 : Fin (42 : ℕ) → Bool), x1.eval (List.ofFn x4) = Bool.true ↔ ∃ (x5 : Fin (42 : ℕ)) (x6 : Fin (42 : ℕ)), (↑x5 < (21 : ℕ) ∧ (21 : ℕ) ≤ ↑x6 ∧ (↑x6 + (21 : ℕ) - ↑x5) % (21 : ℕ) ∈ [(0 : ℕ), (5 : ℕ), (7 : ℕ), (17 : ℕ), (20 : ℕ)]) ∧ x4 x5 = Bool.true ∧ x4 x6 = Bool.true) → (∃ (x5 : ℕ) (x6 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x5]? = Option.some x6 ∧ x6.op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (x1.wires (List.ofFn fun (x7 : Fin (42 : ℕ)) => Decidable.decide (↑x7 = (0 : ℕ)))).getD ((42 : ℕ) + x5) Bool.false = Bool.true ∧ ∀ x7 < x5, ∀ (x9 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x7]? = Option.some x9 → x9.op = PEqualNP.CircuitLowerBounds.GateOp.and → (x1.wires (List.ofFn fun (x12 : Fin (42 : ℕ)) => Decidable.decide (↑x12 = (0 : ℕ)))).getD ((42 : ℕ) + x7) Bool.false = Bool.false) → False)
    (outGate : ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), (42 : ℕ) ≤ x1.output → PEqualNP.MetaComplexity.Monotone2 x1 → x1.size ≤ (124 : ℕ) → (∀ (x4 : Fin (42 : ℕ) → Bool), x1.eval (List.ofFn x4) = Bool.true ↔ ∃ (x5 : Fin (42 : ℕ)) (x6 : Fin (42 : ℕ)), (↑x5 < (21 : ℕ) ∧ (21 : ℕ) ≤ ↑x6 ∧ (↑x6 + (21 : ℕ) - ↑x5) % (21 : ℕ) ∈ [(0 : ℕ), (5 : ℕ), (7 : ℕ), (17 : ℕ), (20 : ℕ)]) ∧ x4 x5 = Bool.true ∧ x4 x6 = Bool.true) → (∃ (x5 : ℕ) (x6 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x5]? = Option.some x6 ∧ x6.op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (x1.wires (List.ofFn fun (x7 : Fin (42 : ℕ)) => Decidable.decide (↑x7 = (0 : ℕ)))).getD ((42 : ℕ) + x5) Bool.false = Bool.true ∧ ∀ x7 < x5, ∀ (x9 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x7]? = Option.some x9 → x9.op = PEqualNP.CircuitLowerBounds.GateOp.and → (x1.wires (List.ofFn fun (x12 : Fin (42 : ℕ)) => Decidable.decide (↑x12 = (0 : ℕ)))).getD ((42 : ℕ) + x7) Bool.false = Bool.false) → False) :
    ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x1 → x1.size ≤ (124 : ℕ) → (∀ (x4 : Fin (42 : ℕ) → Bool), x1.eval (List.ofFn x4) = Bool.true ↔ ∃ (x5 : Fin (42 : ℕ)) (x6 : Fin (42 : ℕ)), (↑x5 < (21 : ℕ) ∧ (21 : ℕ) ≤ ↑x6 ∧ (↑x6 + (21 : ℕ) - ↑x5) % (21 : ℕ) ∈ [(0 : ℕ), (5 : ℕ), (7 : ℕ), (17 : ℕ), (20 : ℕ)]) ∧ x4 x5 = Bool.true ∧ x4 x6 = Bool.true) → (∃ (x5 : ℕ) (x6 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x5]? = Option.some x6 ∧ x6.op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ (x1.wires (List.ofFn fun (x7 : Fin (42 : ℕ)) => Decidable.decide (↑x7 = (0 : ℕ)))).getD ((42 : ℕ) + x5) Bool.false = Bool.true ∧ ∀ x7 < x5, ∀ (x9 : PEqualNP.CircuitLowerBounds.Gate), x1.gates[x7]? = Option.some x9 → x9.op = PEqualNP.CircuitLowerBounds.GateOp.and → (x1.wires (List.ofFn fun (x12 : Fin (42 : ℕ)) => Decidable.decide (↑x12 = (0 : ℕ)))).getD ((42 : ℕ) + x7) Bool.false = Bool.false) → False := by
