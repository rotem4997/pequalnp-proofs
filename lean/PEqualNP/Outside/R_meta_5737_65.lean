set_option maxHeartbeats 2000000 in
theorem PEqualNP.Outside.R_meta_5737_65
    (caseA : ∀ (x1 : ℕ) (x2 : SimpleGraph (Fin x1)) [x3 : DecidableRel x2.Adj], x1 < (50 : ℕ) → (∀ (x4 x5 x6 : Fin x1), x2.Adj x4 x5 → x2.Adj x5 x6 → ¬x2.Adj x6 x4) → (∀ (x5 x6 x7 x8 : Fin x1), x2.Adj x5 x6 → x2.Adj x6 x7 → x2.Adj x7 x8 → x2.Adj x8 x5 → x5 = x7 ∨ x6 = x8) → ¬(x2.IsAcyclic ∨ (5 : ℕ) ≤ x1 ∧ ∃ (x6 : Fin x1 ≃ Fin x1), ∀ (x7 x8 : Fin x1), x2.Adj x7 x8 ↔ (↑(x6 x7) + (1 : ℕ)) % x1 = ↑(x6 x8) ∨ (↑(x6 x8) + (1 : ℕ)) % x1 = ↑(x6 x7)) → ∀ (x7 : Finset (Fin x1)), PEqualNP.MetaComplexity.NestedCover.IsMinCover x2 x7 → ∀ (x9 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x9 → (∀ (x11 : Fin x1 → Bool), x9.eval (List.ofFn x11) = Decidable.decide (∃ (x12 : Fin x1) (x13 : Fin x1), x2.Adj x12 x13 ∧ x11 x12 = Bool.true ∧ x11 x13 = Bool.true)) → x2.edgeFinset.card + x7.card - (1 : ℕ) ≤ x9.size)
    (caseB : ∀ (x1 : ℕ) (x2 : SimpleGraph (Fin x1)) [x3 : DecidableRel x2.Adj], (50 : ℕ) ≤ x1 → (∀ (x4 x5 x6 : Fin x1), x2.Adj x4 x5 → x2.Adj x5 x6 → ¬x2.Adj x6 x4) → (∀ (x5 x6 x7 x8 : Fin x1), x2.Adj x5 x6 → x2.Adj x6 x7 → x2.Adj x7 x8 → x2.Adj x8 x5 → x5 = x7 ∨ x6 = x8) → ¬(x2.IsAcyclic ∨ (5 : ℕ) ≤ x1 ∧ ∃ (x6 : Fin x1 ≃ Fin x1), ∀ (x7 x8 : Fin x1), x2.Adj x7 x8 ↔ (↑(x6 x7) + (1 : ℕ)) % x1 = ↑(x6 x8) ∨ (↑(x6 x8) + (1 : ℕ)) % x1 = ↑(x6 x7)) → ∀ (x7 : Finset (Fin x1)), PEqualNP.MetaComplexity.NestedCover.IsMinCover x2 x7 → ∀ (x9 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x9 → (∀ (x11 : Fin x1 → Bool), x9.eval (List.ofFn x11) = Decidable.decide (∃ (x12 : Fin x1) (x13 : Fin x1), x2.Adj x12 x13 ∧ x11 x12 = Bool.true ∧ x11 x13 = Bool.true)) → x2.edgeFinset.card + x7.card - (1 : ℕ) ≤ x9.size) :
    ∀ (x1 : ℕ) (x2 : SimpleGraph (Fin x1)) [x3 : DecidableRel x2.Adj], (∀ (x4 x5 x6 : Fin x1), x2.Adj x4 x5 → x2.Adj x5 x6 → ¬x2.Adj x6 x4) → (∀ (x5 x6 x7 x8 : Fin x1), x2.Adj x5 x6 → x2.Adj x6 x7 → x2.Adj x7 x8 → x2.Adj x8 x5 → x5 = x7 ∨ x6 = x8) → ¬(x2.IsAcyclic ∨ (5 : ℕ) ≤ x1 ∧ ∃ (x6 : Fin x1 ≃ Fin x1), ∀ (x7 x8 : Fin x1), x2.Adj x7 x8 ↔ (↑(x6 x7) + (1 : ℕ)) % x1 = ↑(x6 x8) ∨ (↑(x6 x8) + (1 : ℕ)) % x1 = ↑(x6 x7)) → ∀ (x7 : Finset (Fin x1)), PEqualNP.MetaComplexity.NestedCover.IsMinCover x2 x7 → ∀ (x9 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.Monotone2 x9 → (∀ (x11 : Fin x1 → Bool), x9.eval (List.ofFn x11) = Decidable.decide (∃ (x12 : Fin x1) (x13 : Fin x1), x2.Adj x12 x13 ∧ x11 x12 = Bool.true ∧ x11 x13 = Bool.true)) → x2.edgeFinset.card + x7.card - (1 : ℕ) ≤ x9.size := by
