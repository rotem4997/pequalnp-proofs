theorem main (C : Circuit) (L : List (ℕ × ℕ)) (hC : PEqualNP.TopForm.IsAO2 11 C) (hne : L ≠ [])
    (hL : ∀ q ∈ L, q.1 < 11 + C.size ∧ q.2 < 11 + C.size) :
    ∃ D : Circuit, Monotone2 D ∧ D.size + 1 = C.size + 2 * L.length ∧
      (∀ x : Fin 11 → Bool, D.eval (List.ofFn x) = L.any fun q =>
        PEqualNP.BlindGate.wireValue C 11 x q.1 && PEqualNP.BlindGate.wireValue C 11 x q.2) ∧
      ∀ x y : Fin 11 → Bool, (∀ i : Fin 11, x i = true → y i = true) →
        D.eval (List.ofFn x) = true → D.eval (List.ofFn y) = true := by
  obtain ⟨p, L', rfl⟩ := List.exists_cons_of_ne_nil hne
  obtain ⟨ext, hops, hlen, hval⟩ := ext_build 11 C L' p hL
  have hAO : PEqualNP.EdgeOwnership.AndOrOnly
      (⟨C.gates ++ ext, 11 + C.gates.length + ext.length - 1⟩ : Circuit) := by
    intro g hg
    rcases List.mem_append.mp hg with h | h
    · exact hC.1 g h
    · exact (hops g h).1
  refine ⟨⟨C.gates ++ ext, 11 + C.gates.length + ext.length - 1⟩, ?_, ?_, ?_, ?_⟩
  · intro g hg
    refine ⟨?_, ?_⟩
    · rcases hAO g hg with e | e <;> simp [e]
    · rcases List.mem_append.mp hg with h | h
      · rw [hC.2.2 g h]
      · rw [(hops g h).2]
  · show (C.gates ++ ext).length + 1 = C.gates.length + 2 * (p :: L').length
    simp only [List.length_append, List.length_cons]
    omega
  · intro x
    exact hval (List.ofFn x) (List.length_ofFn)
  · intro x y hxy h
    exact mono 11 _ hAO x y hxy _ h

