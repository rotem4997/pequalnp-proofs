import PEqualNP.Defs

-- A cut of the 7 + 7 circulant bipartite step along the two halves of its gate count.
-- The relation is the bipartite graph on Fin 7 + Fin 7 with offsets 0, 1 and 3. That
-- offset set is a perfect difference set mod 7, so two left vertices share exactly one
-- neighbour, the graph has no four-cycle, and every biclique is a star. It has 21 edges
-- and least vertex cover 7, and 21 + 7 - 1 = 27 is exactly the size bound here, so a
-- circuit admitted by the step sits at the cover optimum with no slack.
-- assemblyCost is the half the normal form controls: however many AND gates a circuit
-- of the model uses for this relation, the OR assembly below and above them costs 20
-- gates more. Each AND is a star, t stars covering 21 edges need at least 21 - t leaf
-- OR gates, and t results need t - 1 more to combine, giving 20 + t in all. It is tight
-- at t = 7, which is the 27-gate cover circuit, and tight again on that circuit with
-- spare AND gates added.
-- nestedAndIsExtra is the half it does not control: the probes pin an AND gate above an
-- operand that is already false at each of the two one-hot inputs and true at their
-- union, so a second AND over the same edge sits below it, and the remaining 18 edges
-- still need 6 stars of their own. That makes 8 AND gates, one more than the cover.
-- Together they force 20 + 8 = 28 gates against a bound of 27.
theorem PEqualNP.Outside.R_meta_7698_1
    (assemblyCost : ∀ (C : PEqualNP.CircuitLowerBounds.Circuit) (t : ℕ) (f : Fin t → ℕ), PEqualNP.TopForm.IsAO2 (14 : ℕ) C → (∀ (x6 : Fin (14 : ℕ) → Bool), C.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) → Function.Injective f → (∀ (i : Fin t), f i < C.size ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt C (f i)).op = PEqualNP.CircuitLowerBounds.GateOp.and) → (20 : ℕ) + t ≤ C.size)
    (nestedAndIsExtra : ∀ (C : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.TopForm.IsAO2 (14 : ℕ) C → (∀ x4 < C.size, PEqualNP.TopForm.opnd C x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd C x4 (1 : Fin (2 : ℕ))) → (PEqualNP.MetaComplexity.NestedCover.gateAt C (0 : ℕ)).op = PEqualNP.CircuitLowerBounds.GateOp.and → (∀ (x6 : Fin (14 : ℕ) → Bool), C.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) → (∃ x7 < C.size, (0 : ℕ) < x7 ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt C x7).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧ have x8 : List Bool := C.wires (List.ofFn fun (x8 : Fin (14 : ℕ)) => Decidable.decide (x8 = (0 : Fin (14 : ℕ)))); have x9 : List Bool := C.wires (List.ofFn fun (x9 : Fin (14 : ℕ)) => Decidable.decide (x9 = (7 : Fin (14 : ℕ)))); have x10 : List Bool := C.wires (List.ofFn fun (x10 : Fin (14 : ℕ)) => Decidable.decide (x10 = (0 : Fin (14 : ℕ)) ∨ x10 = (7 : Fin (14 : ℕ)))); have x11 : ℕ := PEqualNP.TopForm.opnd C x7 (0 : Fin (2 : ℕ)); have x12 : ℕ := PEqualNP.TopForm.opnd C x7 (1 : Fin (2 : ℕ)); x10.getD x11 Bool.false = Bool.true ∧ x10.getD x12 Bool.false = Bool.true ∧ (x8.getD x11 Bool.false = Bool.false ∧ x8.getD x12 Bool.false = Bool.false ∨ x9.getD x11 Bool.false = Bool.false ∧ x9.getD x12 Bool.false = Bool.false) ∧ (x8.getD x11 Bool.false = Bool.false ∧ x9.getD x11 Bool.false = Bool.false ∨ x8.getD x12 Bool.false = Bool.false ∧ x9.getD x12 Bool.false = Bool.false)) → ∃ (f : Fin (8 : ℕ) → ℕ), Function.Injective f ∧ ∀ (i : Fin (8 : ℕ)), f i < C.size ∧ (PEqualNP.MetaComplexity.NestedCover.gateAt C (f i)).op = PEqualNP.CircuitLowerBounds.GateOp.and) :
    ∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit),   x1.size ≤ (27 : ℕ) →     PEqualNP.TopForm.IsAO2 (14 : ℕ) x1 →       (∀ x4 < x1.size, PEqualNP.TopForm.opnd x1 x4 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x1 x4 (1 : Fin (2 : ℕ))) →         (PEqualNP.MetaComplexity.NestedCover.gateAt x1 (0 : ℕ)).op = PEqualNP.CircuitLowerBounds.GateOp.and →           (∀ (x6 : Fin (14 : ℕ) → Bool), x1.eval (List.ofFn x6) = Bool.true ↔ ∃ (x7 : Fin (7 : ℕ)) (x8 : Fin (7 : ℕ)), (x7 = x8 ∨ x7 = x8 + (1 : Fin (7 : ℕ)) ∨ x7 = x8 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x7) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x8) = Bool.true) →             (∃ x7 < x1.size,                 (0 : ℕ) < x7 ∧                   (PEqualNP.MetaComplexity.NestedCover.gateAt x1 x7).op = PEqualNP.CircuitLowerBounds.GateOp.and ∧                     have x8 : List Bool := x1.wires (List.ofFn fun (x8 : Fin (14 : ℕ)) => Decidable.decide (x8 = (0 : Fin (14 : ℕ))));                     have x9 : List Bool := x1.wires (List.ofFn fun (x9 : Fin (14 : ℕ)) => Decidable.decide (x9 = (7 : Fin (14 : ℕ))));                     have x10 : List Bool := x1.wires (List.ofFn fun (x10 : Fin (14 : ℕ)) => Decidable.decide (x10 = (0 : Fin (14 : ℕ)) ∨ x10 = (7 : Fin (14 : ℕ))));                     have x11 : ℕ := PEqualNP.TopForm.opnd x1 x7 (0 : Fin (2 : ℕ));                     have x12 : ℕ := PEqualNP.TopForm.opnd x1 x7 (1 : Fin (2 : ℕ));                     x10.getD x11 Bool.false = Bool.true ∧ x10.getD x12 Bool.false = Bool.true ∧ (x8.getD x11 Bool.false = Bool.false ∧ x8.getD x12 Bool.false = Bool.false ∨ x9.getD x11 Bool.false = Bool.false ∧ x9.getD x12 Bool.false = Bool.false) ∧ (x8.getD x11 Bool.false = Bool.false ∧ x9.getD x11 Bool.false = Bool.false ∨ x8.getD x12 Bool.false = Bool.false ∧ x9.getD x12 Bool.false = Bool.false)) →               False := by
  intro C hsize hao hopnd hgate0 hspec hdirty
  obtain ⟨f, hinj, hroster⟩ := nestedAndIsExtra C hao hopnd hgate0 hspec hdirty
  have hbound : (28 : ℕ) ≤ C.size := assemblyCost C (8 : ℕ) f hao hspec hinj hroster
  exact Nat.not_succ_le_self (27 : ℕ) (Nat.le_trans hbound hsize)
