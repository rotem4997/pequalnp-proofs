-- Credit: the case-split reduction shape of foudress (R_meta_1710_64, #23768) and willakone
-- (R_meta_17910_64). This is a split on the output wire of x2: one of the 14 inputs, or a later wire; each piece is the step with that one extra hypothesis.
theorem PEqualNP.Outside.R_meta_17227_1
    (caseA : have x1 : List Bool := List.map (fun (x1 : ℕ) => x1 == (0 : ℕ) || x1 == (7 : ℕ)) (List.range (14 : ℕ)); ∀ (x2 : PEqualNP.CircuitLowerBounds.Circuit), x2.output < (14 : ℕ) → x2.size ≤ (26 : ℕ) →     PEqualNP.TopForm.IsAO2 (15 : ℕ) x2 →       (∀ x5 < x2.size, PEqualNP.TopForm.opnd x2 x5 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x2 x5 (1 : Fin (2 : ℕ))) →         (∀ (x6 : Fin (14 : ℕ) → Bool),             have x7 : List Bool := List.ofFn x6;             x2.eval (x7 ++ [x7.getD (0 : ℕ) Bool.false && x7.getD (7 : ℕ) Bool.false]) = Bool.true ↔ ∃ (x8 : Fin (7 : ℕ)) (x9 : Fin (7 : ℕ)), (x8 = x9 ∨ x8 = x9 + (1 : Fin (7 : ℕ)) ∨ x8 = x9 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x8) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x9) = Bool.true) →           ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true ∨ ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide (x7 < (7 : ℕ) ∨ x7 = (14 : ℕ))) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true)
    (caseB : have x1 : List Bool := List.map (fun (x1 : ℕ) => x1 == (0 : ℕ) || x1 == (7 : ℕ)) (List.range (14 : ℕ)); ∀ (x2 : PEqualNP.CircuitLowerBounds.Circuit), (14 : ℕ) ≤ x2.output → x2.size ≤ (26 : ℕ) →     PEqualNP.TopForm.IsAO2 (15 : ℕ) x2 →       (∀ x5 < x2.size, PEqualNP.TopForm.opnd x2 x5 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x2 x5 (1 : Fin (2 : ℕ))) →         (∀ (x6 : Fin (14 : ℕ) → Bool),             have x7 : List Bool := List.ofFn x6;             x2.eval (x7 ++ [x7.getD (0 : ℕ) Bool.false && x7.getD (7 : ℕ) Bool.false]) = Bool.true ↔ ∃ (x8 : Fin (7 : ℕ)) (x9 : Fin (7 : ℕ)), (x8 = x9 ∨ x8 = x9 + (1 : Fin (7 : ℕ)) ∨ x8 = x9 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x8) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x9) = Bool.true) →           ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true ∨ ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide (x7 < (7 : ℕ) ∨ x7 = (14 : ℕ))) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true) :
    have x1 : List Bool := List.map (fun (x1 : ℕ) => x1 == (0 : ℕ) || x1 == (7 : ℕ)) (List.range (14 : ℕ)); ∀ (x2 : PEqualNP.CircuitLowerBounds.Circuit),   x2.size ≤ (26 : ℕ) →     PEqualNP.TopForm.IsAO2 (15 : ℕ) x2 →       (∀ x5 < x2.size, PEqualNP.TopForm.opnd x2 x5 (0 : Fin (2 : ℕ)) ≠ PEqualNP.TopForm.opnd x2 x5 (1 : Fin (2 : ℕ))) →         (∀ (x6 : Fin (14 : ℕ) → Bool),             have x7 : List Bool := List.ofFn x6;             x2.eval (x7 ++ [x7.getD (0 : ℕ) Bool.false && x7.getD (7 : ℕ) Bool.false]) = Bool.true ↔ ∃ (x8 : Fin (7 : ℕ)) (x9 : Fin (7 : ℕ)), (x8 = x9 ∨ x8 = x9 + (1 : Fin (7 : ℕ)) ∨ x8 = x9 + (3 : Fin (7 : ℕ))) ∧ x6 (Fin.castAdd (7 : ℕ) x8) = Bool.true ∧ x6 (Fin.natAdd (7 : ℕ) x9) = Bool.true) →           ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide ((7 : ℕ) ≤ x7)) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true ∨ ((PEqualNP.ReadK.linearParts x2 (fun (x7 : ℕ) => Decidable.decide (x7 < (7 : ℕ) ∨ x7 = (14 : ℕ))) (x1 ++ [Bool.true])).getD x2.output (Bool.false, Bool.false)).2 = Bool.true := by
  intro x1 x2
  rcases Nat.lt_or_ge x2.output (14 : ℕ) with h | h
