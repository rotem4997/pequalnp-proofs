  data : ∃ (roots bank : List (Wire S)), Reach true roots p bank ∧
    (∀ w ∈ ws, Available true bank (restrictRows row w)) ∧
    ¬ Constant (restrictRows row goal) ∧
    ∀ j b, Reach true roots j b → Available true b (restrictRows row goal) → L ≤ j

theorem prepared_sub {R S : Type} {row : S → R} {g L p xs ys}
    (h : Prepared row g L p xs) (sub : ∀ v ∈ ys, v ∈ xs) : Prepared row g L p ys := by
  obtain ⟨r,b,hr,hs,hg,hl⟩ := h.data
  exact ⟨r,b,hr,fun v hv => hs v (sub v hv),hg,hl⟩

theorem tail_mem {α} (a b : α) (rest) (ka kb : Bool) {v}
    (h : v ∈ kept ka a (kept kb b rest)) : v ∈ a::b::rest := by
  rcases mem_kept h with rfl|h
  · simp
  rcases mem_kept h with rfl|h <;> simp [*]

theorem advance {R S : Type} {row : S → R} {g L p} {a b : Wire R} {rest d} (hd : allowed true d) (ka kb)
    (h : Prepared row g L p (a::b::rest)) :
    Prepared row g L (p+1) (comb d a b :: kept ka a (kept kb b rest)) := by
  obtain ⟨roots,bank,hr,hs,hg,hl⟩ := h.data
  obtain ⟨op,x,y,eq,hx,hy,_,_⟩ := comb_prime hd (hs a (by simp)) (hs b (by simp))
  refine ⟨roots,_,Reach.two op hr hx hy,?_,hg,hl⟩
  intro v hv
  rcases List.mem_cons.mp hv with rfl|hv
  · rw [restrict_comb,eq]
    exact Or.inl (by simp)
  · exact available_cons _ (hs v (tail_mem a b rest ka kb hv))

theorem finish {R S : Type} {row : S → R} {g L p s} {a b : Wire R} {rest d ka kb}
    (h : Prepared row g L p (a::b::rest)) (hc : Constant (restrictRows row (comb d a b)))
    (run : Run true g s (comb d a b :: kept ka a (kept kb b rest))) : L+2 ≤ p+(s+1) := by
  classical
  obtain ⟨roots,bank,hr,hs,hg,hl⟩ := h.data
  have sup : supply true bank ((comb d a b :: kept ka a (kept kb b rest)).map (restrictRows row)) := by
    intro w hw
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp hw
    rcases List.mem_cons.mp hv with rfl|hv
    · exact Or.inr (Or.inl hc)
    · exact hs _ (tail_mem a b rest ka kb hv)
  have low := projected_bound row run hg hr sup hl
  simp only [List.map_cons,mass_cons] at low
  rw [show cost (restrictRows row (comb d a b)) = 1 from by simp [cost,hc]] at low
  omega

theorem forced {R S : Type} {a b special : Wire R} {rows : Bool → S → R}
    (hw : ∀ v y, special (rows v y) = v) {d} (hd : allowed true d) (hit : a = special ∨ b = special) :
    ∃ v, Constant (restrictRows (rows v) (comb d a b)) := by
  rcases hit with rfl|rfl <;> rcases allowed_four hd with rfl|rfl|⟨_,rfl⟩|⟨_,rfl⟩
  · exact ⟨false,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨true,true, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨false,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨true,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨false,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨true,true, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨true,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩
  · exact ⟨false,false, funext (fun y => by simp [restrictRows,comb,combine,inv,hw])⟩

theorem both {R S : Type} {special goal : Wire R} (rows : Bool → S → R)
    (hw : ∀ v y, special (rows v y) = v) (different : special ≠ goal)
    {s ws} (run : Run true goal s ws) {p L}
    (live : special ∈ ws) (pre : ∀ v, Prepared (rows v) goal L p ws) : L+2 ≤ p+s := by
  classical
  induction run using Run.ind generalizing p with
  | stop => exact False.elim (different (by simpa using live))
  | perm eq _ ih =>
    exact ih (eq.mem_iff.mpr live) (fun v => prepared_sub (pre v) (fun _ h => eq.mem_iff.mp h))
  | @two s a b rest d hd ka kb hr ih =>
    by_cases hit : a=special ∨ b=special
    · obtain ⟨v,hv⟩ := forced hw hd hit
      exact finish (pre v) hv hr
    · have mem : special ∈ rest := by
        rcases List.mem_cons.mp live with h|hr
        · exact False.elim (hit (Or.inl h.symm))
        rcases List.mem_cons.mp hr with h|h
        · exact False.elim (hit (Or.inr h.symm))
        exact h
      have mem' : special ∈ comb d a b :: kept ka a (kept kb b rest) := by
        cases ka <;> cases kb <;> simp [kept,mem]
      have low := ih mem' (fun v => advance hd ka kb (pre v))
      omega
end PEqualNP.Outside.L_meta_14178_aux.DoubleDrop

