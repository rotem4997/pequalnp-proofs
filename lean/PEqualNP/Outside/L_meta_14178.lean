theorem reachLeft {R : Type} {roots : List (Wire R)} {p bank}
    (h : Reach true roots p bank) : Left.ForestCore.Reach true roots p bank := by
  induction h using Reach.ind with
  | start => exact Left.ForestCore.Reach.start
  | two op _ ha hb ih => exact Left.ForestCore.Reach.two op ih ha hb

theorem falseFloor : Lower true Left.roots Left.codedGraph 10 := by
  intro p bank hp h
  exact Left.wholeBound p bank (reachLeft hp) h

def trueWord := inputs.getD 6 zero ||| Right.target Right.gbAtlas

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem trueFloor : Lower true (vars 127) trueWord 10 := by
  have h := lift_ok (u:=true) (ms:=fixRows 64 0) (raw:=vars 127) (T:=trueWord)
    (xs:=[(inputs.getD 6 zero,0,64)]) (by decide +kernel) (proper_of _ (by decide +kernel))
    (proper_of _ (by decide +kernel)) Right.sixFloor
  exact h

def surface (v : Bool) : Row → Row :=
  if v then fun r => Fin.ofNat 512 (128+(if r.val.testBit 6 then 4 else 0)+(if r.val.testBit 2 then 64 else 0)+(if r.val.testBit 4 then 8 else 0)+(if r.val.testBit 3 then 16 else 0)+(if r.val.testBit 1 then 1 else 0)+(if r.val.testBit 5 then 32 else 0)+(if r.val.testBit 0 then 2 else 0))
  else fun r => Fin.ofNat 512 (r.val &&& 127)
def pool (v : Bool) : List Sig := if v then vars 127 else Left.roots
def localGoal (v : Bool) : Sig := if v then trueWord else Left.codedGraph
def fullWord : Sig := 0xfffffffffefefefefffffff8fefcfaf8ffffffffeeeeeeeeffffffe8eeeceae8fffffffffefefefefffffff8fefcfaf8ffffffffeeeeeeeeffffffe8eeeceae8
def leaf : Sig := inputs.getD 7 zero
def raw : List Sig := [inputs.getD 2 zero,inputs.getD 6 zero,inputs.getD 3 zero,inputs.getD 4 zero,inputs.getD 7 zero,inputs.getD 0 zero,inputs.getD 5 zero,inputs.getD 1 zero]
def target (x : Fin 8 → Bool) := decide (∃ i < ([0, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7] : List ℕ).length / 2, (List.ofFn x).getD (([0, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7] : List ℕ).getD (2 * i) 0) false = true ∧ (List.ofFn x).getD (([0, 4, 0, 5, 1, 5, 2, 5, 1, 6, 2, 6, 3, 6, 0, 7, 1, 7, 3, 7, 5, 7] : List ℕ).getD (2 * i + 1) 0) false = true)

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem surface_checks (v : Bool) :
    rename (surface v) fullWord = localGoal v ∧
    raw.all (fun w => freeWord (pool v) (rename (surface v) w)) = true ∧
    proper (localGoal v) ∧ (∀ r : Row, bit (surface v r) leaf = v) := by
  unfold proper; cases v <;> decide +kernel

theorem localLower (v : Bool) : Lower true (pool v) (localGoal v) 10 := by
  cases v with
  | false => exact falseFloor
  | true => exact trueFloor

theorem prepare {S : Finset Sig} (sub : ∀ a ∈ S, a ∈ raw) (v : Bool) :
    DoubleDrop.Prepared (surface v) (observe fullWord) 10 0 (S.toList.map observe) := by
  obtain ⟨eq,all,properGoal,_⟩ := surface_checks v
  have heq : restrictRows (surface v) (observe fullWord) = observe (localGoal v) :=
    (observe_rename _ _).symm.trans (congrArg observe eq)
  refine ⟨(pool v).map observe,_,Reach.start,?_,?_,?_⟩
  · intro x hx
    obtain ⟨w,hw,rfl⟩ := List.mem_map.mp hx
    rw [←observe_rename]
    exact freeWord_ok ((List.all_eq_true.mp all) w (sub w (Finset.mem_toList.mp hw)))
  · rw [heq]
    exact observe_proper properGoal
  · rw [heq]
    exact localLower v

def sample8 (r : Row) (i : Fin 8) := bit r (raw.getD i.val zero)
set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem table8 : ∀ r, target (sample8 r) = bit r fullWord := by decide +kernel
set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem raw8 : List.ofFn (fun i : Fin 8 => raw.getD i.val zero) = raw := by decide +kernel

theorem eval8 (gs : List Gate) (o : Nat) (legal : FanInTwo (Circuit.mk gs o))
    (h : ∀ x, Circuit.eval ⟨gs,o⟩ (List.ofFn x) = target x) : (execute gs raw).getD o zero=fullWord := by
  apply bit_ext
  intro r
  have e : List.ofFn (sample8 r) = raw.map (bit r) := by rw [←raw8,List.map_ofFn]; rfl
  rw [←bRead,exeBits gs r raw (fun g hg => (legal g hg).1),←e]
  exact (h (sample8 r)).trans (table8 r)

set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem twelve (gs : List Gate) (o : Nat) (legal : FanInTwo (Circuit.mk gs o))
    (h : ∀ x, Circuit.eval ⟨gs,o⟩ (List.ofFn x) = target x) : 12 ≤ gs.countP (fun g => !isNot g) := by
  have pg : proper fullWord := proper_of _ (by decide +kernel)
  have out := getRep (u:=true) (execute gs raw) o
  rw [eval8 gs o legal h] at out
  unfold Right.Model.Repr at out
  rw [nrm_id (by decide +kernel : bit 0 fullWord=false)] at out
  obtain ⟨k,S,hk,run,sub⟩ := extractPlan gs raw legal (by simp) pg (out.resolve_right (fun h => h pg))
  rw [nrm_map (by decide +kernel : raw.all plainWord=true)] at sub
  have mem : leaf ∈ S := raw_required run raw leaf sub 4 132 (by decide +kernel) (by
    have checks : raw.all (fun w => w == leaf || bit 4 w == bit 132 w) = true := by decide +kernel
    intro w hw hn
    simpa [hn] using List.all_eq_true.mp checks w hw)
  have diff : observe leaf ≠ observe fullWord := by
    intro eq
    have h := congrFun eq (40 : Row)
    exact (by decide +kernel : bit 40 leaf ≠ bit 40 fullWord) h
  have reach := list_run run S.toList (Finset.nodup_toList _) (Finset.toList_toFinset _)
  have bound := DoubleDrop.both surface (fun v y => (surface_checks v).2.2.2 y) diff reach
    (List.mem_map_of_mem (Finset.mem_toList.mpr mem)) (prepare sub)
  omega

def witness : List Gate := [⟨.or,[4,7]⟩,⟨.or,[8,5]⟩,⟨.and,[9,0]⟩,⟨.or,[1,7]⟩,⟨.or,[11,2]⟩,⟨.and,[5,12]⟩,⟨.or,[10,13]⟩,⟨.or,[6,7]⟩,⟨.or,[1,3]⟩,⟨.and,[15,16]⟩,⟨.or,[14,17]⟩,⟨.and,[6,2]⟩,⟨.or,[18,19]⟩]
theorem shape : ∀ g ∈ witness, (g.op=.and ∨ g.op=.or) ∧ g.inputs.length ≤ 2 := by simp [witness]
set_option maxRecDepth 32768 in
set_option maxHeartbeats 0 in
theorem computes : ∀ x : Fin 8 → Bool, Circuit.eval ⟨witness,20⟩ (List.ofFn x) = target x := by decide +kernel

