theorem orbitIndex : ∀ o : O, (ovalType o).all (fun i => orbitList[i.val]! == o) = true := by decide +kernel

theorem orbitTile : ∀ i : Fin 8, ∀ s : V, tile (orbitList[i.val]!) s = oval (label i s) := by decide +kernel

theorem specialTile {o : O} {i : Fin 8} (h : ovalType o = some i) (s : V) :
    tile o s = oval (label i s) := by
  have p := orbitIndex o
  simp only [h,Option.all_some,beq_iff_eq] at p
  rw [←p,orbitTile]

theorem shiftSide (m : Nat) (s : V) : (side m 0).image (fun p => p+s) = side m s := by
  ext p
  constructor
  · intro h
    obtain ⟨i,hi,rfl⟩ := mem_image.mp h
    simpa only [memSide,add_sub_cancel_right,sub_zero] using hi
  · intro h
    exact mem_image.mpr ⟨p-s,by simpa only [memSide,sub_zero] using h,sub_add_cancel _ _⟩

theorem tallyShift (o : O) (s : V) (w : V → V → Nat) :
    tally (tile o s) w = tally (tile o 0) (fun p q => w (p+s) (q+s)) := by
  unfold tally tile
  simp only
  rw [←shiftSide (rm o) s,←shiftSide (cm o) s]
  simp only [sum_image (fun _ _ _ _ e => add_right_cancel e)]

def wide := 524288^152
def bundle (p q : V) := encode wide 21 (fun j => word (p+Fin.ofNat 21 j) (q+Fin.ofNat 21 j))
def filled := encode wide 21 (fun _ => fillWord)
def flags := encode wide 21 (fun _ => flagWord)
def allPass (o : O) := ((tally (tile o 0) bundle + filled) &&& flags) == 0

theorem filledSmall (b : Box) : tally b word + fillWord < wide := by
  let f := fun i => tally b (components i)
  let g := fun i => component 524288 i fillWord
  have af : encode 524288 152 f = tally b word := packTally _
  have ag : encode 524288 152 g = fillWord :=
    (encodeWord _ _ _).trans (Nat.mod_eq_of_lt wordFacts.2.2.1)
  rw [←af,←ag,←encodeAdd]
  apply encodeSmall
  intro i hi
  have t := (wordFacts.2.2.2 ⟨i,hi⟩).1
  rw [slotComp] at t
  change g i + lim ⟨i,hi⟩ = 262143 at t
  have bnd : f i ≤ 225351 := blockBound b hi
  omega

theorem wideAnd (i x y : Nat) : component wide i (x &&& y) = component wide i x &&& component wide i y := by
  have h : wide = 2^(19*152) := (pow_mul 2 19 152).symm
  simp only [component,h,←pow_mul,←Nat.shiftRight_eq_div_pow,Nat.shiftRight_and_distrib,Nat.and_mod_two_pow]

theorem shiftedPass (o : O) (s : V) (good : allPass o = true) :
    passes (tally (tile o s) word) = true := by
  let f := fun j => tally (tile o (Fin.ofNat 21 j)) word
  have packed : encode wide 21 f = tally (tile o 0) bundle := by
    simp only [f,tallyShift o _ word,encodeTally]
    rfl
  have rd := readDigit wide 21 (fun j => f j + fillWord)
    (fun j _ => filledSmall (tile o _)) s.isLt
  rw [encodeAdd,packed] at rd
  change component wide s.val (tally (tile o 0) bundle + filled) = f s.val + fillWord at rd
  have rf : component wide s.val flags = flagWord := readDigit wide 21 (fun _ => flagWord) (by decide) s.isLt
  have hx := congrArg (component wide s.val) (beq_iff_eq.mp good)
  rw [wideAnd,rd,rf] at hx
  have z : component wide s.val 0 = 0 := by simp [component]
  rw [z] at hx
  exact beq_iff_eq.mpr (by simpa only [f,Fin.ofNat_val_eq_self] using hx)

