  ((x ||| (x <<< 60648)) >>> (2888*p.val)) % (1 <<< 60648)
theorem quickCorrect : ∀ p q : V, quick p q = bundle p q := by decide +kernel

def ordinaryTest (i : Nat) :=
  let o : O := Fin.ofNat 1205 i
  (ovalType o).isSome || (((tally (tile o 0) quick+filled) &&& flags)==0)

