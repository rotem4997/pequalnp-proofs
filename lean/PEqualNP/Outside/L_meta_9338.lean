-- Closing the column sets after inserting a row enumerates the maximal boxes.
abbrev Box := Finset V × Finset V
def scan (f : Nat → Bool) (lo : Nat) : Nat → Bool
  | 0 => true
  | n+1 => f (lo+n) && scan f lo n

abbrev ValidOn (f : Nat → Bool) (lo hi : Nat) : Prop := ∀ i : Nat, lo ≤ i → i < hi → f i = true

theorem scanned (f : Nat → Bool) (lo n : Nat) (h : scan f lo n=true) : ValidOn f lo (lo+n) := by
  induction n with
  | zero => intro i a b; omega
  | succ n ih =>
    obtain ⟨last,rest⟩ := Bool.and_eq_true_iff.mp h
    intro i lower upper
    by_cases e : i=lo+n
    · exact e ▸ last
    · exact ih rest i lower (by omega)

theorem combine {f : Nat → Bool} {a b c : Nat} (u : ValidOn f a b) (v : ValidOn f b c) :
    ValidOn f a c := fun i hi hj => if h : i<b then u i hi h else v i (by omega) hj

def bit (p q : V) := (incidence.getD p.val 0).testBit q.val
def legal (b : Box) := ∀ p ∈ b.1, ∀ q ∈ b.2, bit p q = false
def fits (b c : Box) := b.1 ⊆ c.1 ∧ b.2 ⊆ c.2
def hit (b : Box) (p q : V) := p ∈ b.1 ∧ q ∈ b.2
def side (m : Nat) (s : V) := univ.filter fun p : V => m.testBit (p-s).val
def rm (o : O) := (rowMasks[o.val / 32]!)[o.val % 32]!
def cm (o : O) := (colMasks[o.val / 32]!)[o.val % 32]!
def tile (o : O) (s : V) : Box := (side (rm o) s, side (cm o) s)
def oval (h : H) : Box := (side (ovals[h.val]!).1 0,side (ovals[h.val]!).2 0)
def roll (m : Nat) (s : V) := ((2^21*m+m) >>> (21-s.val)) % 2^21
def nextCode (o : O) (p : V) := ((extendCodes[o.val / 32]!)[o.val % 32]!)[p.val]!
def orb (code : Nat) : O := Fin.ofNat 1205 (code/32)
def turn (code : Nat) : V := Fin.ofNat 21 (code % 32)

theorem memSide (m : Nat) (s p : V) : p ∈ side m s ↔ m.testBit (p-s).val = true := by
  simp [side]

theorem rollBit (m : Nat) (hm : m<2^21) (s p : V) :
    (roll m s).testBit p.val = m.testBit (p-s).val := by
  have eq : ∀ p s : V, (p-s).val = if 21-s.val+p.val < 21 then 21-s.val+p.val else 21-s.val+p.val-21 := by decide
  simp only [roll,Nat.testBit_mod_two_pow,Nat.testBit_shiftRight,Nat.testBit_two_pow_mul_add m hm,
    show decide (p.val<21)=true from decide_eq_true p.isLt,Bool.true_and]
  rw [eq]; split <;> rfl

theorem bitSub (x y : Nat) (h : x &&& y = x) {i : Nat} (hi : x.testBit i = true) :
    y.testBit i = true := by
  have e := congrArg (fun z : Nat => z.testBit i) h
  simpa [Nat.testBit_and,hi] using e

theorem shiftBit : ∀ p q s : V, bit (p-s) (q-s) = bit p q := by decide +kernel

theorem zerosBit : ∀ p q : V, (2097151 - incidence.getD p.val 0).testBit q.val = !(bit p q) := by decide

abbrev extCheck (o : O) (p : V) : Prop :=
  let c := nextCode o p
  let a := roll (rm (orb c)) (turn c)
  let b := roll (cm (orb c)) (turn c)
  let v := cm o &&& (2097151-incidence.getD p.val 0)
  rm o &&& a = rm o ∧ a.testBit p.val = true ∧ v &&& b = v

def extTest (i : Nat) := scan (fun j => decide (extCheck (Fin.ofNat 1205 i) (Fin.ofNat 21 j))) 0 21

