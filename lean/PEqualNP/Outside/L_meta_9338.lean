theorem maskSize : ∀ o : O, rm o < 2^21 ∧ cm o < 2^21 := by decide +kernel

theorem addRow (o : O) (s p : V) :
    ∃ o' s', (tile o s).1 ⊆ (tile o' s').1 ∧ p ∈ (tile o' s').1 ∧
      ∀ q ∈ (tile o s).2, bit p q = false → q ∈ (tile o' s').2 := by
  let c := nextCode o (p-s)
  let u := orb c
  let t := turn c
  obtain ⟨ra,atp,cb⟩ := extTable o (p-s)
  change rm o &&& roll (rm u) t = rm o at ra
  change (roll (rm u) t).testBit (p-s).val = true at atp
  change (cm o &&& (2097151-incidence.getD (p-s).val 0)) &&& roll (cm u) t = _ at cb
  refine ⟨u,s+t,?_,?_,?_⟩
  · intro i hi
    have h := bitSub _ _ ra ((memSide _ _ _).mp hi)
    rw [rollBit _ (maskSize u).1,sub_sub] at h
    exact (memSide _ _ _).mpr h
  · rw [rollBit _ (maskSize u).1,sub_sub] at atp
    exact (memSide _ _ _).mpr atp
  · intro q hq zero
    have hz : (2097151-incidence.getD (p-s).val 0).testBit (q-s).val = true := by
      rw [zerosBit,shiftBit,zero]; rfl
    have hb := bitSub _ _ cb (i := (q-s).val) (by simp only [Nat.testBit_and,(memSide _ _ _).mp hq,hz]; rfl)
    rw [rollBit _ (maskSize u).2,sub_sub] at hb
    exact (memSide _ _ _).mpr hb

theorem containingTile (A B : Finset V) (ok : legal (A,B)) : ∃ o s, fits (A,B) (tile o s) := by
  induction A using Finset.induction_on with
  | empty =>
    refine ⟨initial,0,empty_subset _,?_⟩
    have e : (tile initial 0).2 = univ := by decide
    simpa [e] using B.subset_univ
  | @insert p A _ ih =>
    obtain ⟨o,s,ha,hb⟩ := ih (fun i hi => ok i (mem_insert_of_mem hi))
    obtain ⟨u,t,sub,hp,cols⟩ := addRow o s p
    exact ⟨u,t,insert_subset hp (ha.trans sub),fun q hq =>
      cols q (hb hq) (ok p (mem_insert_self _ _) q hq)⟩

-- Each digit holds a cell weight for one case. The bounds below exclude carries.
def tally (b : Box) (w : V → V → Nat) := ∑ p ∈ b.1, ∑ q ∈ b.2, w p q
def word (p q : V) : Nat := (cellWords[p.val]!)[q.val]!
def weight (k : K) (p q : V) := slot k (word p q)
def lim (k : K) : Nat := limits[k.val]!
def seed (k : K) : List H := seeds[k.val]!
def edges (k : K) : List Edge := branches[k.val]!

theorem tallyMono {b c : Box} (sub : fits b c) (w : V → V → Nat) : tally b w ≤ tally c w := by
  unfold tally
  exact (sum_le_sum (fun p _ => sum_le_sum_of_subset_of_nonneg sub.2 (by intros; omega))).trans
    (sum_le_sum_of_subset_of_nonneg sub.1 (by intros; omega))

theorem tallyBound (b : Box) (w : V → V → Nat) (bound : ∀ p q, w p q ≤ 511) : tally b w ≤ 225351 := by
  calc
    tally b w ≤ tally (univ,univ) w := tallyMono ⟨subset_univ _,subset_univ _⟩ _
    _ ≤ ∑ p : V, ∑ q : V, 511 := sum_le_sum fun p _ => sum_le_sum fun q _ => bound p q
    _ = _ := by decide

def encode (d : Nat) : Nat → (Nat → Nat) → Nat
  | 0, _ => 0
  | n+1, f => f 0 + d * encode d n (fun j => f (j+1))

def component (d i x : Nat) := x/d^i%d

theorem compNext (d i x : Nat) : component d (i+1) x = component d i (x/d) := by
  simp [component,pow_succ,Nat.div_div_eq_div_mul,Nat.mul_comm]

theorem encodeWord (d n x : Nat) : encode d n (fun i => component d i x) = x % d^n := by
  induction n generalizing x with
  | zero => simp [encode,Nat.mod_one]
  | succ n ih =>
    simp only [encode,compNext,ih]
    rw [pow_succ']
    simpa [component] using (Nat.mod_mul (a := d) (b := d^n) (x := x)).symm

theorem readDigit (d n : Nat) (f : Nat → Nat) (small : ∀ i<n, f i<d)
    {j : Nat} (hj : j<n) : component d j (encode d n f) = f j := by
  induction n generalizing j f with
  | zero => omega
  | succ n ih =>
    have sm := small 0 (by omega)
    cases j with
    | zero => simp [encode,component,Nat.mod_eq_of_lt sm]
    | succ j =>
      rw [compNext,encode,Nat.add_mul_div_left _ _ (by omega),Nat.div_eq_of_lt sm,Nat.zero_add]
      exact ih _ (fun i hi => small _ (by omega)) (by omega)

theorem encodeSmall (d n : Nat) (f : Nat → Nat) (small : ∀ i<n, f i<d) : encode d n f<d^n := by
  induction n generalizing f with
  | zero => simp [encode]
  | succ n ih =>
    have ht := ih (fun j => f (j+1)) (fun i hi => small _ (by omega))
    have h0 := small 0 (by omega)
    rw [encode,pow_succ']
    calc
      _ < d + d * encode d n (fun j => f (j+1)) := by omega
      _ = d * (encode d n (fun j => f (j+1))+1) := by rw [Nat.mul_add,Nat.mul_one,Nat.add_comm]
      _ ≤ _ := Nat.mul_le_mul_left _ ht

theorem encodeAdd (d n : Nat) (f g : Nat → Nat) :
    encode d n (fun i => f i + g i) = encode d n f + encode d n g := by
  induction n generalizing f g with
  | zero => rfl
  | succ n ih =>
    simp only [encode]
    rw [ih (fun i => f (i+1)) (fun i => g (i+1)),Nat.mul_add]
    omega

theorem encodeTally (d n : Nat) (b : Box) (f : Nat → V → V → Nat) :
    encode d n (fun i => tally b (f i)) = tally b (fun p q => encode d n (fun i => f i p q)) := by
  induction n generalizing f with
  | zero => simp [encode,tally]
  | succ n ih =>
    simp only [encode]
    rw [ih (fun i => f (i+1))]
    simp only [tally,sum_add_distrib,mul_sum]

theorem slotComp (k : K) (x : Nat) : slot k x = component 524288 k.val x := by
  simp only [slot,component,Nat.shiftRight_eq_div_pow,pow_mul]
  rfl

theorem slotAnd (k : K) (x y : Nat) : slot k (x &&& y) = slot k x &&& slot k y := by
  change ((x &&& y) >>> (19*k.val)) % 2^19 = _
  rw [Nat.shiftRight_and_distrib,Nat.and_mod_two_pow]
  rfl

def thinWord := encode 524288 152 (fun _ => 511)

theorem wordFacts : (∀ p q : V, word p q < 524288^152) ∧
    (∀ k p q, weight k p q ≤ 511) ∧ fillWord < 524288^152 ∧
    (∀ k : K, slot k fillWord + lim k = 262143 ∧ flagWord.testBit (19*k.val+18) = true) := by
  have ht : ∀ p q : V, word p q < 524288^152 ∧ word p q &&& thinWord = word p q := by decide +kernel
  refine ⟨fun p q => (ht p q).1,?_,by decide,by decide +kernel⟩
  intro k p q
  have m := congrArg (slot k) (ht p q).2
  rw [slotAnd] at m
  have v : slot k thinWord = 511 := (slotComp _ _).trans (readDigit 524288 152 (fun _ => 511) (fun _ _ => by decide) k.isLt)
  rw [v] at m
  change slot k (word p q) ≤ 511
  rw [←m]
  exact Nat.and_le_right

def components (i : Nat) (p q : V) := component 524288 i (word p q)

theorem sameComponents (k : K) : components k.val = weight k := by
  funext p q
  exact (slotComp k (word p q)).symm

theorem blockBound (b : Box) {i : Nat} (hi : i<152) : tally b (components i) ≤ 225351 := by
  let k : K := ⟨i,hi⟩
  apply tallyBound
  intro p q
  change component 524288 k.val (word p q) ≤ 511
  rw [←slotComp]
  exact wordFacts.2.1 k p q

theorem packTally (b : Box) :
    encode 524288 152 (fun i => tally b (components i)) = tally b word := by
  rw [encodeTally]
  unfold components
  simp only [encodeWord,Nat.mod_eq_of_lt (wordFacts.1 _ _)]

theorem tallyWordSmall (b : Box) : tally b word < 524288^152 := by
  rw [←packTally]
  exact encodeSmall _ _ _ (fun i hi => lt_of_le_of_lt (blockBound b hi) (by decide))

theorem readTally (k : K) (b : Box) : slot k (tally b word) = tally b (weight k) := by
  have rd := readDigit 524288 152 (fun i => tally b (components i))
    (fun i hi => lt_of_le_of_lt (blockBound b hi) (by decide)) k.isLt
  rw [packTally] at rd
  simpa only [slotComp,sameComponents] using rd

def passes (x : Nat) := (x+fillWord) &&& flagWord == 0

theorem bitCap (b : Box) (k : K) (test : (tally b word+fillWord).testBit (19*k.val+18) = false) :
    tally b (weight k) ≤ lim k := by
  let f := fun i => tally b (components i)
  let g := fun i => component 524288 i fillWord
  have af : encode 524288 152 f = tally b word := packTally _
  have ag : encode 524288 152 g = fillWord :=
    (encodeWord _ _ _).trans (Nat.mod_eq_of_lt wordFacts.2.2.1)
  have sm (i : Nat) (hi : i<152) : f i + g i < 524288 := by
    have bnd := blockBound b hi
    have t := (wordFacts.2.2.2 ⟨i,hi⟩).1
    rw [slotComp] at t
    change component 524288 i fillWord + lim ⟨i,hi⟩ = 262143 at t
    change tally b (components i) + component 524288 i fillWord < 524288
    omega
  have both := readDigit 524288 152 (fun i => f i+g i) sm k.isLt
  rw [encodeAdd,af,ag] at both
  have low : (slot k (tally b word+fillWord)).testBit 18 = false := by
    change (((tally b word+fillWord) >>> (19*k.val)) % 2^19).testBit 18 = false
    simp only [Nat.testBit_mod_two_pow,Nat.testBit_shiftRight,show decide (18<19)=true from rfl,
      Bool.true_and,test]
  rw [slotComp,both,Nat.testBit_eq_decide_div_mod_eq] at low
  have bound := sm k.val k.isLt
  have offset := (wordFacts.2.2.2 k).1
  rw [slotComp] at offset
  have integral : ¬ ((f k.val + g k.val) / 262144 % 2 = 1) := of_decide_eq_false low
  have eq : f k.val = tally b (weight k) := by rw [show f k.val = tally b (components k.val) from rfl,sameComponents]
  change g k.val + lim k = 262143 at offset
  omega

theorem passed (b : Box) (h : passes (tally b word) = true) (k : K) : tally b (weight k) ≤ lim k := by
  apply bitCap
  have test := congrArg (fun x : Nat => x.testBit (19*k.val+18)) (beq_iff_eq.mp h)
  simpa only [Nat.testBit_and,(wordFacts.2.2.2 k).2,Bool.and_true,Nat.zero_testBit] using test

abbrev family (T : Finset Box) := ∀ b ∈ T, legal b
def covered (S : List H) (T : Finset Box) :=
  ∀ p q, bit p q = false → (∃ h ∈ S, hit (oval h) p q) ∨ ∃ b ∈ T, hit b p q

theorem removeTile {S : List H} {T : Finset Box} {b : Box} {h : H}
    (hc : covered S T) (sub : fits b (oval h)) : covered (h::S) (T.erase b) := by
  intro p q z
  rcases hc p q z with ⟨a,ha,v⟩ | ⟨c,mem,hp,hq⟩
  · exact Or.inl ⟨_,List.mem_cons_of_mem _ ha,v⟩
  · by_cases eq : c=b
    · subst c
      exact Or.inl ⟨h,by simp,sub.1 hp,sub.2 hq⟩
    · exact Or.inr ⟨c,mem_erase.mpr ⟨eq,mem⟩,hp,hq⟩

theorem moreSeeds {S U : List H} {T : Finset Box} (hc : covered S T)
    (sub : ∀ a ∈ S, a ∈ U) : covered U T := by
  intro p q z
  exact (hc p q z).imp (fun ⟨a,ha,v⟩ => ⟨a,sub a ha,v⟩) id

def permR (g : G) (p : V) := (genRows[g.val]!)[p.val]!
def permC (g : G) (p : V) := (genCols[g.val]!)[p.val]!
def act (g : G) (h : H) := (genLabels[g.val]!)[h.val]!
def moved (g : G) (b : Box) : Box := (b.1.image (permR g), b.2.image (permC g))

theorem genFacts : ∀ g : G,
    (∀ p q, bit (permR g p) (permC g q) = bit p q) ∧
    (∀ p, ∃ i : V, permR g i = p) ∧ (∀ q, ∃ j : V, permC g j = q) := by decide +kernel

