theorem genOval (g : G) : ∀ h : H, moved g (oval h) = oval (act g h) := by
  fin_cases g
  · exact genOval0
  · exact genOval1
  · exact genOval2
  · exact genOval3
  · exact genOval4
  · exact genOval5
  · exact genOval6
  · exact genOval7
  · exact genOval8

theorem movedHit (g : G) {b : Box} {p q : V} (h : hit b p q) :
    hit (moved g b) (permR g p) (permC g q) :=
  ⟨mem_image_of_mem _ h.1,mem_image_of_mem _ h.2⟩

theorem movedFamily (g : G) {T : Finset Box} (ok : family T) : family (T.image (moved g)) := by
  rintro _ hb p hp q hq
  obtain ⟨b,mem,rfl⟩ := mem_image.mp hb
  obtain ⟨i,hi,rfl⟩ := mem_image.mp hp
  obtain ⟨j,hj,rfl⟩ := mem_image.mp hq
  rw [(genFacts g).1]
  exact ok b mem i hi j hj

theorem movedCover (g : G) {S : List H} {T : Finset Box} (hc : covered S T) :
    covered (S.map (act g)) (T.image (moved g)) := by
  intro p q hz
  obtain ⟨i,rfl⟩ := (genFacts g).2.1 p
  obtain ⟨j,rfl⟩ := (genFacts g).2.2 q
  rw [(genFacts g).1] at hz
  rcases hc i j hz with ⟨h,mem,atH⟩ | ⟨b,mem,atB⟩
  · have ht := movedHit g atH
    rw [genOval] at ht
    exact Or.inl ⟨_,List.mem_map_of_mem mem,ht⟩
  · exact Or.inr ⟨_,mem_image_of_mem _ mem,movedHit g atB⟩

def walk (w : List G) (a : H) := w.foldl (fun h g => act g h) a

theorem walkCover (w : List G) (S : List H) (T : Finset Box) (ok : family T) (hc : covered S T) :
    ∃ U : Finset Box, U.card ≤ T.card ∧ family U ∧ covered (S.map (walk w)) U := by
  induction w generalizing S T with
  | nil =>
    have e : walk [] = id := rfl
    exact ⟨T,le_rfl,ok,by simpa [e] using hc⟩
  | cons g ws ih =>
    obtain ⟨U,ct,ok',hc'⟩ := ih (S.map (act g)) (T.image (moved g)) (movedFamily g ok) (movedCover g hc)
    have e : walk (g::ws) = walk ws ∘ act g := rfl
    exact ⟨U,ct.trans card_image_le,ok',by simpa [e,List.map_map] using hc'⟩

def area (b : Box) := b.1.card * b.2.card
def sizeRule (b : Box) := area b ≤ 28 ∧
  (area b = 28 → (b.1.card=4 ∧ b.2.card=7) ∨ (b.1.card=7 ∧ b.2.card=4))

def load (T : Finset Box) (A B : Box → Finset V) (p : V) :=
  ∑ b ∈ T, if p ∈ A b then (B b).card else 0

theorem minLoad (T : Finset Box) (A B : Box → Finset V) (zero : V → Finset V)
    (size : ∀ p, (zero p).card = 16)
    (hc : ∀ p q, q ∈ zero p → ∃ b ∈ T, p ∈ A b ∧ q ∈ B b) (p : V) : 16 ≤ load T A B p := by
  let U := T.filter fun b => p ∈ A b
  have sub : zero p ⊆ U.biUnion B := by
    intro q hq
    obtain ⟨b,hb,pa,qb⟩ := hc p q hq
    exact mem_biUnion.mpr ⟨b,mem_filter.mpr ⟨hb,pa⟩,qb⟩
  calc
    16 = (zero p).card := (size p).symm
    _ ≤ _ := card_le_card sub
    _ ≤ ∑ b ∈ U, (B b).card := card_biUnion_le
    _ = _ := by simp [U,load,sum_filter]

theorem totalLoad (T : Finset Box) (A B : Box → Finset V) :
    (∑ p : V, load T A B p) = ∑ b ∈ T, (A b).card*(B b).card := by
  unfold load
  rw [sum_comm]
  simp [sum_ite_mem]

theorem exactLoad (f : V → Nat) (lo : ∀ p, 16 ≤ f p) (hi : (∑ p, f p) ≤ 336) (p : V) : f p=16 := by
  by_contra h
  have larger : (∑ _ : V, 16) < ∑ q : V, f q :=
    sum_lt_sum (fun q _ => lo q) ⟨p,mem_univ _,lt_of_le_of_ne (lo p) (Ne.symm h)⟩
  have n : (∑ _ : V, 16)=336 := by decide
  omega

theorem fourWidths (T : Finset Box) (A B : Box → Finset V)
    (sh : ∀ b ∈ T, (B b).card = 4 ∨ (B b).card = 7)
    (eq : ∀ p, load T A B p = 16) {b : Box} (hb : b ∈ T) {p : V} (hp : p ∈ A b) :
    (B b).card = 4 := by
  let U := T.filter fun c => p ∈ A c
  let F := U.filter fun c => (B c).card=4
  let S := U.filter fun c => (B c).card=7
  have split : (∑ c ∈ U, (B c).card) = F.card*4+S.card*7 := by
    have h := fun c (hc : c ∈ U) => sh c (mem_filter.mp hc).1
    calc
      _ = ∑ c ∈ U, ((if (B c).card=4 then 4 else 0)+(if (B c).card=7 then 7 else 0)) :=
        sum_congr rfl fun c hc => by rcases h c hc with v | v <;> simp [v]
      _ = _ := by rw [sum_add_distrib,←sum_filter,←sum_filter]; simp [F,S]
  have value : (∑ c ∈ U, (B c).card) = 16 := by simpa [U,sum_filter,load] using eq p
  rcases sh b hb with v | v
  · exact v
  · have pos : 0 < S.card := card_pos.mpr ⟨b,mem_filter.mpr ⟨mem_filter.mpr ⟨hb,hp⟩,v⟩⟩
    omega

theorem smallImpossible (T : Finset Box) (ht : T.card≤12) (sh : ∀ b ∈ T, sizeRule b)
    (hc : covered [] T) : False := by
  have zc : (∀ p : V, (univ.filter (fun q : V => bit p q=false)).card=16) ∧
      (∀ q : V, (univ.filter (fun p : V => bit p q=false)).card=16) := by decide
  have row := minLoad T Prod.fst Prod.snd _ zc.1 (fun p q h => by
    simpa [hit] using hc p q (mem_filter.mp h).2)
  have col := minLoad T Prod.snd Prod.fst _ zc.2 (fun q p h => by
    simpa [hit,and_comm] using hc p q (mem_filter.mp h).2)
  have top : (∑ b ∈ T, area b) ≤ 336 := calc
    _ ≤ ∑ _ ∈ T, 28 := sum_le_sum fun b hb => (sh b hb).1
    _ = T.card*28 := by simp
    _ ≤ _ := by omega
  have bot : 336 ≤ ∑ b ∈ T, area b := calc
    336 = ∑ _ : V, 16 := by decide
    _ ≤ _ := sum_le_sum fun p _ => row p
    _ = _ := totalLoad _ _ _
  have full (b : Box) (hb : b ∈ T) : area b=28 := by
    by_contra h
    have strict : (∑ c ∈ T, area c) < ∑ _ ∈ T, 28 :=
      sum_lt_sum (fun c m => (sh c m).1) ⟨b,hb,lt_of_le_of_ne (sh b hb).1 h⟩
    change (∑ c ∈ T, area c) < ∑ _ ∈ T, (28 : Nat) at strict
    rw [show (∑ _ ∈ T, (28 : Nat)) = T.card*28 by simp] at strict
    omega
  have shape := fun b hb => (sh b hb).2 (full b hb)
  have rr := exactLoad _ row (by rw [totalLoad]; exact top)
  have cc := exactLoad _ col (by rw [totalLoad]; simpa only [area,mul_comm] using top)
  obtain ⟨b,hb,_⟩ : ∃ b ∈ T, hit b 0 1 := by simpa using hc 0 1 (by decide)
  rcases shape b hb with ⟨a,w⟩ | ⟨a,w⟩
  · obtain ⟨p,hp⟩ := card_pos.mp (show 0 < b.1.card by omega)
    have := fourWidths T Prod.fst Prod.snd (fun c hc' => (shape c hc').elim
      (fun h => Or.inr h.2) (fun h => Or.inl h.2)) rr hb hp
    omega
  · obtain ⟨q,hq⟩ := card_pos.mp (show 0 < b.2.card by omega)
    have := fourWidths T Prod.snd Prod.fst (fun c hc' => (shape c hc').elim
      (fun h => Or.inl h.1) (fun h => Or.inr h.1)) cc hb hq
    omega

-- All cyclic shifts of a box are tested together in disjoint blocks of digits.
def ovalType (o : O) : Option (Fin 8) :=
  match o.val with
  | 241 => some 0
  | 536 => some 1
  | 750 => some 2
  | 779 => some 3
  | 901 => some 4
  | 1001 => some 5
  | 1035 => some 6
  | 1063 => some 7
  | _ => none

