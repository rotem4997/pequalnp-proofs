def mark : List K → Nat
  | [] => 0
  | k::ks => (1 <<< (19*k.val+18)) ||| mark ks

theorem markBit (ks : List K) (k : K) : (mark ks).testBit (19*k.val+18) = true ↔ k ∈ ks := by
  induction ks with
  | nil => simp [mark]
  | cons a ks ih =>
    have same : (19*a.val+18=19*k.val+18) ↔ k=a := by
      constructor
      · intro eq; apply Fin.ext; omega
      · rintro rfl; rfl
    simp only [mark,Nat.testBit_or,Nat.one_shiftLeft,Nat.testBit_two_pow,Bool.or_eq_true,
      decide_eq_true_eq,ih,List.mem_cons,same]

def marked (h : H) := ((tally (oval h) word+fillWord) &&& flagWord)
def ovalTest (i : Nat) :=
  let h : H := Fin.ofNat 168 i
  let ks := eventNodes[h.val]!
  (marked h &&& mark ks == marked h) &&
    ks.all (fun k => (edges k).any (fun e => e.1 == h))

