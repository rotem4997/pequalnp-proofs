theorem oneCell (w : V → V → Nat) {b : Box} {p q : V} (atCell : hit b p q) : w p q ≤ tally b w := by
  exact (single_le_sum (f := w p) (by intros; omega) atCell.2).trans
    (single_le_sum (f := fun i => ∑ j ∈ b.2, w i j) (by intros; omega) atCell.1)

theorem weightCovered (T : Finset Box) (w : V → V → Nat)
    (hc : ∀ p q, 0 < w p q → ∃ b ∈ T, hit b p q) :
    tally (univ,univ) w ≤ ∑ b ∈ T, tally b w := by
  let f := fun b : Box => fun p q => if p ∈ b.1 then (if q ∈ b.2 then w p q else 0) else 0
  have pt (p q : V) : w p q ≤ ∑ b ∈ T, f b p q := by
    by_cases hp : 0 < w p q
    · obtain ⟨b,hb,hr,hc'⟩ := hc p q hp
      have := single_le_sum (f := fun c => f c p q) (fun c _ => Nat.zero_le _) hb
      simpa only [f,hr,hc',ite_true] using this
    · omega
  calc
    _ ≤ ∑ p : V, ∑ q : V, ∑ b ∈ T, f b p q := sum_le_sum fun p _ => sum_le_sum fun q _ => pt p q
    _ = ∑ b ∈ T, ∑ p : V, ∑ q : V, f b p q := by
      simp_rw [sum_comm (s := (univ : Finset V)) (t := T)]
    _ = _ := by
      apply sum_congr rfl
      intro b _
      simp [f,sum_ite_irrel,sum_ite_mem,tally]

theorem heavyBox {k : K} {T : Finset Box} (size : T.card ≤ budget k) (hc : covered (seed k) T) :
    ∃ b ∈ T, lim k < tally b (weight k) := by
  have keep (p q : V) (pos : 0 < weight k p q) : ∃ b ∈ T, hit b p q := by
    have zero : bit p q = false := by
      cases ht : bit p q with
      | false => rfl
      | true =>
        have zz := darkCells p q ht
        simp [weight,zz,slot] at pos
    rcases hc p q zero with ⟨h,mem,loc⟩ | rest
    · have low := oneCell (weight k) loc
      rw [(ovalFacts k h).1 mem] at low; omega
    · exact rest
  by_contra! bounded
  have total := weightCovered T _ keep
  have upper : (∑ b ∈ T, tally b (weight k)) ≤ budget k * lim k := calc
    _ ≤ ∑ _ ∈ T, lim k := sum_le_sum bounded
    _ = T.card * lim k := by simp
    _ ≤ _ := Nat.mul_le_mul_right _ size
  have := massLarge k
  omega

theorem nodeImpossible (n : Nat) (k : K) (rank : budget k = n) (T : Finset Box)
    (size : T.card ≤ n) (ok : family T) (hc : covered (seed k) T) : False := by
  induction n using Nat.strong_induction_on generalizing k T with
  | ind n ih =>
    obtain ⟨b,hb,heavy⟩ := heavyBox (size.trans rank.ge) hc
    obtain ⟨o,s,sub⟩ := containingTile b.1 b.2 (ok b hb)
    have high := lt_of_lt_of_le heavy (tallyMono sub (weight k))
    cases spec : ovalType o with
    | none => exact (Nat.not_lt_of_le (ordinaryBound o s spec k)) high
    | some i =>
      let h := label i s
      rw [specialTile spec] at high sub
      obtain ⟨e,em,matchH⟩ := (ovalFacts k h).2 high
      obtain ⟨smaller,route⟩ := routeFacts em
      have gone : covered (e.1 :: seed k) (T.erase b) := by rw [matchH]; exact removeTile hc sub
      have rest : family (T.erase b) := fun c hm => ok c (mem_erase.mp hm).2
      obtain ⟨U,ct,fam,cv⟩ := walkCover e.2.2 _ _ rest gone
      rw [card_erase_of_mem hb] at ct
      apply ih (budget e.2.1) (by omega) e.2.1 rfl U (by omega) fam
      apply moreSeeds cv
      intro a ha
      obtain ⟨d,hd,rfl⟩ := List.mem_map.mp ha
      exact route d hd

theorem anyOval {T : Finset Box} (size : T.card ≤ 12) (ok : family T) (hc : covered [] T)
    {b : Box} (hb : b ∈ T) {h : H} (sub : fits b (oval h)) : False := by
  have rest : family (T.erase b) := fun c hm => ok c (mem_erase.mp hm).2
  obtain ⟨U,ct,fam,cv⟩ := walkCover (firstMoves[h.val]!) [h] _ rest (removeTile hc sub)
  rw [card_erase_of_mem hb] at ct
  apply nodeImpossible 11 0 startFacts.2.2 U (by omega) fam
  simpa only [startFacts.2.1,List.map_cons,List.map_nil,startFacts.1] using cv

theorem noCover (L : List Box) (size : L.length ≤ 12) (legalL : ∀ b ∈ L, legal b)
    (hits : ∀ p q, bit p q = false → ∃ b ∈ L, hit b p q) : False := by
  classical
  let T := L.toFinset
  have small : T.card ≤ 12 := L.toFinset_card_le.trans size
  have ok : family T := fun b hb => legalL _ (List.mem_toFinset.mp hb)
  have cv : covered [] T := fun p q z => Or.inr (by simpa only [T,List.mem_toFinset] using hits p q z)
  have regular (b : Box) (mem : b ∈ T) : ∃ c : Box, fits b c ∧ sizeRule c := by
    obtain ⟨o,s,sub⟩ := containingTile b.1 b.2 (ok b mem)
    cases spec : ovalType o with
    | none => exact ⟨_,sub,ordinaryShape spec⟩
    | some i =>
      rw [specialTile spec] at sub
      exact False.elim (anyOval small ok cv mem sub)
  choose grow facts using regular
  let U := T.attach.image fun b => grow b.val b.property
  have cU : U.card ≤ 12 := (card_image_le.trans (le_of_eq card_attach)).trans small
  have sU : ∀ c ∈ U, sizeRule c := by
    intro c hc
    obtain ⟨b,_,rfl⟩ := mem_image.mp hc
    exact (facts _ b.property).2
  apply smallImpossible U cU sU
  intro p q z
  obtain ⟨b,mem,hp,hq⟩ := hits p q z
  have m : b ∈ T := List.mem_toFinset.mpr mem
  exact Or.inr ⟨grow b m,mem_image_of_mem _ (mem_attach T ⟨b,m⟩),(facts b m).1.1 hp,(facts b m).1.2 hq⟩

