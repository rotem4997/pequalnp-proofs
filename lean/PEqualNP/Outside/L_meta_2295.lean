namespace PEqualNP.Outside.L_meta_2295_aux.Helpers.Readers
open PEqualNP.MetaComplexity

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Outside.L_meta_2295_aux.Helpers

theorem gate_cases {k : ℕ} (gs : List Gate) (hcl : CleanL k gs) (q : ℕ) (g : Gate)
    (hq : gs[q]? = some g) (a : ℕ) (ha : a ∈ g.inputs) :
    (g.op = GateOp.not ∧ g.inputs = [a] ∧ ∀ u : Fin k → Bool, vl gs u (k + q) = !vl gs u a) ∨
    ∃ w, (g.inputs = [a, w] ∨ g.inputs = [w, a]) ∧
      ((g.op = GateOp.and ∧ ∀ u : Fin k → Bool, vl gs u (k + q) = (vl gs u a && vl gs u w)) ∨
       (g.op = GateOp.or ∧ ∀ u : Fin k → Bool, vl gs u (k + q) = (vl gs u a || vl gs u w))) := by
  rcases hcl q g hq with ⟨hop, j, _, hin⟩ | ⟨hop, j, j', _, _, hin⟩
  · left
    have e : a = j := by rw [hin] at ha; simpa using ha
    subst e
    exact ⟨hop, hin, fun u => vl_not gs hcl u q g hq a hop hin⟩
  · right
    have e : a = j ∨ a = j' := by rw [hin] at ha; simpa using ha
    rcases e with e | e
    · subst e
      refine ⟨j', Or.inl hin, ?_⟩
      rcases hop with hop | hop
      · exact Or.inl ⟨hop, fun u => by rw [vl_gate gs hcl u q g hq, hop, hin]; simp [GateOp.eval]⟩
      · exact Or.inr ⟨hop, fun u => by rw [vl_gate gs hcl u q g hq, hop, hin]; simp [GateOp.eval]⟩
    · subst e
      refine ⟨j, Or.inr hin, ?_⟩
      rcases hop with hop | hop
      · refine Or.inl ⟨hop, fun u => ?_⟩
        rw [vl_gate gs hcl u q g hq, hop, hin]
        simp only [GateOp.eval, List.map_cons, List.map_nil, List.all_cons, List.all_nil, id,
          Bool.and_true]
        exact Bool.and_comm _ _
      · refine Or.inr ⟨hop, fun u => ?_⟩
        rw [vl_gate gs hcl u q g hq, hop, hin]
        simp only [GateOp.eval, List.map_cons, List.map_nil, List.any_cons, List.any_nil, id,
          Bool.or_false]
        exact Bool.or_comm _ _

section

variable {m : ℕ} {f : (Fin m → Bool) → Bool} {gs : List Gate} {o : ℕ}

theorem Least.no_tri (L : Least m f gs o) (hnc : ∃ x y : Fin m → Bool, f x ≠ f y) (p q a : ℕ)
    (hpa : Reads gs p a) (hqa : Reads gs q a) (hqp : Reads gs q (m + p)) : False := by
  obtain ⟨gp, hgp, hap⟩ := hpa
  obtain ⟨gq, hgq, haq⟩ := hqa
  obtain ⟨gq', hgq', hpq⟩ := hqp
  have e : gq' = gq := by rw [hgq] at hgq'; exact (Option.some.inj hgq').symm
  subst e
  have hlt_a : a < m + p := (L.hcl p gp hgp).lt a hap
  have hlt_p : m + p < m + q := (L.hcl q gq' hgq).lt _ hpq
  have hqlen : q < gs.length := (List.getElem?_eq_some_iff.1 hgq).1
  rcases gate_cases gs L.hcl q gq' hgq a haq with ⟨_, hin, _⟩ | ⟨w, hin, hq⟩
  · rw [hin] at hpq
    simp at hpq
    omega
  · have hw : w = m + p := by
      rcases hin with hin | hin <;> rw [hin] at hpq <;> simp at hpq <;> omega
    subst hw
    rcases gate_cases gs L.hcl p gp hgp a hap with ⟨_, _, hp⟩ | ⟨w', _, hp⟩
    · rcases hq with ⟨_, hq⟩ | ⟨_, hq⟩
      · exact L.no_const hnc q hqlen false (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> rfl)
      · exact L.no_const hnc q hqlen true (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> rfl)
    · rcases hq with ⟨_, hq⟩ | ⟨_, hq⟩ <;> rcases hp with ⟨_, hp⟩ | ⟨_, hp⟩
      · exact L.no_alias hnc q hqlen (m + p) hlt_p (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> cases vl gs u w' <;> rfl)
      · exact L.no_alias hnc q hqlen a (by omega) (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> cases vl gs u w' <;> rfl)
      · exact L.no_alias hnc q hqlen a (by omega) (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> cases vl gs u w' <;> rfl)
      · exact L.no_alias hnc q hqlen (m + p) hlt_p (fun u => by
          rw [hq u, hp u]; cases vl gs u a <;> cases vl gs u w' <;> rfl)

end

section

variable {n : ℕ} {f : (Fin (n + 1) → Bool) → Bool} {gs : List Gate} {o : ℕ}

theorem isC_reader (hcl : CleanL (n + 1) gs) (i : Fin (n + 1)) (p : ℕ) (gp : Gate)
    (hgp : gs[p]? = some gp) (hip : (i : ℕ) ∈ gp.inputs) (b : Bool)
    (h : gp.op = GateOp.not ∨ b = fixBit gp) : IsC n gs i b (n + 1 + p) := by
  rcases h with h | rfl
  · apply st_allconst n gs hcl i b p gp hgp
    intro a ha
    rcases hcl p gp hgp with ⟨_, j, _, hin⟩ | ⟨hop, _⟩
    · rw [hin] at ha hip
      simp at ha hip
      rw [ha, ← hip]
      exact ⟨b, stF_self n gs i b⟩
    · rcases hop with hop | hop <;> rw [hop] at h <;> cases h
  · exact const_read n gs hcl i _ p gp hgp i hip (stF_self n gs i _)

theorem Least.third (L : Least (n + 1) f gs o) (i : Fin (n + 1)) (b : Bool)
    (hnc : ∃ x y : Fin (n + 1) → Bool, f (Function.update x i b) ≠ f (Function.update y i b))
    (p q : ℕ) (hpq : p ≠ q) (hp : Reads gs p i) (hq : Reads gs q i)
    (hc : IsC n gs i b (n + 1 + p)) : Drop f i b 3 gs.length := by
  have hfnc : ∃ x y : Fin (n + 1) → Bool, f x ≠ f y := by
    obtain ⟨x, y, h⟩ := hnc
    exact ⟨_, _, h⟩
  obtain ⟨J, hJp, hJr, hJrc⟩ := L.next i b hnc p (reads_len hp) hc
  have hJq : J ≠ q := by
    rintro rfl
    exact L.no_tri hfnc p J i hp hq hJr
  exact L.save3 i b hnc p q J hpq (by omega) (Ne.symm hJq) (rc_input b hp) (rc_input b hq) hJrc

theorem Least.fourth (L : Least (n + 1) f gs o) (i : Fin (n + 1)) (b : Bool)
    (hnc : ∃ x y : Fin (n + 1) → Bool, f (Function.update x i b) ≠ f (Function.update y i b))
    (p q : ℕ) (hpq : p ≠ q) (hp : Reads gs p i) (hq : Reads gs q i)
    (hcp : IsC n gs i b (n + 1 + p)) (hcq : IsC n gs i b (n + 1 + q)) :
    Drop f i b 4 gs.length := by
  have hfnc : ∃ x y : Fin (n + 1) → Bool, f x ≠ f y := by
    obtain ⟨x, y, h⟩ := hnc
    exact ⟨_, _, h⟩
  obtain ⟨J1, h1p, h1r, h1rc⟩ := L.next i b hnc p (reads_len hp) hcp
  obtain ⟨J2, h2q, h2r, h2rc⟩ := L.next i b hnc q (reads_len hq) hcq
  have h1q : J1 ≠ q := by
    rintro rfl
    exact L.no_tri hfnc p J1 i hp hq h1r
  have h2p : J2 ≠ p := by
    rintro rfl
    exact L.no_tri hfnc q J2 i hq hp h2r
  by_cases h12 : J1 = J2
  · have h2r' : Reads gs J1 (n + 1 + q) := by rw [h12]; exact h2r
    have h2q' : q < J1 := by rw [h12]; exact h2q
    obtain ⟨gJ, hgJ, hinp⟩ := h1r
    obtain ⟨gJ', hgJ', hinq⟩ := h2r'
    have e : gJ' = gJ := gate_eq hgJ' hgJ rfl
    subst e
    have hcJ : IsC n gs i b (n + 1 + J1) := st_allconst n gs L.hcl i b J1 gJ' hgJ (fun a ha => by
      rcases two_inputs (L.hcl J1 gJ' hgJ) (n + 1 + p) (n + 1 + q) a hinp hinq (by omega) ha
        with e | e
      · rw [e]; exact hcp
      · rw [e]; exact hcq)
    obtain ⟨K, hKJ, _, hKrc⟩ := L.next i b hnc J1 (List.getElem?_eq_some_iff.1 hgJ).1 hcJ
    exact L.save4 i b hnc p q J1 K hpq (by omega) (by omega) (Ne.symm h1q) (by omega) (by omega)
      (rc_input b hp) (rc_input b hq) h1rc hKrc
  · exact L.save4 i b hnc p q J1 J2 hpq (by omega) (Ne.symm h2p) (Ne.symm h1q) (by omega) h12
      (rc_input b hp) (rc_input b hq) h1rc h2rc

theorem Least.two_readers (L : Least (n + 1) f gs o) (i : Fin (n + 1))
    (hnc : ∀ b : Bool, ∃ x y : Fin (n + 1) → Bool,
      f (Function.update x i b) ≠ f (Function.update y i b))
    (p q : ℕ) (hpq : p ≠ q) (hp : Reads gs p i) (hq : Reads gs q i) : Pays f i gs.length := by
  obtain ⟨gp, hgp, hip⟩ := hp
  obtain ⟨gq, hgq, hiq⟩ := hq
  have hp : Reads gs p i := ⟨gp, hgp, hip⟩
  have hq : Reads gs q i := ⟨gq, hgq, hiq⟩
  have cp := isC_reader L.hcl i p gp hgp hip
  have cq := isC_reader L.hcl i q gq hgq hiq
  by_cases hnp : gp.op = GateOp.not
  · exact Or.inl ⟨L.third i false (hnc false) p q hpq hp hq (cp false (Or.inl hnp)),
      L.third i true (hnc true) p q hpq hp hq (cp true (Or.inl hnp))⟩
  by_cases hnq : gq.op = GateOp.not
  · exact Or.inl ⟨L.third i false (hnc false) q p (Ne.symm hpq) hq hp (cq false (Or.inl hnq)),
      L.third i true (hnc true) q p (Ne.symm hpq) hq hp (cq true (Or.inl hnq))⟩
  by_cases hfb : fixBit gp = fixBit gq
  · cases hc : fixBit gp
    · exact Or.inr (Or.inl ⟨L.fourth i false (hnc false) p q hpq hp hq
        (cp false (Or.inr hc.symm)) (cq false (Or.inr (by rw [← hfb, hc]))),
        L.save2 i true (hnc true) p q hpq (rc_input true hp) (rc_input true hq)⟩)
    · exact Or.inr (Or.inr ⟨L.save2 i false (hnc false) p q hpq (rc_input false hp)
        (rc_input false hq), L.fourth i true (hnc true) p q hpq hp hq
        (cp true (Or.inr hc.symm)) (cq true (Or.inr (by rw [← hfb, hc])))⟩)
  · have key : ∀ b, Drop f i b 3 gs.length := by
      intro b
      by_cases hb : b = fixBit gp
      · exact L.third i b (hnc b) p q hpq hp hq (cp b (Or.inr hb))
      · have hb' : b = fixBit gq := by
          revert hb hfb
          cases b <;> cases fixBit gp <;> cases fixBit gq <;> simp
        exact L.third i b (hnc b) q p (Ne.symm hpq) hq hp (cq b (Or.inr hb'))
    exact Or.inl ⟨key false, key true⟩

theorem Least.not_two_readers (L : Least (n + 1) f gs o) (i : Fin (n + 1))
    (hnc : ∀ b : Bool, ∃ x y : Fin (n + 1) → Bool,
      f (Function.update x i b) ≠ f (Function.update y i b))
    (r : ℕ) (g : Gate) (hr : gs[r]? = some g) (hop : g.op = GateOp.not)
    (hin : (i : ℕ) ∈ g.inputs) (p q : ℕ) (hpq : p ≠ q) (hp : Reads gs p (n + 1 + r))
    (hq : Reads gs q (n + 1 + r)) : Drop f i false 3 gs.length ∧ Drop f i true 3 gs.length := by
  have key : ∀ b, Drop f i b 3 gs.length := by
    intro b
    have hc := isC_reader L.hcl i r g hr hin b (Or.inl hop)
    have hpr := reads_lt L.hcl hp
    have hqr := reads_lt L.hcl hq
    exact L.save3 i b (hnc b) r p q (by omega) (by omega) hpq (rc_input b ⟨g, hr, hin⟩)
      (rc_of_reads hp hc) (rc_of_reads hq hc)
  exact ⟨key false, key true⟩

end

end PEqualNP.Outside.L_meta_2295_aux.Helpers.Readers

namespace PEqualNP.Outside.L_meta_2295_aux

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity
open PEqualNP.Outside.L_meta_2295_aux.Helpers
open PEqualNP.Outside.L_meta_2295_aux.Helpers.Readers

private theorem firstAnd (C : Circuit) (hC : FanInTwo C)
    (hfirst : ∀ x : Fin 9 → Bool, (C.wires (List.ofFn x)).getD 9 false = (x 0 && x 4)) :
    ∃ g gs, C.gates = g :: gs ∧ g.op = GateOp.and ∧ (g.inputs = [0, 4] ∨ g.inputs = [4, 0]) := by
  have hn : C.gates ≠ [] := by
    intro hn
    have h := hfirst (fun _ => true)
    rw [wires_eq, hn] at h
    simp [wiresFrom] at h
  obtain ⟨g, gs, hg⟩ := List.exists_cons_of_ne_nil hn
  obtain ⟨hop, hlen⟩ := hC g (by rw [hg]; exact List.mem_cons_self)
  have tests (p : ℕ → Bool) (hp : ∀ i, 9 ≤ i → p i = false) :
      g.op.eval (g.inputs.map p) = (p 0 && p 4) := by
    let x : Fin 9 → Bool := fun i => p i.val
    let w := List.ofFn x
    have hv (i : ℕ) : w.getD i false = p i := by
      by_cases hi : i < 9
      · simp only [w, List.getD_eq_getElem?_getD, List.getElem?_ofFn, dite_eq_left hi, Option.getD_some]
        rfl
      · simp only [w, List.getD_eq_getElem?_getD, List.getElem?_ofFn, dite_eq_right hi, Option.getD_none]
        exact (hp i (Nat.le_of_not_gt hi)).symm
    let value := g.op.eval (g.inputs.map fun i => w.getD i false)
    have hcons : C.wires w = wiresFrom gs (w ++ [value]) := by rw [wires_eq, hg]; rfl
    obtain ⟨tail, ht, _⟩ := wiresFrom_prefix gs (w ++ [value])
    have h := hfirst x
    change (C.wires w).getD 9 false = _ at h
    rw [hcons, ht, List.getD_append _ _ _ _ (by simp [w])] at h
    have hval : (w ++ [value]).getD 9 false = value := getD_snoc_len _ _ _ _ (by simp [w])
    rw [hval] at h
    change g.op.eval (g.inputs.map fun i => w.getD i false) = (p 0 && p 4) at h
    simpa only [hv] using h
  have hPair := tests (fun i => decide (i = 0 ∨ i = 4)) (by intro i hi; simp [show i ≠ 0 by omega, show i ≠ 4 by omega])
  have hZero := tests (fun i => decide (i = 0)) (by intro i hi; simp [show i ≠ 0 by omega])
  have hFour := tests (fun i => decide (i = 4)) (by intro i hi; simp [show i ≠ 4 by omega])
  have hFalse := tests (fun _ => false) (by simp)
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hop
  refine ⟨g, gs, hg, ?_⟩
  rcases hop with hand | hor | hnot
  · refine ⟨hand, ?_⟩
    have hm (i : ℕ) (hi : i ∈ g.inputs) : i = 0 ∨ i = 4 := by
      have ht : (g.inputs.map (fun i => decide (i = 0 ∨ i = 4))).all id = true := by
        simpa [hand, GateOp.eval] using hPair
      simpa using (List.all_eq_true.mp ht) _ (List.mem_map.mpr ⟨i, hi, rfl⟩)
    have h0 : 0 ∈ g.inputs := by
      by_contra h
      have hp : (g.inputs.map (fun i => decide (i = 4))).all id = true :=
        List.all_eq_true.mpr (by
          intro v hv
          obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hv
          have : i = 4 := (hm i hi).resolve_left (fun hz => h (hz ▸ hi))
          simp [this])
      have hbad : (g.inputs.map (fun i => decide (i = 4))).all id = false := by
        simpa [hand, GateOp.eval] using hFour
      rw [hp] at hbad
      contradiction
    have h4 : 4 ∈ g.inputs := by
      by_contra h
      have hp : (g.inputs.map (fun i => decide (i = 0))).all id = true :=
        List.all_eq_true.mpr (by
          intro v hv
          obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hv
          have : i = 0 := (hm i hi).resolve_right (fun hz => h (hz ▸ hi))
          simp [this])
      have hbad : (g.inputs.map (fun i => decide (i = 0))).all id = false := by
        simpa [hand, GateOp.eval] using hZero
      rw [hp] at hbad
      contradiction
    cases hin : g.inputs with
    | nil => simp [hin] at h0
    | cons i tail =>
      cases tail with
      | nil => simp [hin] at h0 h4; omega
      | cons j tail =>
        have hlen' : tail.length + 2 ≤ 2 := by simpa [hin, Nat.add_assoc] using hlen
        have ht : tail = [] := List.length_eq_zero_iff.mp (by omega)
        subst tail
        simp [hin] at h0 h4 ⊢
        omega
  · exfalso
    have hp : (g.inputs.map (fun i => decide (i = 0 ∨ i = 4))).any id = true := by
      simpa [hor, GateOp.eval] using hPair
    have hz : (g.inputs.map (fun i => decide (i = 0))).any id = false := by
      simpa [hor, GateOp.eval] using hZero
    have hf : (g.inputs.map (fun i => decide (i = 4))).any id = false := by
      simpa [hor, GateOp.eval] using hFour
    obtain ⟨v, hv, hvtrue⟩ := List.any_eq_true.mp hp
    obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hv
    have he : i = 0 ∨ i = 4 := by simpa using hvtrue
    rcases he with rfl | rfl
    · have h1 : (g.inputs.map (fun i => decide (i = 0))).any id = true :=
        List.any_eq_true.mpr ⟨true, List.mem_map.mpr ⟨0, hi, by decide⟩, rfl⟩
      rw [h1] at hz; contradiction
    · have h1 : (g.inputs.map (fun i => decide (i = 4))).any id = true :=
        List.any_eq_true.mpr ⟨true, List.mem_map.mpr ⟨4, hi, by decide⟩, rfl⟩
      rw [h1] at hf; contradiction
  · exfalso
    cases hin : g.inputs <;> simp [hnot, GateOp.eval, hin] at hFalse

private theorem sameOutside (ignored : ℕ) (gates : List Gate)
    (hread : ∀ g ∈ gates, ignored ∉ g.inputs) (a b : List Bool)
    (hlen : a.length = b.length)
    (hinput : ∀ i, i ≠ ignored → a.getD i false = b.getD i false) :
    ∀ i, i ≠ ignored → (wiresFrom gates a).getD i false =
      (wiresFrom gates b).getD i false := by
  induction gates generalizing a b with
  | nil => exact hinput
  | cons g gs ih =>
    have hargs : g.inputs.map (fun i => a.getD i false) =
        g.inputs.map (fun i => b.getD i false) := by
      apply List.map_congr_left
      intro i hi
      apply hinput i
      intro he
      exact hread g List.mem_cons_self (he ▸ hi)
    let v := g.op.eval (g.inputs.map fun i => a.getD i false)
    change ∀ i, i ≠ ignored → (wiresFrom gs (a ++ [v])).getD i false =
      (wiresFrom gs (b ++ [g.op.eval (g.inputs.map fun i => b.getD i false)])).getD i false
    rw [← hargs]
    apply ih (fun g hg => hread g (List.mem_cons_of_mem _ hg))
    · simp [hlen]
    · intro i hi
      by_cases hlt : i < a.length
      · rw [List.getD_append _ _ _ _ hlt, List.getD_append _ _ _ _ (hlen ▸ hlt)]
        exact hinput i hi
      · rw [List.getD_append_right _ _ _ _ (Nat.le_of_not_gt hlt),
          List.getD_append_right _ _ _ _ (hlen ▸ Nat.le_of_not_gt hlt), hlen]

private theorem addGates (m : ℕ) (gs : List Gate) (acc : List Stat × List Gate) :
    ∃ tail, (elim m gs acc).2 = acc.2 ++ tail := by
  induction gs generalizing acc with
  | nil => exact ⟨[], by simp [elim]⟩
  | cons g gs ih =>
    obtain ⟨tail, ht⟩ := ih (elimStep m acc g)
    rw [elim_cons, ht, elimStep, Prod.snd, List.append_assoc]
    exact ⟨_, rfl⟩

theorem eliminateFirstAnd (C : Circuit) (hmin : IsMinimalCircuit 9 C)
    (hfirst : ∀ x : Fin 9 → Bool, (C.wires (List.ofFn x)).getD 9 false = (x 0 && x 4))
    (hdep : ∃ x : Fin 9 → Bool, x 0 = false ∧
      circuitFun 9 C (Function.update x 4 false) ≠ circuitFun 9 C (Function.update x 4 true))
    (hnc : ∃ x y : Fin 9 → Bool,
      circuitFun 9 C (Function.update x 4 false) ≠ circuitFun 9 C (Function.update y 4 false)) :
    ∃ s : ℕ, s + 3 ≤ C.size ∧ HasCircuitSize 9
      (fun x => circuitFun 9 C (Function.update x 4 false)) s := by
  obtain ⟨g, rawTail, hg, hand, hargs⟩ := firstAnd C hmin.1 hfirst
  let seed : List Stat × List Gate := (idStats 9, [])
  let acc := elim 9 C.gates seed
  have ok : ∀ p ∈ C.gates, Ok p := hmin.1
  have hInv (y : Fin 9 → Bool) :
      Inv 9 (List.ofFn y) (wiresFrom C.gates (List.ofFn y)) acc :=
    inv_elim 9 _ (by simp) C.gates _ _ ok (inv_id 9 y)
  have hval (y : Fin 9 → Bool) :
      (acc.1.getD C.output (Sum.inl false)).val (wiresFrom acc.2 (List.ofFn y)) = circuitFun 9 C y :=
    ((hInv y).2 C.output).2
  have hclean : CleanL 9 acc.2 := clean_elim 9 (List.ofFn fun _ : Fin 9 => false) (by simp)
    C.gates _ _ ok (inv_id 9 _) (by intro p g hp; simp [seed] at hp)
  have hlen : acc.2.length ≤ C.size := by simpa [acc, seed, Circuit.size] using elim_len 9 C.gates seed
  cases ho : acc.1.getD C.output (Sum.inl false) with
  | inl c =>
    obtain ⟨x, y, hxy⟩ := hnc
    have he (z : Fin 9 → Bool) : circuitFun 9 C z = c := by
      have h := hval z
      rw [ho] at h
      exact h.symm
    exact False.elim (hxy ((he _).trans (he _).symm))
  | inr o =>
    have hev (x : Fin 9 → Bool) : vl acc.2 x o = circuitFun 9 C x := by
      have h := hval x
      rw [ho] at h
      exact h
    have least : Least 9 (circuitFun 9 C) acc.2 o := by
      refine ⟨hclean, hev, ?_⟩
      intro gs o' hc' he'
      have hsz : C.size ≤ (⟨gs, o'⟩ : Circuit).size := hmin.2 ⟨gs, o'⟩
        (fun g hg => (clean_nok 9 gs hc' g hg).1) (funext he')
      exact hlen.trans hsz
    have hfirstStep : (elimStep 9 seed g).2 = [g] := by
      obtain ⟨op, args⟩ := g
      change op = GateOp.and at hand
      change args = [0, 4] ∨ args = [4, 0] at hargs
      subst op
      rcases hargs with rfl | rfl <;> rfl
    obtain ⟨tail, ht⟩ := addGates 9 rawTail (elimStep 9 seed g)
    have hghead : acc.2 = g :: tail := by simpa only [acc, hg, elim_cons, hfirstStep, List.singleton_append] using ht
    have firstReads : Reads acc.2 0 4 := ⟨g, by simp [hghead], by rcases hargs with h | h <;> simp [h]⟩
    have firstFalse : IsC 8 acc.2 4 false 9 := by
      refine ⟨false, ?_⟩
      unfold stF
      rw [hghead, elim_cons, elim_getD]
      · obtain ⟨op, args⟩ := g
        change op = GateOp.and at hand
        change args = [0, 4] ∨ args = [4, 0] at hargs
        subst op
        rcases hargs with rfl | rfl <;> rfl
      · simp [elimStep, statAt_length]
    have secondReads : ∃ q, q ≠ 0 ∧ Reads acc.2 q 4 := by
      by_contra h
      have htail : ∀ p ∈ tail, 4 ∉ p.inputs := by
        intro p hp h4
        obtain ⟨q, hq⟩ := List.mem_iff_getElem?.1 hp
        exact h ⟨q + 1, by omega, p, by simpa [hghead] using hq, h4⟩
      have hout : o ≠ 4 := by
        intro ho
        subst o
        obtain ⟨x, y, hxy⟩ := hnc
        apply hxy
        rw [← hev, ← hev, vl_input _ _ _ (by decide), vl_input _ _ _ (by decide)]
        simp
      obtain ⟨x, hx, hne⟩ := hdep
      let u := Function.update x 4 false
      let v := Function.update x 4 true
      have hw (i : ℕ) (hi : i ≠ 4) : (List.ofFn u).getD i false = (List.ofFn v).getD i false := by
        by_cases hil : i < 9
        · have hj : (⟨i, hil⟩ : Fin 9) ≠ 4 := fun e => hi (congrArg Fin.val e)
          simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, dite_eq_left hil,
            Option.getD_some, u, v, Function.update_of_ne hj]
        · simp only [List.getD_eq_getElem?_getD, List.getElem?_ofFn, dite_eq_right hil, Option.getD_none]
      have hzero (b : Bool) :
          g.op.eval (g.inputs.map fun i => (List.ofFn (Function.update x 4 b)).getD i false) = false := by
        rcases hargs with ha | ha <;> simp [hand, GateOp.eval, ha, hx]
      apply hne
      rw [← hev, ← hev]
      change (wiresFrom acc.2 (List.ofFn u)).getD o false =
        (wiresFrom acc.2 (List.ofFn v)).getD o false
      rw [hghead]
      change (wiresFrom tail (List.ofFn u ++ [_])).getD o false =
        (wiresFrom tail (List.ofFn v ++ [_])).getD o false
      rw [hzero false, hzero true]
      apply sameOutside 4 tail htail _ _ (by simp) _ o hout
      intro i hi
      by_cases il : i < 9
      · rw [List.getD_append _ _ _ _ (by simpa using il), List.getD_append _ _ _ _ (by simpa using il), hw i hi]
      · rw [List.getD_append_right _ _ _ _ (by simpa using Nat.le_of_not_gt il),
          List.getD_append_right _ _ _ _ (by simpa using Nat.le_of_not_gt il)]
        simp
    obtain ⟨q, hq, hread⟩ := secondReads
    obtain ⟨s, hs, hc⟩ := least.third 4 false hnc 0 q (Ne.symm hq) firstReads hread firstFalse
    exact ⟨s, hs.trans hlen, hc⟩

end PEqualNP.Outside.L_meta_2295_aux

namespace PEqualNP.Outside.L_meta_2295_aux
open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity

theorem meta2295Reindex (g : (Fin 9 → Bool) → Bool) (s : ℕ)
    (h : HasCircuitSize 9 g s) :
    HasCircuitSize 8 (fun x => g (Fin.insertNth 4 false x)) s := by
  obtain ⟨C, hC, hsize, hEval⟩ := h
  let stop := 8 + C.gates.length
  let rename (i : ℕ) := if i < 4 then i else if i = 4 then stop else i - 1
  let remap (a : Gate) : Gate := ⟨a.op, a.inputs.map rename⟩
  let D : Circuit := ⟨C.gates.map remap, rename C.output⟩
  have hlegal : FanInTwo D := by
    intro a ha
    change a ∈ C.gates.map remap at ha
    obtain ⟨b, hb, rfl⟩ := List.mem_map.mp ha
    simpa [remap] using hC b hb
  refine ⟨D, hlegal, by simpa [D, Circuit.size] using hsize, ?_⟩
  intro x
  let y : Fin 9 → Bool := Fin.insertNth 4 false x
  let step (w : List Bool) (a : Gate) := w ++ [a.op.eval (a.inputs.map fun i => w.getD i false)]
  have outside {w : List Bool} {i : ℕ} (hi : w.length ≤ i) : w.getD i false = false := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none_iff.mpr hi]
    rfl
  have simulate (gs : List Gate) (a b : List Bool)
      (hl : a.length = b.length + 1) (hlo : 8 ≤ b.length)
      (hhi : b.length + gs.length ≤ stop)
      (hr : ∀ i, a.getD i false = b.getD (rename i) false) :
      ∀ i, (gs.foldl step a).getD i false =
        ((gs.map remap).foldl step b).getD (rename i) false := by
    induction gs generalizing a b with
    | nil => exact hr
    | cons p ps ih =>
      let v := p.op.eval (p.inputs.map fun i => a.getD i false)
      have hv : (remap p).op.eval ((remap p).inputs.map fun i => b.getD i false) = v := by
        simp only [remap, v, List.map_map, Function.comp_def, hr]
      change ∀ i, (ps.foldl step (a ++ [v])).getD i false =
        ((ps.map remap).foldl step (b ++ [_])).getD (rename i) false
      rw [hv]
      apply ih
      · simp [hl, Nat.add_assoc]
      · simp; omega
      · simp at hhi ⊢; omega
      · intro i
        by_cases hi : i = 4
        · subst i
          rw [List.getD_append a [v] false 4 (by omega)]
          rw [hr 4, show rename 4 = stop by simp [rename]]
          rw [outside, outside] <;> (simp at hhi ⊢; omega)
        · have hsmall : rename i = if i < 4 then i else i - 1 := by simp [rename, hi]
          rcases lt_trichotomy i a.length with hlt | heq | hgt
          · have hrl : rename i < b.length := by rw [hsmall]; split <;> omega
            rw [List.getD_append a [v] false i hlt,
              List.getD_append b [v] false (rename i) hrl, hr i]
          · subst i
            have hre : rename a.length = b.length := by rw [hsmall]; split <;> omega
            rw [hre, List.getD_append_right _ _ _ _ (Nat.le_refl _),
              List.getD_append_right _ _ _ _ (Nat.le_refl _)]
            simp
          · have hrg : b.length < rename i := by rw [hsmall]; split <;> omega
            rw [outside, outside] <;> (simp; omega)
  have initial (i : ℕ) : (List.ofFn y).getD i false = (List.ofFn x).getD (rename i) false := by
    by_cases hi : i < 9
    · interval_cases i <;> first | rfl | (
        rw [show rename 4 = stop by simp [rename], outside (w := List.ofFn x) (i := stop) (by simp [stop])]
        rfl)
    · have hri : 8 ≤ rename i := by simp [rename, show ¬i < 4 by omega, show i ≠ 4 by omega]; omega
      rw [outside (w := List.ofFn y) (i := i) (by simpa using Nat.le_of_not_gt hi),
        outside (w := List.ofFn x) (i := rename i) (by simpa using hri)]
  have hout := simulate C.gates (List.ofFn y) (List.ofFn x) (by simp) (by simp)
    (by simp [stop]) initial C.output
  exact hout.symm.trans (hEval y)
end PEqualNP.Outside.L_meta_2295_aux

theorem PEqualNP.Outside.L_meta_2295 : 
∀ (x1 : PEqualNP.CircuitLowerBounds.Circuit), PEqualNP.MetaComplexity.IsMinimalCircuit (9 : ℕ) x1 → (∀ (x3 : Fin (9 : ℕ) → Bool), (x1.wires (List.ofFn x3)).getD (9 : ℕ) Bool.false = (x3 (0 : Fin (9 : ℕ)) && x3 (4 : Fin (9 : ℕ)))) → (PEqualNP.MetaComplexity.circuitFun (9 : ℕ) x1 = fun (x4 : Fin (9 : ℕ) → Bool) => x4 (0 : Fin (9 : ℕ)) && x4 (1 : Fin (9 : ℕ)) || x4 (1 : Fin (9 : ℕ)) && x4 (2 : Fin (9 : ℕ)) || x4 (2 : Fin (9 : ℕ)) && x4 (3 : Fin (9 : ℕ)) || x4 (3 : Fin (9 : ℕ)) && x4 (4 : Fin (9 : ℕ)) || x4 (4 : Fin (9 : ℕ)) && x4 (0 : Fin (9 : ℕ)) || x4 (0 : Fin (9 : ℕ)) && x4 (5 : Fin (9 : ℕ)) || x4 (1 : Fin (9 : ℕ)) && x4 (6 : Fin (9 : ℕ)) || x4 (2 : Fin (9 : ℕ)) && x4 (7 : Fin (9 : ℕ)) || x4 (3 : Fin (9 : ℕ)) && x4 (8 : Fin (9 : ℕ)) || x4 (5 : Fin (9 : ℕ)) && x4 (7 : Fin (9 : ℕ)) || x4 (6 : Fin (9 : ℕ)) && x4 (8 : Fin (9 : ℕ)) || x4 (8 : Fin (9 : ℕ)) && x4 (5 : Fin (9 : ℕ))) → ∃ (x5 : ℕ), x5 + (3 : ℕ) ≤ x1.size ∧ PEqualNP.MetaComplexity.HasCircuitSize (8 : ℕ) (fun (x6 : Fin (8 : ℕ) → Bool) => x6 (0 : Fin (8 : ℕ)) && x6 (1 : Fin (8 : ℕ)) || x6 (1 : Fin (8 : ℕ)) && x6 (2 : Fin (8 : ℕ)) || x6 (2 : Fin (8 : ℕ)) && x6 (3 : Fin (8 : ℕ)) || x6 (0 : Fin (8 : ℕ)) && x6 (4 : Fin (8 : ℕ)) || x6 (1 : Fin (8 : ℕ)) && x6 (5 : Fin (8 : ℕ)) || x6 (2 : Fin (8 : ℕ)) && x6 (6 : Fin (8 : ℕ)) || x6 (3 : Fin (8 : ℕ)) && x6 (7 : Fin (8 : ℕ)) || x6 (4 : Fin (8 : ℕ)) && x6 (6 : Fin (8 : ℕ)) || x6 (5 : Fin (8 : ℕ)) && x6 (7 : Fin (8 : ℕ)) || x6 (7 : Fin (8 : ℕ)) && x6 (4 : Fin (8 : ℕ))) x5
 := by
  intro C hmin hfirst hfun
  have hdepends : ∃ x : Fin 9 → Bool, x 0 = false ∧
      PEqualNP.MetaComplexity.circuitFun 9 C (Function.update x 4 false) ≠
        PEqualNP.MetaComplexity.circuitFun 9 C (Function.update x 4 true) := by
    refine ⟨fun i => decide (i = 3), by decide, ?_⟩
    rw [hfun]
    decide
  have hnonconstant : ∃ x y : Fin 9 → Bool,
      PEqualNP.MetaComplexity.circuitFun 9 C (Function.update x 4 false) ≠
        PEqualNP.MetaComplexity.circuitFun 9 C (Function.update y 4 false) := by
    refine ⟨fun _ => false, fun i => decide (i = 0 ∨ i = 1), ?_⟩
    rw [hfun]
    decide
  obtain ⟨s, hs, hsize⟩ := PEqualNP.Outside.L_meta_2295_aux.eliminateFirstAnd C hmin hfirst hdepends hnonconstant
  refine ⟨s, hs, ?_⟩
  have hsmall := PEqualNP.Outside.L_meta_2295_aux.meta2295Reindex _ s hsize
  convert hsmall using 1
  funext x
  rw [hfun]
  let y : Fin 9 → Bool := Function.update (Fin.insertNth 4 false x) 4 false
  change _ = (y 0 && y 1 || y 1 && y 2 || y 2 && y 3 || y 3 && y 4 || y 4 && y 0 ||
    y 0 && y 5 || y 1 && y 6 || y 2 && y 7 || y 3 && y 8 || y 5 && y 7 ||
    y 6 && y 8 || y 8 && y 5)
  simp only [show y 0 = x 0 from rfl, show y 1 = x 1 from rfl, show y 2 = x 2 from rfl,
    show y 3 = x 3 from rfl, show y 4 = false from rfl, show y 5 = x 4 from rfl,
    show y 6 = x 5 from rfl, show y 7 = x 6 from rfl, show y 8 = x 7 from rfl,
    Bool.and_false, Bool.false_and, Bool.or_false]
