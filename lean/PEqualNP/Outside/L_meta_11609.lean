theorem avoid : moves raw (feasible target negative 6) = false := by
  change raw.any branch = false
  simp only [raw,List.any_cons,List.any_nil,first0,first1,first2,first3,first4,first5,Bool.false_or]

theorem checked : feasible target negative 7 raw = false := by
  have absent : raw.contains target = false := by decide +kernel
  change (raw.contains target || (decide (raw.length ≤ 8) && covered target negative raw && moves raw (feasible target negative 6))) = false
  simp only [absent,avoid,Bool.false_or,Bool.and_false]

theorem lower (p : List (ℕ × ℕ)) (o : ℕ) (hit : canonical (evaluate p initial o) = target) : 8 ≤ p.length :=
  from_check target nonzero raw initial (by decide +kernel) start negative neg essential 7 checked p o hit

