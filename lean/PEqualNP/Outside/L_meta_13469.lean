def xsG : List ℕ := [0x149cc9d7de0066001ef, 0x2f6f376c666978ba613, 0x3b6f37b8b992793d81c, 0x3c757a3febe381c1fe0, 0x3f8abfc115fc01fe000, 0x3fffc40201fffe00000]

theorem rowsG_len : rowsG.length = 74 := by decide +kernel

theorem enc_inputsG :
    (List.ofFn fun (i : Fin 6) => ((fun x : Fin 6 → Bool => x i), taggedFn i.val)).map
      (encT rowsG 37 false) = xsG := by decide +kernel

theorem enc_goalG : encT rowsG 37 false (fG, false) = goal 37 := by decide +kernel

theorem proper_failG : ∀ zs ∈ xsG.sublists, zs ≠ xsG →
    (cov 37 zs &&& lo 37) ≠ lo 37 := by decide +kernel

theorem no_subG (noRunFull : ∀ s ≤ 8, ¬ NatRunT 37 false (goal 37) s xsG) :
    ∀ s ≤ 8, ∀ zs : List ℕ, zs.Sublist xsG → NatRunT 37 false (goal 37) s zs → False := by
  intro s hs zs hz h
  by_cases e : zs = xsG
  · subst e; exact noRunFull s hs h
  · exact proper_failG zs (List.mem_sublists.2 hz) e (required h)

theorem mainG (noRunFull : ∀ s ≤ 8, ¬ NatRunT 37 false (goal 37) s xsG) :
    ¬ HasCircuitSize 6 fG 8 := by
  intro h
  obtain ⟨s', hs', ws, hsub, hrun⟩ :=
    exists_run_tagged false fG ⟨pt 6 0, pt 6 11, by decide +kernel⟩ taggedFn htag_fn h
  have hr : NatRunT 37 false (encT rowsG 37 false (fG, false)) s'
      (ws.map (encT rowsG 37 false)) :=
    RunT.map (encT rowsG 37 false)
      (fun a => encT_inv rowsG 37 rowsG_len false a)
      (fun a b => encT_and rowsG 37 rowsG_len false a b)
      (fun a b => encT_or rowsG 37 rowsG_len false a b)
      (fun a => encT_tag rowsG 37 rowsG_len false a)
      hrun
  rw [enc_goalG] at hr
  refine no_subG noRunFull s' hs' _ ?_ hr
  rw [← enc_inputsG]
  exact hsub.map _

