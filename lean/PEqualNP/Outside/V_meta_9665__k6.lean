import Mathlib
import PEqualNP.Defs

namespace PEqualNP.Outside.V_meta_9665__k6

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.Represents

abbrev Word16 := BitVec 16

def Allowed (op : GateOp) : Prop := op = GateOp.and ∨ op = GateOp.or

def Known (w : List Word16) (a : Word16) : Prop :=
  a = 0 ∨ a = BitVec.allOnes 16 ∨ a ∈ w

def wordOp (op : GateOp) (as : List Word16) : Word16 :=
  match op, as with
  | .and, [] => BitVec.allOnes 16
  | .and, [a] => a
  | .and, a :: b :: _ => a &&& b
  | .or, [] => 0
  | .or, [a] => a
  | .or, a :: b :: _ => a ||| b
  | .not, [] => BitVec.allOnes 16
  | .not, a :: _ => ~~~a
  | _, _ => 0

def wordStep (ws : List Word16) (g : Gate) : Word16 :=
  wordOp g.op (g.inputs.map fun i => ws.getD i 0)

def wordRun (ws : List Word16) : List Gate → List Word16
  | [] => ws
  | g :: gs => wordRun (ws ++ [wordStep ws g]) gs

def bits (ws : List Word16) (j : ℕ) : List Bool :=
  ws.map fun w => w.getLsbD j

theorem bits_get (ws : List Word16) (i j : ℕ) :
    (bits ws j).getD i false = (ws.getD i 0).getLsbD j := by
  simp only [bits, List.getD_eq_getElem?_getD, List.getElem?_map]
  cases h : ws[i]? with
  | none => simp
  | some w => simp

theorem wordOp_bits (op : GateOp) (as : List Word16) (j : ℕ) (hj : j < 16)
    (h : Allowed op) (hlen : as.length ≤ 2) :
    (wordOp op as).getLsbD j = op.eval (bits as j) := by
  have hz : (0 : Word16).getLsbD j = false := BitVec.getLsbD_zero
  rcases h with rfl | rfl <;>
    cases as with
    | nil =>
      simp only [wordOp, GateOp.eval, bits, List.map_nil, List.all_nil,
        List.any_nil, BitVec.getLsbD_allOnes, hj, decide_true, hz]
    | cons a rest =>
      cases rest with
      | nil =>
        simp only [wordOp, GateOp.eval, bits, List.map_cons, List.map_nil,
          List.all_cons, List.all_nil, List.any_cons, List.any_nil,
          Bool.and_true, Bool.or_false, id_eq]
      | cons b rest2 =>
        cases rest2 with
        | nil =>
          simp only [wordOp, GateOp.eval, bits, List.map_cons, List.map_nil,
            List.all_cons, List.all_nil, List.any_cons, List.any_nil,
            Bool.and_true, Bool.or_false, BitVec.getLsbD_and, BitVec.getLsbD_or, id_eq]
        | cons c rest3 => simp at hlen

theorem wordStep_bits (ws : List Word16) (g : Gate) (j : ℕ) (hj : j < 16)
    (h : Allowed g.op) (hlen : g.inputs.length ≤ 2) :
    (wordStep ws g).getLsbD j = g.op.eval (g.inputs.map fun i => (bits ws j).getD i false) := by
  unfold wordStep
  rw [wordOp_bits g.op _ j hj h (by simpa using hlen)]
  congr 1
  simp only [bits, List.map_map]
  refine List.map_congr_left fun i _ => ?_
  simpa [bits] using (bits_get ws i j).symm

theorem wordRun_bits (ws : List Word16) (gs : List Gate) (j : ℕ) (hj : j < 16)
    (hok : ∀ g ∈ gs, Allowed g.op ∧ g.inputs.length ≤ 2) :
    bits (wordRun ws gs) j = gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) (bits ws j) := by
  induction gs generalizing ws with
  | nil => rfl
  | cons g gs ih =>
    have hg := hok g List.mem_cons_self
    have hrest : ∀ g' ∈ gs, Allowed g'.op ∧ g'.inputs.length ≤ 2 :=
      fun g' hg' => hok g' (List.mem_cons_of_mem g hg')
    simp only [wordRun, List.foldl_cons]
    rw [ih (ws ++ [wordStep ws g]) hrest]
    congr 1
    simp only [bits, List.map_append, List.map_cons, List.map_nil]
    rw [wordStep_bits ws g j hj hg.1 hg.2]
    rfl

def Next (w : List Word16) (z : Word16) : Prop :=
  ∃ a ∈ w, ∃ b ∈ w, z = a &&& b ∨ z = a ||| b

def Reach : List Word16 → ℕ → Word16 → Prop
  | w, 0, t => t ∈ w
  | w, k + 1, t => t ∈ w ∨ ∃ z, z ∉ w ∧ z ≠ 0 ∧ z ≠ BitVec.allOnes 16 ∧ Next w z ∧ Reach (z :: w) k t

theorem reach_mono {w : List Word16} {k : ℕ} {t : Word16} (h : Reach w k t) : Reach w (k + 1) t := by
  induction k generalizing w with
  | zero => exact Or.inl h
  | succ k ih =>
    rcases h with ht | ⟨z, h1, h2, h3, h4, hr⟩
    · exact Or.inl ht
    · exact Or.inr ⟨z, h1, h2, h3, h4, ih hr⟩

theorem known_get {w ws : List Word16} (h : ∀ a ∈ ws, Known w a) (i : ℕ) : Known w (ws.getD i 0) := by
  rw [List.getD_eq_getElem?_getD]
  cases hi : ws[i]? with
  | none => exact Or.inl rfl
  | some a => exact h a (List.mem_of_getElem? hi)

theorem wordOp_next (w : List Word16) (op : GateOp) (as : List Word16)
    (ha : ∀ a ∈ as, Known w a) (hok : Allowed op) :
    Known w (wordOp op as) ∨ Next w (wordOp op as) := by
  have hand : ∀ a b, Known w a → Known w b → Known w (a &&& b) ∨ Next w (a &&& b) := by
    intro a b ha' hb'
    rcases ha' with rfl | rfl | hma
    · exact Or.inl (Or.inl BitVec.zero_and)
    · rw [BitVec.allOnes_and]; exact Or.inl hb'
    · rcases hb' with rfl | rfl | hmb
      · exact Or.inl (Or.inl BitVec.and_zero)
      · rw [BitVec.and_allOnes]; exact Or.inl (Or.inr (Or.inr hma))
      · exact Or.inr (⟨a, hma, b, hmb, Or.inl rfl⟩)
  have hor : ∀ a b, Known w a → Known w b → Known w (a ||| b) ∨ Next w (a ||| b) := by
    intro a b ha' hb'
    rcases ha' with rfl | rfl | hma
    · rw [show (0 : Word16) ||| b = b from BitVec.zero_or]; exact Or.inl hb'
    · exact Or.inl (Or.inr (Or.inl (BitVec.allOnes_or)))
    · rcases hb' with rfl | rfl | hmb
      · rw [show a ||| (0 : Word16) = a from BitVec.or_zero]; exact Or.inl (Or.inr (Or.inr hma))
      · exact Or.inl (Or.inr (Or.inl (BitVec.or_allOnes)))
      · exact Or.inr (⟨a, hma, b, hmb, Or.inr rfl⟩)

  rcases hok with rfl | rfl <;> cases as with
  | nil =>
    first | exact Or.inl (Or.inr (Or.inl rfl)) | exact Or.inl (Or.inl rfl)
  | cons a rest =>
    cases rest with
    | nil =>
      exact Or.inl (ha a List.mem_cons_self)
    | cons b rest2 =>
      first
      | exact hand a b (ha a List.mem_cons_self) (ha b (List.mem_cons_of_mem _ List.mem_cons_self))
      | exact hor a b (ha a List.mem_cons_self) (ha b (List.mem_cons_of_mem _ List.mem_cons_self))

theorem reachable (w ws : List Word16) (gs : List Gate) (k o : ℕ) (t : Word16)
    (hk : gs.length ≤ k) (hknown : ∀ a ∈ ws, Known w a)
    (hok : ∀ g ∈ gs, Allowed g.op) (h0 : t ≠ 0) (h1 : t ≠ BitVec.allOnes 16)
    (ht : (wordRun ws gs).getD o 0 = t) : Reach w k t := by
  induction gs generalizing ws w k with
  | nil =>
    change ws.getD o 0 = t at ht
    have h := known_get hknown o
    rw [ht] at h
    have hm := (h.resolve_left h0).resolve_left h1
    induction k with
    | zero => exact hm
    | succ k _ => exact Or.inl hm
  | cons g gs ih =>
    let z := wordStep ws g
    change (wordRun (ws ++ [z]) gs).getD o 0 = t at ht
    have hrest := fun g' (hg' : g' ∈ gs) => hok g' (List.mem_cons_of_mem g hg')
    cases k with
    | zero => simp at hk
    | succ k =>
      have hlen : gs.length ≤ k := by simpa using hk
      by_cases h : Known w z
      · apply reach_mono
        apply ih w (ws ++ [z]) k hlen _ hrest ht
        intro a ha
        simp only [List.mem_append, List.mem_singleton] at ha
        rcases ha with ha | rfl
        · exact hknown a ha
        · exact h
      · have hz : Known w z ∨ Next w z :=
          wordOp_next w g.op _ (fun a ha => by
            obtain ⟨i, _, rfl⟩ := List.mem_map.mp ha
            exact known_get hknown i) (hok g List.mem_cons_self)
        refine Or.inr ⟨z, fun hm => h (Or.inr (Or.inr hm)), fun hz0 => h (Or.inl hz0),
          fun hz1 => h (Or.inr (Or.inl hz1)), hz.resolve_left h, ?_⟩
        apply ih (z :: w) (ws ++ [z]) k hlen _ hrest ht
        intro a ha
        simp only [List.mem_append, List.mem_singleton] at ha
        rcases ha with ha | rfl
        · rcases hknown a ha with h0' | h1' | hm
          · exact Or.inl h0'
          · exact Or.inr (Or.inl h1')
          · exact Or.inr (Or.inr (List.mem_cons_of_mem z hm))
        · exact Or.inr (Or.inr List.mem_cons_self)

def inputCols : List Word16 := [0xaaaa, 0xcccc, 0xf0f0, 0xff00, 0x5555, 0x3333, 0x0f0f, 0x00ff]

def row4 (j : ℕ) (i : Fin 4) : Bool := (inputCols.getD i.val 0).getLsbD j

theorem table_reach {f : (Fin 4 → Bool) → Bool} {k : ℕ} {t : Word16}
    (hf : HasLitSize 4 f k) (h0 : t ≠ 0) (h1 : t ≠ BitVec.allOnes 16)
    (hb : ∀ j : Fin 16, f (row4 j.val) = t.getLsbD j.val) : Reach inputCols k t := by
  obtain ⟨C, hok, hs, hev⟩ := hf
  have hok' : ∀ g ∈ C.gates, Allowed g.op ∧ g.inputs.length ≤ 2 :=
    fun g hg => by have h1 := hok g hg; simpa [Allowed] using h1
  refine reachable inputCols inputCols C.gates k C.output t hs ?_ (fun g hg => (hok' g hg).1) h0 h1 ?_
  · intro a ha; exact Or.inr (Or.inr ha)
  · apply BitVec.eq_of_getLsbD_eq
    intro j hj
    rw [← bits_get, wordRun_bits _ _ _ hj hok']
    have hinput_all : ∀ q : Fin 16, bits inputCols q.val = List.ofFn (row4 q.val) ++ List.ofFn (fun i => !(row4 q.val i)) := by decide +kernel
    have hinput := hinput_all ⟨j, hj⟩
    rw [hinput]
    exact (hev (row4 j)).trans (hb ⟨j, hj⟩)

noncomputable section

def negLit (l : Nat) : Nat :=
  match Nat.beq (Nat.mod l (nat_lit 2)) (nat_lit 0) with
  | true => Nat.add l (nat_lit 1)
  | false => Nat.sub l (nat_lit 1)

def bitAt (T l : Nat) : Bool := Nat.beq (Nat.land (Nat.shiftRight T l) (nat_lit 1)) (nat_lit 1)

def setBitAt (T u : Nat) : Nat := Nat.lor T (Nat.shiftLeft (nat_lit 1) u)

theorem bitAt_eq_testBit (T l : Nat) : bitAt T l = T.testBit l := by
  have h : Nat.land (Nat.shiftRight T l) 1 = (T >>> l) % 2 := Nat.and_one_is_mod _
  unfold bitAt
  rw [h, Nat.testBit_eq_decide_div_mod_eq, Nat.shiftRight_eq_div_pow, Bool.eq_iff_iff,
    decide_eq_true_eq]
  exact ⟨Nat.eq_of_beq_eq_true, fun h => h ▸ Nat.beq_refl _⟩

theorem bitAt_setBitAt (T u l : Nat) : bitAt (setBitAt T u) l = (bitAt T l || decide (u = l)) := by
  have h : setBitAt T u = T ||| (1 <<< u) := rfl
  rw [h, bitAt_eq_testBit, bitAt_eq_testBit, Nat.testBit_or, Nat.one_shiftLeft, Nat.testBit_two_pow]

def litVal (a : Nat → Bool) (l : Nat) : Bool := a (l / 2) == (l % 2 == 0)

def ClauseSat (a : Nat → Bool) (c : List Nat) : Prop := ∃ l ∈ c, litVal a l = true

def FormulaSat (F : List (List Nat)) : Prop := ∃ a : Nat → Bool, ∀ c ∈ F, ClauseSat a c

theorem litVal_negLit (a : Nat → Bool) (l : Nat) : litVal a (negLit l) = !litVal a l := by
  have hn : negLit l = if l % 2 = 0 then l + 1 else l - 1 := by
    unfold negLit
    cases hb : Nat.beq (Nat.mod l 2) 0 with
    | false =>
      have h1 : ¬ (l % 2 = 0) := Nat.ne_of_beq_eq_false hb
      rw [ite_eq_right_of_eq_false _ _ (eq_false h1)]; rfl
    | true =>
      have h1 : l % 2 = 0 := Nat.eq_of_beq_eq_true hb
      rw [ite_eq_left_of_eq_true _ _ (eq_true h1)]
  rw [hn]
  unfold litVal
  by_cases h : l % 2 = 0
  · have h1 : (l + 1) / 2 = l / 2 := by omega
    have h2 : (l + 1) % 2 = 1 := by omega
    rw [ite_eq_left_of_eq_true _ _ (eq_true h), h1, h2, h]
    cases a (l / 2) <;> rfl
  · have h1 : (l - 1) / 2 = l / 2 := by omega
    have h2 : (l - 1) % 2 = 0 := by omega
    have h3 : l % 2 = 1 := by omega
    rw [ite_eq_right_of_eq_false _ _ (eq_false h), h1, h2, h3]
    cases a (l / 2) <;> rfl

inductive Trie where
  | nil : Trie
  | node (v : Option Nat) (l r : Trie) : Trie

def trieGet (t : Trie) : Nat → Option Nat :=
  Trie.rec (motive := fun _ => Nat → Option Nat) (fun _ => none)
    (fun v _ _ ihl ihr k =>
      Bool.rec
        (Bool.rec (ihr (Nat.sub (Nat.div k (nat_lit 2)) (nat_lit 1))) (ihl (Nat.div k (nat_lit 2)))
          (Nat.beq (Nat.mod k (nat_lit 2)) (nat_lit 1)))
        v (Nat.beq k (nat_lit 0))) t

def trieRoot (t : Trie) : Option Nat := Trie.rec (motive := fun _ => Option Nat) none (fun v _ _ _ _ => v) t
def trieLeft (t : Trie) : Trie := Trie.rec (motive := fun _ => Trie) .nil (fun _ l _ _ _ => l) t
def trieRight (t : Trie) : Trie := Trie.rec (motive := fun _ => Trie) .nil (fun _ _ r _ _ => r) t

def trieSet (fuel : Nat) : Trie → Nat → Option Nat → Trie :=
  Nat.rec (motive := fun _ => Trie → Nat → Option Nat → Trie) (fun t _ _ => t)
    (fun _ ih t k o =>
      Bool.rec
        (Bool.rec (.node (trieRoot t) (trieLeft t) (ih (trieRight t) (Nat.sub (Nat.div k (nat_lit 2)) (nat_lit 1)) o))
          (.node (trieRoot t) (ih (trieLeft t) (Nat.div k (nat_lit 2)) o) (trieRight t))
          (Nat.beq (Nat.mod k (nat_lit 2)) (nat_lit 1)))
        (.node o (trieLeft t) (trieRight t)) (Nat.beq k (nat_lit 0))) fuel

def TrieAll (P : Nat → Prop) : Trie → Prop
  | .nil => True
  | .node v l r => (∀ c, v = some c → P c) ∧ TrieAll P l ∧ TrieAll P r

theorem trieAll_get {P : Nat → Prop} :
    ∀ {t : Trie} {k : Nat} {c : Nat}, TrieAll P t → trieGet t k = some c → P c
  | .nil, _, _, _, h => by simp [trieGet] at h
  | .node v l r, k, c, ⟨hv, hl, hr⟩, h => by
    change Bool.rec (Bool.rec (trieGet r _) (trieGet l _) _) v _ = some c at h
    cases h0 : Nat.beq k 0
    · rw [h0] at h
      cases h1 : Nat.beq (Nat.mod k 2) 1
      · rw [h1] at h; exact trieAll_get hr h
      · rw [h1] at h; exact trieAll_get hl h
    · rw [h0] at h; exact hv c h

theorem trieAll_root {P : Nat → Prop} {t : Trie} (h : TrieAll P t) :
    ∀ c, trieRoot t = some c → P c := by
  cases t with
  | nil => intro c hc; cases hc
  | node v l r => exact h.1

theorem trieAll_left {P : Nat → Prop} {t : Trie} (h : TrieAll P t) : TrieAll P (trieLeft t) := by
  cases t with
  | nil => trivial
  | node v l r => exact h.2.1

theorem trieAll_right {P : Nat → Prop} {t : Trie} (h : TrieAll P t) : TrieAll P (trieRight t) := by
  cases t with
  | nil => trivial
  | node v l r => exact h.2.2

theorem trieAll_set {P : Nat → Prop} :
    ∀ (fuel : Nat) {t : Trie} (k : Nat) {o : Option Nat},
      TrieAll P t → (∀ c, o = some c → P c) → TrieAll P (trieSet fuel t k o)
  | 0, _, _, _, ht, _ => ht
  | fuel + 1, t, k, o, ht, ho => by
    change TrieAll P (Bool.rec (Bool.rec (.node (trieRoot t) (trieLeft t) (trieSet fuel (trieRight t) _ o))
      (.node (trieRoot t) (trieSet fuel (trieLeft t) _ o) (trieRight t)) _) (.node o (trieLeft t) (trieRight t)) _)
    cases h0 : Nat.beq k 0
    · cases h1 : Nat.beq (Nat.mod k 2) 1
      · exact ⟨trieAll_root ht, trieAll_left ht, trieAll_set fuel _ (trieAll_right ht) ho⟩
      · exact ⟨trieAll_root ht, trieAll_set fuel _ (trieAll_left ht) ho, trieAll_right ht⟩
    · exact ⟨ho, trieAll_left ht, trieAll_right ht⟩

theorem bitAt_land (x y l : Nat) : bitAt (Nat.land x y) l = (bitAt x l && bitAt y l) := by
  rw [bitAt_eq_testBit, bitAt_eq_testBit, bitAt_eq_testBit]
  exact Nat.testBit_and x y l

theorem bitAt_xor (x y l : Nat) : bitAt (Nat.xor x y) l = (bitAt x l ^^ bitAt y l) := by
  rw [bitAt_eq_testBit, bitAt_eq_testBit, bitAt_eq_testBit]
  exact Nat.testBit_xor x y l

theorem bitAt_zero (l : Nat) : bitAt 0 l = false := by
  rw [bitAt_eq_testBit]; exact Nat.zero_testBit l

theorem bitAt_pow (u l : Nat) : bitAt (Nat.shiftLeft 1 u) l = decide (u = l) := by
  have h : Nat.shiftLeft 1 u = 1 <<< u := rfl
  rw [bitAt_eq_testBit, h, Nat.one_shiftLeft, Nat.testBit_two_pow]

def clMask : List Nat → Nat
  | [] => 0
  | l :: ls => setBitAt (clMask ls) l

theorem bitAt_clMask : ∀ (c : List Nat) (l : Nat), bitAt (clMask c) l = true ↔ l ∈ c
  | [], l => by simp [clMask, bitAt_zero]
  | x :: xs, l => by
    rw [clMask, bitAt_setBitAt, Bool.or_eq_true, bitAt_clMask xs l, decide_eq_true_eq, List.mem_cons]
    exact ⟨fun h => h.elim Or.inr (fun h => Or.inl h.symm),
      fun h => h.elim (fun h => Or.inr h.symm) Or.inl⟩

abbrev Cont := Trie → Nat → Bool → Nat → Nat → Nat → Bool

def stepRead (k : Cont) (db : Trie) (id C F P x : Nat) : Bool :=
  Bool.rec
    (Bool.rec (k db id false (setBitAt C x) F P) (k db id true C C 0) (Nat.beq x (nat_lit 0)))
    (k db (Nat.succ x) false C F P)
    (Nat.beq id (nat_lit 0))

def stepUnit (k : Cont) (db : Trie) (id C F P x : Nat) : Bool :=
  Bool.rec false (k db id true C (setBitAt F (negLit x)) 0) (Nat.beq P (Nat.shiftLeft (nat_lit 1) x))

def stepClause (k : Cont) (db : Trie) (id C F D : Nat) : Bool :=
  Bool.rec (k db id true C F (Nat.xor D (Nat.land D F)))
    (Bool.rec (k (trieSet 64 db (Nat.sub id (nat_lit 1)) (some C)) 0 false 0 0 0) true
      (Nat.beq C (nat_lit 0)))
    (Nat.beq (Nat.xor D (Nat.land D F)) (nat_lit 0))

def stepHint (k : Cont) (db : Trie) (id C F x : Nat) : Bool :=
  Option.rec false (stepClause k db id C F) (trieGet db x)

def tokenStep (k : Cont) (x : Nat) : Cont := fun db id mode C F P =>
  Bool.rec (stepRead k db id C F P x)
    (Bool.rec (stepUnit k db id C F P x) (stepHint k db id C F x) (Nat.beq P (nat_lit 0)))
    mode

def stop : Cont := fun _ _ _ _ _ _ => false

def runWord (W M fuel w : Nat) (k : Cont) : Cont :=
  Nat.rec (motive := fun _ => Nat → Cont) (fun _ => k)
    (fun _ ih w =>
      Bool.rec (tokenStep (ih (Nat.shiftRight w W)) (Nat.land w M)) k (Nat.beq w (nat_lit 1)))
    fuel w

def fuelW : Nat := 1024

def runW (e : Cont) (W : Nat) (words : List Nat) : Cont :=
  List.rec (motive := fun _ => Cont) e
    (fun w _ k => runWord W (Nat.sub (Nat.shiftLeft (nat_lit 1) W) (nat_lit 1)) fuelW w k) words

def loadF : List (List Nat) → List Nat → Trie → Trie
  | [], _, t => t
  | _ :: _, [], t => t
  | c :: cs, q :: qs, t =>
    loadF cs qs (Bool.rec (trieSet 64 t (Nat.sub q 1) (some (clMask c))) t (Nat.beq q 0))

def unpackWord (W M fuel w : Nat) (rest : List Nat) : List Nat :=
  Nat.rec (motive := fun _ => Nat → List Nat) (fun _ => rest)
    (fun _ ih w => Bool.rec (Nat.land w M :: ih (Nat.shiftRight w W)) rest (Nat.beq w (nat_lit 1)))
    fuel w

def unpack (W : Nat) (words : List Nat) : List Nat :=
  List.rec (motive := fun _ => List Nat) []
    (fun w _ ih => unpackWord W (Nat.sub (Nat.shiftLeft (nat_lit 1) W) (nat_lit 1)) 1024 w ih)
    words

def checkW (F : List (List Nat)) (fk : List Nat) (W : Nat) (words : List Nat) : Bool :=
  runW stop W words (loadF F fk .nil) 0 false 0 0 0

def MaskSat (a : Nat → Bool) (m : Nat) : Prop := ∃ l, bitAt m l = true ∧ litVal a l = true

def BitsFalse (a : Nat → Bool) (F : Nat) : Prop := ∀ l, bitAt F l = true → litVal a l = false

def HintInv (a : Nat → Bool) (C F P : Nat) : Prop :=
  (∀ x, bitAt C x = true → litVal a x = false) →
    BitsFalse a F ∧ (P = 0 ∨ ∃ w, bitAt P w = true ∧ litVal a w = true)

theorem witness_U (a : Nat → Bool) {F D : Nat} (hF : BitsFalse a F) (hD : MaskSat a D) :
    ∃ w, bitAt (Nat.xor D (Nat.land D F)) w = true ∧ litVal a w = true := by
  obtain ⟨w, hwD, hwv⟩ := hD
  have hwF : bitAt F w = false := by
    cases hb : bitAt F w
    · rfl
    · rw [hF w hb] at hwv; exact absurd hwv (by simp)
  exact ⟨w, by rw [bitAt_xor, bitAt_land, hwD, hwF]; rfl, hwv⟩

def Good (a : Nat → Bool) (Q : Prop) (k : Cont) : Prop :=
  ∀ db id mode C F P, TrieAll (MaskSat a) db → (mode = true → HintInv a C F P) →
    k db id mode C F P = true → Q

theorem stop_good (a : Nat → Bool) (Q : Prop) : Good a Q stop := by
  intro _ _ _ _ _ _ _ _ h
  exact absurd h (by simp [stop])

theorem tokenStep_good (a : Nat → Bool) {Q : Prop} {k : Cont} (hk : Good a Q k) (x : Nat) :
    Good a Q (tokenStep k x) := by
  intro db id mode C F P hdb hinv h
  change Bool.rec (stepRead k db id C F P x)
    (Bool.rec (stepUnit k db id C F P x) (stepHint k db id C F x) (Nat.beq P 0)) mode = true at h
  cases mode with
  | false =>
    change Bool.rec
      (Bool.rec (k db id false (setBitAt C x) F P) (k db id true C C 0) (Nat.beq x 0))
      (k db (Nat.succ x) false C F P) (Nat.beq id 0) = true at h
    cases hi : Nat.beq id 0
    · rw [hi] at h
      cases hx : Nat.beq x 0
      · rw [hx] at h
        exact hk db id false _ F P hdb (by simp) h
      · rw [hx] at h
        exact hk db id true C C 0 hdb (fun _ hC => ⟨hC, Or.inl rfl⟩) h
    · rw [hi] at h
      exact hk db _ false C F P hdb (by simp) h
  | true =>
    have hinv := hinv rfl
    cases hP : Nat.beq P 0
    · rw [hP] at h
      change Bool.rec false (k db id true C (setBitAt F (negLit x)) 0)
        (Nat.beq P (Nat.shiftLeft 1 x)) = true at h
      cases hu : Nat.beq P (Nat.shiftLeft 1 x)
      · rw [hu] at h; exact absurd h (by simp)
      · rw [hu] at h
        refine hk db id true C _ 0 hdb (fun _ hC => ⟨?_, Or.inl rfl⟩) h
        obtain ⟨hF, hPw⟩ := hinv hC
        rcases hPw with hP0 | ⟨w, hw, hwv⟩
        · rw [hP0] at hP; exact absurd hP (by simp)
        · rw [Nat.eq_of_beq_eq_true hu, bitAt_pow, decide_eq_true_eq] at hw
          subst hw
          intro l hl
          rw [bitAt_setBitAt, Bool.or_eq_true, decide_eq_true_eq] at hl
          rcases hl with hl | rfl
          · exact hF l hl
          · rw [litVal_negLit, hwv]; rfl
    · rw [hP] at h
      change Option.rec false (stepClause k db id C F) (trieGet db x) = true at h
      cases hg : trieGet db x with
      | none => rw [hg] at h; exact absurd h (by simp)
      | some D =>
        rw [hg] at h
        have hD : MaskSat a D := trieAll_get hdb hg
        change Bool.rec (k db id true C F (Nat.xor D (Nat.land D F)))
          (Bool.rec (k (trieSet 64 db (Nat.sub id 1) (some C)) 0 false 0 0 0) true
            (Nat.beq C 0))
          (Nat.beq (Nat.xor D (Nat.land D F)) 0) = true at h
        cases hU : Nat.beq (Nat.xor D (Nat.land D F)) 0
        · rw [hU] at h
          refine hk db id true C F _ hdb (fun _ hC => ⟨(hinv hC).1, Or.inr ?_⟩) h
          exact witness_U a (hinv hC).1 hD
        · rw [hU] at h
          have hCsat : MaskSat a C := by
            apply Classical.byContradiction
            intro hn
            have hC : ∀ y, bitAt C y = true → litVal a y = false := by
              intro y hy
              cases hv : litVal a y
              · rfl
              · exact absurd ⟨y, hy, hv⟩ hn
            obtain ⟨w, hw, _⟩ := witness_U a (hinv hC).1 hD
            rw [Nat.eq_of_beq_eq_true hU, bitAt_zero] at hw
            exact absurd hw (by simp)
          cases hC0 : Nat.beq C 0
          · rw [hC0] at h
            exact hk _ _ false 0 0 0
              (trieAll_set 64 _ hdb (fun c hc => by cases hc; exact hCsat)) (by simp) h
          · obtain ⟨w, hw, _⟩ := hCsat
            rw [Nat.eq_of_beq_eq_true hC0, bitAt_zero] at hw
            exact absurd hw (by simp)

theorem runWord_good (a : Nat → Bool) {Q : Prop} (W M : Nat) {k : Cont} (hk : Good a Q k) :
    ∀ fuel w, Good a Q (runWord W M fuel w k)
  | 0, _ => hk
  | fuel + 1, w => by
    change Good a Q (Bool.rec (tokenStep (runWord W M fuel (Nat.shiftRight w W) k)
      (Nat.land w M)) k (Nat.beq w 1))
    cases Nat.beq w 1
    · exact tokenStep_good a (runWord_good a W M hk fuel _) _
    · exact hk

theorem runW_good (a : Nat → Bool) {Q : Prop} {e : Cont} (he : Good a Q e) (W : Nat) :
    ∀ words : List Nat, Good a Q (runW e W words)
  | [] => he
  | w :: ws => runWord_good a W (Nat.sub (Nat.shiftLeft 1 W) 1) (runW_good a he W ws) fuelW w

theorem maskSat_of_clauseSat (a : Nat → Bool) {c : List Nat} (h : ClauseSat a c) : MaskSat a (clMask c) := by
  obtain ⟨l, hl, hv⟩ := h
  exact ⟨l, (bitAt_clMask c l).mpr hl, hv⟩

theorem loadF_all (a : Nat → Bool) : ∀ (F : List (List Nat)) (fk : List Nat) {t : Trie},
    TrieAll (MaskSat a) t → (∀ c ∈ F, ClauseSat a c) → TrieAll (MaskSat a) (loadF F fk t)
  | [], _, _, ht, _ => ht
  | _ :: _, [], _, ht, _ => ht
  | c :: cs, q :: qs, t, ht, hF => by
    unfold loadF
    apply loadF_all a cs qs _ (fun c' hc' => hF c' (List.mem_cons_of_mem _ hc'))
    cases Nat.beq q 0
    · exact trieAll_set 64 _ ht (fun c' hc' => by
        cases hc'; exact maskSat_of_clauseSat a (hF c List.mem_cons_self))
    · exact ht

theorem checkW_sound (F : List (List Nat)) (fk : List Nat) (W : Nat) (words : List Nat)
    (h : checkW F fk W words = true) : ¬ FormulaSat F := by
  rintro ⟨a, ha⟩
  exact runW_good a (stop_good a False) W words _ _ false 0 0 0
    (loadF_all a F fk (t := .nil) trivial ha) (by simp) h

end

def N_in : ℕ := 8
def K_c : ℕ := 5
def W_c : ℕ := 13
def base1 : ℕ := 209
def base2 : ℕ := 219
def base3 : ℕ := 379

def posL (v : ℕ) : ℕ := 2 * v
def negL (v : ℕ) : ℕ := 2 * v + 1

theorem litVal_posL (a : Nat → Bool) (v : ℕ) : litVal a (posL v) = a v := by
  unfold litVal posL
  have h1 : 2 * v / 2 = v := by omega
  have h2 : 2 * v % 2 = 0 := by omega
  rw [h1, h2]; cases a v <;> rfl

theorem litVal_negL (a : Nat → Bool) (v : ℕ) : litVal a (negL v) = !a v := by
  unfold litVal negL
  have h1 : (2 * v + 1) / 2 = v := by omega
  have h2 : (2 * v + 1) % 2 = 1 := by omega
  rw [h1, h2]; cases a v <;> rfl

def vVal (w p : ℕ) : ℕ := 1 + w * 16 + p
def vPad (g : ℕ) : ℕ := base1 + g
def vOr (g : ℕ) : ℕ := base1 + K_c + g

def vA (g p : ℕ) : ℕ := base2 + g * 16 + p
def vB (g p : ℕ) : ℕ := base2 + 16 * K_c + g * 16 + p
def vSelA (g i : ℕ) : ℕ := base3 + g * W_c + i
def vSelB (g i : ℕ) : ℕ := base3 + K_c * W_c + g * W_c + i

def targetWord : Word16 := BitVec.ofNat 16 283

def targetFn (x : Fin 4 → Bool) : Bool :=
  (283 : ℕ).testBit (tableIndex x)

def encGate (g : ℕ) : List (List ℕ) :=
  let w := N_in + g
  [ (List.range w).map (fun i => posL (vSelA g i)),
    (List.range w).map (fun i => posL (vSelB g i)) ] ++
  ((List.range w).flatMap fun i =>
    (List.range (w - (i + 1))).flatMap fun d =>
      [ [negL (vSelA g i), negL (vSelA g (i + 1 + d))],
        [negL (vSelB g i), negL (vSelB g (i + 1 + d))] ]) ++
  [ [negL (vPad g), posL (vSelA g 0)],
    [negL (vPad g), posL (vSelB g 0)],
    [negL (vPad g), negL (vOr g)] ] ++
  ((List.range w).flatMap fun i =>
    (List.range (i + 1)).map fun j => [posL (vPad g), negL (vSelA g i), negL (vSelB g j)]) ++
  
  ((List.range g).flatMap fun gp =>
    [ [negL (vPad gp), negL (vSelA g (N_in + gp))],
      [negL (vPad gp), negL (vSelB g (N_in + gp))] ]) ++
  ((List.range w).flatMap fun i =>
    (List.range 16).flatMap fun p =>
      [ [negL (vSelA g i), negL (vVal i p), posL (vA g p)],
        [negL (vSelA g i), posL (vVal i p), negL (vA g p)],
        [negL (vSelB g i), negL (vVal i p), posL (vB g p)],
        [negL (vSelB g i), posL (vVal i p), negL (vB g p)] ]) ++
  ((List.range 16).flatMap fun p =>
      [ [negL (vOr g), negL (vA g p), posL (vVal w p)],
        [negL (vOr g), negL (vB g p), posL (vVal w p)],
        [negL (vOr g), posL (vA g p), posL (vB g p), negL (vVal w p)],
        [posL (vOr g), negL (vA g p), negL (vB g p), posL (vVal w p)],
        [posL (vOr g), posL (vA g p), negL (vVal w p)],
        [posL (vOr g), posL (vB g p), negL (vVal w p)] ])

def encForm : List (List ℕ) :=
  ((List.range N_in).flatMap fun w =>
    (List.range 16).map fun p =>
      [if (inputCols.getD w 0).getLsbD p then posL (vVal w p) else negL (vVal w p)]) ++
  ((List.range 16).map fun p =>
    [if targetWord.getLsbD p then posL (vVal (W_c - 1) p) else negL (vVal (W_c - 1) p)]) ++
  [[negL (vPad (K_c - 1))]] ++
  ((List.range (K_c - 1)).map fun d => [negL (vPad (d + 1)), posL (vPad d)]) ++
  ((List.range K_c).flatMap encGate) ++
  ((List.range (K_c - 1)).map fun g =>
    posL (vPad g) :: ((List.range (K_c - (g + 1))).flatMap fun d =>
      [posL (vSelA (g + 1 + d) (N_in + g)), posL (vSelB (g + 1 + d) (N_in + g))]))

structure EncModel where
  wVal : ℕ → Word16
  pad : ℕ → Bool
  opOr : ℕ → Bool
  sA : ℕ → ℕ
  sB : ℕ → ℕ
  inp : ∀ i < N_in, wVal i = inputCols.getD i 0
  out : wVal (W_c - 1) = targetWord
  pad_last : pad (K_c - 1) = false
  pad_pref : ∀ g < K_c - 1, pad (g + 1) = true → pad g = true
  sA_lt : ∀ g < K_c, sA g < N_in + g
  sB_lt : ∀ g < K_c, sB g < N_in + g
  no_read_pad : ∀ g gp, g < K_c → gp < g → pad gp = true → sA g ≠ N_in + gp ∧ sB g ≠ N_in + gp
  uses : ∀ g < K_c - 1, pad g = false → ∃ g2, g < g2 ∧ g2 < K_c ∧ (sA g2 = N_in + g ∨ sB g2 = N_in + g)
  op_ok : ∀ g < K_c,
    (pad g = true → sA g = 0 ∧ sB g = 0 ∧ opOr g = false) ∧
    (pad g = false → sA g < sB g) ∧
    (opOr g = true → wVal (N_in + g) = wVal (sA g) ||| wVal (sB g)) ∧
    (opOr g = false → wVal (N_in + g) = wVal (sA g) &&& wVal (sB g))

def assignOf (M : EncModel) (v : ℕ) : Bool :=
  if v < 1 then false
  else if v < base1 then (M.wVal ((v - 1) / 16)).getLsbD ((v - 1) % 16)
  else if v < base1 + K_c then M.pad (v - base1)
  else if v < base2 then M.opOr (v - (base1 + K_c))
  else if v < base2 + 16 * K_c then (M.wVal (M.sA ((v - base2) / 16))).getLsbD ((v - base2) % 16)
  else if v < base3 then (M.wVal (M.sB ((v - (base2 + 16 * K_c)) / 16))).getLsbD ((v - (base2 + 16 * K_c)) % 16)
  else if v < base3 + K_c * W_c then decide (M.sA ((v - base3) / W_c) = (v - base3) % W_c)
  else decide (M.sB ((v - (base3 + K_c * W_c)) / W_c) = (v - (base3 + K_c * W_c)) % W_c)

theorem assign_vVal (M : EncModel) (w p : ℕ) (hw : w < W_c) (hp : p < 16) :
    assignOf M (vVal w p) = (M.wVal w).getLsbD p := by
  unfold assignOf vVal
  have h1 : ¬ (1 + w * 16 + p < 1) := by omega
  have h2 : 1 + w * 16 + p < base1 := by unfold base1 W_c at *; omega
  have h3 : (1 + w * 16 + p - 1) / 16 = w := by omega
  have h4 : (1 + w * 16 + p - 1) % 16 = p := by omega
  simp [h1, h2, h3, h4]

theorem assign_vPad (M : EncModel) (g : ℕ) (hg : g < K_c) :
    assignOf M (vPad g) = M.pad g := by
  unfold assignOf vPad
  have h1 : ¬ (base1 + g < 1) := by unfold base1; omega
  have h2 : ¬ (base1 + g < base1) := by omega
  have h3 : base1 + g < base1 + K_c := by omega
  simp [h1, h2, h3]

theorem assign_vOr (M : EncModel) (g : ℕ) (hg : g < K_c) :
    assignOf M (vOr g) = M.opOr g := by
  unfold assignOf vOr
  have h1 : ¬ (base1 + K_c + g < 1) := by unfold base1; omega
  have h2 : ¬ (base1 + K_c + g < base1) := by omega
  have h3 : ¬ (base1 + K_c + g < base1 + K_c) := by omega
  have h4 : base1 + K_c + g < base2 := by unfold base1 base2 K_c at *; omega
  simp [h1, h2, h3, h4]



theorem assign_vA (M : EncModel) (g p : ℕ) (hg : g < K_c) (hp : p < 16) :
    assignOf M (vA g p) = (M.wVal (M.sA g)).getLsbD p := by
  unfold assignOf vA
  have h1 : ¬ (base2 + g * 16 + p < 1) := by unfold base2; omega
  have h2 : ¬ (base2 + g * 16 + p < base1) := by unfold base1 base2; omega
  have h3 : ¬ (base2 + g * 16 + p < base1 + K_c) := by unfold base1 base2 K_c; omega
  
  have h4 : ¬ (base2 + g * 16 + p < base2) := by omega
  have h5 : base2 + g * 16 + p < base2 + 16 * K_c := by omega
  have h6 : (base2 + g * 16 + p - base2) / 16 = g := by omega
  have h7 : (base2 + g * 16 + p - base2) % 16 = p := by omega
  simp [h1, h2, h3, h4, h5, h6, h7]

theorem assign_vB (M : EncModel) (g p : ℕ) (hg : g < K_c) (hp : p < 16) :
    assignOf M (vB g p) = (M.wVal (M.sB g)).getLsbD p := by
  unfold assignOf vB
  have h1 : ¬ (base2 + 16 * K_c + g * 16 + p < 1) := by unfold base2; omega
  have h2 : ¬ (base2 + 16 * K_c + g * 16 + p < base1) := by unfold base1 base2; omega
  have h3 : ¬ (base2 + 16 * K_c + g * 16 + p < base1 + K_c) := by unfold base1 base2 K_c; omega
  
  have h4 : ¬ (base2 + 16 * K_c + g * 16 + p < base2) := by omega
  have h5 : ¬ (base2 + 16 * K_c + g * 16 + p < base2 + 16 * K_c) := by omega
  have h6 : base2 + 16 * K_c + g * 16 + p < base3 := by unfold base2 base3 K_c at *; omega
  have h7 : (base2 + 16 * K_c + g * 16 + p - (base2 + 16 * K_c)) / 16 = g := by omega
  have h8 : (base2 + 16 * K_c + g * 16 + p - (base2 + 16 * K_c)) % 16 = p := by omega
  simp [h1, h2, h3, h4, h5, h6, h7, h8]

theorem assign_vSelA (M : EncModel) (g i : ℕ) (hg : g < K_c) (hi : i < W_c) :
    assignOf M (vSelA g i) = decide (M.sA g = i) := by
  unfold assignOf vSelA
  have h1 : ¬ (base3 + g * W_c + i < 1) := by unfold base3; omega
  have h2 : ¬ (base3 + g * W_c + i < base1) := by unfold base1 base3; omega
  have h3 : ¬ (base3 + g * W_c + i < base1 + K_c) := by unfold base1 base3 K_c; omega
  
  have h4 : ¬ (base3 + g * W_c + i < base2) := by unfold base2 base3; omega
  have h5 : ¬ (base3 + g * W_c + i < base2 + 16 * K_c) := by unfold base2 base3 K_c; omega
  have h6 : ¬ (base3 + g * W_c + i < base3) := by omega
  have h7 : base3 + g * W_c + i < base3 + K_c * W_c := by
    have : (g + 1) * W_c ≤ K_c * W_c := Nat.mul_le_mul_right W_c (by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; omega
  have h8 : (base3 + g * W_c + i - base3) / W_c = g := by
    have : base3 + g * W_c + i - base3 = i + W_c * g := by ring_nf; omega
    rw [this, Nat.add_mul_div_left _ _ (by unfold W_c; omega), Nat.div_eq_of_lt hi, Nat.zero_add]
  have h9 : (base3 + g * W_c + i - base3) % W_c = i := by
    have : base3 + g * W_c + i - base3 = i + W_c * g := by ring_nf; omega
    rw [this, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi]
  simp [h1, h2, h3, h4, h5, h6, h7, h8, h9]

theorem assign_vSelB (M : EncModel) (g i : ℕ) (_hg : g < K_c) (hi : i < W_c) :
    assignOf M (vSelB g i) = decide (M.sB g = i) := by
  unfold assignOf vSelB
  have h1 : ¬ (base3 + K_c * W_c + g * W_c + i < 1) := by unfold base3; omega
  have h2 : ¬ (base3 + K_c * W_c + g * W_c + i < base1) := by unfold base1 base3; omega
  have h3 : ¬ (base3 + K_c * W_c + g * W_c + i < base1 + K_c) := by unfold base1 base3 K_c; omega
  
  have h4 : ¬ (base3 + K_c * W_c + g * W_c + i < base2) := by unfold base2 base3; omega
  have h5 : ¬ (base3 + K_c * W_c + g * W_c + i < base2 + 16 * K_c) := by unfold base2 base3 K_c; omega
  have h6 : ¬ (base3 + K_c * W_c + g * W_c + i < base3) := by omega
  have h7 : ¬ (base3 + K_c * W_c + g * W_c + i < base3 + K_c * W_c) := by omega
  have h8 : (base3 + K_c * W_c + g * W_c + i - (base3 + K_c * W_c)) / W_c = g := by
    have : base3 + K_c * W_c + g * W_c + i - (base3 + K_c * W_c) = i + W_c * g := by ring_nf; omega
    rw [this, Nat.add_mul_div_left _ _ (by unfold W_c; omega), Nat.div_eq_of_lt hi, Nat.zero_add]
  have h9 : (base3 + K_c * W_c + g * W_c + i - (base3 + K_c * W_c)) % W_c = i := by
    have : base3 + K_c * W_c + g * W_c + i - (base3 + K_c * W_c) = i + W_c * g := by ring_nf; omega
    rw [this, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hi]
  simp [h1, h2, h3, h4, h5, h6, h7, h8, h9]

theorem encGate_sat (M : EncModel) (g : ℕ) (hg : g < K_c) :
    ∀ c ∈ encGate g, ClauseSat (assignOf M) c := by
  intro c hc
  unfold encGate at hc
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hc
  have hW : N_in + g < W_c := by unfold N_in W_c K_c at *; omega
  rcases hc with (((((hc | hc) | hc) | hc) | hc) | hc) | hc
  · rcases hc with rfl | rfl
    · refine ⟨posL (vSelA g (M.sA g)), List.mem_map.mpr ⟨M.sA g, List.mem_range.mpr (M.sA_lt g hg), rfl⟩, ?_⟩
      simp [litVal_posL, assign_vSelA M g (M.sA g) hg (by have := M.sA_lt g hg; omega)]
    · refine ⟨posL (vSelB g (M.sB g)), List.mem_map.mpr ⟨M.sB g, List.mem_range.mpr (M.sB_lt g hg), rfl⟩, ?_⟩
      simp [litVal_posL, assign_vSelB M g (M.sB g) hg (by have := M.sB_lt g hg; omega)]
  · rcases List.mem_flatMap.mp hc with ⟨i, hi, hc⟩
    rcases List.mem_flatMap.mp hc with ⟨d, hd, hc⟩
    rw [List.mem_range] at hi hd
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl
    · by_cases h1 : M.sA g = i
      · exact ⟨negL (vSelA g (i + 1 + d)), by simp, by simp [litVal_negL, assign_vSelA M g (i + 1 + d) hg (by omega), show M.sA g ≠ i + 1 + d by omega]⟩
      · exact ⟨negL (vSelA g i), by simp, by simp [litVal_negL, assign_vSelA M g i hg (by omega), h1]⟩
    · by_cases h1 : M.sB g = i
      · exact ⟨negL (vSelB g (i + 1 + d)), by simp, by simp [litVal_negL, assign_vSelB M g (i + 1 + d) hg (by omega), show M.sB g ≠ i + 1 + d by omega]⟩
      · exact ⟨negL (vSelB g i), by simp, by simp [litVal_negL, assign_vSelB M g i hg (by omega), h1]⟩
  · rcases hc with rfl | rfl | rfl
    · by_cases hp : M.pad g = true
      · exact ⟨posL (vSelA g 0), by simp, by simp [litVal_posL, assign_vSelA M g 0 hg (by omega), (M.op_ok g hg).1 hp]⟩
      · exact ⟨negL (vPad g), by simp, by simp [litVal_negL, assign_vPad M g hg, hp]⟩
    · by_cases hp : M.pad g = true
      · exact ⟨posL (vSelB g 0), by simp, by simp [litVal_posL, assign_vSelB M g 0 hg (by omega), (M.op_ok g hg).1 hp]⟩
      · exact ⟨negL (vPad g), by simp, by simp [litVal_negL, assign_vPad M g hg, hp]⟩
    · by_cases hp : M.pad g = true
      · exact ⟨negL (vOr g), by simp, by simp [litVal_negL, assign_vOr M g hg, (M.op_ok g hg).1 hp]⟩
      · exact ⟨negL (vPad g), by simp, by simp [litVal_negL, assign_vPad M g hg, hp]⟩
  · rcases List.mem_flatMap.mp hc with ⟨i, hi, hc⟩
    rcases List.mem_map.mp hc with ⟨j, hj, rfl⟩
    rw [List.mem_range] at hi hj
    by_cases hp : M.pad g = true
    · exact ⟨posL (vPad g), by simp, by simp [litVal_posL, assign_vPad M g hg, hp]⟩
    · have hlt := (M.op_ok g hg).2.1 (Bool.eq_false_iff.mpr hp)
      by_cases ha : M.sA g = i
      · have hb : M.sB g ≠ j := by omega
        exact ⟨negL (vSelB g j), by simp, by simp [litVal_negL, assign_vSelB M g j hg (by omega), hb]⟩
      · exact ⟨negL (vSelA g i), by simp, by simp [litVal_negL, assign_vSelA M g i hg (by omega), ha]⟩

  · rcases List.mem_flatMap.mp hc with ⟨gp, hgp, hc⟩
    rw [List.mem_range] at hgp
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl
    · by_cases hp : M.pad gp = true
      · exact ⟨negL (vSelA g (N_in + gp)), by simp, by simp [litVal_negL, assign_vSelA M g (N_in + gp) hg (by omega), (M.no_read_pad g gp hg hgp hp).1]⟩
      · exact ⟨negL (vPad gp), by simp, by simp [litVal_negL, assign_vPad M gp (by omega), hp]⟩
    · by_cases hp : M.pad gp = true
      · exact ⟨negL (vSelB g (N_in + gp)), by simp, by simp [litVal_negL, assign_vSelB M g (N_in + gp) hg (by omega), (M.no_read_pad g gp hg hgp hp).2]⟩
      · exact ⟨negL (vPad gp), by simp, by simp [litVal_negL, assign_vPad M gp (by omega), hp]⟩
  · rcases List.mem_flatMap.mp hc with ⟨i, hi, hc⟩
    rcases List.mem_flatMap.mp hc with ⟨p, hp, hc⟩
    rw [List.mem_range] at hi hp
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl
    · by_cases ha : M.sA g = i
      · subst ha
        cases hv : (M.wVal (M.sA g)).getLsbD p
        · exact ⟨negL (vVal (M.sA g) p), by simp, by simp [litVal_negL, assign_vVal M (M.sA g) p (by omega) hp, hv]⟩
        · exact ⟨posL (vA g p), by simp, by simp [litVal_posL, assign_vA M g p hg hp, hv]⟩
      · exact ⟨negL (vSelA g i), by simp, by simp [litVal_negL, assign_vSelA M g i hg (by omega), ha]⟩
    · by_cases ha : M.sA g = i
      · subst ha
        cases hv : (M.wVal (M.sA g)).getLsbD p
        · exact ⟨negL (vA g p), by simp, by simp [litVal_negL, assign_vA M g p hg hp, hv]⟩
        · exact ⟨posL (vVal (M.sA g) p), by simp, by simp [litVal_posL, assign_vVal M (M.sA g) p (by omega) hp, hv]⟩
      · exact ⟨negL (vSelA g i), by simp, by simp [litVal_negL, assign_vSelA M g i hg (by omega), ha]⟩
    · by_cases hb : M.sB g = i
      · subst hb
        cases hv : (M.wVal (M.sB g)).getLsbD p
        · exact ⟨negL (vVal (M.sB g) p), by simp, by simp [litVal_negL, assign_vVal M (M.sB g) p (by omega) hp, hv]⟩
        · exact ⟨posL (vB g p), by simp, by simp [litVal_posL, assign_vB M g p hg hp, hv]⟩
      · exact ⟨negL (vSelB g i), by simp, by simp [litVal_negL, assign_vSelB M g i hg (by omega), hb]⟩
    · by_cases hb : M.sB g = i
      · subst hb
        cases hv : (M.wVal (M.sB g)).getLsbD p
        · exact ⟨negL (vB g p), by simp, by simp [litVal_negL, assign_vB M g p hg hp, hv]⟩
        · exact ⟨posL (vVal (M.sB g) p), by simp, by simp [litVal_posL, assign_vVal M (M.sB g) p (by omega) hp, hv]⟩
      · exact ⟨negL (vSelB g i), by simp, by simp [litVal_negL, assign_vSelB M g i hg (by omega), hb]⟩
  · rcases List.mem_flatMap.mp hc with ⟨p, hp, hc⟩
    rw [List.mem_range] at hp
    have hva : assignOf M (vA g p) = (M.wVal (M.sA g)).getLsbD p := assign_vA M g p hg hp
    have hvb : assignOf M (vB g p) = (M.wVal (M.sB g)).getLsbD p := assign_vB M g p hg hp
    have hvw : assignOf M (vVal (N_in + g) p) = (M.wVal (N_in + g)).getLsbD p := assign_vVal M (N_in + g) p (by omega) hp
    have hvo : assignOf M (vOr g) = M.opOr g := assign_vOr M g hg
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
    rcases hc with rfl | rfl | rfl | rfl | rfl | rfl <;> cases ho : M.opOr g
    all_goals
      try (have heq := (M.op_ok g hg).2.2.1 ho; rw [heq, BitVec.getLsbD_or] at hvw)
      try (have heq := (M.op_ok g hg).2.2.2 ho; rw [heq, BitVec.getLsbD_and] at hvw)
      cases ha : (M.wVal (M.sA g)).getLsbD p <;> cases hb : (M.wVal (M.sB g)).getLsbD p <;>
        simp only [ClauseSat, List.mem_cons, List.not_mem_nil, or_false, exists_eq_or_imp, exists_eq_left,
          litVal_posL, litVal_negL, hva, hvb, hvw, hvo, ho, ha, hb] <;> decide

theorem encForm_sat (M : EncModel) : FormulaSat encForm := by
  refine ⟨assignOf M, fun c hc => ?_⟩
  unfold encForm at hc
  simp only [List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with ((((hc | hc) | rfl) | hc) | hc) | hc
  · rcases List.mem_flatMap.mp hc with ⟨w, hw, hc⟩
    rcases List.mem_map.mp hc with ⟨p, hp, rfl⟩
    rw [List.mem_range] at hw hp
    cases hb : (inputCols.getD w 0).getLsbD p
    · exact ⟨negL (vVal w p), by simp, by rw [litVal_negL, assign_vVal M w p (by unfold N_in W_c at *; omega) hp, M.inp w hw, hb]; rfl⟩
    · exact ⟨posL (vVal w p), by simp, by rw [litVal_posL, assign_vVal M w p (by unfold N_in W_c at *; omega) hp, M.inp w hw, hb]⟩
  · rcases List.mem_map.mp hc with ⟨p, hp, rfl⟩
    rw [List.mem_range] at hp
    cases hb : targetWord.getLsbD p
    · exact ⟨negL (vVal (W_c - 1) p), by simp, by rw [litVal_negL, assign_vVal M (W_c - 1) p (by unfold W_c; omega) hp, M.out, hb]; rfl⟩
    · exact ⟨posL (vVal (W_c - 1) p), by simp, by rw [litVal_posL, assign_vVal M (W_c - 1) p (by unfold W_c; omega) hp, M.out, hb]⟩
  · exact ⟨negL (vPad (K_c - 1)), by simp, by simp [litVal_negL, assign_vPad M (K_c - 1) (by unfold K_c; omega), M.pad_last]⟩
  · rcases List.mem_map.mp hc with ⟨d, hd, rfl⟩
    rw [List.mem_range] at hd
    by_cases hp : M.pad (d + 1) = true
    · exact ⟨posL (vPad d), by simp, by simp [litVal_posL, assign_vPad M d (by omega), M.pad_pref d hd hp]⟩
    · exact ⟨negL (vPad (d + 1)), by simp, by simp [litVal_negL, assign_vPad M (d + 1) (by omega), hp]⟩
  · rcases List.mem_flatMap.mp hc with ⟨g, hg, hc⟩
    exact encGate_sat M g (List.mem_range.mp hg) c hc
  · rcases List.mem_map.mp hc with ⟨g, hg, rfl⟩
    rw [List.mem_range] at hg
    by_cases hp : M.pad g = true
    · exact ⟨posL (vPad g), List.mem_cons_self, by simp [litVal_posL, assign_vPad M g (by omega), hp]⟩
    · obtain ⟨g2, hg2, hlt2, hor⟩ := M.uses g hg (Bool.eq_false_iff.mpr hp)
      have hd : g2 - (g + 1) < K_c - (g + 1) := by omega
      have hsum : g + 1 + (g2 - (g + 1)) = g2 := by omega
      rcases hor with ha | hb
      · refine ⟨posL (vSelA g2 (N_in + g)), List.mem_cons_of_mem _ (List.mem_flatMap.mpr ⟨g2 - (g + 1), List.mem_range.mpr hd, by rw [hsum]; simp⟩), ?_⟩
        simp [litVal_posL, assign_vSelA M g2 (N_in + g) hlt2 (by unfold N_in W_c K_c at *; omega), ha]
      · refine ⟨posL (vSelB g2 (N_in + g)), List.mem_cons_of_mem _ (List.mem_flatMap.mpr ⟨g2 - (g + 1), List.mem_range.mpr hd, by rw [hsum]; simp⟩), ?_⟩
        simp [litVal_posL, assign_vSelB M g2 (N_in + g) hlt2 (by unfold N_in W_c K_c at *; omega), hb]

structure RawSeq (m : ℕ) (t : Word16) where
  wVal : ℕ → Word16
  opOr : ℕ → Bool
  sA : ℕ → ℕ
  sB : ℕ → ℕ
  inp : ∀ i < N_in, wVal i = inputCols.getD i 0
  step : ∀ g < m,
    (opOr g = true ∧ sA g < sB g ∧ sB g < N_in + g ∧ wVal (N_in + g) = wVal (sA g) ||| wVal (sB g)) ∨
    (opOr g = false ∧ sA g < sB g ∧ sB g < N_in + g ∧ wVal (N_in + g) = wVal (sA g) &&& wVal (sB g))
  outIdx : ℕ
  outLt : outIdx < N_in + m
  outEq : wVal outIdx = t

theorem reach_to_raw_aux : ∀ k (ws : List Word16) (m : ℕ) (wVal : ℕ → Word16)
    (opOr : ℕ → Bool) (sA sB : ℕ → ℕ) (t : Word16),
    (∀ i < N_in, wVal i = inputCols.getD i 0) →
    (∀ g < m,
      (opOr g = true ∧ sA g < sB g ∧ sB g < N_in + g ∧ wVal (N_in + g) = wVal (sA g) ||| wVal (sB g)) ∨
      (opOr g = false ∧ sA g < sB g ∧ sB g < N_in + g ∧ wVal (N_in + g) = wVal (sA g) &&& wVal (sB g))) →
    (∀ a ∈ ws, ∃ i < N_in + m, wVal i = a) →
    Reach ws k t →
    ∃ m' ≤ m + k, Nonempty (RawSeq m' t) := by
  intro k
  induction k with
  | zero =>
    intro ws m wVal opOr sA sB t hinp hstep hcov hr
    obtain ⟨idx, hidx, heq⟩ := hcov t hr
    exact ⟨m, by omega, ⟨⟨wVal, opOr, sA, sB, hinp, hstep, idx, hidx, heq⟩⟩⟩
  | succ k ih =>
    intro ws m wVal opOr sA sB t hinp hstep hcov hr
    rcases hr with ht | ⟨z, hzm, _, _, hnext, hr'⟩
    · obtain ⟨idx, hidx, heq⟩ := hcov t ht
      exact ⟨m, by omega, ⟨⟨wVal, opOr, sA, sB, hinp, hstep, idx, hidx, heq⟩⟩⟩
    · have hex : ∃ (ho : Bool) (a b : ℕ),
          (ho = true ∧ a < b ∧ b < N_in + m ∧ z = wVal a ||| wVal b) ∨
          (ho = false ∧ a < b ∧ b < N_in + m ∧ z = wVal a &&& wVal b) := by
        rcases hnext with ⟨a, ha, b, hb, hEq⟩
        obtain ⟨ia, hia, rfl⟩ := hcov a ha
        obtain ⟨ib, hib, rfl⟩ := hcov b hb
        have hne : ia ≠ ib := by
          intro h; subst h
          rcases hEq with rfl | rfl
          · rw [BitVec.and_self] at hzm; exact hzm ha
          · rw [BitVec.or_self] at hzm; exact hzm ha
        rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
        · rcases hEq with rfl | rfl
          · exact ⟨false, ia, ib, Or.inr ⟨rfl, hlt, hib, rfl⟩⟩
          · exact ⟨true, ia, ib, Or.inl ⟨rfl, hlt, hib, rfl⟩⟩
        · rcases hEq with rfl | rfl
          · exact ⟨false, ib, ia, Or.inr ⟨rfl, hgt, hia, BitVec.and_comm _ _⟩⟩
          · exact ⟨true, ib, ia, Or.inl ⟨rfl, hgt, hia, BitVec.or_comm _ _⟩⟩
      obtain ⟨ho, a, b, hgate⟩ := hex
      let wVal' := fun i => if i = N_in + m then z else wVal i
      let opOr' := fun g => if g = m then ho else opOr g
      let sA' := fun g => if g = m then a else sA g
      let sB' := fun g => if g = m then b else sB g
      have hsub := ih (z :: ws) (m + 1) wVal' opOr' sA' sB' t
        (fun i hi => by simp only [wVal', show i ≠ N_in + m by omega, ↓reduceIte]; exact hinp i hi)
        (fun g hg => by
          by_cases hgm : g = m
          · subst hgm
            simp only [wVal', opOr', sA', sB', ↓reduceIte]
            rcases hgate with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
            · exact Or.inl ⟨h1, h2, h3, by simp only [show a ≠ N_in + g by omega, show b ≠ N_in + g by omega, ↓reduceIte]; exact h4⟩
            · exact Or.inr ⟨h1, h2, h3, by simp only [show a ≠ N_in + g by omega, show b ≠ N_in + g by omega, ↓reduceIte]; exact h4⟩
          · have hlt : g < m := by omega
            simp only [wVal', opOr', sA', sB', hgm, ↓reduceIte]
            rcases hstep g hlt with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
            · exact Or.inl ⟨h1, h2, h3, by simp only [show N_in + g ≠ N_in + m by omega, show sA g ≠ N_in + m by omega, show sB g ≠ N_in + m by omega, ↓reduceIte]; exact h4⟩
            · exact Or.inr ⟨h1, h2, h3, by simp only [show N_in + g ≠ N_in + m by omega, show sA g ≠ N_in + m by omega, show sB g ≠ N_in + m by omega, ↓reduceIte]; exact h4⟩)
        (fun u hu => by
          rcases List.mem_cons.mp hu with rfl | hu
          · exact ⟨N_in + m, by omega, by simp [wVal']⟩
          · obtain ⟨i, hi, rfl⟩ := hcov u hu
            exact ⟨i, by omega, by simp [wVal', show i ≠ N_in + m by omega]⟩)
        hr'
      obtain ⟨m', hm', hR⟩ := hsub
      exact ⟨m', by omega, hR⟩

def delIdx (d i : ℕ) : ℕ := if i < d then i else i - 1

theorem raw_del {m : ℕ} {t : Word16} (R : RawSeq m t) (d : ℕ) (hd : d < m)
    (hnot_out : R.outIdx ≠ N_in + d)
    (hnot_used : ∀ g2, d < g2 → g2 < m → R.sA g2 ≠ N_in + d ∧ R.sB g2 ≠ N_in + d) :
    Nonempty (RawSeq (m - 1) t) := by
  let unIdx (i : ℕ) : ℕ := if i < N_in + d then i else i + 1
  have hun_del : ∀ i, i ≠ N_in + d → unIdx (delIdx (N_in + d) i) = i := by
    intro i hi; unfold unIdx delIdx; split_ifs <;> omega
  have hdel_lt : ∀ i j, i < j → i ≠ N_in + d → j ≠ N_in + d → delIdx (N_in + d) i < delIdx (N_in + d) j := by
    intro i j hij hi hj; unfold delIdx; split_ifs <;> omega
  refine ⟨{
    wVal := fun i => R.wVal (unIdx i)
    opOr := fun g => R.opOr (if g < d then g else g + 1)
    sA := fun g => delIdx (N_in + d) (R.sA (if g < d then g else g + 1))
    sB := fun g => delIdx (N_in + d) (R.sB (if g < d then g else g + 1))
    inp := fun i hi => by
      have : unIdx i = i := by unfold unIdx; split_ifs <;> omega
      rw [this]; exact R.inp i hi
    step := fun g hg => by
      by_cases hgd : g < d
      · simp only [hgd, ↓reduceIte]
        have huw : unIdx (N_in + g) = N_in + g := by unfold unIdx; split_ifs <;> omega
        rw [huw]
        rcases R.step g (by omega) with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · have ha : delIdx (N_in + d) (R.sA g) = R.sA g := by unfold delIdx; split_ifs <;> omega
          have hb : delIdx (N_in + d) (R.sB g) = R.sB g := by unfold delIdx; split_ifs <;> omega
          exact Or.inl ⟨h1, by omega, by omega, by rw [hun_del _ (by omega), hun_del _ (by omega)]; exact h4⟩
        · have ha : delIdx (N_in + d) (R.sA g) = R.sA g := by unfold delIdx; split_ifs <;> omega
          have hb : delIdx (N_in + d) (R.sB g) = R.sB g := by unfold delIdx; split_ifs <;> omega
          exact Or.inr ⟨h1, by omega, by omega, by rw [hun_del _ (by omega), hun_del _ (by omega)]; exact h4⟩
      · simp only [hgd, ↓reduceIte]
        have huw : unIdx (N_in + g) = N_in + (g + 1) := by unfold unIdx; split_ifs <;> omega
        rw [huw]
        have hnu := hnot_used (g + 1) (by omega) (by omega)
        rcases R.step (g + 1) (by omega) with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · have hlt := hdel_lt _ _ h2 hnu.1 hnu.2
          have hb : delIdx (N_in + d) (R.sB (g + 1)) < N_in + g := by unfold delIdx; split_ifs <;> omega
          exact Or.inl ⟨h1, hlt, hb, by rw [hun_del _ hnu.1, hun_del _ hnu.2]; exact h4⟩
        · have hlt := hdel_lt _ _ h2 hnu.1 hnu.2
          have hb : delIdx (N_in + d) (R.sB (g + 1)) < N_in + g := by unfold delIdx; split_ifs <;> omega
          exact Or.inr ⟨h1, hlt, hb, by rw [hun_del _ hnu.1, hun_del _ hnu.2]; exact h4⟩
    outIdx := delIdx (N_in + d) R.outIdx
    outLt := by unfold delIdx; have := R.outLt; split_ifs <;> omega
    outEq := by rw [hun_del _ hnot_out]; exact R.outEq
  }⟩

theorem reach_to_model (hr : Reach inputCols K_c targetWord) : Nonempty EncModel := by
  have hex : ∃ m, Nonempty (RawSeq m targetWord) := by
    have h := reach_to_raw_aux K_c inputCols 0 (fun i => inputCols.getD i 0) (fun _ => false) (fun _ => 0) (fun _ => 0) targetWord
      (fun _ _ => rfl) (fun _ hg => by omega)
      (fun a ha => by
        obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp ha
        have hlen : inputCols.length = N_in := by decide
        exact ⟨i, by omega, by rw [List.getD_eq_getElem _ _ hi]⟩) hr
    obtain ⟨m', _, hR⟩ := h
    exact ⟨m', hR⟩
  classical
  let m := Nat.find hex
  have hm_ex : Nonempty (RawSeq m targetWord) := Nat.find_spec hex
  have hm_le : m ≤ K_c := by
    have h := reach_to_raw_aux K_c inputCols 0 (fun i => inputCols.getD i 0) (fun _ => false) (fun _ => 0) (fun _ => 0) targetWord
      (fun _ _ => rfl) (fun _ hg => by omega)
      (fun a ha => by
        obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp ha
        have hlen : inputCols.length = N_in := by decide
        exact ⟨i, by omega, by rw [List.getD_eq_getElem _ _ hi]⟩) hr
    obtain ⟨m', hm', hR⟩ := h
    exact le_trans (Nat.find_min' hex hR) (by omega)
  have hm_min : ∀ m' < m, ¬ Nonempty (RawSeq m' targetWord) := fun m' hlt => Nat.find_min hex hlt
  obtain ⟨R⟩ := hm_ex
  have hm_pos : 1 ≤ m := by
    by_contra h0
    have hm0 : m = 0 := by omega
    have hlt : R.outIdx < N_in := by have := R.outLt; omega
    have heq := R.outEq
    rw [R.inp R.outIdx hlt] at heq
    have hlen : R.outIdx < inputCols.length := by
      have : inputCols.length = N_in := by decide
      omega
    have hmem : targetWord ∈ inputCols := by
      rw [← heq, List.getD_eq_getElem _ _ hlen]
      exact List.getElem_mem hlen
    exact (show targetWord ∉ inputCols by decide) hmem
  have hout : R.outIdx = N_in + (m - 1) := by
    by_contra hne
    exact hm_min (m - 1) (by omega) (raw_del R (m - 1) (by omega) hne (fun g2 hg2 hlt => by omega))
  have huses : ∀ g < m - 1, ∃ g2, g < g2 ∧ g2 < m ∧ (R.sA g2 = N_in + g ∨ R.sB g2 = N_in + g) := by
    intro g hg
    by_contra hno
    push Not at hno
    exact hm_min (m - 1) (by omega) (raw_del R g (by omega) (by omega) hno)
  let p := K_c - m
  let sh (i : ℕ) : ℕ := if i < N_in then i else i + p
  let unsh (i : ℕ) : ℕ := if i < N_in then i else if i < N_in + p then 0 else i - p
  have hunsh_sh : ∀ i, unsh (sh i) = i := by
    intro i; unfold unsh sh; split_ifs <;> omega
