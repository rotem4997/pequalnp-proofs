  induction ws with
  | nil => intro _; rfl
  | cons a r ih =>
    intro p
    change orB (p (f a) (r.map f)) (anySingles (r.map f) (fun b bs => p b (f a :: bs))) = _
    rw [orB_eq, ih]
    simp only [singles, List.any_cons, List.any_map]
