def andB (x y : Bool) : Bool := Bool.rec (motive := fun _ => Bool) false y x
def orB (x y : Bool) : Bool := Bool.rec (motive := fun _ => Bool) y true x
def force (k : ℕ) (f : ℕ → Bool) : Bool :=
