theorem andB_eq (x y : Bool) : andB x y = (x && y) := by cases x <;> rfl
theorem orB_eq (x y : Bool) : orB x y = (x || y) := by cases x <;> rfl
theorem notB_eq (x : Bool) : Bool.rec (motive := fun _ => Bool) true false x = !x := by
