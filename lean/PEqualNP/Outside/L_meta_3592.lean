      · exact absurd h hon
    have hab : ∀ c d : ℕ, (∀ y, Fw (n + j) y = o.eval [if c < n + j then Fw c y else false,
        if d < n + j then Fw d y else false]) → ¬ (¬ c < n + j) := by
      intro c d hcd hc
      rcases hop' with rfl | rfl
      · exact hconst false fun y => by
          rw [hcd y, if_neg hc]; simp [PEqualNP.CircuitLowerBounds.GateOp.eval]
      · by_cases hd : d < n + j
        · exact hdup d hd fun y => by
            rw [hcd y, if_neg hc, if_pos hd]; simp [PEqualNP.CircuitLowerBounds.GateOp.eval]
        · exact hconst false fun y => by
            rw [hcd y, if_neg hc, if_neg hd]; simp [PEqualNP.CircuitLowerBounds.GateOp.eval]
    have h1 : a < n + j := not_not.1 (hab a b fun y => hv y)
    have h2 : b < n + j := not_not.1 (hab b a fun y => by
      rw [hv y]
      rcases hop' with rfl | rfl
      · simp [PEqualNP.CircuitLowerBounds.GateOp.eval, Bool.and_comm]
      · simp [PEqualNP.CircuitLowerBounds.GateOp.eval, Bool.or_comm])
    have hne : a ≠ b := by
      rintro rfl
      refine hdup a h1 fun y => ?_
      rw [hv y]
      rcases hop' with rfl | rfl <;> simp [PEqualNP.CircuitLowerBounds.GateOp.eval, h1]
    refine ⟨?_, by simpa using hne, fun h => absurd h hon, fun _ => rfl⟩
    intro i hi
    rcases List.mem_cons.1 hi with rfl | hi
    · exact h1
    · rw [List.mem_singleton.1 hi]; exact h2
