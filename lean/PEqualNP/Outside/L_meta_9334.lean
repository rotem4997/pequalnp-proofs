def setOfMask (m : ℕ) : Finset V := Finset.univ.filter fun i => m.testBit i.val
def hbox (h : HI) : Box := (setOfMask (hs[h.val]!).1, setOfMask (hs[h.val]!).2)
def spread (m step : ℕ) := (List.range 21).foldl (fun s k => if m.testBit k then s + 2^(step*k) else s) 0
def words : Array ℕ := hs.map fun p => spread p.1 210 * spread p.2 10
def seed : ℕ := (2^(10*441)-1)/1023

def classify : List (ℕ × ℕ) → ℕ → Bool
  | [], x => decide (x%1023 ≤ 28) || words.any (fun w => (x &&& w) == x)
  | (a,b) :: ts, x => decide (x%1023 ≤ 28) || (classify ts (x &&& a) && classify ts (x &&& b))

