theorem cutOK : ∀ t i j : V,
    (i ≠ t → digit (cuts.getD t.val (0,0)).1 (ix i j) = 1023) ∧
    (bit t j = false → digit (cuts.getD t.val (0,0)).2 (ix i j) = 1023) := by decide +kernel

def positions (A B : Finset V) := (A ×ˢ B).image fun p => ix p.1 p.2

theorem boxUpper (x cap : Nat) (A B : Finset V)
    (legal : ∀ i ∈ A, ∀ j ∈ B, bit i j = false)
    (small : total 441 x < 1023) (last : x >>> (10*441) = 0) (pass : passes cap cuts x = true) :
    ∑ k ∈ positions A B, digit x k ≤ cap := by
  apply sound cap 441 (positions A B) _ cuts x _ small last pass
  · intro k hk
    obtain ⟨⟨i,j⟩,_,rfl⟩ := Finset.mem_image.mp hk
    apply Finset.mem_range.mpr
    unfold ix
    have := i.isLt
    have := j.isLt
    omega
  · intro cut member
    obtain ⟨k, rfl⟩ := List.mem_iff_get.mp member
    let t : V := ⟨k.val, by have := k.isLt; exact this⟩
    have eq : cuts.get k = cuts.getD t.val (0,0) := by simp [t,List.getD_eq_getElem?_getD]
    rw [eq]
    by_cases ht : t ∈ A
    · right
      intro n hn
      obtain ⟨⟨i,j⟩,hij,rfl⟩ := Finset.mem_image.mp hn
      exact (cutOK t i j).2 (legal t ht j (Finset.mem_product.mp hij).2)
    · left
      intro n hn
      obtain ⟨⟨i,j⟩,hij,rfl⟩ := Finset.mem_image.mp hn
      exact (cutOK t i j).1 (fun e => ht (e ▸ (Finset.mem_product.mp hij).1))


