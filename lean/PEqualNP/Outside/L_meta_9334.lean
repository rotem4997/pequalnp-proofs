  obtain ⟨small,last,mass⟩ := wFacts k
  obtain ⟨three,hz⟩ := repFacts k
  refine obstruct T zeros (fun b => positions b.1 b.2) (digit (grid k))
    (wRepSet k) has three adm.1 (cap k) hz ?_ mass ?_
  · intro b hb
    exact boxUpper _ _ _ _ (adm.2.1 b hb) small last (gridPass k)
  · intro z hz'
    obtain ⟨i,j,white,rfl⟩ := zeroCoord hz'
    obtain ⟨b,hb,hi,hj⟩ := adm.2.2 i j white
    exact ⟨b,hb,Finset.mem_image.mpr ⟨(i,j),Finset.mem_product.mpr ⟨hi,hj⟩,rfl⟩⟩

