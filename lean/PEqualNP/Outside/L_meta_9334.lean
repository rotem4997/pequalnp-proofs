import PEqualNP.Defs

namespace PEqualNP.Outside.L_meta_9334

-- A cell weight occupies one base-1024 digit. A legal rectangle chooses one branch of each row cut. The digit sum is the packed value modulo 1023 when the total is below 1023.
def digit (x k : ℕ) := (x >>> (10*k)) % (2^10)
def total (n x : ℕ) := ∑ k ∈ Finset.range n, digit x k

theorem digit_and (x m i : ℕ) : digit (x &&& m) i = digit x i &&& digit m i := by
  simp only [digit, Nat.shiftRight_and_distrib, Nat.and_mod_two_pow]

theorem digit_le (x m i : ℕ) : digit (x &&& m) i ≤ digit x i := by
  rw [digit_and]
  exact Nat.and_le_left

theorem digit_full (x m i : ℕ) (hm : digit m i = 1023) : digit (x &&& m) i = digit x i := by
  rw [digit_and,hm]
  change digit x i &&& (2^10-1) = digit x i
  rw [Nat.and_two_pow_sub_one_eq_mod]
  exact Nat.mod_eq_of_lt (Nat.mod_lt _ (by decide))

theorem foldDigit (v y : ℕ) : (v + y % 1024 + y / 1024) % 1023 = (v + y) % 1023 := by
  have eq : v+y = (v+y%1024+y/1024) + 1023*(y/1024) := by omega
  rw [eq, Nat.add_mul_mod_self_left]

theorem sumMod (n x : ℕ) : (total n x + (x >>> (10*n))) % 1023 = x % 1023 := by
  induction n with
  | zero => simp [total]
  | succ n ih =>
    rw [← ih]
    rw [show total (n+1) x = total n x + digit x n by simp [total,Finset.sum_range_succ]]
    rw [show 10*(n+1) = 10*n+10 by omega, Nat.shiftRight_add]
    change (total n x + (x >>> (10*n)) % 1024 + ((x >>> (10*n)) >>> 10)) % 1023 = _
    rw [Nat.shiftRight_eq_div_pow (x >>> (10*n)) 10]
    exact foldDigit _ _

theorem total_mod (n x : ℕ) (small : total n x < 1023) (endWord : x >>> (10*n) = 0) :
    total n x = x % 1023 := by
  simpa [endWord, Nat.mod_eq_of_lt small] using sumMod n x

def passes (cap : ℕ) : List (ℕ × ℕ) → ℕ → Bool
  | [], x => decide (x % 1023 ≤ cap)
  | (a,b) :: tail, x => decide (x % 1023 ≤ cap) || (passes cap tail (x &&& a) && passes cap tail (x &&& b))

theorem sound (cap n : ℕ) (entries : Finset ℕ) (inside : entries ⊆ Finset.range n)
    (ts : List (ℕ × ℕ)) (x : ℕ)
    (slots : ∀ cut ∈ ts, (∀ i ∈ entries, digit cut.1 i = 1023) ∨ (∀ i ∈ entries, digit cut.2 i = 1023))
    (small : total n x < 1023) (endWord : x >>> (10*n) = 0) (ok : passes cap ts x = true) :
    ∑ i ∈ entries, digit x i ≤ cap := by
  induction ts generalizing x with
  | nil =>
    have bound := of_decide_eq_true ok
    exact (Finset.sum_le_sum_of_subset_of_nonneg inside (fun _ _ _ => Nat.zero_le _)).trans
      ((total_mod n x small endWord).le.trans bound)
  | cons cut ts ih =>
    rcases cut with ⟨u,v⟩
    rcases Bool.or_eq_true_iff.mp ok with done | nextChecks
    · have bound := of_decide_eq_true done
      exact (Finset.sum_le_sum_of_subset_of_nonneg inside (fun _ _ _ => Nat.zero_le _)).trans
        ((total_mod n x small endWord).le.trans bound)
    · have rest := fun m (hm : m ∈ ts) => slots m (List.mem_cons_of_mem _ hm)
      have step (m : ℕ) (keep : ∀ i ∈ entries, digit m i = 1023) (pass : passes cap ts (x &&& m) = true) :
          ∑ i ∈ entries, digit x i ≤ cap := by
        have smaller : total n (x &&& m) ≤ total n x := Finset.sum_le_sum fun i _ => digit_le x m i
        have top : (x &&& m) >>> (10*n) = 0 := by simp [Nat.shiftRight_and_distrib,endWord]
        have h := ih (x &&& m) rest (lt_of_le_of_lt smaller small) top pass
        exact (Finset.sum_congr rfl (fun i hi => (digit_full x m i (keep i hi)).symm)).le.trans h
      rcases slots (u,v) (by simp) with left | right
      · exact step u left (Bool.and_eq_true_iff.mp nextChecks).1
      · exact step v right (Bool.and_eq_true_iff.mp nextChecks).2


