    digit (rectWord h) (ix i j) = 1023 := by decide +kernel

theorem boxWeightZero (x : ℕ) (h : HI) (separate : x &&& rectWord h = 0)
    (z : ℕ) (inside : z ∈ positions (hbox h).1 (hbox h).2) : digit x z = 0 := by
  obtain ⟨⟨i,j⟩,mem,rfl⟩ := Finset.mem_image.mp inside
  obtain ⟨hi,hj⟩ := Finset.mem_product.mp mem
  have ei : (hs[h.val]!).1.testBit i.val = true := (Finset.mem_filter.mp hi).2
  have ej : (hs[h.val]!).2.testBit j.val = true := (Finset.mem_filter.mp hj).2
  have same := digit_full x (rectWord h) (ix i j) (rectWordBits h i j ei ej)
  rw [separate] at same
  simpa [digit] using same.symm

