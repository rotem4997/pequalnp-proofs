  · exact boxWeightZero _ c sep.2.1 z hz
  have eq := Finset.mem_singleton.mp hb
  subst b
  exact boxWeightZero _ d sep.2.2 z hz

-- Sum the weights over the remaining eight rectangles.
open Finset


theorem obstruct {ι α : Type*} [DecidableEq ι] [DecidableEq α]
    (T : Finset ι) (U : Finset α) (box : ι → Finset α) (w : α → ℕ)
    (Z : Finset ι) (sub : Z ⊆ T) (three : Z.card = 3)
    (small : T.card ≤ 11) (cap : ℕ)
    (zero : ∀ i ∈ Z, ∀ p ∈ box i, w p = 0)
    (upper : ∀ i ∈ T, ∑ p ∈ box i, w p ≤ cap)
    (lower : 8 * cap < ∑ p ∈ U, w p) :
    ¬ (∀ p ∈ U, ∃ i ∈ T, p ∈ box i) := by
  classical
  intro cover
  let R := T \ Z
  have count : R.card ≤ 8 := by
    have h := Finset.card_sdiff_add_card_eq_card sub
    dsimp [R]
    omega
  have one (p : α) (hp : p ∈ U) : w p ≤ ∑ i ∈ R, (if p ∈ box i then w p else 0) := by
    obtain ⟨i,hi,mem⟩ := cover p hp
    by_cases iz : i ∈ Z
    · simp [zero i iz p mem]
    · have ir : i ∈ R := Finset.mem_sdiff.mpr ⟨hi,iz⟩
      have h := Finset.single_le_sum (f := fun j => if p ∈ box j then w p else 0)
        (fun j _ => Nat.zero_le _) ir
      simpa [mem] using h
  have row (i : ι) (hi : i ∈ R) : (∑ p ∈ U, (if p ∈ box i then w p else 0)) ≤ cap := by
    rw [← Finset.sum_filter]
    exact (Finset.sum_le_sum_of_subset_of_nonneg
      (show U.filter (· ∈ box i) ⊆ box i from fun x hx => (Finset.mem_filter.mp hx).2)
      (fun _ _ _ => Nat.zero_le _)).trans (upper i (Finset.mem_sdiff.mp hi).1)
  have bound := Finset.sum_le_sum one
  rw [Finset.sum_comm] at bound
  have total := (Finset.sum_le_sum row)
  simp only [Finset.sum_const, nsmul_eq_mul] at total
  exact (Nat.not_le_of_gt lower) (bound.trans (total.trans (Nat.mul_le_mul_right cap count)))

-- Transport a cover through three certified permutations.
abbrev admissible (T : Finset Box) := T.card ≤ 11 ∧ (∀ b ∈ T, legal b) ∧ hits T

theorem moveLegal (m : Move) (v : valid m) {b : Box} (h : legal b) : legal (moved m b) := by
  intro i hi j hj
  obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hi
  obtain ⟨c,hc,rfl⟩ := Finset.mem_image.mp hj
  exact (v.2.2 a c).trans (h a ha c hc)

theorem moveValidCover (m : Move) (v : valid m) (T : Finset Box) (h : admissible T) :
    admissible (T.image (moved m)) := by
  refine ⟨Finset.card_image_le.trans h.1,?_,?_⟩
  · intro b hb
    obtain ⟨a,ha,rfl⟩ := Finset.mem_image.mp hb
    exact moveLegal m v (h.2.1 a ha)
  · intro i j eq
    obtain ⟨a,rfl⟩ := Finite.surjective_of_injective (f := perm m.1) (fun _ _ => v.1 _ _) i
    obtain ⟨c,rfl⟩ := Finite.surjective_of_injective (f := perm m.2) (fun _ _ => v.2.1 _ _) j
    obtain ⟨b,hb,ha,hc⟩ := h.2.2 a c ((v.2.2 a c).symm.trans eq)
    exact ⟨moved m b, Finset.mem_image_of_mem _ hb, Finset.mem_image_of_mem _ ha, Finset.mem_image_of_mem _ hc⟩

theorem moveInjective (m : Move) (v : valid m) : Function.Injective (moved m) := by
  intro a b eq
  apply Prod.ext
  · exact Finset.image_injective (f := perm m.1) (fun _ _ => v.1 _ _) (congrArg Prod.fst eq)
  · exact Finset.image_injective (f := perm m.2) (fun _ _ => v.2.1 _ _) (congrArg Prod.snd eq)


theorem carryLabel (s : Word) (i : HI) : carry s (hbox i) = hbox (walk s i) := by
  induction s generalizing i with
  | nil => rfl
  | cons g tail ih =>
    change carry tail (moved (gen g) (hbox i)) = hbox (walk tail (act g i))
    rw [genActs, ih]

theorem carryInjective (s : Word) : Function.Injective (carry s) := by
  induction s with
  | nil => exact fun _ _ h => h
  | cons g tail ih => exact ih.comp (moveInjective _ (genValid g))

theorem carryCover (s : Word) (T : Finset Box) (h : admissible T) :
    admissible (T.image (carry s)) := by
  induction s generalizing T with
  | nil =>
    change admissible (T.image id)
    simpa using h
  | cons g tail ih =>
    have H := ih _ (moveValidCover (gen g) (genValid g) T h)
    rw [Finset.image_image] at H
    exact H

theorem firstChecks (i : HI) : carry (first i) (hbox i) = hbox 0 := by
  rw [carryLabel, firstIndex]

theorem secondChecks (i : HI) (nz : i ≠ 0) :
    carry (second i).2 (hbox 0) = hbox 0 ∧
    carry (second i).2 (hbox i) = hbox (anchor (second i).1) := by
  simp only [carryLabel, (secondIndex i nz).1, (secondIndex i nz).2, and_self]

theorem thirdChecks (a : Fin 4) (i : HI) (nz : i ≠ 0) (other : i ≠ anchor a) :
    ({hbox 0,hbox (anchor a),hbox i} : Finset Box).image (carry (third a i).2) =
      repSet (third a i).1 := by
  let s := (third a i).2
  let k := (third a i).1
  have labels : ({0,anchor a,i} : Finset HI).image (walk s) = repLabels k := thirdIndex a i nz other
  have eq := congrArg (Finset.image hbox) labels
  have endRep : (repLabels k).image hbox = repSet k := by
    unfold repLabels repSet
    generalize rep[k.val]! = triple
    rcases triple with ⟨x,y,z⟩
    simp
  rw [endRep] at eq
  simpa only [Finset.image_insert,Finset.image_singleton,carryLabel] using eq
theorem useRepresentatives
    (base : ∀ k T, admissible T → repSet k ⊆ T → False)
    (T : Finset Box) (h : admissible T) (a b c : HI)
    (ab : hbox a ≠ hbox b) (ac : hbox a ≠ hbox c) (bc : hbox b ≠ hbox c)
    (ha : hbox a ∈ T) (hb : hbox b ∈ T) (hc : hbox c ∈ T) : False := by
  let m := first a
  have ma := firstChecks a
  let j := walk m b
  have mj := carryLabel m b
  let k := walk m c
  have mk := carryLabel m c
  have inj := carryInjective m
  have j0 : j ≠ 0 := by
    intro eq
    change walk m b = 0 at eq
    rw [eq] at mj
    exact ab (inj (ma.trans mj.symm))
  let S := T.image (carry m)
  have hs := carryCover m T h
  have s0 : hbox 0 ∈ S := ma ▸ Finset.mem_image_of_mem (carry m) ha
  have sj : hbox j ∈ S := mj ▸ Finset.mem_image_of_mem (carry m) hb
  have sk : hbox k ∈ S := mk ▸ Finset.mem_image_of_mem (carry m) hc
  let n := (second j).2
  let e := (second j).1
  obtain ⟨n0,nj⟩ := secondChecks j j0
  let p := walk n k
  have np : carry n (hbox k) = hbox p := carryLabel n k
  have injn := carryInjective n
  have p0 : p ≠ 0 := by
    intro eq
    rw [eq] at np
    exact ac (inj (ma.trans ((injn (n0.trans np.symm)).trans mk.symm)))
  have pe : p ≠ anchor e := by
    rintro eq
    rw [eq] at np
