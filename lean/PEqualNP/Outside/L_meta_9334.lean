theorem labelShape : ∀ h : HI, (hbox h).1.card = 6 ∧ (hbox h).2.card = 6 ∧
    ∀ i ∈ (hbox h).1, ∀ j ∈ (hbox h).2, bit i j = false := by decide +kernel

theorem seedProps : total 441 seed < 1023 ∧ seed >>> 4410 = 0 ∧
    ∀ i j : V, digit seed (ix i j) = 1 := by decide +kernel

-- The same decision tree on unit weights extends every legal rectangle larger than 28 cells to one of the 168 listed six-by-six boxes.
theorem ixInj : Function.Injective (fun p : V × V => ix p.1 p.2) := by
  rintro ⟨a,b⟩ ⟨c,d⟩ h
  change a.val*21 + b.val = c.val*21 + d.val at h
  have hb := b.isLt
  have hd := d.isLt
  apply Prod.ext
  · apply Fin.ext
    change a.val = c.val
    omega
  · apply Fin.ext
    change b.val = d.val
    omega

theorem posCard (A B : Finset V) : (positions A B).card = A.card*B.card := by
  rw [positions, Finset.card_image_of_injective _ ixInj, Finset.card_product]

theorem classifySound (E : Finset ℕ) (ins : E ⊆ Finset.range 441) (large : 28 < E.card) :
    ∀ (ts : List (ℕ × ℕ)) (x : ℕ),
    (∀ m ∈ ts, (∀ i ∈ E, digit m.1 i = 1023) ∨ (∀ i ∈ E, digit m.2 i = 1023)) →
    total 441 x < 1023 → x >>> 4410 = 0 →
    (∀ i ∈ E, digit x i = 1) → classify ts x = true →
    ∃ h : HI, ∀ i ∈ E, digit (words[h.val]!) i ≠ 0 := by
  have notSmall (x : Nat) (small : total 441 x < 1023) (last : x >>> 4410 = 0)
      (ones : ∀ i ∈ E, digit x i = 1) : ¬ x%1023 ≤ 28 := by
    rw [← total_mod 441 x small last]
    have a : E.card = ∑ i ∈ E, digit x i := by
      calc
        E.card = ∑ _ ∈ E, (1 : ℕ) := by simp
        _ = ∑ i ∈ E, digit x i := Finset.sum_congr rfl fun i hi => (ones i hi).symm
    have b : ∑ i ∈ E, digit x i ≤ total 441 x :=
      Finset.sum_le_sum_of_subset_of_nonneg ins (fun _ _ _ => Nat.zero_le _)
    omega
  intro ts
  induction ts with
  | nil =>
    intro x _ sm last ones ok
    rcases Bool.or_eq_true_iff.mp ok with bad | found
    · exact (notSmall x sm last ones (of_decide_eq_true bad)).elim
    · obtain ⟨idx,bound,matchW⟩ := Array.any_eq_true.mp found
      have size : words.size = 168 := by rw [words, Array.size_map]; rfl
      let h : HI := ⟨idx, size ▸ bound⟩
      refine ⟨h,fun i hi hz => ?_⟩
      have same := congrArg (fun z => digit z i) (eq_of_beq matchW)
      have hz' : digit (words[idx]'bound) i = 0 := by simpa [h,getElem!_pos, bound] using hz
      simp [digit_and,ones i hi,hz'] at same
  | cons cut tail ih =>
    rcases cut with ⟨a,b⟩
    intro x legal sm last ones ok
    rcases Bool.or_eq_true_iff.mp ok with bad | pair
    · exact (notSmall x sm last ones (of_decide_eq_true bad)).elim
    · have step (m : ℕ) (keep : ∀ i ∈ E, digit m i = 1023) (pass : classify tail (x &&& m) = true) :=
        ih (x &&& m) (fun t ht => legal t (List.mem_cons_of_mem _ ht))
          (lt_of_le_of_lt (Finset.sum_le_sum fun k _ => digit_le x m k) sm)
          (by simp [Nat.shiftRight_and_distrib,last])
          (fun i hi => (digit_full x m i (keep i hi)).trans (ones i hi)) pass
      rcases legal (a,b) (by simp) with left | right
      · exact step a left (Bool.and_eq_true_iff.mp pair).1
      · exact step b right (Bool.and_eq_true_iff.mp pair).2

theorem bigExt (A B : Finset V) (legal : ∀ i ∈ A, ∀ j ∈ B, bit i j = false)
    (big : 28 < A.card*B.card) : ∃ h : HI, A ⊆ (hbox h).1 ∧ B ⊆ (hbox h).2 := by
  let E := positions A B
  have ins : E ⊆ Finset.range 441 := by
    intro k hk
    obtain ⟨⟨i,j⟩,_,rfl⟩ := Finset.mem_image.mp hk
    apply Finset.mem_range.mpr
    unfold ix
    have := i.isLt
    have := j.isLt
    omega
  have slots : ∀ cut ∈ cuts, (∀ k ∈ E, digit cut.1 k = 1023) ∨ (∀ k ∈ E, digit cut.2 k = 1023) := by
    intro cut member
    obtain ⟨k, rfl⟩ := List.mem_iff_get.mp member
    let t : V := ⟨k.val, by exact k.isLt⟩
    have eq : cuts.get k = cuts.getD t.val (0,0) := by simp [t,List.getD_eq_getElem?_getD]
    rw [eq]
    by_cases ht : t ∈ A
    · right
      intro n hn
      obtain ⟨⟨i,j⟩,hij,rfl⟩ := Finset.mem_image.mp hn
      exact (cutOK t i j).2 (legal t ht j (Finset.mem_product.mp hij).2)
    · left
      intro n hn
      obtain ⟨⟨i,j⟩,hij,rfl⟩ := Finset.mem_image.mp hn
      exact (cutOK t i j).1 (fun e => ht (e ▸ (Finset.mem_product.mp hij).1))
  have large : 28 < E.card := (posCard A B).symm ▸ big
  obtain ⟨h, hh⟩ := classifySound E ins large cuts seed slots seedProps.1 seedProps.2.1 (by
    intro k hk
    obtain ⟨⟨i,j⟩,_,rfl⟩ := Finset.mem_image.mp hk
    exact seedProps.2.2 i j) classified
  have both (i j : V) (hi : i ∈ A) (hj : j ∈ B) : i ∈ (hbox h).1 ∧ j ∈ (hbox h).2 :=
    labelSound h i j (hh (ix i j) (Finset.mem_image.mpr ⟨(i,j),Finset.mem_product.mpr ⟨hi,hj⟩,rfl⟩))
  have left : A.Nonempty := by
    by_contra! h
    simp [h] at big
  have right : B.Nonempty := by
    by_contra! h
    simp [h] at big
  obtain ⟨a,ha⟩ := left
  obtain ⟨b,hb⟩ := right
  exact ⟨h,fun i hi => (both i b hi hb).1,fun j hj => (both a j ha hj).2⟩

-- Enlarge large boxes and discard duplicates. Area counting leaves at least three distinct listed boxes in any cover of size at most eleven.
abbrev legal (b : Box) := ∀ i ∈ b.1, ∀ j ∈ b.2, bit i j = false
abbrev hits (T : Finset Box) := ∀ i j : V, bit i j = false → ∃ b ∈ T, i ∈ b.1 ∧ j ∈ b.2
def area (b : Box) := b.1.card * b.2.card
def allZero : Finset Nat := ((Finset.univ : Finset (V × V)).filter (fun p => bit p.1 p.2 = false)).image (fun p => ix p.1 p.2)
def tiles (T : Finset Box) := T.biUnion fun b => positions b.1 b.2

theorem zeroCount : allZero.card = 336 := by decide +kernel

theorem tileCount (T : Finset Box) (bound : ∀ b ∈ T, area b ≤ 36) :
    (tiles T).card ≤ 28*T.card + 8*(T.filter (fun b => 28 < area b)).card := by
  induction T using Finset.induction_on with
  | empty => simp [tiles]
  | @insert b S hb ih =>
    have prev := ih (fun c hc => bound c (Finset.mem_insert_of_mem hc))
    have size := bound b (Finset.mem_insert_self _ _)
    have added := Finset.card_union_le (positions b.1 b.2) (tiles S)
    rw [posCard] at added
    change ((positions b.1 b.2) ∪ tiles S).card ≤ area b + (tiles S).card at added
    rw [show tiles (insert b S) = positions b.1 b.2 ∪ tiles S by simp [tiles],Finset.card_insert_of_notMem hb]
    by_cases large : 28 < area b
    · simp [Finset.filter_insert,large,hb]; omega
    · simp [Finset.filter_insert,large]; omega

noncomputable def grow (b : Box) : Box := by
  classical
  exact if h : ∃ k, b.1 ⊆ (hbox k).1 ∧ b.2 ⊆ (hbox k).2 then hbox h.choose else b

theorem growFacts (b : Box) (ok : legal b) :
    b.1 ⊆ (grow b).1 ∧ b.2 ⊆ (grow b).2 ∧ legal (grow b) ∧
    area (grow b) ≤ 36 ∧ (28 < area (grow b) → ∃ k, grow b = hbox k) := by
  classical
  unfold grow
  split
  next h =>
    obtain ⟨s,t⟩ := h.choose_spec
    obtain ⟨u,v,w⟩ := labelShape h.choose
    exact ⟨s,t,w,by simp [area,u,v],fun _ => ⟨_,rfl⟩⟩
  next h =>
    have sm : area b ≤ 28 := by
      by_contra! lg
      exact h (bigExt b.1 b.2 ok lg)
    exact ⟨fun _ x => x,fun _ x => x,ok,by omega,fun z => (Nat.not_lt_of_ge sm z).elim⟩

set_option maxRecDepth 12000 in
set_option maxHeartbeats 1500000 in
theorem recognizableCover (L : List Box) (small : L.length ≤ 11) (ok : ∀ b ∈ L, legal b)
    (hit : ∀ i j : V, bit i j = false → ∃ b ∈ L, i ∈ b.1 ∧ j ∈ b.2) :
    ∃ T : Finset Box, T.card ≤ 11 ∧ (∀ b ∈ T, legal b) ∧ hits T ∧
      ∃ a b c : HI, hbox a ≠ hbox b ∧ hbox a ≠ hbox c ∧ hbox b ≠ hbox c ∧
        hbox a ∈ T ∧ hbox b ∈ T ∧ hbox c ∈ T := by
  classical
  let T := L.toFinset.image grow
  have size : T.card ≤ 11 := Finset.card_image_le.trans (L.toFinset_card_le.trans small)
  have facts (b : Box) (hb : b ∈ T) : legal b ∧ area b ≤ 36 ∧ (28 < area b → ∃ k, b = hbox k) := by
    obtain ⟨v,hv,rfl⟩ := Finset.mem_image.mp hb
    exact (growFacts v (ok _ (List.mem_toFinset.mp hv))).2.2
  have cover : hits T := by
    intro i j blank
    obtain ⟨b,hb,hi,hj⟩ := hit i j blank
    have p := growFacts b (ok _ hb)
    have member : grow b ∈ T := Finset.mem_image_of_mem grow (List.mem_toFinset.mpr hb)
    have hrow : i ∈ (grow b).1 := @p.1 i hi
    have hcol : j ∈ (grow b).2 := @p.2.1 j hj
    exact ⟨grow b,member,hrow,hcol⟩
  have sub : allZero ⊆ tiles T := by
    intro k hk
    obtain ⟨⟨i,j⟩,hij,rfl⟩ := Finset.mem_image.mp hk
    obtain ⟨b,hb,hi,hj⟩ := cover i j (Finset.mem_filter.mp hij).2
    exact Finset.mem_biUnion.mpr ⟨b,hb,Finset.mem_image.mpr ⟨(i,j),Finset.mem_product.mpr ⟨hi,hj⟩,rfl⟩⟩
  let S := T.filter (fun b => 28 < area b)
  have source := tileCount T (fun b hb => (facts b hb).2.1)
  change _ ≤ 28*T.card+8*S.card at source
  have mass := Finset.card_le_card sub
  rw [zeroCount] at mass
  obtain ⟨F,fs,ct⟩ := Finset.exists_subset_card_eq (show 3 ≤ S.card by omega)
  obtain ⟨a,b,c,ab,ac,bc,eq⟩ := Finset.card_eq_three.mp ct
  have witness (x : Box) (hx : x ∈ F) : x ∈ T ∧ ∃ h, x = hbox h := by
    obtain ⟨hx,large⟩ := Finset.mem_filter.mp (fs hx)
    exact ⟨hx,(facts x hx).2.2 large⟩
  obtain ⟨ha,i,rfl⟩ := witness a (by simp [eq])
  obtain ⟨hb,j,rfl⟩ := witness b (by simp [eq])
  obtain ⟨hc,k,rfl⟩ := witness c (by simp [eq])
  exact ⟨T,size,fun b hb => (facts b hb).1,cover,i,j,k,ab,ac,bc,ha,hb,hc⟩

