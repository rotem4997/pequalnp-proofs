def allOk : Bool := L.all fun m1 => L.all fun m2 => m1 == m2 || G.any (fun g => g.1 == m1 && g.2.any (fun e => ok m1 m2 e))

theorem allOk_true : allOk = true := by decide +kernel

theorem code_iff : ∀ a b : Fin 14, Er a b = true ↔ 14 * (a : ℕ) + (b : ℕ) ∈ codes := by
  decide +kernel

theorem L_indep : ∀ m ∈ L, ∀ a b : Fin 14, Er a b = true →
    ¬(m.testBit a = true ∧ m.testBit b = true) := by
  decide +kernel

theorem toFn_eq (x : Fin 14 → Bool) (hx : Maximal (fun y => ¬ X y) x) :
    ∃ m ∈ L, x = fun i : Fin 14 => m.testBit i := by
  have hnx : ¬∃ (a : Fin 14) (b : Fin 14), 14 * (a : ℕ) + (b : ℕ) ∈ codes ∧ x a = true ∧ x b = true := by
    rintro ⟨a, b, hc, ha, hb⟩
    exact hx.1 ⟨a, b, (code_iff a b).2 hc, ha, hb⟩
  obtain ⟨m, hm, hbits⟩ := main x hnx
  refine ⟨m, hm, ?_⟩
  have hy : ¬ X (fun i : Fin 14 => m.testBit i) := by
    rintro ⟨a, b, he, ha, hb⟩
    exact L_indep m hm a b he ⟨ha, hb⟩
  have hle : x ≤ fun i : Fin 14 => m.testBit i := fun i => Bool.le_iff_imp.2 (hbits i)
  exact le_antisymm hle (hx.2 hy hle)

def fp (σ : List ℕ) (i : Fin 14) : Fin 14 := ⟨σ.getD i 0 % 14, Nat.mod_lt _ (by norm_num)⟩

theorem permOK_spec (σ : List ℕ) (h : permOK σ = true) :
    (∀ i < 14, σ.getD i 0 < 14) ∧ (∀ i < 14, ∀ j < 14, i ≠ j → σ.getD i 0 ≠ σ.getD j 0) ∧
    (∀ a < 14, ∀ b < 14, S a b = S (σ.getD a 0) (σ.getD b 0)) := by
  simp only [permOK, Bool.and_eq_true, List.all_eq_true, List.mem_range, decide_eq_true_eq] at h
  obtain ⟨h1, h2, h3⟩ := h
  refine ⟨h1, ?_, ?_⟩
  · intro i hi j hj hij
    have := h2 i hi j hj
    simp only [Bool.or_eq_true, beq_iff_eq, bne_iff_ne, ne_eq] at this
    rcases this with h | h
    · exact absurd h hij
    · exact h
  · intro a ha b hb
    exact beq_iff_eq.mp (h3 a ha b hb)

theorem fp_val (σ : List ℕ) (h : permOK σ = true) (i : Fin 14) :
    ((fp σ i : Fin 14) : ℕ) = σ.getD i 0 :=
  Nat.mod_eq_of_lt ((permOK_spec σ h).1 i i.2)

theorem fp_inj (σ : List ℕ) (h : permOK σ = true) : Function.Injective (fp σ) := by
  intro a b hab
  by_contra hne
  have hv := congrArg Fin.val hab
  rw [fp_val σ h, fp_val σ h] at hv
  exact (permOK_spec σ h).2.1 a a.2 b b.2 (fun e => hne (Fin.ext e)) hv

theorem fp_bij (σ : List ℕ) (h : permOK σ = true) : Function.Bijective (fp σ) :=
  ⟨fp_inj σ h, Finite.injective_iff_surjective.mp (fp_inj σ h)⟩

theorem fp_S (σ : List ℕ) (h : permOK σ = true) (a b : Fin 14) :
    S (fp σ a) (fp σ b) = S a b := by
  rw [fp_val σ h, fp_val σ h]
  exact ((permOK_spec σ h).2.2 a a.2 b b.2).symm

theorem aut (σ : List ℕ) (h : permOK σ = true) (x9 : Fin 14 → Bool) :
    X (x9 ∘ fp σ) ↔ X x9 := by
  constructor
  · rintro ⟨a, b, he, ha, hb⟩
    have hs : S (fp σ a) (fp σ b) = true := by
      rw [fp_S σ h]
      simp [S, he]
    simp only [S, Bool.or_eq_true] at hs
    rcases hs with hs | hs
    · exact ⟨fp σ a, fp σ b, hs, ha, hb⟩
    · exact ⟨fp σ b, fp σ a, hs, hb, ha⟩
  · rintro ⟨c, d, he, hc, hd⟩
    obtain ⟨a, rfl⟩ := (fp_bij σ h).2 c
    obtain ⟨b, rfl⟩ := (fp_bij σ h).2 d
    have hs : S a b = true := by
      rw [← fp_S σ h]
      simp [S, he]
    simp only [S, Bool.or_eq_true] at hs
    rcases hs with hs | hs
    · exact ⟨a, b, hs, hc, hd⟩
    · exact ⟨b, a, hs, hd, hc⟩

theorem cover (m1 m2 : ℕ) (h1 : m1 ∈ L) (h2 : m2 ∈ L) (hne : m1 ≠ m2) :
    ∃ e : ℕ × ℕ × ℕ × ℕ × Bool, ok m1 m2 e = true := by
  have h := allOk_true
  unfold allOk at h
  rw [List.all_eq_true] at h
  have h' := h m1 h1
  rw [List.all_eq_true] at h'
  have h'' := h' m2 h2
  rw [Bool.or_eq_true, beq_iff_eq] at h''
  rcases h'' with h'' | h''
  · exact absurd h'' hne
  · rw [List.any_eq_true] at h''
    obtain ⟨g, _, hg⟩ := h''
    rw [Bool.and_eq_true, List.any_eq_true] at hg
    obtain ⟨e, _, he⟩ := hg.2
    exact ⟨e, he⟩

theorem mt_spec (m r : ℕ) (σ : List ℕ) (h : mt m r σ = true) (i : Fin 14) :
    m.testBit i = r.testBit (σ.getD i 0) := by
  unfold mt at h
  rw [List.all_eq_true] at h
  exact beq_iff_eq.mp (h i (List.mem_range.2 i.2))

