theorem PEqualNP.Outside.L_meta_11104 :
    ¬ (∃ L : List (Finset (Fin 20) × Finset (Fin 20)), L.length ≤ 7 ∧ (∀ r ∈ L, ∀ i ∈ r.1, ∀ j ∈ r.2, (([589842, 131109, 262218, 524436, 297, 594, 1188, 2376, 4752, 9504, 19008, 38016, 76032, 152064, 304128, 608256, 167937, 335874, 671748, 294921] : List ℕ).getD i.val 0).testBit j.val = false) ∧ ∀ (i : Fin 20) (j : Fin 20), (([589842, 131109, 262218, 524436, 297, 594, 1188, 2376, 4752, 9504, 19008, 38016, 76032, 152064, 304128, 608256, 167937, 335874, 671748, 294921] : List ℕ).getD i.val 0).testBit j.val = false → ∃ r ∈ L, i ∈ r.1 ∧ j ∈ r.2) := by
  classical
  rintro ⟨L, hlen, allZero, covers⟩
  have covered (i : ℕ) : ∃ k : Fin L.length,
      (cell i).1 ∈ (L.get k).1 ∧ (cell i).2 ∈ (L.get k).2 := by
    obtain ⟨box, mem, hrow, hcol⟩ := covers (cell i).1 (cell i).2 (allZeroCell i)
    obtain ⟨k, rfl⟩ := List.mem_iff_get.mp mem
    exact ⟨k, hrow, hcol⟩
  choose pick hits using covered
  let colors (i : ℕ) : Fin 7 := Fin.castLE hlen (pick i)
  apply noColoring colors
  intro i j h same
  have samePick : pick i = pick j := by
    apply Fin.ext
    exact congrArg (fun k : Fin 7 => k.val) same
  have other : (cell j).1 ∈ (L.get (pick i)).1 ∧ (cell j).2 ∈ (L.get (pick i)).2 := by
    simpa only [samePick] using hits j
  have mem := List.get_mem L (pick i)
  have one : bit (cell i).1 (cell j).2 = false :=
    allZero _ mem _ (hits i).1 _ other.2
  have two : bit (cell j).1 (cell i).2 = false :=
    allZero _ mem _ other.1 _ (hits i).2
  simp [clash, one, two] at h
