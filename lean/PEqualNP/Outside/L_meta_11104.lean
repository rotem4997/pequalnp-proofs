theorem certificateValid : verify program 12 0 initial = true := by
  decide +kernel

theorem noColoring (C : ℕ → Fin 7)
    (proper : ∀ i j, clash i j = true → C i ≠ C j) : False := by
  classical
  let a (i : Fin 6) : Fin 7 := C i.val
  have injA : Function.Injective a := by
    intro i j h
    by_contra different
    exact proper _ _ (anchorClash i j different) h
  have countA : (Finset.univ.image a).card = 6 := by
    rw [Finset.card_image_of_injective _ injA]
    simp
  obtain ⟨extra, unused⟩ : ∃ x : Fin 7, x ∉ Finset.univ.image a := by
    by_contra! h
    have eq : Finset.univ.image a = Finset.univ := Finset.eq_univ_of_forall h
    rw [eq] at countA
    simp at countA
  let ext : Fin 7 → Fin 7 := Fin.lastCases extra a
  have injExt : Function.Injective ext := by
    intro i j eq
    cases i using Fin.lastCases with
    | last =>
      cases j using Fin.lastCases with
      | last => rfl
      | cast j =>
        exact (unused (Finset.mem_image.mpr
          ⟨j, Finset.mem_univ _, by simpa only [ext, Fin.lastCases_last, Fin.lastCases_castSucc] using eq.symm⟩)).elim
    | cast i =>
      cases j using Fin.lastCases with
      | last =>
        exact (unused (Finset.mem_image.mpr
          ⟨i, Finset.mem_univ _, by simpa only [ext, Fin.lastCases_last, Fin.lastCases_castSucc] using eq⟩)).elim
      | cast j =>
        exact congrArg Fin.castSucc (injA (by simpa only [ext, Fin.lastCases_last, Fin.lastCases_castSucc] using eq))
  let e : Fin 7 ≃ Fin 7 :=
    Equiv.ofBijective ext ⟨injExt, Finite.injective_iff_surjective.mp injExt⟩
  let c (i : ℕ) : ℕ := (e.symm (C i)).val
  have fixed (i : ℕ) (hi : i < 6) : c i = i := by
    let j : Fin 6 := ⟨i, hi⟩
    have eq : e j.castSucc = C i := by
      change Fin.lastCases extra a j.castSucc = C i
      rw [Fin.lastCases_castSucc]
    have inv : e.symm (C i) = j.castSucc := by
      rw [← eq, Equiv.symm_apply_apply]
    exact congrArg Fin.val inv
  have valid : ∀ i j, clash i j = true → c i ≠ c j := by
    intro i j h neq
    apply proper i j h
    exact e.symm.injective (Fin.ext neq)
  have fit : ∀ i, c i ∈ initial i := by
    intro i
    unfold initial
    split
    next hi => simp [fixed i hi]
    next =>
      apply List.mem_filter.mpr
      refine ⟨List.mem_range.mpr (e.symm (C i)).isLt, ?_⟩
      by_cases small : c i < 6
      · have free : clash i (c i) = false := by
          cases h : clash i (c i)
          · rfl
          · exact (valid _ _ h (fixed (c i) small).symm).elim
        simp [free]
      · simp [small]
  exact verify_sound program valid 12 0 initial fit certificateValid

