def cell (i : ℕ) : Fin 20 × Fin 20 := cells.getD i (19, 17)

def clash (i j : ℕ) : Bool :=
  bit (cell i).1 (cell j).2 || bit (cell j).1 (cell i).2

theorem zeroCell : ∀ i : Fin cells.length, bit (cell i.val).1 (cell i.val).2 = false := by
  decide +kernel

theorem allZeroCell (i : ℕ) : bit (cell i).1 (cell i).2 = false := by
  by_cases h : i < cells.length
  · exact zeroCell ⟨i, h⟩
  · unfold cell
    rw [List.getD_eq_default _ _ (Nat.le_of_not_gt h)]
    decide

theorem anchorClash : ∀ i j : Fin 6, i ≠ j → clash i.val j.val = true := by
  decide +kernel

abbrev Domains := ℕ → List ℕ

def update (D : Domains) (i : ℕ) (allowed : List ℕ) : Domains :=
  fun j => if j = i then allowed else D j

def initial (i : ℕ) : List ℕ :=
  if i < 6 then [i] else (List.range 7).filter fun c => !(decide (c < 6) && clash i c)

def prune (D : Domains) (step : ℕ × ℕ) : Domains :=
  match D step.1 with
  | [c] => if clash step.1 step.2 then
      update D step.2 ((D step.2).filter fun x => x != c)
    else D
  | _ => D

theorem prune_safe {C : ℕ → ℕ} (proper : ∀ i j, clash i j = true → C i ≠ C j)
    {D : Domains} (fits : ∀ i, C i ∈ D i) (step : ℕ × ℕ) :
    ∀ i, C i ∈ prune D step i := by
  by_cases hc : clash step.1 step.2 = true
  · cases src : D step.1 with
    | nil => simpa [prune, src] using fits
    | cons c tail =>
      cases tail with
      | nil =>
        have ha : C step.1 = c := by simpa [src] using fits step.1
        have hb : C step.2 ≠ c := by
          intro e
          exact proper _ _ hc (ha.trans e.symm)
        intro i
        by_cases ht : i = step.2
        · subst i
          simp [prune, src, hc, update, fits, hb]
        · simpa [prune, src, hc, update, ht] using fits i
      | cons d ds => simpa [prune, src] using fits
  · cases src : D step.1 with
    | nil => simpa [prune, src] using fits
    | cons c tail =>
      cases tail with
      | nil => simpa [prune, src, hc] using fits
      | cons d ds => simpa [prune, src] using fits

theorem fold_safe {C : ℕ → ℕ} (proper : ∀ i j, clash i j = true → C i ≠ C j)
    (steps : List (ℕ × ℕ)) {D : Domains} (fits : ∀ i, C i ∈ D i) :
    ∀ i, C i ∈ steps.foldl prune D i := by
  induction steps generalizing D with
  | nil => exact fits
  | cons step rest ih =>
    exact ih (prune_safe proper fits step)

-- Each node removes colors ruled out by a singleton domain before splitting on
-- the remaining colors at one cell. An empty domain has no child.
abbrev Node := List (ℕ × ℕ) × ℕ × List (ℕ × ℕ)

def verify (program : List Node) : ℕ → ℕ → Domains → Bool
  | 0, _, _ => false
  | fuel + 1, k, D =>
    let n := program.getD k ([], 0, [])
    let reduced := n.1.foldl prune D
    (reduced n.2.1).all fun c =>
      match n.2.2.find? (fun p => p.1 == c) with
      | some p => verify program fuel p.2 (update reduced n.2.1 [c])
      | none => false

theorem verify_sound (program : List Node) {C : ℕ → ℕ}
    (proper : ∀ i j, clash i j = true → C i ≠ C j) :
    ∀ fuel k D, (∀ i, C i ∈ D i) → verify program fuel k D = true → False := by
  intro fuel
  induction fuel with
  | zero => simp [verify]
  | succ fuel ih =>
    intro k D fits result
    let n := program.getD k ([], 0, [])
    let reduced := n.1.foldl prune D
    have rem : ∀ i, C i ∈ reduced i := fold_safe proper n.1 fits
    change (reduced n.2.1).all _ = true at result
    have h := List.all_eq_true.mp result (C n.2.1) (rem n.2.1)
    cases find : n.2.2.find? (fun p => p.1 == C n.2.1) with
    | none =>
      rw [find] at h
      exact Bool.false_ne_true h
    | some p =>
      rw [find] at h
      apply ih p.2 (update reduced n.2.1 [C n.2.1]) ?_ h
      intro i
      by_cases hi : i = n.2.1
      · simp [update, hi]
      · simpa [update, hi] using rem i

