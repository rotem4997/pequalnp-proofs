def HT : Nat → Nat → Nat
  | 2, 0 => 0xdb082246
  | 3, 0 => 0xdb082246
  | _, _ => 0
def dictB : Nat → Nat → Nat
  | 0, 0 => 0x300000000000000000000000000000003000000000000000000000000000000020002000000000000000000000000000200020000000000000000000000000003000300000000000000000000000000000000
  | _, _ => 0
