theorem cFanIn : FanInTwo C := by
  intro g hg
  change g ∈ operations.map gate at hg
  obtain ⟨o, _, rfl⟩ := List.mem_map.mp hg
  by_cases h : o.1 = 0
  · simp [gate, h]
  · by_cases j : o.1 = 1 <;> simp [gate, h, j]

