def fwd (k : ℕ) (i : Fin 14) : Fin 14 :=
  ⟨((PL.getD k []).getD i.val 0) % 14, Nat.mod_lt _ (by norm_num)⟩

def bwd (k : ℕ) (i : Fin 14) : Fin 14 :=
  ⟨((IL.getD k []).getD i.val 0) % 14, Nat.mod_lt _ (by norm_num)⟩

theorem inv_ok : ∀ k : Fin 125, ∀ i : Fin 14,
    bwd k.val (fwd k.val i) = i ∧ fwd k.val (bwd k.val i) = i := by
  decide +kernel

theorem aut_ok : ∀ k : Fin 125, ∀ a b : Fin 14, R a b = true →
    (R (fwd k.val a) (fwd k.val b) || R (fwd k.val b) (fwd k.val a)) = true ∧
    (R (bwd k.val a) (bwd k.val b) || R (bwd k.val b) (bwd k.val a)) = true := by
  decide +kernel

def perm (k : Fin 125) : Equiv.Perm (Fin 14) where
  toFun := fwd k.val
  invFun := bwd k.val
  left_inv := fun i => (inv_ok k i).1
  right_inv := fun i => (inv_ok k i).2

theorem autP (k : Fin 125) (x : Fin 14 → Bool) : P (x ∘ ⇑(perm k)) ↔ P x := by
  constructor
  · rintro ⟨a, b, hab, ha, hb⟩
    have h := (aut_ok k a b hab).1
    simp only [Bool.or_eq_true] at h
    rcases h with h | h
    · exact ⟨fwd k.val a, fwd k.val b, h, ha, hb⟩
    · exact ⟨fwd k.val b, fwd k.val a, h, hb, ha⟩
  · rintro ⟨a, b, hab, ha, hb⟩
    have h := (aut_ok k a b hab).2
    simp only [Bool.or_eq_true] at h
    rcases h with h | h
    · refine ⟨bwd k.val a, bwd k.val b, h, ?_, ?_⟩
      · show x (fwd k.val (bwd k.val a)) = true
        rw [(inv_ok k a).2]; exact ha
      · show x (fwd k.val (bwd k.val b)) = true
        rw [(inv_ok k b).2]; exact hb
    · refine ⟨bwd k.val b, bwd k.val a, h, ?_, ?_⟩
      · show x (fwd k.val (bwd k.val b)) = true
        rw [(inv_ok k b).2]; exact hb
      · show x (fwd k.val (bwd k.val a)) = true
        rw [(inv_ok k a).2]; exact ha

def eF (i : Fin 21) : Fin 14 → Bool := fun x =>
  decide (x.val = (edges.getD i.val (0, 0)).1 ∨ x.val = (edges.getD i.val (0, 0)).2)

theorem edge_ok : ∀ a b : Fin 14, R a b = true →
    ∃ i : Fin 21, (edges.getD i.val (0, 0)).1 = a.val ∧ (edges.getD i.val (0, 0)).2 = b.val := by
  decide +kernel

theorem minimal_edge (x : Fin 14 → Bool) (h : Minimal P x) : ∃ i : Fin 21, x = eF i := by
  obtain ⟨⟨a, b, hab, ha, hb⟩, hmin⟩ := h
  obtain ⟨i, h1, h2⟩ := edge_ok a b hab
  refine ⟨i, ?_⟩
  have key : ∀ y, eF i y = true → x y = true := by
    intro y hy
    simp only [eF, decide_eq_true_eq, h1, h2] at hy
    rcases hy with hy | hy
    · rw [show y = a from Fin.ext hy]; exact ha
    · rw [show y = b from Fin.ext hy]; exact hb
  have hle : eF i ≤ x := by
    intro y
    have := key y
    revert this
    cases eF i y <;> cases x y <;> simp
  have hP : P (eF i) := ⟨a, b, hab, decide_eq_true (Or.inl h1.symm), decide_eq_true (Or.inr h2.symm)⟩
  exact le_antisymm (hmin hP hle) hle

def sel (i j : Fin 21) : ℕ × ℕ × Bool := (TT.getD i.val []).getD j.val (0, 0, false)

def cp (c : ℕ) : ℕ × ℕ :=
  [((129 : ℕ), (130 : ℕ)), ((129 : ℕ), (260 : ℕ)), ((129 : ℕ), (544 : ℕ))].getD c (0, 0)

theorem cp_mem : ∀ c < 3, cp c ∈ [((129 : ℕ), (130 : ℕ)), ((129 : ℕ), (260 : ℕ)), ((129 : ℕ), (544 : ℕ))] := by
  decide

theorem sel_ok : ∀ i j : Fin 21, i ≠ j →
    (sel i j).1 < 125 ∧ (sel i j).2.1 < 3 ∧
    (if (sel i j).2.2 then
      (∀ x : Fin 14, eF j x = (cp (sel i j).2.1).1.testBit (fwd (sel i j).1 x).val) ∧
      (∀ x : Fin 14, eF i x = (cp (sel i j).2.1).2.testBit (fwd (sel i j).1 x).val)
    else
      (∀ x : Fin 14, eF i x = (cp (sel i j).2.1).1.testBit (fwd (sel i j).1 x).val) ∧
      (∀ x : Fin 14, eF j x = (cp (sel i j).2.1).2.testBit (fwd (sel i j).1 x).val)) := by
  decide +kernel

theorem main : ∀ (x2 x3 : Fin (14 : ℕ) → Bool), Minimal P x2 → Minimal P x3 → x2 ≠ x3 → ∃ (x7 : Equiv.Perm (Fin (14 : ℕ))), ∃ x8 ∈ [((129 : ℕ), (130 : ℕ)), ((129 : ℕ), (260 : ℕ)), ((129 : ℕ), (544 : ℕ))], (∀ (x9 : Fin (14 : ℕ) → Bool), P (x9 ∘ ⇑x7) ↔ P x9) ∧ (((x2 = fun (x9 : Fin (14 : ℕ)) => x8.1.testBit ↑(x7 x9)) ∧ x3 = fun (x9 : Fin (14 : ℕ)) => x8.2.testBit ↑(x7 x9)) ∨ (x3 = fun (x9 : Fin (14 : ℕ)) => x8.1.testBit ↑(x7 x9)) ∧ x2 = fun (x9 : Fin (14 : ℕ)) => x8.2.testBit ↑(x7 x9)) := by
  intro x2 x3 h2 h3 hne
  obtain ⟨i, rfl⟩ := minimal_edge x2 h2
  obtain ⟨j, rfl⟩ := minimal_edge x3 h3
  have hij : i ≠ j := by
    rintro rfl
    exact hne rfl
  obtain ⟨hk, hc, hs⟩ := sel_ok i j hij
  refine ⟨perm ⟨(sel i j).1, hk⟩, cp (sel i j).2.1, cp_mem _ hc, autP _, ?_⟩
  cases hsel : (sel i j).2.2
  · rw [hsel] at hs
    simp only [Bool.false_eq_true, ↓reduceIte] at hs
    left
    exact ⟨funext hs.1, funext hs.2⟩
  · rw [hsel] at hs
    simp only [↓reduceIte] at hs
    right
    exact ⟨funext hs.1, funext hs.2⟩

