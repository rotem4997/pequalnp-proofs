namespace PEqualNP.MetaComplexity.L575Proof.EdgeFn

theorem stmtML_final : StmtML := ml_of_front stmtFront

end PEqualNP.MetaComplexity.L575Proof.EdgeFn

end

namespace PEqualNP.MetaComplexity.L575Proof.EdgeFn

theorem drop_internal {N s : ℕ} (F : (Fin N → Bool) → Bool) (D : Finset (Fin N))
    (hd : DeepHyp F D) (hne : D.Nonempty) (hs : HasCircuitSize N F s) :
    ∃ y ∈ D,
      (∃ s', s' + 3 ≤ s ∧ HasCircuitSize N (fun x => F (Function.update x y false)) s') ∨
      (∃ s', s' + 4 ≤ s ∧ HasCircuitSize N (fun x => F (Function.update x y true)) s') := by
  cases N with
  | zero => exact Fin.elim0 hne.choose
  | succ n => exact stmtML_final n F D s hd hne hs

end PEqualNP.MetaComplexity.L575Proof.EdgeFn

namespace PEqualNP.Outside.Path575

open PEqualNP.CircuitLowerBounds PEqualNP.MetaComplexity PEqualNP.MetaComplexity.L575Proof.Helpers

private theorem positive_of_changes_last {n s : ℕ} (f : (Fin (n+1) → Bool) → Bool) (b : Bool)
    (hd : ∃ x : Fin (n+1) → Bool, f (Function.update x (Fin.last n) (!(x (Fin.last n)))) ≠ f x)
    (hn : ∃ y y' : Fin n → Bool, f (Fin.snoc y b) ≠ f (Fin.snoc y' b))
    (hs : HasCircuitSize (n+1) f s) : 0 < s := by
  by_contra! hz
  rcases hs with ⟨C, _, hsize, hev⟩
  have glen : C.gates.length ≤ s := hsize
  have hg : C.gates = [] := List.length_eq_zero_iff.mp (by omega)
  have e (x : Fin (n+1) → Bool) : (List.ofFn x).getD C.output false = f x := by
    simpa [Circuit.eval, Circuit.wires, hg] using hev x
  obtain ⟨x, hx⟩ := hd
  by_cases hlt : C.output < n+1
  · let i : Fin (n+1) := ⟨C.output,hlt⟩
    have read (z : Fin (n+1) → Bool) : z i = f z := by
      have hz := e z
      rw [List.getD_eq_getElem _ _ (by simpa only [List.length_ofFn] using hlt),
        List.getElem_ofFn] at hz
      exact hz
    by_cases hi : i = Fin.last n
    · obtain ⟨u,v,huv⟩ := hn
      apply huv
      rw [←read, ←read, hi, Fin.snoc_last, Fin.snoc_last]
    · apply hx
      rw [←read, ←read, Function.update_of_ne hi]
  · have constant (z : Fin (n+1) → Bool) : false = f z := by
      simpa [List.getD, hlt] using e z
    exact hx ((constant _).symm.trans (constant _))

def terminalFun {n : ℕ} (f : (Fin n → Bool) → Bool) (v : Fin n)
    (x : Fin (n+2) → Bool) : Bool :=
  f (fun i => x i.castSucc.castSucc) ||
    (x (Fin.last n).castSucc && (x v.castSucc.castSucc || x (Fin.last (n+1))))

private def terminalRem {n : ℕ} (f : (Fin n → Bool) → Bool) (v : Fin n) (b : Bool)
    (x : Fin (n+1) → Bool) : Bool :=
  f (fun i => x i.castSucc) || (x (Fin.last n) && (x v.castSucc || b))

theorem terminal_pair {n s : ℕ} (f : (Fin n → Bool) → Bool) (v : Fin n)
    (hn : ∃ u w : Fin n → Bool, f u ≠ f w)
    (h0 : ∃ u : Fin n → Bool, u v = false ∧ f u = false)
    (h1 : ∃ u : Fin n → Bool, u v = true ∧ f u = false)
    (hs : HasCircuitSize (n+2) (terminalFun f v) s) :
    ∃ c, HasCircuitSize n f c ∧ c+3 ≤ s := by
  obtain ⟨x0,hu0,hf0⟩ := h0
  obtain ⟨x1,hu1,hf1⟩ := h1
  have hdep : ∃ x : Fin (n+2) → Bool,
      terminalFun f v (Function.update x (Fin.last (n+1)) (!(x (Fin.last (n+1))))) ≠ terminalFun f v x := by
    refine ⟨Fin.snoc (Fin.snoc x0 true) false,?_⟩
    simp [terminalFun,Function.update_of_ne,Fin.castSucc_ne_last,hu0,hf0]
  have hncb (b : Bool) : ∃ u w : Fin (n+1) → Bool,
      terminalFun f v (Fin.snoc u b) ≠ terminalFun f v (Fin.snoc w b) := by
    obtain ⟨u,w,huw⟩ := hn
    exact ⟨Fin.snoc u false,Fin.snoc w false,by simpa [terminalFun] using huw⟩
  obtain ⟨b,k,hk,hr⟩ := gate_elim_two (n+1) (terminalFun f v) s hdep hncb hs
  have hr' : HasCircuitSize (n+1) (terminalRem f v b) k := by
    change HasCircuitSize (n+1) (fun y => f (fun i => y i.castSucc) || (y (Fin.last n) && (y v.castSucc || b))) k
    simpa [terminalFun] using hr
  have hda : ∃ x : Fin (n+1) → Bool,
      terminalRem f v b (Function.update x (Fin.last n) (!(x (Fin.last n)))) ≠ terminalRem f v b x := by
    refine ⟨Fin.snoc x1 false,?_⟩
    simp [terminalRem,Function.update_of_ne,Fin.castSucc_ne_last,hu1,hf1]
  have hna : ∃ u w : Fin n → Bool,
      terminalRem f v b (Fin.snoc u false) ≠ terminalRem f v b (Fin.snoc w false) := by
    simpa [terminalRem] using hn
  have hpos := positive_of_changes_last (terminalRem f v b) false hda hna hr'
  obtain ⟨c,rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hpos)
  have hfinal := gate_elim n (terminalRem f v b) false c hda hna hr'
  exact ⟨c,by simpa [terminalRem] using hfinal,by omega⟩

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

def links (root : Bool) : List Bool → Bool
  | [] => false
  | a::xs => (a && xs.headD root) || links root xs

private theorem links_cons (r x : Bool) (xs : List Bool) :
    links r (x::xs) = ((x && xs.headD r) || links r xs) := rfl

private theorem links_append (r : Bool) (a b : List Bool) :
    links r (a++b) = (links (b.headD r) a || links r b) := by
  induction a with
  | nil => simp [links]
  | cons x xs ih =>
    have hd : (xs++b).headD r = xs.headD (b.headD r) := by cases xs <;> rfl
    simp only [List.cons_append,links_cons,hd,ih,Bool.or_assoc]

private theorem links_last (r : Bool) (xs : List Bool) :
    links r xs = (links false xs || (xs.getLastD false && r)) := by
  induction xs with
  | nil => simp [links]
  | cons x xs ih =>
    cases xs with
    | nil => simp [links]
    | cons y ys =>
      change ((x && y) || links r (y::ys)) = (((x && y) || links false (y::ys)) || ((x::y::ys).getLastD false && r))
      rw [ih,Bool.or_assoc]
      rfl

private theorem links_reverse (xs : List Bool) : links false xs.reverse = links false xs := by
  induction xs with
  | nil => rfl
  | cons x xs ih =>
    rw [List.reverse_cons,links_append,links_last (r:=([x] : List Bool).headD false) xs.reverse,ih]
    simp [links,Bool.and_comm,Bool.or_comm]

private theorem end_reverse (root : Bool) (xs : List Bool) :
    links false (root::xs) = links root xs.reverse := by
  rw [←links_reverse (root::xs),List.reverse_cons,links_append]
  simp [links]

theorem cut_fresh_false (u v : Bool) (a b : List Bool) :
    links v (u::(a ++ false::b)) = (links u a.reverse || links v b) := by
  change links v ((u::a) ++ false::b) = _
  rw [links_append]
  change (links false (u::a) || links v (false::b)) = _
  rw [end_reverse,links_cons]
  simp

theorem cut_fresh_true (u v l r : Bool) (a b : List Bool) :
    links v (u::(a ++ l::true::r::b)) = (links u a.reverse || links v b || l || r) := by
  change links v ((u::a) ++ l::true::r::b) = _
  rw [links_append,links_last (r:=(l::true::r::b).headD v) (u::a),end_reverse]
  simp only [links,List.headD_cons,Bool.and_true,Bool.true_and]
  cases l <;> cases r <;> simp

theorem links_peel (root a b : Bool) (xs : List Bool) :
    links root (b::a::xs) = (links root xs || (a && (xs.headD root || b))) := by
  simp only [links,List.headD_cons]
  cases a <;> cases b <;> simp [Bool.or_comm]

def oldBits {N f : ℕ} (x : Fin (N+f) → Bool) (i : Fin N) := x (Fin.castAdd f i)
def freshBits {N f : ℕ} (x : Fin (N+f) → Bool) (i : Fin f) := x (Fin.natAdd N i)

def twoArms {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N)
    (a b : List (Fin m)) (x : Fin (N+m) → Bool) : Bool :=
  g (oldBits x) || links (oldBits x u) (a.map (freshBits x)) || links (oldBits x v) (b.map (freshBits x))

private theorem links_zero (root : Bool) (l : List Bool) (hz : ∀ b ∈ l, b = false) : links root l = false := by
  induction l with
  | nil => rfl
  | cons b l ih => simp [links,hz b List.mem_cons_self,ih (fun x hx => hz x (List.mem_cons_of_mem _ hx))]

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open scoped Classical
open PEqualNP.MetaComplexity.L575Proof.Helpers.Readers PEqualNP.MetaComplexity.L575Proof.EdgeFn

def route {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool) (x : Fin (N+m) → Bool) : Bool :=
  g (fun i => x (Fin.castAdd m i)) || decide (∃ i : Fin m, x (Fin.natAdd N i) = true ∧
    ((i.val = 0 ∧ x (Fin.castAdd m u) = true) ∨ (i.val+1=m ∧ x (Fin.castAdd m v) = true) ∨
    ∃ j : Fin m, j.val=i.val+1 ∧ x (Fin.natAdd N j) = true))

def pathInterior (N m : ℕ) : Finset (Fin (N+m)) :=
  Finset.univ.filter fun i => N < i.val ∧ i.val+1 < N+m

private theorem old_not_in {N m : ℕ} (i : Fin N) : Fin.castAdd m i ∉ pathInterior N m := by
  simp [pathInterior,Fin.castAdd]

private theorem tail_in {N m : ℕ} (i : Fin m) :
    Fin.natAdd N i ∈ pathInterior N m ↔ 0 < i.val ∧ i.val+1 < m := by
  simp [pathInterior,Fin.natAdd] <;> omega

private theorem mem_tail {N m : ℕ} (y : Fin (N+m)) (hy : y ∈ pathInterior N m) :
    ∃ i : Fin m, 0 < i.val ∧ i.val+1 < m ∧ y = Fin.natAdd N i := by
  have hh : N < y.val ∧ y.val+1 < N+m := (Finset.mem_filter.mp hy).2
  refine ⟨⟨y.val-N,by omega⟩,by simp <;> omega,by simp <;> omega,Fin.ext ?_⟩
  simp [Fin.natAdd] <;> omega

private theorem old_ne_tail {N m : ℕ} (i : Fin N) (j : Fin m) :
    Fin.castAdd m i ≠ Fin.natAdd N j := by
  intro h
  have e := congrArg Fin.val h
  simp only [Fin.val_castAdd,Fin.val_natAdd] at e
  omega

private theorem update_append {N m : ℕ} (old : Fin N → Bool) (w : Fin m → Bool)
    (i : Fin m) (b : Bool) :
    Function.update (Fin.append old w) (Fin.natAdd N i) b =
      Fin.append old (Function.update w i b) := by
  funext j
  refine Fin.addCases (fun o => ?_) (fun k => ?_) j
  · simp [Function.update_of_ne (old_ne_tail _ _)]
  · by_cases h : k=i
    · simp [h]
    · have hni : Fin.natAdd N k ≠ Fin.natAdd N i :=
        fun e => h (Fin.ext (Nat.add_left_cancel (congrArg Fin.val e)))
      simp [Function.update_of_ne h,Function.update_of_ne hni]

private theorem route_append {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (old : Fin N → Bool) (w : Fin m → Bool) :
    route u v g (Fin.append old w) = true ↔ g old = true ∨
      (∃ i : Fin m, w i = true ∧ ((i.val=0 ∧ old u=true) ∨ (i.val+1=m ∧ old v=true) ∨
        ∃ j : Fin m, j.val=i.val+1 ∧ w j=true)) := by simp [route]

private theorem single_probe {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (old : Fin N → Bool) (hg : g old = false)
    (y z k : Fin m) (hy : 0 < y.val ∧ y.val+1 < m) (hz : 0 < z.val ∧ z.val+1 < m)
    (hyz : y ≠ z) (hyk : y.val+1=k.val ∨ k.val+1=y.val)
    (hzk : z.val+1 ≠ k.val ∧ k.val+1 ≠ z.val ∧ z ≠ k)
    (hleft : k.val=0 → old u=false) (hright : k.val+1=m → old v=false)
    (a b : Bool) :
    route u v g (set2 (Fin.append old (fun i => decide (i=k)))
        (Fin.natAdd N y) a (Fin.natAdd N z) b) = a := by
  simp only [set2,update_append]
  apply Bool.eq_iff_iff.mpr
  rw [route_append]
  have hky : k≠y := by intro e; subst e; omega
  have hx (i : Fin m) :
      Function.update (Function.update (fun i : Fin m => decide (i=k)) y a) z b i = true ↔
      (i=z ∧ b=true) ∨ (i=y ∧ a=true) ∨ i=k := by
    by_cases iz : i=z <;> by_cases iy : i=y <;>
      simp_all [Function.update_of_ne,Ne.symm hky]
  simp only [hg,hx]
  constructor
  · rintro (hfalse | ⟨i,hi,hh⟩)
    · contradiction
    · by_contra ha
      have choices (l : Fin m) (hl : (l=z ∧ b=true) ∨ (l=y ∧ a=true) ∨ l=k) : l=z ∨ l=k := by
        rcases hl with ⟨e,_⟩|⟨_,h⟩|e
        · exact Or.inl e
        · contradiction
        · exact Or.inr e
      rcases hh with ⟨h0,hu⟩|⟨hN,hv⟩|⟨j,hij,hj⟩
      · rcases choices i hi with rfl|rfl
        · omega
        · rw [hleft h0] at hu
          contradiction
      · rcases choices i hi with rfl|rfl
        · omega
        · rw [hright hN] at hv
          contradiction
      · rcases choices i hi with rfl|rfl <;> rcases choices j hj with rfl|rfl <;> omega
  · intro ha
    apply Or.inr
    rcases hyk with hi|hi
    · exact ⟨y,Or.inr (Or.inl ⟨rfl,ha⟩),Or.inr (Or.inr ⟨k,hi.symm,Or.inr (Or.inr rfl)⟩)⟩
    · exact ⟨k,Or.inr (Or.inr rfl),Or.inr (Or.inr ⟨y,hi.symm,Or.inr (Or.inl ⟨rfl,ha⟩)⟩)⟩

private theorem independent_probe {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hu : ∃ w, w u = false ∧ g w = false) (hv : ∃ w, w v = false ∧ g w = false)
    (y z : Fin m) (hy : 0 < y.val ∧ y.val+1 < m) (hz : 0 < z.val ∧ z.val+1 < m)
    (hne : y ≠ z) :
    ∃ x : Fin (N+m) → Bool, ∀ a b, route u v g (set2 x (Fin.natAdd N y) a (Fin.natAdd N z) b) = a := by
  have hn : y.val ≠ z.val := fun e => hne (Fin.ext e)
  by_cases hlt : y.val < z.val
  · obtain ⟨w,hw,hg⟩ := hu
    let k : Fin m := ⟨y.val-1,by omega⟩
    have hk : k.val = y.val-1 := rfl
    refine ⟨Fin.append w (fun i => decide (i=k)),fun a b => single_probe u v g w hg y z k hy hz hne
      (Or.inr (by omega)) ⟨by omega,by omega,?_⟩ (fun _ => hw) (fun h => by omega) a b⟩
    intro he
    have := congrArg Fin.val he
    omega
  · obtain ⟨w,hw,hg⟩ := hv
    let k : Fin m := ⟨y.val+1,by omega⟩
    have hk : k.val = y.val+1 := rfl
    refine ⟨Fin.append w (fun i => decide (i=k)),fun a b => single_probe u v g w hg y z k hy hz hne
      (Or.inl (by omega)) ⟨by omega,by omega,?_⟩ (fun h => by omega) (fun _ => hw) a b⟩
    intro he
    have := congrArg Fin.val he
    omega

private theorem route_window {N m : ℕ} (hm : 6 ≤ m) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (y : Fin m) (hy : 0 < y.val ∧ y.val+1 < m) (x : Fin (N+m) → Bool)
    (hzero : route u v g (zeroOn (pathInterior N m) x) = false) :
    ∃ x', (∀ i, i ∉ pathInterior N m → x' i = x i) ∧ x' (Fin.natAdd N y) = false ∧
      route u v g x' = false ∧ route u v g (Function.update x' (Fin.natAdd N y) true) = true := by
  obtain ⟨z,hz,hzy⟩ : ∃ z : Fin m, (2 ≤ z.val ∧ z.val+2 < m) ∧
      (z.val+1=y.val ∨ y.val+1=z.val) := by
    by_cases hi : y.val+3 < m
    · exact ⟨⟨y.val+1,by omega⟩,⟨by simp <;> omega,by simp <;> omega⟩,Or.inr rfl⟩
    · exact ⟨⟨y.val-1,by omega⟩,⟨by simp <;> omega,by simp <;> omega⟩,Or.inl (by simp <;> omega)⟩
  let D := pathInterior N m
  let base := zeroOn D x
  let w := Function.update base (Fin.natAdd N z) true
  have iz : Fin.natAdd N z ∈ D := (tail_in (N:=N) z).mpr ⟨by omega,by omega⟩
  have iy : Fin.natAdd N y ∈ D := (tail_in (N:=N) y).mpr hy
  have yz : Fin.natAdd N y ≠ Fin.natAdd N z := by
    intro e
    have es := congrArg Fin.val e
    simp only [Fin.val_natAdd] at es
    omega
  have same (i : Fin (N+m)) (hi : i ∉ D) : w i = x i := by
    have hne : i ≠ Fin.natAdd N z := fun he => hi (he ▸ iz)
    simp [w,base,zeroOn,hi,Function.update_of_ne hne]
  have old (i : Fin N) : w (Fin.castAdd m i) = base (Fin.castAdd m i) := by
    simp [w,Function.update_of_ne (old_ne_tail i z)]
  have edge_rule (o : Fin m) (ho : w (Fin.natAdd N o) = true) :
      o.val=0 ∨ o.val+1=m ∨ o=z := by
    by_cases he : o=z
    · exact Or.inr (Or.inr he)
    by_contra! bad
    have hin := (tail_in (N:=N) o).mpr (by omega)
    have hn : Fin.natAdd N o ≠ Fin.natAdd N z :=
      fun e => he (Fin.ext (Nat.add_left_cancel (congrArg Fin.val e)))
    simp [w,base,zeroOn,Function.update_of_ne hn,hin,D] at ho
  have endpoint (o : Fin m) (ho : o.val=0 ∨ o.val+1=m) : w (Fin.natAdd N o) = base (Fin.natAdd N o) := by
    have he : o.val ≠ z.val := by omega
    have hn : Fin.natAdd N o ≠ Fin.natAdd N z := fun e => he (Nat.add_left_cancel (congrArg Fin.val e))
    exact Function.update_of_ne hn _ _
  refine ⟨w,same,?_,?_,?_⟩
  · simp [w,base,zeroOn,Function.update_of_ne yz,iy]
  · by_contra! hw
    have he : route u v g w = true := by cases h : route u v g w <;> simp_all
    have hb : route u v g base = true := by
      simp only [route,Bool.or_eq_true,decide_eq_true_eq] at he ⊢
      rcases he with hg|⟨i,hi,⟨hL,hvL⟩|⟨hR,hvR⟩|⟨j,hj,hjOn⟩⟩
      · exact Or.inl (by simpa only [old] using hg)
      · exact Or.inr ⟨i,by rwa [endpoint i (Or.inl hL)] at hi, Or.inl ⟨hL,by rwa [old] at hvL⟩⟩
      · exact Or.inr ⟨i,by rwa [endpoint i (Or.inr hR)] at hi, Or.inr (Or.inl ⟨hR,by rwa [old] at hvR⟩)⟩
      · rcases edge_rule i hi with hi0|hiN|rfl <;> rcases edge_rule j hjOn with hj0|hjN|rfl <;> omega
    exact Bool.noConfusion (hb.symm.trans hzero)
  · simp only [route,Bool.or_eq_true,decide_eq_true_eq]
    have hyOn : Function.update w (Fin.natAdd N y) true (Fin.natAdd N y) = true := by simp
    have hzOn : Function.update w (Fin.natAdd N y) true (Fin.natAdd N z) = true := by
      simp [Function.update_of_ne yz.symm,w]
    rcases hzy with he|he
    · exact Or.inr ⟨z,hzOn,Or.inr (Or.inr ⟨y,he.symm,hyOn⟩)⟩
    · exact Or.inr ⟨y,hyOn,Or.inr (Or.inr ⟨z,he.symm,hzOn⟩)⟩

theorem route_deep {N m : ℕ} (hm : 6 ≤ m) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (hu : ∃ w, w u = false ∧ g w = false) (hv : ∃ w, w v = false ∧ g w = false) :
    DeepHyp (route (m:=m) u v g) (pathInterior N m) := by
  constructor
  · intro y hy b
    obtain ⟨i,h0,h1,rfl⟩ := mem_tail y hy
    obtain ⟨j,hj,hne⟩ : ∃ j : Fin m, (0 < j.val ∧ j.val+1 < m) ∧ j ≠ i := by
      by_cases hi : i.val=1
      · refine ⟨⟨2,by omega⟩,by simp <;> omega,?_⟩
        intro he
        have := congrArg Fin.val he
        simp at this
        omega
      · refine ⟨⟨1,by omega⟩,by simp <;> omega,?_⟩
        intro he
        exact hi (congrArg Fin.val he).symm
    obtain ⟨x,hx⟩ := independent_probe u v g hu hv j i hj ⟨h0,h1⟩ hne
    refine ⟨Function.update x (Fin.natAdd N j) false,Function.update x (Fin.natAdd N j) true,?_⟩
    change route u v g (set2 x _ false _ b) ≠ route u v g (set2 x _ true _ b)
    rw [hx false b,hx true b]
    decide
  · intro y hy z hz hne hf
    obtain ⟨i,hi,hi',rfl⟩ := mem_tail y hy
    obtain ⟨j,hj,hj',rfl⟩ := mem_tail z hz
    have hi'j : i ≠ j := fun e => hne (congrArg _ e)
    obtain ⟨x,hx⟩ := independent_probe u v g hu hv i j ⟨hi,hi'⟩ ⟨hj,hj'⟩ hi'j
    obtain ⟨a,b,hab⟩ := hf
    have hbad := (hab x).1
    rw [hx,hx] at hbad
    cases a <;> contradiction
  · intro y hy x hzero
    obtain ⟨i,h0,h1,rfl⟩ := mem_tail y hy
    exact route_window hm u v g i ⟨h0,h1⟩ x hzero
  · intro x hh
    have told (i : Fin N) : zeroOn (pathInterior N m) x (Fin.castAdd m i) = x (Fin.castAdd m i) := by
      simp [zeroOn,old_not_in]
    have tnew (i : Fin m) (hi : zeroOn (pathInterior N m) x (Fin.natAdd N i) = true) :
        x (Fin.natAdd N i) = true := by
      by_cases he : Fin.natAdd N i ∈ pathInterior N m <;> simp_all [zeroOn]
    simp only [route,Bool.or_eq_true,decide_eq_true_eq,told] at hh ⊢
    rcases hh with h|⟨i,hi,h⟩
    · exact Or.inl h
    · refine Or.inr ⟨i,tnew i hi,?_⟩
      rcases h with h|h|⟨j,hj,hjOn⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl h)
      · exact Or.inr (Or.inr ⟨j,hj,tnew j hjOn⟩)

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open PEqualNP.MetaComplexity

def anchor {N m : ℕ} (u : Fin N) : List (Fin m) → Fin (N+m)
  | [] => u.castAdd m
  | j::_ => j.natAdd N

private theorem links_zeros (p : Bool) (n : Nat) : links p (List.replicate n false) = false := by
  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ,links,ih]

private theorem asgn_old {N m : Nat} (a : Fin N → Bool) (z : Fin m → Bool) : oldBits (Fin.append a z) = a := by
  funext i; exact Fin.append_left a z i
private theorem asgn_fresh {N m : Nat} (a : Fin N → Bool) (z : Fin m → Bool) : freshBits (Fin.append a z) = z := by
  funext i; exact Fin.append_right a z i

private theorem all_off {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N)
    (A B : List (Fin m)) (z : Fin N → Bool) : twoArms g u v A B (Fin.append z (fun _ => false)) = g z := by
  simp [twoArms,asgn_old,asgn_fresh,links_zeros]

private theorem arm_nonconst {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N)
    (A B : List (Fin m)) (hn : ∃ x y, g x ≠ g y) : ∃ x y, twoArms g u v A B x ≠ twoArms g u v A B y := by
  obtain ⟨x,y,h⟩ := hn
  exact ⟨Fin.append x (fun _ => false),Fin.append y (fun _ => false),by simpa only [all_off] using h⟩

private theorem off_map {m : ℕ} (i : Fin m) (b : Bool) (L : List (Fin m)) (hi : i ∉ L) :
    L.map (fun j => if j=i then b else false) = List.replicate L.length false := by
  induction L with
  | nil => rfl
  | cons r L ih =>
    have hr : r ≠ i := fun h => hi (h ▸ List.mem_cons_self)
    have hl : i ∉ L := fun h => hi (List.mem_cons_of_mem _ h)
    rw [List.map_cons,ite_eq_right hr,ih hl,List.length_cons,List.replicate_succ]

private theorem anchor_witness {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N)
    (A B : List (Fin m)) (dist : (A++B).Nodup)
    (hu : ∀ b : Bool, ∃ z, z u = b ∧ g z = false) (b : Bool) :
    ∃ x, x (anchor u A) = b ∧ twoArms g u v A B x = false := by
  cases A with
  | nil =>
    obtain ⟨z,hz,hg⟩ := hu b
    exact ⟨Fin.append z (fun _ => false),(Fin.append_left _ _ _).trans hz,(all_off ..).trans hg⟩
  | cons a A =>
    obtain ⟨z,hz,hg⟩ := hu false
    have hnot : a ∉ A++B := (List.nodup_cons.mp dist).1
    have hA := off_map a b A (fun ha => hnot (List.mem_append_left _ ha))
    have hB := off_map a b B (fun hb => hnot (List.mem_append_right _ hb))
    let aux : Fin m → Bool := fun j => if j=a then b else false
    refine ⟨Fin.append z aux,?_,?_⟩
    · simp [anchor,Fin.append_right,aux]
    · simp only [twoArms,asgn_old,asgn_fresh,hg,hz,List.map_cons,aux,ite_true,hA,hB,links_zeros,Bool.false_or,Bool.or_false]
      rw [links_cons,links_zeros]
      cases A.length <;> simp [List.replicate_succ]

private theorem arms_unchanged {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N)
    (A B : List (Fin m)) (x y : Fin (N+m) → Bool) (hold : oldBits x= oldBits y)
    (h : ∀ i ∈ A++B, freshBits x i = freshBits y i) : twoArms g u v A B x = twoArms g u v A B y := by
  have left := List.map_congr_left (l:=A) (fun i hi => h i (List.mem_append_left _ hi))
  have right := List.map_congr_left (l:=B) (fun i hi => h i (List.mem_append_right _ hi))
  simp only [twoArms,hold,left,right]

private theorem fresh_inj {N m : ℕ} {a b : Fin m} (h : a.natAdd N = b.natAdd N) : a=b := by
  apply Fin.ext; have e := congrArg Fin.val h; simp only [Fin.val_natAdd] at e; omega

private theorem old_ne_fresh {N m : ℕ} (u : Fin N) (a : Fin m) : Fin.castAdd m u ≠ a.natAdd N := by
  intro he; have e := congrArg Fin.val he; simp only [Fin.val_castAdd,Fin.val_natAdd] at e; omega

def Relabel575 : Prop := ∀ {n m : ℕ} (p : Fin n → Fin m) (H : (Fin n → Bool) → Bool) (s : ℕ),
  HasCircuitSize n H s → HasCircuitSize m (fun x => H (x ∘ p)) s

def Pair575 : Prop := ∀ {n s : ℕ} (f : (Fin n → Bool) → Bool) (v : Fin n),
  (∃ x y, f x ≠ f y) → (∃ x, x v = false ∧ f x = false) → (∃ x, x v = true ∧ f x = false) →
  HasCircuitSize (n+2) (terminalFun f v) s → ∃ c, HasCircuitSize n f c ∧ c+3 ≤ s

private theorem peel_left {N m s : ℕ} (relabel : Relabel575) (pair : Pair575)
    (g : (Fin N → Bool) → Bool) (u v : Fin N) (a b : Fin m) (A B : List (Fin m))
    (dist : ((b::a::A)++B).Nodup) (hn : ∃ x y, g x ≠ g y)
    (hu : ∀ w : Bool, ∃ z, z u = w ∧ g z = false)
    (hs : HasCircuitSize (N+m) (twoArms g u v (b::a::A) B) s) :
    ∃ c, HasCircuitSize (N+m) (twoArms g u v A B) c ∧ c+3 ≤ s := by
  let n := N+m
  let y := a.natAdd N
  let z := b.natAdd N
  let q := anchor u A
  let F := twoArms g u v A B
  have db := List.nodup_cons.mp dist
  have da := List.nodup_cons.mp db.2
  have hba : b ≠ a := fun h => db.1 (h ▸ List.mem_cons_self)
  have hyz : y ≠ z := fun h => hba (fresh_inj h).symm
  have avoid (j : Fin m) (hj : j ∈ A++B) : j ≠ a ∧ j ≠ b :=
    ⟨fun h => da.1 (h ▸ hj),fun h => db.1 (List.mem_cons_of_mem _ (h ▸ hj))⟩
  let p (i : Fin n) : Fin (n+2) := if i=y then (Fin.last n).castSucc else if i=z then Fin.last (n+1) else i.castSucc.castSucc
  have py : p y = (Fin.last n).castSucc := by simp [p]
  have pz : p z = Fin.last (n+1) := by simp [p,hyz.symm]
  have keep (j : Fin m) (hj : j ∈ A++B) : p (j.natAdd N) = (j.natAdd N).castSucc.castSucc := by
    have e1 : j.natAdd N ≠ y := fun e => (avoid _ hj).1 (fresh_inj e)
    have e2 : j.natAdd N ≠ z := fun e => (avoid _ hj).2 (fresh_inj e)
    simp only [p,ite_eq_right e1,ite_eq_right e2]
  have keepOld (i : Fin N) : p (i.castAdd m) = (i.castAdd m).castSucc.castSucc := by
    have e1 : i.castAdd m ≠ y := old_ne_fresh i a
    have e2 : i.castAdd m ≠ z := old_ne_fresh i b
    simp only [p,ite_eq_right e1,ite_eq_right e2]
  have hs' := relabel p _ s hs
  have eq : (fun x => twoArms g u v (b::a::A) B (x ∘ p)) = terminalFun F q := by
    funext x
    let base := fun i : Fin n => x i.castSucc.castSucc
    have hf : F (x∘p)=F base := arms_unchanged g u v A B _ _
      (funext fun i => congrArg x (keepOld i)) (fun i hi => congrArg x (keep i hi))
    have hend : (A.map (freshBits (x∘p))).headD (oldBits (x∘p) u) = base q := by
      cases A with
      | nil => exact congrArg x (keepOld u)
      | cons j js => exact congrArg x (keep j (List.mem_append_left _ List.mem_cons_self))
    change (g (oldBits (x∘p)) || links (oldBits (x∘p) u) ((x (p z))::(x (p y))::A.map (freshBits (x∘p))) || links (oldBits (x∘p) v) (B.map (freshBits (x∘p)))) = _
    rw [links_peel,py,pz,hend]
    change _ = (F base || _)
    rw [←hf]
    dsimp only [F,twoArms]
    ac_rfl
  rw [eq] at hs'
  exact pair F q (arm_nonconst _ _ _ _ _ hn) (anchor_witness _ _ _ _ _ da.2 hu false)
    (anchor_witness _ _ _ _ _ da.2 hu true) hs'

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open PEqualNP.MetaComplexity

private theorem strip_left {N m : ℕ} (relabel : Relabel575) (pair : Pair575)
    (g : (Fin N → Bool) → Bool) (u v : Fin N) (hn : ∃ x y, g x ≠ g y)
    (hu : ∀ b : Bool, ∃ z, z u = b ∧ g z = false) (B : List (Fin m)) :
    ∀ (A : List (Fin m)) (s : ℕ), (A++B).Nodup → HasCircuitSize (N+m) (twoArms g u v A B) s →
      ∃ (U : List (Fin m)) (c : ℕ), U.Sublist A ∧ U.length = A.length % 2 ∧
        HasCircuitSize (N+m) (twoArms g u v U B) c ∧ 3*(A.length/2)+c ≤ s := by
  intro A s
  generalize hd : A.length = d
  induction d using Nat.strong_induction_on generalizing A s with
  | ind d ih =>
    intro dist size
    cases A with
    | nil => subst d; exact ⟨[],s,List.Sublist.refl _,rfl,size,by simp⟩
    | cons b A =>
      cases A with
      | nil => subst d; exact ⟨[b],s,List.Sublist.refl _,rfl,size,by simp⟩
      | cons a A =>
        obtain ⟨c,hc,hcost⟩ := peel_left relabel pair g u v a b A B dist hn hu size
        have short : A.length < d := by simp only [List.length_cons] at hd; omega
        have hd' : (A++B).Nodup := (List.nodup_cons.mp (List.nodup_cons.mp dist).2).2
        obtain ⟨U,s',sub,par,rem,paid⟩ := ih A.length short A c rfl hd' hc
        exact ⟨U,s',(sub.cons a).cons b,by simp only [List.length_cons] at hd; omega,rem,
          by simp only [List.length_cons] at hd; omega⟩

private theorem swap_arms {N m : ℕ} (g : (Fin N → Bool) → Bool) (u v : Fin N) (A B : List (Fin m)) :
    twoArms g u v A B = twoArms g v u B A := by
  funext x
  unfold twoArms
  ac_rfl

def pendant575 {N : ℕ} (g : (Fin N → Bool) → Bool) (v : Fin N) (x : Fin (N+1) → Bool) :=
  g (fun i => x i.castSucc) || (x v.castSucc && x (Fin.last N))

private theorem single_to_pendant {N m s : ℕ} (relabel : Relabel575) (g : (Fin N → Bool) → Bool)
    (u v : Fin N) (a : Fin m) (h : HasCircuitSize (N+m) (twoArms g u v [a] []) s) :
    HasCircuitSize (N+1) (pendant575 g u) s := by
  let p : Fin (N+m) → Fin (N+1) := Fin.append Fin.castSucc (fun _ => Fin.last N)
  have eq : (fun x => twoArms g u v [a] [] (x∘p)) = pendant575 g u := by
    funext x
    have hO : oldBits (x∘p) = fun i => x i.castSucc := funext fun i => congrArg x (Fin.append_left _ _ i)
    have hA : freshBits (x∘p) a = x (Fin.last N) := congrArg x (Fin.append_right _ _ a)
    simp [twoArms,pendant575,hO,hA,links,Bool.and_comm]
  exact eq ▸ relabel p _ s h

theorem arms_to_pendant {N m s : ℕ} (relabel : Relabel575) (pair : Pair575)
    (g : (Fin N → Bool) → Bool) (u v : Fin N) (hn : ∃ x y, g x ≠ g y)
    (hu : ∀ b : Bool, ∃ z, z u=b ∧ g z=false) (hv : ∀ b : Bool, ∃ z, z v=b ∧ g z=false)
    (A B : List (Fin m)) (dist : (A++B).Nodup) (odd : (A.length+B.length) % 2=1)
    (size : HasCircuitSize (N+m) (twoArms g u v A B) s) :
    ∃ c : ℕ, 3*((A.length+B.length)/2)+c ≤ s ∧
      (HasCircuitSize (N+1) (pendant575 g u) c ∨ HasCircuitSize (N+1) (pendant575 g v) c) := by
  obtain ⟨U,s₁,sub,par,hrem,hpaid⟩ := strip_left relabel pair g u v hn hu B A s dist size
  rw [swap_arms] at hrem
  have d' : (B++U).Nodup := List.nodup_append_comm.mp ((sub.append_right B).nodup dist)
  obtain ⟨V,c,_,par',hc,hpaid'⟩ := strip_left relabel pair g v u hn hv U B s₁ d' hrem
  refine ⟨c,by omega,?_⟩
  have hs : U.length+V.length=1 := by omega
  cases U with
  | nil =>
    cases V with
    | nil => simp at hs
    | cons j V =>
      have he : V=[] := List.length_eq_zero_iff.mp (by simp only [List.length_cons] at hs; omega)
      subst V
      exact Or.inr (single_to_pendant relabel g v u j hc)
  | cons i U =>
    have he : U=[] := List.length_eq_zero_iff.mp (by simp only [List.length_cons] at hs; omega)
    have he' : V=[] := List.length_eq_zero_iff.mp (by simp only [List.length_cons] at hs; omega)
    subst U V
    rw [swap_arms] at hc
    exact Or.inl (single_to_pendant relabel g u v i hc)

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open PEqualNP.MetaComplexity

def LastDrop575 : Prop := ∀ (n : ℕ) (F : (Fin (n+1) → Bool) → Bool) (b : Bool) (s : ℕ),
  (∃ x, F (Function.update x (Fin.last n) (!(x (Fin.last n)))) ≠ F x) →
  (∃ u v : Fin n → Bool, F (Fin.snoc u b) ≠ F (Fin.snoc v b)) →
  HasCircuitSize (n+1) F (s+1) → HasCircuitSize n (fun x => F (Fin.snoc x b)) s

theorem appended_or_drop {n s : ℕ} (gate : LastDrop575) (f : (Fin n → Bool) → Bool) (hn : ∃ x y, f x ≠ f y)
    (hs : HasCircuitSize (n+1) (fun x => f (fun i => x i.castSucc) || x (Fin.last n)) s) :
    ∃ c, HasCircuitSize n f c ∧ c+1 ≤ s := by
  let F (x : Fin (n+1) → Bool) := f (fun i => x i.castSucc) || x (Fin.last n)
  have off : ∃ x, f x = false := by
    obtain ⟨x,y,h⟩ := hn
    by_cases hx : f x = false
    · exact ⟨x,hx⟩
    · exact ⟨y,by cases hy : f y <;> cases hz : f x <;> simp_all⟩
  obtain ⟨x,hx⟩ := off
  have hd : ∃ z, F (Function.update z (Fin.last n) (!(z (Fin.last n)))) ≠ F z := by
    refine ⟨Fin.snoc x false,?_⟩
    simp [F,Function.update_of_ne,Fin.castSucc_ne_last,hx]
  have hr : ∃ u w : Fin n → Bool, F (Fin.snoc u false) ≠ F (Fin.snoc w false) := by simpa [F] using hn
  have pos := positive_of_changes_last F false hd hr hs
  obtain ⟨c,rfl⟩ := Nat.exists_eq_succ_of_ne_zero pos.ne'
  exact ⟨c,by simpa [F] using gate n F false c hd hr hs,le_rfl⟩

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open PEqualNP.MetaComplexity

private theorem erase_or {n s : ℕ} (relabel : Relabel575) (gate : LastDrop575)
    (F : (Fin n → Bool) → Bool) (v : Fin n) (hn : ∃ x y, F x ≠ F y)
    (stable : ∀ x y, (∀ i, i≠v → x i=y i) → F x=F y)
    (hs : HasCircuitSize n (fun x => F x || x v) s) : ∃ c, HasCircuitSize n F c ∧ c+1 ≤ s := by
  let p (i : Fin n) : Fin (n+1) := if i=v then Fin.last n else i.castSucc
  have eq : (fun x : Fin (n+1) → Bool => F (x∘p) || x (p v)) = (fun x => F (fun i => x i.castSucc) || x (Fin.last n)) := by
    funext x
    rw [stable (x∘p) (fun i => x i.castSucc) (fun i h => congrArg x (ite_eq_right h))]
    simp [p]
  have hc := relabel p _ s hs
  change HasCircuitSize (n+1) (fun x => F (x∘p) || x (p v)) s at hc
  exact appended_or_drop gate F hn (eq ▸ hc)

theorem remove_two_or {N m s : ℕ} (relabel : Relabel575) (gate : LastDrop575)
    (g : (Fin N → Bool) → Bool) (u v : Fin N) (hn : ∃ x y, g x ≠ g y)
    (A B : List (Fin m)) (i j : Fin m) (hij : i ≠ j) (hi : i ∉ A++B) (hj : j ∉ A++B)
    (hs : HasCircuitSize (N+m) (fun x => twoArms g u v A B x || freshBits x i || freshBits x j) s) :
    ∃ c, HasCircuitSize (N+m) (twoArms g u v A B) c ∧ c+2 ≤ s := by
  let F := twoArms g u v A B
  have stable (z : Fin m) (hz : z ∉ A++B) (x y : Fin (N+m) → Bool)
      (ok : ∀ a, a ≠ z.natAdd N → x a=y a) : F x=F y := by
    apply arms_unchanged
    · exact funext fun k => ok _ (old_ne_fresh k z)
    · exact fun k hk => ok _ (fun e => hz (fresh_inj e ▸ hk))
  let G (x : Fin (N+m) → Bool) := F x || freshBits x i
  have ng : ∃ x y, G x ≠ G y := by
    obtain ⟨x,y,h⟩ := hn
    refine ⟨Fin.append x (fun _ => false),Fin.append y (fun _ => false),?_⟩
    simpa [G,F,all_off,asgn_fresh] using h
  have sg (x y : Fin (N+m) → Bool) (ok : ∀ a, a≠j.natAdd N → x a=y a) : G x=G y := by
    change (F x || freshBits x i) = (F y || freshBits y i)
    rw [stable j hj x y ok,show freshBits x i = freshBits y i from ok _ (fun e => hij (fresh_inj e))]
  obtain ⟨c,hc,hc'⟩ := erase_or relabel gate G (j.natAdd N) ng sg hs
  obtain ⟨d,hd,hd'⟩ := erase_or relabel gate F (i.natAdd N) (arm_nonconst _ _ _ _ _ hn) (stable i hi) hc
  exact ⟨d,hd,by omega⟩

end PEqualNP.Outside.Path575

namespace PEqualNP.Outside.Path575

open scoped Classical

private theorem indexed_links (r : Bool) (l : List Bool) :
    links r l = true ↔ ∃ i : ℕ, ∃ hi : i < l.length, l[i] = true ∧
      (l[i+1]?).getD r = true := by
  induction l with
  | nil => simp [links]
  | cons b l ih =>
    rw [links_cons,Bool.or_eq_true,Bool.and_eq_true,ih]
    have head : l.headD r = (l[0]?).getD r := by cases l <;> rfl
    constructor
    · rintro (⟨hb,hh⟩ | ⟨i,hi,hv,hn⟩)
      · exact ⟨0,by simp,hb,head ▸ hh⟩
      · exact ⟨i+1,by simp;omega,hv,hn⟩
    · rintro ⟨i,hi,hv,hn⟩
      cases i with
      | zero => exact Or.inl ⟨hv,head.symm ▸ hn⟩
      | succ i => exact Or.inr ⟨i,by simpa using hi,hv,hn⟩

private theorem links_ofFn {m : ℕ} (hm : 0 < m) (u v : Bool) (w : Fin m → Bool) :
    links v (u :: List.ofFn w) = true ↔
      ∃ i : Fin m, w i = true ∧ ((i.val=0 ∧ u=true) ∨ (i.val+1=m ∧ v=true) ∨
        ∃ j : Fin m, j.val=i.val+1 ∧ w j=true) := by
  have get (i : ℕ) : ((List.ofFn w)[i]?).getD v =
      if h : i < m then w ⟨i,h⟩ else v := by
    by_cases hi : i < m
    · rw [dite_eq_left hi,List.getElem?_eq_getElem (by simpa using hi)]
      simp
    · rw [dite_eq_right hi,List.getElem?_eq_none (by simp; omega)]
      rfl
  have head : (List.ofFn w).headD v = w ⟨0,hm⟩ := by
    rw [List.headD_eq_head?_getD,List.head?_eq_getElem?,get,dite_eq_left hm]
  rw [links_cons,Bool.or_eq_true,Bool.and_eq_true,head,indexed_links]
  constructor
  · rintro (⟨hu,hw⟩ | ⟨i,hi,hw,hn⟩)
    · exact ⟨⟨0,hm⟩,hw,Or.inl ⟨rfl,hu⟩⟩
    · have hh : i < m := by simpa using hi
      refine ⟨⟨i,hh⟩,by simpa using hw,Or.inr ?_⟩
      rw [get] at hn
      split at hn
      next h => exact Or.inr ⟨⟨_,h⟩,rfl,hn⟩
      next h => exact Or.inl ⟨by simp;omega,hn⟩
  · rintro ⟨i,hw,⟨hi,hu⟩ | ⟨hi,hv⟩ | ⟨j,hj,hjv⟩⟩
    · have eq : i = ⟨0,hm⟩ := Fin.ext hi
      exact Or.inl ⟨hu,eq ▸ hw⟩
    · refine Or.inr ⟨i.val,by simp,by simpa using hw,?_⟩
      rw [get,dite_eq_right (by omega)]
      exact hv
    · refine Or.inr ⟨i.val,by simp,by simpa using hw,?_⟩
      rw [get,dite_eq_left (by have := j.isLt;omega)]
      have eq : j = ⟨i.val+1, by have := j.isLt; omega⟩ := Fin.ext hj
      exact eq ▸ hjv

theorem route_links {N m : ℕ} (hm : 0 < m) (u v : Fin N) (g : (Fin N → Bool) → Bool)
    (x : Fin (N+m) → Bool) : route u v g x = (g (oldBits x) ||
      links (oldBits x v) (oldBits x u :: (List.finRange m).map (freshBits x))) := by
  rw [←List.ofFn_eq_map]
  apply Bool.eq_iff_iff.mpr
  simp only [route,Bool.or_eq_true,decide_eq_true_eq,links_ofFn hm,oldBits,freshBits]
  rfl

private theorem range_split {m : ℕ} (i : Fin m) :
    ∃ A B : List (Fin m), List.finRange m = A ++ i :: B ∧ A.length=i.val ∧ A.length+B.length+1=m := by
  let l := List.finRange m
  have hi : i.val < l.length := by simp [l]
  refine ⟨l.take i.val,l.drop (i.val+1),?_,?_,?_⟩
  · have at_i : l[i.val] = i := by simp [l]
    calc
      List.finRange m = l.take i.val ++ l.drop i.val := (List.take_append_drop ..).symm
      _ = _ := by rw [List.drop_eq_getElem_cons hi,at_i]
  · simp [l]
  · simp [l]; omega

private theorem keep_old {N m : ℕ} (x : Fin (N+m) → Bool) (i : Fin m) (b : Bool) :
    oldBits (Function.update x (Fin.natAdd N i) b) = oldBits x := by
  funext j
  exact Function.update_of_ne (fun h => by
    have e := congrArg Fin.val h
    simp only [Fin.val_castAdd,Fin.val_natAdd] at e
    omega) _ _

private theorem cut_natAdd_inj {N m : ℕ} {a b : Fin m} (h : Fin.natAdd N a = Fin.natAdd N b) : a=b := by
  apply Fin.ext
  have h' := congrArg Fin.val h
  simpa only [Fin.val_natAdd,Nat.add_right_inj] using h'

private theorem fresh_self {N m : ℕ} (x : Fin (N+m) → Bool) (i : Fin m) (b : Bool) :
    freshBits (Function.update x (Fin.natAdd N i) b) i = b := Function.update_self ..

private theorem keep_fresh {N m : ℕ} (x : Fin (N+m) → Bool) (i : Fin m) (b : Bool)
    (A : List (Fin m)) (hi : i ∉ A) :
    A.map (freshBits (Function.update x (Fin.natAdd N i) b)) = A.map (freshBits x) := by
  apply List.map_congr_left
  intro j hj
  have hn : Fin.natAdd N j ≠ Fin.natAdd N i := fun e => hi ((cut_natAdd_inj e) ▸ hj)
  exact Function.update_of_ne hn _ _

private theorem reverse_cut_nodup {α : Type*} (A B : List α) (T : List α)
    (hn : (A ++ T ++ B).Nodup) :
    (A.reverse++B).Nodup ∧ T.Nodup ∧ ∀ t ∈ T, t ∉ A.reverse++B := by
  simp only [List.nodup_append',List.disjoint_left,List.mem_append,List.mem_reverse,List.nodup_reverse] at *
  grind

theorem route_cut_false {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool) (i : Fin m) :
    ∃ A B : List (Fin m), (A++B).Nodup ∧ A.length+B.length+1=m ∧
      (fun x => route u v g (Function.update x (Fin.natAdd N i) false)) = twoArms g u v A B := by
  obtain ⟨a,b,split,_,hl⟩ := range_split i
  have hu : (a++[i]++b).Nodup := by simpa [List.append_assoc] using split ▸ List.nodup_finRange m
  obtain ⟨hn,_,out⟩ := reverse_cut_nodup a b [i] hu
  have oi := out i (by simp)
  have ia : i ∉ a := by simpa using fun h => oi (List.mem_append_left b h)
  have ib : i ∉ b := fun h => oi (List.mem_append_right _ h)
  refine ⟨a.reverse,b,hn,by simpa using hl,?_⟩
  funext x
  rw [route_links (by omega),keep_old,split,List.map_append,List.map_cons,keep_fresh x i false a ia,
    keep_fresh x i false b ib]
  rw [fresh_self]
  rw [cut_fresh_false]
  simp only [twoArms,List.map_reverse,Bool.or_assoc]

theorem route_cut_true {N m : ℕ} (u v : Fin N) (g : (Fin N → Bool) → Bool) (i : Fin m)
    (hi : 0 < i.val) (hi' : i.val+1 < m) :
    ∃ (A B : List (Fin m)) (l r : Fin m), (A++B).Nodup ∧ A.length+B.length+3=m ∧
      l ≠ r ∧ l ∉ A++B ∧ r ∉ A++B ∧
      (fun x => route u v g (Function.update x (Fin.natAdd N i) true)) =
        (fun x => twoArms g u v A B x || freshBits x l || freshBits x r) := by
  obtain ⟨a,b,split,hla,hl⟩ := range_split i
  have han : a ≠ [] := by rintro rfl; simp at hla; omega
  obtain ⟨A,l,ha⟩ : ∃ A l, a=A++[l] :=
    ⟨a.dropLast,a.getLast han,(List.dropLast_append_getLast han).symm⟩
  subst a
  cases b with
  | nil => simp at hl hla; omega
  | cons r B =>
    simp only [List.append_assoc,List.singleton_append] at split
    have hu : (A++[l,i,r]++B).Nodup := by simpa [List.append_assoc] using split ▸ List.nodup_finRange m
    obtain ⟨hn,hd,out⟩ := reverse_cut_nodup A B [l,i,r] hu
    have lr : l ≠ r := by intro e; apply (List.nodup_cons.mp hd).1; simp [e]
    have il : i ≠ l := by intro e; apply (List.nodup_cons.mp hd).1; simp [e]
    have ir : i ≠ r := by simpa using (List.nodup_cons.mp (List.nodup_cons.mp hd).2).1
    have oi := out i (by simp)
    have ia : i ∉ A := by simpa using fun h => oi (List.mem_append_left B h)
    have ib : i ∉ B := fun h => oi (List.mem_append_right _ h)
    refine ⟨A.reverse,B,l,r,hn,by simp at hl ⊢; omega,lr,out l (by simp),out r (by simp),?_⟩
    funext x
    rw [route_links (by omega),keep_old,split,List.map_append,List.map_cons,List.map_cons,List.map_cons,
      keep_fresh x i true A ia, keep_fresh x i true B ib]
    have fl : freshBits (Function.update x (Fin.natAdd N i) true) l = freshBits x l :=
      Function.update_of_ne (fun h => il (cut_natAdd_inj h).symm) _ _
    have fr : freshBits (Function.update x (Fin.natAdd N i) true) r = freshBits x r :=
      Function.update_of_ne (fun h => ir (cut_natAdd_inj h).symm) _ _
    rw [fl,fr]
    rw [fresh_self]
    rw [cut_fresh_true]
    simp only [twoArms,List.map_reverse,Bool.or_assoc]

end PEqualNP.Outside.Path575

open PEqualNP.Outside.Path575
open PEqualNP.MetaComplexity.L575Proof

theorem PEqualNP.Outside.L_meta_575 :
    ∀ (N h : ℕ) (u v : Fin N) (g : (Fin N → Bool) → Bool), u ≠ v → 3 ≤ h → (∃ y y' : Fin N → Bool, g y ≠ g y') → (∃ x : Fin N → Bool, x u = false ∧ g x = false) → (∃ x : Fin N → Bool, x u = true ∧ g x = false) → (∃ x : Fin N → Bool, x v = false ∧ g x = false) → (∃ x : Fin N → Bool, x v = true ∧ g x = false) → ∀ s : ℕ, PEqualNP.MetaComplexity.HasCircuitSize (N + 2 * h) (fun x : Fin (N + 2 * h) → Bool => g (fun i : Fin N => x (Fin.castAdd (2 * h) i)) || decide (∃ i : Fin (2 * h), x (Fin.natAdd N i) = true ∧ ((i.val = 0 ∧ x (Fin.castAdd (2 * h) u) = true) ∨ (i.val + 1 = 2 * h ∧ x (Fin.castAdd (2 * h) v) = true) ∨ ∃ j : Fin (2 * h), j.val = i.val + 1 ∧ x (Fin.natAdd N j) = true))) s → ∃ s' : ℕ, 3 * h + s' ≤ s ∧ (PEqualNP.MetaComplexity.HasCircuitSize (N + 1) (fun x : Fin (N + 1) → Bool => g (fun i : Fin N => x i.castSucc) || (x u.castSucc && x (Fin.last N))) s' ∨ PEqualNP.MetaComplexity.HasCircuitSize (N + 1) (fun x : Fin (N + 1) → Bool => g (fun i : Fin N => x i.castSucc) || (x v.castSucc && x (Fin.last N))) s') := by
  intro N h u v g huv hh hn hu0 hu1 hv0 hv1 s hs
  have hm : 6 ≤ 2*h := by omega
  have hu : ∀ b : Bool, ∃ z, z u=b ∧ g z=false := by
    intro b
    cases b
    · exact hu0
    · exact hu1
  have hv : ∀ b : Bool, ∃ z, z v=b ∧ g z=false := by
    intro b
    cases b
    · exact hv0
    · exact hv1
  have hd := route_deep hm u v g hu0 hv0
  have hnon : (pathInterior N (2*h)).Nonempty := by
    let i : Fin (2*h) := ⟨1,by omega⟩
    exact ⟨Fin.natAdd N i, (PEqualNP.Outside.Path575.tail_in i).mpr (by simp [i];omega)⟩
  obtain ⟨y,hy,rest⟩ := EdgeFn.drop_internal (route u v g) _ hd hnon hs
  obtain ⟨i,hi,hi',rfl⟩ := PEqualNP.Outside.Path575.mem_tail y hy
  have relabel : Relabel575 := @Helpers.PermInputs.relabel_size
  have pair : Pair575 := @terminal_pair
  rcases rest with ⟨s',hp,hr⟩ | ⟨s',hp,hr⟩
  · obtain ⟨A,B,hdis,hlen,he⟩ := route_cut_false u v g i
    rw [he] at hr
    obtain ⟨c,hpay,hpend⟩ := arms_to_pendant relabel pair g u v hn hu hv A B hdis (by omega) hr
    exact ⟨c,by omega,hpend⟩
  · obtain ⟨A,B,l,r,hdis,hlen,hlr,hl,hr',he⟩ := route_cut_true u v g i hi hi'
    rw [he] at hr
    obtain ⟨d,hd',hdpay⟩ := remove_two_or relabel Helpers.gate_elim g u v hn A B l r hlr hl hr' hr
    obtain ⟨c,hpay,hpend⟩ := arms_to_pendant relabel pair g u v hn hu hv A B hdis (by omega) hd'
    exact ⟨c,by omega,hpend⟩
