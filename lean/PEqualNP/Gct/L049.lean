import PEqualNP.Gct.Helpers.PolarAsm

/-- L-gct-049: the assembly. The statement of L-gct-047 (some directions `v` make the gradients
of `G, D_{v_1} G, .., D_{v_h} G` independent at every nonzero common zero) and the statement of
L-gct-048 (the chart choice `a`) imply the statement of L-gct-034 (hard link H4). -/
theorem PEqualNP.Gct.L049 :
    (∀ (h r : ℕ) (G : MvPolynomial (Fin (h + 2)) ℂ), 2 ≤ r → G.IsHomogeneous r → (∀ x : Fin (h + 2) → ℂ, (∀ i, MvPolynomial.eval x (MvPolynomial.pderiv i G) = 0) → x = 0) → ∃ v : Fin h → Fin (h + 2) → ℂ, ∀ x : Fin (h + 2) → ℂ, x ≠ 0 → MvPolynomial.eval x G = 0 → (∀ k, MvPolynomial.eval x (∑ j, MvPolynomial.C (v k j) * MvPolynomial.pderiv j G) = 0) → LinearIndependent ℂ (Fin.cons (fun j => MvPolynomial.eval x (MvPolynomial.pderiv j G)) (fun k j => MvPolynomial.eval x (MvPolynomial.pderiv j (∑ l, MvPolynomial.C (v k l) * MvPolynomial.pderiv l G))) : Fin (h + 1) → Fin (h + 2) → ℂ)) → (∀ (h r : ℕ) (G : MvPolynomial (Fin (h + 2)) ℂ) (v : Fin h → Fin (h + 2) → ℂ), G.IsHomogeneous r → (∀ x : Fin (h + 2) → ℂ, x ≠ 0 → MvPolynomial.eval x G = 0 → (∀ k, MvPolynomial.eval x (∑ j, MvPolynomial.C (v k j) * MvPolynomial.pderiv j G) = 0) → LinearIndependent ℂ (Fin.cons (fun j => MvPolynomial.eval x (MvPolynomial.pderiv j G)) (fun k j => MvPolynomial.eval x (MvPolynomial.pderiv j (∑ l, MvPolynomial.C (v k l) * MvPolynomial.pderiv l G))) : Fin (h + 1) → Fin (h + 2) → ℂ)) → ∃ a : Fin (h + 2) → ℂ, ∀ x : Fin (h + 2) → ℂ, MvPolynomial.eval x G = 0 → ∑ j, a j * x j = 0 → (∀ k : Fin h, MvPolynomial.eval x (∑ j, MvPolynomial.C (v k j) * MvPolynomial.pderiv j G) = 0) → x = 0) → (∀ (h r : ℕ) (G : MvPolynomial (Fin (h + 2)) ℂ), 2 ≤ r → G.IsHomogeneous r → (∀ x : Fin (h + 2) → ℂ, (∀ i, MvPolynomial.eval x (MvPolynomial.pderiv i G) = 0) → x = 0) → ∃ (a : Fin (h + 2) → ℂ) (v : Fin h → Fin (h + 2) → ℂ) (S : Finset (Fin (h + 2) → ℂ)), (r - 1) ^ (h + 1) ≤ S.card ∧ ∀ x ∈ S, (∀ i, MvPolynomial.eval x ((Fin.cons G (Fin.cons (∑ j, MvPolynomial.C (a j) * MvPolynomial.X j - 1) (fun k : Fin h => ∑ j, MvPolynomial.C (v k j) * MvPolynomial.pderiv j G)) : Fin (h + 2) → MvPolynomial (Fin (h + 2)) ℂ) i) = 0) ∧ (Matrix.of fun i j : Fin (h + 2) => MvPolynomial.eval x (MvPolynomial.pderiv j ((Fin.cons G (Fin.cons (∑ j, MvPolynomial.C (a j) * MvPolynomial.X j - 1) (fun k : Fin h => ∑ j, MvPolynomial.C (v k j) * MvPolynomial.pderiv j G)) : Fin (h + 2) → MvPolynomial (Fin (h + 2)) ℂ) i))).det ≠ 0) :=
  PEqualNP.Gct.Helpers.polarAsm_holds
