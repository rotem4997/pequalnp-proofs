import Mathlib

/-!
Helpers for L-gct-034, count lemma B (Bezout lower bound), commutative algebra route.

Count lemma B: a square system `f_1, .., f_n` in `C[x_1, .., x_n]` whose top forms have only the
trivial common zero, and all of whose zeros have invertible Jacobian, has at least
`prod_i totalDegree f_i` zeros. It is stated here as the Prop `BezCountB`.

What this file proves is the finiteness half (the "easy" filtered direction):

* `bez_exists_pow_mem`: if the top forms `g` have only the trivial common zero, every `X j ^ N`
  lies in `(g)` for some `N` (Nullstellensatz).
* `bez_monomial_mem`: every monomial of large degree lies in `(g)`.
* `bez_homog_decomp`: a form `p` of large degree `D` is `sum_i g_i * a_i` with `a_i` forms of
  degree `D - d_i`.
* `bez_reduce`: every polynomial is congruent mod `(f)` to one of degree below a fixed bound.
* `bez_finite_quotient`: `C[x] / (f)` is a finite dimensional `C` vector space.

The lower bound `dim C[x]/(f) >= prod d_i` (regularity of the top forms) is not here.
-/

namespace PEqualNP.Gct.Helpers

open MvPolynomial

/-- Count lemma B of L-gct-034, as a single Prop. -/
def BezCountB : Prop :=
  ∀ (n : ℕ) (f : Fin n → MvPolynomial (Fin n) ℂ),
    (∀ x : Fin n → ℂ,
      (∀ i, eval x (homogeneousComponent (f i).totalDegree (f i)) = 0) → x = 0) →
    (∀ x : Fin n → ℂ, (∀ i, eval x (f i) = 0) →
      (Matrix.of fun i j : Fin n => eval x (pderiv j (f i))).det ≠ 0) →
    ∃ S : Finset (Fin n → ℂ), (∏ i, (f i).totalDegree) ≤ S.card ∧
      ∀ x ∈ S, ∀ i, eval x (f i) = 0

/-- Nullstellensatz step: if `g` has only the trivial common zero, a power of each variable
lies in the ideal generated by `g`. -/
theorem bez_exists_pow_mem {n : ℕ} (g : Fin n → MvPolynomial (Fin n) ℂ)
    (hg : ∀ x : Fin n → ℂ, (∀ i, eval x (g i) = 0) → x = 0) (j : Fin n) :
    ∃ N : ℕ, X j ^ N ∈ Ideal.span (Set.range g) := by
  have hmem : (X j : MvPolynomial (Fin n) ℂ) ∈
      vanishingIdeal ℂ (zeroLocus ℂ (Ideal.span (Set.range g)) : Set (Fin n → ℂ)) := by
    rw [mem_vanishingIdeal_iff]
    intro x hx
    have h0 : x = 0 := hg x fun i => by
      have := hx (g i) (Ideal.subset_span ⟨i, rfl⟩)
      simpa [aeval_eq_eval] using this
    simp [h0]
  rw [vanishingIdeal_zeroLocus_eq_radical] at hmem
  exact hmem

/-- Every monomial of degree at least `sum_j N j + E + 1` lies in `(g)`. -/
theorem bez_monomial_mem {n : ℕ} (g : Fin n → MvPolynomial (Fin n) ℂ)
    (hg : ∀ x : Fin n → ℂ, (∀ i, eval x (g i) = 0) → x = 0) (E : ℕ) :
    ∃ D0 : ℕ, E < D0 ∧ ∀ (s : Fin n →₀ ℕ) (c : ℂ), D0 ≤ s.degree →
      monomial s c ∈ Ideal.span (Set.range g) := by
  choose N hN using bez_exists_pow_mem g hg
  refine ⟨∑ j, N j + E + 1, by omega, fun s c hs => ?_⟩
  have : ∃ j, N j ≤ s j := by
    by_contra hcon
    push Not at hcon
    have h1 : s.degree ≤ ∑ j, N j := by
      rw [Finsupp.degree_eq_sum]
      exact Finset.sum_le_sum fun j _ => (hcon j).le
    omega
  obtain ⟨j, hj⟩ := this
  have hle : Finsupp.single j (N j) ≤ s := by
    rw [Finsupp.single_le_iff]; exact hj
  have hs' : s = (s - Finsupp.single j (N j)) + Finsupp.single j (N j) :=
    (tsub_add_cancel_of_le hle).symm
  rw [hs', ← mul_one c, ← monomial_mul_monomial, ← X_pow_eq_monomial]
  exact Ideal.mul_mem_left _ _ (hN j)

/-- Forms of large degree decompose along the `g i`. -/
theorem bez_homog_decomp {n : ℕ} (g : Fin n → MvPolynomial (Fin n) ℂ) (d : Fin n → ℕ)
    (hgh : ∀ i, (g i).IsHomogeneous (d i)) (D0 : ℕ) (hdD0 : ∀ i, d i ≤ D0)
    (hD0 : ∀ (s : Fin n →₀ ℕ) (c : ℂ), D0 ≤ s.degree → monomial s c ∈ Ideal.span (Set.range g))
    {D : ℕ} (hD : D0 ≤ D) (p : MvPolynomial (Fin n) ℂ) (hp : p.IsHomogeneous D) :
    ∃ a : Fin n → MvPolynomial (Fin n) ℂ, (∀ i, (a i).IsHomogeneous (D - d i)) ∧
      p = ∑ i, g i * a i := by
  have hpI : p ∈ Ideal.span (Set.range g) := by
    rw [p.as_sum]
    refine Ideal.sum_mem _ fun s hs => hD0 s _ ?_
    have h := hp (mem_support_iff.mp hs)
    rw [Finsupp.degree_eq_weight_one]
    exact h.symm ▸ hD
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp hpI
  refine ⟨fun i => homogeneousComponent (D - d i) (c i),
    fun i => homogeneousComponent_isHomogeneous _ _, ?_⟩
  have hpD : homogeneousComponent D p = p := homogeneousComponent_of_mem hp |>.trans (by simp)
  rw [← hpD, ← hc, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [mul_comm (g i)]
  exact weightedHomogeneousComponent_mul_of_isWeightedHomogeneous_right (hgh i)
    ((hdD0 i).trans hD)

/-- Removing the degree `m` component of a polynomial of degree at most `m` lowers the degree. -/
theorem bez_totalDegree_sub_homogeneousComponent_lt {n : ℕ} (φ : MvPolynomial (Fin n) ℂ)
    {m : ℕ} (hm : φ.totalDegree ≤ m) (hm0 : 0 < m) :
    (φ - homogeneousComponent m φ).totalDegree < m := by
  rw [totalDegree, Finset.sup_lt_iff (by simpa using hm0)]
  intro s hs
  rw [mem_support_iff, coeff_sub, coeff_homogeneousComponent] at hs
  have hdeg : (s.sum fun _ e => e) = s.degree := rfl
  rw [hdeg]
  by_contra hcon
  push Not at hcon
  rcases hcon.lt_or_eq with hlt | heq
  · apply hs
    have : φ.coeff s = 0 := coeff_eq_zero_of_totalDegree_lt (by
      have : s.degree = ∑ i ∈ s.support, s i := rfl
      omega)
    simp [this]
  · apply hs
    simp [heq.symm]

/-- The reduction: modulo `(f)`, every polynomial has degree below a fixed bound. -/
theorem bez_reduce {n : ℕ} (f : Fin n → MvPolynomial (Fin n) ℂ)
    (hinf : ∀ x : Fin n → ℂ,
      (∀ i, eval x (homogeneousComponent (f i).totalDegree (f i)) = 0) → x = 0) :
    ∃ D0 : ℕ, 0 < D0 ∧ ∀ p : MvPolynomial (Fin n) ℂ, ∃ q : MvPolynomial (Fin n) ℂ,
      q.totalDegree < D0 ∧ p - q ∈ Ideal.span (Set.range f) := by
  set d : Fin n → ℕ := fun i => (f i).totalDegree with hd
  set g : Fin n → MvPolynomial (Fin n) ℂ := fun i => homogeneousComponent (d i) (f i) with hg
  obtain ⟨D0, hED0, hD0⟩ := bez_monomial_mem g hinf (∑ i, d i)
  have hdD0 : ∀ i, d i ≤ D0 := fun i =>
    (Finset.single_le_sum (fun j _ => Nat.zero_le (d j)) (Finset.mem_univ i)).trans hED0.le
  refine ⟨D0, by omega, fun p => ?_⟩
  induction hdeg : p.totalDegree using Nat.strong_induction_on generalizing p with
  | _ D ih =>
  by_cases hlt : D < D0
  · exact ⟨p, hdeg ▸ hlt, by simp⟩
  push Not at hlt
  have hD : 0 < D := by omega
  obtain ⟨a, ha, hpa⟩ := bez_homog_decomp g d (fun i => homogeneousComponent_isHomogeneous _ _)
    D0 hdD0 hD0 hlt (homogeneousComponent D p) (homogeneousComponent_isHomogeneous _ _)
  set p' := p - ∑ i, f i * a i with hp'
  have hp'eq : p' = (p - homogeneousComponent D p) - ∑ i, (f i - g i) * a i := by
    rw [hp', hpa]
    simp only [sub_mul, Finset.sum_sub_distrib]
    ring
  have hlt' : p'.totalDegree < D := by
    rw [hp'eq]
    refine lt_of_le_of_lt (totalDegree_sub _ _) (max_lt ?_ ?_)
    · exact bez_totalDegree_sub_homogeneousComponent_lt p hdeg.le hD
    · have hsum : (∑ i, (f i - g i) * a i).totalDegree ≤ D - 1 := by
        refine totalDegree_finsetSum_le fun i _ => ?_
        have hai : (a i).totalDegree ≤ D - d i := (ha i).totalDegree_le
        by_cases hdi : d i = 0
        · have hfi : f i - g i = 0 := by
            have h0 : (f i).totalDegree = 0 := hdi
            rw [hg]
            simp only [hdi, homogeneousComponent_zero]
            rw [sub_eq_zero]
            exact totalDegree_eq_zero_iff_eq_C.mp h0
          rw [hfi, zero_mul, totalDegree_zero]
          omega
        · refine (totalDegree_mul _ _).trans ?_
          have hfg : (f i - g i).totalDegree < d i :=
            bez_totalDegree_sub_homogeneousComponent_lt (f i) le_rfl (Nat.pos_of_ne_zero hdi)
          have := hdD0 i
          omega
      omega
  obtain ⟨q, hq, hpq⟩ := ih _ (hdeg ▸ hlt') p' rfl
  refine ⟨q, hq, ?_⟩
  have : p - q = (p' - q) + ∑ i, a i * f i := by
    rw [hp']
    simp only [mul_comm (a _)]
    ring
  rw [this]
  refine Ideal.add_mem _ hpq (Ideal.sum_mem _ fun i _ => ?_)
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- No zeros at infinity makes `C[x] / (f)` finite dimensional. -/
theorem bez_finite_quotient {n : ℕ} (f : Fin n → MvPolynomial (Fin n) ℂ)
    (hinf : ∀ x : Fin n → ℂ,
      (∀ i, eval x (homogeneousComponent (f i).totalDegree (f i)) = 0) → x = 0) :
    Module.Finite ℂ (MvPolynomial (Fin n) ℂ ⧸ Ideal.span (Set.range f)) := by
  obtain ⟨D0, hD0, hred⟩ := bez_reduce f hinf
  let L : restrictTotalDegree (Fin n) ℂ (D0 - 1) →ₗ[ℂ]
      (MvPolynomial (Fin n) ℂ ⧸ Ideal.span (Set.range f)) :=
    (Ideal.Quotient.mkₐ ℂ (Ideal.span (Set.range f))).toLinearMap ∘ₗ
      (restrictTotalDegree (Fin n) ℂ (D0 - 1)).subtype
  refine Module.Finite.of_surjective L fun y => ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨q, hq, hpq⟩ := hred p
  refine ⟨⟨q, (mem_restrictTotalDegree _ _ _).mpr (by omega)⟩, ?_⟩
  simp only [L, LinearMap.coe_comp, Function.comp_apply, Submodule.coe_subtype,
    AlgHom.toLinearMap_apply, Ideal.Quotient.mkₐ_eq_mk]
  exact (Ideal.Quotient.eq.mpr hpq).symm

end PEqualNP.Gct.Helpers
